{
  "subject": "This month at Acme",
  "preheader": "Three stories worth a read.",
  "layout": "builtin:newsletter",
  "theme": {
    "page": "#f1f1f1",
    "canvas": "#ffffff",
    "primary": "#2f2f2f",
    "secondary": "#595959",
    "accent": "#3d3d3d",
    "tint": "#f5f5f5",
    "text": "#1c1c1c",
    "muted": "#666666",
    "headingFont": "Georgia",
    "bodyFont": "Arial"
  },
  "blocks": [
    {
      "id": "logo",
      "type": "image",
      "role": "brand",
      "padding": [
        0,
        0,
        0,
        0
      ],
      "alt": "Your logo",
      "width": 600,
      "height": 155,
      "bleed": true
    },
    {
      "id": "intro",
      "type": "text",
      "role": "content",
      "padding": [
        32,
        40,
        8,
        40
      ],
      "text": "Here is what we have been working on, and a few things we think you will enjoy.",
      "size": 16,
      "lineHeight": 24,
      "align": "center"
    },
    {
      "id": "story",
      "type": "columns",
      "role": "content",
      "columns": [
        {
          "width": 100,
          "blocks": [
            {
              "id": "story-picture",
              "type": "image",
              "padding": [
                16,
                0,
                20,
                0
              ],
              "alt": "Story picture",
              "width": 552,
              "height": 240
            },
            {
              "id": "story-title",
              "type": "heading",
              "padding": [
                0,
                0,
                8,
                0
              ],
              "text": "A story worth reading",
              "size": 21.3,
              "lineHeight": 24,
              "color": "primary",
              "align": "left",
              "weight": 700,
              "font": "heading"
            },
            {
              "id": "story-excerpt",
              "type": "text",
              "padding": [
                0,
                0,
                16,
                0
              ],
              "text": "A short excerpt that tells the reader what the story is about and why it matters.",
              "size": 14.7,
              "lineHeight": 19.2,
              "align": "left"
            },
            {
              "id": "story-link",
              "type": "button",
              "role": "content",
              "padding": [
                0,
                0,
                24,
                0
              ],
              "size": 16,
              "color": "accent",
              "width": 200,
              "label": "Read more",
              "paddingY": 9
            }
          ]
        }
      ]
    },
    {
      "id": "social",
      "type": "social",
      "role": "brand",
      "padding": [
        0,
        24,
        15,
        24
      ],
      "links": [
        {
          "network": "Instagram",
          "href": ""
        },
        {
          "network": "YouTube",
          "href": ""
        },
        {
          "network": "LinkedIn",
          "href": ""
        }
      ]
    },
    {
      "id": "footer",
      "type": "footer",
      "role": "brand",
      "size": 14.7,
      "lineHeight": 22.4,
      "color": "muted",
      "linkColor": "secondary",
      "background": "white",
      "font": "base",
      "letterSpacing": "-0.025em",
      "inset": [
        20.47555319531862,
        24,
        20.47555319531862,
        24
      ],
      "maxWidth": 552,
      "cellPadding": 13,
      "links": [
        {
          "label": "Contact us",
          "href": ""
        },
        {
          "label": "Manage preferences",
          "href": "{{preferencesUrl}}"
        },
        {
          "label": "Unsubscribe",
          "href": "{{unsubscribeUrl}}"
        },
        {
          "label": "View in browser",
          "href": "{{viewUrl}}"
        }
      ],
      "lines": [
        "ACME\n123 Example Street, Springfield",
        "You're receiving this email because you signed up for updates from Acme.",
        "© 2026 Acme"
      ],
      "lineGap": 16
    }
  ]
}
