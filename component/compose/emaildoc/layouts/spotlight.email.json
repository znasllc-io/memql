{
  "subject": "Meet Ace",
  "preheader": "Our guide to getting the small things done.",
  "layout": "builtin:spotlight",
  "theme": {
    "page": "#eef0f3",
    "canvas": "#ffffff",
    "primary": "#1f5f8b",
    "secondary": "#5b8fb9",
    "accent": "#d9534f",
    "tint": "#f6f4ef",
    "text": "#2b2b2b",
    "muted": "#8a8f98",
    "headingFont": "Georgia",
    "bodyFont": "Arial"
  },
  "blocks": [
    {
      "id": "logo",
      "type": "image",
      "role": "brand",
      "padding": [
        0,
        0,
        0,
        0
      ],
      "alt": "Your logo",
      "width": 600,
      "height": 155,
      "bleed": true
    },
    {
      "id": "spotlight",
      "type": "image",
      "role": "content",
      "padding": [
        24,
        24,
        16,
        24
      ],
      "alt": "Spotlight picture",
      "width": 276,
      "height": 300
    },
    {
      "id": "message-box",
      "type": "section",
      "role": "content",
      "background": "canvas",
      "maxWidth": 451,
      "blocks": [
        {
          "id": "message",
          "type": "text",
          "role": "content",
          "text": "Our mission?\n\nMake the small daily jobs a little easier.\n\nWe'll learn together, find the easy wins and make every morning a little more fun.",
          "size": 14.7,
          "lineHeight": 16,
          "align": "center",
          "weight": 700,
          "font": "heading"
        }
      ]
    },
    {
      "id": "cta",
      "type": "button",
      "role": "content",
      "size": 20.4,
      "color": "accent",
      "width": 306,
      "label": "Meet Ace",
      "paddingY": 11
    },
    {
      "id": "follow",
      "type": "heading",
      "role": "brand",
      "text": "Follow us",
      "size": 20,
      "lineHeight": 20,
      "color": "primary",
      "italic": true,
      "weight": 700,
      "letterSpacing": "-0.032em"
    },
    {
      "id": "social",
      "type": "social",
      "role": "brand",
      "links": [
        {
          "network": "Instagram",
          "href": ""
        },
        {
          "network": "YouTube",
          "href": ""
        },
        {
          "network": "LinkedIn",
          "href": ""
        }
      ]
    },
    {
      "id": "footer",
      "type": "footer",
      "role": "brand",
      "size": 14.7,
      "lineHeight": 22.4,
      "color": "muted",
      "linkColor": "secondary",
      "background": "white",
      "font": "base",
      "letterSpacing": "-0.025em",
      "inset": [
        0,
        24,
        0,
        24
      ],
      "maxWidth": 552,
      "cellPadding": 13,
      "links": [
        {
          "label": "Contact us",
          "href": ""
        },
        {
          "label": "Manage preferences",
          "href": "{{preferencesUrl}}"
        },
        {
          "label": "Unsubscribe",
          "href": "{{unsubscribeUrl}}"
        },
        {
          "label": "View in browser",
          "href": "{{viewUrl}}"
        }
      ],
      "lines": [
        "ACME",
        "123 Example Street, Springfield",
        "You're receiving this email because you signed up for updates from Acme.",
        "© 2026 Acme"
      ],
      "after": 115.2
    }
  ]
}
