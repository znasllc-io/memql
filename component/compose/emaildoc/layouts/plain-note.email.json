{
  "subject": "A quick note from us",
  "preheader": "Just a few words.",
  "layout": "builtin:plain-note",
  "theme": {
    "page": "#f1f1f1",
    "canvas": "#ffffff",
    "primary": "#2f2f2f",
    "secondary": "#595959",
    "accent": "#3d3d3d",
    "tint": "#f5f5f5",
    "text": "#1c1c1c",
    "muted": "#666666",
    "headingFont": "Georgia",
    "bodyFont": "Arial"
  },
  "blocks": [
    {
      "id": "logo",
      "type": "image",
      "role": "brand",
      "padding": [
        0,
        0,
        0,
        0
      ],
      "alt": "Your logo",
      "width": 600,
      "height": 155,
      "bleed": true
    },
    {
      "id": "letter",
      "type": "section",
      "role": "content",
      "padding": [
        24,
        0,
        16,
        0
      ],
      "background": "canvas",
      "maxWidth": 502,
      "blocks": [
        {
          "id": "greeting",
          "type": "heading",
          "role": "content",
          "text": "Hello there",
          "size": 26.7,
          "lineHeight": 29.37,
          "color": "primary",
          "align": "left",
          "weight": 700,
          "font": "heading"
        },
        {
          "id": "body",
          "type": "text",
          "role": "content",
          "text": "Thank you for being with us. We wanted to share a few words.\n\nWe appreciate your support, and we are always happy to hear from you.",
          "size": 16,
          "lineHeight": 24,
          "align": "left"
        }
      ]
    },
    {
      "id": "signature",
      "type": "columns",
      "role": "brand",
      "inset": [
        0,
        39.81606744178767,
        0,
        39.81606744178767
      ],
      "maxWidth": 473,
      "columns": [
        {
          "width": 48.31,
          "blocks": [
            {
              "id": "signature-photo",
              "type": "image",
              "alt": "Founder photo",
              "width": 183,
              "height": 191
            }
          ]
        },
        {
          "width": 48.31,
          "blocks": [
            {
              "id": "signature-space",
              "type": "spacer",
              "height": 70.4
            },
            {
              "id": "signature-name",
              "type": "image",
              "alt": "Founder signature",
              "width": 184,
              "height": 32
            },
            {
              "id": "signature-title",
              "type": "text",
              "text": "Founder of Acme",
              "size": 14,
              "lineHeight": 16,
              "align": "center"
            }
          ]
        }
      ]
    },
    {
      "id": "footer",
      "type": "footer",
      "role": "brand",
      "size": 14.7,
      "lineHeight": 22.4,
      "color": "muted",
      "linkColor": "secondary",
      "background": "white",
      "font": "base",
      "letterSpacing": "-0.025em",
      "inset": [
        20.47555319531862,
        24,
        20.47555319531862,
        24
      ],
      "maxWidth": 552,
      "cellPadding": 13,
      "links": [
        {
          "label": "Contact us",
          "href": ""
        },
        {
          "label": "Manage preferences",
          "href": "{{preferencesUrl}}"
        },
        {
          "label": "Unsubscribe",
          "href": "{{unsubscribeUrl}}"
        },
        {
          "label": "View in browser",
          "href": "{{viewUrl}}"
        }
      ],
      "lines": [
        "ACME\n123 Example Street, Springfield",
        "You're receiving this email because you signed up for updates from Acme.",
        "© 2026 Acme"
      ],
      "lineGap": 16
    }
  ]
}
