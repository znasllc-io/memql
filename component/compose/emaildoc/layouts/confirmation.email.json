{
  "subject": "Please confirm your subscription",
  "preheader": "One click and you're on the list.",
  "layout": "builtin:confirmation",
  "theme": {
    "page": "#eef0f3",
    "canvas": "#5b8fb9",
    "primary": "#1f5f8b",
    "secondary": "#5b8fb9",
    "accent": "#d2322d",
    "tint": "#f6f4ef",
    "text": "#1c1c1c",
    "muted": "#696e77",
    "headingFont": "Georgia",
    "bodyFont": "Arial"
  },
  "blocks": [
    {
      "id": "top",
      "type": "spacer",
      "role": "brand",
      "height": 48
    },
    {
      "id": "logo",
      "type": "image",
      "role": "brand",
      "alt": "Your logo",
      "width": 226,
      "height": 128
    },
    {
      "id": "rule-top",
      "type": "divider",
      "role": "brand",
      "color": "primary"
    },
    {
      "id": "headline",
      "type": "heading",
      "role": "content",
      "text": "Welcome aboard!",
      "size": 48,
      "lineHeight": 52.8,
      "color": "white",
      "italic": true,
      "weight": 700,
      "font": "heading"
    },
    {
      "id": "subhead",
      "type": "heading",
      "role": "content",
      "text": "You'll get our best ideas and updates, straight to your inbox.",
      "size": 26.7,
      "lineHeight": 29.37,
      "color": "white",
      "weight": 700,
      "font": "body"
    },
    {
      "id": "hero",
      "type": "image",
      "role": "content",
      "alt": "Hero picture",
      "width": 552,
      "height": 218
    },
    {
      "id": "confirm",
      "type": "button",
      "role": "content",
      "size": 20.2,
      "color": "primary",
      "width": 303,
      "href": "{{confirmUrl}}",
      "label": "Confirm my address",
      "paddingY": 11
    },
    {
      "id": "note",
      "type": "text",
      "role": "content",
      "text": "If you didn't sign up, you can ignore this email.",
      "size": 14.7,
      "lineHeight": 22.4,
      "color": "text",
      "align": "center"
    },
    {
      "id": "rule-bottom",
      "type": "divider",
      "role": "brand",
      "color": "primary"
    },
    {
      "id": "footer",
      "type": "footer",
      "role": "brand",
      "padding": [
        0,
        0,
        24,
        0
      ],
      "size": 14.7,
      "lineHeight": 22.4,
      "gap": 38.4,
      "color": "muted",
      "linkColor": "primary",
      "background": "white",
      "font": "base",
      "letterSpacing": "-0.025em",
      "inset": [
        20.47555319531862,
        24,
        20.47555319531862,
        24
      ],
      "maxWidth": 552,
      "cellPadding": 13,
      "links": [
        {
          "label": "Contact us",
          "href": ""
        },
        {
          "label": "Manage preferences",
          "href": "{{preferencesUrl}}"
        },
        {
          "label": "Unsubscribe",
          "href": "{{unsubscribeUrl}}"
        },
        {
          "label": "View in browser",
          "href": "{{viewUrl}}"
        }
      ],
      "lines": [
        "ACME",
        "123 Example Street, Springfield",
        "You're receiving this email because you signed up for updates from Acme.",
        "© 2026 Acme"
      ],
      "after": 22.4
    }
  ]
}
