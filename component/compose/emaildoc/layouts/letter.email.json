          "type": "heading",
          "role": "content",
          "text": "Thanks for joining us",
          "size": 37.3,
          "lineHeight": 37.3,
          "color": "primary",
          "italic": true,
          "weight": 400,
          "font": "heading",
          "letterSpacing": "-0.032em"
