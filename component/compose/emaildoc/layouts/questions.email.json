{
  "subject": "Your questions, answered",
  "preheader": "The answers you asked for.",
  "layout": "builtin:questions",
  "theme": {
    "page": "#f1f1f1",
    "canvas": "#ffffff",
    "primary": "#2f2f2f",
    "secondary": "#595959",
    "accent": "#3d3d3d",
    "tint": "#f5f5f5",
    "text": "#1c1c1c",
    "muted": "#666666",
    "headingFont": "Georgia",
    "bodyFont": "Arial"
  },
  "blocks": [
    {
      "id": "logo",
      "type": "image",
      "role": "brand",
      "padding": [
        0,
        0,
        0,
        0
      ],
      "alt": "Your logo",
      "width": 600,
      "height": 155,
      "bleed": true
    },
    {
      "id": "headline",
      "type": "heading",
      "role": "content",
      "padding": [
        32,
        24,
        8,
        24
      ],
      "text": "Your questions, answered",
      "size": 26.7,
      "lineHeight": 29.37,
      "color": "primary",
      "align": "center",
      "weight": 700,
      "font": "heading"
    },
    {
      "id": "intro",
      "type": "text",
      "role": "content",
      "padding": [
        0,
        24,
        24,
        24
      ],
      "text": "Here are the questions we hear most often.",
      "size": 16,
      "lineHeight": 24,
      "align": "center"
    },
    {
      "id": "qa",
      "type": "section",
      "role": "content",
      "maxWidth": 502,
      "blocks": [
        {
          "id": "qa-question",
          "type": "text",
          "role": "content",
          "padding": [
            0,
            0,
            6,
            0
          ],
          "text": "Question goes here?",
          "size": 16,
          "lineHeight": 24,
          "align": "left",
          "weight": 700
        },
        {
          "id": "qa-answer",
          "type": "text",
          "role": "content",
          "padding": [
            0,
            0,
            24,
            0
          ],
          "text": "A short, clear answer in a sentence or two.",
          "size": 14.7,
          "lineHeight": 19.2,
          "align": "left"
        }
      ]
    },
    {
      "id": "reply",
      "type": "section",
      "role": "brand",
      "cellPadding": 0,
      "blocks": [
        {
          "id": "reply-heading",
          "type": "heading",
          "padding": [
            0,
            0,
            5.35,
            0
          ],
          "text": "Got a question about this?",
          "size": 21.3,
          "lineHeight": 21.3,
          "color": "secondary",
          "italic": true,
          "weight": 700
        },
        {
          "id": "reply-button",
          "type": "button",
          "size": 20.3,
          "color": "primary",
          "width": 305,
          "label": "Write to us",
          "paddingY": 8
        },
        {
          "id": "reply-note",
          "type": "text",
          "text": "We read every reply.",
          "size": 12,
          "lineHeight": 22.4,
          "align": "center",
          "italic": true
        }
      ]
    },
    {
      "id": "footer",
      "type": "footer",
      "role": "brand",
      "size": 14.7,
      "lineHeight": 22.4,
      "color": "muted",
      "linkColor": "secondary",
      "background": "white",
      "font": "base",
      "letterSpacing": "-0.025em",
      "inset": [
        20.47555319531862,
        24,
        20.47555319531862,
        24
      ],
      "maxWidth": 552,
      "cellPadding": 13,
      "links": [
        {
          "label": "Contact us",
          "href": ""
        },
        {
          "label": "Manage preferences",
          "href": "{{preferencesUrl}}"
        },
        {
          "label": "Unsubscribe",
          "href": "{{unsubscribeUrl}}"
        },
        {
          "label": "View in browser",
          "href": "{{viewUrl}}"
        }
      ],
      "lines": [
        "ACME\n123 Example Street, Springfield",
        "You're receiving this email because you signed up for updates from Acme.",
        "© 2026 Acme"
      ],
      "lineGap": 16
    }
  ]
}
