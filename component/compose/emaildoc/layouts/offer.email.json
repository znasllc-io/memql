{
  "subject": "A little something for you",
  "preheader": "Use your code at checkout.",
  "layout": "builtin:offer",
  "theme": {
    "page": "#f1f1f1",
    "canvas": "#ffffff",
    "primary": "#2f2f2f",
    "secondary": "#595959",
    "accent": "#3d3d3d",
    "tint": "#f5f5f5",
    "text": "#1c1c1c",
    "muted": "#666666",
    "headingFont": "Georgia",
    "bodyFont": "Arial"
  },
  "blocks": [
    {
      "id": "logo",
      "type": "image",
      "role": "brand",
      "padding": [
        0,
        0,
        0,
        0
      ],
      "alt": "Your logo",
      "width": 600,
      "height": 155,
      "bleed": true
    },
    {
      "id": "offer-headline",
      "type": "heading",
      "role": "content",
      "padding": [
        32,
        24,
        12,
        24
      ],
      "text": "10% off your first order",
      "size": 26.7,
      "lineHeight": 29.37,
      "color": "primary",
      "align": "center",
      "weight": 700,
      "font": "heading"
    },
    {
      "id": "offer-text",
      "type": "text",
      "role": "content",
      "padding": [
        4,
        40,
        16,
        40
      ],
      "text": "Thank you for joining us. Use this code at checkout to save on anything in the shop.",
      "size": 16,
      "lineHeight": 24,
      "align": "center"
    },
    {
      "id": "code",
      "type": "highlight",
      "role": "content",
      "padding": [
        8,
        24,
        24,
        24
      ],
      "text": "WELCOME10",
      "size": 26.7,
      "lineHeight": 32.04,
      "gap": 0,
      "color": "primary",
      "background": "tint",
      "weight": 700,
      "font": "body",
      "letterSpacing": "0.1em"
    },
    {
      "id": "cta",
      "type": "button",
      "role": "content",
      "size": 20.4,
      "color": "accent",
      "width": 306,
      "label": "Shop now",
      "paddingY": 11
    },
    {
      "id": "fine-print",
      "type": "text",
      "role": "content",
      "padding": [
        16,
        24,
        16,
        24
      ],
      "text": "One use per customer. Offer ends 31 December.",
      "size": 12,
      "lineHeight": 18,
      "color": "muted",
      "align": "center"
    },
    {
      "id": "social",
      "type": "social",
      "role": "brand",
      "padding": [
        0,
        24,
        15,
        24
      ],
      "links": [
        {
          "network": "Instagram",
          "href": ""
        },
        {
          "network": "YouTube",
          "href": ""
        },
        {
          "network": "LinkedIn",
          "href": ""
        }
      ]
    },
    {
      "id": "footer",
      "type": "footer",
      "role": "brand",
      "size": 14.7,
      "lineHeight": 22.4,
      "color": "muted",
      "linkColor": "secondary",
      "background": "white",
      "font": "base",
      "letterSpacing": "-0.025em",
      "inset": [
        20.47555319531862,
        24,
        20.47555319531862,
        24
      ],
      "maxWidth": 552,
      "cellPadding": 13,
      "links": [
        {
          "label": "Contact us",
          "href": ""
        },
        {
          "label": "Manage preferences",
          "href": "{{preferencesUrl}}"
        },
        {
          "label": "Unsubscribe",
          "href": "{{unsubscribeUrl}}"
        },
        {
          "label": "View in browser",
          "href": "{{viewUrl}}"
        }
      ],
      "lines": [
        "ACME\n123 Example Street, Springfield",
        "You're receiving this email because you signed up for updates from Acme.",
        "© 2026 Acme"
      ],
      "lineGap": 16
