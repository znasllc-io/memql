{
  "subject": "How did we do?",
  "preheader": "Tell us what you think.",
  "layout": "builtin:review-request",
  "theme": {
    "page": "#f1f1f1",
    "canvas": "#ffffff",
    "primary": "#2f2f2f",
    "secondary": "#595959",
    "accent": "#3d3d3d",
    "tint": "#f5f5f5",
    "text": "#1c1c1c",
    "muted": "#666666",
    "headingFont": "Georgia",
    "bodyFont": "Arial"
  },
  "blocks": [
    {
      "id": "logo",
      "type": "image",
      "role": "brand",
      "padding": [
        0,
        0,
        0,
        0
      ],
      "alt": "Your logo",
      "width": 600,
      "height": 155,
      "bleed": true
    },
    {
      "id": "headline",
      "type": "heading",
      "role": "content",
      "padding": [
        32,
        24,
        24,
        24
      ],
      "text": "How did we do?",
      "size": 26.7,
      "lineHeight": 29.37,
      "color": "primary",
      "align": "center",
      "weight": 700,
      "font": "heading"
    },
    {
      "id": "product",
      "type": "image",
      "role": "content",
      "padding": [
        0,
        24,
        16,
        24
      ],
      "alt": "Product picture",
      "width": 300,
      "height": 300
    },
    {
      "id": "text",
      "type": "text",
      "role": "content",
      "padding": [
        8,
        40,
        24,
        40
