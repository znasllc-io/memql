package webtempl

// AdminUserView is the per-user projection used by the admin pages.
// Mirrors the admin package's userView struct.
type AdminUserView struct {
	ID              string
	DisplayName     string
	FirstName       string
	LastName        string
	PrimaryEmail    string
	Phone           string
	PrimaryRole     string
	Gender          string
	Birthdate       string
	Role            string
	Internal        bool
	Active          bool
	SuspendedAt     string
	SuspendedReason string
	CreatedAt       string
}

// AdminUsersDetailData drives /admin/users/detail.
type AdminUsersDetailData struct {
	Layout LayoutData
	Flash  *Flash
	User   AdminUserView
}

templ AdminUsersDetail(data AdminUsersDetailData) {
	@Layout(data.Layout) {
		<div class="card card-full">
			<h1 class="card-title">{ data.User.DisplayName }</h1>
			<p class="card-subtitle">
				<code>{ data.User.ID }</code>
			</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}
			<table class="data">
				<tr><th>Email</th><td>{ data.User.PrimaryEmail }</td></tr>
				<tr><th>Cluster role</th><td>{ data.User.Role }</td></tr>
				<tr><th>Internal</th><td>
					if data.User.Internal {
						{ "yes" }
					} else {
						{ "no" }
					}
				</td></tr>
				<tr><th>Active</th><td>
					if data.User.Active {
						{ "yes" }
					} else {
						{ "no" }
					}
				</td></tr>
				<tr><th>Suspended</th><td>
					if data.User.SuspendedAt != "" {
						{ "Yes — " + data.User.SuspendedAt }
						if data.User.SuspendedReason != "" {
							{ ": " + data.User.SuspendedReason }
						}
					} else {
						{ "No" }
					}
				</td></tr>
				<tr><th>Member since</th><td>{ data.User.CreatedAt }</td></tr>
			</table>
		</div>
		<div class="card card-full">
			<h2 class="card-title">Profile</h2>
			<p class="card-subtitle">
				CoPresent blocks access at the "Account Setup Required" wall
				until every required field below is set. Fill these in on
				behalf of the user before they hit the app.
			</p>
			<form method="POST" action="/admin/users/profile" data-submit-once class="profile-form">
				@CSRFField(data.Layout.CSRFToken)
				<input type="hidden" name="user_id" value={ data.User.ID }/>
				<div class="form-row">
					<label for="first_name">
						First name
						if data.User.FirstName == "" {
							<span class="badge badge-warn ml-1">Not set</span>
						} else {
							<span class="badge ml-1">{ "Set: " + data.User.FirstName }</span>
						}
					</label>
					<input id="first_name" name="first_name" type="text" maxlength="80" autocomplete="given-name" value={ data.User.FirstName } placeholder="e.g. Alex"/>
					<span class="help">Given name. Flows to the JWT as <code>given_name</code> and into the user's CoPresent profile.</span>
				</div>
				<div class="form-row">
					<label for="last_name">
						Last name
						if data.User.LastName == "" {
							<span class="badge badge-warn ml-1">Not set</span>
						} else {
							<span class="badge ml-1">{ "Set: " + data.User.LastName }</span>
						}
					</label>
					<input id="last_name" name="last_name" type="text" maxlength="80" autocomplete="family-name" value={ data.User.LastName } placeholder="e.g. Stone"/>
					<span class="help">Family name. Stamped onto the JWT as <code>family_name</code>.</span>
				</div>
				<div class="form-row">
					<label for="display_name">
						Display name
					</label>
					<input id="display_name" name="display_name" type="text" maxlength="120" autocomplete="name" value={ data.User.DisplayName } placeholder="Auto: First + Last"/>
					<span class="help">Shown in chat and the app header. Leave blank to derive it from First + Last; fill in to override.</span>
				</div>
				<div class="form-row">
					<label for="phone">
						Phone number
						if data.User.Phone == "" {
							<span class="badge badge-warn ml-1">Not set</span>
						} else {
							<span class="badge ml-1">{ "Set: " + data.User.Phone }</span>
						}
					</label>
					<input id="phone" name="phone" type="tel" inputmode="tel" maxlength="32" autocomplete="tel" placeholder="+1 555 010 0100" pattern="^[+0-9 ()\-]{7,}$" value={ data.User.Phone }/>
					<span class="help">E.164 preferred (e.g. +1 555 010 0100). Country code, then number. Spaces and dashes are fine.</span>
				</div>
				<div class="form-row">
					<label for="primary_role">
						Role at organization
						if data.User.PrimaryRole == "" {
							<span class="badge badge-warn ml-1">Not set</span>
						} else {
							<span class="badge ml-1">Set</span>
						}
					</label>
					<input id="primary_role" name="primary_role" type="text" maxlength="80" placeholder="e.g. Engineer, Sales, Account Manager" value={ data.User.PrimaryRole }/>
					<span class="help">Free-form job title. Distinct from the cluster auth role below.</span>
				</div>
				<div class="form-row">
					<label for="gender">
						Gender
						if data.User.Gender == "" {
							<span class="badge badge-warn ml-1">Not set</span>
						} else {
							<span class="badge ml-1">{ "Set: " + data.User.Gender }</span>
						}
					</label>
					<select id="gender" name="gender">
						<option value="" selected?={ data.User.Gender == "" }>— select —</option>
						<option value="female" selected?={ data.User.Gender == "female" }>Female</option>
						<option value="male" selected?={ data.User.Gender == "male" }>Male</option>
						<option value="nonbinary" selected?={ data.User.Gender == "nonbinary" }>Nonbinary</option>
						<option value="other" selected?={ data.User.Gender == "other" }>Other</option>
						<option value="prefer_not_to_say" selected?={ data.User.Gender == "prefer_not_to_say" }>Prefer not to say</option>
					</select>
					<span class="help">Used to address the user appropriately in agent prose. "Prefer not to say" satisfies the gate without asking.</span>
				</div>
				<div class="form-row">
					<label for="birthdate">
						Date of birth
						if data.User.Birthdate == "" {
							<span class="badge badge-warn ml-1">Not set</span>
						} else {
							<span class="badge ml-1">{ "Set: " + data.User.Birthdate }</span>
						}
					</label>
					<input id="birthdate" name="birthdate" type="date" min="1900-01-01" max="2010-12-31" autocomplete="bday" value={ data.User.Birthdate }/>
					<span class="help">YYYY-MM-DD. Used for age-aware agent behavior; not displayed in the app.</span>
				</div>
				<button type="submit" class="btn btn-primary" data-pending-label="Saving...">Save profile</button>
			</form>
		</div>
		<div class="card card-full">
			<h2 class="card-title">Change cluster role</h2>
			<form method="POST" action="/admin/users/role" data-submit-once>
				@CSRFField(data.Layout.CSRFToken)
				<input type="hidden" name="user_id" value={ data.User.ID }/>
				<div class="form-row">
					<label for="role">New role</label>
					<select id="role" name="role">
						<option value="owner" selected?={ data.User.Role == "owner" }>owner</option>
						<option value="admin" selected?={ data.User.Role == "admin" }>admin</option>
						<option value="writer" selected?={ data.User.Role == "writer" }>writer</option>
						<option value="reader" selected?={ data.User.Role == "reader" }>reader</option>
					</select>
				</div>
				<button type="submit" class="btn btn-primary" data-pending-label="Saving...">Update role</button>
			</form>
		</div>
		<div class="card card-full">
			if data.User.SuspendedAt != "" {
				<h2 class="card-title">Lift suspension</h2>
				<form method="POST" action="/admin/users/unsuspend" data-submit-once>
					@CSRFField(data.Layout.CSRFToken)
					<input type="hidden" name="user_id" value={ data.User.ID }/>
					<button type="submit" class="btn btn-primary" data-pending-label="Lifting...">Restore access</button>
				</form>
			} else {
				<h2 class="card-title">Suspend account</h2>
				<p class="text-muted">
					Suspended users keep their data but cannot sign in. Lift the suspension at any time.
				</p>
				<form method="POST" action="/admin/users/suspend" data-submit-once>
					@CSRFField(data.Layout.CSRFToken)
					<input type="hidden" name="user_id" value={ data.User.ID }/>
					<div class="form-row">
						<label for="reason">Reason (optional, internal-only)</label>
						<input id="reason" name="reason" type="text" maxlength="200"/>
					</div>
					<button type="submit" class="btn btn-danger" data-pending-label="Suspending...">Suspend access</button>
				</form>
			}
		</div>
		<p class="text-small mt-2"><a href="/admin/users">&larr; Back to users</a></p>
	}
}
