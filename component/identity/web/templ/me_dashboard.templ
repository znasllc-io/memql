package webtempl

// MeDashboardData drives /me/. The page is a thin shell — app.js
// hydrates the overview panel by fetching account data from
// /auth/refresh and friends.
type MeDashboardData struct {
	Layout LayoutData

	// SharedMailboxNotice is true when this account's address is flagged as
	// a shared mailbox and sign-in links are still on (memql#4304).
	//
	// BOTH CONDITIONS, because the notice is a call to action and there is
	// nothing left to do once links are off. Showing it to somebody who has
	// already turned them off would train them to ignore it.
	SharedMailboxNotice bool
}

templ MeDashboard(data MeDashboardData) {
	@Layout(data.Layout) {
		<div class="me-shell">
			@meSidebar("overview", false)
			<section>
				if data.SharedMailboxNotice {
					<div class="alert alert-warning">
						This account's address looks like a shared mailbox. Anyone who can
						read it can request a sign-in link and enter this account.
						<a href="/me/settings">Consider turning sign-in links off</a> and
						using a passkey.
					</div>
				}
				<div class="card card-wide">
					<h1 class="card-title">Your account</h1>
					<div data-content="overview">
						<p class="text-muted"><span class="spinner"></span> Loading your account&hellip;</p>
					</div>
				</div>
			</section>
		</div>
	}
}
