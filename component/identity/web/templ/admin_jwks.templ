package webtempl

// AdminJWKSData drives /admin/jwks. Empty `PreviousKID` flips the
// page into "no rotation in flight" mode.
type AdminJWKSData struct {
	Layout            LayoutData
	Flash             *Flash
	RotationDays      int
	OverlapHours      int
	CurrentKID        string
	CurrentCreatedAt  string
	CurrentAge        string
	PreviousKID       string
	PreviousRetiresAt string
}

templ AdminJWKS(data AdminJWKSData) {
	@Layout(data.Layout) {
		<div class="card card-full">
			<h1 class="card-title">JWT signing keys</h1>
			<p class="card-subtitle">
				The cluster signs every access token with the current Ed25519
				keypair. Auto-rotates every { formatInt(data.RotationDays) } days; the
				previous key stays in JWKS for { formatInt(data.OverlapHours) }h after
				rotation so in-flight tokens still verify.
			</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}
			<h2>Current key</h2>
			<table class="data">
				<tr><th>kid</th><td><code>{ data.CurrentKID }</code></td></tr>
				<tr><th>Created</th><td>{ data.CurrentCreatedAt }</td></tr>
				<tr><th>Age</th><td>{ data.CurrentAge }</td></tr>
			</table>
			if data.PreviousKID != "" {
				<h2>Previous key (overlap window)</h2>
				<table class="data">
					<tr><th>kid</th><td><code>{ data.PreviousKID }</code></td></tr>
					<tr><th>Retires at</th><td>{ data.PreviousRetiresAt }</td></tr>
				</table>
			} else {
				<p class="text-muted"><em>No previous key — no rotation in flight.</em></p>
			}
			<h2>Manual rotation</h2>
			<p class="text-muted">Forces an immediate rotation. Use this when you suspect the current private key has leaked. The previous key remains in JWKS for the configured overlap window so existing access tokens continue to validate during the handoff.</p>
			<form method="POST" action="/admin/jwks/rotate" data-submit-once>
				@CSRFField(data.Layout.CSRFToken)
				<button type="submit" class="btn btn-danger" data-pending-label="Rotating...">Rotate now</button>
			</form>
		</div>
		<div class="card card-full">
			<h2 class="card-title">Public JWKS feed</h2>
			<p class="text-muted">
				The cluster publishes its public keys at
				<a href="/.well-known/jwks.json"><code>/.well-known/jwks.json</code></a>.
				Other nodes fetch and cache this set to verify access tokens
				locally without calling back into the identity service on every
				request.
			</p>
		</div>
	}
}
