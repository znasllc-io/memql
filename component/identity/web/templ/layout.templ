// Package webtempl owns the rendered HTML for the identity web app.
//
// Each page is a templ component (.templ file). Templates are
// compile-time type-checked: a typo in a field name (.PrefillFoo
// vs .PrefillBar) is a build error, not a runtime template-execution
// truncation. The generated *_templ.go files live alongside their
// sources and are produced by `templ generate` (run via
// `make identity` and inside the Docker build).
//
// Layout composition: every page wraps Layout(LayoutData, ...).
// The outer call passes brand + nav + extra-script metadata; the
// children render the page-specific body. Stimulus controllers are
// wired by the layout via ExtraScripts; htmx is loaded globally so
// any component can use hx-* attributes without extra ceremony.
package webtempl

import "strconv"

type LayoutData struct {
	Title             string
	BrandName         string
	BrandPrimaryColor string
	BrandLogoDataURI  string
	BrandIconDataURI  string
	Year              int
	NavLinks          []NavLink
	ExtraScripts      []string
	DataMe            bool

	// Path is the request URL path. Used to mark the active nav link
	// in the header. When empty, no nav link is highlighted.
	Path string

	// Asset resolves a /static/* path to its content-hashed URL.
	// Defaults to identity-pass when the layout caller forgets to
	// wire it; the cache strategy still works (no-store on HTML
	// + immutable on /static/*) but without the hash bump.
	Asset func(string) string

	// CSRFToken is the per-request double-submit-cookie token the
	// templ forms render into their hidden `_csrf` field. Populated
	// by Server.LayoutData from the request context; empty when no
	// CSRF middleware is wired (defensive -- the templ helper just
	// emits nothing in that case rather than failing the render).
	// See memql#111 + component/identity/web/csrf.go.
	CSRFToken string
}

// CSRFField renders the hidden `_csrf` input that every
// CSRF-protected POST form needs. Emits nothing when CSRFToken is
// empty so views rendered outside the CSRF-middleware chain
// (tests, the rare un-mounted path) don't surface a stray hidden
// input. See memql#111.
templ CSRFField(token string) {
	if token != "" {
		<input type="hidden" name="_csrf" value={ token }/>
	}
}

type NavLink struct {
	Href  string
	Label string
}

// asset is the safe Asset accessor. Used inside templ expressions
// where Asset itself might be nil.
func (d LayoutData) asset(p string) string {
	if d.Asset == nil {
		return p
	}
	return d.Asset(p)
}

// formatInt is the standard int->string helper used inside templ
// expressions. templ rejects non-string interpolations so every
// numeric field is wrapped through this.
func formatInt(n int) string { return strconv.Itoa(n) }

// navLinkClass returns "active" when the link's Href matches the
// request path. Used by the layout to highlight the current section
// in the top nav.
//
// Match rules:
//   - exact path match always wins (/admin/users == /admin/users)
//   - container-style hrefs that end in "/" match only exactly,
//     so /admin/ does not eat /admin/users
//   - leaf hrefs (no trailing slash) match their own subtree, so
//     /admin/users also lights up on /admin/users/detail
func navLinkClass(linkHref, currentPath string) string {
	if linkHref == "" || currentPath == "" {
		return ""
	}
	if linkHref == currentPath {
		return "active"
	}
	// Container hrefs (trailing slash) match only exactly. Otherwise
	// every /admin/* page would also light up the /admin/ overview link.
	if len(linkHref) > 0 && linkHref[len(linkHref)-1] == '/' {
		return ""
	}
	// Leaf href: light up on its own subtree only when followed by '/'
	// so /admin/users does not match /admin/users-archive.
	if len(currentPath) > len(linkHref) && currentPath[:len(linkHref)] == linkHref && currentPath[len(linkHref)] == '/' {
		return "active"
	}
	return ""
}

// brandHover derives a darker shade of the brand color for the
// hover-state CSS variable. Operates on the #RRGGBB form the
// wizard captures; falls back to the base color when the input
// doesn't parse as hex (so `bg-brand-hover` never breaks layout).
func brandHover(brand string) string {
	if len(brand) != 7 || brand[0] != '#' {
		return brand
	}
	parseHex := func(s string) int {
		n := 0
		for _, c := range s {
			n <<= 4
			switch {
			case c >= '0' && c <= '9':
				n |= int(c - '0')
			case c >= 'a' && c <= 'f':
				n |= int(c-'a') + 10
			case c >= 'A' && c <= 'F':
				n |= int(c-'A') + 10
			default:
				return -1
			}
		}
		return n
	}
	r := parseHex(brand[1:3])
	g := parseHex(brand[3:5])
	b := parseHex(brand[5:7])
	if r < 0 || g < 0 || b < 0 {
		return brand
	}
	// Darken by ~20% (multiply each channel by 0.8).
	r = (r * 4) / 5
	g = (g * 4) / 5
	b = (b * 4) / 5
	hex := "0123456789abcdef"
	return "#" + string([]byte{
		hex[(r>>4)&0xf], hex[r&0xf],
		hex[(g>>4)&0xf], hex[g&0xf],
		hex[(b>>4)&0xf], hex[b&0xf],
	})
}

templ Layout(data LayoutData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="referrer" content="strict-origin-when-cross-origin"/>
			<meta name="robots" content="noindex,nofollow"/>
			<title>{ data.Title } — { data.BrandName }</title>
			<link rel="stylesheet" href={ data.asset("/static/app.css") }/>
		</head>
		<body data-me?={ data.DataMe } style={ "--brand-primary: " + data.BrandPrimaryColor + "; --brand-primary-hover: " + brandHover(data.BrandPrimaryColor) }>
			<div class="shell">
				<header class="shell-header">
					<a href="/" class="brand" aria-label={ data.BrandName + " home" }>
						if data.BrandLogoDataURI != "" {
							<img src={ data.BrandLogoDataURI } alt={ data.BrandName }/>
						} else {
							<span>{ data.BrandName }</span>
						}
					</a>
					if len(data.NavLinks) > 0 {
						<nav class="nav">
							for _, n := range data.NavLinks {
								<a href={ templ.SafeURL(n.Href) } class={ navLinkClass(n.Href, data.Path) }>{ n.Label }</a>
							}
						</nav>
					}
				</header>
				<main class="shell-main">
					{ children... }
				</main>
				<footer class="shell-footer">
					<span>© { strconv.Itoa(data.Year) } { data.BrandName }</span>
					<a href="/legal/tos">Terms of Service</a>
					<a href="/legal/privacy">Privacy</a>
				</footer>
			</div>
			<!--
				Script load order:
				  1. app.js — defines window.IdentityStimulus (registration façade);
				     schedules Stimulus.Application.start() for DOMContentLoaded.
				  2. htmx — declarative server-driven swaps.
				  3. stimulus — class-based controllers for stateful client behavior.
				  4. ExtraScripts — page-specific controller files.
				All deferred so they execute in document order before DOMContentLoaded.
			-->
			<script src={ data.asset("/static/app.js") } defer></script>
			<script src={ data.asset("/static/htmx.min.js") } defer></script>
			<script src={ data.asset("/static/stimulus.umd.min.js") } defer></script>
			for _, src := range data.ExtraScripts {
				<script src={ src } defer></script>
			}
		</body>
	</html>
}
