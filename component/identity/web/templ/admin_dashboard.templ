package webtempl

// AdminAuditView is the per-row projection rendered into admin audit
// tables. Mirrors the admin package's auditView struct field-for-field.
type AdminAuditView struct {
	ID            string
	OccurredAt    string
	Category      string
	Action        string
	ActorEmail    string
	ActorRole     string
	TargetID      string
	TargetEmail   string
	Outcome       string
	FailureReason string
	SourceIP      string
}

// AdminDashboardData drives /admin/.
type AdminDashboardData struct {
	Layout        LayoutData
	Flash         *Flash
	Mode          string
	UserCount     int
	AuditCount    int
	AuditWindow   string
	AuditEvents   []AdminAuditView
	CurrentKID    string
	CurrentKeyAge string
}

templ AdminDashboard(data AdminDashboardData) {
	@Layout(data.Layout) {
		<div class="card card-full">
			<h1 class="card-title">Cluster overview</h1>
			<p class="card-subtitle">
				Live counts and the most recent audit events. Numbers refresh on
				each page load.
			</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}
			<div class="stat-grid">
				<div class="stat">
					<div class="stat-label">Active users</div>
					<div class="stat-value">{ formatInt(data.UserCount) }</div>
				</div>
				<div class="stat">
					<div class="stat-label">Audit events</div>
					<div class="stat-value">{ formatInt(data.AuditCount) }</div>
					<div class="stat-meta">{ data.AuditWindow }</div>
				</div>
				<div class="stat">
					<div class="stat-label">Signing key</div>
					<div class="stat-value text-base"><code>{ data.CurrentKID }</code></div>
					<div class="stat-meta">rotated { data.CurrentKeyAge } ago</div>
				</div>
				<div class="stat">
					<div class="stat-label">Registration</div>
					<div class="stat-value text-base">{ data.Mode }</div>
				</div>
			</div>
		</div>
		<div class="card card-full">
			<h2 class="card-title">Recent audit activity</h2>
			if len(data.AuditEvents) == 0 {
				<p class="text-muted">No audit events recorded yet.</p>
			} else {
				<div class="table-wrap">
					<table class="data">
						<thead>
							<tr><th>When</th><th>Category</th><th>Action</th><th>Actor</th><th>Outcome</th></tr>
						</thead>
						<tbody>
							for _, ev := range data.AuditEvents {
								<tr>
									<td>{ ev.OccurredAt }</td>
									<td>{ ev.Category }</td>
									<td><code>{ ev.Action }</code></td>
									<td>
										if ev.ActorEmail != "" {
											{ ev.ActorEmail }
										} else {
											<span class="text-subtle">(system)</span>
										}
									</td>
									<td>
										if ev.Outcome == "success" {
											<span class="badge">{ ev.Outcome }</span>
										} else {
											<span class="badge badge-danger">{ ev.Outcome }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<p class="text-small text-muted mt-4 mb-0">
					<a href="/admin/audit">See full audit log &rarr;</a>
				</p>
			}
		</div>
	}
}
