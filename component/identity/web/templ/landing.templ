package webtempl

// LandingData drives the magic-link confirmation page -- the one page a
// click on a sign-in link can reach (memql#4302).
//
// Three states, chosen by which fields are set:
//
//	Problem != ""  a terminal message: invalid, expired, already used,
//	               already confirmed, wrong device. No form.
//	Approved       "we told the other device"; the person is finished here.
//	otherwise      the confirmation form, whose only control is Continue.
//
// THE FORM HAS NO EMAIL FIELD ANY MORE. It used to ask the visitor to
// re-type their address, which proved nothing (the address is in the mailbox
// they just read it from) and taught people to type their email into a page
// reached from a link. The page now STATES the account -- masked -- and the
// hidden token is the credential.
type LandingData struct {
	Layout LayoutData

	// MagicToken is round-tripped through a hidden field so /auth/landing
	// can verify it. It is the proof of possession, which is why the path
	// needs no CSRF token of its own.
	MagicToken string

	// MaskedEmail names the account without printing it: "j***@acme.test".
	// Present on the form and on the approved page. Naming the account
	// matters -- "confirm sign-in" for an unnamed account is a phishing
	// shape -- but the page is reachable by anybody holding the link.
	MaskedEmail string

	// SameDevice is true when this browser holds the binding cookie, i.e.
	// this is the browser that asked for the link. It only changes the copy;
	// the server decides what Continue does, from the cookie, not from this.
	SameDevice bool

	// Approved marks the cross-device "done, go back" page.
	Approved bool

	// Problem / Message render a terminal state instead of the form.
	Problem string
	Message string
}

templ Landing(data LandingData) {
	@Layout(data.Layout) {
		<div class="card">
			if data.Problem != "" {
				@landingTerminal(data)
			} else if data.Approved {
				@landingApproved(data)
			} else {
				@landingConfirm(data)
			}
		</div>
	}
}

templ landingTerminal(data LandingData) {
	<h1 class="card-title">{ data.Problem }</h1>
	<p class="text-muted">{ data.Message }</p>
	<hr/>
	<p class="text-small text-muted mb-0">
		<a href="/login">Request a new link</a>
	</p>
}

templ landingApproved(data LandingData) {
	<h1 class="card-title">Sign-in confirmed</h1>
	<p class="text-muted">
		Thanks. Go back to the device where you asked for the link -- it is
		finishing signing you in now.
	</p>
	<p class="text-small text-subtle mt-2">
		You are not signed in on this device, and nothing here signs you in.
		If you closed that page, request a new link from the device you want
		to use.
	</p>
	<hr/>
	<p class="text-small text-muted mb-0">
		<a href="/login">Request a new link</a>
	</p>
}

templ landingConfirm(data LandingData) {
	<h1 class="card-title">Confirm sign-in</h1>
	if data.MaskedEmail != "" {
		<p class="text-small text-subtle">Account: <strong>{ data.MaskedEmail }</strong></p>
	}
	if data.SameDevice {
		<p class="text-muted">
			Continue to finish signing in on this device.
		</p>
	} else {
		<p class="text-muted">
			You opened this link on a different device from the one that asked for
			it. Continue to confirm the sign-in, then go back to that device --
			it will finish signing in.
		</p>
		<p class="text-small text-subtle mt-2">
			This will not sign you in here.
		</p>
	}
	<form method="POST" action="/auth/landing" data-submit-once>
		<input type="hidden" name="ml" value={ data.MagicToken }/>
		<button type="submit" class="btn btn-primary btn-block" data-pending-label="Confirming...">Continue</button>
	</form>
	<hr/>
	<p class="text-small text-muted mb-0">
		Didn't ask for this? <a href="/login">Start over</a>, and ignore this page.
	</p>
}
