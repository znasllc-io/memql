package webtempl

// AdminDeploymentsData drives /admin/deployments (memql#726). Env is
// the selected environment (staging | prod). Status carries the
// mapped per-env deployment view; Status.Present is false when the
// reader returned nothing (e.g. an error flash is shown instead).
type AdminDeploymentsData struct {
	Layout LayoutData
	Flash  *Flash
	Env    string
	Status AdminDeploymentStatus
}

// AdminDeploymentStatus is the templ-facing projection of the
// deploy-control DeploymentStatus proto. Plain strings + slices so
// the view stays decoupled from the generated package.
type AdminDeploymentStatus struct {
	Present       bool
	Env           string
	Version       string
	EngineVersion string
	ValidatedAt   string
	Gate          string
	Components    []AdminDeployComponent
	Argo          *AdminDeployArgo
	Rollouts      []AdminDeployRollout
	GateResult    *AdminDeployGate
}

type AdminDeployComponent struct {
	Name   string
	Digest string
	Repo   string
}

type AdminDeployArgo struct {
	SyncStatus       string
	HealthStatus     string
	LastSyncRevision string
	LastSyncAt       string
	OutOfSync        bool
}

type AdminDeployRollout struct {
	Name                 string
	Kind                 string
	Phase                string
	ActiveColor          string
	PreviewColor         string
	CanaryWeight         int
	CurrentStep          int
	LatestAnalysisResult string
}

type AdminDeployGate struct {
	Result string
	RanAt  string
	Legs   []AdminDeployGateLeg
}

type AdminDeployGateLeg struct {
	Name   string
	Passed bool
	Detail string
}

// orDash renders a placeholder when a status field is empty so the
// table cells don't collapse to nothing.
func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

// passIndicator renders the no-emoji pass/fail box used across the
// gate + drift panels: "[x]" passed, "[ ]" failed.
func passIndicator(passed bool) string {
	if passed {
		return "[x]"
	}
	return "[ ]"
}

// envTabClass marks the active env toggle link.
func envTabClass(tab, current string) string {
	if tab == current {
		return "active"
	}
	return ""
}

templ AdminDeployments(data AdminDeploymentsData) {
	@Layout(data.Layout) {
		<div class="card card-full">
			<h1 class="card-title">Deployments</h1>
			<p class="card-subtitle">
				Read-only view of the deployment-v2 machinery: per-env image
				authority, the release lockfile, Argo CD app status, Argo
				Rollouts progressive delivery, and the in-cluster deploy gate.
			</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}
			<nav class="nav">
				<a href="/admin/deployments?env=staging" class={ envTabClass("staging", data.Env) }>staging</a>
				<a href="/admin/deployments?env=prod" class={ envTabClass("prod", data.Env) }>prod</a>
			</nav>
		</div>
		if data.Status.Present {
			@deploymentOverviewPanel(data)
			@deploymentArgoPanel(data.Status.Argo)
			@deploymentRolloutsPanel(data)
			@deploymentGatePanel(data.Status.GateResult)
		}
	}
}

templ deploymentOverviewPanel(data AdminDeploymentsData) {
	{{ st := data.Status }}
	<div class="card card-full">
		<h2 class="card-title">Overview — { orDash(st.Env) }</h2>
		<table class="data">
			<tr><th>Promoted version</th><td><code>{ orDash(st.Version) }</code></td></tr>
			<tr><th>Engine version</th><td><code>{ orDash(st.EngineVersion) }</code></td></tr>
			<tr><th>Validated at</th><td>{ orDash(st.ValidatedAt) }</td></tr>
			<tr><th>Gate</th><td>{ orDash(st.Gate) }</td></tr>
		</table>
		<h3>Component digests</h3>
		if len(st.Components) > 0 {
			<table class="data">
				<tr><th>Component</th><th>Repo</th><th>Digest</th></tr>
				for _, c := range st.Components {
					<tr>
						<td>{ c.Name }</td>
						<td>{ orDash(c.Repo) }</td>
						<td><code>{ orDash(c.Digest) }</code></td>
					</tr>
				}
			</table>
		} else {
			<p class="text-muted"><em>No component digests recorded for this overlay.</em></p>
		}
		@deploymentActionsPanel(data)
	</div>
}

// deploymentActionsPanel renders the deploy-staging + promote-to-prod
// write controls (memql#727). Deploy-staging is the non-destructive
// lane; promote is type-to-confirm (operator must type the exact
// version into the confirm field). Both POST to gated CSRF-protected
// routes and redirect back here with a SUCCESS / ERROR flash carrying
// the audit-event id.
templ deploymentActionsPanel(data AdminDeploymentsData) {
	<h3>Actions</h3>
	<div class="deploy-actions">
		<form method="POST" action="/admin/deployments/deploy-staging" data-submit-once>
			@CSRFField(data.Layout.CSRFToken)
			<h4>Deploy to staging</h4>
			<p class="text-small text-muted">
				Assemble + apply a release into the staging overlay via the
				sanctioned promote script. Non-destructive lane.
			</p>
			<div class="form-row">
				<label for="deploy-staging-version">Version</label>
				<input id="deploy-staging-version" type="text" name="version" placeholder="0.9.10" required/>
			</div>
			<button type="submit" class="btn btn-primary" data-pending-label="Deploying...">Deploy to staging</button>
		</form>
		<form method="POST" action="/admin/deployments/promote" data-submit-once>
			@CSRFField(data.Layout.CSRFToken)
			<h4>Promote to prod</h4>
			<p class="text-small text-muted">
				Copy a validated staging release into the prod overlay (digest
				copy, no rebuild). <strong>Destructive:</strong> type the exact
				version below to confirm.
			</p>
			<div class="form-row">
				<label for="promote-version">Version</label>
				<input id="promote-version" type="text" name="version" placeholder="0.9.10" required/>
			</div>
			<div class="form-row">
				<label for="promote-confirm">Type the version to confirm</label>
				<input id="promote-confirm" type="text" name="confirm" placeholder="0.9.10" required/>
			</div>
			<button type="submit" class="btn btn-danger" data-pending-label="Promoting...">Promote to prod</button>
		</form>
		@deploymentRollbackForm(data)
	</div>
}

// deploymentRollbackForm renders the rollback control (memql#727).
// Destructive: the operator must type the commit SHA or the literal
// word "rollback" into the confirm field. Defaults the env to the
// currently-selected environment.
templ deploymentRollbackForm(data AdminDeploymentsData) {
	<form method="POST" action="/admin/deployments/rollback" data-submit-once>
		@CSRFField(data.Layout.CSRFToken)
		<h4>Rollback</h4>
		<p class="text-small text-muted">
			Revert the overlay commit for the given environment via
			<code>git revert</code>. <strong>Destructive:</strong> type the
			commit SHA or the word <code>rollback</code> to confirm.
		</p>
		<div class="form-row">
			<label for="rollback-env">Environment</label>
			<select id="rollback-env" name="env">
				<option value="staging" selected?={ data.Env == "staging" }>staging</option>
				<option value="prod" selected?={ data.Env == "prod" }>prod</option>
			</select>
		</div>
		<div class="form-row">
			<label for="rollback-sha">Commit SHA</label>
			<input id="rollback-sha" type="text" name="commitSha" placeholder="a1b2c3d" required/>
		</div>
		<div class="form-row">
			<label for="rollback-confirm">Type the commit SHA or "rollback" to confirm</label>
			<input id="rollback-confirm" type="text" name="confirm" placeholder="rollback" required/>
		</div>
		<button type="submit" class="btn btn-danger" data-pending-label="Rolling back...">Rollback</button>
	</form>
}

templ deploymentArgoPanel(argo *AdminDeployArgo) {
	<div class="card card-full">
		<h2 class="card-title">Argo CD</h2>
		if argo != nil {
			<table class="data">
				<tr><th>Sync status</th><td>{ orDash(argo.SyncStatus) }</td></tr>
				<tr><th>Health status</th><td>{ orDash(argo.HealthStatus) }</td></tr>
				<tr>
					<th>Drift</th>
					<td>
						if argo.OutOfSync {
							{ passIndicator(false) } OutOfSync
						} else {
							{ passIndicator(true) } in sync
						}
					</td>
				</tr>
				<tr><th>Last sync revision</th><td><code>{ orDash(argo.LastSyncRevision) }</code></td></tr>
				<tr><th>Last sync at</th><td>{ orDash(argo.LastSyncAt) }</td></tr>
			</table>
		} else {
			<p class="text-muted"><em>Argo CD app status unavailable (could not reach the cluster).</em></p>
		}
	</div>
}

templ deploymentRolloutsPanel(data AdminDeploymentsData) {
	{{ rollouts := data.Status.Rollouts }}
	<div class="card card-full">
		<h2 class="card-title">Rollouts</h2>
		if len(rollouts) > 0 {
			<table class="data">
				<tr>
					<th>Name</th>
					<th>Kind</th>
					<th>Phase</th>
					<th>Active</th>
					<th>Preview</th>
					<th>Canary weight</th>
					<th>Step</th>
					<th>Latest analysis</th>
					<th>Actions</th>
				</tr>
				for _, ro := range rollouts {
					<tr>
						<td>{ ro.Name }</td>
						<td>{ orDash(ro.Kind) }</td>
						<td>{ orDash(ro.Phase) }</td>
						<td>{ orDash(ro.ActiveColor) }</td>
						<td>{ orDash(ro.PreviewColor) }</td>
						<td>{ formatInt(ro.CanaryWeight) }%</td>
						<td>{ formatInt(ro.CurrentStep) }</td>
						<td>{ orDash(ro.LatestAnalysisResult) }</td>
						<td>
							@deploymentRolloutActions(data, ro.Name)
						</td>
					</tr>
				}
			</table>
		} else {
			<p class="text-muted"><em>No rollouts found in the cluster.</em></p>
		}
	</div>
}

// deploymentRolloutActions renders the per-rollout promote / abort
// controls (memql#727). Promote advances the rollout (no confirm);
// abort is destructive (drops the new revision) so it requires the
// operator to type the literal word "abort" into the confirm field.
// Both POST to the gated CSRF-protected /admin/deployments/rollout
// route with the rollout name + current env stamped.
templ deploymentRolloutActions(data AdminDeploymentsData, rolloutName string) {
	<form method="POST" action="/admin/deployments/rollout" style="display:inline;" data-submit-once>
		@CSRFField(data.Layout.CSRFToken)
		<input type="hidden" name="env" value={ data.Env }/>
		<input type="hidden" name="rollout" value={ rolloutName }/>
		<input type="hidden" name="action" value="promote"/>
		<button type="submit" class="btn btn-secondary btn-small" data-pending-label="Promoting...">Promote</button>
	</form>
	<form method="POST" action="/admin/deployments/rollout" style="display:inline;" data-submit-once>
		@CSRFField(data.Layout.CSRFToken)
		<input type="hidden" name="env" value={ data.Env }/>
		<input type="hidden" name="rollout" value={ rolloutName }/>
		<input type="hidden" name="action" value="abort"/>
		<input type="text" name="confirm" placeholder="type abort" size="10" required/>
		<button type="submit" class="btn btn-danger btn-small" data-pending-label="Aborting...">Abort</button>
	</form>
}

templ deploymentGatePanel(gate *AdminDeployGate) {
	<div class="card card-full">
		<h2 class="card-title">Deploy gate</h2>
		if gate != nil {
			<table class="data">
				<tr><th>Result</th><td>{ orDash(gate.Result) }</td></tr>
				<tr><th>Ran at</th><td>{ orDash(gate.RanAt) }</td></tr>
			</table>
			<h3>Legs</h3>
			if len(gate.Legs) > 0 {
				<table class="data">
					<tr><th>Pass</th><th>Leg</th><th>Detail</th></tr>
					for _, leg := range gate.Legs {
						<tr>
							<td><code>{ passIndicator(leg.Passed) }</code></td>
							<td>{ leg.Name }</td>
							<td>{ orDash(leg.Detail) }</td>
						</tr>
					}
				</table>
			} else {
				<p class="text-muted"><em>No analysis legs recorded.</em></p>
			}
		} else {
			<p class="text-muted"><em>No deploy-gate result available.</em></p>
		}
	</div>
}
