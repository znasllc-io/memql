package webtempl

// SetupWizardData is the typed page payload. Adding a field here is
// the only way to surface new state in the template — typos in the
// templ file fail the build, which is the whole point of the
// templ-vs-html/template switch.
type SetupWizardData struct {
	Layout                     LayoutData
	Flash                      *Flash
	PrefillDomain              string
	PrefillOwnerEmail          string
	PrefillOwnerFirstName      string
	PrefillOwnerLastName       string
	PrefillOwnerPhone          string
	PrefillOwnerPrimaryRole    string
	PrefillOwnerGender         string
	PrefillOwnerBirthdate      string
	PrefillOrgName             string
	PrefillInternalDomains     string
	PrefillRegistrationDomains string
	PrefillNotifyEmails        string
	PrefillMode                string
}

// Flash is the standard alert payload reused across pages.
type Flash struct {
	Kind    string // "info" | "success" | "warn" | "error"
	Message string
}

templ SetupWizard(data SetupWizardData) {
	@Layout(data.Layout) {
		<div class="card card-wide">
			<h1 class="card-title">Welcome to { data.Layout.BrandName }</h1>
			<p class="card-subtitle">
				First-time setup. This wizard claims cluster ownership and
				configures how new accounts get created. Sign-in is locked
				until you complete this step — that prevents anyone but you
				from claiming the owner role. You can change any of these
				settings later from the admin UI.
			</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}
			<form method="POST" action="/setup" data-submit-once>
				<h2>Cluster domain <span class="text-danger">*</span></h2>
				<div class="form-row">
					<label for="domain">Domain</label>
					<input id="domain" name="domain" type="text" required maxlength="255" autocomplete="off" value={ data.PrefillDomain } placeholder="e.g. acme.com, staging.acme.com, local.znas.io"/>
					<span class="help">
						The cluster's public hostname suffix. Every service runs at a subdomain: app.&lt;domain&gt; for the SPA, identity.&lt;domain&gt; for sign-in, bff.&lt;domain&gt; for the API, agent.&lt;domain&gt; for worker registration. Use local.&lt;your-domain&gt; on a developer machine, staging.&lt;your-domain&gt; for staging, or just &lt;your-domain&gt; in production.
					</span>
				</div>
				<hr/>
				<h2>Cluster owner</h2>
				<p class="text-small text-muted">
					These are stamped onto your user profile so the app
					treats you as a fully-set-up user the moment you sign
					in. You can edit them later from the admin console.
				</p>
				<div class="form-row">
					<label for="owner_first_name">First name <span class="text-danger">*</span></label>
					<input id="owner_first_name" name="owner_first_name" type="text" required maxlength="80" autocomplete="given-name" value={ data.PrefillOwnerFirstName } placeholder="e.g. Alex"/>
				</div>
				<div class="form-row">
					<label for="owner_last_name">Last name <span class="text-danger">*</span></label>
					<input id="owner_last_name" name="owner_last_name" type="text" required maxlength="80" autocomplete="family-name" value={ data.PrefillOwnerLastName } placeholder="e.g. Stone"/>
				</div>
				<div class="form-row">
					<label for="owner_email">Owner email <span class="text-danger">*</span></label>
					<input id="owner_email" name="owner_email" type="email" required autocomplete="email" value={ data.PrefillOwnerEmail }/>
					<span class="help">
						We'll send a sign-in link here so you can verify ownership and
						log in as the cluster owner.
					</span>
				</div>
				<div class="form-row">
					<label for="owner_phone">Phone number <span class="text-subtle">(optional)</span></label>
					<input id="owner_phone" name="owner_phone" type="tel" inputmode="tel" maxlength="32" autocomplete="tel" placeholder="+1 555 010 0100" pattern="^[+0-9 ()\-]{7,}$" value={ data.PrefillOwnerPhone }/>
					<span class="help">E.164 preferred. Country code, then number. Spaces and dashes are fine.</span>
				</div>
				<div class="form-row">
					<label for="owner_primary_role">Role at organization <span class="text-subtle">(optional)</span></label>
					<input id="owner_primary_role" name="owner_primary_role" type="text" maxlength="80" placeholder="e.g. Engineer, Founder, Account Manager" value={ data.PrefillOwnerPrimaryRole }/>
					<span class="help">Free-form job title. Distinct from the cluster auth role (you're the owner by virtue of running setup).</span>
				</div>
				<div class="form-row">
					<label for="owner_gender">Gender <span class="text-subtle">(optional)</span></label>
					<select id="owner_gender" name="owner_gender">
						<option value="" selected?={ data.PrefillOwnerGender == "" }>— select —</option>
						<option value="female" selected?={ data.PrefillOwnerGender == "female" }>Female</option>
						<option value="male" selected?={ data.PrefillOwnerGender == "male" }>Male</option>
						<option value="nonbinary" selected?={ data.PrefillOwnerGender == "nonbinary" }>Nonbinary</option>
						<option value="other" selected?={ data.PrefillOwnerGender == "other" }>Other</option>
						<option value="prefer_not_to_say" selected?={ data.PrefillOwnerGender == "prefer_not_to_say" }>Prefer not to say</option>
					</select>
				</div>
				<div class="form-row">
					<label for="owner_birthdate">Date of birth <span class="text-subtle">(optional)</span></label>
					<input id="owner_birthdate" name="owner_birthdate" type="date" min="1900-01-01" max="2010-12-31" autocomplete="bday" value={ data.PrefillOwnerBirthdate }/>
				</div>
				<div class="form-row">
					<label for="org_name">Organization name <span class="text-subtle">(optional)</span></label>
					<input id="org_name" name="org_name" type="text" value={ data.PrefillOrgName } placeholder="e.g. Acme Inc."/>
				</div>
				<hr/>
				<h2>Internal email domains</h2>
				<div class="form-row">
					<label for="internal_domains">
						Internal email domains <span class="text-subtle">(optional, comma-separated)</span>
					</label>
					<input id="internal_domains" name="internal_domains" type="text" value={ data.PrefillInternalDomains } placeholder="e.g. acme.com, acme.co.uk"/>
					<span class="help">
						Users registering with these domains get the cluster-wide
						default role. External users get a personal partition only.
					</span>
				</div>
				<hr/>
				<h2>Registration mode <span class="text-danger">*</span></h2>
				<div class="radio-group" role="radiogroup" aria-labelledby="reg-mode-label">
					<span id="reg-mode-label" class="text-muted text-small mb-1">Who can sign up?</span>
					@modeRadio("open", "Open", "Anyone with any email can sign up immediately.", data.PrefillMode, true)
					@modeRadio("domain_restricted", "Domain-restricted", "Only allow-listed email domains can self-register.", data.PrefillMode, false)
					@modeRadio("invite_only", "Invite-only", "No self-service. Users only enter via admin invitations.", data.PrefillMode, false)
					@modeRadio("waitlist", "Waitlist", "Users submit access requests; admins review and approve.", data.PrefillMode, false)
				</div>
				<div class="form-row" data-when="domain_restricted" style="display:none;">
					<label for="registration_domains">Allowed registration domains</label>
					<input id="registration_domains" name="registration_domains" type="text" value={ data.PrefillRegistrationDomains } placeholder="e.g. acme.com, partner.io"/>
					<span class="help">Comma-separated list. Required for domain-restricted mode.</span>
				</div>
				<div class="form-row" data-when="waitlist" style="display:none;">
					<label for="notify_emails">Notify these admins of new requests</label>
					<input id="notify_emails" name="notify_emails" type="text" value={ data.PrefillNotifyEmails } placeholder="e.g. ops@acme.com, security@acme.com"/>
					<span class="help">Comma-separated list. Empty = notify all owners + admins.</span>
				</div>
				<hr/>
				<button type="submit" class="btn btn-primary" disabled data-pending-label="Saving and sending email...">
					Finish setup
				</button>
				<p class="text-small text-muted mt-2 mb-0">
					We'll persist these settings and email a sign-in link to the
					owner address. Click the link to claim cluster ownership.
				</p>
			</form>
		</div>
	}
}

// modeRadio is the per-mode radio row. The `requiredAttr` flag
// stamps `required` on the first radio of the group so HTML5
// validation enforces "exactly one must be picked" without JS.
templ modeRadio(value, label, detail, prefilled string, requiredAttr bool) {
	<label>
		if requiredAttr {
			<input type="radio" name="registration_mode" value={ value } required checked?={ prefilled == value }/>
		} else {
			<input type="radio" name="registration_mode" value={ value } checked?={ prefilled == value }/>
		}
		<span>
			{ label }
			<span class="label-detail">{ detail }</span>
		</span>
	</label>
}
