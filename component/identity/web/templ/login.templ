package webtempl

// LoginData drives the /login page. The page is stage-based, NOT
// registration-mode-based: every visit opens with the email field
// (Stage="email"), and the POST handler decides whether to route
// the user to a magic-link or re-render in a follow-up stage.
//
//	Stage="email"            initial email-only form. Always rendered
//	                         on GET, regardless of registration mode.
//	Stage="waitlist_signup"  new user; collect name + context so the
//	                         operator can review the access request.
//	                         Email is preserved from step 1.
//	Stage="needs_invite"     new user, mode=invite_only. Offer the
//	                         token-paste field; operator-side outreach
//	                         is the only other path.
type LoginData struct {
	Layout             LayoutData
	Flash              *Flash
	Mode               string
	Stage              string
	AllowedDomainsHint string
	PrefillEmail       string

	// SharedMailboxHint is true when PrefillEmail looks like a shared
	// mailbox (memql#4304). Derived from the ADDRESS by the public heuristic,
	// never from the account row -- reading the row here would tell an
	// unauthenticated visitor whether a given address has an account.
	SharedMailboxHint bool
	// ReturnTo is the post-sign-in landing path the relying-party SPA
	// wants to send the user to after the OAuth code-flow completes.
	// Threaded through unchanged.
	ReturnTo string
	// OAuth code-flow context. When present, identity matches the
	// (ClientID, RedirectURI) pair against registered clients and
	// stamps the magic link with the OAuth context so /auth/complete
	// can mint an auth code for that client. When absent, the magic
	// link goes through the admin-session path and lands in /admin/.
	ClientID    string
	RedirectURI string
	OAuthState  string
	// Consent display (AuthorizeMode). ClientName is the human-friendly app
	// name (RFC 7591 client_name, falling back to ClientID); ClientLogo is a
	// bundled /static logo asset URL when we recognize the app, else "" and
	// ClientInitial (first letter) drives a placeholder avatar.
	ClientName    string
	ClientInitial string
	ClientLogo    string
	// ClientSelfRegistered is true when this client came from the DB-backed
	// oauthClient store -- it created itself through the unauthenticated
	// RFC 7591 POST /register -- rather than from an operator's
	// MEMQL_IDENTITY_REGISTERED_CLIENTS (memql#3794).
	//
	// It changes what the consent block is allowed to imply. ClientName is
	// ATTACKER-CHOSEN on this path, so the page must not present it as
	// identification: no bundled logo (the handler withholds it), an explicit
	// "not verified" marker, and the redirect URI shown as the thing that
	// actually says where the credential goes.
	ClientSelfRegistered bool
	// PKCE challenge (RFC 7636). Carried through the form hidden fields
	// from the /authorize endpoint so the magic-link the user receives
	// mints a PKCE-bound auth code. The /authorize endpoint REQUIRES
	// S256; these are empty on the plain /login path.
	CodeChallenge       string
	CodeChallengeMethod string
	// AuthorizeMode=true means this page was reached via the OAuth 2.1
	// /authorize endpoint (a third-party client, e.g. claude.ai, is
	// requesting access). The page shows a short consent line naming the
	// requesting client before the email field.
	AuthorizeMode bool
}

templ Login(data LoginData) {
	@Layout(data.Layout) {
		<div class="card">
			<h1 class="card-title">{ loginTitleFor(data) }</h1>
			<p class="card-subtitle">{ loginSubtitleFor(data) }</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}
			switch data.Stage {
				case "waitlist_signup":
					@loginFormWaitlist(data)
				case "needs_invite":
					@loginFormInvite(data)
				default:
					@loginFormEmail(data)
			}
			<hr/>
			<p class="text-small text-muted mb-0">
				By continuing, you agree to our
				<a href="/legal/tos">Terms of Service</a> and
				<a href="/legal/privacy">Privacy Policy</a>.
			</p>
		</div>
	}
}

// loginTitleFor picks the heading based on which stage we're in.
// Stage 1 always reads "Sign in" so a returning user sees the
// language they expect; stages 2-3 swap to "Request access" /
// "Use an invitation" so the new context is obvious.
func loginTitleFor(data LoginData) string {
	switch data.Stage {
	case "waitlist_signup":
		return "Request access to " + data.Layout.BrandName
	case "needs_invite":
		return "Use your invitation"
	default:
		return "Sign in to " + data.Layout.BrandName
	}
}

// loginSubtitleFor picks the supporting copy. Stage 1 uses the
// "magic link, no password" line for everyone; stages 2-3 explain
// the new context.
func loginSubtitleFor(data LoginData) string {
	switch data.Stage {
	case "waitlist_signup":
		return "Tell us a bit about yourself and we'll get back to you."
	case "needs_invite":
		return "Paste the token from your invitation email."
	default:
		return "Enter your email — we'll send you a single-use sign-in link. If you don't have an account yet, we'll walk you through requesting access."
	}
}

// loginFormEmail is the universal step-1 form. Same shape regardless
// of registration mode; the server decides what to do once it sees
// the submitted email.
templ loginFormEmail(data LoginData) {
	if data.AuthorizeMode && data.ClientID != "" {
		<div class="alert alert-info" style="display:flex;align-items:center;gap:12px;text-align:left;">
			if data.ClientLogo != "" {
				<img src={ data.ClientLogo } alt={ data.ClientName } width="40" height="40" style="flex:0 0 auto;width:40px;height:40px;border-radius:9px;"/>
			} else {
				<span aria-hidden="true" style="flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:9px;background:#4f46e5;color:#fff;font-weight:600;font-size:18px;line-height:1;">{ data.ClientInitial }</span>
			}
			<span>
				<strong>{ data.ClientName }</strong>
				if data.ClientSelfRegistered {
					<span style="display:inline-block;margin-left:6px;padding:1px 6px;border-radius:4px;background:#7c2d12;color:#fff;font-size:11px;font-weight:600;letter-spacing:.02em;vertical-align:middle;">NOT VERIFIED</span>
				}
				is requesting access to your { data.Layout.BrandName } account. Sign in to approve.
			</span>
		</div>
		// WHERE THE CREDENTIAL ACTUALLY GOES (memql#3794).
		//
		// The name above is a label the client picked for itself, and on the
		// self-registered path nobody checked it. The redirect URI is the only
		// thing on this page that says where an approved credential is
		// delivered, and it used to appear solely as a hidden form field --
		// present in the POST, invisible to the person approving it.
		//
		// Rendered in a monospace block rather than inline prose so a
		// lookalike host is legible: proportional text at body size is exactly
		// where rn/m and l/I hide.
		if data.RedirectURI != "" {
			<div style="margin-top:-4px;margin-bottom:16px;text-align:left;">
				<div style="font-size:12px;color:#6b7280;margin-bottom:4px;">Approving sends your sign-in to:</div>
				<code style="display:block;padding:8px 10px;border-radius:6px;background:#f3f4f6;border:1px solid #e5e7eb;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;line-height:1.4;word-break:break-all;color:#111827;">{ data.RedirectURI }</code>
				if data.ClientSelfRegistered {
					<div style="font-size:12px;color:#7c2d12;margin-top:6px;">
						This application registered itself and its name has not been verified by anyone. Approve it only if you recognise the address above.
					</div>
				}
			</div>
		}
	}
	<form method="POST" action="/login" data-submit-once>
		<input type="hidden" name="form" value="email"/>
		if data.ReturnTo != "" {
			<input type="hidden" name="return_to" value={ data.ReturnTo }/>
		}
		if data.ClientID != "" {
			<input type="hidden" name="client_id" value={ data.ClientID }/>
		}
		if data.RedirectURI != "" {
			<input type="hidden" name="redirect_uri" value={ data.RedirectURI }/>
		}
		if data.OAuthState != "" {
			<input type="hidden" name="state" value={ data.OAuthState }/>
		}
		if data.CodeChallenge != "" {
			<input type="hidden" name="code_challenge" value={ data.CodeChallenge }/>
		}
		if data.CodeChallengeMethod != "" {
			<input type="hidden" name="code_challenge_method" value={ data.CodeChallengeMethod }/>
		}
		<div class="form-row">
			<label for="email">Email</label>
			<input id="email" name="email" type="email" required autocomplete="email" autofocus inputmode="email" data-hint-target="#email-hint" value={ data.PrefillEmail }/>
			if data.Mode == "domain_restricted" && data.AllowedDomainsHint != "" {
				<span class="help">
					Registration on this cluster is limited to: { data.AllowedDomainsHint }. Existing users from any domain can still sign in.
				</span>
			}
			if data.SharedMailboxHint {
				<span class="help">
					That address looks like a shared mailbox. Anyone who can read it can
					use the sign-in link, so it signs in as this account rather than as
					you personally.
				</span>
			}
			<span id="email-hint" class="help"></span>
		</div>
		<button type="submit" class="btn btn-primary btn-block" data-pending-label="Continuing...">Continue</button>
	</form>
	@loginPasskey(data)
}

// loginPasskey renders the "Sign in with a passkey" control that sits
// alongside the magic-link form (memql#3407).
//
// It is a PROGRESSIVE ENHANCEMENT twice over. The block is rendered
// `hidden` and only static/passkey-login.js reveals it, so a browser
// without WebAuthn -- or with JS off entirely -- sees the email form and
// nothing else. And it renders at all only when a relying party is in
// scope: a passkey assertion's whole output is an auth code for a
// client, so with no client there is nothing for it to produce, and the
// magic-link form's admin-session path is the way in.
//
// The OAuth context rides on data-* attributes carrying exactly the
// values the form above puts in its hidden inputs. Both factors hand the
// server the same in-flight context; the server validates it and holds
// it server-side from there.
templ loginPasskey(data LoginData) {
	if data.ClientID != "" && data.RedirectURI != "" {
		<div
			class="mt-3"
			hidden
			data-passkey-login
			data-client-id={ data.ClientID }
			data-redirect-uri={ data.RedirectURI }
			data-state={ data.OAuthState }
			data-code-challenge={ data.CodeChallenge }
			data-code-challenge-method={ data.CodeChallengeMethod }
		>
			<p class="text-small text-muted text-center mb-0">or</p>
			<button
				type="button"
				class="btn btn-block"
				data-passkey-button
				data-label="Sign in with a passkey"
				data-pending-label="Waiting for your passkey..."
			>Sign in with a passkey</button>
			<span class="help" data-passkey-status hidden role="status"></span>
		</div>
	}
}

// loginFormWaitlist is rendered after step 1 reveals a new user
// in waitlist or domain-restricted-denied mode. Email is preserved
// from step 1; operator collects name + context so they can decide
// whether to approve.
templ loginFormWaitlist(data LoginData) {
	<form method="POST" action="/login" data-submit-once>
		<input type="hidden" name="form" value="waitlist"/>
		if data.ReturnTo != "" {
			<input type="hidden" name="return_to" value={ data.ReturnTo }/>
		}
		if data.ClientID != "" {
			<input type="hidden" name="client_id" value={ data.ClientID }/>
		}
		if data.RedirectURI != "" {
			<input type="hidden" name="redirect_uri" value={ data.RedirectURI }/>
		}
		if data.OAuthState != "" {
			<input type="hidden" name="state" value={ data.OAuthState }/>
		}
		if data.CodeChallenge != "" {
			<input type="hidden" name="code_challenge" value={ data.CodeChallenge }/>
		}
		if data.CodeChallengeMethod != "" {
			<input type="hidden" name="code_challenge_method" value={ data.CodeChallengeMethod }/>
		}
		<div class="form-row">
			<label for="email">Email</label>
			<input id="email" name="email" type="email" required autocomplete="email" inputmode="email" value={ data.PrefillEmail }/>
		</div>
		<div class="form-row">
			<label for="name">Name <span class="text-subtle">(optional)</span></label>
			<input id="name" name="name" type="text" autocomplete="name"/>
		</div>
		<div class="form-row">
			<label for="additional_context">What would you use { data.Layout.BrandName } for? <span class="text-subtle">(optional)</span></label>
			<textarea id="additional_context" name="additional_context" rows="3" placeholder="A sentence or two helps us prioritize."></textarea>
		</div>
		<button type="submit" class="btn btn-primary btn-block" data-pending-label="Submitting...">Request access</button>
		<p class="text-small text-muted mt-3 mb-0">
			<a href="/login">&larr; Use a different email</a>
		</p>
	</form>
}

// loginFormInvite is rendered after step 1 reveals a new user in
// invite-only mode, OR when an existing operator with a token
// reaches /login?stage=needs_invite directly.
// loginFormInvite is the needs_invite stage: somebody who has a token but no
// working link.
//
// THE HIDDEN EMAIL FIELD IS NOT DECORATION (memql#4601). This form used to
// render `form`, `return_to`, `client_id`, `redirect_uri` and `state` and no
// address at all, while both sibling forms carried `value={ data.PrefillEmail }`
// and the handler populated PrefillEmail for this very stage. So every
// submission posted `email=""`, resolveInvitation compared the row's address
// against the empty string, and the person holding a valid invitation was told
// to check their email address. Redemption had never once succeeded, on any
// shipped version, and no test posted this form.
//
// The address is HIDDEN rather than shown-and-editable because the visitor
// typed it one step ago and an invitation authorizes exactly one address:
// re-presenting it as an editable box invites a change that can only produce a
// mismatch. handleLoginPost now also refuses an empty address on this branch,
// so the field and the handler cannot drift apart silently again.
templ loginFormInvite(data LoginData) {
	<form method="POST" action="/login" data-submit-once>
		<input type="hidden" name="form" value="invite"/>
		<input type="hidden" name="email" value={ data.PrefillEmail }/>
		if data.ReturnTo != "" {
			<input type="hidden" name="return_to" value={ data.ReturnTo }/>
		}
		if data.ClientID != "" {
			<input type="hidden" name="client_id" value={ data.ClientID }/>
		}
		if data.RedirectURI != "" {
			<input type="hidden" name="redirect_uri" value={ data.RedirectURI }/>
		}
		if data.OAuthState != "" {
			<input type="hidden" name="state" value={ data.OAuthState }/>
		}
		if data.CodeChallenge != "" {
			<input type="hidden" name="code_challenge" value={ data.CodeChallenge }/>
		}
		if data.CodeChallengeMethod != "" {
			<input type="hidden" name="code_challenge_method" value={ data.CodeChallengeMethod }/>
		}
		<div class="form-row">
			<label for="invitation">Invitation token</label>
			<input id="invitation" name="invitation" type="text" autocomplete="off" required placeholder="paste your invitation token"/>
		</div>
		<button type="submit" class="btn btn-primary btn-block" data-pending-label="Working...">Continue</button>
		<p class="text-small text-muted mt-3 mb-0">
			<a href="/login">&larr; Sign in with email instead</a>
		</p>
	</form>
}
