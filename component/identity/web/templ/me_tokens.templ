package webtempl

// MeTokenRow is the per-row PAT projection rendered into the tokens
// table. The handler converts pat.PATRow into this shape so the templ
// component stays decoupled from the storage type.
type MeTokenRow struct {
	ID         string
	Label      string
	Active     bool
	LastUsedAt string
	CreatedAt  string
}

// MeTokensData drives /me/tokens. `NewToken` + `NewLabel` are non-empty
// only on the response that follows a successful POST — the plaintext
// token is shown ONCE.
type MeTokensData struct {
	Layout   LayoutData
	Flash    *Flash
	NewToken string
	NewLabel string
	Tokens   []MeTokenRow
}

templ MeTokens(data MeTokensData) {
	@Layout(data.Layout) {
		<div class="me-shell">
			@meSidebar("tokens", true)
			<section>
				<div class="card card-wide">
					<h1 class="card-title">Personal access tokens</h1>
					<p class="card-subtitle">
						Long-lived bearer tokens for CLI clients (memql-cockpit, scripts).
						Treat them like passwords: a single token grants the same access
						you have when signed in here. Revoke any token you don't need.
					</p>
					if data.Flash != nil {
						<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
					}
					if data.NewToken != "" {
						<div class="alert alert-warn">
							<p><strong>Save this token now &mdash; you won't see it again.</strong></p>
							<p>It cannot be recovered. If you lose it, generate a new one and revoke this one.</p>
							<pre class="token-display"><code>{ data.NewToken }</code></pre>
							<p class="text-small text-muted">
								Label: <em>{ data.NewLabel }</em>
							</p>
						</div>
					}
					<h2 class="card-section">Generate a new token</h2>
					<form method="POST" action="/me/tokens" class="form-row" data-submit-once>
						@CSRFField(data.Layout.CSRFToken)
						<input type="text" name="label" placeholder="e.g. cockpit on laptop" required maxlength="120" pattern="[^&lt;&gt;]+" style="flex:1;"/>
						<button type="submit" class="btn btn-primary">Generate</button>
					</form>
					<h2 class="card-section">Your tokens</h2>
					if len(data.Tokens) == 0 {
						<p class="text-muted">You haven't generated any tokens yet.</p>
					} else {
						<table class="data">
							<thead>
								<tr>
									<th>Label</th>
									<th>Status</th>
									<th>Last used</th>
									<th>Created</th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								for _, t := range data.Tokens {
									@meTokenRow(t, data.Layout.CSRFToken)
								}
							</tbody>
						</table>
					}
				</div>
			</section>
		</div>
	}
}

templ meTokenRow(t MeTokenRow, csrfToken string) {
	<tr>
		<td>
			if t.Label != "" {
				{ t.Label }
			} else {
				<em>(no label)</em>
			}
		</td>
		<td>
			if t.Active {
				<span class="badge">active</span>
			} else {
				<span class="badge badge-muted">revoked</span>
			}
		</td>
		<td>
			if t.LastUsedAt != "" {
				{ t.LastUsedAt }
			} else {
				<span class="text-muted">never</span>
			}
		</td>
		<td>{ t.CreatedAt }</td>
		<td>
			if t.Active {
				<form method="POST" action="/me/tokens/revoke" style="display:inline;" data-submit-once data-confirm="Revoke this token? CLI clients using it will stop working immediately.">
					@CSRFField(csrfToken)
					<input type="hidden" name="id" value={ t.ID }/>
					<button type="submit" class="btn btn-danger btn-small">
						Revoke
					</button>
				</form>
			}
		</td>
	</tr>
}
