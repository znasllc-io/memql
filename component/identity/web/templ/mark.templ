package webtempl

// The MemQL mark: the 9-node graph polyhedron from memql.io.
//
// The geometry is brand/mark.svg at the repo root, shared verbatim with the
// portal's MemqlMark.tsx and the VS Code extension's activity-bar glyph. It is
// inlined here rather than referenced as an <img> so it takes currentColor --
// the wordmark colours it with .brand-mark, and nothing needs a second file
// for a second colour.
//
// aria-hidden because it sits beside the brand name in the same link: a screen
// reader that announced both would say the product's name twice.

templ Mark() {
	<svg class="brand-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
		<g fill="none" stroke="currentColor" stroke-width="0.78" stroke-linecap="round">
			<line x1="13.09" y1="2.52" x2="4.30" y2="5.32"></line>
			<line x1="13.09" y1="2.52" x2="9.45" y2="6.83"></line>
			<line x1="13.09" y1="2.52" x2="19.70" y2="8.76"></line>
			<line x1="13.09" y1="2.52" x2="2.52" y2="14.24"></line>
			<line x1="4.30" y1="5.32" x2="9.45" y2="6.83"></line>
			<line x1="4.30" y1="5.32" x2="19.70" y2="8.76"></line>
			<line x1="4.30" y1="5.32" x2="2.52" y2="14.24"></line>
			<line x1="9.45" y1="6.83" x2="19.70" y2="8.76"></line>
			<line x1="9.45" y1="6.83" x2="2.52" y2="14.24"></line>
			<line x1="9.45" y1="6.83" x2="13.58" y2="16.07"></line>
			<line x1="19.70" y1="8.76" x2="13.58" y2="16.07"></line>
			<line x1="19.70" y1="8.76" x2="17.92" y2="17.85"></line>
			<line x1="19.70" y1="8.76" x2="9.40" y2="20.70"></line>
			<line x1="2.52" y1="14.24" x2="13.58" y2="16.07"></line>
			<line x1="2.52" y1="14.24" x2="9.40" y2="20.70"></line>
			<line x1="13.58" y1="16.07" x2="17.92" y2="17.85"></line>
			<line x1="13.58" y1="16.07" x2="9.40" y2="20.70"></line>
			<line x1="17.92" y1="17.85" x2="9.40" y2="20.70"></line>
			<line x1="17.92" y1="17.85" x2="21.52" y2="21.48"></line>
		</g>
		<g fill="currentColor" stroke="none">
			<circle cx="13.09" cy="2.52" r="1.53"></circle>
			<circle cx="4.30" cy="5.32" r="1.53"></circle>
			<circle cx="9.45" cy="6.83" r="1.53"></circle>
			<circle cx="19.70" cy="8.76" r="1.53"></circle>
			<circle cx="2.52" cy="14.24" r="1.53"></circle>
			<circle cx="13.58" cy="16.07" r="1.53"></circle>
			<circle cx="17.92" cy="17.85" r="1.53"></circle>
			<circle cx="9.40" cy="20.70" r="1.53"></circle>
			<circle cx="21.52" cy="21.48" r="1.53"></circle>
		</g>
	</svg>
}
