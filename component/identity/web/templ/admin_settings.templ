package webtempl

import "strconv"

// colorOrDefault returns a 7-char hex color suitable for an
// <input type="color"> value. The native widget rejects empty
// strings (silently snaps to #000000), so we fall back to the
// cluster default brand color when the operator hasn't set one.
func colorOrDefault(hex string) string {
	if len(hex) == 7 && hex[0] == '#' {
		return hex
	}
	return "#0433ff"
}

// AdminSettingsForm is the projection of the cluster-settings concept
// rendered into the admin settings form.
type AdminSettingsForm struct {
	BrandName                 string
	BrandPrimaryColor         string
	BrandLogoDataURI          string
	BrandIconDataURI          string
	RegistrationMode          string
	RegistrationDomains       string
	InternalDomains           string
	InternalDefaultRole       string
	RegisteredClientsJSON     string
	AccessRequestNotifyEmails string
	// Token + session lifetimes. Values shown to the operator are
	// the runtime-tunable ClusterSettings overrides when set, OR
	// the boot-time env / built-in default when no override. The
	// handler renders 0 / "" as "use default" so the form can show
	// both states cleanly.
	AccessTokenTTLSeconds   int
	AccessTokenTTLMinutes   int  // shown in minutes for readability
	RefreshTokenTTLSeconds  int
	RefreshTokenTTLDays     int  // shown in days for readability
	MagicLinkTTLSeconds     int
	MagicLinkTTLMinutes     int  // shown in minutes
	InvitationTTLDays       int
	RefreshCookieSameSite   string  // "" | "lax" | "none"
	// Effective values after override-vs-default resolution.
	// Shown read-only beside the input so the operator sees what
	// the system is actually using right now.
	EffectiveAccessTokenLabel  string
	EffectiveRefreshTokenLabel string
	EffectiveMagicLinkLabel    string
	EffectiveInvitationLabel   string
	EffectiveSameSiteLabel     string
}

// AdminSettingsData drives /admin/settings.
type AdminSettingsData struct {
	Layout LayoutData
	Flash  *Flash
	Form   AdminSettingsForm
}

templ AdminSettings(data AdminSettingsData) {
	@Layout(data.Layout) {
		<div class="card card-full">
			<h1 class="card-title">Cluster settings</h1>
			<p class="card-subtitle">
				Runtime-editable knobs. The first-run wizard seeded these values;
				edits here take effect immediately without restarting the binary.
			</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}
			<form method="POST" action="/admin/settings" data-submit-once>
				<h2>Branding</h2>
				<div class="form-row">
					<label for="brand_name">Brand name</label>
					<input id="brand_name" name="brand_name" type="text" value={ data.Form.BrandName } autocomplete="off"/>
					<span class="help">Shown in the page title and header. Leave blank to fall back to the cluster default.</span>
				</div>
				<div class="form-row" data-controller="color-input">
					<label for="brand_primary_color">Primary color</label>
					<div class="flex gap-2">
						<input
							type="color"
							data-color-input-target="picker"
							data-action="input->color-input#syncFromPicker"
							value={ colorOrDefault(data.Form.BrandPrimaryColor) }
							aria-label="Pick primary color"
						/>
						<input
							id="brand_primary_color"
							name="brand_primary_color"
							type="text"
							value={ data.Form.BrandPrimaryColor }
							placeholder="#0433ff"
							pattern="^#?[0-9a-fA-F]{6}$"
							data-color-input-target="hex"
							data-action="input->color-input#syncFromHex change->color-input#syncFromHex"
						/>
					</div>
					<span class="help">Used for buttons, links, and accents. Click the swatch or type a 6-digit hex.</span>
				</div>
				@imageUploadField(imageUploadFieldConfig{
					Variant:     "logo",
					Label:       "Logo",
					Description: "Horizontal wordmark with name + icon. Used in the header and login pages where there's room for the full mark. Output: 1024×256 (4:1).",
					Name:        "brand_logo_data_uri",
					Value:       data.Form.BrandLogoDataURI,
				})
				@imageUploadField(imageUploadFieldConfig{
					Variant:     "icon",
					Label:       "Icon",
					Description: "Square icon-only mark. Used for tabs, share previews, and any compact context. Output: 256×256.",
					Name:        "brand_icon_data_uri",
					Value:       data.Form.BrandIconDataURI,
				})
				<hr/>
				<h2>Registration</h2>
				<div class="form-row">
					<label for="registration_mode">Mode</label>
					<select id="registration_mode" name="registration_mode" required>
						<option value="open" selected?={ data.Form.RegistrationMode == "open" }>open</option>
						<option value="domain_restricted" selected?={ data.Form.RegistrationMode == "domain_restricted" }>domain_restricted</option>
						<option value="invite_only" selected?={ data.Form.RegistrationMode == "invite_only" }>invite_only</option>
						<option value="waitlist" selected?={ data.Form.RegistrationMode == "waitlist" }>waitlist</option>
					</select>
				</div>
				<div class="form-row">
					<label for="registration_domains">Allowed registration domains</label>
					<input id="registration_domains" name="registration_domains" type="text" value={ data.Form.RegistrationDomains } placeholder="acme.com, partner.io"/>
					<span class="help">Comma-separated. Required when mode = domain_restricted.</span>
				</div>
				<hr/>
				<h2>Internal users</h2>
				<div class="form-row">
					<label for="internal_domains">Internal email domains</label>
					<input id="internal_domains" name="internal_domains" type="text" value={ data.Form.InternalDomains } placeholder="acme.com"/>
					<span class="help">Users registering with these domains get the cluster-wide default role.</span>
				</div>
				<div class="form-row">
					<label for="internal_default_role">Internal default role</label>
					<select id="internal_default_role" name="internal_default_role" required>
						<option value="owner" selected?={ data.Form.InternalDefaultRole == "owner" }>owner</option>
						<option value="admin" selected?={ data.Form.InternalDefaultRole == "admin" }>admin</option>
						<option value="writer" selected?={ data.Form.InternalDefaultRole == "writer" }>writer</option>
						<option value="reader" selected?={ data.Form.InternalDefaultRole == "reader" }>reader</option>
					</select>
				</div>
				<hr/>
				<h2>Operator notifications</h2>
				<div class="form-row">
					<label for="access_request_notify_emails">Access-request notify emails</label>
					<input id="access_request_notify_emails" name="access_request_notify_emails" type="text" value={ data.Form.AccessRequestNotifyEmails } placeholder="ops@acme.com, security@acme.com"/>
					<span class="help">Comma-separated. Empty = notify all owners + admins.</span>
				</div>
				<hr/>
				<h2>Registered OAuth clients</h2>
				<div class="form-row">
					<label for="registered_clients_json">Clients JSON</label>
					<textarea id="registered_clients_json" name="registered_clients_json" rows="5" placeholder={ `[{"clientId":"copresent","redirectURIs":["https://app.copresent.ai/auth/callback"]}]` }>{ data.Form.RegisteredClientsJSON }</textarea>
					<span class="help">{ "JSON array of {clientId, redirectURIs}. Edit carefully — bad JSON breaks new logins." }</span>
				</div>
				<hr/>
				<h2>Tokens &amp; sessions</h2>
				<p class="card-subtitle">
					Lifetimes for issued tokens. Leave a field empty / 0 to use the
					built-in default (or whatever the IDENTITY_*_TTL_SECONDS env var
					sets). Edits apply on the next access-token mint or
					refresh-rotation -- no identity restart required. The "Effective"
					line under each input shows what's currently in force.
				</p>
				<div class="form-row">
					<label for="access_token_ttl_minutes">Access token lifetime (minutes)</label>
					<input id="access_token_ttl_minutes" name="access_token_ttl_minutes" type="number" min="1" max="1440" value={ accessTokenTTLValue(data.Form) } placeholder="15"/>
					<span class="help">Bounded 1 minute -- 24 hours. Default 15 minutes. Effective: { data.Form.EffectiveAccessTokenLabel }</span>
				</div>
				<div class="form-row">
					<label for="refresh_token_ttl_days">Refresh token lifetime (days)</label>
					<input id="refresh_token_ttl_days" name="refresh_token_ttl_days" type="number" min="1" max="365" value={ refreshTokenTTLValue(data.Form) } placeholder="30"/>
					<span class="help">Bounded 1 day -- 365 days. Default 30 days. Lowering this DOES NOT immediately invalidate live sessions; the next rotation that crosses the new ceiling refuses. Effective: { data.Form.EffectiveRefreshTokenLabel }</span>
				</div>
				<div class="form-row">
					<label for="magic_link_ttl_minutes">Magic-link lifetime (minutes)</label>
					<input id="magic_link_ttl_minutes" name="magic_link_ttl_minutes" type="number" min="1" max="60" value={ magicLinkTTLValue(data.Form) } placeholder="10"/>
					<span class="help">Bounded 1 minute -- 60 minutes. Default 10 minutes. Short by design -- magic-links are click-through credentials. Effective: { data.Form.EffectiveMagicLinkLabel }</span>
				</div>
				<div class="form-row">
					<label for="invitation_ttl_days">Invitation lifetime (days)</label>
					<input id="invitation_ttl_days" name="invitation_ttl_days" type="number" min="1" max="90" value={ invitationTTLValue(data.Form) } placeholder="7"/>
					<span class="help">Bounded 1 day -- 90 days. Default 7 days. How long an admin-issued user invitation remains usable. Effective: { data.Form.EffectiveInvitationLabel }</span>
				</div>
				<div class="form-row">
					<label for="refresh_cookie_samesite">Refresh cookie SameSite</label>
					<select id="refresh_cookie_samesite" name="refresh_cookie_samesite">
						<option value="" selected?={ data.Form.RefreshCookieSameSite == "" }>(use env / default = lax)</option>
						<option value="lax" selected?={ data.Form.RefreshCookieSameSite == "lax" }>Lax (same-site self-hosted)</option>
						<option value="none" selected?={ data.Form.RefreshCookieSameSite == "none" }>None (cross-site SaaS)</option>
					</select>
					<span class="help">Lax suits app.acme.com + identity.acme.com (single eTLD+1) and avoids Safari ITP. None is needed when the SPA + identity live on different eTLD+1s (app.copresent.ai + auth.znasllc.io). Effective: { data.Form.EffectiveSameSiteLabel }</span>
				</div>
				<button type="submit" class="btn btn-primary" data-pending-label="Saving...">Save settings</button>
			</form>
		</div>
	}
}

// accessTokenTTLValue / refreshTokenTTLValue / etc. render the
// numeric input value. Empty when 0 so the placeholder shows the
// default; the post handler treats empty / 0 as "use default".
func accessTokenTTLValue(form AdminSettingsForm) string {
	if form.AccessTokenTTLMinutes <= 0 {
		return ""
	}
	return strconv.Itoa(form.AccessTokenTTLMinutes)
}

func refreshTokenTTLValue(form AdminSettingsForm) string {
	if form.RefreshTokenTTLDays <= 0 {
		return ""
	}
	return strconv.Itoa(form.RefreshTokenTTLDays)
}

func magicLinkTTLValue(form AdminSettingsForm) string {
	if form.MagicLinkTTLMinutes <= 0 {
		return ""
	}
	return strconv.Itoa(form.MagicLinkTTLMinutes)
}

func invitationTTLValue(form AdminSettingsForm) string {
	if form.InvitationTTLDays <= 0 {
		return ""
	}
	return strconv.Itoa(form.InvitationTTLDays)
}

// imageUploadFieldConfig is the projection consumed by the
// imageUploadField templ helper. Variant is "logo" (3:1 horizontal)
// or "icon" (1:1 square); the controller picks aspect, output size,
// and crop-stage dimensions from this string.
type imageUploadFieldConfig struct {
	Variant     string
	Label       string
	Description string
	Name        string
	Value       string
}

// imageUploadField renders a single uploader block: title +
// description, then either the saved-image preview (idle state)
// or the crop stage (editing state). Buttons drive the
// image-upload Stimulus controller, which lives in
// /static/admin-settings-branding.js.
templ imageUploadField(c imageUploadFieldConfig) {
	<div
		class="image-upload-field"
		data-controller="image-upload"
		data-image-upload-variant-value={ c.Variant }
	>
		<div class="image-upload-header">
			<div>
				<div class="image-upload-label">{ c.Label }</div>
				<p class="image-upload-description">{ c.Description }</p>
			</div>
		</div>
		<input type="hidden" name={ c.Name } value={ c.Value } data-image-upload-target="dataUri"/>
		<div data-image-upload-target="idle" class={ "image-upload-idle", "image-upload-idle--" + c.Variant }>
			<div class="image-upload-preview" data-image-upload-target="preview"></div>
			<div class="image-upload-actions">
				<label class="btn btn-secondary cursor-pointer">
					<span data-image-upload-target="uploadLabel">
						if c.Value != "" {
							Replace
						} else {
							Upload
						}
					</span>
					<input
						type="file"
						class="sr-only"
						accept="image/png,image/jpeg,image/webp,image/gif"
						data-image-upload-target="file"
						data-action="change->image-upload#fileChosen"
					/>
				</label>
				<button type="button" class={ "btn btn-ghost", templ.KV("hidden", c.Value == "") } data-action="image-upload#clear" data-image-upload-target="removeBtn">
					Remove
				</button>
			</div>
		</div>
		<div data-image-upload-target="editor" hidden class="image-upload-editor">
			<div
				class={ "crop-stage", "crop-stage--" + c.Variant }
				data-image-upload-target="stage"
				data-action="mousedown->image-upload#dragStart touchstart->image-upload#dragStart"
			>
				<img alt="Drag to reposition" data-image-upload-target="image" draggable="false"/>
			</div>
			<div class="image-upload-zoom">
				<label class="image-upload-zoom-label">Zoom</label>
				<input
					type="range"
					min="100"
					max="400"
					step="1"
					value="100"
					data-image-upload-target="zoom"
					data-action="input->image-upload#zoomChanged"
				/>
			</div>
			<div class="flex flex-wrap gap-2">
				<button type="button" class="btn btn-primary" data-action="image-upload#applyCrop">Apply</button>
				<button type="button" class="btn btn-ghost" data-action="image-upload#cancelCrop">Cancel</button>
			</div>
		</div>
		<p class="image-upload-status help" data-image-upload-target="status"></p>
	</div>
}
