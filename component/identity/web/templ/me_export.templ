package webtempl

// MeExportData drives /me/export. The export-status panel is hydrated
// client-side; the rate-limit hours value is pre-rendered here.
type MeExportData struct {
	Layout         LayoutData
	RateLimitHours int
}

templ MeExport(data MeExportData) {
	@Layout(data.Layout) {
		<div class="me-shell">
			@meSidebar("export", false)
			<section>
				<div class="card card-wide">
					<h1 class="card-title">Export your data</h1>
					<p class="text-muted">
						Download a copy of the data { data.Layout.BrandName } stores about your
						account: profile, identities, sessions, partition grants,
						access-request history, legal-acceptance records, and audit
						events where you are the actor or target.
					</p>
					<p class="text-small text-subtle">
						For your safety this is rate-limited to once every
						{ formatInt(data.RateLimitHours) } hours.
					</p>
					<div class="btn-row">
						<a href="/me/export/download.json" class="btn btn-primary">
							Download JSON
						</a>
						<a href="/me/export/download.html" class="btn btn-secondary">
							Download HTML
						</a>
					</div>
					<div data-content="export-status" class="mt-3"></div>
				</div>
			</section>
		</div>
	}
}
