package webtempl

// AdminPATRow is the per-row PAT projection rendered into /admin/tokens.
// Includes owner email so admins can identify tokens without
// cross-referencing user ids.
type AdminPATRow struct {
	ID         string
	UserID     string
	OwnerEmail string
	Label      string
	Active     bool
	LastUsedAt string
	CreatedAt  string
}

// AdminNodeTokenRow is the per-row node-token projection rendered
// into the Node tokens section of /admin/tokens (memql#350).
//
// MintedByEmail / Bootstrapped are mutually exclusive: operator-CLI
// mints carry MintedByEmail (the admin who ran the mint subcommand);
// /node/bootstrap-minted rows carry Bootstrapped=true and render as
// "(bootstrapped)" so the admin can distinguish the two paths at a
// glance.
type AdminNodeTokenRow struct {
	ID               string
	NodeID           string
	NodeType         string
	Active           bool
	MintedBy         string // raw subject; non-empty for both paths
	MintedByEmail    string // resolved when MintedBy is a user id
	Bootstrapped     bool   // true when MintedBy is a system: subject
	ExpiresAt        string
	LastConnectAt    string
	BootstrappedAt   string
	BootstrappedFrom string
	CreatedAt        string
}

// AdminTokensData drives /admin/tokens.
//
// PAT + node-token fields are independent: both sections render when
// both adapters are wired; either one rendering empty (with a
// "nothing here yet" placeholder) is the graceful-degradation shape
// when one adapter is nil.
type AdminTokensData struct {
	Layout      LayoutData
	Flash       *Flash
	Tokens      []AdminPATRow
	TotalCount  int
	ActiveCount int

	// memql#350: node-token section.
	NodeTokens          []AdminNodeTokenRow
	NodeTokenTotalCount int
	NodeTokenActiveCnt  int
}

templ AdminTokens(data AdminTokensData) {
	@Layout(data.Layout) {
		<div class="card card-full">
			<h1 class="card-title">Tokens</h1>
			<p class="card-subtitle">
				Every PAT + node-class credential issued in the cluster. Use
				Revoke for security-incident response &mdash; revoking
				immediately blocks the corresponding CLI session or node
				bootstrap.
			</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}

			<h2 class="card-subhead mt-4">Personal access tokens</h2>
			if len(data.Tokens) == 0 {
				<p class="text-muted mt-2">No PATs have been issued yet.</p>
			} else {
				<div class="table-wrap">
					<table class="data">
						<thead>
							<tr>
								<th>Owner</th>
								<th>Label</th>
								<th>Status</th>
								<th>Last used</th>
								<th>Created</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, t := range data.Tokens {
								@adminTokensRow(t, data.Layout.CSRFToken)
							}
						</tbody>
					</table>
				</div>
				<p class="text-small text-muted mt-4">
					Total: { formatInt(data.TotalCount) } ({ formatInt(data.ActiveCount) } active).
				</p>
			}

			<h2 class="card-subhead mt-4">Node tokens</h2>
			<p class="text-small text-muted">
				Machine credentials authenticating cluster-internal node
				binaries on <code>NodeService.Stream</code>. Rows minted by
				<code>POST /node/bootstrap</code> (memql#338) render as
				<em>(bootstrapped)</em>; rows minted via the operator CLI
				carry the admin's email.
			</p>
			if len(data.NodeTokens) == 0 {
				<p class="text-muted mt-2">No node tokens have been issued yet.</p>
			} else {
				<div class="table-wrap">
					<table class="data">
						<thead>
							<tr>
								<th>Node</th>
								<th>Minted by</th>
								<th>Status</th>
								<th>Last connect</th>
								<th>Bootstrapped</th>
								<th>Source IP</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, t := range data.NodeTokens {
								@adminNodeTokensRow(t, data.Layout.CSRFToken)
							}
						</tbody>
					</table>
				</div>
				<p class="text-small text-muted mt-4">
					Total: { formatInt(data.NodeTokenTotalCount) } ({ formatInt(data.NodeTokenActiveCnt) } active).
				</p>
			}
		</div>
	}
}

templ adminNodeTokensRow(t AdminNodeTokenRow, csrfToken string) {
	<tr>
		<td>
			<strong>{ t.NodeType }</strong>
			if t.NodeID != "" {
				<span class="text-muted"> { t.NodeID }</span>
			}
		</td>
		<td>
			if t.Bootstrapped {
				<em class="text-muted">(bootstrapped)</em>
			} else if t.MintedByEmail != "" {
				{ t.MintedByEmail }
			} else {
				<span class="text-muted">{ t.MintedBy }</span>
			}
		</td>
		<td>
			if t.Active {
				<span class="badge">active</span>
			} else {
				<span class="badge badge-muted">revoked</span>
			}
		</td>
		<td>
			if t.LastConnectAt != "" {
				{ t.LastConnectAt }
			} else {
				<span class="text-muted">never</span>
			}
		</td>
		<td>
			if t.BootstrappedAt != "" {
				{ t.BootstrappedAt }
			} else {
				<span class="text-muted">never</span>
			}
		</td>
		<td>
			if t.BootstrappedFrom != "" {
				<code>{ t.BootstrappedFrom }</code>
			} else {
				<span class="text-muted">&mdash;</span>
			}
		</td>
		<td>
			if t.Active {
				<form method="POST" action="/admin/tokens/node/revoke" style="display:inline;" data-submit-once data-confirm="Revoke this node token? The affected node will be unable to re-bootstrap until you mint a fresh credential.">
					@CSRFField(csrfToken)
					<input type="hidden" name="id" value={ t.ID }/>
					<button type="submit" class="btn btn-danger btn-small">
						Revoke
					</button>
				</form>
			}
		</td>
	</tr>
}

templ adminTokensRow(t AdminPATRow, csrfToken string) {
	<tr>
		<td>
			if t.OwnerEmail != "" {
				{ t.OwnerEmail }
			} else {
				<span class="text-muted">{ t.UserID }</span>
			}
		</td>
		<td>
			if t.Label != "" {
				{ t.Label }
			} else {
				<em>(no label)</em>
			}
		</td>
		<td>
			if t.Active {
				<span class="badge">active</span>
			} else {
				<span class="badge badge-muted">revoked</span>
			}
		</td>
		<td>
			if t.LastUsedAt != "" {
				{ t.LastUsedAt }
			} else {
				<span class="text-muted">never</span>
			}
		</td>
		<td>{ t.CreatedAt }</td>
		<td>
			if t.Active {
				<form method="POST" action="/admin/tokens/revoke" style="display:inline;" data-submit-once data-confirm="Revoke this token? The owner will be signed out of any CLI session using it.">
					@CSRFField(csrfToken)
					<input type="hidden" name="id" value={ t.ID }/>
					<button type="submit" class="btn btn-danger btn-small">
						Revoke
					</button>
				</form>
			}
		</td>
	</tr>
}
