package webtempl

// AdminPATRow is the per-row PAT projection rendered into /admin/tokens.
// Includes owner email so admins can identify tokens without
// cross-referencing user ids.
type AdminPATRow struct {
	ID         string
	UserID     string
	OwnerEmail string
	Label      string
	Active     bool
	LastUsedAt string
	CreatedAt  string
}

// AdminNodeTokenRow is the per-row v1:identity:identity[node_token]
// projection rendered into /admin/tokens (memql#343). Distinct from
// AdminPATRow because the operational signals differ: a PAT cares
// about owner + label + last-used; a node token cares about which
// node binding it serves, when + from where it was bootstrapped, and
// the JWT JTI of the most-recent mint.
//
// MintedBy reads "system:node_bootstrap" for rows created by the
// /node/bootstrap endpoint; operator-CLI mints (the original #105
// path) carry the admin's userId instead. The template renders
// "(bootstrapped)" for the sentinel.
type AdminNodeTokenRow struct {
	ID                 string
	NodeID             string
	NodeType           string
	MintedBy           string
	KeyHashJTI         string
	Active             bool
	ExpiresAt          string
	LastConnectAt      string
	BootstrappedAt     string
	BootstrappedFrom   string
	LastBootstrappedAt string
	RevokedAt          string
}

// AdminTokensData drives /admin/tokens.
type AdminTokensData struct {
	Layout      LayoutData
	Flash       *Flash
	Tokens      []AdminPATRow
	TotalCount  int
	ActiveCount int

	// memql#343: node-token surface on the same page (one nav link,
	// one operator concept = "tokens"). The slices are independent --
	// either may be empty.
	NodeTokens            []AdminNodeTokenRow
	NodeTokenTotalCount   int
	NodeTokenActiveCount  int
}

templ AdminTokens(data AdminTokensData) {
	@Layout(data.Layout) {
		<div class="card card-full">
			<h1 class="card-title">Personal access tokens</h1>
			<p class="card-subtitle">
				Every PAT issued in the cluster. Use Revoke for security-incident
				response &mdash; revoking a PAT immediately stops any CLI client
				using it.
			</p>
			if data.Flash != nil {
				<div class={ "alert", "alert-" + data.Flash.Kind }>{ data.Flash.Message }</div>
			}
			if len(data.Tokens) == 0 {
				<p class="text-muted mt-2">No PATs have been issued yet.</p>
			} else {
				<div class="table-wrap">
					<table class="data">
						<thead>
							<tr>
								<th>Owner</th>
								<th>Label</th>
								<th>Status</th>
								<th>Last used</th>
								<th>Created</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, t := range data.Tokens {
								@adminTokensRow(t, data.Layout.CSRFToken)
							}
						</tbody>
					</table>
				</div>
				<p class="text-small text-muted mt-4">
					Total: { formatInt(data.TotalCount) } ({ formatInt(data.ActiveCount) } active).
				</p>
			}
		</div>
		<div class="card card-full mt-4">
			<h1 class="card-title">Node tokens</h1>
			<p class="card-subtitle">
				Cluster-internal class="node" JWTs. Rows minted by the
				<code>/node/bootstrap</code> endpoint (memql#343) carry
				<em>(bootstrapped)</em> in the Minted by column; operator-CLI
				mints carry the admin's userId. Revoke stops the next
				<code>NodeService.Stream</code> open from the affected node.
			</p>
			if len(data.NodeTokens) == 0 {
				<p class="text-muted mt-2">No node tokens have been minted yet.</p>
			} else {
				<div class="table-wrap">
					<table class="data">
						<thead>
							<tr>
								<th>Node</th>
								<th>Minted by</th>
								<th>Status</th>
								<th>Last connect</th>
								<th>Bootstrapped</th>
								<th>From</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, t := range data.NodeTokens {
								@adminNodeTokensRow(t, data.Layout.CSRFToken)
							}
						</tbody>
					</table>
				</div>
				<p class="text-small text-muted mt-4">
					Total: { formatInt(data.NodeTokenTotalCount) } ({ formatInt(data.NodeTokenActiveCount) } active).
				</p>
			}
		</div>
	}
}

templ adminNodeTokensRow(t AdminNodeTokenRow, csrfToken string) {
	<tr>
		<td>
			<span class="badge badge-muted">{ t.NodeType }</span>
			{ " " }
			<code class="text-small">{ t.NodeID }</code>
		</td>
		<td>
			if t.MintedBy == "system:node_bootstrap" {
				<span class="text-muted">(bootstrapped)</span>
			} else {
				<code class="text-small">{ t.MintedBy }</code>
			}
		</td>
		<td>
			if t.Active {
				<span class="badge">active</span>
			} else {
				<span class="badge badge-muted">revoked</span>
				if t.RevokedAt != "" {
					<br/>
					<span class="text-small text-muted">{ t.RevokedAt }</span>
				}
			}
		</td>
		<td>
			if t.LastConnectAt != "" {
				{ t.LastConnectAt }
			} else {
				<span class="text-muted">never</span>
			}
		</td>
		<td>
			if t.LastBootstrappedAt != "" {
				{ t.LastBootstrappedAt }
			} else if t.BootstrappedAt != "" {
				{ t.BootstrappedAt }
			} else {
				<span class="text-muted">&mdash;</span>
			}
		</td>
		<td>
			if t.BootstrappedFrom != "" {
				<code class="text-small">{ t.BootstrappedFrom }</code>
			} else {
				<span class="text-muted">&mdash;</span>
			}
		</td>
		<td>
			if t.Active {
				<form method="POST" action="/admin/tokens/node/revoke" style="display:inline;" data-submit-once data-confirm="Revoke this node token? The next bootstrap or stream open from this node will be rejected.">
					@CSRFField(csrfToken)
					<input type="hidden" name="id" value={ t.ID }/>
					<button type="submit" class="btn btn-danger btn-small">
						Revoke
					</button>
				</form>
			}
		</td>
	</tr>
}

templ adminTokensRow(t AdminPATRow, csrfToken string) {
	<tr>
		<td>
			if t.OwnerEmail != "" {
				{ t.OwnerEmail }
			} else {
				<span class="text-muted">{ t.UserID }</span>
			}
		</td>
		<td>
			if t.Label != "" {
				{ t.Label }
			} else {
				<em>(no label)</em>
			}
		</td>
		<td>
			if t.Active {
				<span class="badge">active</span>
			} else {
				<span class="badge badge-muted">revoked</span>
			}
		</td>
		<td>
			if t.LastUsedAt != "" {
				{ t.LastUsedAt }
			} else {
				<span class="text-muted">never</span>
			}
		</td>
		<td>{ t.CreatedAt }</td>
		<td>
			if t.Active {
				<form method="POST" action="/admin/tokens/revoke" style="display:inline;" data-submit-once data-confirm="Revoke this token? The owner will be signed out of any CLI session using it.">
					@CSRFField(csrfToken)
					<input type="hidden" name="id" value={ t.ID }/>
					<button type="submit" class="btn btn-danger btn-small">
						Revoke
					</button>
				</form>
			}
		</td>
	</tr>
}
