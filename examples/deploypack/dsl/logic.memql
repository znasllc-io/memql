// logic.memql -- the deploy pack (examples/deploypack), Epic 2 / #2096 (E2.3).
//
// Imperative body for the deploy-lifecycle automation. Mirrors deploy.go's
// Deploy(): read the deployment's new state off the CDC event, and for the
// azure provider in the in_progress state, fire the promote effect and
// transition the record to its terminal status (succeeded | failed).
//
// Env mapping (production -> prod) is done inside the deployRunPromote Go
// handler via deploycontrol.ConsoleEnvFor -- the SAME mapping the Go driver
// uses -- so this logic passes the deployment.environment enum straight
// through and the mapping lives in exactly one place.
//
// Outcome handling without `else` (the DSL if-expression has no else branch):
// deployRunPromote returns success in-band (it does NOT error on a promote
// failure, only on misconfiguration), so two guarded transitions cover the
// branch -- one fires when success==true, the other when success!=true --
// exactly deploy.go's runErr -> transitionStatusForErr(succeeded|failed).

use deploypack.builtins.{ deployRunPromote, deployObserveReconciledState, deployRecordBack }
use deployment.mutations.{ updateDeploymentStatus }

@description("On every v1:cluster:deployment update: when the new status is in_progress AND the provider is azure (or empty -> azure default) AND a version + deploymentId are present, fire deployRunPromote (passing the environment enum; the handler maps it to the promote.sh env) and transition the deployment to its terminal status. A FORWARD deploy lands in succeeded; a ROLLBACK record (one carrying previousDeploymentId) lands in rolled_back -- matching deploy.go's RollbackDeployment terminal exactly (#2115 parity). A promote failure lands in failed either way. Acts only on the in_progress edge; other status updates are ignored. The event-driven port of deploy.go's apply+transition. Epic 2 / #2096.")
logic driveDeploymentInProgress {
  args {
    event object @required
  }
  body {
    status := coalesce(args.event.node.payload.status, "")
    provider := coalesce(args.event.node.payload.provider, "")
    deploymentId := coalesce(args.event.node.payload.deploymentId, "")
    version := coalesce(args.event.node.payload.version, "")
    environment := coalesce(args.event.node.payload.environment, "")
    previousDeploymentId := coalesce(args.event.node.payload.previousDeploymentId, "")
    isAzure := provider == "azure" || provider == ""
    isRollback := previousDeploymentId != ""

    result := if status == "in_progress" && isAzure && version != "" && deploymentId != "" {
      deployRunPromote({ version: version, env: environment })
    }
    promoted := !result.Empty() && result.First().payload.success == true

    // Terminal status mirrors deploy.go exactly: a forward deploy -> succeeded,
    // a rollback record (previousDeploymentId set) -> rolled_back, a promote
    // failure -> failed (#2115). The DSL if-expression has no else, so each
    // mutually-exclusive outcome is its own guarded transition.
    succeeded := if promoted && !isRollback {
      updateDeploymentStatus({ deploymentId: deploymentId, status: "succeeded" })
    }
    rolledBack := if promoted && isRollback {
      updateDeploymentStatus({ deploymentId: deploymentId, status: "rolled_back" })
    }
    failed := if !result.Empty() && result.First().payload.success != true {
      updateDeploymentStatus({ deploymentId: deploymentId, status: "failed" })
    }
    return deploymentId
  }
}

// ---- logic/deploypack/recordReconciledState ----

@description("Model A record-back loop (#2097): when a v1:cluster:deployment reaches succeeded (the promote completed), observe the ArgoCD-reconciled state and record it back into the deployment concept. On a clean reconciliation (synced && healthy) it appends the observed per-node spec via deployRecordBack (createDeploymentNodeSpec -- a DIFFERENT concept, so it does NOT re-trigger this v1:cluster:deployment automation). When ArgoCD reports the app is NOT synced/healthy, it appends a corrective failed transition (which moves status off succeeded, self-terminating). The committed overlay stays the source of truth; the data layer mirrors observed state. Multi-node safe: the per-node append is idempotent (asOf latest collapses) and the succeeded->terminal guards prevent a re-trigger loop. Epic 2 / #2097.")
logic recordReconciledState {
  args {
    event object @required
  }
  body {
    status := coalesce(args.event.node.payload.status, "")
    provider := coalesce(args.event.node.payload.provider, "")
    deploymentId := coalesce(args.event.node.payload.deploymentId, "")
    version := coalesce(args.event.node.payload.version, "")
    imageDigest := coalesce(args.event.node.payload.imageDigest, "")
    isAzure := provider == "azure" || provider == ""

    observation := if status == "succeeded" && isAzure && deploymentId != "" {
      deployObserveReconciledState({ app: "" })
    }
    reconciled := !observation.Empty() && observation.First().payload.synced == true && observation.First().payload.healthy == true

    recorded := if reconciled {
      deployRecordBack({
        deploymentId: deploymentId,
        nodeType: "bff",
        version: version,
        replicas: 2,
        imageDigest: imageDigest
      })
    }
    corrected := if !observation.Empty() && reconciled != true {
      updateDeploymentStatus({ deploymentId: deploymentId, status: "failed" })
    }
    return deploymentId
  }
}
