// logic.memql -- the deploy pack (examples/deploypack), Epic 2 / #2096 (E2.3).
//
// Imperative bodies for the deploy-lifecycle automations. Read the
// deployment's new state off the CDC event, and for the azure provider in the
// in_progress state, OBSERVE ArgoCD's reconciled state. The
// TERMINAL TRANSITION is persisted by the automation's gated mutation steps
// (decide -> act -> persist), not in here -- logic performs no graph writes
// (behavioral-constructs ADR section 2.1). Rewritten for #2400 after strict
// boot (#2357) surfaced that the original bodies never parsed.
//
// Grammar note (#2400, updated #2407/#2410). These bodies were written for
// the legacy logic-step grammar, where every `:=` step RHS had to be a CALL,
// an `if cond { call }`, or a collection chain. The original bodies used bare
// scalar/boolean expression assignments and were silently skipped at load
// for their entire life, so the rewrite built branching values with
// cond(...) calls, one infix comparison per predicate, and pulled every
// collection-chain read (result.First().payload.x) into its own coalesce()
// step first. Edition 2026 takes an expression on the right of `:=` and
// evaluates it in process, so the migration turned those steps into the
// `? :` and `??` forms below; the one-value-per-step layout is the legacy
// grammar's, kept as the codemod wrote it.
//
// No environment is read off the event (epic memql#3943). The pack drives ONE
// installation, so there is no environment to map and no promote to aim: the
// forward-deploy effect this logic used to fire (deployRunPromote) pinned one
// environment's overlay from another's, and both halves of that are gone. What
// remains is the honest question -- did ArgoCD reconcile what the merge pinned
// -- which observeReconciledState already answers.

use deploypack.builtins.{ deployObserveReconciledState, deployRecordBack }

@description("On every v1:cluster:deployment update: when the new status is in_progress AND the provider is azure (or empty -> azure default) AND a version + deploymentId are present, observe ArgoCD's reconciled state and return { deploymentId, outcome } where outcome is succeeded (forward deploy, ArgoCD synced AND healthy), rolled_back (rollback record -- one carrying previousDeploymentId -- likewise reconciled, matching deploy.go's RollbackDeployment terminal, #2115 parity), failed (observed and NOT reconciled), or empty (not our edge; nothing observed). The automation persists the transition. Epic 2 / #2096; the promote effect it used to fire went with the environment concept, epic memql#3943.")
logic driveDeploymentInProgress {
  args {
    event object @required
  }
  body {
    status := args.event.payload.status ?? ""
    provider := args.event.payload.provider ?? ""
    deploymentId := args.event.payload.deploymentId ?? ""
    version := args.event.payload.version ?? ""
    previousDeploymentId := args.event.payload.previousDeploymentId ?? ""
    isAzure := provider == "azure" ? true : provider == "" ? true : false
    result := if status == "in_progress" && isAzure == true && version != "" && deploymentId != "" {
      deployObserveReconciledState(app: "")
    }
    observedProbe := result.First().payload.effect ?? ""
    syncedVal := result.First().payload.synced ?? false
    healthyVal := result.First().payload.healthy ?? false
    observed := observedProbe == "" ? false : true
    reconciled := syncedVal == true ? (healthyVal == true ? true : false) : false
    isRollback := previousDeploymentId == "" ? false : true
    outcome := reconciled == true ? (isRollback == true ? "rolled_back" : "succeeded") : observed == true ? "failed" : ""
    return { deploymentId: deploymentId, outcome: outcome }
  }
}

// ---- logic/deploypack/recordReconciledState ----

@description("Model A record-back loop (#2097): when a v1:cluster:deployment reaches succeeded (the promote completed), observe the ArgoCD-reconciled state. On a clean reconciliation (synced && healthy) append the observed per-node spec via deployRecordBack (createDeploymentNodeSpec -- a DIFFERENT concept, so it does NOT re-trigger the v1:cluster:deployment automations) and return verdict=recorded. When ArgoCD reports NOT synced/healthy, return verdict=correct so the automation appends the corrective failed transition (which moves status off succeeded, self-terminating). The committed overlay stays the source of truth; the data layer mirrors observed state. Epic 2 / #2097; rewritten for #2400.")
logic recordReconciledState {
  args {
    event object @required
  }
  body {
    status := args.event.payload.status ?? ""
    provider := args.event.payload.provider ?? ""
    deploymentId := args.event.payload.deploymentId ?? ""
    version := args.event.payload.version ?? ""
    imageDigest := args.event.payload.imageDigest ?? ""
    isAzure := provider == "azure" ? true : provider == "" ? true : false
    observation := if status == "succeeded" && isAzure == true && deploymentId != "" {
      deployObserveReconciledState(app: "")
    }
    obsProbe := observation.First().payload.effect ?? ""
    syncedVal := observation.First().payload.synced ?? false
    healthyVal := observation.First().payload.healthy ?? false
    observed := obsProbe == "" ? false : true
    reconciled := syncedVal == true ? (healthyVal == true ? true : false) : false
    recorded := if reconciled == true {
      deployRecordBack(deploymentId: deploymentId, nodeType: "bff", version: version, replicas: 2, imageDigest: imageDigest)
    }
    verdict := reconciled == true ? "recorded" : observed == true ? "correct" : ""
    return { deploymentId: deploymentId, verdict: verdict }
  }
}
