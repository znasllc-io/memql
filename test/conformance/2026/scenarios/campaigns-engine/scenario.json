{
  "description": "The campaigns engine's event emails: the shipped generator turns a rule into an authored automation, which fires on its trigger concept's rows under the rule author's envelope and stages one outbound email per recipient.",
  "scenarios": [
    {
      "name": "cluster-role-rule-stages-one-email-per-owner",
      "description": "An active rule on new forge requests, for the cluster's owners, fires on a new request: it stages an email to the owner and records the firing. The same event delivered again is claimed already and sends nothing more.",
      "seed": [
        {
          "mutation": "createUser",
          "args": {
            "userId": {
              "$id": "owner"
            },
            "displayName": "Scenario Owner",
            "primaryEmail": {
              "$id": "owner-{tag}@scenario.invalid"
            },
            "role": "owner"
          }
        },
        {
          "mutation": "createUser",
          "args": {
            "userId": {
              "$id": "author"
            },
            "displayName": "Scenario Rule Author",
            "primaryEmail": {
              "$id": "author-{tag}@scenario.invalid"
            },
            "role": "writer"
          }
        },
        {
          "mutation": "createClientAccount",
          "args": {
            "accountId": {
              "$id": "organization"
            },
            "name": "Scenario Organization"
          },
          "as": {
            "userId": {
              "$id": "owner"
            },
            "role": "owner"
          }
        },
        {
          "mutation": "writeGroup",
          "args": {
            "groupId": {
              "$id": "acct-organization"
            },
            "name": "Scenario Organization Members",
            "kind": "account",
            "accountId": {
              "$id": "organization"
            },
            "status": "active"
          }
        },
        {
          "builtin": "accountAccessUpdate",
          "as": {
            "userId": {
              "$id": "owner"
            },
            "role": "owner"
          },
          "args": {
            "accountId": {
              "$id": "organization"
            },
            "operation": "apps",
            "apps": [
              "app:email"
            ]
          }
        },
        {
          "builtin": "accountAccessUpdate",
          "as": {
            "userId": {
              "$id": "owner"
            },
            "role": "owner"
          },
          "args": {
            "accountId": {
              "$id": "organization"
            },
            "operation": "members",
            "userIds": [
              {
                "$id": "author"
              }
            ],
            "role": "member",
            "apps": [
              "app:email"
            ]
          }
        },
        {
          "mutation": "createTemplate",
          "as": {
            "userId": {
              "$id": "author"
            },
            "role": "writer"
          },
          "args": {
            "templateId": {
              "$id": "tpl"
            },
            "name": "A request arrived",
            "subject": "A request arrived",
            "textBody": "A new request is waiting for you.",
            "versionTime": "2026-10-01T00:00:00Z",
            "accountId": {
              "$id": "organization"
            }
          }
        },
        {
          "mutation": "updateTemplate",
          "as": {
            "userId": {
              "$id": "author"
            },
            "role": "writer"
          },
          "args": {
            "templateId": {
              "$id": "tpl"
            },
            "status": "ready",
            "versionTime": "2026-10-01T00:01:00Z",
            "name": "A request arrived",
            "subject": "A request arrived",
            "textBody": "A new request is waiting for you."
          }
        },
        {
          "mutation": "createEmailRule",
          "as": {
            "userId": {
              "$id": "author"
            },
            "role": "writer"
          },
          "args": {
            "emailRuleId": {
              "$id": "rule"
            },
            "name": "New requests",
            "triggerConcept": "v1:forge:request",
            "eventKind": "created",
            "templateId": {
              "$id": "tpl"
            },
            "recipientMode": "cluster_roles",
            "recipientRoles": [
              "owner"
            ],
            "accountId": {
              "$id": "organization"
            }
          }
        },
        {
          "mutation": "setEmailRuleStatus",
          "as": {
            "userId": {
              "$id": "author"
            },
            "role": "writer"
          },
          "args": {
            "emailRuleId": {
              "$id": "rule"
            },
            "status": "active"
          }
        },
        {
          "mutation": "createRequest",
          "args": {
            "requestId": {
              "$id": "req"
            },
            "projectId": "project-scenario",
            "title": "A scenario request",
            "body": "Mailed to the owners."
          }
        }
      ],
      "fire": [
        {
          "emailRule": {
            "$id": "rule"
          },
          "as": {
            "userId": {
              "$id": "author"
            }
          },
          "event": {
            "action": "created",
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            }
          }
        },
        {
          "emailRule": {
            "$id": "rule"
          },
          "as": {
            "userId": {
              "$id": "author"
            }
          },
          "redeliver": true
        }
      ],
      "expect": {
        "rows": [
          {
            "concept": "v1:platform:outboundRequest",
            "where": {
              "target": {
                "$id": "owner-{tag}@scenario.invalid"
              },
              "subject": "A request arrived"
            },
            "payload": {
              "medium": "email",
              "body": "A new request is waiting for you.",
              "status": "pending",
              "serverStaged": true
            }
          },
          {
            "concept": "v1:campaigns:emailRule",
            "id": {
              "$id": "rule"
            },
            "payload": {
              "firedCount": 1
            }
          },
          {
            "concept": "v1:campaigns:template",
            "id": {
              "$id": "tpl"
            },
            "payload": {
              "accountId": {
                "$id": "v1:accounts:account:organization"
              },
              "ownerUserId": {
                "$id": "v1:identity:user:author"
              }
            }
          },
          {
            "concept": "v1:campaigns:emailRule",
            "id": {
              "$id": "rule"
            },
            "payload": {
              "accountId": {
                "$id": "v1:accounts:account:organization"
              },
              "ownerUserId": {
                "$id": "v1:identity:user:author"
              }
            }
          },
          {
            "concept": "v1:accounts:account",
            "id": {
              "$id": "organization"
            },
            "payload": {
              "ownerUserId": {
                "$id": "v1:identity:user:owner"
              },
              "allowedApps": [
                "app:email"
              ]
            }
          },
          {
            "concept": "v1:identity:groupMembership",
            "id": {
              "$id": "acct-organization-{tag}-author-{tag}"
            },
            "payload": {
              "groupId": {
                "$id": "v1:identity:group:acct-organization"
              },
              "userId": {
                "$id": "v1:identity:user:author"
              },
              "organizationRole": "member",
              "allowedApps": [
                "app:email"
              ],
              "status": "active"
            }
          },
          {
            "concept": "v1:identity:user",
            "id": {
              "$id": "author"
            },
            "payload": {
              "role": "writer",
              "active": true
            }
          }
        ]
      }
    }
  ]
}
