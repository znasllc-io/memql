{
  "description": "Before-write routing sets the initial request state; recordRouted records its first-version audit, while recordTransition records subsequent status changes.",
  "scenarios": [
    {
      "name": "owner-request-is-queued",
      "description": "An owner's request goes straight to queued, approved by its submitter, with one routed audit event.",
      "seed": [
        {
          "mutation": "createRequest",
          "args": {
            "requestId": {
              "$id": "req"
            },
            "projectId": "project-scenario",
            "title": "A scenario request",
            "body": "Routed by role."
          }
        }
      ],
      "fire": [
        {
          "automation": "recordRouted",
          "event": {
            "action": "created",
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            }
          }
        }
      ],
      "expect": {
        "rows": [
          {
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            },
            "payload": {
              "status": "queued",
              "submitterRole": "owner",
              "approvedByUserId": "v1:identity:user:user-scenario-owner"
            }
          },
          {
            "concept": "v1:forge:requestEvent",
            "where": {
              "requestId": {
                "$id": "req"
              },
              "kind": "routed"
            },
            "payload": {
              "fromStatus": "submitted",
              "note": "routed by submitter role"
            }
          },
          {
            "concept": "v1:forge:requestEvent",
            "where": {
              "requestId": {
                "$id": "req"
              }
            },
            "count": 1
          }
        ]
      },
      "dryRun": {
        "fire": 0,
        "writes": 1
      },
      "resume": {
        "fire": 0,
        "failAt": 1
      }
    },
    {
      "name": "unchanged-status-records-nothing",
      "description": "Writing a request's status again, unchanged, is an update and fires recordTransition, which records nothing for it.",
      "seed": [
        {
          "mutation": "createRequest",
          "args": {
            "requestId": {
              "$id": "req"
            },
            "projectId": "project-scenario",
            "title": "A scenario request",
            "body": "Routed by role."
          }
        }
      ],
      "fire": [
        {
          "automation": "recordRouted",
          "event": {
            "action": "created",
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            }
          }
        },
        {
          "mutation": "advanceRequest",
          "args": {
            "requestId": {
              "$id": "req"
            },
            "status": "queued"
          }
        },
        {
          "automation": "recordTransition",
          "event": {
            "action": "updated",
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            }
          }
        }
      ],
      "expect": {
        "rows": [
          {
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            },
            "payload": {
              "status": "queued"
            }
          },
          {
            "concept": "v1:forge:requestEvent",
            "where": {
              "requestId": {
                "$id": "req"
              }
            },
            "count": 1
          },
          {
            "concept": "v1:forge:requestEvent",
            "where": {
              "requestId": {
                "$id": "req"
              },
              "fromStatus": "queued"
            },
            "count": 0
          }
        ]
      },
      "resume": {
        "fire": 2,
        "failAt": 1
      }
    },
    {
      "name": "writer-request-needs-approval",
      "description": "A writer's request needs approval. Its first version is recorded as routed.",
      "seed": [
        {
          "mutation": "createRequest",
          "as": {
            "userId": "user-scenario-writer",
            "role": "writer"
          },
          "args": {
            "requestId": {
              "$id": "req"
            },
            "projectId": "project-scenario",
            "title": "A scenario request",
            "body": "Routed by role."
          }
        }
      ],
      "fire": [
        {
          "automation": "recordRouted",
          "event": {
            "action": "created",
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            }
          }
        }
      ],
      "expect": {
        "rows": [
          {
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            },
            "payload": {
              "status": "needs_approval",
              "submitterRole": "writer"
            }
          },
          {
            "concept": "v1:forge:requestEvent",
            "where": {
              "requestId": {
                "$id": "req"
              },
              "kind": "routed"
            },
            "payload": {
              "fromStatus": "submitted"
            }
          },
          {
            "concept": "v1:forge:requestEvent",
            "where": {
              "requestId": {
                "$id": "req"
              }
            },
            "count": 1
          }
        ]
      },
      "resume": {
        "fire": 0,
        "failAt": 1
      }
    },
    {
      "name": "reader-request-needs-validation",
      "description": "A reader's request needs validation. needs_validation names no audit kind, so the transition records nothing.",
      "seed": [
        {
          "mutation": "createRequest",
          "as": {
            "userId": "user-scenario-reader",
            "role": "reader"
          },
          "args": {
            "requestId": {
              "$id": "req"
            },
            "projectId": "project-scenario",
            "title": "A scenario request",
            "body": "Routed by role."
          }
        }
      ],
      "fire": [
        {
          "automation": "recordRouted",
          "event": {
            "action": "created",
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            }
          }
        }
      ],
      "expect": {
        "rows": [
          {
            "concept": "v1:forge:request",
            "id": {
              "$id": "req"
            },
            "payload": {
              "status": "needs_validation",
              "submitterRole": "reader"
            }
          },
          {
            "concept": "v1:forge:requestEvent",
            "where": {
              "requestId": {
                "$id": "req"
              },
              "kind": "routed"
            },
            "payload": {
              "fromStatus": "submitted"
            }
          },
          {
            "concept": "v1:forge:requestEvent",
            "where": {
              "requestId": {
                "$id": "req"
              }
            },
            "count": 1
          }
        ]
      }
    }
  ]
}
