/// When a node joins the cluster, raise a ticket if it was last seen this year.
@trigger(event="node.created", concept="v1:cluster:node")
automation welcomeNodesSeenThisYear {
  seen := logic joinedNodeLastSeen(event: event)
  if year(seen) == 2026 {
    raise := mutation raiseAgentTicket(title: "A node joined the cluster")
  }
}
