/// When a node joins the cluster, raise a ticket -- behind an `if` with nothing to decide.
@trigger(event="node.created", concept="v1:cluster:node", partition="*")
automation welcomeNodeUnconditionally {
  step kind {
    logic joinedNodeType (event)
  }
  step raise {
    if {
      mutation raiseAgentTicket (title: "A node joined the cluster")
    }
  }
}
