/// A support ticket, the row the automation here raises.
concept ticket {
  title   string
  status  string
}

/// Raise a ticket with a title.
mutate ticket raiseAgentTicket {
  args {
    title  string!
  }
  insert {
    title: args.title
    status: "open"
  }
}

/// The kind of node the triggering event is about.
logic joinedNodeType {
  args {
    event  object!
  }
  body {
    return args.event.payload.nodeType
  }
}

/// When the node the triggering event is about was last seen.
logic joinedNodeLastSeen {
  args {
    event  object!
  }
  body {
    return args.event.payload.lastSeen
  }
}
