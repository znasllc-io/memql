{
  "cases": [
    {
      "file": "named-arguments.memql",
      "verdict": "load_ok",
      "note": "A step's call names each argument, and each argument is an expression."
    },
    {
      "file": "object-literal-call-args.memql",
      "verdict": "refuse_parse",
      "message": "object-literal call args are removed; pass named args directly",
      "note": "A construct call's arguments are named: `saNoteGoal(goalId: args.id)`."
    },
    {
      "file": "note-text.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {
        "id": "g1"
      },
      "expect": "goal g1 changed"
    },
    {
      "file": "ticket-count.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "calls": {
        "query saTickets": [
          {
            "id": "t1"
          }
        ]
      },
      "expect": 1,
      "note": "The corpus boots no database: the case gives the call's answer."
    },
    {
      "file": "labels.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {
        "labels": [
          "team-a",
          "ops",
          "team-b"
        ]
      },
      "expect": [
        "TEAM-A",
        "TEAM-B"
      ]
    },
    {
      "file": "priority-band.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {
        "priority": 3
      },
      "expect": "high"
    },
    {
      "file": "note-map.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {
        "id": "g1",
        "priority": 4
      },
      "expect": {
        "goalId": "g1",
        "urgent": true,
        "weight": -8
      }
    },
    {
      "file": "optional-owner.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {},
      "actor": {
        "userId": "u1"
      },
      "expect": "u1"
    },
    {
      "file": "optional-owner.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {
        "goal": {
          "ownerUserId": "u2"
        }
      },
      "actor": {
        "userId": "u1"
      },
      "expect": "u2"
    },
    {
      "file": "open-or-listed.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {
        "ticket": {
          "status": "closed"
        },
        "status": "held"
      },
      "expect": true
    },
    {
      "file": "nil-when-unset.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {},
      "expect": null,
      "note": "An absent note equals the empty string, so the value is nil."
    },
    {
      "file": "nil-when-unset.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {
        "note": "done"
      },
      "expect": "done"
    },
    {
      "file": "grouped.memql",
      "verdict": "evaluate",
      "concept": "ticket",
      "args": {
        "a": 2,
        "b": 0,
        "c": true
      },
      "expect": true
    },
    {
      "file": "an-args-reference.memql",
      "verdict": "load_ok"
    },
    {
      "file": "a-retired-function.memql",
      "verdict": "refuse_parse",
      "message": "year() is retired under the 2026.08 grammar epoch",
      "note": "A retired function is refused where the parser reads a step argument."
    },
    {
      "file": "a-comparison.memql",
      "verdict": "load_ok",
      "note": "A step argument is an expression, so a comparison is a boolean value there. Before edition 2026 the parser stopped at the operator."
    },
    {
      "file": "a-reserved-name.memql",
      "verdict": "refuse_parse",
      "message": "\"now\" is a reserved engine name (now / actor / partition / config / trace) and cannot be an argument name",
      "note": "Refuses the argument's NAME rather than its value: kept because a call site is where the reserved names are refused (memql#3626)."
    }
  ]
}
