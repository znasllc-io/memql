/// A support ticket, the row the tool here lists.
concept ticket {
  title     string
  status    string
  priority  float
}

/// The open tickets, newest first. It sorts and does not paginate: the tool's handler pages it.
query ticket openTicketsForTool {
  filter row => row.status == "open"
  sort "row.createdAt", "desc"
}

/// The tickets a tool lists with typed defaults: closed ones only when asked, at or above a priority, in one status.
query ticket ticketsForToolDefaults {
  args {
    includeClosed  boolean
    minPriority    float
    status         string
  }
  filter row => (args.includeClosed == true || row.status != "closed")
              && (args.minPriority == nil || row.priority >= args.minPriority)
              && (args.status == nil || row.status == args.status)
  sort "row.createdAt", "desc"
}
