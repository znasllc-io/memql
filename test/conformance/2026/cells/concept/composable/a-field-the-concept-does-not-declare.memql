/// A support ticket raised by a customer, composed from a field it does not have.
@composable(as="ticket", fields="title,resolution", list="ticketsToComposeByResolution")
concept ticket {
  ownerUserId  string
  title        string
  status       string
}

/// The tickets a composed file is made from.
query ticket ticketsToComposeByResolution {
  filter status == "open"
  sort "row.createdAt", "desc"
  paginate 20
}
