/// A work-spine template that also fires on every node that joins.
@template
@trigger(event="node.created", concept="v1:cluster:node", partition="*")
automation raiseRequestedTicketTriggered {
  args {
    /// The ticket's title.
    title  string!
  }

  step raise {
    mutation raiseTicketTemplate (title: args.title)
  }
}
