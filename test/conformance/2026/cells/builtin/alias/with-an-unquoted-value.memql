/// Today's date key in a timezone, for naming a daily ticket; also callable as ticketDayKey.
@executor("integration.timeutil.dateKeyInTimezone")
@alias(ticketDayKey)
builtin ticketDateKeyAlias {
  timezone  string  @description("An IANA timezone; UTC when empty.")
  now       string  @description("The instant to key, RFC3339.")
}
