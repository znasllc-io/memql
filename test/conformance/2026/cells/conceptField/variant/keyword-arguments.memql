/// A support ticket, and where to reply: an email address or a phone number, whichever replyVia names.
concept ticket {
  title     string
  status    string
  replyVia  enum("email", "phone")!
  replyTo   object!  @variant(discriminator="replyVia") {
    email {
      address  string!
    }
    phone {
      number  string!
    }
  }
}
