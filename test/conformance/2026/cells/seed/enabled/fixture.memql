/// The row this cell's seed writes.
concept cannedReply {
  text  string
}

/// The mutation the seed materializer writes this concept's rows through: create<Concept>.
mutation cannedReply createCannedReply {
  args {
    cannedReplyId  string!
    text           string!
  }
  insert {
    id: args.cannedReplyId
    text: args.text
  }
}
