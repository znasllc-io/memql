/// The row this cell's seed writes.
concept helpArticle {
  title  string
}

/// The mutation the seed materializer writes this concept's rows through: create<Concept>.
mutate helpArticle createHelpArticle {
  args {
    helpArticleId  string!
    title          string!
  }
  insert {
    id: args.helpArticleId
    title: args.title
  }
}
