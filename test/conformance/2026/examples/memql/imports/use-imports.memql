use library.concepts.{ artifact, folder }
use library.shapes.{ artifactFull }
use common.traits.{ isActiveRecord, isNotDeleted }

/// Live artifacts filed under a folder.
query artifact liveArtifactsInFolder {
  args {
    folderId  string  @required
  }
  filter   row => row.folderId == args.folderId && isActiveRecord(row)
  shape    artifactFull
  paginate 50
}

/// Folders nobody has deleted.
query folder undeletedFolders {
  filter   row => isNotDeleted(row)
  paginate 50
}
