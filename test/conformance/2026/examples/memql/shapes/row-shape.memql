/// Per-(folderId, agentId) retention override.
concept retentionOverride {
  folderId  string!
  agentId   string!
  mode      enum("keep_forever", "keep_one_year", "inherit")!
  active    bool
}

@row
/// Per-(folder, agent) retention override projection
shape retentionOverride retentionOverrideFull {
  row.id
  folderId
  agentId
  mode
  active
  row.createdAt
}
