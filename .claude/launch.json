{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "memql-full",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["-f", "docker/docker-compose.full.yml", "up"],
      "port": 8085
    },
    {
      "name": "memql-polyphon",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["-f", "docker/docker-compose.full.yml", "-f", "docker/docker-compose.polyphon.yml", "up"],
      "port": 8085
    },
    {
      "name": "postgres-only",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["-f", "docker/docker-compose.full.yml", "up", "postgres"],
      "port": 5432
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd /Users/znas/develop/frontend && npm run dev"],
      "port": 8080
    },
    {
      "name": "copresent-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd /Users/znas/projects/copresent && npx vite --host 0.0.0.0 --port 8080 --clearScreen false"],
      "port": 8080
    },
    {
      "name": "identity-admin",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "sleep infinity"],
      "port": 8081
    }
  ]
}
