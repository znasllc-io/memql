{
  "name": "memql-productivity-tools",
  "displayName": "MemQL Productivity Tools",
  "description": "Documents, emails, PDFs and human-reviewed suggestions connected to MemQL.",
  "version": "0.2.0",
  "publisher": "znasllc",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/znasllc-io/memql.git",
    "directory": "editors/productivity"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icons/memql.png",
  "main": "./out/extension.js",
  "browser": "./out/webExtension.js",
  "extensionDependencies": [
    "znasllc.memql"
  ],
  "activationEvents": [
    "onFileSystem:memql-file",
    "onUri"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Offline editing is available. Connecting to MemQL requires a trusted workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "memql.productivity.openFile",
        "title": "Open File from MemQL",
        "category": "MemQL"
      },
      {
        "command": "memql.productivity.compareLatest",
        "title": "Compare with Latest Revision",
        "category": "MemQL"
      },
      {
        "command": "memql.productivity.useComparedRevision",
        "title": "Use Compared Revision as Save Base",
        "category": "MemQL"
      },
      {
        "command": "memql.productivity.markdown.source",
        "title": "Markdown Source",
        "category": "MemQL",
        "icon": "$(code)"
      },
      {
        "command": "memql.productivity.markdown.reading",
        "title": "Markdown Reading View",
        "category": "MemQL",
        "icon": "$(preview)"
      },
      {
        "command": "memql.productivity.markdown.review",
        "title": "Markdown Review",
        "shortTitle": "Review",
        "category": "MemQL",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "memql.productivity.markdown.split",
        "title": "Markdown Split View",
        "category": "MemQL",
        "icon": "$(open-preview)"
      },
      {
        "command": "memql.productivity.email.design",
        "title": "Email Design",
        "category": "MemQL",
        "icon": "$(preview)"
      },
      {
        "command": "memql.productivity.email.source",
        "title": "Email Source",
        "category": "MemQL",
        "icon": "$(code)"
      },
      {
        "command": "memql.productivity.email.split",
        "title": "Email Split View",
        "category": "MemQL",
        "icon": "$(open-preview)"
      },
      {
        "command": "memql.productivity.markdown.copy",
        "title": "Copy",
        "category": "MemQL"
      },
      {
        "command": "memql.productivity.markdown.feedback",
        "title": "Feedback",
        "category": "MemQL"
      },
      {
        "command": "memql.productivity.checkTools",
        "title": "Check Editor Tools",
        "category": "MemQL"
      },
      {
        "command": "memql.productivity.markdown.note",
        "title": "Add note",
        "category": "MemQL"
      },
      {
        "command": "memql.productivity.newMarkdown",
        "title": "New Markdown Document",
        "category": "MemQL"
      },
      {
        "command": "memql.productivity.markdown.insertImage",
        "title": "Insert Image into Markdown",
        "category": "MemQL",
        "icon": "$(file-media)"
      },
      {
        "command": "memql.productivity.newEmail",
        "title": "New Email",
        "category": "MemQL"
      }
    ],
    "customEditors": [
      {
        "viewType": "memql.productivity.pdf",
        "displayName": "MemQL PDF",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "memql.productivity.markdown",
        "displayName": "MemQL Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "memql.productivity.email",
        "displayName": "MemQL Email Template",
        "selector": [
          {
            "filenamePattern": "*.email.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "memql.productivity.newEmail",
        "displayName": "New Email",
        "selector": [
          {
            "filenamePattern": "memql-file:/new-email/*/*"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "*.email.json"
        ],
        "url": "./media/email.schema.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "memql.productivity.markdown.copy",
          "when": "false"
        },
        {
          "command": "memql.productivity.markdown.feedback",
          "when": "false"
        },
        {
          "command": "memql.productivity.markdown.note",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "memql.productivity.markdown.copy",
          "when": "webviewId == memql.productivity.markdown && webviewSection == markdownReadOnly",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "memql.productivity.markdown.feedback",
          "when": "webviewId == memql.productivity.markdown && webviewSection == markdownReadOnly && memqlMarkdownFeedback",
          "group": "6_feedback"
        },
        {
          "command": "memql.productivity.markdown.note",
          "when": "webviewId == memql.productivity.markdown && webviewSection == markdownReadOnly && memqlMarkdownNote",
          "group": "6_feedback@2"
        }
      ],
      "editor/title": [
        {
          "command": "memql.productivity.markdown.source",
          "when": "resourceLangId == markdown || resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "navigation@1"
        },
        {
          "command": "memql.productivity.markdown.reading",
          "when": "resourceLangId == markdown || resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "navigation@2"
        },
        {
          "command": "memql.productivity.markdown.review",
          "when": "resourceLangId == markdown || resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "navigation@3"
        },
        {
          "command": "memql.productivity.markdown.split",
          "when": "resourceLangId == markdown || resourceFilename =~ /\\.(md|markdown)$/i",
          "group": "2_markdown@4"
        },
        {
          "command": "memql.productivity.email.design",
          "when": "resourceFilename =~ /\\.email\\.json$/i",
          "group": "navigation@1"
        },
        {
          "command": "memql.productivity.email.source",
          "when": "resourceFilename =~ /\\.email\\.json$/i",
          "group": "navigation@2"
        },
        {
          "command": "memql.productivity.email.split",
          "when": "resourceFilename =~ /\\.email\\.json$/i",
          "group": "2_email@3"
        },
        {
          "command": "memql.productivity.markdown.insertImage",
          "when": "resourceScheme == memql-file && resourceLangId == markdown && activeCustomEditorId != memql.productivity.markdown",
          "group": "2_markdown@5"
        }
      ]
    },
    "configuration": {
      "title": "MemQL Productivity",
      "properties": {
        "memql.productivity.osTheme": {
          "type": "string",
          "enum": [
            "ask",
            "match",
            "keep"
          ],
          "enumDescriptions": [
            "Ask once when opening a file from MemQL OS.",
            "Match MemQL OS each time a file opens.",
            "Keep the current editor theme."
          ],
          "default": "ask",
          "scope": "application",
          "description": "Theme matching for files opened from MemQL OS in an installed editor. High contrast themes are preserved."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "vscode:prepublish": "npm run compile",
    "test": "node esbuild.test.js && node --test dist-test/*.test.js",
    "gallery": "node gallery/build.mjs",
    "gallery:shoot": "node ../vscode/gallery/shoot.mjs --dir=dist-gallery",
    "package": "npm run compile && npx --yes @vscode/vsce@latest package --no-dependencies"
  },
  "dependencies": {
    "@znasllc-io/memql-sdk-core": "file:../../sdk/ts",
    "image-size": "2.0.4",
    "markdown-it": "14.3.1",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.28.1",
    "jsdom": "26.1.0",
    "typescript": "^5.4.0"
  }
}
