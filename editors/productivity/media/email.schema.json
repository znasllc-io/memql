{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemQL email",
  "description": "An email is either a layout (blocks) or custom HTML (textBody and htmlBody).",
  "oneOf": [
    {
      "$ref": "#/definitions/layoutEmail"
    },
    {
      "$ref": "#/definitions/customEmail"
    }
  ],
  "definitions": {
    "layoutEmail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "theme",
        "blocks"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 998,
          "pattern": "^(?=.*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "patternErrorMessage": "Enter a subject on one line.",
          "description": "One line."
        },
        "preheader": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "patternErrorMessage": "The preheader must be one line of 200 characters or fewer.",
          "description": "The preview line after the subject: one line, up to 200 characters."
        },
        "layout": {
          "type": "string",
          "description": "The layout this email was made from. Leave it as it is."
        },
        "theme": {
          "$ref": "#/definitions/theme"
        },
        "blocks": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "$ref": "#/definitions/block"
          }
        }
      }
    },
    "customEmail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "textBody",
        "htmlBody"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 998,
          "pattern": "^(?=.*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "patternErrorMessage": "Enter a subject on one line.",
          "description": "One line."
        },
        "preheader": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "patternErrorMessage": "The preheader must be one line of 200 characters or fewer.",
          "description": "The preview line after the subject: one line, up to 200 characters."
        },
        "textBody": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "patternErrorMessage": "Include a plain-text version.",
          "description": "The plain-text version."
        },
        "htmlBody": {
          "type": "string"
        }
      }
    },
    "theme": {
