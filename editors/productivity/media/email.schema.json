          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9 -]{0,39}$",
          "patternErrorMessage": "Enter a font name using letters, digits, spaces or hyphens.",
          "description": "A font name using letters, digits, spaces or hyphens."
        },
        "bodyFont": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9 -]{0,39}$",
