{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemQL email template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "textBody",
    "htmlBody"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "textBody": {
      "type": "string"
    },
    "htmlBody": {
      "type": "string"
    }
  }
}
