{
  "$schema": "vscode://schemas/color-theme",
  "name": "MemQL Light",
  "type": "light",
  "colors": {
    "focusBorder": "#047d5a",
    "foreground": "#14201a",
    "descriptionForeground": "#586159",
    "errorForeground": "#b42318",
    "widget.border": "#d6ddd4",
    "sash.hoverBorder": "#047d5a",
    "editor.background": "#f2f4ef",
    "editor.foreground": "#14201a",
    "editor.selectionBackground": "#c2cabf",
    "editor.selectionHighlightBackground": "#d6ddd4",
    "editor.lineHighlightBackground": "#e9ede6",
    "editor.findMatchBackground": "#c2cabf",
    "editor.findMatchHighlightBackground": "#d6ddd4",
    "editorCursor.foreground": "#047d5a",
    "editorLineNumber.foreground": "#586159",
    "editorLineNumber.activeForeground": "#047d5a",
    "editorWhitespace.foreground": "#7c847b",
    "editorIndentGuide.background1": "#d6ddd4",
    "editorIndentGuide.activeBackground1": "#c2cabf",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#d6ddd4",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#d6ddd4",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#d6ddd4",
    "editorSuggestWidget.selectedBackground": "#c2cabf",
    "editorSuggestWidget.highlightForeground": "#047d5a",
    "editorGroup.border": "#d6ddd4",
    "editorGroupHeader.tabsBackground": "#ffffff",
    "editorError.foreground": "#b42318",
    "editorWarning.foreground": "#b45309",
    "editorInfo.foreground": "#047d5a",
    "sideBar.background": "#ffffff",
    "sideBar.foreground": "#14201a",
    "sideBar.border": "#d6ddd4",
    "sideBarTitle.foreground": "#586159",
    "sideBarSectionHeader.background": "#e9ede6",
    "sideBarSectionHeader.foreground": "#14201a",
    "sideBarSectionHeader.border": "#d6ddd4",
    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#047d5a",
    "activityBar.inactiveForeground": "#586159",
    "activityBar.border": "#d6ddd4",
    "activityBar.activeBorder": "#047d5a",
    "activityBarBadge.background": "#047d5a",
    "activityBarBadge.foreground": "#ffffff",
    "list.activeSelectionBackground": "#c2cabf",
    "list.activeSelectionForeground": "#14201a",
    "list.inactiveSelectionBackground": "#d6ddd4",
    "list.inactiveSelectionForeground": "#14201a",
    "list.hoverBackground": "#e9ede6",
    "list.hoverForeground": "#14201a",
    "list.focusBackground": "#c2cabf",
    "list.focusForeground": "#14201a",
    "list.focusOutline": "#047d5a",
    "list.highlightForeground": "#047d5a",
    "list.errorForeground": "#b42318",
    "list.warningForeground": "#b45309",
    "tree.indentGuidesStroke": "#d6ddd4",
    "statusBar.background": "#026842",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#026842",
    "statusBar.noFolderBackground": "#026842",
    "statusBar.noFolderForeground": "#ffffff",
    "statusBar.debuggingBackground": "#b45309",
    "statusBar.debuggingForeground": "#f2f4ef",
    "statusBarItem.remoteBackground": "#047d5a",
    "statusBarItem.remoteForeground": "#ffffff",
    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#14201a",
    "titleBar.inactiveBackground": "#ffffff",
    "titleBar.inactiveForeground": "#586159",
    "titleBar.border": "#d6ddd4",
    "tab.activeBackground": "#f2f4ef",
    "tab.activeForeground": "#14201a",
    "tab.inactiveBackground": "#ffffff",
    "tab.inactiveForeground": "#586159",
    "tab.border": "#d6ddd4",
    "tab.activeBorderTop": "#047d5a",
    "tab.unfocusedActiveBorderTop": "#c2cabf",
    "tab.hoverBackground": "#e9ede6",
    "button.background": "#047d5a",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#026842",
    "button.secondaryBackground": "#e9ede6",
    "button.secondaryForeground": "#14201a",
    "button.secondaryHoverBackground": "#d6ddd4",
    "badge.background": "#047d5a",
    "badge.foreground": "#ffffff",
    "input.background": "#ffffff",
    "input.foreground": "#14201a",
    "input.border": "#c2cabf",
    "input.placeholderForeground": "#586159",
    "inputOption.activeBorder": "#047d5a",
    "inputValidation.errorBackground": "#ffffff",
    "inputValidation.errorForeground": "#14201a",
    "inputValidation.errorBorder": "#b42318",
    "dropdown.background": "#ffffff",
    "dropdown.foreground": "#14201a",
    "dropdown.border": "#c2cabf",
    "panel.background": "#f2f4ef",
    "panel.border": "#d6ddd4",
    "panelTitle.activeForeground": "#14201a",
    "panelTitle.inactiveForeground": "#586159",
    "panelTitle.activeBorder": "#047d5a",
    "terminal.background": "#f2f4ef",
    "terminal.foreground": "#14201a",
    "quickInput.background": "#ffffff",
    "quickInput.foreground": "#14201a",
    "quickInputList.focusBackground": "#c2cabf",
    "quickInputList.focusForeground": "#14201a",
    "menu.background": "#ffffff",
    "menu.foreground": "#14201a",
    "menu.border": "#d6ddd4",
    "menu.selectionBackground": "#c2cabf",
    "menu.selectionForeground": "#14201a",
    "notifications.background": "#ffffff",
    "notifications.foreground": "#14201a",
    "notifications.border": "#d6ddd4",
    "notificationLink.foreground": "#047d5a",
    "breadcrumb.background": "#f2f4ef",
    "breadcrumb.foreground": "#586159",
    "breadcrumb.focusForeground": "#14201a"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#586159",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "constant.character"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "name": "Number and language constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Keyword, storage and annotation",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage",
        "storage.modifier",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#047d5a"
      }
    }
  ]
}
