{
  "$schema": "vscode://schemas/color-theme",
  "name": "MemQL Dark",
  "type": "dark",
  "colors": {
    "focusBorder": "#5ccda7",
    "foreground": "#e8e6dd",
    "descriptionForeground": "#9ca395",
    "errorForeground": "#e0705f",
    "widget.border": "#313a35",
    "sash.hoverBorder": "#5ccda7",
    "editor.background": "#1b1d1d",
    "editor.foreground": "#e8e6dd",
    "editor.selectionBackground": "#414d46",
    "editor.selectionHighlightBackground": "#313a35",
    "editor.lineHighlightBackground": "#282c29",
    "editor.findMatchBackground": "#414d46",
    "editor.findMatchHighlightBackground": "#313a35",
    "editorCursor.foreground": "#5ccda7",
    "editorLineNumber.foreground": "#9ca395",
    "editorLineNumber.activeForeground": "#5ccda7",
    "editorWhitespace.foreground": "#6c726a",
    "editorIndentGuide.background1": "#313a35",
    "editorIndentGuide.activeBackground1": "#414d46",
    "editorWidget.background": "#212625",
    "editorWidget.border": "#313a35",
    "editorHoverWidget.background": "#212625",
    "editorHoverWidget.border": "#313a35",
    "editorSuggestWidget.background": "#212625",
    "editorSuggestWidget.border": "#313a35",
    "editorSuggestWidget.selectedBackground": "#414d46",
    "editorSuggestWidget.highlightForeground": "#5ccda7",
    "editorGroup.border": "#313a35",
    "editorGroupHeader.tabsBackground": "#212625",
    "editorError.foreground": "#e0705f",
    "editorWarning.foreground": "#cbb083",
    "editorInfo.foreground": "#5ccda7",
    "sideBar.background": "#212625",
    "sideBar.foreground": "#e8e6dd",
    "sideBar.border": "#313a35",
    "sideBarTitle.foreground": "#9ca395",
    "sideBarSectionHeader.background": "#282c29",
    "sideBarSectionHeader.foreground": "#e8e6dd",
    "sideBarSectionHeader.border": "#313a35",
    "activityBar.background": "#212625",
    "activityBar.foreground": "#5ccda7",
    "activityBar.inactiveForeground": "#9ca395",
    "activityBar.border": "#313a35",
    "activityBar.activeBorder": "#5ccda7",
    "activityBarBadge.background": "#5ccda7",
    "activityBarBadge.foreground": "#07090a",
    "list.activeSelectionBackground": "#414d46",
    "list.activeSelectionForeground": "#e8e6dd",
    "list.inactiveSelectionBackground": "#313a35",
    "list.inactiveSelectionForeground": "#e8e6dd",
    "list.hoverBackground": "#282c29",
    "list.hoverForeground": "#e8e6dd",
    "list.focusBackground": "#414d46",
    "list.focusForeground": "#e8e6dd",
    "list.focusOutline": "#5ccda7",
    "list.highlightForeground": "#5ccda7",
    "list.errorForeground": "#e0705f",
    "list.warningForeground": "#cbb083",
    "tree.indentGuidesStroke": "#313a35",
    "statusBar.background": "#026842",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#026842",
    "statusBar.noFolderBackground": "#026842",
    "statusBar.noFolderForeground": "#ffffff",
    "statusBar.debuggingBackground": "#cbb083",
    "statusBar.debuggingForeground": "#1b1d1d",
    "statusBarItem.remoteBackground": "#5ccda7",
    "statusBarItem.remoteForeground": "#07090a",
    "titleBar.activeBackground": "#212625",
    "titleBar.activeForeground": "#e8e6dd",
    "titleBar.inactiveBackground": "#212625",
    "titleBar.inactiveForeground": "#9ca395",
    "titleBar.border": "#313a35",
    "tab.activeBackground": "#1b1d1d",
    "tab.activeForeground": "#e8e6dd",
    "tab.inactiveBackground": "#212625",
    "tab.inactiveForeground": "#9ca395",
    "tab.border": "#313a35",
    "tab.activeBorderTop": "#5ccda7",
    "tab.unfocusedActiveBorderTop": "#414d46",
    "tab.hoverBackground": "#282c29",
    "button.background": "#5ccda7",
    "button.foreground": "#07090a",
    "button.hoverBackground": "#98ffe0",
    "button.secondaryBackground": "#282c29",
    "button.secondaryForeground": "#e8e6dd",
    "button.secondaryHoverBackground": "#313a35",
    "badge.background": "#5ccda7",
    "badge.foreground": "#07090a",
    "input.background": "#212625",
    "input.foreground": "#e8e6dd",
    "input.border": "#414d46",
    "input.placeholderForeground": "#9ca395",
    "inputOption.activeBorder": "#5ccda7",
    "inputValidation.errorBackground": "#212625",
    "inputValidation.errorForeground": "#e8e6dd",
    "inputValidation.errorBorder": "#e0705f",
    "dropdown.background": "#212625",
    "dropdown.foreground": "#e8e6dd",
    "dropdown.border": "#414d46",
    "panel.background": "#1b1d1d",
    "panel.border": "#313a35",
    "panelTitle.activeForeground": "#e8e6dd",
    "panelTitle.inactiveForeground": "#9ca395",
    "panelTitle.activeBorder": "#5ccda7",
    "terminal.background": "#1b1d1d",
    "terminal.foreground": "#e8e6dd",
    "quickInput.background": "#212625",
    "quickInput.foreground": "#e8e6dd",
    "quickInputList.focusBackground": "#414d46",
    "quickInputList.focusForeground": "#e8e6dd",
    "menu.background": "#212625",
    "menu.foreground": "#e8e6dd",
    "menu.border": "#313a35",
    "menu.selectionBackground": "#414d46",
    "menu.selectionForeground": "#e8e6dd",
    "notifications.background": "#212625",
    "notifications.foreground": "#e8e6dd",
    "notifications.border": "#313a35",
    "notificationLink.foreground": "#5ccda7",
    "breadcrumb.background": "#1b1d1d",
    "breadcrumb.foreground": "#9ca395",
    "breadcrumb.focusForeground": "#e8e6dd"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9ca395",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "constant.character"
      ],
      "settings": {
        "foreground": "#cbb083"
      }
    },
    {
      "name": "Number and language constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#98ffe0"
      }
    },
    {
      "name": "Keyword, storage and annotation",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage",
        "storage.modifier",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#5ccda7"
      }
    }
  ]
}
