{
  "name": "memql",
  "displayName": "MemQL",
  "description": "Language support for MemQL (.memql): syntax highlighting, diagnostics, completion, hover, and signature help, powered by the offline memql-lsp language server.",
  "version": "0.3.0",
  "publisher": "znasllc",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znasllc-io/memql.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:memql",
    "onView:memqlClusters"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Language features (highlighting, diagnostics, completion, hover, signature help) work in untrusted workspaces. Connecting to a cluster, browsing its data, and running a construct against it require trust: those read credentials from ~/.memql/clusters.yaml, open a network connection, and execute code against a live cluster, which a malicious workspace must not be able to trigger. Run configurations live in the workspace so a repository can ship one, and nothing ever runs automatically -- a CodeLens renders an affordance and there is no run-on-save.",
      "restrictedConfigurations": [
        "memql.lsp.serverPath"
      ]
    }
  },
  "main": "./out/extension.js",
  "icon": "icons/memql.png",
  "contributes": {
    "languages": [
      {
        "id": "memql",
        "aliases": [
          "MemQL",
          "memql"
        ],
        "extensions": [
          ".memql"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/memql.png",
          "dark": "./icons/memql.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "memql",
        "scopeName": "source.memql",
        "path": "./syntaxes/memql.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "MemQL",
      "properties": {
        "memql.lsp.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the memql-lsp binary. When empty, the extension uses the bundled platform binary if present, otherwise 'memql-lsp' on PATH. Read from your USER settings only: a value in workspace settings (.vscode/settings.json) is refused and a warning says so, because a workspace-supplied path would let an opened folder point the extension at any executable on your machine. When no binary resolves, only language features are lost -- the Clusters, Concepts and Runs views do not use the language server."
        },
        "memql.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the memql-lsp server."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "memql",
        "scopes": {
          "keyword": [
            "keyword.control.memql"
          ],
          "variable": [
            "variable.other.memql"
          ],
          "string": [
            "string.quoted.double.memql"
          ],
          "number": [
            "constant.numeric.memql"
          ],
          "operator": [
            "keyword.operator.memql"
          ],
          "decorator": [
            "storage.modifier.memql"
          ],
          "comment": [
            "comment.line.memql"
          ],
          "type": [
            "entity.name.type.memql"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memql",
          "title": "memQL",
          "icon": "icons/memql-activity.svg"
        }
      ]
    },
    "views": {
      "memql": [
        {
          "id": "memqlDeployments",
          "name": "Deployments",
          "when": "isWorkspaceTrusted"
        },
        {
          "id": "memqlClusters",
          "name": "Clusters",
          "when": "isWorkspaceTrusted"
        },
        {
          "id": "memqlConstructs",
          "name": "Constructs",
          "when": "isWorkspaceTrusted"
        },
        {
          "id": "memqlData",
          "name": "Data",
          "when": "isWorkspaceTrusted"
        },
        {
          "id": "memqlRuns",
          "name": "Runs",
          "when": "isWorkspaceTrusted"
        }
      ]
    },
    "commands": [
      {
        "command": "memql.clusters.refresh",
        "title": "memQL: Refresh Clusters",
        "icon": "$(refresh)"
      },
      {
        "command": "memql.clusters.select",
        "title": "memQL: Select Cluster"
      },
      {
        "command": "memql.clusters.add",
        "title": "memQL: Add Cluster",
        "icon": "$(add)"
      },
      {
        "command": "memql.clusters.edit",
        "title": "memQL: Edit Cluster",
        "icon": "$(edit)"
      },
      {
        "command": "memql.clusters.remove",
        "title": "memQL: Remove Cluster From List",
        "icon": "$(trash)"
      },
      {
        "command": "memql.clusters.uninstall",
        "title": "memQL: Uninstall Local Cluster..."
      },
      {
        "command": "memql.constructs.refresh",
        "title": "memQL: Refresh Constructs",
        "icon": "$(refresh)"
      },
      {
        "command": "memql.constructs.open",
        "title": "memQL: Open Construct"
      },
      {
        "command": "memql.deployments.refresh",
        "title": "memQL: Refresh Deployments",
        "icon": "$(refresh)"
      },
      {
        "command": "memql.deployments.createDeployment",
        "title": "memQL: Create Deployment...",
        "icon": "$(add)"
      },
      {
        "command": "memql.deployments.open",
        "title": "memQL: Open Local Deployment",
        "icon": "$(server)"
      },
      {
        "command": "memql.clusters.repair",
        "title": "memQL: Repair Local Cluster"
      },
      {
        "command": "memql.clusters.takeOwnership",
        "title": "memQL: Take Ownership (enrol a passkey)",
        "icon": "$(key)"
      },
      {
        "command": "memql.clusters.signIn",
        "title": "memQL: Sign In",
        "icon": "$(sign-in)"
      },
      {
        "command": "memql.clusters.signOut",
        "title": "memQL: Sign Out"
      },
      {
        "command": "memql.clusters.disconnect",
        "title": "memQL: Disconnect"
      },
      {
        "command": "memql.clusters.signInWithCode",
        "title": "memQL: Sign In With a Device Code"
      },
      {
        "command": "memql.clusters.connection",
        "title": "memQL: Open Cluster Connection",
        "icon": "$(plug)"
      },
      {
        "command": "memql.clusters.openPortal",
        "title": "memQL: Open Portal",
        "icon": "$(link-external)"
      },
      {
        "command": "memql.data.refresh",
        "title": "memQL: Refresh Data",
        "icon": "$(refresh)"
      },
      {
        "command": "memql.data.open",
        "title": "memQL: Browse Concept Rows"
      },
      {
        "command": "memql.runs.refresh",
        "title": "memQL: Refresh Runs",
        "icon": "$(refresh)"
      },
      {
        "command": "memql.runs.open",
        "title": "memQL: Open Run Configurations File",
        "icon": "$(json)"
      },
      {
        "command": "memql.runs.execute",
        "title": "memQL: Run Configuration",
        "icon": "$(play)"
      },
      {
        "command": "memql.runs.delete",
        "title": "memQL: Delete Run Configuration",
        "icon": "$(trash)"
      },
      {
        "command": "memql.run.construct",
        "title": "memQL: Run Construct"
      },
      {
        "command": "memql.run.constructWith",
        "title": "memQL: Run Construct With Arguments"
      },
      {
        "command": "memql.run.automation",
        "title": "memQL: Run Automation"
      },
      {
        "command": "memql.training.dryRun",
        "title": "memQL: Dry-run Construct Against The Cluster"
      },
      {
        "command": "memql.training.tryInSession",
        "title": "memQL: Try Construct In This Session"
      },
      {
        "command": "memql.training.promote",
        "title": "memQL: Promote Construct To The Cluster"
      },
      {
        "command": "memql.training.demote",
        "title": "memQL: Demote Construct From The Cluster"
      },
      {
        "command": "memql.training.showList",
        "title": "memQL: Show Untrained And Drifted Constructs"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "memql.clusters.refresh",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.select",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.constructs.refresh",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.constructs.open",
          "when": "false"
        },
        {
          "command": "memql.deployments.refresh",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.deployments.createDeployment",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.deployments.open",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.add",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.edit",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.remove",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.uninstall",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.repair",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.takeOwnership",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.signIn",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.signOut",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.disconnect",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.signInWithCode",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.connection",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.clusters.openPortal",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.data.refresh",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.data.open",
          "when": "false"
        },
        {
          "command": "memql.runs.refresh",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.runs.open",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "memql.runs.execute",
          "when": "false"
        },
        {
          "command": "memql.runs.delete",
          "when": "false"
        },
        {
          "command": "memql.run.construct",
          "when": "false"
        },
        {
          "command": "memql.run.constructWith",
          "when": "false"
        },
        {
          "command": "memql.run.automation",
          "when": "false"
        },
        {
          "command": "memql.training.dryRun",
          "when": "false"
        },
        {
          "command": "memql.training.tryInSession",
          "when": "false"
        },
        {
          "command": "memql.training.promote",
          "when": "false"
        },
        {
          "command": "memql.training.demote",
          "when": "false"
        },
        {
          "command": "memql.training.showList",
          "when": "isWorkspaceTrusted"
        }
      ],
      "view/title": [
        {
          "command": "memql.deployments.refresh",
          "when": "view == memqlDeployments",
          "group": "navigation@1"
        },
        {
          "command": "memql.clusters.add",
          "when": "view == memqlClusters",
          "group": "navigation@1"
        },
        {
          "command": "memql.clusters.refresh",
          "when": "view == memqlClusters",
          "group": "navigation@2"
        },
        {
          "command": "memql.constructs.refresh",
          "when": "view == memqlConstructs",
          "group": "navigation@1"
        },
        {
          "command": "memql.data.refresh",
          "when": "view == memqlData",
          "group": "navigation@1"
        },
        {
          "command": "memql.runs.open",
          "when": "view == memqlRuns",
          "group": "navigation@1"
        },
        {
          "command": "memql.runs.refresh",
          "when": "view == memqlRuns",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "memql.clusters.connection",
          "when": "view == memqlClusters && (viewItem == memqlCluster || viewItem == memqlLocalCluster)",
          "group": "inline@1"
        },
        {
          "command": "memql.clusters.openPortal",
          "when": "view == memqlClusters && (viewItem == memqlCluster || viewItem == memqlLocalCluster)",
          "group": "inline@2"
        },
        {
          "command": "memql.clusters.edit",
          "when": "view == memqlClusters && (viewItem == memqlCluster || viewItem == memqlLocalCluster)",
          "group": "inline@3"
        },
        {
          "command": "memql.clusters.remove",
          "when": "view == memqlClusters && (viewItem == memqlCluster || viewItem == memqlLocalCluster)",
          "group": "inline@4"
        },
        {
          "command": "memql.clusters.signIn",
          "when": "view == memqlClusters && (viewItem == memqlCluster || viewItem == memqlLocalCluster)",
          "group": "auth@1"
        },
        {
          "command": "memql.clusters.signOut",
          "when": "view == memqlClusters && (viewItem == memqlCluster || viewItem == memqlLocalCluster)",
          "group": "auth@2"
        },
        {
          "command": "memql.deployments.createDeployment",
          "when": "view == memqlDeployments && viewItem == memqlLocalInstanceAbsent",
          "group": "inline@1"
        },
        {
          "command": "memql.clusters.repair",
          "when": "view == memqlDeployments && viewItem == memqlLocalInstance",
          "group": "lifecycle@1"
        },
        {
          "command": "memql.clusters.uninstall",
          "when": "view == memqlDeployments && viewItem == memqlLocalInstance",
          "group": "lifecycle@2"
        },
        {
          "command": "memql.runs.execute",
          "when": "view == memqlRuns && viewItem == memqlRun",
          "group": "inline@1"
        },
        {
          "command": "memql.runs.delete",
          "when": "view == memqlRuns && viewItem == memqlRun",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "build:install-cli": "esbuild src/install/cli.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-install/cli.js",
    "install-cli": "npm run build:install-cli && node dist-install/cli.js",
    "test": "tsc -p tsconfig.test.json && node esbuild.test.js && node --test dist-test/test/*.js",
    "test:host": "npm run compile && tsc -p tsconfig.host.json && node esbuild.host.js && node test-host/runner.js"
  },
  "dependencies": {
    "@znasllc-io/memql-sdk-core": "file:../../sdk/ts",
    "@znasllc-io/memql-view-kit": "file:../../sdk/ts-viewkit",
    "vscode-languageclient": "^10.1.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.91.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  }
}
