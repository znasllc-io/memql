{
  "name": "memql",
  "displayName": "MemQL",
  "description": "MemQL language support for Visual Studio Code and Cursor, plus installing, connecting to and working with MemQL clusters.",
  "version": "0.6.1",
  "publisher": "znasllc",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znasllc-io/memql.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "memql": {
    "edition": "2026",
    "status": "frozen",
    "grammarVersion": "2026.09-dsl-v1-followups-9f344ecf"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:memql",
    "onView:memqlClusters",
    "onUri",
    "workspaceContains:**/*.memql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Language features work in Restricted Mode. Clusters, data and runs need a trusted workspace.",
      "restrictedConfigurations": [
        "memql.lsp.serverPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "main": "./out/extension.js",
  "icon": "icons/memql.png",
  "contributes": {
    "languages": [
      {
        "id": "memql",
        "aliases": [
          "MemQL",
          "memql"
        ],
        "extensions": [
          ".memql"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/memql.png",
          "dark": "./icons/memql.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "memql",
        "scopeName": "source.memql",
        "path": "./syntaxes/memql.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "MemQL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/memql-dark-color-theme.json"
      },
      {
        "label": "MemQL Light",
        "uiTheme": "vs",
        "path": "./themes/memql-light-color-theme.json"
      }
    ],
    "configuration": {
      "title": "MemQL",
      "properties": {
        "memql.appearance": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Match the editor's colour theme.",
            "Always use the MemQL light colours.",
            "Always use the MemQL dark colours."
          ],
          "default": "system",
          "description": "Colours for MemQL pages. System matches the editor's colour theme, and a high-contrast theme always wins."
        },
        "memql.lsp.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a memql-lsp binary; leave empty to use the bundled one or memql-lsp on your PATH. Read from user settings only, so a folder you open can't choose what runs."
        },
        "memql.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log messages between the editor and memql-lsp to the Output panel, for troubleshooting."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "memql",
        "scopes": {
          "keyword": [
            "keyword.control.memql"
          ],
          "variable": [
            "variable.other.memql"
          ],
          "string": [
            "string.quoted.double.memql"
          ],
          "number": [
            "constant.numeric.memql"
          ],
          "operator": [
            "keyword.operator.memql"
          ],
          "decorator": [
            "storage.modifier.memql"
          ],
          "comment": [
            "comment.line.memql"
          ],
          "type": [
            "entity.name.type.memql"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memql",
          "title": "MemQL",
          "icon": "icons/memql-activity.svg"
        }
      ]
    },
    "views": {
      "memql": [
        {
          "id": "memqlClusters",
          "name": "Clusters",
          "when": "isWorkspaceTrusted"
        },
        {
          "id": "memqlDeployments",
          "name": "Deployments",
          "when": "!isWeb && isWorkspaceTrusted"
        },
        {
          "id": "memqlConstructs",
          "name": "Constructs",
          "when": "!isWeb && isWorkspaceTrusted"
        },
        {
          "id": "memqlData",
          "name": "Data",
          "when": "!isWeb && isWorkspaceTrusted"
        },
        {
          "id": "memqlRuns",
          "name": "Runs",
          "when": "!isWeb && isWorkspaceTrusted"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "memqlClusters",
        "contents": "No clusters yet.\n[Install Local Cluster](command:memql.deployments.createDeployment)\n[Connect to a Cluster](command:memql.clusters.add)",
        "when": "!isWeb && (!memql.localClusterPresent)"
      },
      {
        "view": "memqlClusters",
        "contents": "A local cluster is running on this computer.\n[Connect](command:memql.clusters.connectLocal)\n[Add Another Cluster](command:memql.clusters.add)",
        "when": "memql.localClusterPresent"
      },
      {
        "view": "memqlDeployments",
        "contents": "Not connected to a cluster.\n[Show Local Cluster](command:memql.deployments.open)\n[Connect to a Cluster](command:memql.clusters.select)",
        "when": "!memql.clusterSelected && memql.localClusterPresent"
      },
      {
        "view": "memqlDeployments",
        "contents": "Not connected to a cluster.\n[Install Local Cluster](command:memql.deployments.createDeployment)\n[Connect to a Cluster](command:memql.clusters.select)",
        "when": "!isWeb && (!memql.clusterSelected && !memql.localClusterPresent)"
      },
      {
        "view": "memqlDeployments",
        "contents": "Sign in to see this cluster's history.\n[Sign In](command:memql.deployments.signIn)",
        "when": "memql.clusterSelected && memql.connectionState == signIn"
      },
      {
        "view": "memqlDeployments",
        "contents": "No history yet.",
        "when": "memql.clusterSelected && memql.connectionState == connected"
      },
      {
        "view": "memqlDeployments",
        "contents": "Connecting.",
        "when": "memql.clusterSelected && memql.connectionState == connecting"
      },
      {
        "view": "memqlDeployments",
        "contents": "Can't reach this cluster.\n[Show Details](command:memql.deployments.openCluster)",
        "when": "memql.clusterSelected && memql.connectionState == unreachable"
      },
      {
        "view": "memqlDeployments",
        "contents": "This cluster has no address.\n[Edit Cluster](command:memql.clusters.edit)",
        "when": "memql.clusterSelected && memql.connectionState == notConfigured"
      },
      {
        "view": "memqlConstructs",
        "contents": "Not connected to a cluster.\n[Connect to a Cluster](command:memql.clusters.select)\n[Add Cluster](command:memql.clusters.add)",
        "when": "!memql.clusterSelected"
      },
      {
        "view": "memqlConstructs",
        "contents": "Sign in to see constructs.\n[Sign In](command:memql.clusters.signIn)",
        "when": "memql.connectionState == signIn"
      },
      {
        "view": "memqlConstructs",
        "contents": "The cluster isn't answering.\n[Retry](command:memql.constructs.refresh)",
        "when": "memql.connectionState == unreachable"
      },
      {
        "view": "memqlConstructs",
        "contents": "This cluster has no address.\n[Edit Cluster](command:memql.clusters.edit)",
        "when": "memql.connectionState == notConfigured"
      },
      {
        "view": "memqlData",
        "contents": "Not connected to a cluster.\n[Connect to a Cluster](command:memql.clusters.select)\n[Add Cluster](command:memql.clusters.add)",
        "when": "!memql.clusterSelected"
      },
      {
        "view": "memqlData",
        "contents": "Sign in to see data.\n[Sign In](command:memql.clusters.signIn)",
        "when": "memql.connectionState == signIn"
      },
      {
        "view": "memqlData",
        "contents": "The cluster isn't answering.\n[Retry](command:memql.data.refresh)",
        "when": "memql.connectionState == unreachable"
      },
      {
        "view": "memqlData",
        "contents": "This cluster has no address.\n[Edit Cluster](command:memql.clusters.edit)",
        "when": "memql.connectionState == notConfigured"
      },
      {
        "view": "memqlRuns",
        "contents": "Runs you save from a Run form appear here.\n[Edit Saved Runs](command:memql.runs.open)",
        "when": "workbenchState != empty"
      },
      {
        "view": "memqlRuns",
        "contents": "Open a folder to save runs.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "memqlClusters",
        "contents": "[Connect to a Cluster](command:memql.clusters.add)",
        "when": "isWeb && !memql.clusterSelected"
      }
    ],
