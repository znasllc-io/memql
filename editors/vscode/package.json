      "view/title": [
        {
          "command": "memql.deployments.signIn",
          "when": "!isWeb && (view == memqlDeployments && memql.connectionState == signIn)",
          "group": "navigation@0"
        },
        {
          "command": "memql.deployments.openCluster",
          "when": "!isWeb && (view == memqlDeployments && memql.clusterSelected)",
          "group": "navigation@1"
        },
        {
          "command": "memql.deployments.createDeployment",
          "when": "!isWeb && (view == memqlDeployments && memql.deploymentsInstance == memqlLocalInstanceAbsent)",
          "group": "1_install@1"
        },
        {
          "command": "memql.deployments.changeVersion",
          "when": "!isWeb && (view == memqlDeployments && memql.deploymentsInstance == memqlLocalInstance)",
          "group": "2_version@1"
        },
        {
          "command": "memql.deployments.rebuildFromCheckout",
          "when": "!isWeb && (view == memqlDeployments && memql.deploymentsInstance == memqlLocalInstance && memql.deploymentsHasCheckout)",
          "group": "2_version@2"
        },
        {
          "command": "memql.deployments.updateAndRebuild",
          "when": "!isWeb && (view == memqlDeployments && memql.deploymentsInstance == memqlLocalInstance && memql.deploymentsHasBranch)",
          "group": "2_version@3"
        },
        {
          "command": "memql.deployments.openCheckout",
          "when": "!isWeb && (view == memqlDeployments && memql.deploymentsInstance == memqlLocalInstance && memql.deploymentsHasCheckout)",
          "group": "3_open@1"
        },
        {
          "command": "memql.clusters.repair",
          "when": "!isWeb && (view == memqlDeployments && memql.deploymentsInstance == memqlLocalInstance)",
          "group": "4_repair@1"
        },
        {
          "command": "memql.clusters.uninstall",
          "when": "!isWeb && (view == memqlDeployments && memql.deploymentsInstance == memqlLocalInstance)",
          "group": "9_danger@1"
        },
        {
          "command": "memql.clusters.add",
          "when": "view == memqlClusters",
          "group": "navigation@1"
        },
        {
          "command": "memql.deployments.createDeployment",
          "when": "!isWeb && (view == memqlClusters && !memql.localClusterPresent)",
          "group": "1_local@1"
        },
        {
          "command": "memql.clusters.repair",
          "when": "!isWeb && (view == memqlClusters && memql.localClusterPresent)",
          "group": "1_local@2"
        },
        {
          "command": "memql.constructs.refresh",
          "when": "!isWeb && (view == memqlConstructs)",
          "group": "navigation@1"
        },
        {
          "command": "memql.language.showReference",
          "when": "!isWeb && (view == memqlConstructs)",
          "group": "9_reference@1"
        },
        {
          "command": "memql.data.refresh",
          "when": "!isWeb && (view == memqlData)",
          "group": "navigation@1"
        },
        {
          "command": "memql.runs.open",
          "when": "!isWeb && (view == memqlRuns && workbenchState != empty)",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "memql.clusters.signIn",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;signIn(;|$)/",
          "group": "inline@1"
        },
        {
          "command": "memql.clusters.openConsole",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;connected(;.*)?;os(;|$)/",
          "group": "inline@1"
        },
        {
          "command": "memql.clusters.connection",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;/",
          "group": "1_open@1"
        },
        {
          "command": "memql.clusters.openConsole",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;.*;os(;|$)/",
          "group": "1_open@2"
        },
        {
          "command": "memql.clusters.signIn",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;signIn(;|$)/",
          "group": "2_session@1"
        },
        {
          "command": "memql.clusters.signInWithCode",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;signIn(;|$)/",
          "group": "2_session@2"
        },
        {
          "command": "memql.clusters.takeOwnership",
          "when": "!isWeb && (view == memqlClusters && viewItem =~ /^memqlCluster;.*;ownerSetup(;|$)/)",
          "group": "2_session@3"
        },
        {
          "command": "memql.clusters.disconnect",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;(connected|connecting)(;|$)/",
          "group": "2_session@4"
        },
        {
          "command": "memql.clusters.signOut",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;.*;signedIn(;|$)/",
          "group": "2_session@5"
        },
        {
          "command": "memql.clusters.edit",
          "when": "!isWeb && (view == memqlClusters && viewItem =~ /^memqlCluster;/)",
          "group": "3_edit@1"
        },
        {
          "command": "memql.clusters.remove",
          "when": "view == memqlClusters && viewItem =~ /^memqlCluster;/",
          "group": "9_remove@1"
        },
        {
          "command": "memql.runs.execute",
          "when": "!isWeb && (view == memqlRuns && viewItem == memqlRun && memql.connected)",
          "group": "inline@1"
        },
        {
          "command": "memql.runs.execute",
          "when": "!isWeb && (view == memqlRuns && viewItem == memqlRun && memql.connected)",
          "group": "1_run@1"
        },
        {
          "command": "memql.runs.delete",
          "when": "!isWeb && (view == memqlRuns && viewItem == memqlRun)",
          "group": "9_delete@1"
        },
        {
          "command": "memql.constructs.run",
          "when": "!isWeb && (view == memqlConstructs && viewItem == memqlRunnableConstruct && memql.connected)",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "build:install-cli": "esbuild src/install/cli.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-install/cli.js",
    "install-cli": "npm run build:install-cli && node dist-install/cli.js",
    "test": "tsc -p tsconfig.test.json && node esbuild.test.js && node --test dist-test/test/*.js",
    "test:host": "npm run compile && tsc -p tsconfig.host.json && node esbuild.host.js && node test-host/runner.js",
    "gallery": "node gallery/build.mjs",
    "gallery:shoot": "node gallery/shoot.mjs",
    "gallery:check": "node gallery/check.mjs"
  },
  "dependencies": {
    "@znasllc-io/memql-sdk-core": "file:../../sdk/ts",
    "@znasllc-io/memql-view-kit": "file:../../sdk/ts-viewkit",
    "vscode-languageclient": "^10.1.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.91.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.80",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "memql",
    "dsl",
    "language server",
    "kubernetes",
    "k3d",
    "graph database"
  ],
  "bugs": {
