{
  "name": "memql",
  "displayName": "MemQL",
  "description": "Language support for MemQL (.memql): syntax highlighting, diagnostics, completion, hover, and signature help, powered by the offline memql-lsp language server.",
  "version": "0.3.0",
  "publisher": "znasllc",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:memql",
    "onView:memqlClusters"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Language features (highlighting, diagnostics, completion, hover, signature help) work in untrusted workspaces. Connecting to a cluster and browsing its data require trust: those read credentials from ~/.memql/clusters.yaml and open a network connection, which a malicious workspace must not be able to trigger.",
      "restrictedConfigurations": ["memql.lsp.serverPath"]
    }
  },
  "main": "./out/extension.js",
  "icon": "icons/memql.png",
  "contributes": {
    "languages": [
      {
        "id": "memql",
        "aliases": [
          "MemQL",
          "memql"
        ],
        "extensions": [
          ".memql"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/memql.png",
          "dark": "./icons/memql.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "memql",
        "scopeName": "source.memql",
        "path": "./syntaxes/memql.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "MemQL",
      "properties": {
        "memql.lsp.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the memql-lsp binary. When empty, the extension uses the bundled platform binary if present, otherwise 'memql-lsp' on PATH. For security this is a machine/user-scoped setting only -- it is deliberately not configurable per workspace, so an untrusted folder cannot redirect the extension to an arbitrary executable."
        },
        "memql.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the memql-lsp server."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "memql",
        "scopes": {
          "keyword": [
            "keyword.control.memql"
          ],
          "variable": [
            "variable.other.memql"
          ],
          "string": [
            "string.quoted.double.memql"
          ],
          "number": [
            "constant.numeric.memql"
          ],
          "operator": [
            "keyword.operator.memql"
          ],
          "decorator": [
            "storage.modifier.memql"
          ],
          "comment": [
            "comment.line.memql"
          ],
          "type": [
            "entity.name.type.memql"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memql",
          "title": "memQL",
          "icon": "icons/memql-activity.svg"
        }
      ]
    },
    "views": {
      "memql": [
        {
          "id": "memqlClusters",
          "name": "Clusters"
        },
        {
          "id": "memqlConcepts",
          "name": "Concepts"
        }
      ]
    },
    "commands": [
      { "command": "memql.clusters.refresh", "title": "memQL: Refresh Clusters", "icon": "$(refresh)" },
      { "command": "memql.clusters.select", "title": "memQL: Select Cluster" },
      { "command": "memql.clusters.add", "title": "memQL: Add Cluster", "icon": "$(add)" },
      { "command": "memql.clusters.edit", "title": "memQL: Edit Cluster", "icon": "$(edit)" },
      { "command": "memql.clusters.disconnect", "title": "memQL: Disconnect" },
      { "command": "memql.concepts.refresh", "title": "memQL: Refresh Concepts", "icon": "$(refresh)" },
      { "command": "memql.concepts.open", "title": "memQL: Open Concept" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "memql.concepts.open", "when": "false" }
      ],
      "view/title": [
        { "command": "memql.clusters.add", "when": "view == memqlClusters", "group": "navigation@1" },
        { "command": "memql.clusters.refresh", "when": "view == memqlClusters", "group": "navigation@2" },
        { "command": "memql.concepts.refresh", "when": "view == memqlConcepts", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "memql.clusters.edit", "when": "view == memqlClusters && viewItem == memqlCluster", "group": "inline" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p tsconfig.test.json && node esbuild.test.js && node --test dist-test/test/*.js"
  },
  "dependencies": {
    "@znasllc-io/memql-sdk-core": "file:../../sdk/ts",
    "@znasllc-io/memql-view-kit": "file:../../sdk/ts-viewkit",
    "vscode-languageclient": "^10.1.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.91.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  }
}
