# deploy/systemd/memql-worker.service
# ============================================
#
# Template user-systemd unit for memql-worker on Linux.
# scripts/install/install-linux.sh copies this to
# ~/.config/systemd/user/ with the binary path filled in.
#
# User-systemd (not system-wide) is the right choice for the
# headless variant; the GUI variant additionally requires the
# user's X11 session, which is also user-scoped.

[Unit]
Description=memQL Cockpit Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__BINARY_PATH__ worker run
Restart=on-failure
RestartSec=5
StandardOutput=append:__STATE_DIR__/worker.log
StandardError=append:__STATE_DIR__/worker.log

# Environment file for the worker token + cluster URL. Marked with
# leading `-` so systemd doesn't fail if the file is missing; the
# worker also reads from ~/.memql/worker.yaml. Use this file (mode
# 0600) instead of inline Environment= so the token does NOT show
# up in `systemctl show` output.
EnvironmentFile=-__STATE_DIR__/../worker.env

# Resource caps. Phase 7 wires per-call rlimits on `exec` calls;
# these process-level caps are a coarser ceiling.
LimitNOFILE=4096
TasksMax=128

# Hardening directives. Other users' home directories and the system tree stay
# read-only, and the worker keeps no way to gain privileges. Its own home is
# writable because the apps it drives keep their login there (~/.claude,
# ~/.claude.json, ~/.codex), and refresh it on any call; a session's workspace
# defaults to ~/.local/share/memql. MemoryDenyWriteExecute and RestrictNamespaces
# are deliberately absent: the first kills Node.js, the second refuses the
# bubblewrap sandbox a session's shell commands run in. See
# cockpit/docs/local-apps.md. The GUI build (computer_use_embodied) drives the
# user's desktop on top of this.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
