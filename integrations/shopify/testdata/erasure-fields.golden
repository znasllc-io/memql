  contractGid                              gid         SubscriptionContract               kept by kind: a reference to another row; NOT A LINK: a line belongs to its order and is reached with it; the subscription it bills is not what makes it hers
  currentQuantity                          scalar      Int                                kept by kind: an integer
  customAttributes                         objectList  Attribute                          scrubbed: becomes []
  discountAllocations                      objectList  DiscountAllocation                 kept by the list: the amount each discount took off the line
      holds { allocatedAmountSet { shopMoney { amount currencyCode } presentmentMoney { amount currencyCode } } discountApplication { __typename allocationMethod index targetSelection targetType } }
  discountedTotalSet                       object      MoneyBag                           kept by the list: an amount of the sale
  discountedUnitPriceAfterAllDiscountsSet  object      MoneyBag                           kept by the list: an amount of the sale
  discountedUnitPriceSet                   object      MoneyBag                           kept by the list: an amount of the sale
  duties                                   objectList  Duty                               kept by the list: duties on the goods: customs codes, amounts and tax lines
      holds { countryCodeOfOrigin harmonizedSystemCode id price { shopMoney { amount currencyCode } presentmentMoney { amount currencyCode } } taxLines { channelLiable priceSet { shopMoney { amount currencyCode } presentmentMoney { amount currencyCode } } rate ratePercentage source title } }
  image                                    object      Image                              scrubbed: the key is removed
  isGiftCard                               scalar      Boolean                            kept by kind: a boolean
  lineItemGroup                            object      LineItemGroup                      scrubbed: the key is removed
  merchantEditable                         scalar      Boolean                            kept by kind: a boolean
  name                                     scalar      String                             kept by the list: the product's and the variant's titles; scrubbed on a custom item (a line with no productGid): becomes "[redacted]"
  nonFulfillableQuantity                   scalar      Int                                kept by kind: an integer
  originalTotalSet                         object      MoneyBag                           kept by the list: an amount of the sale
  originalUnitPriceSet                     object      MoneyBag                           kept by the list: an amount of the sale
  priceAfterAllDiscountsBeforeTaxesSet     object      MoneyBag                           kept by the list: an amount of the sale
  productGid                               gid         Product                            kept by kind: a reference to another row; a link that reaches nothing: no erasure reaches a product
  quantity                                 scalar      Int                                kept by kind: an integer
  refundableQuantity                       scalar      Int                                kept by kind: an integer
  requiresShipping                         scalar      Boolean                            kept by kind: a boolean
  restockable                              scalar      Boolean                            kept by kind: a boolean
  sellingPlan                              object      LineItemSellingPlan                scrubbed: the key is removed
  sku                                      scalar      String                             kept by the list: the variant's SKU; scrubbed on a custom item (a line with no productGid): becomes "[redacted]"
  staffMemberGid                           gid         StaffMember                        kept by kind: a reference to another row; a link that reaches nothing: no erasure reaches a staffMember
  taxLines                                 objectList  TaxLine                            kept by the list: tax lines: titles, rates and amounts
      holds { channelLiable priceSet { shopMoney { amount currencyCode } presentmentMoney { amount currencyCode } } rate ratePercentage source title }
  taxable                                  scalar      Boolean                            kept by kind: a boolean
  title                                    scalar      String                             kept by the list: the product's title; scrubbed on a custom item (a line with no productGid): becomes "[redacted]"
  totalDiscountSet                         object      MoneyBag                           kept by the list: an amount of the sale
  unfulfilledDiscountedTotalSet            object      MoneyBag                           kept by the list: an amount of the sale
  unfulfilledOriginalTotalSet              object      MoneyBag                           kept by the list: an amount of the sale
  unfulfilledQuantity                      scalar      Int                                kept by kind: an integer
  variantGid                               gid         ProductVariant                     kept by kind: a reference to another row; a link that reaches nothing: no erasure reaches a productVariant
  variantTitle                             scalar      String                             kept by the list: the variant's title; scrubbed on a custom item (a line with no productGid): becomes "[redacted]"
  vendor                                   scalar      String                             scrubbed: becomes "[redacted]"
  weight                                   object      Weight                             scrubbed: the key is removed

concept orderTransaction (OrderTransaction)
  reach: child of order; gid field orderGid naming order; gid field parentTransactionGid naming orderTransaction
  accountNumber                            scalar      String                             scrubbed: becomes "[redacted]"
  amountRoundingSet                        object      MoneyBag                           kept by the list: an amount of the sale
  amountSet                                object      MoneyBag                           kept by the list: an amount of the sale
