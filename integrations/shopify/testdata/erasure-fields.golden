      holds { nodes { amountSet { shopMoney { amount currencyCode } presentmentMoney { amount currencyCode } } taxAmountSet { shopMoney { amount currencyCode } presentmentMoney { amount currencyCode } } reason } }
  orderGid                                 gid         Order                              kept by kind: a reference to another row; a link: a row that names an in-scope order here is in scope
  processedAt                              scalar      DateTime                           kept by kind: a date-time
  refundLineItems                          inlineList  RefundLineItem                     kept by the list: the refunded lines: which line, how many, and their amounts
      holds { nodes { lineItem { id } quantity subtotalSet { shopMoney { amount currencyCode } presentmentMoney { amount currencyCode } } totalTaxSet { shopMoney { amount currencyCode } presentmentMoney { amount currencyCode } } } }
  refundShippingLines                      inlineList  RefundShippingLine                 kept by the list: the refunded shipping: its amounts and nothing else
