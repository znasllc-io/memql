# Nginx reverse proxy for the local memQL dev cluster.
#
# This file is a template processed by nginx:alpine's built-in
# envsubst on container start. Only ${DOMAIN} is substituted (see
# NGINX_ENVSUBST_FILTER on the nginx service in docker-compose);
# nginx's own $host / $scheme / $remote_addr stay literal.
#
# Hostnames (resolved via the developer's wildcard DNS record
# `*.${DOMAIN}` -> 127.0.0.1):
#
#   app.${DOMAIN}        -> CoPresent SPA (Vite dev server on the
#                            developer's host machine)
#   identity.${DOMAIN}   -> identity service HTTP surface
#   bff.${DOMAIN}        -> BFF gRPC + HTTP (/memql/ws bridge,
#                            attachments, polyphon, healthz);
#                            /memql/audio is proxied through to the
#                            voice node (STT lives there, not the bff)
#   agent.${DOMAIN}      -> Agent gRPC (WorkerService.Stream) + HTTP
#
# TLS:
#   /etc/nginx/certs/dev.{crt,key} -- generated locally with mkcert
#   (`make setup-tls`). The mkcert root CA is installed in the
#   developer's system trust store so browsers, Go clients, and the
#   cockpit-worker all verify the cert without warnings. The cert
#   is issued for `*.${DOMAIN}` so every subdomain Just Works.

# -----------------------------------------------------------------
# Resolver
# -----------------------------------------------------------------
# Docker's embedded DNS server lives at 127.0.0.11 inside any
# user-defined network. We point nginx at it explicitly with a
# 10-second TTL so name resolution for the cluster nodes (bff,
# agent, identity, etc.) gets re-checked frequently. WITHOUT this,
# nginx caches each upstream's IP at config-load time forever; when
# `docker compose up -d --build agent` recreates the agent
# container with a new IP, nginx keeps trying to reach the dead
# old IP and the worker gets a stream-level "Unimplemented" because
# whatever subnet neighbour it ends up reaching isn't the agent
# anymore. The 10s TTL bounds that staleness window without making
# DNS the hot path.
#
# `ipv6=off` because Docker's embedded resolver returns AAAA records
# for host.docker.internal that point at fdc4:f303:9324::254 -- a
# link-local-ish address that isn't routable from the LB container,
# producing connect(101: Network unreachable) errors visible in the
# nginx error log. Forcing IPv4 resolution is a long-standing
# workaround in the Docker community.
resolver 127.0.0.11 valid=10s ipv6=off;

# -----------------------------------------------------------------
# Upstreams (explicit blocks for backwards compatibility)
# -----------------------------------------------------------------
# The upstream blocks below resolve names ONCE at config-load and
# cache the result forever -- that's the staleness bug the resolver
# directive above is the first half of fixing. The location blocks
# below pair the resolver with VARIABLE-based upstream targets
# (`set $upstream agent:50051; grpc_pass grpc://$upstream;`) which
# routes resolution through the runtime resolver instead of the
# config-load cache. So these named upstream blocks are kept here
# only as documentation of which port each node listens on; the
# locations don't reference them.
upstream bff_grpc       { server bff:50051; }
upstream bff_http       { server bff:8088; }
upstream agent_grpc     { server agent:50051; }
upstream agent_http     { server agent:8089; }
upstream identity_http  { server identity:8081; }

# The CoPresent SPA runs as a Vite dev server in the `app` container
# (see docker-compose.full.yml). Documentation-only, like the blocks
# above -- the location below uses the runtime-resolver variable form
# so nginx starts even if `app` is still installing deps / booting.
upstream app_vite { server app:8080; }

# -----------------------------------------------------------------
# Plaintext :80 -> 301 to TLS :443
# -----------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name app.${DOMAIN}
                identity.${DOMAIN}
                bff.${DOMAIN}
                agent.${DOMAIN}
                cognition.${DOMAIN}
                planner.${DOMAIN}
                voice.${DOMAIN};
    return 301 https://$host$request_uri;
}

# -----------------------------------------------------------------
# CoPresent SPA -- proxies to Vite dev server on the host.
# Vite handles HMR over WebSocket; nginx upgrades the connection
# through. Vite also proxies /memql/*, /spaces/..., /polyphon/*
# internally (per copresent/vite.config.ts).
#
# Identity-service XHR paths (/auth/*, /oauth/*, /.well-known/*) are
# proxied here too -- same-origin from the SPA's perspective. Why:
# Safari refuses cross-origin XHR to identity.${DOMAIN} with a
# generic "TypeError: Load failed" / "Could not connect" even when
# the cross-origin host is mkcert-trusted and the CORS preflight
# succeeds. This appears to be Safari's HTTP/2 connection-coalescing
# behavior (the same wildcard-cert / same-IP pair can produce a
# coalesced connection that Safari refuses to demote when the second
# host needs an XHR with credentials). Routing /auth + /oauth
# through app.${DOMAIN} eliminates the cross-origin entirely so
# Safari has no quirk to bite on. Chrome / Firefox were unaffected
# in the wild but ride the same path now for consistency.
#
# Top-level magic-link redirects (initiateLogin -> identity/login)
# still go to identity.${DOMAIN} directly -- those are top-level
# navigations, not XHR, and Safari handles them fine.
# -----------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/dev.crt;
    ssl_certificate_key /etc/nginx/certs/dev.key;

    # Identity service XHR endpoints, served same-origin so the
    # SPA's fetch() calls don't trip Safari's cross-origin TLS
    # quirks. Order matters: these locations must precede the
    # catch-all `location /` block.
    #
    # EXACT-MATCH locations only -- do NOT use a regex like
    # ^/(auth|oauth)/ because /auth/callback is a SPA-side
    # React Router route (the magic-link redirect-back where the
    # SPA reads ?code= and trades it for an access token via
    # /oauth/token). Proxying /auth/callback to identity would
    # 404 the post-magic-link redirect and break sign-in entirely.
    # Each XHR path is enumerated explicitly below; new ones get
    # added one at a time.
    #
    # Identity sets the refresh-token cookie with Domain= implicit
    # (host-only). The browser sees app.${DOMAIN} as the response
    # origin, so the cookie binds to that host -- subsequent
    # /auth/refresh from the SPA carries it naturally. No
    # cookie-domain rewriting needed.
    location = /auth/refresh {
        set $identity_target identity:8081;
        proxy_pass http://$identity_target;
        proxy_set_header Host              identity.${DOMAIN};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 3600s;
    }
    location = /auth/logout {
        set $identity_target identity:8081;
        proxy_pass http://$identity_target;
        proxy_set_header Host              identity.${DOMAIN};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 3600s;
    }
    location = /oauth/token {
        set $identity_target identity:8081;
        proxy_pass http://$identity_target;
        proxy_set_header Host              identity.${DOMAIN};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 3600s;
    }
    location = /.well-known/jwks.json {
        set $identity_target identity:8081;
        proxy_pass http://$identity_target;
        proxy_set_header Host              identity.${DOMAIN};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 3600s;
    }

    location / {
        # Variable-based upstream so the resolver picks fresh DNS each
        # request (see the resolver block at the top) -- lets nginx
        # start before the `app` container is up and survive its
        # recreation. Mirrors the bff/agent/identity locations.
        set $app_target app:8080;
        proxy_pass http://$app_target;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # WebSocket upgrade -- Vite HMR + the /memql/* WS proxy
        # both ride this path.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# -----------------------------------------------------------------
# Identity service -- the OAuth + magic-link + admin web UI +
# JWKS + /pair/* endpoints all live here, all HTTP.
# -----------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name identity.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/dev.crt;
    ssl_certificate_key /etc/nginx/certs/dev.key;

    location / {
        # Variable-based upstream so the resolver picks fresh DNS
        # each request -- see the resolver block at the top.
        set $identity_target identity:8081;
        proxy_pass http://$identity_target;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout 3600s;
    }
}

# -----------------------------------------------------------------
# BFF -- two protocols on one host:
#   - gRPC paths (/znasllc.memql.*) -> grpc_pass
#   - everything else (HTTP, WS bridge) -> proxy_pass
# -----------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name bff.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/dev.crt;
    ssl_certificate_key /etc/nginx/certs/dev.key;

    # gRPC -- MemqlService.Stream, NodeService.Stream.
    location ~ ^/znasllc\.memql\. {
        # Variable-based upstream -- forces nginx to use the
        # runtime resolver instead of the config-load DNS cache,
        # so a `docker compose up -d --build bff` doesn't strand
        # nginx on the old container's IP. See the resolver block
        # at the top.
        set $bff_grpc_target bff:50051;
        grpc_pass grpc://$bff_grpc_target;
        grpc_set_header Host         $host;
        grpc_set_header X-Real-IP    $remote_addr;
        grpc_read_timeout 3600s;
        grpc_send_timeout 3600s;
    }

    # Audio WebSocket -- terminates on the VOICE node, not the bff.
    # The audio handler + STT provider live on voice (and agent) per
    # docs/core/build-tags.md; the bff has neither, so /memql/audio must
    # be proxied to voice (voice:8085). Browser still connects to
    # bff.${DOMAIN}; nginx forwards. Variable-based upstream uses the
    # runtime resolver (see the resolver block at the top) so a rebuilt
    # voice container isn't stranded on a stale IP.
    location /memql/audio {
        set $voice_http_target voice:8085;
        proxy_pass http://$voice_http_target;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # HTTP -- /memql/ws (browser WS bridge), /spaces/{id}/attachments,
    # /polyphon/*, /healthz. (/memql/audio is handled above -> voice.)
    location / {
        set $bff_http_target bff:8088;
        proxy_pass http://$bff_http_target;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# -----------------------------------------------------------------
# Agent -- workers attach via gRPC WorkerService.Stream here.
# MemqlService is also reachable for engine queries originating
# on the agent node.
# -----------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name agent.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/dev.crt;
    ssl_certificate_key /etc/nginx/certs/dev.key;

    location ~ ^/znasllc\.memql\. {
        # Variable-based upstream -- the load-bearing fix for the
        # worker.register stale-IP bug. Without this, every
        # `docker compose up -d --build agent` left nginx pointing
        # at the previous agent container's IP forever, and the
        # worker got stuck in a reconnect loop with
        # "Unimplemented: unknown service WorkerService". See the
        # resolver block at the top.
        set $agent_grpc_target agent:50051;
        grpc_pass grpc://$agent_grpc_target;
        grpc_set_header Host         $host;
        grpc_set_header X-Real-IP    $remote_addr;
        grpc_read_timeout 3600s;
        grpc_send_timeout 3600s;
    }

    location / {
        set $agent_http_target agent:8089;
        proxy_pass http://$agent_http_target;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
    }
}

# -----------------------------------------------------------------
# LiveKit -- WebSocket signal + REST validate endpoint for the
# Polyphon multi-agent voice rooms. The browser pulls a room token
# from the BFF (PolyphonRoomTokenMsg gRPC) and then opens a WebRTC
# session against the LiveKit server. Because the SPA is served on
# https://app.${DOMAIN}, the LiveKit signal URL has to be reachable
# at wss:// from the same origin set -- a plain ws://localhost:7880
# is blocked by the browser's mixed-content / CORS rules. Nginx
# terminates TLS here and proxies to the livekit container, which
# only listens on plain HTTP/WS internally (per its `--dev`
# default). Only present when docker-compose.polyphon.yml is part
# of the stack -- the `livekit` upstream resolves via Docker's DNS.
# -----------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name livekit.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/dev.crt;
    ssl_certificate_key /etc/nginx/certs/dev.key;

    location / {
        # Variable-based upstream so nginx survives a
        # `docker compose up -d --build livekit` without going stale
        # on the old container IP -- same trick the bff / agent
        # blocks use.
        set $livekit_target livekit:7880;
        proxy_pass http://$livekit_target;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade for the LiveKit signal channel.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
