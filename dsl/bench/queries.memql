// Reads over the proving suite's published record.
//
// ADMIN AND ABOVE, on BOTH halves (memql#5216). The concepts declare
// `@rowAuthz(clusterOwner, rankFloor="admin")` -- administrative to write,
// readable from admin down -- and every read here carries the surface floor to
// match. Epic memql#4832's D6 says the two are both permanent and neither
// stands in for the other: `@requiresRank` gates WHO MAY CALL, the tier decides
// WHICH ROWS COME BACK.
//
// THEY USED TO DISAGREE, and that is what this file is a fix for. The filters
// read `actor.isClusterOwner==true` while MemQL OS's Benchmarks section admits
// `{ min: "admin" }`, so a non-owner admin was let into the screen and served
// nothing -- rendered, on a surface built to make absence legible, as every
// figure being UNMEASURED. This header used to assert the opposite, that the OS
// floor was gated at admin "for exactly that reason": the claim was that the
// two agreed, and they did not.

/// Every benchmark run, newest first. The trend across releases is read from this.
@requiresRank("admin")
query run benchRuns {
  sort    "row.createdAt", "desc"
  shape   benchRunFull
}

/// One benchmark run by id.
@requiresRank("admin")
query run benchRunById {
  args {
    benchRunId  string!
  }
  filter  row => row.id == args.benchRunId
  shape   benchRunFull
}

/// Every published figure for one benchmark run.
@requiresRank("admin")
query sample benchSamplesForRun {
  args {
    benchRunId  string!
  }
  filter  row => row.benchRunId == args.benchRunId
  sort    "metric", "asc"
  shape   benchSampleFull
}

/// One metric's figures across runs, which is how a trend is drawn.
@requiresRank("admin")
query sample benchSamplesForMetric {
  args {
    metric  string!
    arm     string
  }
  filter  row => row.metric == args.metric && (args.arm == nil || row.arm == args.arm)
  sort    "row.createdAt", "desc"
  shape   benchSampleFull
}
