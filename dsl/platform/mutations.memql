// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use platform.concepts.{ globalSecret, globalVariable, missingCapability, outboundRequest, partitionSecret, partitionVariable }

// ---- mutations/v1/platform/insertPolicyTrace.memql ----

// insertPolicyTrace
// =================
//
// Engine-internal mutation. Called from component/memql/policy_evaluator.go
// when a policy evaluation needs to land on the v1:platform:policyTrace
// timeline -- either because the policy carries @traces_persisted, or
// because the caller passed PersistTrace=true on the EvaluatePolicy
// options.
//
// args:
//   policyName       string  required
//   tier             string  required
//   actorUserId      string  optional
//   actorRole        string  optional
//   callerPartition  string  optional
//   argsHash         string  required
//   resultJson       string  required
//   traceJson        string  required
//   durationMs       float   required
//   error            string  optional
//
// Retention is enforced by purgeExpiredPolicyTraces (daily cron).

@enabled
@description("Persist a single policy evaluation trace to v1:platform:policyTrace.")
mutate policyTrace insertPolicyTrace {
  args {
    policyName       string  @required
    tier             string  @required
    actorUserId      string
    actorRole        string
    callerPartition  string
    argsHash         string  @required
    resultJson       string  @required
    traceJson        string  @required
    durationMs       number  @required
    error            string
  }
  insert {
    args.policyName
    args.tier
    actorUserId: coalesce(args.actorUserId, "")
    actorRole: coalesce(args.actorRole, "")
    callerPartition: coalesce(args.callerPartition, "")
    args.argsHash
    args.resultJson
    args.traceJson
    args.durationMs
    error: coalesce(args.error, "")
  }
}

// ---- concepts/v1/platform/partitionSecret/seed.memql ----

@actor("system")

// No default secret seeds. Partition-scoped secrets (BYOK vendor keys,
// per-tenant integration creds) are written by the router integration or
// by operators via `make secret-set NAME=... VALUE=... SCOPE=partition
// PARTITION=<name>`.

// ---- mutations/v1/platform/setGlobalSecret.memql ----

// setGlobalSecret
// ===============
//
// Upserts an instance-wide (global) encrypted secret row in
// v1:platform:globalSecret. Companion to setPartitionSecret
// (partition-scoped). Used by `make secrets-seed`,
// `make prod-seed-secrets`, and `make secret-set SCOPE=global` to
// populate instance defaults.
//
// The encryptedValue + fingerprint are produced by
// component/secret.Encrypt before this mutation is called.

@enabled
@description("Persist an instance-wide (global) encrypted secret row in v1:platform:globalSecret. The encryptedValue and fingerprint are produced by the backend secret helper; this mutation only stores them.")
mutate globalSecret setGlobalSecret {
  args {
    id              string  @required
    name            string  @required
    encryptedValue  string  @required
    fingerprint     string  @required
    kind            string
    description     string
    addedBy         string
    active          bool
  }
  insert {
    args.id
    args.name
    args.encryptedValue
    args.fingerprint
    args.kind
    args.description
    args.addedBy
    active: coalesce(args.active, true)
  }
}

// ---- mutations/v1/platform/setGlobalVariable.memql ----

// setGlobalVariable
// =================
//
// Upserts an instance-wide (global) plaintext variable in
// v1:platform:globalVariable. Used by seed files and
// `make variable-set SCOPE=global` to populate instance defaults.

@enabled
@description("Persist an instance-wide (global) plaintext variable row in v1:platform:globalVariable.")
mutate globalVariable setGlobalVariable {
  args {
    id           string  @required
    name         string  @required
    value        string  @required
    description  string
    active       bool
  }
  insert {
    args.id
    args.name
    args.value
    args.description
    active: coalesce(args.active, true)
  }
}

// ---- mutations/v1/platform/setPartitionSecret.memql ----

// setPartitionSecret
// ==================
//
// Upserts a partition-scoped encrypted secret row in
// v1:platform:partitionSecret. Callers pre-compute the ciphertext +
// fingerprint via component/secret.Encrypt; this mutation only persists
// the opaque fields. The router integration uses this for vendor_api_key
// rows; future callers will use it for per-tenant integration creds.
//
// Deterministic id means re-submitting rotates the value; the prior
// ciphertext remains in the time-series history under the same id.

@enabled
@description("Persist a partition-scoped encrypted secret row in v1:platform:partitionSecret. The encryptedValue and fingerprint are produced by the backend secret helper; this mutation only stores them.")
mutate partitionSecret setPartitionSecret {
  args {
    id              string  @required
    name            string  @required
    encryptedValue  string  @required
    fingerprint     string  @required
    kind            string
    description     string
    addedBy         string
    active          bool
  }
  insert {
    args.id
    args.name
    args.encryptedValue
    args.fingerprint
    args.kind
    args.description
    args.addedBy
    active: coalesce(args.active, true)
  }
}

// ---- mutations/v1/platform/setPartitionVariable.memql ----

// setPartitionVariable
// ====================
//
// Upserts a partition-scoped plaintext configuration variable in
// v1:platform:partitionVariable. Companion to setPartitionSecret
// for non-sensitive values. Used by `make variable-set SCOPE=partition`
// and by automations that write per-tenant config.

@enabled
@description("Persist a partition-scoped plaintext variable row in v1:platform:partitionVariable.")
mutate partitionVariable setPartitionVariable {
  args {
    id           string  @required
    name         string  @required
    value        string  @required
    description  string
    active       bool
  }
  insert {
    args.id
    args.name
    args.value
    args.description
    active: coalesce(args.active, true)
  }
}

@enabled
@description("Per Q7 missing-capability surface: log a new gap the Planner Agent identified during a Plan. First sighting creates the row; repeat sightings (same (kind, capability)) call bumpMissingCapabilitySighting instead so the row stays unique-by-capability and sightingCount climbs. Status defaults to 'open'.")
mutate missingCapability logMissingCapability {
  args {
    missingId       string  @required
    kind            string  @required
    capability      string  @required
    description     string  @required
    requestedFromPlanId  string
    requestedByAgentId   string
    partitionId         string
    partitionScope  string
    firstSeenAt     string  @required
    exampleGoal     string
  }
  insert {
    id: args.missingId
    args.kind
    args.capability
    args.description
    args.requestedFromPlanId
    args.requestedByAgentId
    args.partitionId
    args.partitionScope
    args.firstSeenAt
    lastSeenAt: args.firstSeenAt
    sightingCount: 1
    status: "open"
    exampleGoals: [coalesce(args.exampleGoal, "")]
  }
}

@enabled
@description("Per Q7 missing-capability surface: a repeat sighting of an already-logged gap. Increments sightingCount and refreshes lastSeenAt. The Planner Agent calls this when it encounters a known gap; aggregated counts feed the platform-roadmap prioritization view.")
mutate missingCapability bumpMissingCapabilitySighting {
  args {
    missingId       string  @required
    sightingCount   int     @required
    lastSeenAt      string  @required
  }
  update {
    id: args.missingId
    args.sightingCount
    args.lastSeenAt
  }
}

@enabled
@description("Operator-driven status transition on a missingCapability row. Used by the platform team's backlog tooling to mark a gap as in_progress, resolved (with a note on what shipped), or wontfix.")
mutate missingCapability updateMissingCapabilityStatus {
  args {
    missingId   string  @required
    status      string  @required
    resolution  string
  }
  update {
    id: args.missingId
    args.status
    args.resolution
  }
}

// ---- mutations/v1/platform/stageOutboundRequest.memql ----

// stageOutboundRequest
// ====================
//
// The zero-Go staging surface for outbound delivery (memql#2521): a
// product automation/logic body calls this to durably request that
// something leave the cluster. The engine-owned outbound worker drains
// the row and stamps status transitions back. Callers derive requestId
// deterministically (hash(concat(...))) when they want staging-time
// idempotency.

@enabled
@description("Stage an outbound delivery (memql#2521): insert a v1:platform:outboundRequest row with status='pending' for the engine outbound worker to drain. Credentials are never part of the row; targets must satisfy the deployment's per-medium allowlist or the worker fails the row fast.")
mutate outboundRequest stageOutboundRequest {
  args {
    requestId    string  @required
    medium       string  @required
    target       string  @required
    subject      string
    body         string  @required
    dedupeKey    string
    requestedBy  string
  }
  insert {
    id: args.requestId
    args.medium
    args.target
    args.subject
    args.body
    args.dedupeKey
    args.requestedBy
    status: "pending"
    attempts: 0
  }
}

// ---- mutations/v1/platform/updateOutboundRequestStatus.memql ----

// updateOutboundRequestStatus
// ===========================
//
// Worker-side status stamping for outbound delivery (memql#2521). The
// outbound worker is the intended caller; the mutation is not scoped to
// it (an operator can requeue a failed row by setting status='pending')
// but products should treat delivery state as read-only.

@enabled
@description("Stamp a delivery-state transition on a v1:platform:outboundRequest row (memql#2521). Called by the engine outbound worker (sending/sent/retrying/failed + attempt metadata); operators may set status='pending' to requeue a failed row.")
mutate outboundRequest updateOutboundRequestStatus {
  args {
    requestId      string  @required
    status         string  @required
    attempts       int
    lastError      string
    nextAttemptAt  string
    sentAt         string
  }
  update {
    id: args.requestId
    args.status
    args.attempts
    args.lastError
    args.nextAttemptAt
    args.sentAt
  }
}
