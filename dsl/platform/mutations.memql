// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// ---- mutations/v1/platform/setGlobalSecret.memql ----

// setGlobalSecret
// ===============
//
// Upserts an instance-wide (global) encrypted secret row in
// v1:platform:globalSecret. Companion to setPartitionSecret
// (partition-scoped). Used by `make secrets-seed`,
// `make prod-seed-secrets`, and `make secret-set SCOPE=global` to
// populate instance defaults.
//
// The encryptedValue + fingerprint are produced by
// component/secret.Encrypt before this mutation is called.

/// Persist an instance-wide (global) encrypted secret row in v1:platform:globalSecret. The
/// encryptedValue and fingerprint are produced by the backend secret helper; this mutation only
/// stores them.
mutation globalSecret setGlobalSecret {
  args {
    id              string!
    name            string!
    encryptedValue  string!
    fingerprint     string!
    kind            string
    description     string
    addedBy         string
    active          bool
  }
  insert {
    accept { id, name, encryptedValue, fingerprint, kind, description, addedBy }
    stamp {
      active: args.active ?? true
    }
  }
}

// ---- mutations/v1/platform/setGlobalVariable.memql ----

// setGlobalVariable
// =================
//
// Upserts an instance-wide (global) plaintext variable in
// v1:platform:globalVariable. Used by seed files and
// `make variable-set SCOPE=global` to populate instance defaults.

/// Persist an instance-wide (global) plaintext variable row in v1:platform:globalVariable.
mutation globalVariable setGlobalVariable {
  args {
    id           string!
    name         string!
    value        string!
    description  string
    active       bool
  }
  insert {
    accept { id, name, value, description }
    stamp {
      active: args.active ?? true
    }
  }
}

// ---- mutations/v1/platform/setPartitionSecret.memql ----

// setPartitionSecret
// ==================
//
// Upserts a partition-scoped encrypted secret row in
// v1:platform:partitionSecret. Callers pre-compute the ciphertext +
// fingerprint via component/secret.Encrypt; this mutation only persists
// the opaque fields. The router integration uses this for vendor_api_key
// rows; future callers will use it for per-tenant integration creds.
//
// Deterministic id means re-submitting rotates the value; the prior
// ciphertext remains in the time-series history under the same id.

/// Persist a partition-scoped encrypted secret row in v1:platform:partitionSecret. The
/// encryptedValue and fingerprint are produced by the backend secret helper; this mutation only
/// stores them.
mutation partitionSecret setPartitionSecret {
  args {
    id              string!
    name            string!
    encryptedValue  string!
    fingerprint     string!
    kind            string
    description     string
    addedBy         string
    active          bool
  }
  insert {
    accept { id, name, encryptedValue, fingerprint, kind, description, addedBy }
    stamp {
      active: args.active ?? true
    }
  }
}

// ---- mutations/v1/platform/setPartitionVariable.memql ----

// setPartitionVariable
// ====================
//
// Upserts a partition-scoped plaintext configuration variable in
// v1:platform:partitionVariable. Companion to setPartitionSecret
// for non-sensitive values. Used by `make variable-set SCOPE=partition`
// and by automations that write per-tenant config.

/// Persist a partition-scoped plaintext variable row in v1:platform:partitionVariable.
mutation partitionVariable setPartitionVariable {
  args {
    id           string!
    name         string!
    value        string!
    description  string
    active       bool
  }
  insert {
    accept { id, name, value, description }
    stamp {
      active: args.active ?? true
    }
  }
}

/// Per Q7 missing-capability surface: log a new gap the Planner Agent identified during a Plan.
/// First sighting creates the row; repeat sightings (same (kind, capability)) call
/// bumpMissingCapabilitySighting instead so the row stays unique-by-capability and sightingCount
/// climbs. Status defaults to 'open'.
mutation missingCapability logMissingCapability {
  args {
    missingId       string!
    kind            string!
    capability      string!
    description     string!
    requestedFromRunId  string
    requestedByAgentId   string
    partitionId         string
    partitionScope  string
    firstSeenAt     string!
    exampleGoal     string
  }
  insert {
    id: args.missingId
    args.kind
    args.capability
    args.description
    args.requestedFromRunId
    args.requestedByAgentId
    args.partitionId
    args.partitionScope
    args.firstSeenAt
    lastSeenAt: args.firstSeenAt
    sightingCount: 1
    status: "open"
    exampleGoals: [args.exampleGoal ?? ""]
  }
}

/// Per Q7 missing-capability surface: a repeat sighting of an already-logged gap. Increments
/// sightingCount and refreshes lastSeenAt. The Planner Agent calls this when it encounters a known
/// gap; aggregated counts feed the platform-roadmap prioritization view.
mutation missingCapability bumpMissingCapabilitySighting {
  args {
    missingId       string!
    sightingCount   int!
    lastSeenAt      string!
  }
  update {
    accept { sightingCount, lastSeenAt }
    stamp {
      id: args.missingId
    }
  }
}

/// Operator-driven status transition on a missingCapability row. Used by the platform team's
/// backlog tooling to mark a gap as in_progress, resolved (with a note on what shipped), or
/// wontfix.
mutation missingCapability updateMissingCapabilityStatus {
  args {
    missingId   string!
    status      string!
    resolution  string
  }
  update {
    accept { status, resolution }
    stamp {
      id: args.missingId
    }
  }
}

// ---- mutations/v1/platform/stageOutboundRequest.memql ----

// stageOutboundRequest
// ====================
//
// The zero-Go staging surface for outbound delivery (memql#2521): a
// product automation/logic body calls this to durably request that
// something leave the cluster. The engine-owned outbound worker drains
// the row and stamps status transitions back. Callers derive requestId
// deterministically (a hash() over a `+`-joined key) when they want
// staging-time idempotency.
//
// @createOnly("status", "attempts") makes that idempotency correct
// (fylo#63): status + attempts are the delivery-lifecycle fields the
// outbound worker OWNS after creation (via updateOutboundRequestStatus).
// This mutation seeds them at birth, but a re-stage onto an existing
// requestId (e.g. a product automation that re-fires while its trigger
// row is still at the same stage) must NOT reset a row the worker has
// already moved to sending/sent/failed/retrying -- that would rewind
// delivery state and redeliver. @createOnly drops status/attempts from
// the delta on the read-merge path, so a re-stage preserves them while
// still refreshing the deliverable content (target/subject/body/dedupeKey).
// The other worker-owned fields (lastError/nextAttemptAt/sentAt) are not
// written here at all, so the read-merge already preserves them.

/// Stage an outbound delivery (memql#2521): insert a v1:platform:outboundRequest row with
/// status='pending' for the engine outbound worker to drain. Credentials are never part of the row;
/// targets must satisfy the deployment's per-medium allowlist or the worker fails the row fast.
/// Idempotent by requestId: a re-stage onto an existing row preserves the worker-owned
/// status/attempts (@createOnly, fylo#63) rather than resetting delivery state.
@createOnly("status", "attempts")
mutation outboundRequest stageOutboundRequest {
  args {
    requestId    string!
    medium       string!
    target       string!
    subject      string
    body         string!
    dedupeKey    string
    requestedBy  string
  }
  insert {
    accept { medium, target, subject, body, dedupeKey, requestedBy }
    stamp {
      id: args.requestId
      status: "pending"
      attempts: 0
    }
  }
}

// ---- mutations/v1/platform/updateOutboundRequestStatus.memql ----

// updateOutboundRequestStatus
// ===========================
//
// Worker-side status stamping for outbound delivery (memql#2521). The
// outbound worker is the intended caller; the mutation is not scoped to
// it (an operator can requeue a failed row by setting status='pending')
// but products should treat delivery state as read-only.

/// Stamp a delivery-state transition on a v1:platform:outboundRequest row (memql#2521). Called by
/// the engine outbound worker (sending/sent/retrying/failed + attempt metadata); operators may set
/// status='pending' to requeue a failed row.
mutation outboundRequest updateOutboundRequestStatus {
  args {
    requestId      string!
    status         string!
    attempts       int
    lastError      string
    nextAttemptAt  string
    sentAt         string
  }
  update {
    accept { status, attempts, lastError, nextAttemptAt, sentAt }
    stamp {
      id: args.requestId
    }
  }
}

// ---- mutations/v1/platform/stageInboundRequest.memql ----

// stageInboundRequest
// ===================
//
// Receiver-side staging for inbound delivery (memql#2957). The engine's
// inbound receiver is the intended caller, after the source allowlist
// and the signature check have both passed -- a request that fails
// either is refused at the edge and never reaches this mutation, so a
// row existing IS the record that it was accepted.
//
// Idempotent by requestId, which the receiver derives from (source,
// digest of the SIGNED payload): a redelivery of the same event
// re-stages onto the same row and @createOnly preserves the
// product-owned status / processedAt / lastError rather than resetting
// handling state back to 'received'. Same shape as
// stageOutboundRequest's protection of the worker-owned fields.
//
// NOT the sender's dedupe header. That header is not covered by the
// vendor's HMAC, so deriving identity from it let one captured
// delivery mint unbounded rows (memql#2957 landing review). It is
// still recorded on the row; it just does not decide the id.
//
// @createOnly stops the STATUS being reset. It does not stop the
// second node.created firing -- this is at-least-once delivery with a
// stable idempotency key, not exactly-once processing, and a product
// automation has to branch on status before doing work.

/// Stage a verified inbound delivery (memql#2957): insert a v1:platform:inboundRequest row with
/// status='received' for a product automation to drain. Called by the engine inbound receiver once
/// the source allowlist and signature check have passed; the signing secret is never part of the
/// row. Idempotent by requestId: a redelivery preserves the product-owned handling state
/// (@createOnly) instead of replaying it.
@createOnly("status", "processedAt", "lastError")
mutation inboundRequest stageInboundRequest {
  args {
    requestId          string!
    source             string!
    medium             string!
    body               string!
    contentType        string
    dedupeKey          string
    signatureVerified  bool
    receivedAt         string
  }
  insert {
    accept { source, medium, body, contentType, dedupeKey, signatureVerified, receivedAt }
    stamp {
      id: args.requestId
      status: "received"
    }
  }
}

// ---- mutations/v1/platform/updateInboundRequestStatus.memql ----

// updateInboundRequestStatus
// ==========================
//
// Product-side handling stamps for inbound delivery (memql#2957). The
// mirror of updateOutboundRequestStatus, with the ownership inverted:
// there the engine stamps and products read, here the PRODUCT stamps as
// it works the row and the engine only ever writes the initial
// 'received'.

/// Stamp a handling transition on a v1:platform:inboundRequest row (memql#2957). Called by the
/// product automation draining the row (processing/processed/failed); the engine receiver only ever
/// writes the initial 'received'.
mutation inboundRequest updateInboundRequestStatus {
  args {
    requestId    string!
    status       string!
    lastError    string
    processedAt  string
  }
  update {
    accept { status, lastError, processedAt }
    stamp {
      id: args.requestId
    }
  }
}

/// Create a site. Defaults are applied with ?? because a concept-field @default is never applied
/// on insert (memql#2960) -- writing the field without ?? leaves it empty and the edge refuses to
/// serve a row whose status it cannot read.
///
/// status and systemOwned are caller-settable (default "draft" / false, the ordinary operator-created
/// site) so the SeedMaterializer can pass "live" / true for the portal seed (dsl/platform/seeds.memql,
/// memql#3711) -- the platform's own console has to resolve the moment the cluster boots, and it must
/// not be deletable by an operator who does not realize it is how sites get managed at all.
///
/// `createdAt` / `createdBy` are NEVER authored here -- both are reserved payload fields
/// (component/database/memory-nodes/constants.go) the engine stamps intrinsically from `now` /
/// the caller's actor (component/database/memory-nodes/concept.go). An earlier version of this
/// mutation stamped them explicitly in `stamp{}`, which every write refused at the reserved-field
/// guard in executor_mutation.go with "mutation payload ... declares reserved field" -- silently,
/// because nothing exercised this mutation against a live boot until memql#3714's edge verification
/// found the portal's own seed failing with exactly that error on every fresh cluster (memql#3714b).
///
/// OWNERSHIP (memql#4344). `ownerUserId` is STAMPED from actor.userId and is deliberately NOT an
/// arg. A concept declaring an owner tier over a caller-supplied field records a guarantee nothing
/// provides -- and reads as safe, so an auditor seeing the tier stops looking; that is what
/// TestDeclaredOwnerFieldsAreServerStamped refuses, and an exemption here would be false, because
/// the field genuinely is not forgeable.
///
/// Synthetic deployment actors leave system sites unowned. Real people keep
/// ownerUserId, including cluster owners and callers forwarded through the
/// package pipeline. Internal origin admits server-only operations; it never
/// erases the authenticated person's attribution.
///
/// HOSTNAME. The args field carries the SHAPE half (@maxLength + a lowercase-DNS @pattern), which is
/// all a mutation body can express. The half that decides -- <slug>.<domain> against the domain THIS
/// cluster serves, the [a-z0-9-]{3,40} slug, the reserved labels, cluster-wide uniqueness, and the
/// cluster-owner exemption for a custom hostname -- is the same Go guard, for the same reason the
/// systemOwned-delete refusal is: none of it is expressible here, and a UI-only check is not a check.
@actor
mutation site createSite {
  args {
    siteId       string!
    accountId    string
    hostname     string!  @maxLength(253) @pattern("^[a-z0-9][a-z0-9.-]*[a-z0-9]$")
    kind         enum("spa", "static", "shopify_storefront")
    /// What the edge answers for a path that matches no file. Omitted means the kind decides,
    /// which is what every site row created before memql#5535 carries and what they must keep
    /// resolving as. It sits in accept{} rather than stamp{} for updateSiteBundle's artifactId
    /// reason: an omitted arg is dropped from the payload, so a `?? ""` here would write an
    /// explicit empty string and there would be no way to express "let the kind decide".
    resolutionTail enum("fallback", "not_found")
    bundleRef    string!
    status       enum("draft", "live", "disabled")
    apiProxy     boolean
    systemOwned  boolean
    title        string
    artifactId   string
    binding      object
  }
  insert {
    accept { hostname, bundleRef, artifactId, binding, resolutionTail, accountId }
    stamp {
      id:          args.siteId
      ownerUserId: actor.userId
      kind:        args.kind ?? "spa"
      status:      args.status ?? "draft"
      apiProxy:    args.apiProxy ?? false
      systemOwned: args.systemOwned ?? false
      title:       args.title ?? args.hostname
    }
  }
}

/// Point a site at a different bundle version. THE deploy operation, and THE rollback operation --
/// they are the same write in opposite directions, which is the whole reason bundles are stored
/// under versioned prefixes rather than overwritten.
///
/// `artifactId` is optional provenance: sitePublishFromArtifact passes the v1:library:artifact the
/// bundle came out of, and CI publishing through POST /sites/{id}/bundles passes nothing. It sits in
/// accept{} rather than stamp{} precisely so an omitted arg is OMITTED FROM THE PAYLOAD (missing args
/// are dropped, mutation_templates.go) and the read-merge inherits the stored value -- `args.artifactId ??
/// ""` would put an explicit empty string in the delta and blank the provenance on every rollback.
///
/// AUTHORIZATION resolves the prior site and checks current rights in its organization. Shared
/// edits preserve the original owner and record the current writer on the new version. Package
/// publication also checks the target site's deploy/publish permission before external effects;
/// a grant on its source package's organization does not grant rights in another organization.
mutation site updateSiteBundle {
  args {
    siteId     string!
    bundleRef  string!
    artifactId string
  }
  update {
    accept { bundleRef, artifactId }
    stamp {
      id: args.siteId
    }
  }
}

/// Move a site between draft / live / disabled.
///
/// Owner-or-cluster-owner, enforced by guardRowAuthzWrite against v1:platform:site's composite tier
/// rather than by anything here -- see updateSiteBundle's note for why the split is where it is.
@requiresCapability("execute", "app:deployables/publish")
mutation site updateSiteStatus {
  args {
    siteId  string!
    status  enum("draft", "live", "disabled")!
  }
  update {
    id:     args.siteId
    status: args.status
  }
}

/// Point a deployable at the client it is FOR -- or at nobody (epic memql#4800, D5).
///
/// A NARROW, SINGLE-PURPOSE WRITE, like updateSiteBundle and updateSiteStatus beside it. The site
/// detail's account picker is its only caller, and giving the tie its own mutation is what keeps
/// the picker from being able to touch a hostname, a bundle or a status by accident.
///
/// `accountId` IS STAMPED, NOT ACCEPTED, and the difference is the whole feature. An accepted arg
/// is dropped from the payload when omitted (missing args are dropped, mutation_templates.go) and
/// the read-merge then inherits the stored value -- which would make CLEARING a tie inexpressible:
/// every "no client" would silently re-save the client already there. `args.accountId ?? ""` always
/// writes a value, so an omitted arg means "no client" and says so on the row.
///
/// NOT VALIDATED against the registry, deliberately. An account is a record with no read effect
/// (D1), so an id naming no row costs nothing: the picker resolves what it can and renders the rest
/// as "not visible to you", which is a truer answer than a refusal would be -- an operator CAN
/// legitimately tie a site to an account whose row another person owns.
///
/// AUTHORIZATION is the concept's composite tier plus guardRowAuthzWrite, which resolves the target
/// row and admits its owner with the cluster-owner path as the separate escape. Nothing about the
/// account is consulted: tying a site to a client changes who the work is FOR and never who may
/// read or write it.
mutation site updateSiteAccount {
  args {
    siteId     string!
    accountId  string
  }
  update {
    id: args.siteId
    accountId: args.accountId ?? ""
  }
}

/// Replace a deployable's runtime settings (epic memql#4906, decision P7): the key-values the edge
/// merges into the site's runtime-config document under `settings`, read by the bundle at load.
///
/// A REPLACE, NOT A MERGE, and the whole object is the argument. `settings` is stamped from the
/// required arg rather than accepted, so an empty object is written as an empty object and clearing
/// every setting is expressible -- an accepted optional arg would be dropped from the payload when
/// omitted and the read-merge would re-save whatever was there (updateSiteAccount's reasoning). The
/// editor sends the map it shows, so what a person sees is what the row holds.
///
/// The shape half is here: an object. The half that decides -- every key of the identifier form
/// [A-Za-z][A-Za-z0-9_]{0,63} and not ending in `Ref`, every value a plain string within
/// MEMQL_SITE_SETTINGS_MAX_VALUE_LENGTH, at most MEMQL_SITE_SETTINGS_MAX_KEYS keys, and the
/// systemOwned refusal -- is the Go guard beside the status guard
/// (component/memql/platform_site_settings_guard.go), because a mutation body cannot see an object's
/// keys. NOT A PLACE FOR A SECRET: the document is served to every visitor.
///
/// AUTHORIZATION is the concept's composite tier plus guardRowAuthzWrite, as on updateSiteBundle:
/// the row's owner, or a cluster owner through the explicit escape. A systemOwned row is refused for
/// both, because the seed re-writes it at every boot.
mutation site updateSiteSettings {
  args {
    siteId    string!
    settings  object!
  }
  update {
    id:       args.siteId
    settings: args.settings
  }
}

/// Turn this deployable's SHOPPER SURFACE on or off (epic memql#5532, issue memql#5551).
///
/// WHAT IT SWITCHES: POST /_memql/forms/{pack}/{name} and GET /_memql/reads/{pack}/{name} on this
/// site's own origin, for every form and read a LOADED pack declares. Off, both answer 404 -- not
/// 403, because a site that has not turned this on must look like it has no such path rather than
/// like it has one it is guarding.
///
/// WHAT IT DOES NOT SWITCH, and this is the part worth being plain about: it does not decide WHAT
/// is reachable. That is the pack's declaration (component/memql/shopper_surface.go), it is in Go,
/// it is init-time, and nothing undeclared is reachable at any setting of this field. Turning this
/// on publishes exactly the forms and reads the packs this cluster has ENABLED have declared, and
/// nothing else.
///
/// `shopperForms boolean!` rather than an optional with `?? false`: this is a deliberate act in
/// both directions and "off" must be expressible as a write rather than only as an omission --
/// updateSiteSettings' clearing problem, in boolean.
///
/// AUTHORIZATION is the concept's composite tier plus guardRowAuthzWrite, exactly as on
/// updateSiteBundle and updateSiteSettings: the row's owner, or a cluster owner through the
/// explicit escape, and a systemOwned row refused for both. A cluster-owned site cannot usefully
/// turn it on either way -- the shopper write borrows the row's ownerUserId and an empty one has
/// no authority to borrow -- but the refusal for that lives at the edge, where the answer can be a
/// page rather than a write error nobody sees.
mutation site updateSiteShopperForms {
  args {
    siteId        string!
    shopperForms  boolean!
  }
  update {
    id:           args.siteId
    shopperForms: args.shopperForms
  }
}

/// Choose what the edge answers for a path that matches no file in this deployable's bundle
/// (memql#5535) -- the LAST rung of the resolution order, and nothing above it.
///
/// THREE VALUES, AND THE THIRD IS THE EMPTY ONE. "fallback" serves index.html, "not_found"
/// answers 404, and "" HANDS THE DECISION BACK TO `kind` -- which is the state every row created
/// before this field existed is in, and the one a person must be able to return a site to. That is
/// why the arg is optional and stamped with `?? ""` rather than accepted: an accepted arg omitted
/// by the caller is dropped from the payload and the read-merge re-saves whatever was there, so
/// clearing the choice would be inexpressible. It is the exact inverse of createSite's reading of
/// the same field, for the same reason updateSiteSettings and updateSiteBundle differ.
///
/// WHY A SITE AND NOT A KIND. A shopify_storefront was given the spa fallback because the kind's
/// own description says it IS a spa bundle; the first storefront actually built was a multi-page
/// prerendered tree that declared kind: static precisely to get the 404 back, and thereby gave up
/// the store binding, the storefront block in its runtime document and the policy that admits
/// Shopify. Neither tail is right for every storefront, so the SITE says which it is.
///
/// AUTHORIZATION is the concept's composite tier plus guardRowAuthzWrite, exactly as on
/// updateSiteBundle and updateSiteSettings: the row's owner, or a cluster owner through the
/// explicit escape, and a systemOwned row refused for both.
mutation site updateSiteResolutionTail {
  args {
    siteId          string!
    resolutionTail  enum("fallback", "not_found")
  }
  update {
    id:             args.siteId
    resolutionTail: args.resolutionTail ?? ""
  }
}

/// Point a storefront deployable at the v1:shopify:store row it fronts, or clear the binding
/// (epic memql#5530, issue memql#5538).
///
/// ONE VALUE, AND IT IS A REFERENCE. The binding is written whole as {storeId} rather than merged,
/// so the legacy {storeDomain, storefrontTokenRef} shape cannot survive a write: a read-merge would
/// have kept the copy beside the reference and left two records of one store, which is the thing
/// this epic exists to end. An empty storeId writes an empty object, which is the unbound state --
/// clearing must be expressible, for updateSiteSettings' reason.
///
/// AUTHORIZATION IS TWO GATES, AND THE SECOND IS THE SUBSTANTIVE ONE.
/// @requiresCapability names the surface: `app:deployables/store` is seeded on owner and developer
/// (Connect Shopify, D3). Beside it, a Go guard refuses a binding naming a store row the CALLER
/// CANNOT READ -- so the answer to "who may bind a storefront to a store they may not read" is
/// nobody. That check needs a cross-row read no mutation body can make, which is why it sits with
/// the hostname policy rather than here (component/memql/platform_site_binding_guard.go).
///
/// A developer reads every store, so a developer may bind ANY storefront they can write to ANY
/// store on the cluster, and D3 accepts it. That is not only their own: the site tier's account
/// grant admits staff (developer and above) to write every account-tied site, so it is every client
/// storefront, live ones included -- the same reach that lets a developer pause, archive or delete
/// those sites. Every store row is registered by a cluster owner or server code (D15), so the
/// Storefront token a binding exposes is always one an owner or Connect chose.
@requiresCapability("execute", "app:deployables/store")
mutation site updateSiteStoreBinding {
  args {
    siteId   string!
    storeId  string
  }
  update {
    id:      args.siteId
    binding: { storeId: args.storeId ?? "" }
  }
}

// ---- The candidate version and the preview binding (epic memql#5531) ----
//
// `bundleRef` names what SERVES; `candidateRef` names a published version that
// is being exercised beside it. `binding` names the store shoppers reach;
// `previewBinding` names the development store the candidate is exercised
// against. Four mutations over that pair, and between them they are the whole
// of the owner's staging model inside a product that has no environments
// (design D7, confirmed by the owner 2026-09-20).
//
// WHAT IS NOT HERE IS THE POINT. There is no rollback mutation: rollback is
// updateSiteBundle pointed back at the previous version, one row write,
// exactly as it was before this epic -- and giving it a ceremony of its own
// would have made the cheap operation look like the expensive one.

/// Publish a CANDIDATE VERSION beside the one that serves (epic memql#5531).
///
/// A candidate is a bundle version this deployable is not serving. Setting one changes NOTHING
/// about what the public is served: the edge goes on serving `bundleRef` to every request that
/// does not carry a preview grant, for a draft site and for a live one alike.
///
/// `candidateRef` IS STAMPED, NOT ACCEPTED, and clearSiteCandidate exists anyway. The stamp is what
/// makes this mutation always write the value it was given; the separate clear is what makes
/// "there is no candidate" expressible as an act a person takes deliberately, rather than as the
/// side effect of omitting an argument. updateSiteAccount's note is the general form of the rule.
///
/// `artifactId` is accepted for updateSiteBundle's reason exactly: it is optional provenance, and
/// an omitted accepted arg is DROPPED from the payload so the read-merge inherits what is stored.
///
/// A CANDIDATE MAY NOT EQUAL THE SERVING VERSION, which is a comparison against the PRIOR row and
/// therefore Go (component/memql/platform_site_candidate_guard.go). A candidate that is already
/// serving is not a candidate: there would be nothing to exercise, and promoting it would be a
/// write that changes nothing while reading like a release.
///
/// AUTHORIZATION is the concept's composite tier plus guardRowAuthzWrite -- the row's owner, or a
/// cluster owner through the explicit escape -- and @requiresCapability names the surface.
/// `preview` rather than `publish` is the line this epic draws: preparing and exercising a version
/// is one grant, making the public see it is another, and a person may hold the first without the
/// second.
@requiresCapability("execute", "app:deployables/preview")
mutation site setSiteCandidate {
  args {
    siteId        string!
    candidateRef  string!
    artifactId    string
  }
  update {
    accept { artifactId }
    stamp {
      id:            args.siteId
      candidateRef:  args.candidateRef
    }
  }
}

/// Withdraw the candidate version, leaving the deployable with only what it serves.
///
/// The plain inverse of setSiteCandidate, and its own act rather than an omitted argument -- see
/// that mutation's note. It touches neither `bundleRef` nor `previewBinding`: withdrawing a
/// candidate is not detaching a development store, and a person who withdraws one usually means to
/// publish another against the same store.
///
/// Every preview grant naming the withdrawn version stops resolving, because a grant names the
/// candidate it was issued for and the edge compares the two (component/edge/preview.go). So this
/// is also how an operator ends every open preview of a version at once.
@requiresCapability("execute", "app:deployables/preview")
mutation site clearSiteCandidate {
  args {
    siteId  string!
  }
  update {
    id:            args.siteId
    candidateRef:  ""
  }
}

/// Promote the candidate: the version being exercised becomes the version that serves.
///
/// THE ROW FLIP `bundleRef` ALREADY WAS. `bundleRef := candidateRef`, `candidateRef := ""`, one
/// write -- which is why rollback needs nothing new: updateSiteBundle pointed back at the previous
/// version is still one row write, and the version this promotion replaced is still sitting under
/// its own prefix in object storage.
///
/// THE CALLER NAMES THE VERSION IT IS PROMOTING, and that argument is the whole safety of this
/// mutation. A mutation body cannot read the row's own stored field, so the candidate has to arrive
/// as an argument; and an argument nobody checked would let a candidate republished between the
/// reading and the click be promoted by surprise. So a Go guard refuses a `candidateRef` that is
/// not the one STORED (component/memql/platform_site_candidate_guard.go) -- the same rule the work
/// spine's approvals use, where an approval is a decision about one specific artifact and the hash
/// is what stops it carrying to a modified one.
///
/// REFUSED WHILE THE SERVING BINDING NAMES A DEVELOPMENT STORE (issue memql#5546). Promoting is how
/// a version reaches shoppers, and a deployable whose `binding` points at a development store has
/// no shoppers to reach -- it would serve a catalog nobody can buy from and take orders into a
/// store that is not the merchant's. The guard is Go because whether a store is a development store
/// is a field on ANOTHER row (platform_site_golive_guard.go), and the refusal names the store and
/// the act that clears it, so the OS can make the act ABSENT rather than draw it and have it fail.
///
/// AUTHORIZATION is @requiresCapability("execute", "app:deployables/publish") -- promotion sits with
/// go live, pause and roll back rather than with preview, because it is the act that changes what
/// the public is served.
@requiresCapability("execute", "app:deployables/publish")
mutation site promoteSiteCandidate {
  args {
    siteId        string!
    candidateRef  string!
    artifactId    string
  }
  update {
    accept { artifactId }
    stamp {
      id:            args.siteId
      bundleRef:     args.candidateRef
      candidateRef:  ""
    }
  }
}

/// Point a storefront's CANDIDATE at the development store it is exercised against, or clear it
/// (epic memql#5531, design D8).
///
/// The preview binding's twin is `binding`, and the two are separate fields for the reason the
/// whole epic exists: `binding` is the store shoppers reach, and a version being exercised must
/// never be able to reach it. Written whole as {storeId} rather than merged, for
/// updateSiteStoreBinding's reason -- a read-merge would let a retired shape survive beside the
/// reference. An empty storeId writes an empty object, the unbound state, so detaching a
/// development store stays expressible.
///
/// THE STORE MUST BE A DEVELOPMENT STORE. v1:shopify:store.isDevelopment is a fact about somebody
/// else's system, recorded on the store row when it is attached, and a preview binding naming a
/// store without it is REFUSED -- that is the second direction of the go-live guard, and the reason
/// it matters is that the failure it prevents is silent: a preview against the live store looks
/// exactly like a preview, right up to the test payment landing in the merchant's real orders.
///
/// AUTHORIZATION is `app:deployables/store` (owner and developer), the same gate
/// updateSiteStoreBinding carries and for the same reason -- this names a v1:shopify:store row,
/// which reads at developer and above, and the Go guard beside it refuses a store the CALLER CANNOT
/// READ whatever capability they hold. `preview` is deliberately not enough: preparing a version is
/// one thing, choosing which of the cluster's stores it talks to is another. The reach is the
/// serving binding's: any storefront the caller can write, client storefronts included.
@requiresCapability("execute", "app:deployables/store")
mutation site updateSitePreviewBinding {
  args {
    siteId   string!
    storeId  string
  }
  update {
    id:              args.siteId
    previewBinding:  { storeId: args.storeId ?? "" }
  }
}

// ---- Preview grants and what the engine observed (epic memql#5531) ----
//
// THREE OF THE FOUR ARE @serverOnly, and the split is customDomain's exactly.
// A write that carries a CREDENTIAL, or that records a MEASUREMENT, is minted
// in Go and reaches the graph through a builtin; a write that decides nothing
// the tier has not already decided stays an ordinary mutation.
//
//   createSitePreviewGrant      @serverOnly -- writes a token digest
//   touchSitePreviewGrant       @serverOnly -- the edge's own record of use
//   recordSitePreviewObservation @serverOnly -- a measurement
//   revokeSitePreviewGrant      reachable   -- an operator ends a preview
//
// The reason the create cannot be reachable is the reason customDomain's
// cannot: a caller who chooses the token digest chooses the token, and the
// whole of what makes a preview URL a credential is that the person holding it
// did not pick it. A caller who chose `expiresAt` would choose the lifetime
// too, which is the only bound a bearer credential has here.

/// Mint a preview grant (epic memql#5531). @serverOnly: `tokenHash` is the digest of a bearer
/// credential and `expiresAt` is the only bound on it, so neither may be a caller's choice.
/// `sitePreviewOpen` (dsl/platform/builtins.memql) is the reachable surface.
///
/// `ownerUserId` IS STAMPED FROM THE ACTOR AND IS NOT AN ARGUMENT. The concept declares the
/// composite owner tier over this field, and a tier over a caller-supplied value records a guarantee
/// nothing provides -- it reads as safe, so an auditor seeing the tier stops looking. That is what
/// TestDeclaredOwnerFieldsAreServerStamped refuses, and it is right to: a preview is a credential
/// for an unpublished version, so "whose is it" must be a fact the engine established rather than a
/// field the wire carried. The builtin runs under the CALLER's own context, so `actor.userId` here
/// IS the person who asked.
///
/// SCOPING TO actor.userId IS NOT THE FIX, AND IT IS ALREADY DONE. The stamp above is exactly that
/// scoping -- the row is the caller's and the composite owner tier decides it -- and this mutation
/// is @serverOnly anyway, because ownership is not the property in question. What has to hold is
/// that the TOKEN DIGEST was minted rather than supplied and that `expiresAt` was computed rather
/// than chosen. A caller who picks the digest picks the token, and a caller who picks the expiry
/// picks the only bound a bearer credential has. Neither is a question about whose row it is, so no
/// amount of actor scoping answers it; only the Go frame that minted the token knows, which is why
/// `sitePreviewOpen` is the one way in (customDomain's createCustomDomain draws the same line for
/// the same reason).
///
/// `candidateRef` and `previewStoreId` are COPIED, not referenced, and the copy is the mechanism.
/// The edge compares the copy against the site row's live value and refuses a grant whose candidate
/// has moved, which is what makes withdrawing a candidate end every open preview of it.
@actor
@serverOnly
mutation sitePreviewGrant createSitePreviewGrant {
  args {
    grantId         string!
    siteId          string!
    tokenHash       string!  @maxLength(64) @pattern("^[0-9a-f]{64}$")
    candidateRef    string!
    previewStoreId  string
    issuedAt        datetime!
    expiresAt       datetime!
  }
  insert {
    accept { siteId, tokenHash, candidateRef, previewStoreId, issuedAt, expiresAt }
    stamp {
      id:           args.grantId
      ownerUserId:  actor.userId
    }
  }
}

/// Record that the edge honoured a grant (epic memql#5531). @serverOnly: it is the deployment's own
/// observation of its own serving path, and a client-writable "last seen" is a field that says what
/// its writer wanted it to say.
///
/// THE EDGE THROTTLES THIS RATHER THAN WRITING PER REQUEST. A preview loads a document and every
/// asset under it, and a write per asset would put the graph in the serving path of a page --
/// component/edge/preview.go holds the value for previewSeenThrottle before writing again. The
/// field is evidence that a URL was used, not a request counter, and it says so.
///
/// actor.userId SCOPING COULD NOT BE THE FIX HERE, because the writer is not a person. The EDGE
/// writes this, under its own synthetic cluster-owner actor, about a grant it has just resolved by
/// token digest -- it holds nobody's credential and never learns who is asking, so there is no
/// caller to scope to. And scoping it to the grant's own owner would not help either: the property
/// that matters is that the value was OBSERVED by the deployment rather than asserted by anybody,
/// and a field the grant's holder could write is a field that says what its writer wanted it to say.
@serverOnly
mutation sitePreviewGrant touchSitePreviewGrant {
  args {
    grantId     string!
    lastSeenAt  datetime!
  }
  update {
    id:          args.grantId
    lastSeenAt:  args.lastSeenAt
  }
}

/// End a preview (epic memql#5531). The plain inverse of opening one, and the ONE write here that
/// is not @serverOnly -- it carries no credential and decides nothing the tier has not decided, so
/// putting a Go hop in front of a timestamp would buy nothing (customDomain's `remove` draws the
/// same line for the same reason).
///
/// A SOFT END. The row stays as the record that a preview was opened, by whom, against which
/// version and which store -- which is the question asked after something unexpected turns up in a
/// development store, and a deleted row answers it for nobody.
///
/// AUTHORIZATION is the concept's composite tier plus guardRowAuthzWrite -- the grant's own
/// operator, or a cluster owner through the explicit escape, which is what lets an operator end a
/// preview somebody else left open.
@requiresCapability("execute", "app:deployables/preview")
mutation sitePreviewGrant revokeSitePreviewGrant {
  args {
    grantId    string!
    revokedAt  datetime!
  }
  update {
    id:         args.grantId
    revokedAt:  args.revokedAt
  }
}

/// Record one of the four things the engine can observe of a preview (issue memql#5547).
/// @serverOnly: it is a MEASUREMENT, and a measurement a client can write is not one.
///
/// `ownerUserId` IS STAMPED FROM THE ACTOR, for createSitePreviewGrant's reason exactly -- and the
/// consequence is worth stating rather than discovering: an observation belongs to WHOEVER RAN THE
/// EXERCISE, not to whoever opened the preview. Those are usually the same person; when they are
/// not, a cluster owner sees both sets through the tier's second arm and the other person sees their
/// own. Attributing the row to the grant's owner instead would mean a caller naming somebody else as
/// the author of a measurement, which is the guarantee the tier exists to make impossible.
///
/// SCOPING TO actor.userId IS ALREADY DONE AND IS NOT WHAT BARS THIS FROM THE WIRE. `ownerUserId` is
/// stamped from the actor, so the composite owner tier decides the row and a caller could only ever
/// write their own. What actor scoping cannot establish is the thing this row CLAIMS: that a store
/// answered, that a cart took a line, that a checkout address came back, and how long each took.
/// Those are MEASUREMENTS, and a measurement a client can write is not one -- a caller scoped
/// perfectly to themselves could still write four green rows against a storefront nobody exercised,
/// and the surface that reads them exists precisely to say whether that happened. So the writer has
/// to be the frame that did the measuring, which is what @serverOnly names.
///
/// `ok` IS REQUIRED AND `failure` IS THE WHY. A row here is an answer either way; a step nobody ran
/// has NO ROW, which is the third state and the one the OS draws as unmeasured. Writing a row to
/// say "we did not look" would make "nobody asked" and "we asked and got nothing" the same shape on
/// the screen, which is the one thing the design record asks this surface not to do.
@actor
@serverOnly
mutation sitePreviewObservation recordSitePreviewObservation {
  args {
    observationId  string!
    grantId        string!
    siteId         string!
    storeId        string!
    kind           enum("catalog_read", "cart_accepted", "checkout_url", "order_mirrored")!
    observedAt     datetime!
    ok             boolean!
    detail         string
    failure        string
    durationMs     int
  }
  insert {
    accept { grantId, siteId, storeId, kind, observedAt, ok, detail, failure, durationMs }
    stamp {
      id:           args.observationId
      ownerUserId:  actor.userId
    }
  }
}

/// Soft-delete a site by stamping deleted=true (memql#3717). The time-series row survives for
/// history; isNotDeleted on siteByHostname/sitesAll/siteById is what actually stops the edge
/// resolving a deleted site's hostname -- this mutation only flips the flag. A systemOwned row
/// (the portal's own seed) is refused regardless of who calls this: the DSL grammar cannot express
/// that conditional, so the block is a Go write guard wired beside executeWrite (see
/// component/memql/platform_site_delete_guard.go), not something this mutation body can enforce.
/// Beyond that, deletion is owner-or-cluster-owner: guardRowAuthzWrite admits the row's OWNER, and
/// the cluster-owner path is rowAuthzWriteEscape's explicit escape -- so one user cannot delete
/// another's deployable, and an operator can delete any non-systemOwned one.
@requiresCapability("execute", "app:deployables/retire")
mutation site deleteSite {
  args {
    siteId  string!
  }
  update {
    id:      args.siteId
    deleted: true
  }
}

// ---- setPackEnabled (module registry, memql#4189) ----

/// Flip a pack's per-instance enablement in v1:platform:packState. clusterOwner tier via the
/// concept's @rowAuthz -- these rows are the deployment's, not any operator's, and the tier injects
/// the actor gate. The Modules flip reaches this through MemQLEngine.SetPackEnabled
/// (component/memql), which admits the owner for any pack and a developer holding execute on
/// app:cluster/modules for a STOREFRONT pack only, then runs this under internal origin with the
/// caller's actor kept, so the row's provenance is the person; component/grpc's SetPackEnabledMsg
/// handler writes one audit event per attempt. The id is the bare pack domain -- the engine
/// canonicalizes it to v1:platform:packState:<packDomain>, so one row per pack with the version
/// history as the flip audit trail. RESTART-REQUIRED lifecycle: the write changes what each node
/// reads at its next boot, never what a running node has loaded.
///
/// The FIRST flip of a pack is a create, and a create needs a cluster owner or server code,
/// enforced in executeWrite (component/memql/create_rank_floor.go): the tier does not judge a
/// create, and a floor on this mutation would never see a raw insert() of the same concept (Connect
/// Shopify design, D13). Internal origin passes. Once a pack has a row, the tier's write guard
/// refuses every non-owner flip of it, so a direct call below owner is refused either way: a developer
/// flips a storefront pack through the Modules path above, never by calling this.
mutation packState setPackEnabled {
  args {
    id          string!
    packDomain  string!
    enabled     bool!
    reason      string
  }
  insert {
    accept { id, packDomain, enabled, reason }
  }
}

// ---- Custom domains (epic memql#4805) ----
//
// THE GRAPH HOLDS THE STATE MACHINE and these six writes are its whole
// vocabulary: one create, one remove a person makes, and four the sweep makes
// on their behalf. Everything the cluster actually does -- two DNS lookups, an
// Ingress, a Certificate -- hangs off a status this file writes.
//
// THE CREATE IS @serverOnly, AND THE REASON IS THE TOKEN. `token` is the value
// a client publishes at `TXT _memql-verify.<hostname>` to prove they control
// the name, so a caller who chooses it proves nothing: one constant published
// under a thousand domains would verify all of them. It is minted in Go
// (integrations/customdomain) and this mutation is how that mint reaches the
// row. The client-reachable surface is the `customDomainAdd` builtin, which is
// the same split sitePublishFromArtifact already uses -- a write that needs Go
// is reached through a capability, not by widening a mutation.
//
// THE FOUR SWEEP WRITERS ARE @serverOnly for the reason the outbox writers
// below are: actor.userId scoping has nobody to scope to. They are the
// deployment's own reconciliation state, written by the engine under its
// operator identity with internal origin stamped -- origin defaults to CLIENT,
// and a missed stamp refuses every call with only a WARN in the log.
//
// REMOVE IS NOT @serverOnly, and the asymmetry is deliberate. It writes no
// credential and decides nothing the tier has not already decided: an operator
// asks for the binding to come down, the row goes to `removing`, and the sweep
// dispatches the unbind. Making it a builtin too would put a Go hop in front of
// a status write for no gain.

/// Record a new custom-domain binding, pending its DNS records. @serverOnly: the token this writes
/// is the ownership proof a caller must not choose. `customDomainAdd` (dsl/platform/builtins.memql)
/// is the reachable surface.
///
/// The row lands `pending_dns` with no failureReason -- "created, nothing looked at yet" is a
/// different statement from "we looked and the record is missing", and the panel says so. The three
/// D10 guards (a hostname under the cluster's own domain, a front-door collision, more domains than
/// the per-site maximum) run in Go beside this write, for the same reason the site hostname policy
/// does: the domain comes from the environment, the maximum is env-tunable, and the collision needs
/// a read.
///
/// actor.userId scoping is not the fix, and could not be. There is nothing to scope to --
/// v1:platform:customDomain is clusterOwner tier and carries no owner field -- but the deeper reason
/// is that ownership is not the property in question. What has to hold is that the token was MINTED
/// rather than supplied, and only the Go frame that minted it knows that; a client-reachable create
/// taking a caller's token is a verification primitive that verifies nothing, however well scoped.
@serverOnly
mutation customDomain createCustomDomain {
  args {
    domainId   string!
    siteId     string!
    hostname   string!  @maxLength(253) @pattern("^[a-z0-9][a-z0-9.-]*[a-z0-9]$")
    token      string!
    accountId  string
  }
  insert {
    accept { siteId, hostname, token, accountId }
    stamp {
      id:             args.domainId
      status:         "pending_dns"
      failureReason:  ""
      failureDetail:  ""
    }
  }
}

/// Ask for a binding to come down. The row walks to `removing`; the sweep dispatches the unbind
/// script, and `markCustomDomainRemoved` closes the walk.
///
/// THE HOSTNAME STOPS RESOLVING AT THIS WRITE, not at the Ingress deletion: `liveCustomDomainByHostname`
/// filters `row.status == "live"`, so the edge stops answering the moment this lands. That ordering is the
/// point -- an operator removing a binding because it is being abused should not have to wait for
/// kubectl.
@requiresCapability("execute", "app:deployables/domains")
mutation customDomain removeCustomDomain {
  args {
    domainId  string!
  }
  update {
    id:             args.domainId
    status:         "removing"
    failureReason:  ""
    failureDetail:  ""
  }
}

/// What the sweep saw when a check did not pass. The row stays (or lands) in `verifying` and carries
/// the typed reason plus what was actually observed.
///
/// `lastCheckedAt` is written on EVERY pass, including the ones that change nothing else, which is
/// what lets the panel say "checked 40 seconds ago, still not pointing" rather than leaving somebody
/// unable to tell a stuck sweep from a stuck record.
///
/// actor.userId scoping is not the fix and there is nobody to scope to: the caller is the
/// reconciliation sweep, running under the engine's own operator identity, so actor.userId is empty
/// for every legitimate caller and a self-scoped filter would match nothing. The concept's
/// clusterOwner tier is the access decision. What @serverOnly adds over it is the WIRE -- without it
/// these become typed SDK methods whose only use is to tell the Domains panel something about the
/// cluster's DNS that nobody checked.
@serverOnly
mutation customDomain recordCustomDomainCheck {
  args {
    domainId       string!
    failureReason  string!
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { failureReason, lastCheckedAt }
    stamp {
      id:             args.domainId
      status:         "verifying"
      failureDetail:  args.failureDetail ?? ""
    }
  }
}

/// Both DNS checks passed: the name is proved and it points here. The row moves to `issuing` and the
/// next sweep pass dispatches the bind script.
///
/// `verifiedAt` is written once and never cleared. An issuance that fails afterwards does not
/// un-prove control of the name, and clearing it would restart a walk that is already past this
/// stage.
///
/// actor.userId scoping is not the fix and there is nobody to scope to: the caller is the
/// reconciliation sweep, running under the engine's own operator identity, so actor.userId is empty
/// for every legitimate caller and a self-scoped filter would match nothing. The concept's
/// clusterOwner tier is the access decision. What @serverOnly adds over it is the WIRE -- without it
/// these become typed SDK methods whose only use is to tell the Domains panel something about the
/// cluster's DNS that nobody checked.
@serverOnly
mutation customDomain markCustomDomainVerified {
  args {
    domainId       string!
    verifiedAt     datetime!
    lastCheckedAt  datetime!
  }
  update {
    accept { verifiedAt, lastCheckedAt }
    stamp {
      id:             args.domainId
      status:         "issuing"
      failureReason:  ""
      failureDetail:  ""
    }
  }
}

/// Provisioning did not go through. The row STAYS in `issuing` and carries the typed reason plus the
/// capability envelope's own detail.
///
/// IT DOES NOT FALL BACK TO `verifying`, and that is the honest reading: the DNS is verified, so
/// re-running the two lookups would prove nothing that is not already proven, and a status that
/// walked backwards would make the panel look like it had lost ground. `issuing` plus
/// `no_acme_issuer` says exactly what is true -- this cluster is trying to issue and cannot -- which
/// is the answer a local k3d install should get forever rather than a pretend success (design D7).
///
/// RETRIES RIDE THE SCHEDULE, and re-applying is safe because the bind script is idempotent: a
/// second `kubectl apply` of an unchanged Certificate is a no-op, so cert-manager's own ACME backoff
/// stays the thing that governs Let's Encrypt, not this loop.
///
/// actor.userId scoping is not the fix and there is nobody to scope to: the caller is the
/// reconciliation sweep, running under the engine's own operator identity, so actor.userId is empty
/// for every legitimate caller and a self-scoped filter would match nothing. The concept's
/// clusterOwner tier is the access decision. What @serverOnly adds over it is the WIRE -- without it
/// these become typed SDK methods whose only use is to tell the Domains panel something about the
/// cluster's DNS that nobody checked.
@serverOnly
mutation customDomain recordCustomDomainIssuanceFailure {
  args {
    domainId       string!
    failureReason  string!
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { failureReason, lastCheckedAt }
    stamp {
      id:             args.domainId
      status:         "issuing"
      failureDetail:  args.failureDetail ?? ""
    }
  }
}

/// The unbind did not go through. The row STAYS `removing`, carrying the typed reason and what the
/// cluster said, and the next pass tries again.
///
/// ITS OWN MUTATION, AND THE REASON IS A BUG THIS REPLACED. A failed unbind used to be recorded
/// through `recordCustomDomainIssuanceFailure`, which stamps `status: "issuing"` -- correct for the
/// one caller it was written for, and wrong for this one: a binding somebody had asked to take DOWN
/// was written back onto the certificate step, and the very next pass dispatched the BIND for it. On
/// a cluster with an issuer that re-applies the Ingress and Certificate of a domain its operator
/// removed, and if its DNS still points here it walks to `live` again -- the exact outcome
/// `removeCustomDomain` promises cannot happen ("an operator removing a binding because it is being
/// abused should not have to wait for kubectl"). Found by cancelling a domain on a local cluster,
/// whose ServiceAccount may not touch Ingresses at all, where it showed as a removal that reappeared
/// on "Certificate" two minutes later with Ownership and DNS drawn as verified -- neither had been.
///
/// A removal only ever ends at `removed`. It does not walk anywhere else, whatever the cluster says.
///
/// actor.userId scoping is not the fix and there is nobody to scope to: the caller is the
/// reconciliation sweep, running under the engine's own operator identity, so actor.userId is empty
/// for every legitimate caller and a self-scoped filter would match nothing. The concept's
/// clusterOwner tier is the access decision. What @serverOnly adds over it is the WIRE -- without it
/// this becomes a typed SDK method whose only use is to tell the Domains panel that a removal
/// failed, about a cluster nobody asked.
@serverOnly
mutation customDomain recordCustomDomainRemovalFailure {
  args {
    domainId       string!
    failureReason  string!
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { failureReason, lastCheckedAt }
    stamp {
      id:             args.domainId
      status:         "removing"
      failureDetail:  args.failureDetail ?? ""
    }
  }
}

/// The objects are applied and the certificate is not Ready yet. The ordinary state for the first
/// minute of an HTTP-01 order, and NOT a failure: it writes no failureReason, so the panel shows
/// `issuing` with a plain note rather than something a person should go and fix.
///
/// `lastCheckedAt` still moves, which is the point -- "asked 30 seconds ago, still waiting" and
/// "nothing has looked at this in an hour" are different situations and the panel has to be able to
/// tell them apart.
///
/// actor.userId scoping is not the fix and there is nobody to scope to: the caller is the
/// reconciliation sweep, running under the engine's own operator identity, so actor.userId is empty
/// for every legitimate caller and a self-scoped filter would match nothing. The concept's
/// clusterOwner tier is the access decision. What @serverOnly adds over it is the WIRE -- without it
/// these become typed SDK methods whose only use is to tell the Domains panel something about the
/// cluster's DNS that nobody checked.
@serverOnly
mutation customDomain recordCustomDomainIssuingProgress {
  args {
    domainId       string!
    note           string
    lastCheckedAt  datetime!
  }
  update {
    id:             args.domainId
    status:         "issuing"
    failureReason:  ""
    failureDetail:  args.note ?? ""
    lastCheckedAt:  args.lastCheckedAt
  }
}

/// The certificate came back Ready: the edge now resolves this hostname to its site.
///
/// actor.userId scoping is not the fix and there is nobody to scope to: the caller is the
/// reconciliation sweep, running under the engine's own operator identity, so actor.userId is empty
/// for every legitimate caller and a self-scoped filter would match nothing. The concept's
/// clusterOwner tier is the access decision. What @serverOnly adds over it is the WIRE -- without it
/// these become typed SDK methods whose only use is to tell the Domains panel something about the
/// cluster's DNS that nobody checked.
@serverOnly
mutation customDomain markCustomDomainLive {
  args {
    domainId       string!
    issuedAt       datetime!
    lastCheckedAt  datetime!
  }
  update {
    accept { issuedAt, lastCheckedAt }
    stamp {
      id:             args.domainId
      status:         "live"
      failureReason:  ""
      failureDetail:  ""
    }
  }
}

/// The unbind completed. Terminal, and the row STAYS -- the history is the audit, so a binding this
/// cluster once served is still answerable after it is gone.
///
/// actor.userId scoping is not the fix and there is nobody to scope to: the caller is the
/// reconciliation sweep, running under the engine's own operator identity, so actor.userId is empty
/// for every legitimate caller and a self-scoped filter would match nothing. The concept's
/// clusterOwner tier is the access decision. What @serverOnly adds over it is the WIRE -- without it
/// these become typed SDK methods whose only use is to tell the Domains panel something about the
/// cluster's DNS that nobody checked.
@serverOnly
mutation customDomain markCustomDomainRemoved {
  args {
    domainId       string!
    removedAt      datetime!
    lastCheckedAt  datetime!
  }
  update {
    accept { removedAt, lastCheckedAt }
    stamp {
      id:             args.domainId
      status:         "removed"
      failureReason:  ""
      failureDetail:  ""
    }
  }
}

// ---- The per-account front door (epic memql#5168) ----
//
// EVERY MUTATION HERE IS @serverOnly, and the clusterOwner tier is not the
// reason -- the tier is the ACCESS decision, and @serverOnly is about the WIRE.
// A door's whole walk is driven by the reconciler: what a client-reachable
// write would buy is the ability to declare a door live without the three
// hostnames ever having pointed at this cluster, which is a certificate the
// edge would then resolve traffic through. There is no operator need on the
// other side of that: the one act a person performs is opening the door, and
// the reconciler does the opening from the account's own reservation.

/// Open a front door for an account, pending DNS. Written by the reconciler when it first sees a
/// verified account holding a reserved name with no live door.
///
/// `reservedName` is COPIED from account.memqlDomain rather than read through the relationship,
/// and the concept's own description says why: changing a client's domain CLEARS memqlDomain, and
/// the teardown that follows has to name three hosts the account row can no longer produce.
/// actor.userId scoping is not the fix, and could not be. There is nothing to scope to -- the
/// concept is clusterOwner tier and carries no owner field -- but the deeper reason is that the
/// property in question is not who is asking. What has to hold is that the reservation was VERIFIED,
/// and only the reconciler's own frame, which has just read domainStatus and memqlReservedAt off the
/// account, knows that. A client-reachable create scoped perfectly to its caller would still open a
/// door for a name nobody proved they own.
@serverOnly
mutation accountFrontDoor createAccountFrontDoor {
  args {
    doorId        string!
    accountId     string!
    reservedName  string!  @maxLength(253) @pattern("^[a-z0-9][a-z0-9.-]*[a-z0-9]$")
  }
  insert {
    accept { accountId, reservedName }
    stamp {
      id:             args.doorId
      status:         "pending_dns"
      failureReason:  ""
      failureDetail:  ""
    }
  }
}

/// Record a pass that looked and did not advance. Writes what was seen at each of the three hosts
/// and the typed reason, and moves lastCheckedAt.
///
/// `hostChecks` is written on EVERY pass, including the ones that change nothing. That is what
/// makes "checked 40 seconds ago, api. still resolves to the old load balancer" a different
/// statement from "nobody has looked", and it is the only thing standing between an operator and
/// testing three CNAMEs by hand.
/// actor.userId scoping is not the fix: what this writes is what a DNS lookup RETURNED, and no
/// caller can be scoped into being a resolver. A client-reachable version would let the observation
/// be asserted rather than made, which is the one thing the whole walk rests on.
@serverOnly
mutation accountFrontDoor recordAccountFrontDoorCheck {
  args {
    doorId         string!
    status         enum("pending_dns", "verifying", "issuing", "removing")!
    hostChecks     object!
    failureReason  string!
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { status, hostChecks, failureReason, failureDetail, lastCheckedAt }
    stamp {
      id:  args.doorId
    }
  }
}

/// All three hosts point at this cluster. Moves the door to `issuing` and stamps verifiedAt.
///
/// verifiedAt is never cleared by a later failure: an issuance that fails afterwards does not
/// un-prove that the records were created, and clearing it would restart a walk already past that
/// stage.
/// actor.userId scoping is not the fix: verification is a claim about three CNAME records in the
/// public DNS, not about who is asking. Scoped to its caller it would still be a person declaring
/// that their own name points here, and the ACME order that follows would then be attempted on
/// their say-so against a rate limit the whole cluster shares.
@serverOnly
mutation accountFrontDoor markAccountFrontDoorVerified {
  args {
    doorId         string!
    hostChecks     object!
    verifiedAt     datetime!
    lastCheckedAt  datetime!
  }
  update {
    accept { hostChecks, verifiedAt, lastCheckedAt }
    stamp {
      id:             args.doorId
      status:         "issuing"
      failureReason:  ""
      failureDetail:  ""
    }
  }
}

/// The objects are applied and the certificate is not Ready yet -- the ordinary state for the first
/// minutes of an ACME order, and NOT a failure. Carries cert-manager's own condition message so the
/// rail can say what the issuer is waiting on rather than showing a spinner with no content.
/// actor.userId scoping is not the fix: the value written is cert-manager's own condition message,
/// read out of the cluster by the frame that just applied the objects. There is no caller who could
/// supply it truthfully, so a scoped write would only make it forgeable.
@serverOnly
mutation accountFrontDoor recordAccountFrontDoorIssuingProgress {
  args {
    doorId         string!
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { failureDetail, lastCheckedAt }
    stamp {
      id:             args.doorId
      status:         "issuing"
      failureReason:  ""
    }
  }
}

/// Issuance refused or failed. The door stays at `issuing` and carries the typed reason: a cluster
/// with no ACME issuer sits here forever, which is the correct local-cluster answer (custom domains
/// D7) and not a stuck state.
/// actor.userId scoping is not the fix, for recordAccountFrontDoorIssuingProgress's reason: this
/// records what the capability envelope came back with. A caller-scoped version would let a person
/// write no_acme_issuer onto a door that is issuing perfectly well, and the sweep would believe it.
@serverOnly
mutation accountFrontDoor recordAccountFrontDoorIssuanceFailure {
  args {
    doorId         string!
    failureReason  string!
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { failureReason, failureDetail, lastCheckedAt }
    stamp {
      id:      args.doorId
      status:  "issuing"
    }
  }
}

/// The certificate is Ready. From this write on the edge resolves `app.<reservedName>` to the OS
/// site with the account in context, and the api and id hosts terminate TLS.
/// actor.userId scoping is not the fix, and this is the sharpest case in the file. `live` is what
/// makes the edge resolve traffic through the door, and the only evidence for it is a Certificate
/// the reconciler read as Ready. A caller-scoped write would let anyone holding an account declare
/// their own door live and take traffic on a certificate that does not exist -- the browser's
/// error, their client's employees, our name on it.
@serverOnly
mutation accountFrontDoor markAccountFrontDoorLive {
  args {
    doorId         string!
    issuedAt       datetime!
    lastCheckedAt  datetime!
  }
  update {
    accept { issuedAt, lastCheckedAt }
    stamp {
      id:             args.doorId
      status:         "live"
      failureReason:  ""
      failureDetail:  ""
    }
  }
}

/// The reservation behind this door is gone -- the account's domain changed, or the account was
/// archived (design D9). Moves it to `removing` so the next pass unbinds.
///
/// THIS IS THE ONLY TRANSITION THAT CAN LEAVE `live`, and it is a teardown rather than a park. A
/// door whose reservation was discarded is the cluster serving three names it no longer holds proof
/// for; record A's rule is that proof of one name is not proof of another, and this is that rule
/// reaching the hosts.
/// actor.userId scoping is not the fix: the trigger is the ABSENCE of a reservation on the account
/// row, which is a fact about a different row the caller may not be able to read at all. An
/// operator who wants a door taken down changes the account's reservation, which is the act they
/// already have; this write is the consequence, not the control.
@serverOnly
mutation accountFrontDoor requestAccountFrontDoorRemoval {
  args {
    doorId         string!
    failureReason  string
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { failureReason, failureDetail, lastCheckedAt }
    stamp {
      id:      args.doorId
      status:  "removing"
    }
  }
}

/// actor.userId scoping is not the fix, for recordAccountFrontDoorIssuanceFailure's reason: this
/// records what the unbind's capability envelope came back with, which only the frame that ran it
/// saw.
///
/// A SEPARATE MUTATION FROM recordAccountFrontDoorIssuanceFailure, and the separation is the whole
/// point of it. That one stamps `status: "issuing"`, which is right for a bind that failed and
/// catastrophic for an unbind that did: routing a failed teardown through it walked the row
/// `removing` -> `issuing`, and the NEXT pass then re-applied the certificate and all four
/// Ingresses for a name whose reservation had been withdrawn -- putting a door the cluster had
/// stopped claiming back into service. Design D9 says removal is the only transition out of `live`;
/// without this mutation that transition was reversible.
@serverOnly
mutation accountFrontDoor recordAccountFrontDoorRemovalFailure {
  args {
    doorId         string!
    failureReason  string!
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { failureReason, failureDetail, lastCheckedAt }
    stamp {
      id:      args.doorId
      status:  "removing"
    }
  }
}

/// actor.userId scoping is not the fix, for recordAccountFrontDoorCheck's reason: this writes what
/// a DNS lookup returned about a door that is already serving, and no caller can be scoped into
/// being a resolver. A client-reachable version would let the drift counter be reset by the very
/// account whose drift it is counting.
///
/// KEEPS THE DOOR `live`. That is the whole distinction from recordAccountFrontDoorCheck, which
/// takes a status: a door that failed ONE re-check is still serving, and demoting on a single
/// unlucky lookup would take a client's front door down for a DNS blip. The sweep demotes through
/// recordAccountFrontDoorCheck once driftFailures reaches its bound.
@serverOnly
mutation accountFrontDoor recordAccountFrontDoorDrift {
  args {
    doorId         string!
    hostChecks     object!
    driftFailures  number!
    failureReason  string
    failureDetail  string
    lastCheckedAt  datetime!
  }
  update {
    accept { hostChecks, driftFailures, failureReason, failureDetail, lastCheckedAt }
    stamp {
      id:      args.doorId
      status:  "live"
    }
  }
}

/// The unbind completed. Terminal, and the row stays -- the pair (issuedAt, removedAt) is how long
/// this cluster served the client's name.
/// actor.userId scoping is not the fix: this records that the unbind script's envelope came back
/// applied, which only the frame that ran it saw. Scoped to a caller it would let a door be marked
/// removed while its Ingresses are still serving -- the row and the cluster disagreeing, with the
/// row being the one anybody reads.
@serverOnly
mutation accountFrontDoor markAccountFrontDoorRemoved {
  args {
    doorId         string!
    removedAt      datetime!
    lastCheckedAt  datetime!
  }
  update {
    accept { removedAt, lastCheckedAt }
    stamp {
      id:             args.doorId
      status:         "removed"
      failureReason:  ""
      failureDetail:  ""
    }
  }
}

// ---- The sync runtime's writes (epic memql#4378) ----
//
// Every one is @serverOnly, and for the same reason the shopify mirror's
// mutations are: actor.userId scoping has nobody to scope to. These rows
// are the deployment's own operational state -- an outbox queue and a
// health timeline -- written by the engine's drain worker and runners
// under the operator identity, never by a user acting on their own rows.
// A client-reachable mutation over them would be an SDK method whose only
// legitimate caller is the server.
//
// The outbox APPEND is not here. It happens inside the engine, in the
// same transaction as the row write it records (component/memql/
// outbox_append.go), because an entry that is not written atomically with
// the change it describes is either a change nothing propagates or a
// delivery of something that was rolled back.

/// Claim a pending entry for delivery. attempts is incremented by the caller so a claim that
/// crashes still counts against the ceiling -- a worker that dies mid-delivery must not give the
/// entry infinite lives. actor.userId scoping does not apply: the caller is the drain worker.
@serverOnly
mutation outboxEntry markOutboxDelivering {
  args {
    entryId   string!
    attempts  int!
  }
  update {
    id:        args.entryId
    status:    "delivering"
    attempts:  args.attempts
  }
}

/// Record a successful delivery. Terminal: nothing retries a delivered entry, and the receiver
/// recognising the idempotency key on a redelivery counts as success. actor.userId scoping does
/// not apply: the caller is the drain worker.
@serverOnly
mutation outboxEntry markOutboxDelivered {
  args {
    entryId      string!
    deliveredAt  datetime!
  }
  update {
    id:           args.entryId
    status:       "delivered"
    deliveredAt:  args.deliveredAt
    lastError:    ""
  }
}

/// Record a failed attempt and when to try again. Not terminal -- the entry returns to the drain
/// set and the worker skips it until nextAttemptAt. actor.userId scoping does not apply: the caller
/// is the drain worker.
@serverOnly
mutation outboxEntry markOutboxFailed {
  args {
    entryId        string!
    nextAttemptAt  datetime!
    lastError      string
  }
  update {
    id:             args.entryId
    status:         "failed"
    nextAttemptAt:  args.nextAttemptAt
    lastError:      args.lastError ?? ""
  }
}

/// Dead-letter an entry whose attempts are exhausted. Terminal until an operator retries it: the
/// worker never picks a dead entry up again, which is the whole difference between dead and failed.
/// actor.userId scoping does not apply: the caller is the drain worker.
@serverOnly
mutation outboxEntry markOutboxDead {
  args {
    entryId    string!
    lastError  string
  }
  update {
    id:         args.entryId
    status:     "dead"
    lastError:  args.lastError ?? ""
  }
}

/// Return a dead entry to the queue at the operator's request. Attempts reset to zero: the operator
/// has presumably fixed whatever was wrong, and carrying the old count forward would dead-letter it
/// again on the first hiccup. actor.userId scoping does not apply -- the row is the deployment's,
/// and the operator gate is the concept's clusterOwner tier plus the adminops caller.
@serverOnly
mutation outboxEntry retryOutboxEntry {
  args {
    entryId  string!
  }
  update {
    id:         args.entryId
    status:     "pending"
    attempts:   0
    lastError:  ""
  }
}

/// Discard a dead entry: the operator has decided this change will never be delivered. Recorded as
/// `delivered` would be a lie, so it stays `dead` and is marked discarded through lastError -- the
/// row is audit history and the queue read filters on status. actor.userId scoping does not apply
/// for the same reason retryOutboxEntry's does not.
@serverOnly
mutation outboxEntry discardOutboxEntry {
  args {
    entryId  string!
    reason   string
  }
  update {
    id:         args.entryId
    status:     "delivered"
    lastError:  args.reason ?? "discarded by an operator"
  }
}

/// Write one domain's health. Deterministic id per (concept, connector, direction), so this is an
/// append onto the same timeline every time. actor.userId scoping does not apply: the writer is the
/// sync runtime, acting for no user.
@serverOnly
mutation syncState upsertSyncState {
  args {
    stateId          string!
    conceptId        string!
    connector        string!
    direction        string!
    backfillCursor   string
    backfillStatus   string
    lastInboundAt    datetime
    lagSeconds       int
    lastReconcileAt  datetime
    driftCount       int
    outboxDepth      int
    deadLetterCount  int
    paused           bool
    lastError        string
  }
  insert {
    accept { conceptId, connector, direction, lastInboundAt, lastReconcileAt }
    stamp {
      id:               args.stateId
      backfillCursor:   args.backfillCursor ?? ""
      backfillStatus:   args.backfillStatus ?? "none"
      lagSeconds:       args.lagSeconds ?? 0
      driftCount:       args.driftCount ?? 0
      outboxDepth:      args.outboxDepth ?? 0
      deadLetterCount:  args.deadLetterCount ?? 0
      paused:           args.paused ?? false
      lastError:        args.lastError ?? ""
    }
  }
}

/// Pause or resume one domain. Separate from upsertSyncState so an operator's pause cannot be
/// clobbered by a runner's next health write -- read-merge preserves every field this one omits.
///
/// @serverOnly, and actor.userId scoping is not the fix: a sync-health row belongs to the
/// DEPLOYMENT, not to a user, so there is no owner field to compare an actor against. The gate that
/// matters is the concept's clusterOwner tier plus the owner/admin check at the operator surface
/// that calls this; the annotation keeps the write off the wire entirely.
@serverOnly
mutation syncState setSyncPaused {
  args {
    stateId  string!
    paused   bool!
  }
  update {
    id:      args.stateId
    paused:  args.paused
  }
}

// ---- packages (epic memql#4794) ----
//
// TWO GROUPS, and the split is the whole security shape of the epic.
//
// The FIRST group is the pipeline's own writers: every stage advance, every
// report, every version stamp. All @serverOnly, all called from Go under
// stamped internal origin (component/auth.ContextWithInternalOrigin, whose
// per-package allowlist grows deliberately and is asserted by a precondition
// test of its own). They are @serverOnly because their arguments are the
// pipeline's internal state -- a status the state machine decides, a report
// only the analysis can produce -- and a client-reachable mutation over them
// would let a caller declare a deploy succeeded that never ran.
//
// The SECOND group is what a PERSON does: create a package, archive one,
// archive a site. Those are ordinary caller-scoped mutations gated by the
// organization boundary and action permissions. Shared edits preserve the
// original owner; creating a package stamps its authenticated creator.
//
// A @serverOnly writer WITHOUT the stamp is refused on every call with only a
// WARN to show for it, so the two halves of each pipeline write -- this
// annotation and that stamp -- are a pair that has to land together.

/// Register a tracked package. The person's write: they supply the source, the engine supplies the
/// identity and the name.
///
/// `name` is an ARG here and only here, because at registration time no analysis has run yet and
/// the tree has not been read -- so the manifest cannot have supplied it. The first successful
/// analysis overwrites it through recordPackageAnalysis, which is why the field's doc says the name
/// comes from the manifest: this value is a placeholder with a person's guess in it.
///
/// `credentialId` NAMES one of the caller's v1:platform:sourceCredential rows and is a plain string
/// here on purpose (epic memql#4885, D10). There is no arg on this mutation, or anywhere else in the
/// packages surface, that carries a token VALUE: the token crossed the wire once, inside
/// sourceCredentialCreate, and the fetcher resolves the name under THIS package's owner -- so naming
/// somebody else's credential here buys nothing but a credential_not_found at the next fetch.
///
/// `accountId` is the tie the package's tier reads (memql#5303, D12). The compose flow sends the
/// cluster's own account unless a client was picked; absent, the package is untied and its owner's.
@actor
@requiresCapability("execute", "app:deployables/sources")
mutation package createPackage {
  args {
    sourceConnectionId string
    packageId     string!
    name          string!  @maxLength(120)
    sourceKind    enum("repo", "artifact")!
    repoUrl       string   @maxLength(400)
    repoRef       string   @maxLength(200)
    credentialId  string
    artifactId    string
    autoDeploy    boolean
    /// Owning organization. If omitted, the engine resolves an authorized default; it refuses an ambiguous choice.
    accountId     string
  }
  insert {
    accept { name, repoUrl, repoRef, credentialId, artifactId, accountId, autoDeploy, sourceConnectionId }
    stamp {
      id:              args.packageId
      ownerUserId:     actor.userId
      sourceKind:      args.sourceKind
      status:          "active"
      updateAvailable: false
    }
  }
}

/// Remove or restore only the configured source entry. Package lifecycle, deployables,
/// grants and installation bindings are unchanged. The engine restricts this to its owner.
@requiresCapability("execute", "app:deployables/sources")
mutation package setPackageSourceRemoved {
  args {
    packageId string!
    removed bool!
  }
  update {
    id: args.packageId
    sourceRemoved: args.removed
  }
}

/// Edit the source facts of a tracked package: which ref to deploy, and which of the owner's
/// credentials to fetch under -- switching a source to a fresh credential after revoking the old one
/// is this write. Minimal arguments deliberately -- update{} has been a read-merge since memql#1628,
/// so re-supplying every discriminator is dead weight that an undeclared-argument DISCARD hides.
@requiresCapability("execute", "app:deployables/sources")
mutation package updatePackageSource {
  args {
    packageId     string!
    repoRef       string   @maxLength(200)
    credentialId  string
    sourceConnectionId string
  }
  update {
    accept { repoRef, credentialId, sourceConnectionId }
    stamp {
      id: args.packageId
    }
  }
}

/// Turn one or more of a source's deployables OFF -- the owner's standing choice not to deploy
/// them.
///
/// NOT @serverOnly, and it is the same shape as setPackageAutoDeploy directly below: a person's
/// standing choice about their own source, so the composite tier's write guard -- the owner, or a
/// cluster owner -- is exactly the right gate and there is no engine writer at all. The pipeline
/// must never touch this field: it writes `declares`, which is what the MANIFEST says, and it
/// rewrites that wholesale on every analysis. Intent kept in the same place would be erased by the
/// next run.
///
/// A MEMBERSHIP CHANGE, not the whole list (memql#4951). It used to take the entire array, because
/// `update{}` read-merges a field and the DSL had no form for removing one member -- @appendFields
/// (memql#2240) adds to an array and had no counterpart. That made every caller read the current
/// list, change one name and write it all back, and left a race nothing declared: two windows
/// toggling two different apps at the same instant clobbered, and the loser was never told.
/// @addToSet is deduped, so disabling the same app twice is disabling it once, which is what makes
/// this and enablePackageDeployables inverses.
@addToSet("disabledDeployables")
@requiresCapability("execute", "app:deployables/retire")
mutation package disablePackageDeployables {
  args {
    packageId       string!
    deployableNames []string!
  }
  update {
    id:                  args.packageId
    disabledDeployables: args.deployableNames
  }
}

/// Turn one or more of a source's deployables back ON.
///
/// The exact inverse of disablePackageDeployables above, and the reason that one is a membership
/// change rather than a whole-list write: removing a member had no form at all. Removing a name
/// that is not there is a no-op rather than an error, so two people enabling the same app both
/// succeed and a retry is safe.
@removeFromSet("disabledDeployables")
@requiresCapability("execute", "app:deployables/retire")
mutation package enablePackageDeployables {
  args {
    packageId       string!
    deployableNames []string!
  }
  update {
    id:                  args.packageId
    disabledDeployables: args.deployableNames
  }
}

/// Turn a source's auto-deploy switch on or off (epic memql#4900).
///
/// The PERSON's write, and an owned one: the write guard resolves the target row and admits its
/// owner (or a cluster owner), so a caller cannot arm auto-deploy on somebody else's source. There
/// is no @serverOnly counterpart and no engine writer -- the switch is only ever a person's
/// decision, which is what makes an auto-run's provenance honest.
@requiresCapability("execute", "app:deployables/sources")
mutation package setPackageAutoDeploy {
  args {
    packageId   string!
    autoDeploy  boolean!
  }
  update {
    id:         args.packageId
    autoDeploy: args.autoDeploy
    autoDeployChangedAt: now
  }
}

/// Set a package's lifecycle status (D10). Pipeline/capability writer.
///
/// @serverOnly, and the reason is the whole D10 shape: archiving is a read-then-verify-then-write
/// dance MemQL cannot express -- the typed name has to be compared against the STORED name, and
/// "this package still has live deployables" is a question about OTHER rows. Both live in the
/// packageArchive capability, which runs under the CALLER's actor and reaches this mutation under
/// stamped internal origin once it has decided.
///
/// A client-reachable status write would be that capability with its two checks removed, which is
/// exactly the thing the design means by "the OS renders the confirm; the server remains the law".
/// The structural half of the law -- what may follow what -- is enforced a second time beside
/// executeWrite, so no writer of any kind can reach `archived` from a status that is not `disabled`.
///
/// actor.userId scoping is not the fix, and this is the clearest case of why: the caller DOES own
/// the row. Scoping would admit exactly the call the design refuses -- archiving without typing the
/// name and without the active-deployables check -- because both of those are conditions on the
/// package's state, not on who is asking.
@serverOnly
mutation package setPackageStatus {
  args {
    packageId  string!
    status     enum("active", "archived")!
  }
  update {
    id:     args.packageId
    status: args.status
  }
}

/// Stamp the version a successful deploy put live. Pipeline writer.
///
/// actor.userId scoping is not the fix, and the reason generalises to every pipeline writer below.
/// Caller-scoping bounds WHOSE rows a call may touch; the danger here is not whose row it is but
/// WHAT is being asserted about it -- "this version is now serving" is a fact only the code that
/// performed the roll can know, and a caller stamping it about their OWN package would be equally
/// wrong and equally unscoped-away. Second, this write happens after a stage handoff, on whichever
/// node the pipeline advanced on, where there is no person in scope at all: actor.userId is empty
/// there, so the scoped form would refuse the only legitimate caller it has.
@serverOnly
mutation package recordPackageDeployedVersion {
  args {
    packageId        string!
    deployedVersion  string!
    updateAvailable  boolean!
  }
  update {
    accept { deployedVersion, updateAvailable }
    stamp {
      id:                 args.packageId
    }
  }
}

/// Stamp the manifest's own name onto the package after an analysis has read the tree.
///
/// actor.userId scoping is not the fix: the value is READ OUT OF THE TREE, so the only correct
/// caller is the analysis that read it, and a caller-scoped version would let a person rename their
/// own package to something the manifest does not say -- which the very next deploy would overwrite.
/// Scoping bounds whose row is touched; the problem is that the value has one true source.
@serverOnly
mutation package recordPackageName {
  args {
    packageId  string!
    name       string!
  }
  update {
    id:   args.packageId
    name: args.name
  }
}

/// Record what a source's manifest declares, from the analysis that read it.
///
/// @serverOnly because it is the PIPELINE's reading of the tree, not a claim a client may make:
/// this list is what the OS offers as "apps you can still deploy", so a caller able to write it
/// could invent deployables that no manifest contains and have the console offer to deploy them.
///
/// actor.userId scoping is not the fix, for both of the reasons the other pipeline writers give.
/// It runs during a deploy, where stages hand off across nodes and actor.userId is EMPTY on the
/// very path that has to write -- a caller-scoped form could never write at all. And the thing
/// worth refusing here is not cross-user reach: it is somebody asserting that a package THEY OWN
/// contains an app its manifest does not name. Scoping bounds whose rows are touched, never what
/// may be claimed about them.
///
/// Rewritten whole on every analysis rather than merged, because the manifest is the authority on
/// what the source contains -- an app removed upstream must LEAVE this list, and a merge would
/// keep it forever.
@serverOnly
mutation package recordPackageDeployables {
  args {
    packageId  string!
    declares   []object!
  }
  update {
    id:       args.packageId
    declares: args.declares
  }
}

/// The D11 feeds' ONLY write. Both feeds -- the webhook and the poll -- converge here, and this
/// mutation touches exactly the two fields section C marks as feed-owned. That narrowness is the
/// design: a feed that could write anything else would be deciding to deploy, and deploying an
/// update is a person's click starting a NEW deployment run through analyze and confirm again.
///
/// actor.userId scoping is not the fix: the polling feed runs on a schedule with no person attached,
/// so actor.userId is empty on the only path that calls it, and the webhook feed runs inside the
/// inbound receiver where the "caller" is GitHub. Scoping it would refuse both legitimate callers
/// while still permitting the thing worth preventing -- a person asserting that their own package
/// has an upstream update it does not have, which is a claim about a row they already own.
@serverOnly
mutation package recordPackageUpstreamVersion {
  args {
    packageId           string!
    latestKnownVersion  string!
    updateAvailable     boolean!
  }
  update {
    accept { latestKnownVersion, updateAvailable }
    stamp {
      id:                  args.packageId
    }
  }
}

/// Open a deployment attempt. Pipeline writer, and the first row of an append-only timeline.
///
/// `ownerUserId` is STAMPED from actor.userId and is deliberately NOT an arg, for the reason
/// TestDeclaredOwnerFieldsAreServerStamped states: a concept declaring an owner tier over a
/// CALLER-SUPPLIED field records a guarantee nothing provides, and it reads as safe, so an auditor
/// seeing the tier stops looking. An earlier cut passed it as an argument on the reasoning that the
/// pipeline copies it off the package row -- true, and invisible at this boundary, which is exactly
/// what the gate exists to refuse.
///
/// What makes the stamp work on a path with no person on it is BORROWED AUTHORITY, the
/// component/campaigns pattern: the pipeline runs this one write under
/// auth.ContextWithUserActor(ctx, <the package's owner>), and that owner value was read off a
/// package row the STARTING caller had already resolved under their own actor -- so it can never
/// name a user the caller could not act as.
///
/// actor.userId scoping is not the fix for the REST of this construct, and that is the separate
/// question: the later stages of this very row are written where no person is in scope at all, and
/// the claim worth refusing ("this deploy succeeded") is one a caller could make about their own
/// package anyway. Hence @serverOnly as well as the stamp.
@serverOnly
@actor
mutation packageDeployment openPackageDeployment {
  args {
    deploymentId   string!
    packageId      string!
    sourceVersion  string
    requestedBy    string
    automatic      boolean
    nodeId         string
    /// The deployables this run was started for. Empty is the whole source.
    scopedTo       []string
    /// The run this one was started from, when it is a retry.
    fromDeploymentId string
    /// The package's account tie, copied by the pipeline off the package row (memql#5303).
    accountId      string
    startedAt      datetime!
  }
  insert {
    accept { sourceVersion, requestedBy, nodeId, scopedTo, fromDeploymentId, accountId }
    stamp {
      id:           args.deploymentId
      packageId:    args.packageId
      ownerUserId:  actor.userId
      status:       "analyzing"
      automatic:    args.automatic ?? false
      startedAt:    args.startedAt
      heartbeatAt:  args.startedAt
    }
  }
}

/// Say a run is still alive. Written on a fixed cadence by the node running the pipeline, and by
/// nothing else -- it is the engine's own account of its own liveness, which is exactly why it is
/// @serverOnly and why actor scoping is not the fix: a caller stamping it on their own deployment
/// would be asserting something only the running node can know, and the abandoned sweep reads it as
/// evidence.
///
/// It is a plain update onto a NON-TERMINAL row: the append-only guard already refuses a write onto
/// a terminal one, so a heartbeat arriving after a run finished is refused rather than reopening it.
///
/// actor.userId scoping is not the fix, for the reason recordPackageDeployedVersion gives one block
/// up: the value is a claim about what a NODE is doing, and a caller stamping it on their own
/// deployment would be asserting something only the running node can know -- while the sweep reads
/// it as evidence that a run is alive. Scoping it to the caller would make that claim forgeable by
/// exactly the party it is about. The run also has no caller for most of its life: the pipeline
/// heartbeats from a goroutine after the request that started it has returned, so a self-scoped
/// filter would refuse the only path that legitimately calls it.
@serverOnly
mutation packageDeployment heartbeatPackageDeployment {
  args {
    deploymentId  string!
    heartbeatAt   datetime!
  }
  update {
    id:          args.deploymentId
    heartbeatAt: args.heartbeatAt
  }
}

/// Close a run whose node stopped saying it was alive.
///
/// A STATUS OF ITS OWN, never 'failed'. Nothing failed that this sweep can name: the D6 order
/// guarantees every site is still serving what it was serving, and writing 'failed' would put a
/// verdict on somebody's package that the evidence does not support. The error it stamps names the
/// node and when it was last heard, which is the whole of what is known.
///
/// The sweep is the ONE writer allowed to close a stranded row, and this mutation is how: it exists
/// so that permission is a named construct a reader can find rather than a special case inside a
/// general close.
///
/// actor.userId scoping is not the fix, and here it is close to backwards. The row belongs to the
/// package's owner, and the caller is a SWEEP with nobody attached -- it runs on the cron leader on
/// a schedule, across every owner, precisely because the person watching a stuck rail is the one
/// who cannot fix it. A self-scoped filter would refuse every row the sweep exists to close. Nor
/// would caller-scoping buy anything: what must not happen is a CLIENT closing somebody's run as
/// abandoned, and @serverOnly is what forbids that, while the maintenance actor's cluster-owner
/// tier is what admits the sweep to the rows.
@serverOnly
mutation packageDeployment abandonPackageDeployment {
  args {
    deploymentId  string!
    stoppedAt     string
    error         object!
    finishedAt    datetime!
  }
  update {
    accept { stoppedAt, error, finishedAt }
    stamp {
      id:         args.deploymentId
      status:     "abandoned"
    }
  }
}

/// Advance a deployment to the next stage. Pipeline writer.
///
/// One mutation for every non-terminal transition rather than one per stage: the ORDER is the D6
/// law and the state machine in Go enforces it, so a mutation per stage would be six copies of one
/// write, each of which could drift from the law it was supposed to express.
///
/// actor.userId scoping is not the fix: a stage advance is a HANDOFF, frequently onto another node,
/// where no person is in scope and actor.userId is empty. And the risk a scoped form would leave
/// standing is the one that matters -- a caller driving their own deployment through `publishing`
/// without any of the work having happened.
@serverOnly
mutation packageDeployment advancePackageDeployment {
  args {
    deploymentId  string!
    status        enum("analyzing", "awaiting_confirm", "building", "staging_dsl", "rolling", "publishing")!
  }
  update {
    id:     args.deploymentId
    status: args.status
  }
}

/// Record that somebody asked this run to stop (epic memql#4937).
///
/// IT SETS A FLAG AND ENDS NOTHING. The node running the attempt is the only writer that closes the
/// row, which is what keeps the record honest: a mutation that wrote `cancelled` directly would
/// claim a run had stopped while its build was still running on a workbench somewhere, and the two
/// statements would be indistinguishable afterwards. So this records the ASK; the pipeline records
/// the OUTCOME at its next stage boundary.
///
/// @serverOnly, and actor.userId scoping is not the fix: the capability packageCancelDeployment resolves
/// the deployment through the owner-scoped read FIRST, so a caller who cannot see the run is
/// refused by name before this is reached, and the two refusals a person can actually hit -- the
/// run is already terminal, or it has started rolling -- are decisions about OTHER fields that a
/// mutation body cannot make. What @serverOnly adds is the WIRE: without it a client could flag a
/// run whose stage it never checked. An actor.userId filter would also refuse the legitimate
/// caller outright on the common path -- the pipeline reads this flag under no person at all.
@serverOnly
mutation packageDeployment requestPackageDeploymentCancel {
  args {
    deploymentId  string!
  }
  update {
    id:              args.deploymentId
    cancelRequested: true
  }
}


/// Re-stamp which deployables a run is for. Pipeline writer.
///
/// Scope is stamped at open from the placements the first call carried, and re-stamped HERE when a
/// parked run is confirmed -- because the gate is the moment a person answers which apps they
/// meant. A compose gate opens with no placements at all (the analyze is about the whole source)
/// and closes with the skips somebody ticked, so a run whose scope were fixed at open would report
/// progress on apps it had been told not to build.
///
/// Its own mutation rather than an argument on advancePackageDeployment: advancing is a stage
/// change and this is not, and a caller able to move a run's stage while rewriting what it is about
/// could relabel a run mid-flight.
///
/// actor.userId scoping is not the fix, for the reason every pipeline writer on this row carries:
/// scope is DERIVED from the placements the pipeline read, and it is what the console then trusts
/// to decide which run a page is about. A caller-scoped version would let somebody rewrite the
/// scope of their own run -- their own row, their own package -- and thereby point a Cancel, a
/// refusal notice and a rail at an app the run has nothing to do with. The write is the pipeline's
/// conclusion, not a preference, and there is no person in scope at the moment it is made.
@serverOnly
mutation packageDeployment recordPackageDeploymentScope {
  args {
    deploymentId  string!
    scopedTo      []string!
  }
  update {
    id:       args.deploymentId
    scopedTo: args.scopedTo
  }
}

/// Land the analysis report, and the snapshot it was read from. Pipeline writer.
///
/// actor.userId scoping is not the fix: the report is the output of the offline analysis gates
/// (component/packages) and nothing else can produce a truthful one. A caller-scoped version would
/// let a person write a clean report onto their own deployment and walk it past the confirm gate --
/// their own row, their own package, and a complete fabrication of the one artifact the gate exists
/// to show them.
/// @noUnset("snapshotArtifactId") because a run's snapshot is written ONCE and re-reported many
/// times. A resumed run re-analyses the bytes it already stored, so its second report carries no
/// artifact to store -- and without this the empty value would blank the id, leaving the row
/// pointing at nothing and a later retry refused `snapshot_unavailable` for a snapshot that is
/// sitting in blob storage (memql#4955).
@serverOnly
@noUnset("snapshotArtifactId")
mutation packageDeployment recordPackageDeploymentReport {
  args {
    deploymentId        string!
    report              object!
    sourceVersion       string
    snapshotArtifactId  string
  }
  update {
    accept { sourceVersion, snapshotArtifactId }
    stamp {
      id:      args.deploymentId
      report:  args.report
    }
  }
}

/// Finish a deployment attempt: succeeded, refused, or failed. Pipeline writer.
///
/// The row is TERMINAL after this and accepts no further writes -- enforced beside executeWrite,
/// because "append-only" is a property of the concept and not of the callers who happen to respect
/// it. A retry is a new row.
///
/// actor.userId scoping is not the fix: closing runs at the end of the pipeline, on a node with no
/// person in scope, and the assertion being made -- "this succeeded" -- is exactly the one a caller
/// scoped to their own rows would still be free to make falsely about their own deploy.
@serverOnly
mutation packageDeployment closePackageDeployment {
  args {
    deploymentId  string!
    status        enum("succeeded", "refused", "failed", "abandoned", "cancelled")!
    deployables   []object
    dslVersion    string
    buildLogTail  string
    builtOn       object
    error         object
    finishedAt    datetime!
  }
  update {
    accept { deployables, dslVersion, buildLogTail, builtOn, error }
    stamp {
      id:          args.deploymentId
      status:      args.status
      finishedAt:  args.finishedAt
    }
  }
}

/// Bind a site to the package deployable that produced it. Pipeline writer, run once on the FIRST
/// deploy of a deployable; later deploys find the site through these two fields and republish it.
///
/// actor.userId scoping is not the fix: these two fields are the KEY a later deploy republishes
/// through, so a caller able to set them on their own site could point somebody else's package
/// deployable at it and have the next deploy of that package publish into a site the package's
/// owner never chose. The site is the caller's; the consequence is not.
@serverOnly
mutation site recordSitePackageOrigin {
  args {
    siteId                 string!
    packageId              string!
    packageDeployableName  string!
  }
  update {
    accept { packageId, packageDeployableName }
    stamp {
      id:                     args.siteId
    }
  }
}

/// Set a site's lifecycle status, including `archived` (D10). Capability writer.
///
/// The existing updateSiteStatus stays exactly as it was and is the client-reachable one -- it
/// offers draft / live / disabled and cannot name `archived` at all, so the ordinary enable/disable
/// edge is unchanged and needs no capability. This one exists for the archive edge alone, for the
/// same reason setPackageStatus does: the typed hostname is compared against the STORED hostname,
/// which a mutation body cannot do.
///
/// actor.userId scoping is not the fix for the same reason it is not there: the caller owns the
/// site, so scoping admits the very call being refused. What is being withheld is not reach across
/// users -- it is the ability to skip the confirmation and the disable-first rule.
@serverOnly
mutation site setSiteStatus {
  args {
    siteId  string!
    status  enum("draft", "live", "disabled", "archived")!
  }
  update {
    id:     args.siteId
    status: args.status
  }
}

// ---- source credentials (epic memql#4885, D10) ----
//
// Three writes, split the way the packages block above is split.
// createSourceCredential and touchSourceCredential are the ENGINE's: the first
// lands a value only the Go frame that sealed it can vouch for, the second is
// the fetcher's own account of a fetch. revokeSourceCredential is the PERSON's:
// an owned, client-reachable status flip the write guard admits for the row's
// owner and refuses for everyone else.

/// Land a sealed credential. @serverOnly, and caller-scoping is not the fix: the row IS the caller's
/// (ownerUserId is stamped from actor.userId below), so a scoped form would admit exactly the call
/// being refused -- a browser writing an `encryptedValue` and `fingerprint` it composed itself.
/// Neither value can be vouched for by anyone but the Go frame that ran secret.Encrypt under
/// MEMQL_MASTER_KEY, a key that exists on nodes and must never exist on a laptop; a client-supplied
/// ciphertext would be a row that reads as configured and unseals to nothing, or to whatever the
/// client chose. So the only way in is the sourceCredentialCreate capability: the token crosses the
/// wire once, is sealed, and reaches this mutation under stamped internal origin WITH the caller's
/// own actor -- which is what makes the owner stamp the person who asked, and refuses an empty one.
@serverOnly
@actor
mutation sourceCredential createSourceCredential {
  args {
    credentialId    string!
    host            string!
    label           string!  @maxLength(120)
    encryptedValue  string!
    fingerprint     string!
  }
  insert {
    accept { host, label, encryptedValue, fingerprint }
    stamp {
      id:          args.credentialId
      ownerUserId: actor.userId
      kind:        "token"
      status:      "active"
    }
  }
}

/// Revoke a credential. The person's write, and an owned one: the write guard resolves the target
/// row and admits its owner (or a cluster owner, through the explicit escape), so a caller cannot
/// revoke a credential they do not hold. The row stays -- it is the audit history of what fetched
/// under it -- and every source fetching under it refuses at its next fetch until it is switched.
mutation sourceCredential revokeSourceCredential {
  args {
    credentialId  string!
  }
  update {
    id:        args.credentialId
    status:    "revoked"
    revokedAt: now
  }
}

/// Stamp the heartbeat. Pipeline writer: the fetcher and the poll call it right after unsealing, so
/// `lastUsedAt` is the engine's own account of a fetch and never enters an arrival-cue fingerprint.
///
/// actor.userId scoping is not the fix, for the reason recordPackageDeployedVersion gives: the value
/// is a claim about what the engine DID, and a caller stamping it on their own credential would be
/// equally wrong and equally unscoped away. And the poll runs on a schedule with nobody attached, so
/// a self-scoped filter would refuse the one path that legitimately calls it.
@serverOnly
mutation sourceCredential touchSourceCredential {
  args {
    credentialId  string!
    lastUsedAt    datetime!
  }
  update {
    accept { lastUsedAt }
    stamp {
      id: args.credentialId
    }
  }
}

// ---- GitHub App grants (epic memql#4912, C5/C6) ----
//
// Four writes, and the split is by WHO IS SPEAKING rather than by what changes.
// createGithubAppGrant and updateGithubAppGrant are the CALLBACK's, running on
// the identity node with a browser redirect in hand and no actor of its own --
// so both borrow the state row's user through auth.ContextWithUserActor before
// the stamp, and a blank one is refused in Go before either is rendered, because
// ContextWithUserActor is a no-op on an empty id and the row would land owned by
// nobody. refreshGithubAppGrantToken is the ENGINE's account of a token it
// renewed without anybody watching; recordGithubAppInstallations is the WEBHOOK's
// account of an installation somebody added or removed. Naming them apart is what
// keeps each argument list to the fields its writer can actually vouch for.
//
// All four are @serverOnly for the reason createSourceCredential is: every one of
// them writes a value sealed under MEMQL_MASTER_KEY, or a fact only a verified
// GitHub delivery establishes, and neither can be vouched for by a browser.

/// Land a new grant. The connect callback's insert, chosen over update when no grant for this
/// (owner, externalId) exists yet.
///
/// `externalId` rather than the login is the identity: a person who renames their GitHub account
/// keeps the same numeric id, and a grant keyed on the login would silently become a second row.
///
/// actor.userId scoping is not the fix, for the reason createSourceCredential records: the row IS
/// the caller's -- ownerUserId is stamped from actor.userId below -- so a scoped form would admit
/// exactly the call being refused, a browser writing an `encryptedValue` and a `refreshToken` it
/// composed itself. Neither can be vouched for by anyone but the Go frame that ran secret.Encrypt
/// under MEMQL_MASTER_KEY, a key that exists on nodes and must never exist on a laptop.
@serverOnly
@actor
mutation sourceCredential createGithubAppGrant {
  args {
    credentialId     string!
    host             string!
    label            string!  @maxLength(120)
    encryptedValue   string!
    fingerprint      string!
    refreshToken     string
    expiresAt        datetime
    login            string!
    externalId       string!
    installationIds  []string
  }
  insert {
    accept { host, label, encryptedValue, fingerprint, refreshToken, expiresAt, login, externalId, installationIds }
    stamp {
      id:          args.credentialId
      ownerUserId: actor.userId
      kind:        "github_app"
      status:      "active"
    }
  }
}

/// Update a grant in place. The connect callback's other half: reconnecting replaces the tokens and
/// re-reads the login and the installations, and does NOT mint a second row.
///
/// It stamps `status: "active"`, so reconnecting after a disconnect is the repair rather than a
/// second credential to choose between. `revokedAt` is deliberately left alone: a datetime cannot be
/// cleared, and the timestamp of the last disconnect stays true as history -- which is why the card
/// reads it only alongside `status`.
///
/// actor.userId scoping is not the fix, and the filter is not what is missing: the callback resolves
/// the row by (owner, externalId) under the state row's own user before it gets here. What
/// @serverOnly withholds is the WIRE. Every value this writes is sealed ciphertext, so a
/// client-reachable form would let a browser write an `encryptedValue` and a `refreshToken` of its
/// choosing onto its own grant -- a row that reads as connected and unseals to whatever the client
/// picked. The seal is the authorization, and only a node holds the key.
@serverOnly
mutation sourceCredential updateGithubAppGrant {
  args {
    credentialId     string!
    encryptedValue   string!
    fingerprint      string!
    refreshToken     string
    expiresAt        datetime
    login            string!
    installationIds  []string
  }
  update {
    accept { encryptedValue, fingerprint, refreshToken, expiresAt, login, installationIds }
    stamp {
      id:     args.credentialId
      status: "active"
    }
  }
}

/// Record a token the engine renewed on its own. Written after a server-side refresh, inside the
/// fetch or poll that needed it, so a person is never sent back through the browser for an expiry.
///
/// It writes the four token fields and NOTHING else -- not the login, not the installations, not the
/// status. A refresh is evidence about a token, and a writer that also touched the installations
/// would be reporting a fact it did not observe.
///
/// actor.userId scoping is not the fix, for the reason touchSourceCredential gives: the value is a
/// claim about what the ENGINE did, and a caller stamping a sealed token on their own grant would be
/// equally wrong and equally unscoped away. The poll also runs on a schedule with nobody attached,
/// so a self-scoped filter would refuse the one path that most needs to refresh.
@serverOnly
mutation sourceCredential refreshGithubAppGrantToken {
  args {
    credentialId    string!
    encryptedValue  string!
    fingerprint     string!
    refreshToken    string
    expiresAt       datetime
  }
  update {
    accept { encryptedValue, fingerprint, refreshToken, expiresAt }
    stamp {
      id: args.credentialId
    }
  }
}

/// Record the installations a grant can reach. The webhook's write, from an `installation` or
/// `installation_repositories` delivery the inbound seam already HMAC-verified.
///
/// The list is REPLACED rather than merged, because a read carries the whole set and a merge could
/// never remove one -- and an installation that stays in the list after it was uninstalled is
/// exactly the state that turns a clear repository_not_installed into an unexplained 404.
///
/// actor.userId scoping is not the fix: this records what GITHUB answered, not what a person typed,
/// and a caller-reachable form would let a browser claim its grant reaches an installation it does
/// not -- which is the one field the picker's "install it here" link is decided from. The writer
/// already runs under the owner's actor, so the row is scoped; what @serverOnly withholds is a wire
/// on which that claim could be composed.
@serverOnly
mutation sourceCredential recordGithubAppInstallations {
  args {
    credentialId     string!
    installationIds  []string
  }
  update {
    accept { installationIds }
    stamp {
      id: args.credentialId
    }
  }
}

/// Record one node's verdict on one module as a new version of the deterministic row
/// v1:platform:moduleReadiness:<module>--<nodeId>. @serverOnly: readiness is the engine's own
/// observation, written under internal origin at boot and on a change; a client-reachable writer
/// would be a primitive for forging "configured".
///
/// actor.userId scoping is not the fix, and there is nothing to scope to: the concept is public,
/// requiresIdentity tier and carries no owner field, because readiness is a fact about the NODE, not
/// about any user. A caller-reachable write would let any signed-in caller claim any node's
/// configuration state, however the args were scoped.
@serverOnly
mutation moduleReadiness recordModuleReadiness {
  args {
    rowId       string!
    module      string!
    nodeId      string!
    nodeType    string!
    state       enum("configured", "partial", "unconfigured", "notApplicable", "unknown")!
    reason      string
    core        boolean
    lanes       []object
    reportedAt  string!
  }
  insert {
    id:          args.rowId
    module:      args.module
    nodeId:      args.nodeId
    nodeType:    args.nodeType
    state:       args.state
    reason:      args.reason ?? ""
    core:        args.core ?? false
    lanes:       args.lanes ?? []
    reportedAt:  args.reportedAt
  }
}

// THE EMBEDDER BINDING'S WRITES ARE @serverOnly, and the reason is not the tier
// (epic memql#5137, D6). A cluster owner may certainly CHOOSE the embedder --
// that is the point of the feature. What they may not do is write this row
// directly, because activating a binding is not a write: it is create the
// vector table for the new width, run reembedLibrary to fill it, compare the
// counts, and only then flip `active`. A mutation reachable from a client would
// let somebody perform step four on its own, and the cluster would then read
// every vector in the old table through the new model's geometry -- half a
// search space, ranked confidently, with no error anywhere.
//
// The act an operator performs is the BUILTIN that runs all four steps. These
// are what it writes with.

/// Record a binding that is being activated. Written before the re-embed starts, with
/// `activatedAt` deliberately absent -- until the counts match this row is a PLAN, and a reader
/// seeing a timestamp on it would read a switch that has not happened as one that has.
///
/// @serverOnly, AND actor.userId SCOPING IS NOT THE FIX, because there is no actor to scope to.
/// The embedder is a property of the DEPLOYMENT: one binding, one vector space, everybody's rows in
/// it. A per-user binding is not a narrower version of this feature, it is a different and
/// incoherent one -- two users embedding into two geometries and one `similarTo` comparing across
/// them. This write happens under the engine's own operator identity, as one step of an activation
/// the builtin performs.
///
/// Note the concept is READABLE by any signed-in person (public, requiresIdentity): there is no
/// secret in a model id and a width, and somebody asking why their search changed shape needs it.
/// Readable and writable are separate questions and this is the answer to the second one.
@serverOnly
@createOnly("providerRef", "dimensions", "previousRef", "reembedRunId")
mutation embedderBinding recordEmbedderBindingPlan {
  args {
    bindingId     string!
    providerRef   string!
    dimensions    int!     @minimum(1)
    previousRef   string
    reembedRunId  string
  }
  insert {
    accept { providerRef, dimensions, previousRef, reembedRunId }
    stamp {
      id: args.bindingId
    }
  }
}

/// Flip the binding to active. Called only when the new width's vector count matches the old one's;
/// `activatedAt` is what makes this row a state rather than a plan.
///
/// @serverOnly, AND actor.userId SCOPING IS NOT THE FIX -- same reason as the plan write above (no
/// actor owns a deployment-wide vector space) plus one this write has on its own. Flipping the
/// binding is the LAST of four steps: create the new width's table, fill it, compare the counts,
/// flip. A caller-reachable mutation would let somebody perform step four alone, and the cluster
/// would then read every vector in the old table through the new model's geometry -- half a search
/// space, ranked confidently, with no error anywhere. The guard is that only the builtin that ran
/// steps one to three can call this.
@serverOnly
mutation embedderBinding activateEmbedderBinding {
  args {
    bindingId    string!
    activatedAt  datetime!
  }
  update {
    id:           args.bindingId
    activatedAt:  args.activatedAt
  }
}

// ---- Measurement and evidence writes (epic memql#5146) ----
//
// All three are @serverOnly, and for one reason with three faces.
//
// A measurement is a NUMBER THE ROUTER RANKS ON. A client-reachable write here
// is a primitive for making a model look good: name your own machine, name your
// own model, claim 0.99 structured validity, and the fleet routes structured
// work to it. The figures may only come from a probe the engine started and a
// machine the engine asked.
//
// An evidence row is the same argument over a longer window, and its decision
// field decides whether a person is asked again.

/// Record one probe's figures. @serverOnly: the figures are what the router ranks on, so a
/// client-reachable write would be a primitive for making a model look good by claiming so.
///
/// actor.userId scoping is NOT the fix, and this is the subtle part: the caller IS the machine's
/// owner here, so a self-scoped filter would admit exactly this call. Scoping answers "whose row is
/// it", and the hazard is not whose -- it is that a legitimate owner could write any figures they
/// like about their own machine and have the fleet route structured work to it on the strength of
/// them. Only the server knows what the probe actually reported, so only the server may write it.
///
/// ownerUserId is STAMPED FROM THE ACTOR and never taken from args -- the concept declares it
/// @serverSet. The probe's report arrives on an agent replica, which runs this under
/// auth.ContextWithUserActor for the registration's owner: the borrowed-authority shape every other
/// write about somebody's machine already uses, and the reason a worker's own principal cannot
/// write here directly.
@actor
@serverOnly
mutation modelMeasurement recordModelMeasurement {
  args {
    measurementId        string!
    machineId            string!
    modelId              string!
    suiteVersion         string!
    measuredAt           string!
    /// Each figure is { measured: true, median, spreadLow, spreadHigh, n } XOR
    /// { measured: false, absentReason, absentDetail }. Rendered by
    /// component/worker/probe.Figure.Row(), which is the one place that decides
    /// the shape and the one place that refuses a malformed one.
    structuredValidity   object
    toolCallCorrectness  object
    throughputTps        object
    ttftMs               object
    probeError           string
  }
  insert {
    id: args.measurementId
    ownerUserId: actor.userId
    args.machineId
    args.modelId
    args.suiteVersion
    args.measuredAt
    structuredValidity: args.structuredValidity ?? {}
    toolCallCorrectness: args.toolCallCorrectness ?? {}
    throughputTps: args.throughputTps ?? {}
    ttftMs: args.ttftMs ?? {}
    probeError: args.probeError ?? ""
  }
}

/// Record one model's folded week. @serverOnly: the nightly fold is the only writer, and the counts
/// are what a demotion proposal rests on.
///
/// actor.userId scoping is not the fix because there is nobody to scope to. The row is the
/// deployment's own reconciliation state -- it declares @rowAuthz(clusterOwner) and carries no owner
/// field at all, because the question it answers is how a MODEL behaved across the fleet rather than
/// how it behaved for one person. A caller-scoped filter over a row with no owner matches nothing,
/// which would leave the fold unable to write its own output.
@actor
@serverOnly
mutation modelEvidence recordModelEvidence {
  args {
    evidenceId          string!
    modelId             string!
    level               string!
    week                string!
    calls               int!
    structuredFailures  int
    repairs             int
    retries             int
    parks               int
    proposal            string
    approvalId          string
    ruleHash            string
    foldedAt            string!
  }
  insert {
    accept { modelId, level, week, calls, foldedAt }
    stamp {
      id: args.evidenceId
      structuredFailures: args.structuredFailures ?? 0
      repairs: args.repairs ?? 0
      retries: args.retries ?? 0
      parks: args.parks ?? 0
      proposal: args.proposal ?? "none"
      approvalId: args.approvalId ?? ""
      ruleHash: args.ruleHash ?? ""
    }
  }
}

/// Record what a person decided about a proposal. @serverOnly for the reason above, plus one of its
/// own: `declined` is what stops the same week's evidence re-proposing, so a client that could write
/// it could silence a demotion nobody declined.
///
/// actor.userId scoping is not the fix for the same reason it is not on recordModelEvidence -- the
/// row has no owner to scope to. The decision itself IS gated on a person: it is written from the
/// approval path, where v1:work:approval already recorded who decided and when, and this row only
/// mirrors the outcome so the next fold can read it without re-reading every approval.
@actor
@serverOnly
mutation modelEvidence recordEvidenceDecision {
  args {
    evidenceId  string!
    proposal    string!
    decidedAt   string!
  }
  update {
    id: args.evidenceId
    args.proposal
    foldedAt: args.decidedAt
  }
}

/// Verified installation writer. Only the Go capability may supply the grant,
/// installation and provider account facts after checking GitHub live.
/// actor.userId scoping cannot establish that the grant reaches this installation
/// or derive provider metadata; a caller could otherwise forge its own binding.
@serverOnly
@actor
mutation sourceConnection recordSourceConnection {
  args {
    connectionId string!
    credentialId string!
    installationId string!
    providerAccountId string!
    accountLogin string!
    accountType string!
  }
  insert {
    accept { credentialId, installationId, providerAccountId, accountLogin, accountType }
    stamp {
      id: args.connectionId
      ownerUserId: actor.userId
      status: "active"
    }
  }
}

/// Local binding removal after the capability has resolved the owner. This
/// changes no credential, package, deployment or hosted site.
/// actor.userId scoping alone cannot enforce execute on app:deployables/sources;
/// the capability checks that independent management permission before this write.
@serverOnly
mutation sourceConnection removeSourceConnection {
  args { connectionId string! }
  update {
    id: args.connectionId
    status: "removed"
  }
}

/// Provider callback only: caller ownership alone cannot prove authorization
/// at Shopify. The integration records this after verified OAuth approval.
@serverOnly
mutation externalConnection recordExternalConnection {
  args {
    connectionId string!
    ownerUserId string!
    provider string!
    resourceId string!
    label string!
  }
  insert {
    accept { ownerUserId, provider, resourceId, label }
    stamp {
      id: args.connectionId
      status: "active"
    }
  }
}

/// Removing a personal selection changes no provider grant or deployed site.
@actor
@requiresCapability("execute", "app:settings/connections")
mutation externalConnection disconnectExternalConnection {
  args { connectionId string! }
  update {
    id: args.connectionId
    status: "removed"
  }
}
