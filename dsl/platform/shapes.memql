// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Comprehensive policy-trace projection for v1:platform:policyTrace rows. Backs the
/// policyTracesForPolicy debug query and any operator surface that lists recent policy evaluations.
@row
shape policyTrace policyTraceFull {
  row.id
  policyName
  tier
  actorUserId
  actorRole
  callerPartition
  argsHash
  resultJson
  traceJson
  durationMs
  error
  row.createdAt
}

/// Comprehensive configuration variable projection. Used for both v1:platform:partitionVariable
/// (partition-scoped) and v1:platform:globalVariable (global) -- the two concepts share the same
/// field layout, so one shape serves both.
@row
shape partitionVariable variableFull {
  row.id
  name
  value
  description
  row.createdAt
}

/// Missing-capability projection for the platform-backlog view + the Planner Agent's
/// lookup-by-(kind, capability) before logging a new sighting. Carries the dedup key (kind,
/// capability) plus the prioritization signals (sightingCount, lastSeenAt, exampleGoals).
@row
shape missingCapability missingCapabilityFull {
  row.id
  kind
  capability
  description
  requestedFromPlanId
  requestedByAgentId
  partitionId
  partitionScope
  sightingCount
  firstSeenAt
  lastSeenAt
  status
  resolution
  exampleGoals
}

// ---- shapes/v1/platform/outboundRequestFull.memql ----

/// Full outbound-request projection (memql#2521). Backs the worker's drain scan and any
/// operator/product surface auditing delivery state.
@row
shape outboundRequest outboundRequestFull {
  row.id
  medium
  target
  subject
  body
  status
  attempts
  lastError
  nextAttemptAt
  sentAt
  dedupeKey
  requestedBy
  row.createdAt
}

// ---- shapes/v1/platform/inboundRequestFull.memql ----

/// Full inbound-request projection (memql#2957). Backs the product automation's read of a staged
/// row and any operator surface auditing what arrived.
@row
shape inboundRequest inboundRequestFull {
  row.id
  source
  medium
  body
  contentType
  status
  dedupeKey
  signatureVerified
  receivedAt
  processedAt
  lastError
  row.createdAt
}
