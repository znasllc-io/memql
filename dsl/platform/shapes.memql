// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Comprehensive configuration variable projection. Used for both v1:platform:partitionVariable
/// (partition-scoped) and v1:platform:globalVariable (global) -- the two concepts share the same
/// field layout, so one shape serves both.
@row
shape partitionVariable variableFull {
  row.id
  name
  value
  description
  row.createdAt
}

/// Missing-capability projection for the platform-backlog view + the Planner Agent's
/// lookup-by-(kind, capability) before logging a new sighting. Carries the dedup key (kind,
/// capability) plus the prioritization signals (sightingCount, lastSeenAt, exampleGoals).
@row
shape missingCapability missingCapabilityFull {
  row.id
  kind
  capability
  description
  requestedFromPlanId
  requestedByAgentId
  partitionId
  partitionScope
  sightingCount
  firstSeenAt
  lastSeenAt
  status
  resolution
  exampleGoals
}

// ---- shapes/v1/platform/outboundRequestFull.memql ----

/// Full outbound-request projection (memql#2521). Backs the worker's drain scan and any
/// operator/product surface auditing delivery state.
@row
shape outboundRequest outboundRequestFull {
  row.id
  medium
  target
  subject
  body
  status
  attempts
  lastError
  nextAttemptAt
  sentAt
  dedupeKey
  requestedBy
  row.createdAt
}

// ---- shapes/v1/platform/inboundRequestFull.memql ----

/// Full inbound-request projection (memql#2957). Backs the product automation's read of a staged
/// row and any operator surface auditing what arrived.
@row
shape inboundRequest inboundRequestFull {
  row.id
  source
  medium
  body
  contentType
  status
  dedupeKey
  signatureVerified
  receivedAt
  processedAt
  lastError
  row.createdAt
}

/// Full projection of v1:platform:site -- what the edge needs to serve a request and what the
/// portal's site list renders.
@row
shape site siteFull {
  row.id
  ownerUserId
  hostname
  kind
  bundleRef
  status
  apiProxy
  systemOwned
  title
  notes
  artifactId
  binding
  packageId
  packageDeployableName
  accountId
  row.createdAt
}

/// Full projection of v1:platform:customDomain -- what the Domains panel renders and what the
/// verification sweep reads to decide its next move (epic memql#4805).
///
/// EVERY FIELD THE PANEL NEEDS IS HERE, and that is a rule rather than a convenience: a concept
/// field is not a readable field, and a projection that omitted `token` or `failureDetail` would
/// hand the guidance panel a row with nothing to render and no error to explain it. `token` is
/// projected on purpose -- it is the value the client has to publish in DNS, so a panel that could
/// not show it could not do its job. The tier is clusterOwner, so only an operator ever reads it.
@row
shape customDomain customDomainFull {
  row.id
  siteId
  hostname
  accountId
  token
  status
  failureReason
  failureDetail
  lastCheckedAt
  verifiedAt
  issuedAt
  removedAt
  row.createdAt
}

/// Full projection of v1:platform:outboxEntry -- what the drain worker needs to deliver an entry
/// and what the operator's dead-letter queue renders.
@row
shape outboxEntry outboxEntryFull {
  row.id
  conceptId
  rowRef
  action
  version
  target
  status
  attempts
  nextAttemptAt
  lastError
  idempotencyKey
  deliveredAt
  row.createdAt
}

/// Full projection of v1:platform:syncState -- one domain's health, as the Data origins page reads
/// it and as the runners write it.
@row
shape syncState syncStateFull {
  row.id
  conceptId
  connector
  direction
  backfillCursor
  backfillStatus
  lastInboundAt
  lagSeconds
  lastReconcileAt
  driftCount
  outboxDepth
  deadLetterCount
  paused
  lastError
  row.createdAt
}

// ---- packages (epic memql#4794) ----

// ---- source credentials (epic memql#4885) ----

/// The client-readable projection of v1:platform:sourceCredential -- the Settings Sources group, the
/// Source stop's credential chip, and the connected-account card. Everything BUT the two sealed
/// fields, and that omission is the security property: no client read can return ciphertext, because
/// no client-reachable query carries a shape that projects it. `fingerprint` is what tells two
/// credentials apart; `lastUsedAt` is a heartbeat and must never enter an arrival-cue fingerprint.
///
/// `kind`, `login` and `installationIds` are here because the card has to say what a person is
/// looking at -- a pasted token, or a grant connected as @somebody that reaches these installations
/// -- and `installationIds` moving IS news: it means somebody installed the app somewhere, which is
/// exactly the change the card exists to show. `externalId` and `expiresAt` are deliberately absent:
/// one is an internal key nothing renders and the other is a timestamp the engine refreshes on its
/// own, so a card driven by it would announce a change every eight hours.
@row
shape sourceCredential sourceCredentialCard {
  row.id
  ownerUserId
  host
  kind
  label
  login
  installationIds
  fingerprint
  status
  lastUsedAt
  revokedAt
  row.createdAt
}

/// The server-only projection: what a fetch needs and nothing a person does. Reached through
/// sourceCredentialSealedById and githubAppGrantByExternalId alone, both @serverOnly and both
/// resolved under the OWNER's actor from inside a fetch, a poll or the connect callback; the
/// ciphertext is unsealed into a local that dies with the call.
///
/// It carries BOTH sealed fields, and the pair is what makes a grant usable without a browser: the
/// user token expires in eight hours, so a resolution that could read only `encryptedValue` would
/// send a person back through GitHub every working day. `kind` decides which shape of credential
/// the resolver is holding, and therefore whether a 401 reads as "this token cannot see it" or as
/// reconnect_required.
@row
shape sourceCredential sourceCredentialSealed {
  row.id
  ownerUserId
  host
  kind
  status
  encryptedValue
  login
  externalId
  refreshToken
  expiresAt
  installationIds
}

/// Full projection of v1:platform:package -- the OS packages list and detail.
///
/// `credentialId` is projected deliberately: it is a NAME, never a value (epic memql#4885), and the
/// person editing a package has to be able to see which of their credentials it fetches under.
/// Nothing here can leak a credential, because no credential is ever on the row.
@row
shape package packageFull {
  row.id
  ownerUserId
  name
  sourceKind
  repoUrl
  repoRef
  credentialId
  artifactId
  deployedVersion
  latestKnownVersion
  updateAvailable
  status
  row.createdAt
}

/// Full projection of v1:platform:packageDeployment -- the timeline and the confirm gate.
///
/// `report` and `error` are projected whole because they ARE the surface: the confirm gate renders
/// the report, and the OS renders the error's own sentence verbatim. Summarising either here would
/// mean the browser showing a paraphrase of a refusal whose exact words are the useful part.
@row
shape packageDeployment packageDeploymentFull {
  row.id
  ownerUserId
  packageId
  sourceVersion
  status
  report
  dslVersion
  deployables
  snapshotArtifactId
  buildLogTail
  error
  requestedBy
  startedAt
  finishedAt
  row.createdAt
}
