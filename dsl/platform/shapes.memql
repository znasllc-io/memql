// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@description("Comprehensive policy-trace projection for v1:platform:policyTrace rows. Backs the policyTracesForPolicy debug query and any operator surface that lists recent policy evaluations.")
shape policyTrace policyTraceFull {
  row.id
  policyName
  tier
  actorUserId
  actorRole
  callerPartition
  argsHash
  resultJson
  traceJson
  durationMs
  error
  row.createdAt
}

@row
@description("Comprehensive configuration variable projection. Used for both v1:platform:partitionVariable (partition-scoped) and v1:platform:globalVariable (global) -- the two concepts share the same field layout, so one shape serves both.")
shape partitionVariable variableFull {
  row.id
  name
  value
  description
  row.createdAt
}

@row
@description("Missing-capability projection for the platform-backlog view + the Planner Agent's lookup-by-(kind, capability) before logging a new sighting. Carries the dedup key (kind, capability) plus the prioritization signals (sightingCount, lastSeenAt, exampleGoals).")
shape missingCapability missingCapabilityFull {
  row.id
  kind
  capability
  description
  requestedFromPlanId
  requestedByAgentId
  partitionId
  partitionScope
  sightingCount
  firstSeenAt
  lastSeenAt
  status
  resolution
  exampleGoals
}

// ---- shapes/v1/platform/outboundRequestFull.memql ----

@row
@description("Full outbound-request projection (memql#2521). Backs the worker's drain scan and any operator/product surface auditing delivery state.")
shape outboundRequest outboundRequestFull {
  row.id
  medium
  target
  subject
  body
  status
  attempts
  lastError
  nextAttemptAt
  sentAt
  dedupeKey
  requestedBy
  row.createdAt
}
