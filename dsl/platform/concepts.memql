// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use accounts.concepts.{ account }
use agents.concepts.{ agent }
use identity.concepts.{ user }
use library.concepts.{ artifact }
use work.concepts.{ approval, run }
use worker.concepts.{ registration }

/// Instance-wide encrypted secret. Lives in the reserved _system partition (via @scope("global")).
/// The cleartext value is NEVER stored -- only a NaCl secretbox ciphertext (base64(nonce||ct))
/// under MEMQL_MASTER_KEY and a short fingerprint for UI display. Used for instance-level API keys,
/// OAuth client secrets, Azure/Graph credentials, etc. For per-tenant overrides (BYOK) use
/// v1:platform:partitionSecret; the resolver falls back partition -> global automatically.
@displayCard(primary="name", secondary="kind", tertiary="fingerprint", status="active")
concept globalSecret {
  name            string!  @description("Secret name (uppercase with underscores by convention).")
  encryptedValue  string!  @secret  @description("Base64-encoded nonce || NaCl-secretbox ciphertext, sealed under MEMQL_MASTER_KEY. Opaque -- never rendered to humans. @secret redacts a rejected value in the function-args validator ONLY, and matches by ARGUMENT NAME, so a mutation writing encryptedValue: args.somethingElse is not covered -- see Concept.SecretFields for the full scope.")
  fingerprint     string!  @description("Last 4 chars of the cleartext, prefixed with '...'. For UI display only; lets operators tell rotated secrets apart without leaking the value.")
  kind            string    @description("Optional tag to group secrets by type. Examples: 'vendor_api_key', 'oauth_secret', 'smtp_password'. Folded router API keys use 'vendor_api_key'.")
  description     string    @description("Human-readable description of the secret's purpose.")
  addedBy         string    @description("Identity subject that wrote the secret.")
  active          bool  @description("When false the resolver skips this row and falls back. Useful for rotating a key without deleting history.")
  lastUsedAt      datetime  @description("Last time the resolver decrypted this secret. Empty until first use.")
  rotatedAt       datetime  @description("Timestamp of the most recent rotation (optional).")
}

/// Instance-wide plaintext configuration variable. Lives in the reserved _system partition (via
/// @scope("global")) and is visible to every tenant. Used for instance-level defaults like provider
/// names, feature flags, log levels, and tuning knobs. For per-tenant overrides use
/// v1:platform:partitionVariable. For sensitive values use v1:platform:globalSecret.
@displayCard(primary="name", secondary="value", tertiary="description", status="active")
concept globalVariable {
  name         string!  @description("Variable name (uppercase with underscores by convention).")
  value        string!  @description("Variable value, always stored as string. Callers parse if they need typed data.")
  description  string  @description("Human-readable description of the variable's purpose.")
  active       bool  @description("When false the resolver ignores this row.")
}

// ---- concepts/v1/platform/globalSecret/seed.memql ----

// (An orphaned `@actor("system")` sat here -- the sole surviving line of the
// retired globalSecret seed file. With no declaration of its own to bind to,
// it floated down onto the NEXT declaration, v1:platform:partitionSecret,
// whose build then failed with `unknown concept annotation @actor` and was
// dropped by the unified loader as a recorded skip. Found while annotating
// that concept's encryptedValue for issue #3181.)

// No default secret seeds. v1:platform:globalSecret rows are populated at
// runtime, not from this concept file:
//   * component/memql.DefaultInjector -- one-time, only-if-absent seed of
//     manifest-listed (scripts/secrets/manifest.yaml) DEFAULTED
//     concept-stored entries, run on every node boot (Epic 7 / memql#2109).
//   * scripts/secrets (Go CLI, `seed --env-file <path>`) -- an operator
//     tool, invoked internally by MemQL's dev-refresh flow, that reads a
//     .env file and upserts manifest-listed entries as v1:platform:global*
//     rows against a running memql.
//   * The setGlobalSecret / setPartitionSecret mutations directly, e.g.
//     from an admin surface.
// `make secrets` (scripts/k3d/seed-secrets.sh) is a DIFFERENT layer: it
// seeds the k8s Secret objects nodes envFrom at boot (MEMQL_MASTER_KEY,
// DATABASE_DSN, TLS certs, ...), not graph rows. Seeding a secret at the
// concept-file level would require committing ciphertext, which requires a
// static MEMQL_MASTER_KEY -- antithetical to per-install keys. Keep this
// file empty.

// ---- concepts/v1/platform/partitionSecret/concept.memql ----

/// Partition-scoped encrypted secret. Holds per-tenant sensitive values (BYOK vendor API keys,
/// per-tenant Twilio/SMTP creds, etc.). Same wire shape as v1:platform:globalSecret, different
/// scope. The cleartext value is NEVER stored -- only a NaCl secretbox ciphertext under
/// MEMQL_MASTER_KEY and a fingerprint. When the partition-scoped resolver (resolveSecret) cannot
/// find a row, it falls back to v1:platform:globalSecret so a tenant's BYOK key wins over the
/// instance default but the instance default is always available.
@displayCard(primary="name", secondary="kind", tertiary="fingerprint", status="active")
concept partitionSecret {
  name            string!  @description("Secret name (uppercase with underscores by convention).")
  encryptedValue  string!  @secret  @description("Base64-encoded nonce || NaCl-secretbox ciphertext, sealed under MEMQL_MASTER_KEY. Opaque -- never rendered to humans. @secret redacts a rejected value in the function-args validator ONLY, and matches by ARGUMENT NAME, so a mutation writing encryptedValue: args.somethingElse is not covered -- see Concept.SecretFields for the full scope.")
  fingerprint     string!  @description("Last 4 chars of the cleartext, prefixed with '...'. For UI display only.")
  kind            string    @description("Optional tag to group secrets by type. Examples: 'vendor_api_key', 'oauth_secret'. BYOK vendor keys use 'vendor_api_key'.")
  description     string    @description("Human-readable description of the secret's purpose.")
  addedBy         string    @description("Identity subject that wrote the secret.")
  active          bool  @description("When false the resolver skips this row and falls back to the global v1:platform:globalSecret.")
  lastUsedAt      datetime  @description("Last time the resolver decrypted this secret. Empty until first use.")
  rotatedAt       datetime  @description("Timestamp of the most recent rotation (optional).")
}

// ---- concepts/v1/platform/partitionVariable/concept.memql ----

/// Partition-scoped plaintext configuration variable. Holds per-tenant non-sensitive overrides
/// (default chat provider, default language, feature flags scoped to a single tenant, etc.). Same
/// wire shape as v1:platform:globalVariable, different scope. When the partition-scoped resolver
/// (resolveVariable) cannot find a row, it falls back to v1:platform:globalVariable so a tenant's
/// override wins over the instance default but the instance default is always available.
@displayCard(primary="name", secondary="value", tertiary="description", status="active")
concept partitionVariable {
  name         string!  @description("Variable name (uppercase with underscores by convention).")
  value        string!  @description("Variable value, always stored as string. Callers parse if they need typed data.")
  description  string  @description("Human-readable description of the variable's purpose.")
  active       bool  @description("When false the resolver skips this row and falls back to the global v1:platform:globalVariable.")
}

// ---- concepts/v1/platform/missingCapability/concept.memql ----

/// A capability the platform itself cannot yet provide -- a missing tool, missing integration,
/// missing liveSource connector kind, missing knowledge domain category, etc. Distinct from
/// the capability-gap signal raised when no agent in the catalog can serve an
/// utterance: missingCapability fires when even creating the right specialist wouldn't solve the
/// problem because the underlying platform surface doesn't exist. Logged by the Planner Agent
/// during its capability-gap detection step before agent creation. Becomes the product backlog --
/// 'these are the things the platform can't do yet that users actually want.' Global-scoped so it's
/// visible across tenants for prioritization.
@displayCard(primary="capability", secondary="kind", tertiary="description", status="status")
concept missingCapability {
  kind            enum("tool", "integration", "liveSource", "connectorKind", "knowledgeDomain", "modelCapability", "other")! @description("What category of platform extension would close this gap. 'tool' = an agent-callable action that doesn't exist yet (e.g. 'sendSlackMessage'). 'integration' = a backing service we don't speak to yet (e.g. Jira). 'liveSource' = a volatile data source we'd want bound to agents but don't have a query for. 'connectorKind' = a brand-new liveConnector implementation kind (e.g. 'snowflake'). 'knowledgeDomain' = a category-level gap, e.g. agents trying to act in a domain we never seeded. 'modelCapability' = a model-level feature we don't support yet (e.g. structured-output with strict schemas on a new provider).")
  capability      string! @description("Short identifier for the missing thing, e.g. 'sendSlackMessage', 'jira.createIssue', 'erp.inventory.live'. Stable across multiple sightings so duplicate signals collapse onto one row.")
  description     string! @description("Human-readable description: what the platform was being asked to do that it couldn't. Surfaced in the product backlog view.")
  requestedFromRunId   string @description("v1:work:run.id where the gap was detected. Lets the platform team trace back to 'what was the user trying to accomplish when we hit this wall'.")
  requestedByAgentId   string @description("v1:agents:agent.id of the agent (typically the Planner Agent) that logged the gap. Empty for system-level detection.")
  partitionId         string  @description("Optional space scope where the gap was detected. Useful for attributing 'this gap blocked work in space X'.")
  partitionScope  string  @description("Partition where the gap was detected. Empty = unknown. Helps de-duplicate platform-wide vs tenant-specific gaps.")
  sightingCount   int @description("How many times this gap has been logged. New sightings of the same (kind, capability) increment rather than creating new rows. Drives 'most-requested capability' prioritization.")
  firstSeenAt     datetime @description("When the first sighting was logged.")
  lastSeenAt      datetime @description("When the most recent sighting was logged.")
  status          enum("open", "in_progress", "resolved", "wontfix") @description("Lifecycle. 'open' = logged, nothing done yet. 'in_progress' = the platform team is working on it (manually set). 'resolved' = the capability shipped; the Planner Agent's next sighting will recreate as a fresh row if it still doesn't work. 'wontfix' = explicit dismissal.")
  resolution      string  @description("Free-text note when status='resolved' or 'wontfix' explaining what shipped (or why we won't ship it).")
  exampleGoals    []string @description("List of Plan.goal strings that triggered this gap. Capped at the most recent N (engine policy); gives the prioritization view 'real users wanted X, Y, Z'.")

  @relationship(type="references", field="requestedFromRunId", target=run, direction="outgoing")
  @relationship(type="references", field="requestedByAgentId", target=agent, direction="outgoing")
}

// ---- concepts/v1/platform/outboundRequest/concept.memql ----

/// A staged outbound delivery (memql#2521): the durable outbox row a product automation or logic
/// body creates when it decides something must leave the cluster (an email, a webhook call). The
/// engine-owned outbound worker drains pending/retrying rows, performs the delivery through the
/// deploy-configured transport (per-medium allowlists, credentials from env/globalSecret -- NEVER
/// from this row), and stamps the status transitions back, so delivery state is ordinary graph
/// state products can query and react to. See docs/internal/design/outbound-delivery-adr.md.
@displayCard(primary="target", secondary="subject", tertiary="medium", status="status")
concept outboundRequest {
  medium        enum("email", "webhook")! @description("Delivery transport. 'email' delivers via the engine email integration (Graph/SMTP/log per deployment). 'webhook' POSTs the payload as JSON to the target URL.")
  target        string! @description("Where to deliver: a recipient email address for medium='email', an absolute URL for medium='webhook'. Must match the deployment's per-medium allowlist or the row fails fast.")
  subject       string  @description("Email subject line. Ignored for medium='webhook'.")
  body          string! @description("What to deliver: the email text body, or the JSON body POSTed to a webhook. Capped by MEMQL_OUTBOUND_MAX_PAYLOAD_BYTES at drain time. Never secret material. (Named body, not payload: shape paths reserve the payload prefix.)")
  status        enum("pending", "sending", "sent", "retrying", "failed") @description("Delivery lifecycle. 'pending' = staged, awaiting the worker. 'sending' = a replica claimed it and is delivering. 'sent' = transport accepted it (sentAt stamped). 'retrying' = a retryable failure; eligible again at nextAttemptAt. 'failed' = permanent failure or attempts exhausted (see lastError).")
  attempts      int @description("Delivery attempts made so far. Incremented on each failure; bounded by MEMQL_OUTBOUND_MAX_ATTEMPTS.")
  lastError     string  @description("Most recent delivery error, truncated to 4KB. Empty on success.")
  nextAttemptAt datetime @description("When a 'retrying' row becomes eligible again (bounded exponential backoff with jitter). Compared Go-side by the worker.")
  sentAt        datetime @description("When the transport accepted the delivery.")
  dedupeKey     string  @description("Optional caller idempotency key, passed through to the receiver (webhook: X-Memql-Dedupe-Key header) so external systems can deduplicate at-least-once redelivery.")
  requestedBy   string  @description("Provenance: which product automation/logic staged this row. Free-form; surfaces in delivery audit queries.")
}

// ---- concepts/v1/platform/inboundRequest/concept.memql ----

/// A verified inbound delivery (memql#2957): the durable inbox row the engine's inbound receiver
/// stages when a third party POSTs to /inbound/{source} and the request passes the deployment's
/// source allowlist and signature check. Product DSL reacts with an ordinary automation on
/// node.created -- no product Go. The counterpart to v1:platform:outboundRequest: outbound is the
/// outbox a product stages and the engine drains, inbound is the inbox the engine stages and a
/// product drains. Credentials are NEVER on this row -- the signing secret lives in
/// env/globalSecret and only the verdict is recorded. See
/// docs/internal/design/inbound-delivery-adr.md.
@displayCard(primary="source", secondary="medium", tertiary="dedupeKey", status="status")
concept inboundRequest {
  source        string! @description("Which allowlisted sender this arrived from -- the {source} path segment, matched against MEMQL_INBOUND_SOURCE_ALLOWLIST. Products filter their automation on it. Never caller-chosen beyond the allowlist: an unlisted source is refused before a row exists.")
  medium        enum("webhook", "mailbox")! @description("How it arrived. 'webhook' is a third party POSTing to /inbound/{source}. 'mailbox' is the Graph NDR reader (memql#4824) staging a delivery-status report it read out of our OWN sending mailbox -- which is why those rows are stamped signatureVerified even though nobody signed anything: provenance IS the verification there, and the field is what gates campaignIngestFeedback. The enum was written with one value and the note that a second inbound transport should not need a concept change; this is that second transport, and it did.")
  body          string! @description("The verified raw request body, exactly as signed. Capped by MEMQL_INBOUND_MAX_BODY_BYTES at receive time -- a larger request is refused with 413 and no row is staged. Never secret material. (Named body, not payload: shape paths reserve the payload prefix.)")
  contentType   string  @description("The request's Content-Type, so a product automation can branch on JSON vs form-encoded without re-sniffing the body.")
  status        enum("received", "processing", "processed", "failed") @description("Product-side handling lifecycle, NOT delivery state -- the delivery already succeeded by the time a row exists. 'received' = staged, awaiting the product automation. 'processing'/'processed'/'failed' are stamped by the product as it works the row.")
  dedupeKey     string  @description("The sender's own idempotency key when it supplies one via MEMQL_INBOUND_SOURCE_<NAME>_DEDUPE_HEADER, otherwise the SHA-256 of the raw body. RECORDED for a product automation to read; it does NOT decide the row id. Identity is the digest of the SIGNED payload, because the vendor signs the body and not this header -- deriving the id from an unsigned header let one captured delivery mint unbounded rows (memql#2957 landing review).")
  signatureVerified bool @description("Whether the HMAC signature was checked and matched. Supplied by the receiver through stageInboundRequest rather than stamped; an absent value reads as false. Only ever true, or false for a source explicitly configured scheme='none'; a FAILED check is refused at the edge and never staged, so this records which sources are running unverified rather than which requests failed.")
  receivedAt    datetime @description("When the receiver accepted the request.")
  processedAt   datetime @description("When the product finished handling the row.")
  lastError     string  @description("Most recent product-side handling error, truncated to 4KB. Empty on success.")
}

/// A web surface this cluster serves at a hostname -- a single-page app, a static website, or the
/// platform's own site. A site is DATA, not infrastructure: deploying one is an upload plus a row
/// write and rolling one back is a row write, so the number of Kubernetes objects does not grow with
/// the number of sites. The graph's own row history IS the version list.
///
/// The COMPOSITE tier -- the owner, OR a cluster owner (memql#4312). It replaced a plain
/// clusterOwner tier when deployables became self-serve (memql#4344), and the reason the old tier
/// gave is the reason the composite is the only form that could replace it. That reason was: a
/// plain owner="ownerUserId" tier has NO cluster-owner escape on the read path -- enforceRowAuthzOnPlan
/// ANDs the owned predicate unconditionally -- so on an owner-tier concept "list every site in this
/// cluster" is not merely unimplemented, it is not EXPRESSIBLE, and the caller silently gets a
/// subset. That query is the Deployables app's primary screen, and cluster-wide hostname uniqueness would be
/// uncheckable for the same reason. The composite keeps BOTH statements true at once: it injects
/// (ownerUserId==actor.userId)||(actor.isClusterOwner==true), so a user reads exactly their own
/// deployables and an operator reads every row in the cluster -- which is what makes "list every
/// site" expressible, and what lets the Go hostname-uniqueness probe see rows it does not own.
/// Going the other way (staying clusterOwner and adding an owner field) would have made every
/// self-serve read return nothing to the user who created the row.
///
/// ownerUserId EMPTY means cluster-owned, and the seeded platform-site row is the case: sameRowAuthzOwner
/// refuses an empty owner outright, so a cluster-owned row is reachable through the admin branch
/// alone -- never by a caller who happens to have no identity resolved.
@rowAuthz(owner="ownerUserId", clusterOwner, account="accountId")
@displayCard(primary="hostname", secondary="kind", tertiary="title", status="status")
concept site {
  ownerUserId  string   @description("v1:identity:user.id that owns this deployable, or EMPTY for a cluster-owned site. Stamped from the actor on create by createSite, which is what makes the tier below true rather than aspirational. A write made as the DEPLOYMENT -- a cluster owner, a system actor, or trusted server-side Go -- has that stamp undone and produces a cluster-owned row instead; the seeded platform site is the one the platform ships that way, and re-running createSite on an existing id is how an operator hands a site over or takes it back. It is the row-authz key: the composite tier compares it against actor.userId and ORs in the cluster-owner branch, so a user reads and writes exactly their own sites while an operator reads every one. NOT `string!` -- an empty value is the meaningful cluster-owned state, and `string!` would refuse the platform-site seed.")
  hostname     string!  @description("Fully qualified host this site answers on, e.g. shop.example.com. Cluster-unique. A USER-owned site must be <slug>.<domain> -- slug [a-z0-9-]{3,40}, not one of the reserved labels (api / identity / mcp / portal / www / admin / mail), and the domain is the one the cluster serves, derived through component/frontdoor rather than supplied. Any other hostname -- a custom apex, a second domain -- is cluster-owner-only, because the cloud front-door certificate names exact hosts (memql#4224) and only the *.<domain> Ingress rule routes without an operator step. It is no longer HAND-certified: a CLIENT's own domain is bound through v1:platform:customDomain (epic memql#4805), which verifies two DNS records and then provisions the exact-host Ingress and Certificate itself -- this field stays the site's OWN hostname either way, and a binding never changes it. Enforced in Go beside the systemOwned-delete refusal (component/memql/platform_site_hostname_policy.go), because neither the slug rule, the reserved list, cluster-wide uniqueness nor an actor-conditional exemption is expressible in a mutation body; the mutation carries the shape half (@pattern / @maxLength).")
  kind         enum("spa", "static", "shopify_storefront")!  @description("Tail of the request-resolution order. 'spa' falls back to index.html so client-side routing works; 'static' answers 404 so a mistyped path in a multi-page site is visible rather than silently rendering the home page. Authored as an open enum rather than a closed one, and the reason is worth keeping even though the case that motivated it did not ship: a third value, 'server', was designed in epic memql#3718 -- bundleRef naming a container image instead of a bundle prefix, reconciled by a narrow controller into a Deployment + Service with the edge proxying to it rather than serving bytes -- and that epic was CLOSED UNBUILT, because its motivation is migrating a customer's existing Rails/Laravel/Django/Express app and no such migration exists. Do not read 'server' as queued work; read it as the demonstration that a new kind is additive here, touching neither the front-door host rules, the TLS model, the platform's own site, the publish path, nor this concept. Whatever the next kind turns out to be, it costs a value and its resolution tail. 'shopify_storefront' (memql#4344) is the demonstration and the first addition: it is a SPA the edge serves at <slug>.<domain>, so its resolution tail is 'spa' exactly, and everything that makes it a storefront rides `binding` and the runtime-config document. Checkout is Shopify's hosted checkout; orders and inventory arrive by webhook, never through the storefront. Android, iOS and macOS deliberately have NO value here (design D5). They are artifact DISTRIBUTION -- stores, TestFlight, notarisation -- not hostname-resolved web surfaces, so there is nothing for the edge to resolve and a value that never resolves would be the wrong kind of additive. The Deployables app shows them as disabled 'coming soon' kinds with no schema behind them. TestSiteKindEnumIsExactlyThreeValues pins this list so the next addition is a decision rather than a drift.")
  bundleRef    string!  @description("URI of the bundle to serve, one of three usages. 'file:///app/os' -- the platform's own site, MemQL OS, baked into the image (it was 'file:///app/portal' until epic memql#4984 retired the portal); deploy and rollback are an image rollout and an image rollback. 'file:///app/sites/<name>' -- a site a monorepo cluster bakes into the edge image at build time (or a working-tree path for the dev inner loop); deploy and rollback are the same image rollout/rollback. 'blob://sites/<id>/<version>/' -- an uploaded bundle in object storage; deploy is an upload plus a row flip in seconds, rollback is one row write. Bake what ships with the cluster; upload what changes on its own clock -- a typo fix on a landing page must not roll the node serving every other site, and marketing copy diverges from engine cadence immediately.")
  status       enum("draft", "live", "disabled", "archived")!  @description("'draft' resolves for nobody (404); 'live' serves; 'disabled' answers 503 rather than 404 so a deliberately paused site is distinguishable from a typo'd hostname; 'archived' (epic memql#4794, D10) is decommissioned and answers 404, because to the internet it is gone rather than paused. NOTE: @default is never applied on insert (memql#2960) -- createSite fills this with ??. The lifecycle is draft -> live <-> disabled -> archived, and ARCHIVE REQUIRES DISABLED FIRST plus a typed-name confirmation the SERVER verifies (updateSiteStatus / archiveSite); a systemOwned row is exempt from the whole axis and refused at the write path. Adding a fourth value was safe only because component/edge stopped listing what does NOT serve and started listing what does -- a serve-by-default switch would have made an archived site keep answering 200.")
  apiProxy     bool     @description("Mount /_memql/* on this origin, forwarded to the bff, so the site is same-origin with its own API. Removes CORS and the SameSite=Lax cookie problem entirely.")
  systemOwned  bool     @description("Blocks deletion. The platform's own site only -- MemQL OS: its row is re-seeded at boot, so an operator cannot brick cluster management by deleting it. Does NOT branch the serving path -- see TestPlatformSiteHasNoSpecialCaseInTheServingPath.")
  title        string   @description("Operator-facing label shown in the site list (MemQL OS, Deployables).")
  notes        string   @description("Operator-facing notes.")
  artifactId   string   @description("The v1:library:artifact row this site's current bundle was published from, when it was published from the Library rather than uploaded by CI or baked into the image. Provenance, not a serving input -- the edge reads bundleRef and never this. Empty for a site whose bundle arrived through POST /sites/{id}/bundles or file:///app/*.")
  binding      object   @description("Per-kind connection to the system this site fronts. Shape is decided by `kind`, and only one kind declares one today: shopify_storefront => {storeDomain, storefrontTokenRef}, where storeDomain is the myshopify.com host and storefrontTokenRef NAMES a v1:platform:globalSecret row holding the Storefront API token -- the token itself is never stored here, and the Admin API token never appears in either field. Empty for spa and static. A Storefront token is a client-side credential by Shopify's design, so the edge resolves the named secret at serve time into the site's runtime-config document; that is the only place it is dereferenced.")
  deleted      bool @description("Soft-delete flag (memql#3717). isNotDeleted filters it out of siteByHostname/sitesAll/siteById so the edge stops resolving a deleted site's hostname; the row survives for history. deleteSite stamps this true. A systemOwned row is refused at the write path regardless of this field -- see the Go guard wired beside executeWrite.")
  packageId    string   @description("The v1:platform:package this site was deployed from (epic memql#4794, D7), or EMPTY for a hand-made site -- which stays fully supported and is the majority of rows today. Set by the pipeline on the FIRST deploy of a package deployable and never cleared, because it is what a redeploy uses to find the site it published last time instead of creating a second one at a second hostname.")
  packageDeployableName string @description("The manifest deployable name this site serves (epic memql#4794, D2/D7). Together with packageId it is the key a redeploy republishes through -- which is exactly why the manifest refuses two deployables sharing a name. Empty whenever packageId is.")

  accountId    string   @description("The v1:accounts:account this deployable is FOR -- the client whose storefront or site this is (epic memql#4800, D5). Optional, and a plain reference with NO read effect: row authorization on this concept is exactly what it was, no query narrows on this field, and a site with no tie resolves, serves and lists precisely as it always has. An account is a record of who work is for, never a visibility scope (D1) -- the pressure to make it one will arrive because a registry of clients looks like a tenancy model, and the answer is that client ACCESS rides the guest-invitation machinery pointed at an account instead. Together with v1:accounts:account.domain this is the whole of what the custom-domains epic consumes from the registry (D9): a site tied to a client suggests that client's own domain when an operator adds one. Set and cleared from the Deployables site detail's account picker.")

  settings     object   @description("Key-values a bundle reads at runtime (epic memql#4906, decision P7): the edge merges them into the site's runtime-config document under `settings`, so a bundle reads `config.settings.apiBase` and one bundle serves two deployables against different endpoints without a rebuild. A flat object of PLAIN STRING values under keys of the form [A-Za-z][A-Za-z0-9_]{0,63}, at most MEMQL_SITE_SETTINGS_MAX_KEYS of them and each value at most MEMQL_SITE_SETTINGS_MAX_VALUE_LENGTH characters -- enforced in Go beside the status guard (component/memql/platform_site_settings_guard.go), because a mutation body sees a value and never an object's keys. NOT A PLACE FOR A SECRET: the document is served to every visitor's browser, unauthenticated, so a value here is public by construction. A key ending in `Ref` is refused so nobody invents a naming convention the edge does not honour -- the storefront binding's storefrontTokenRef on `binding` is the one reference the edge resolves, for exactly one kind. Written whole by updateSiteSettings (a replace, so clearing is expressible); a systemOwned row refuses the write like every other status-class write, because the seed would revert it. Absent and empty read the same: the document carries an empty object.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="deployedFrom", field="packageId", target=package, direction="outgoing")
  @relationship(type="references", as="publishedFrom", field="artifactId", target=artifact, direction="outgoing")
  @relationship(type="references", as="forAccount", field="accountId", target=account, direction="outgoing")
}

/// A client's own domain, bound to one of this cluster's deployables (epic memql#4805).
///
/// The row is the STATE MACHINE. Nothing else holds it: a scheduled sweep reads these rows, does
/// two DNS lookups per non-terminal one, and writes back what it saw; when both checks pass it
/// dispatches an idempotent capability script that applies the exact-host Ingress + Certificate
/// pair. The engine gains NO Kubernetes client for any of it -- an in-engine client-go reconciler
/// would be a second way to touch cluster objects beside the GitOps/script path, which is the exact
/// thing environment-parity review rejects (design D2).
///
/// clusterOwner tier, for the reason v1:platform:packState and v1:platform:site's predecessor both
/// carry it: what a cluster SERVES AT ITS FRONT DOOR is one deployment's fact. Certificate issuance
/// and Ingress objects are cluster-level resources with real rate limits, so v1 automates what was
/// already owner territory rather than widening it (D1). Widening is additive -- the v2 shape is a
/// request-and-approve queue, and it needs no change here.
///
/// ROWS SURVIVE REMOVAL. `remove` walks the row to `removed`; nothing deletes. A binding that once
/// existed is the audit trail of what this cluster was serving and when, and a deleted row answers
/// no question anybody asks after an incident.
@rowAuthz(clusterOwner)
@displayCard(primary="hostname", secondary="siteId", tertiary="failureReason", status="status")
concept customDomain {
  siteId         string!  @description("The v1:platform:site row this domain serves. Required: a custom domain with no deployable behind it is a hostname the edge would resolve to nothing, and the alias step reads exactly this field to answer a request. The relationship below is what canonicalizes it, so a client may pass the bare id.")
  hostname       string!  @description("The client's own fully qualified host, e.g. www.acme.com or acme.com. Cluster-unique across BOTH this concept and v1:platform:site -- the edge resolves one Host to one site, so a second live claim makes which site answers depend on row order. Three things it may NOT be, refused at create by component/memql/platform_custom_domain_policy.go: a hostname under the cluster's own domain (that is slug territory, and createSite already owns it), one of the front-door hosts (api / identity / mcp / os / the apex), or a claim past the per-site maximum. None of the three is expressible in a mutation body -- the domain comes from the environment, the maximum is env-tunable, and the collision needs a read.")
  accountId      string   @description("PROVENANCE, not authorization. Which account this binding was made for, prefilled from the site's own account tie when one exists. Empty is the ordinary state on a cluster whose accounts epic has not landed: the panel degrades to free entry and the binding works identically. Nothing reads this to decide anything -- the tier above is the whole access story.")
  token          string!  @description("The ownership token a client publishes as `TXT _memql-verify.<hostname>`. Minted at create. STORED IN PLAINTEXT and that is deliberate rather than an oversight: the whole point of the value is that DNS publishes it to the world, so hashing it would make the row unable to state the thing the guidance panel has to render. It proves control of the NAME, not of an account -- an attacker who reads it still has to publish it under a domain they do not own.")
  status         enum("pending_dns", "verifying", "issuing", "live", "removing", "removed")!  @description("Where this binding is on its walk. pending_dns: created, nothing seen yet. verifying: at least one check has run and at least one is still failing -- read failureReason for which. issuing: both DNS checks passed and the bind script is applying the Ingress + Certificate. live: the certificate is Ready and the edge resolves the hostname to the site. removing: the unbind script is taking the pair away. removed: terminal, and the row stays. The sweep only ever touches a non-terminal row, so `live` and `removed` cost nothing per tick.")
  failureReason  string   @description("The TYPED reason the last attempt did not advance, or empty. Four values today -- dns_token_missing, dns_not_pointing, no_acme_issuer, issuance_failed -- rendered verbatim by the Domains panel, which is the whole reason the field is typed rather than prose: the panel has to name exactly WHICH record is still wrong, and a free-text sentence composed on the server cannot be keyed on. Not an enum, because a refusal the engine has never seen before must still reach the row rather than being refused by its own schema.")
  failureDetail  string   @description("What the sweep or the bind script actually observed, in the words of whatever produced it -- the value found at the TXT record, the address the hostname resolves to, the capability envelope's error message. The panel renders it BESIDE failureReason, because 'dns_not_pointing' says which record and this says what is in it, and a person fixing DNS needs both.")
  lastCheckedAt  datetime @description("When the sweep last looked. Written on EVERY pass including the ones that change nothing, which is what makes 'checked 40 seconds ago, still not pointing' a different statement from 'nobody has looked'. Deliberately NOT in the panel's arrival-cue fingerprint: it moves for every row on a timer, and fingerprinting it would turn the list into a strobe (clients/os/README.md's heartbeat rule).")
  verifiedAt     datetime @description("When both DNS checks first passed. Empty until they do. Never cleared by a later failure -- an issuance that fails after verification does not un-prove control of the name, and clearing it would restart a walk that is already past that stage.")
  issuedAt       datetime @description("When the certificate first became Ready and the row went live. Empty until then.")
  removedAt      datetime @description("When the unbind completed. Empty on every row that has not been removed; the pair with issuedAt is how long this cluster served the domain.")

  @relationship(type="references", as="servedBy", field="siteId", target=site, direction="outgoing")
}

/// One account's reserved MemQL name, served (epic memql#5168, design D of the access program:
/// docs/superpowers/specs/2026-09-08-per-account-front-door-design.md). A client whose own domain is
/// acme.com reserves memql.acme.com through record A's domain walk, and this row is what turns that
/// reservation into three hosts the cluster actually answers on -- app. for the OS shell, api. for the
/// engine's API edge, id. for sign-in.
///
/// A NEW CONCEPT RATHER THAN FOUR MORE FIELDS ON THE ACCOUNT ROW, for customDomain's own reason: what
/// a cluster serves at its front door is one DEPLOYMENT's fact, and v1:accounts:account sits on a
/// rank-visible tier where a client-rank member can read it. The reservation belongs on the account
/// (it is a fact about the client); the serving belongs here.
///
/// It reuses the custom-domain machinery end to end -- the same DNS resolver, the same six-value
/// status ladder, the same one-transition-per-pass reconciler, the same capability-script provisioner
/// -- and differs in exactly two ways. It checks POINTING ONLY, because record A's TXT walk already
/// proved the parent domain and memqlReservedAt is stamped only on success; and its certificate names
/// THREE hosts, which is what makes activation all-or-nothing without a rule to police (design D8).
@rowAuthz(clusterOwner)
@displayCard(primary="reservedName", secondary="accountId", tertiary="failureReason", status="status")
concept accountFrontDoor {
  accountId     string!  @description("The v1:accounts:account this door is served for. Required, and ONE LIVE ROW PER ACCOUNT: a second door for the same account is a second certificate order for the same three names, which spends a Let's Encrypt rate-limit unit to produce the same result -- and because every object is named after the ACCOUNT, the second door would apply the same five object names over the first's and then have them deleted underneath it by the first's unbind. WHERE THAT IS ENFORCED, precisely: the sweep drops an account from its work list the moment it sees ANY non-removed door for it (integrations/customdomain/accountdoor_reconcile.go, and TestAReservationThatAlreadyHasADoorOpensNothing). It is NOT a Go pre-insert guard -- an earlier version of this description said it was refused in account_domain_validation.go, which was never true: that file guards the account WRITE, and a door is created by the sweep. A pre-insert uniqueness guard is still worth having as the belt to the sweep's braces; it is not here yet, and this says so rather than implying otherwise.")
  reservedName  string!  @description("The name this door serves beneath -- account.memqlDomain as it stood when the door was created, e.g. memql.acme.com. COPIED rather than read through the relationship, and that is the field's whole job: changing an account's domain CLEARS memqlDomain, the token and the verification (record A's resetAccountDomainOnChange), and the reconciler then has to tear down three hosts it can no longer name from the account row. A door that cannot say what it serves is one nothing can unbind.")
  status        enum("pending_dns", "verifying", "issuing", "live", "removing", "removed")!  @description("Where this door is on its walk -- the same six customDomain uses, deliberately, so one vocabulary, one panel grammar and one NonTerminal predicate cover both. pending_dns: created, nothing seen yet. verifying: at least one of the three hosts is not pointing here -- read hostChecks for which. issuing: all three point at the cluster and the bind script is applying the Certificate and the four Ingresses. live: the certificate is Ready and the three hosts answer. removing: the reservation is gone (design D9) and the unbind script is taking the objects away. removed: terminal, and the row stays -- the history is the audit.")
  driftFailures int      @description("How many CONSECUTIVE re-checks a LIVE door has failed, and 0 otherwise. A live door's DNS is re-checked on a slow cadence and demoted to `verifying` after enough sustained failures -- because a door that went live and then had its app. host repointed elsewhere keeps serving, and worse, keeps its callback registered as an OAuth redirect URI. Without the re-check that is a credential-delivery primitive: repoint app.<reservedName> at a server you control, send somebody the cluster's own sign-in link naming that callback, and the auth code arrives at your server through a consent page showing this platform's own name. THE COUNTER EXISTS SO ONE DNS BLIP DOES NOT TAKE A CLIENT'S FRONT DOOR DOWN -- demotion needs sustained drift, not a single unlucky lookup. Reset to 0 by any passing re-check.")
  hostChecks    object   @description("What the last pass saw at each of the three hosts, keyed by role: { app: { ok, reason, detail }, api: {...}, id: {...} }. Activation is all-or-nothing (D8), so this does NOT gate anything -- it exists so the Accounts rail can name WHICH CNAME is still wrong rather than saying three names are not pointing and leaving an operator to test each one. Written on EVERY pass, including the ones that change nothing, for lastCheckedAt's reason. Keys are frontdoor.AccountRoles(), which is where the three labels are spelled.")
  failureReason string   @description("The TYPED reason the last attempt did not advance, or empty. dns_not_pointing, no_acme_issuer and issuance_failed today -- the custom-domain vocabulary minus dns_token_missing, which this concept cannot produce because it runs no ownership check of its own. Not an enum, for customDomain.failureReason's reason: a refusal the engine has never seen must still reach the row rather than being refused by its own schema.")
  failureDetail string   @description("What the sweep or the bind script actually observed, verbatim -- the address a host resolves to, or cert-manager's own condition message while a certificate is issuing. The rail renders it beside failureReason, because the code says which stage and this says what is in the way.")
  lastCheckedAt datetime @description("When the sweep last looked. Written on EVERY pass, which is what makes 'checked 40 seconds ago, still not pointing' a different statement from 'nobody has looked'. Deliberately NOT in the rail's arrival-cue fingerprint: it moves on a timer, and fingerprinting it would turn the stop into a strobe (clients/os/README.md's heartbeat rule).")
  verifiedAt    datetime @description("When all three hosts first pointed at the cluster. Empty until they do; never cleared by a later failure, because an issuance that fails afterwards does not un-prove that the records were created.")
  issuedAt      datetime @description("When the certificate first became Ready and the door went live. Empty until then.")
  removedAt     datetime @description("When the unbind completed. Empty on every row that has not been removed; the pair with issuedAt is how long this cluster served the client's name.")

  @relationship(type="references", as="servedFor", field="accountId", target=account, direction="outgoing")
}

/// Per-instance pack enablement state (module-registry design,
/// docs/superpowers/specs/2026-08-20-module-registry-design.md section 4). One row per pack at the
/// deterministic id v1:platform:packState:<packDomain>; the append-only version history IS the audit
/// trail of flips. ABSENCE OF A ROW MEANS ENABLED, so a pack ships with zero behavior change and a
/// fresh database needs no seeding. Read once per node at boot (app phase 3, after the database
/// starts and before the DSL loaders run); a flip takes effect as each node restarts, and the module
/// inventory reports enabled-vs-loaded honestly in between. A row naming no registered pack domain
/// is reported by the inventory and otherwise ignored.
///
/// clusterOwner tier for the same reason v1:platform:site and v1:campaigns:sendJob carry it: what a
/// cluster RUNS is one deployment's fact, not any individual operator's rows, and "list every
/// pack's state" must be expressible.
@rowAuthz(clusterOwner)
@displayCard(primary="packDomain", secondary="reason", status="enabled")
concept packState {
  packDomain  string!  @description("The registered pack domain this row governs (the RegisterTree name, e.g. 'harness', 'referencepack'). Also the row id's short form.")
  enabled     bool!    @description("Desired per-instance state. false = the pack is mounted-inert on every node's next boot: its namespace stays owned and its concepts (and rows) stay readable, but its queries, mutations, builtins, tools, prompts, automations and Go factories are not loaded.")
  reason      string   @description("Operator note recorded with the flip; shown in the module detail.")
}

/// Virtual projection of one concept's DATA-ORIGINS declaration (epic memql#4378): what MemQL's
/// relationship to that concept's data is. Never persisted -- rows are produced at query time by the
/// `dataOrigins` builtin from the live concept registry, the same shape as v1:router:modelCatalog.
/// Lives in the concept registry so the engine can shape results without a database round-trip.
///
/// This is the INVENTORY half of the Data origins page. The HEALTH half -- backfill cursors, lag,
/// drift counts, outbox depth -- is per-(concept, connector) operational state that accumulates over
/// time and is a persisted row instead. Serving both from one place would make a staleness bug in
/// either look like the other.
@displayCard(primary="conceptId", secondary="dataState", tertiary="origin")
concept dataOrigin {
  conceptId   string!  @description("Canonical id of the concept this row describes. Also the row id -- there is exactly one row per concept and the concept is what it is about. Named conceptId rather than concept because `concept` is a reserved row intrinsic; a payload field by that name is refused at load.")
  dataState   enum("mirror", "origin", "native")!  @description("MemQL's relationship to this concept's data. mirror: an external system owns it and MemQL holds a faithful read-only copy. origin: MemQL owns it and pushes changes out to the systems in mirroredTo. native: MemQL owns it and nobody else has a copy. There is no fourth state -- two systems both authoring one domain is the option the model rejects.")
  origin      string!  @description("The system where changes to this concept are made. Never empty: a concept that declared nothing reports \"memql\", so no client re-derives the default. Not to be confused with a CONSTRUCT's origin, which is where its source file lives.")
  mirroredTo  []string  @description("External systems MemQL pushes this concept's changes out to. Empty unless dataState is \"origin\".")
  connectors  []string  @description("Every connector name this concept depends on -- its external origin plus every mirror target, sorted. Never contains \"memql\": MemQL is not a connector. This is the set the engine resolves at boot, and an unresolvable name refuses it.")
}

/// Virtual projection of one AI PROVIDER's auth state on THIS node (epic memql#4440). Never
/// persisted -- rows are produced at query time by the owner-only `providerAuthStatus` builtin from
/// the live provider registry, the same shape as v1:platform:dataOrigin and v1:router:modelCatalog.
///
/// PER-NODE, and that is the point rather than a limitation. Provider auth resolves once per
/// process at boot, so two replicas genuinely can disagree -- one restarted after a key was seeded
/// and one not. That disagreement is the single most useful thing this read surfaces, and it is why
/// `providersReload` broadcasts instead of acting on whichever replica the front door picked.
///
/// NO CREDENTIAL, AND NO FINGERPRINT OF ONE. `authSource` names a TIER, never a value. The page
/// never reads a key back; "is this key good" is answered by `providerVerify` making a live call,
/// not by comparing against something rendered here.
@displayCard(primary="name", secondary="vendor", tertiary="authSource", status="available")
concept providerAuthStatus {
  name        string!  @description("The DSL provider entry's name. Also the row id -- there is exactly one row per provider and the provider is what it is about.")
  vendor      string!  @description("The provider TYPE the DSL declares (OpenAI, AnthropicChat, ...), which is what selects the Go client.")
  model       string   @description("The vendor model id this entry pins. Empty only for an entry that declares none.")
  available   bool!    @description("Whether THIS node can call it right now. False is the ordinary state of a freshly installed cluster: installing spends no inference and asks for no key, so every provider registers unavailable until one is configured in Settings -> AI providers (MemQL OS).")
  authSource  enum("federation", "globalSecret", "globalVariable", "env", "unresolved")!  @description("Which tier of the resolution chain supplied the credential. federation: Anthropic workload identity, no key at rest anywhere. globalSecret: an encrypted row -- what Settings -> AI providers writes. globalVariable: a plaintext row; right for a baseURL or a federation id, wrong for an API key. env: this pod's environment, the one source an in-app write cannot change. unresolved: nothing configured. Re-resolved at read time, so a key seeded since boot reads as globalSecret before a reload -- which is exactly the \"seeded, not yet applied\" state an operator is in between Save and Apply.")
  reason      string   @description("Why it cannot be called, in the words of the constructor that refused -- which already names the missing variable or the half-configured federation set. Empty when available.")
}

/// The cluster's ACTIVE embedder, at the literal row id `active` (epic memql#5137, D6).
///
/// WHY A BINDING AT ALL. The embedding model was the string "embedding3Small" in five files and
/// `node_vectors` was declared `vector(1536)` -- that model's width, written into the schema. So the
/// cluster could only ever embed with one paid OpenAI model: changing it meant editing five files
/// AND a migration, and doing either without the other produced a table full of vectors of the wrong
/// width. That is not an error anywhere. It is a search space that quietly returns wrong neighbours.
///
/// THE LITERAL ID IS LOAD-BEARING, the same way v1:cluster:database's is (memql#4766). A re-write is
/// then a new VERSION of one logical row rather than a second row, so "which embedder is active" has
/// exactly one answer to read -- and a query that returned two would have no way to choose.
///
/// SWITCHING IS NOT AN EDIT. Activating a different embedder opens the `reembedLibrary` work goal,
/// which fills a new node_vectors_<dims> table and flips this row only when the counts match. Until
/// then every read follows the binding that is still active, so a switch interrupted half way leaves
/// a cluster that still works rather than one whose vectors half mean one thing and half another.
///
/// TIER: public, requiresIdentity, and the row-authz land gate is what settled it. The first cut said
/// clusterOwner, on the reasoning that the embedder is a property of the DEPLOYMENT rather than of a
/// person -- which is true, and is an argument about ownership, not about secrecy. There is nothing
/// here to protect: a model id, a vector width, and when it changed. Meanwhile a person wondering why
/// their search results changed shape has exactly one row that explains it, and hiding it from
/// everyone but the owner would make that unanswerable for the people most likely to ask.
///
/// v1:platform:inferenceStatus and v1:models:modelProfile carry the same tier for the same reason.
/// WRITING is a different question and is settled separately: both mutations are @serverOnly,
/// because activating a binding is four ordered steps and not a write.
@rowAuthz(public, requiresIdentity)
@displayCard(primary="providerRef", secondary="dimensions", tertiary="activatedAt")
concept embedderBinding {
  providerRef   string!  @description("A provider record name (embedding3Small) or a fleet reference (fleet:qwen3-embedding:0.6b). Resolved through the same registry path every other provider name takes, so a fleet embedder is resolved against the ACTING USER's machines exactly like any other fleet call.")
  dimensions    int!     @description("The vector width this provider produces, and therefore which node_vectors_<dims> table its vectors live in. NEVER ZERO on a valid binding: a width of zero cannot have a table and cannot have an index, and pgvector refuses both rather than accepting them quietly. For a fleet model the width comes from the catalog row, because the machine serving it does not know it either.")
  activatedAt   datetime @description("When this binding became active. Empty on a row written by an activation that has not completed -- the re-embed is still filling the new table, and until it does this row is a plan rather than a state.")
  reembedRunId  string   @description("The v1:work:run that filled this binding's table. Empty for the FIRST binding a cluster activates, which has nothing to re-embed FROM -- an absence that means 'nothing to carry over', never 'the run is missing'.")
  previousRef   string   @description("The providerRef this binding replaced, kept so an operator reading the row can see what the search space used to be. A vector corpus is not reversible from the vectors, so the only record of what produced them is this.")

  // `as="filledBy"` is a DOMAIN verb, not a structural type: the run did not
  // create the binding and does not own it -- it filled the vector table the
  // binding names. `references` is what the engine does with the edge.
  @relationship(type="references", as="filledBy", field="reembedRunId", target=run, direction="outgoing")
}

/// Virtual projection of ONE MODEL the caller's fleet can run right now (epic memql#4676). Never
/// persisted -- rows are produced at query time by the `fleetModels` builtin from live worker
/// registrations, the same shape as v1:platform:dataOrigin and v1:router:modelCatalog.
///
/// NEVER PERSISTED, and here the reason is at its sharpest. The answer is which machines are AWAKE
/// right now, so a stored copy could only ever be a second, staler answer -- and its staleness
/// would be indistinguishable from the very condition it describes. A row written four minutes ago
/// saying "llama3.1:8b is available" describes a closed laptop exactly as confidently as an open
/// one.
///
/// SCOPED TO THE CALLER. A model call carries the caller's prompts and routes only to their own
/// machines (memql#4678), so a catalog showing somebody else's would promise a model the router
/// will never use -- and would enumerate another user's hardware besides. What this read returns is
/// the caller's own machines PLUS the shared-inference set, which every user may legitimately reach
/// for cluster work because their owners opted them in.
///
/// ATTRIBUTES ARE THE UNION over the machines behind a model: if one machine can do structured
/// output, the model can, because a call needing it routes there. The intersection would hide a
/// capability the fleet actually has whenever one machine under-reports.
@displayCard(primary="modelId", secondary="machineCount", tertiary="contextWindow", status="online")
concept fleetModel {
  modelId           string!  @description("The runtime-facing model id, exactly as the machine advertised it (llama3.1:8b). Also the row id -- there is one row per model and the model is what it is about. The router selected on this exact string, so no translation happens anywhere between the cockpit and a policy naming fleet:<modelId>.")
  contextWindow     int      @description("Largest context window any machine behind this model advertises, in tokens. Zero means no machine said, which does not meet any floor -- the fail-closed direction, because a guessed window fails as a truncation three layers away that names nothing.")
  structuredOutput  bool!    @description("Whether at least one machine can honour a response schema for this model. False is what keeps a conductor or planner turn away from a model that would answer prose to a structured prompt -- a parse failure with no readable cause.")
  embeddings        bool!    @description("Whether at least one machine produces vectors for this model.")
  params            int      @description("The model's parameter count as the runtime reported it, expanded to a number (Ollama's details.parameter_size: \"8B\" -> 8000000000). MAX across the machines behind the model, for the reason every capability here is a union: a machine that under-reports must not shrink a model the fleet demonstrably runs at full size. It is an ORDERING signal and never a capability gate -- fleet:* picks the strongest ELIGIBLE model, and a model that never said how big it is stays eligible for everything it advertised, it simply does not WIN by silence (design D5). Zero means no machine said.")
  quant             string   @description("The quantization level the runtime reported (Q4_K_M, F16), from the first machine that reported one. Operator-facing only: nothing selects on it, because two quantizations of one model are the same model to a caller and ordering by a string nobody agreed on would be an arbitrary preference wearing a technical name.")
  tools             bool!    @description("Whether at least one machine behind this model can carry a TOOL-CALLING turn -- tool schemas in, tool calls out (epic memql#5096). It is a RUNTIME capability as much as a model one: the same weights behind an endpoint that does not implement the tools field cannot do it, which is why it is advertised per machine rather than inferred from the model id. False keeps a tool turn away from a model that would answer prose to it, which surfaces three layers away as an agent that appears to have stopped using its tools.")
  vision            bool!    @description("Whether at least one machine behind this model can carry a VISION turn -- chat messages with image parts in, text out (epic memql#5137, D4). A union across machines, like every capability here, and a RUNTIME capability as much as a model one: the same weights behind an endpoint that does not implement image parts cannot see. False keeps a vision turn away from a machine that would fail it four layers from the selection.")
  audioIn           bool!    @description("Whether at least one machine behind this model can TRANSCRIBE -- audio bytes in, text with timestamps out. The local door for hold-to-talk; before this the fleet wire carried chat and embedding only, so transcription had to reach a paid vendor or not happen.")
  audioOut          bool!    @description("Whether at least one machine behind this model can SPEAK -- text in, audio bytes out. Served by a small separate runtime (Kokoro) rather than by Ollama, which is why it is advertised per machine and not inferred from the model.")
  imageGen          bool!    @description("Whether at least one machine behind this model can GENERATE IMAGES. Ollama's image generation is experimental and macOS-only as of 2026-01, so this is false on most fleets and the Fleet page says which of the three reasons applies rather than leaving a blank.")
  online            bool!    @description("Whether at least one machine behind this model is reachable now. A model whose only machine is asleep stays LISTED and reports false: the operator's question is why it is not being used, and an entry that vanished answers with silence.")
  machineCount      int!     @description("How many machines advertise this model at all.")
  onlineCount       int!     @description("How many of them are reachable now.")
  machines          []object @description("One entry per machine: {registrationId, name, displayName, runtimes[], online, busy, activeCount, maxConcurrent, memoryGb, platform}. `busy` is against the ceiling the machine DECLARED for this model; a machine that declared none is never busy, because it asked for no limit and the limit is not the thing to describe it by. `memoryGb` and `platform` are what the machine IS rather than what it is serving, and they are here so the catalog can CHECK a model's minMachineClass floor -- before memql#5195 no field carried either, so the floor was compared against a fleet size nothing reported and was never checked on any fleet. `memoryGb` is UsableGigabytes: VRAM on a discrete card, 75 percent of the pool on unified memory, and ZERO MEANS THE COCKPIT HAS NOT REPORTED rather than a machine with no memory. `platform` is normalized to the CATALOG's vocabulary (macos | linux), not the machine's GOOS, so offeredOn compares catalog words against catalog words.")
}

/// Virtual SINGLE-ROW answer to "can this caller get inference at all, and through which door"
/// (epic memql#4676, design G). Never persisted. The first-run gate reads it.
///
/// ONE ROW BECAUSE IT ANSWERS ONE QUESTION. The gate needs an answer, not material to compute one
/// -- and eligibility computed in a client is a second implementation that drifts from the one the
/// router actually applies. Every input is named on the row anyway, so a person looking at a gate
/// they do not understand can see exactly what it read.
@displayCard(primary="eligible", secondary="localModelCount", tertiary="minimumContextWindow")
concept inferenceStatus {
  eligible                 bool!    @description("Whether ANY door is open. This is what the first-run gate branches on.")
  streamingChatEligible     bool     @description("Whether this caller has a usable plain streaming chat door for Ask: an online non-embedding fleet model meeting minimumContextWindow, a runnable app that implements plain streaming chat, or an available federated plain streaming chat provider. Read from the caller's own and shared fleet catalog even on query nodes without local worker dispatch. Does not guarantee a particular prompt fits or a call succeeds; routing applies the actual call's needs and policy.")
  doorsOpen                []string @description("Which of local | app | federation are currently usable, IN THE ORDER THE DEFAULT CHAIN TRIES THEM: a local model, then an app the person already pays for, then federation. The order is part of the answer, so a client renders the list rather than re-deriving one. Empty means the gate has something to ask for. There was a fourth, apiKey, and it went with the vendor keys in epic memql#5088: a cloud vendor is reached by workload identity federation or not at all. Note four DOORS, three NAMES -- both vendors federate and the row does not say which one answered.")
  localEligible            bool!    @description("Whether an online fleet machine advertises a model meeting the MINIMUM CAPABILITY PROFILE: structured output plus the context floor. Deliberately not 'any model at all' -- a fleet whose only model cannot do structured output would pass a naive gate and then refuse every conductor turn, which is a worse place to put a person than the door they were on.")
  localModelCount          int!     @description("How many models the caller's fleet offers, eligible or not. Separates 'you have no machines' from 'your machines run nothing that qualifies'.")
  eligibleModelIds         []string @description("The models that met the profile, so the gate can say which one it is about to use.")
  appEligible              bool!    @description("Whether at least one subscription app (Claude Code, Codex) is allowed, signed in and online on a machine whose stream the replica answering this request holds (epic memql#5096). The replica qualifier is real rather than pedantic: the app-session envelope has no cross-node forward yet, so a machine on a sibling replica is skipped during selection -- and a status row that claimed the door was open would be describing a door this node cannot walk through.")
  runnableApps             []string @description("The app ids behind appEligible, so a surface can say which one it is about rather than only that there is one.")
  appSessionsInstalled     bool!    @description("Whether the node answering this request can open app sessions at all. The app door's twin of fleetInferenceInstalled, and the same distinction: 'you have signed into nothing' and 'this node has no worker service' look identical on a page and have entirely different fixes.")
  cloudConfigured          bool!    @description("Whether any paid provider is configured and callable on this node -- which since epic memql#5088 means a FEDERATED one, there being no other kind. Reported because the park card's cloud-approval affordance keys on it and the Models section uses it to explain why the last door is shut; it is not a door of its own, because a callable cloud provider is a federated one and federation is already a door.")
  federationConfigured     bool!    @description("Whether Anthropic workload identity federation is fully configured (memql#4333). Read through the same predicate the AI providers page reads, so the two cannot disagree about whether a door is open.")
  fleetCatalogInstalled    bool     @description("Whether this node can read the shared graph projection of the caller's available fleet models. Does not imply a local worker dispatcher; public query nodes read the same catalog as agent nodes.")
  fleetInferenceInstalled  bool!    @description("Whether the node answering this request can place fleet model calls at all. Distinguishes 'your machines are asleep' from 'this node has no worker service' -- identical from a page, entirely different fixes.")
  minimumContextWindow     int!     @description("The context floor localEligible applied, published so the gate's recommendation and its check cannot drift. It is a floor for the GATE; what enforces capability per CALL is the catalog gating the router applies.")
}

/// Virtual single-row RESULT of an owner-only `providersReload` (epic memql#4440). Never persisted:
/// an action's outcome is a reply, not a record. What IS recorded is the v1:identity:auditEvent line
/// naming who asked.
@displayCard(primary="requestId", secondary="availableOnThisNode")
concept providersReloadResult {
  requestId            string!  @description("Ties every node's log line back to one Apply. Also the row id. Generated by the engine when the caller supplies none.")
  availableOnThisNode  int!     @description("How many providers are callable on the node that HANDLED the call, after its reload. Named so it cannot be mistaken for a fleet-wide number: the other replicas reload asynchronously off the broadcast, and their answer comes from re-reading providerAuthStatus.")
  registered           int!     @description("How many entries that node holds in total, callable or not. A keyless cluster registers every provider and can call none, so the two numbers differ by design.")
  broadcast            bool!    @description("Whether the reload request was published to the mesh. False would mean this node has no event bus, and the other replicas were not told.")
}

/// Virtual single-row RESULT of an owner-only `providerVerify` (epic memql#4440): whether ONE live,
/// token-free call to the vendor was accepted using the credential THIS node resolved.
///
/// A REJECTED KEY IS A RESULT, NOT AN ERROR -- verified=false carrying the vendor's own words. The
/// distinction matters to the page: a refusal is something to show the operator in place, and an
/// error is an exception dialog about a question that could not be asked.
@displayCard(primary="provider", secondary="authSource", status="verified")
concept providerVerifyResult {
  provider      string!  @description("The provider entry that was verified. Also the row id.")
  vendor        string!  @description("The provider TYPE, which decides how verification is performed. Only Anthropic has a live check today; anything else reports that plainly rather than claiming a pass it did not observe.")
  model         string   @description("The vendor model id this entry pins.")
  authSource    enum("federation", "globalSecret", "globalVariable", "env", "unresolved")!  @description("Which tier supplied the credential that was tried, so a pass or a failure can be attributed to the right place. Same values as v1:platform:providerAuthStatus.authSource.")
  verified      bool!    @description("Whether the vendor accepted the credential. False with a reason covers both \"the vendor said no\" and \"this node has no usable client\" -- the reason tells them apart, because the second never reached the vendor and must not read as a rejection.")
  reason        string   @description("Why verification did not pass, in the vendor's or the constructor's own words. Empty when verified.")
  modelsListed  int      @description("How many models the check listed. Present only on a pass; the call spends no tokens, which is what makes Verify pressable as often as an operator likes.")
}

/// Virtual single-row RESULT of seeding AI provider configuration from Settings (epic
/// memql#4440) -- `providerFederationSet`. Never persisted.
///
/// THERE IS NO VALUE FIELD, AND THERE IS NO READ-BACK CONSTRUCT. Nothing written through this
/// path is a credential any more (epic memql#5088 removed the key-sealing sibling along with
/// every manually entered vendor key): what an operator supplies is a set of federation ids,
/// and what comes back is the row NAMES the resolver will try. "Is this configuration good" is
/// answered by `providerVerify` making a live call, not by showing an operator what they typed.
@displayCard(primary="name", secondary="vendor", tertiary="fingerprint")
concept providerConfigResult {
  name         string!  @description("The row name written, which is the exact name the auth resolver tries. Also the row id. The VENDOR is what the caller chooses; this name is derived, so a mistyped name the resolver never tries is not a state an operator can reach.")
  vendor       string!  @description("Which vendor the configuration is for.")
  fingerprint  string   @description("Four characters derived from the sealed value, enough to tell two keys apart and useless for reconstructing either. Empty for federation, which seals nothing.")
  applied      bool!    @description("Always false: seeding does not reload. Present rather than implied, because \"saved\" and \"in force\" are the two states an operator most needs told apart -- a key that is saved and not applied is doing nothing, and the page says so.")
  written      []string  @description("Which variable names a federation write actually created. Empty for a key write. An omitted optional (the workspace id) writes no row at all rather than an empty one -- the resolver reads \"\" as absent, so an empty row would mean nothing and shadow nothing.")
  message      string   @description("What the operator should do next, in one sentence.")
}

/// One pending outbound delivery for an ORIGIN concept (epic memql#4378, D5). MemQL owns the data;
/// an external system holds a mirror of it; this row is the durable record that a change has to
/// reach that system. Appended by the engine in the SAME TRANSACTION as the row write, one entry
/// per @mirroredTo target, and drained by that connector's worker.
///
/// The append is transactional because the alternative is a change that MemQL believes it
/// propagated and the mirror never heard of. A write that fails writes no entry; an entry that
/// exists names a row write that committed.
///
/// clusterOwner: the queue is one deployment's operational state, not any user's rows, and "how
/// deep is the outbox" has to be answerable. The drain worker reads it under the engine's own
/// operator identity -- the campaigns precedent.
@rowAuthz(clusterOwner)
@displayCard(primary="conceptId", secondary="target", tertiary="rowRef", status="status")
concept outboxEntry {
  conceptId       string!  @description("Canonical id of the concept whose row changed. Named conceptId because `concept` is a reserved row intrinsic.")
  rowRef          string!  @description("Id of the row that changed. Not named rowId to keep it clearly a reference rather than this entry's own id.")
  action          enum("upsert", "retire")!  @description("What happened to the row. MemQL has no hard delete -- a retirement is an append that marks the row gone -- so `retire` is a flag on a change rather than a separate verb.")
  version         string!  @description("The row's version AFTER the change. Half of the idempotency key, and what lets a receiver discard a replay.")
  target          string!  @description("Connector name this entry is destined for -- one of the concept's @mirroredTo targets. Present even though the worker is per-connector, because an entry that cannot say where it is going is unauditable.")
  status          enum("pending", "delivering", "delivered", "failed", "dead")!  @description("pending: waiting for a worker. delivering: claimed by one. delivered: the receiver has it. failed: a delivery attempt failed and nextAttemptAt says when to retry. dead: attempts exhausted -- the operator queue, never retried automatically.")
  attempts        int      @description("How many delivery attempts have been made. Compared against MEMQL_SYNC_OUTBOX_MAX_ATTEMPTS to decide dead.")
  nextAttemptAt   datetime @description("Earliest time a worker may try again. Set on every failure from the backoff schedule; a worker skips entries whose time has not come.")
  lastError       string   @description("Truncated error from the last failed attempt. Never a payload body -- the runtime does not log those.")
  idempotencyKey  string!  @description("(conceptId, rowRef, version, target), rendered once by the engine so every attempt at this entry presents the same key to the receiver. This is what makes a redelivery arrive once.")
  deliveredAt     datetime @description("When the receiver accepted it. Set once; a redelivery that the receiver recognises does not move it.")
}

/// Per-(concept, connector) SYNC HEALTH (epic memql#4378, D7). Health is a ROW, not a log line: an
/// operator asking "is the Shopify mirror current" needs an answer that survives a restart and can
/// be read from a page, not a grep over one replica's stdout.
///
/// Written ONLY by the sync runtime -- the inbound dispatcher, the backfill and reconciliation
/// runners, and the outbox drain worker. Deterministic id per (concept, connector, direction), so
/// the append-only version history IS the health timeline.
///
/// clusterOwner for the same reason outboxEntry is: this is the deployment's operational state.
@rowAuthz(clusterOwner)
@displayCard(primary="conceptId", secondary="connector", tertiary="direction", status="backfillStatus")
concept syncState {
  conceptId        string!  @description("Canonical id of the concept this row reports on.")
  connector        string!  @description("Connector name on the other side.")
  direction        enum("inbound", "outbound")!  @description("inbound: MemQL mirrors this concept and the connector fills it. outbound: MemQL originates it and the connector drains the outbox. A concept can have a row in each direction.")
  backfillCursor   string   @description("Opaque connector cursor for a resumable backfill. Persisted after EVERY page, so a restart resumes rather than restarts.")
  backfillStatus   enum("none", "running", "complete", "failed")  @description("Where the backfill stands. `none` is the default -- never run -- and is distinct from `complete`.")
  lastInboundAt    datetime @description("When the last inbound delivery for this domain was applied.")
  lagSeconds       int      @description("Seconds between the origin's version of the last applied write and when MemQL applied it. A mirror's staleness, in the only unit an operator can act on.")
  lastReconcileAt  datetime @description("When the last reconciliation sweep finished.")
  driftCount       int      @description("Rows the last sweep found disagreeing with the origin. Zero after a clean sweep; non-zero is the number worth investigating even after healing, because repeated drift is a webhook that is not arriving.")
  outboxDepth      int      @description("Pending + failed entries for this (concept, connector). The number that says whether the drain is keeping up.")
  deadLetterCount  int      @description("Entries that exhausted their attempts and are waiting for an operator. Never decreases on its own.")
  paused           bool     @description("Operator pause switch. Stops the backfill and reconciliation runners and the drain for this domain, without unregistering the connector or changing any declaration.")
  lastError        string   @description("Truncated error from the last failure on this domain, whichever runner produced it.")
}

// ---- packages (epic memql#4794) ----

/// A PERSON'S credential for reading a private source (epic memql#4885, D10). One row is one token
/// on one host, sealed once, server-side, and named by the packages that fetch under it.
///
/// It replaces the cluster-wide globalSecret a package used to NAME: any package owner could name
/// any secret, so the fetcher could be made to fetch under an owner's token by whoever knew the
/// name. Here the credential belongs to the person, the composite tier decides who reads it, and
/// the fetcher resolves it under the PACKAGE OWNER's actor -- so a package naming somebody else's
/// credential resolves zero rows and is refused by name, before any request leaves the cluster.
///
/// The COMPOSITE tier, for the reason v1:platform:site and v1:platform:package record: a plain
/// owner tier has no cluster-owner escape on the read path, so "every credential in this cluster"
/// would not be EXPRESSIBLE and an operator would silently read a subset. A cluster owner reads
/// every row's METADATA -- host, label, fingerprint, last used -- which is the oversight the tier
/// exists for, and can decrypt none of it from a browser: `sourceCredentialCard` projects everything
/// but the ciphertext, and decryption happens only inside a fetch.
///
/// A REVOKED ROW IS NEVER DELETED. It is the audit history of what fetched under it -- every
/// deployment whose source arrived through this token is a fact about this row -- and a deleted
/// row answers no question anybody asks after an incident. Revocation flips `status` and stamps
/// `revokedAt`; rotation is adding a new credential and switching a source to it.
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="label", secondary="host", tertiary="fingerprint", status="status")
concept sourceCredential {
  ownerUserId     string    @description("v1:identity:user.id of the person this credential belongs to. Stamped from the actor by the writer (createSourceCredential), never accepted from an argument -- it is the row-authz key the composite tier compares against actor.userId, and a caller-supplied value would record a guarantee nothing provides. NOT `string!`, for the reason its siblings are not: the declaration form is shared, and an empty value is the meaningful cluster-owned state even though nothing writes one here.")
  kind            enum("token", "github_app")  @description("How this credential was obtained, and therefore what the engine may do with it. `token` is a value a person pasted; `github_app` is an authorization grant from the GitHub App, whose `encryptedValue` is a user token the engine refreshes and whose background work runs on installation tokens minted from the app's private key instead. NOT `string!` and DELIBERATELY not required: every row written before Connect existed carries no value, and an ABSENT kind must read as `token` -- the pre-Connect behaviour, the reading that asserts least. A row is never rewritten to add it.")
  host            string!   @description("The host this token authenticates against. `github.com` today, and the only value sourceCredentialCreate admits; the probe and the fetcher match on it, so a credential can never be presented to a host it was not minted for.")
  label           string!   @description("The person's own name for it -- 'work laptop', 'acme deploy key'. Display only; nothing keys on it.")
  encryptedValue  string!  @secret  @description("Base64-encoded nonce || NaCl-secretbox ciphertext of the token, sealed under MEMQL_MASTER_KEY by component/secret.Encrypt on the node that received it. Opaque -- never rendered to humans, never projected by a client-readable shape, and unsealed only inside a fetch into a local that dies with the call. @secret redacts a rejected value in the function-args validator ONLY, and matches by ARGUMENT NAME, so a mutation writing encryptedValue: args.somethingElse is not covered -- see Concept.SecretFields for the full scope.")
  fingerprint     string!   @description("The last four characters of the token, prefixed with '...', for telling two credentials apart in a list without revealing either. Display only.")
  status          enum("active", "revoked")!  @description("'active' fetches; 'revoked' refuses every fetch and poll under it with credential_revoked, and the row stays. The transition is one-way: a revoked credential is not reactivated, a new one is added.")
  lastUsedAt      datetime  @description("When the fetcher or the poll last unsealed this credential. A HEARTBEAT stamped by the engine on every fetch and every poll, and it must never enter an arrival-cue fingerprint: a surface that re-fired on it would announce a change every time a scheduled poll ran, which is exactly the 'a heartbeat is not news' failure clients/os/README.md names. Empty until the first use.")
  revokedAt       datetime  @description("When it was revoked. Set by revokeSourceCredential and never cleared; the row is never deleted. Read it only alongside `status`: a grant that was disconnected and then reconnected is `active` and still carries the timestamp of the last disconnect, because a datetime cannot be cleared and the fact is true history rather than current state.")

  login           string    @description("The GitHub login the grant belongs to -- what 'Connected to GitHub as @octocat' says. Display only, and re-read from GET /user on every connect, so a rename follows: the STABLE key is externalId, never this. Empty for kind='token'.")
  externalId      string    @description("The GitHub user id (a number, stored as text). The stable key a reconnect updates IN PLACE, which is what stops a person accumulating one row per connect and what makes a rename a no-op. Empty for kind='token'.")
  refreshToken    string  @secret  @description("Base64-encoded nonce || NaCl-secretbox ciphertext of the OAuth refresh token, sealed exactly as `encryptedValue` is. A user token expires in eight hours and this is how the engine mints the next one WITHOUT sending the person back through the browser; the refresh token itself lasts six months, after which reconnecting is the only repair and the fetch says so by name (reconnect_required). Projected by no client-readable shape, for the reason `encryptedValue` is not.")
  expiresAt       datetime  @description("When the user token in `encryptedValue` stops working. Compared before a user-scoped call and refreshed server-side when it has passed; never a reason to refuse on its own, because a refresh is the ordinary path and only its failure is news.")
  installationIds []string  @description("The GitHub App installations this grant can reach, read from GET /user/installations at connect and kept current by `installation` and `installation_repositories` webhooks. It is what makes 'the app is not installed on that repository' answerable as repository_not_installed with an installation link, instead of arriving as a 404 the fetcher would have to read as 'private, or not there'. Empty for kind='token', and empty for a grant whose only installation is still awaiting an organization owner's approval -- a pending installation is not a reachable one.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
}

/// A TRACKED SOURCE this cluster can deploy: a memql-project-shaped tree that arrives either as a
/// Git repo or as a zip of exactly the same tree (D1). The two forms are interchangeable and
/// equally validated, which is why `sourceKind` discriminates provenance and nothing else -- every
/// rule downstream of the fetch reads one tree.
///
/// Nothing becomes a package by claiming to be one: an analysis decides, offline, before anything
/// deploys (D12, component/packages). A row exists here because an analysis of that source has
/// already succeeded at least once.
///
/// The COMPOSITE tier, for the reason v1:platform:site records at length: a plain owner tier has no
/// cluster-owner escape on the read path, so "list every package in this cluster" would not be
/// EXPRESSIBLE and an operator would silently read a subset. The composite keeps both statements
/// true -- a person reads their own packages, an operator reads every one.
///
/// AND THE ACCOUNT ARGUMENT, which is a DEPARTURE from the accounts rule and is recorded as one
/// (memql#5303, design 2026-09-11-app-access-grants D12). The rule -- "an account is a record of
/// who work is for, never a visibility scope" (accounts D1) -- holds for campaigns, and it held
/// here until this line. v1:platform:site left it in epic memql#5165, when `account="accountId"`
/// became an argument of the owned tier: a person whose group ties them to the account this row
/// names reads it, and may write it if their role holds the verb, without owning it. This finishes
/// that departure for deployables. A package and its runs are what a client's people, and the
/// cluster's own, work on together, and the alternative -- every deployable visible to exactly its
/// creator and the operator -- was two people on one cluster unable to see each other's. Developer
/// rank and above are standing members of every account-kind group by rule, so the staff read every
/// TIED package; an untied one stays its owner's and the operator's, exactly as before. The compose
/// flow ties a new package to the cluster's own account (`v1:accounts:account:self`) unless a
/// client is picked, which is what makes the departure the default rather than an option.
@rowAuthz(owner="ownerUserId", clusterOwner, account="accountId")
@displayCard(primary="name", secondary="repoUrl", tertiary="deployedVersion", status="status")
concept package {
  ownerUserId         string  @description("v1:identity:user.id that owns this package, or EMPTY for a cluster-owned one. Stamped from the actor on create, exactly as v1:platform:site stamps its own -- it is the row-authz key the composite tier compares against actor.userId, so a caller-supplied value would record a guarantee nothing provides. NOT `string!`, for the same reason the site's is not: an empty value is the meaningful cluster-owned state.")
  name                string!  @description("From the manifest at first analysis (memql-package.yaml `name`). Not caller-chosen: the package IS the tree, and a name typed into a form could disagree with what the tree says it is on the very next deploy.")
  sourceKind          enum("repo", "artifact")!  @description("Where the source comes from. 'repo' tracks a Git repository as the source of truth and is the form the D11 update feeds watch. 'artifact' is a zip already in the Library -- a complete, self-contained snapshot with nothing upstream to notice, so it never carries an update cue. Both analyze, build, stage, roll and publish through exactly the same pipeline.")
  repoUrl             string   @description("HTTPS URL of the tracked repository. Empty for sourceKind='artifact'. Also the match key the webhook feed uses to find this row when a push arrives (D11), which is why it is stored normalized rather than as typed.")
  repoRef             string   @description("Branch, tag or commit to deploy. EMPTY means the repository's default branch, resolved at fetch time -- storing a resolved default here would freeze a package to whatever 'main' meant on the day it was added.")
  credentialId        string   @description("The v1:platform:sourceCredential this package fetches under, or EMPTY for a public repository (epic memql#4885, D10). A NAME rather than a value: the token never lands on this row, on a snapshot, or in a log, and is unsealed only at fetch time -- under the PACKAGE OWNER's actor, so a package naming somebody else's credential resolves nothing and is refused as credential_not_found. A row still carrying a token NAME from before this field existed reads as 'no credential' -- there is no shim -- and the OS asks for one on its Source stop.")
  artifactId          string   @description("The v1:library:artifact this package's source zip was read from, for sourceKind='artifact'. Provenance: Files stores and identifies, packages consume (D8).")
  deployedVersion     string   @description("Commit SHA or content hash of the source currently LIVE. Written by the pipeline when a deployment reaches 'succeeded' -- so it lags the repository deliberately, and the gap between it and latestKnownVersion is the whole update cue.")
  latestKnownVersion  string   @description("Newest upstream version either D11 feed has seen. WRITTEN ONLY BY THE FEEDS. A feed that wrote anything else would be deciding to deploy, which is a person's click.")
  updateAvailable     bool     @description("Whether latestKnownVersion differs from deployedVersion. WRITTEN ONLY BY THE FEEDS, and stored rather than derived at read time so that flipping it is a row change that BROADCASTS -- which is what lights the OS cue without a reload. Deriving it would leave the OS comparing two strings on a row nobody told it had changed.")
  autoDeploy          bool     @description("Whether a push to this source deploys itself when the plan has not changed (epic memql#4900). Off by default and off for every row written before this field existed, which is the only safe default: on, a push to the tracked ref starts a run under the OWNER's authority with nobody watching. The run confirms ITSELF only when the new analysis plans exactly what the last confirmed run planned -- the same apps by name, kind and path, the same DSL domains, every placement already remembered -- and parks at the confirm gate for anything else, exactly as a person's deploy does. A person would call turning it on a change, so it IS in the OS's arrival-cue fingerprint.")
  declares            []object @description("What the SOURCE says it contains: one entry per manifest deployable, {name, kind}, rewritten from the analysis report on every run that reaches one. The package is the thing apps come FROM, and until this existed the only record of what a tree declared lived inside a run's report -- so an app that was declared and never deployed had no site row and was invisible everywhere: absent from the list, absent from the source page's own list of the apps it produces. Skipping one at the confirm gate is exactly that case and the commonest, which is how a person could choose not to deploy an app and then be unable to find it again. A SITE row still means DEPLOYED; this means DECLARED, and the difference between the two lists is the set of apps a person can still deploy. Never a placement: no address is stored here, because a skipped app is not asked for one until it is deployed.")
  disabledDeployables []string @description("The manifest deployables this source's OWNER has chosen not to deploy, by name. The OWNER's field, and the pipeline never writes it -- `declares` above is what the manifest says and is rewritten by every analysis, so intent kept there would be erased by the next one. Two fields because there are two authors. A name here means the app is listed and INERT: it appears under its source so it can be found, it is not offered for deploy, and no run builds it. Skipping one at the confirm gate, deactivating a deployable that came from a source (packageDeactivateDeployable) and archiving the source all add to it; activating (enablePackageDeployables) is the deliberate act that removes it, and only then can it be deployed. Before this, a skipped app was merely 'declared with no site' -- indistinguishable from one nobody had got to yet -- so the console offered to deploy it, and discarding the result brought it straight back. A name that no longer appears in `declares` is harmless: it matches nothing, and the manifest is the authority on what exists.")
  status              enum("active", "archived")!  @description("Lifecycle (D10). 'archived' is a PLACE, not a void: archived rows stay listable behind the Archived filter, because the alternative -- the isNotDeleted tradition, which filters rows out of every list -- is precisely what made a deleted deployable unfindable and is why this axis exists at all. Archiving DEACTIVATES every app the package produced first (2026-09-05 design, D3): each app's site is deleted so its address comes free, its name goes on disabledDeployables, and the package flips last. Restoring brings the package back with its apps inactive.")
  accountId           string   @description("The v1:accounts:account this package is FOR (memql#5303, D12) -- the account argument of the tier above, so a member of that account's group reads this row and its runs without owning them, and a developer or above reads every tied one. The compose flow sets it to the cluster's own account (`self`) unless a client is picked, and copies it onto every packageDeployment it opens. Optional: EMPTY is an untied package, readable by its owner and a cluster owner and nobody else, which is what every row written before this field existed is. Unlike v1:platform:site's field of the same name this one DOES have a read effect, and the concept doc above says why.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="forAccount", field="accountId", target=account, direction="outgoing")
  @relationship(type="references", as="fetchedFrom", field="artifactId", target=artifact, direction="outgoing")
  @relationship(type="references", as="fetchesUnder", field="credentialId", target=sourceCredential, direction="outgoing")
}

/// ONE ATTEMPT to deploy one version of one package -- the append-only timeline (D7).
///
/// APPEND-ONLY IS THE CONTRACT, and it is what makes the row trustworthy. A row at a terminal status
/// (succeeded / refused / failed) accepts no further writes; a retry is a NEW row. So the timeline
/// of a package is the literal history of what was attempted and what happened, and it cannot be
/// rewritten by the next attempt to look like it always went well.
///
/// Same composite tier as its package -- the account argument included (memql#5303, D12), so a run
/// is readable by exactly the people its package is -- and broadcast: the OS watches a deploy
/// advance stage by stage, which is only true because each stage's status write is a row change the
/// mesh forwards.
@rowAuthz(owner="ownerUserId", clusterOwner, account="accountId")
@displayCard(primary="sourceVersion", secondary="packageId", tertiary="requestedBy", status="status")
concept packageDeployment {
  ownerUserId    string  @description("Copied from the package row this deployment belongs to, never from the actor. It is the row-authz key, and taking it from the package is what keeps a deployment visible to exactly the people the package is -- including when the pipeline, not the person, writes the row.")
  accountId      string  @description("Copied from the package row at open, for the reason ownerUserId is (memql#5303): it is the account argument of the tier, and taking it from the package is what keeps the run timeline readable by the people the package is tied to. Written by openPackageDeployment alone and never rewritten; EMPTY for the run of an untied package, and for every run opened before the field existed, which read exactly as they did.")
  packageId      string!  @description("The v1:platform:package this attempt is against.")
  sourceVersion  string   @description("Commit SHA or content hash of the snapshot this attempt analyzed. Empty only while the fetch itself is what failed.")
  status         enum("analyzing", "awaiting_confirm", "building", "staging_dsl", "rolling", "publishing", "succeeded", "refused", "failed", "abandoned", "cancelled")!  @description("Where this attempt is. The stages advance in the D6 order and each write is one @serverOnly mutation under stamped internal origin. FOUR terminal values, and the difference between them is who has work to do: 'refused' is a typed NO the analysis or a gate produced and a person can act on; 'failed' is something that broke; 'succeeded' is live; and 'abandoned' (epic memql#4900) is the sweep's, for a run whose node died mid-flight -- it is deliberately NOT 'failed', because nothing failed that anyone can name and the D6 order guarantees every site is still serving what it was serving. The sweep is the one writer allowed to close a stranded row. FIVE terminal values since epic memql#4937: 'cancelled' is a person's own stop, and it is NOT a flavour of 'failed' for exactly the reason 'abandoned' is not -- nothing broke, nothing was published, and every site is still serving what it was serving. The distinction is who decided: 'abandoned' is a loss this cluster OBSERVED, 'cancelled' is a choice somebody MADE, and a surface that collapsed the two would tell a person their own click was a fault. Only a run that has not started rolling can reach it -- see cancelRequested.")
  report         object   @description("The analysis report (component/packages, design section E): source version, every deployable with its build plan, every DSL domain with construct counts, any Go pack, every problem found. First-class DATA rather than a log -- it is what the OS renders at the always-present confirm gate, and what a person reads a year later to see what a past deploy decided.")
  dslVersion     string   @description("Content-addressed prefix of the DSL tree this attempt staged (blob://packages/<domain>/<contentHash>/), or EMPTY when the package carries no DSL or its DSL was unchanged -- which is the D6 fast path where stage and roll are skipped entirely and nothing restarts.")
  deployables    []object @description("Per-deployable outcome, one entry per manifest deployable: {name, siteId, hostname, bundleRef, version} on success, or {name, refusal:{code, message}} for a half that was refused. A LIST rather than a map because the order is the manifest's and a reader compares it against the report above.")
  snapshotArtifactId string @description("The v1:library:artifact holding the content-addressed source snapshot this attempt ran against (D8). It is what makes a re-analysis repeatable without refetching, and what a person clicks to see exactly which bytes were deployed.")
  buildLogTail   string   @description("Bounded tail of the build output, captured whether the build succeeded or failed so 'why did my build fail' is answered inside the OS rather than in a pod log the person cannot reach (design section I). Bounded because a row is not a log store: the WHOLE output goes to the log store with this deployment as its subject (epic memql#4893), and this is the end of it, for the list.")
  builtOn        object   @description("Where this run built: {surface, nodeId} (epic memql#4900). surface is one of 'prebuilt' (the output was committed and nothing ran), 'workbench' (a sandboxed in-cluster directory) or 'fleet' (a machine in the owner's own Fleet, for a target that needs one). nodeId is the replica that ran the command, and it is on the row because it is the only durable answer to 'where did this build happen' once the directory it happened in is gone -- which it is by the time this row closes, deliberately. Empty surface for a run that never reached the build stage; empty nodeId for the prebuilt path, which ran nowhere.")
  error          object   @description("The typed failure, when there is one: {code, message, scope}. The code is a catalogued refusal (component/packages/refusal.go) so the OS keys its own sentence on a stable string; the message is the server's own sentence, which the OS renders verbatim when it has no copy of its own.")
  requestedBy    string   @description("v1:identity:user.id of whoever started this attempt. Provenance on an append-only row: the timeline says who asked, not merely what happened.")
  startedAt      datetime @description("When this attempt began.")
  finishedAt     datetime @description("When it reached a terminal status. Empty while it is still running.")
  stoppedAt      string   @description("The stage this run had reached when the sweep closed it as 'abandoned' (epic memql#4900). Written by the sweep alone, and only for an abandoned run: it is the one fact closing the row DESTROYS. The status field held 'building', the sweep overwrites it with 'abandoned', and the rail then reads the run's furthest point from its own leftovers -- a report, a staged version, a log tail -- of which a run that died mid-build has none. So it draws the run as having stopped at Analyze, which understates what it achieved and sends somebody looking in the wrong place. Empty for every run that closed itself.")
  nodeId         string   @description("The replica running this attempt (epic memql#4900). Stamped at open from MEMQL_NODE_ID and never rewritten: a run is one call on one node, so this is a fact about the attempt rather than a field that tracks anything. It is what the abandoned sweep's sentence names -- 'this cluster lost the node that was running it' is only useful if it can say WHICH -- and it is deliberately separate from builtOn.nodeId, which names the workbench replica the build ran on. On a two-replica bff building on a two-replica workbench those are four different pods and two different questions.")
  heartbeatAt    datetime @description("When the node running this attempt last said it was still alive (epic memql#4900). Written on a fixed cadence by the running pipeline and by NOTHING else; a run that stops writing it for longer than MEMQL_PACKAGES_ABANDONED_AFTER_SECONDS is closed 'abandoned' by the sweep. A HEARTBEAT, which is why it must never enter an arrival-cue fingerprint: a surface that re-fired on it would announce a change every fifteen seconds of every deploy, which is exactly the 'a heartbeat is not news' failure clients/os/README.md names. Empty on a terminal row and on a run that never started.")
  cancelRequested bool    @description("Somebody asked for this run to stop (epic memql#4937). Set by requestPackageDeploymentCancel and read by the node running the attempt -- it does NOT itself end the run, which is the whole shape: the row records the ASK and the running node records the OUTCOME, so the timeline can never claim a run stopped that is still building somewhere. The pipeline checks it at each stage boundary before the next stage begins, and its heartbeat re-reads it on the same cadence so a long single stage -- a build -- learns about a cancel within one beat rather than only at its own end. THE LAST CHECKPOINT IS IMMEDIATELY BEFORE THE ROLL: from staging_dsl on there is no cancel, because a roll restarts the cluster onto staged MemQL and stopping half way through is the one outcome worse than either finishing or not starting. The capability refuses the ask at that point rather than setting a flag nothing will read.")

  automatic      bool     @description("Whether the source's own auto-deploy switch started this attempt rather than a person (epic memql#4900). FALSE is somebody's click -- the overwhelming majority, and what every row written before this field existed reads as. TRUE means the update feeds noticed the source move and started the run under the package's OWNER (requestedBy still names them, because the deploy is theirs) with nobody at a keyboard: which is what the OS marks on it in Every attempt, and why the run confirms itself only when the plan is unchanged and parks at the gate for anything else. A BOOLEAN rather than an enum of trigger kinds, because there are exactly two answers and the field is not the place to speculate about a third -- and because `provenance`, the word that first suggested itself, is a RESERVED property name (row.provenance.<leaf>) and a concept declaring it is dropped whole.")

  scopedTo       []string @description("The deployables this run was STARTED FOR, by name. Empty means the whole source, which is what every run written before this field existed was and what a run with nothing skipped still is. Without it a run recorded no trace of whose it was, and runs are routinely scoped to one app -- a redeploy from a deployable's page sends every sibling skip:true, and the compose gate does the same when entered for one declared app -- so every reader had to assume the source's newest run was about whatever it was looking at. It was not: a deployable's page read `web` building and drew ITSELF as Building, hid its own acts, and offered a Cancel that killed the other app's run (memql#4953). Filtering on the run's `deployables` outcomes is not a substitute: those are written at CLOSE, and the window where the reading is wrong is exactly the window where the run is still in flight. Stamped where the placements are read, so it is a fact about the run rather than a reader's guess, and re-stamped at the confirm because the gate is where a person answers which apps they meant.")
  fromDeploymentId string @description("The run this one was started FROM, when it was (task memql#4902, memql#4955). A retry of a lost run re-analyses the snapshot that run stored rather than fetching the source again -- so it deploys the bytes the lost run was deploying, not whatever the branch has moved to since -- and this records that it did. It was consumed at fetch time and written nowhere, so the run kept no trace of its own provenance: the CONFIRM that followed was a fresh call with no fromDeploymentId at all, which meant a person read a report describing commit A and clicked a button that shipped commit B. Empty for an ordinary run.")

  @relationship(type="parent", field="packageId", target=package, direction="outgoing")
  @relationship(type="references", as="forAccount", field="accountId", target=account, direction="outgoing")
  @relationship(type="references", as="fetchedFrom", field="snapshotArtifactId", target=artifact, direction="outgoing")
  @relationship(type="references", as="retriedFrom", field="fromDeploymentId", target=packageDeployment, direction="outgoing")
}

/// One node's verdict on one module (design record 2026-09-06-configuration-readiness, section
/// 4.4). Rewritten as a new version of the same id, v1:platform:moduleReadiness:<module>--<nodeId>,
/// when this node's verdict changes and at least every ten minutes, so a read collapses to the
/// latest. Carries presence and source only, never a value.
///
/// TIER: public, requiresIdentity. Any signed-in person reads it -- the setup surface has to tell a
/// viewer "not set up" as honestly as it tells an owner -- and nobody anonymous does. The write is
/// the engine's alone: recordModuleReadiness is @serverOnly.
///
/// `unknown` (design record 2026-09-14-readiness-convergence, D1) is the node's word for "I could
/// not evaluate this": a resolver the verdict depends on errored. It is never a vote in the fold
/// and is never written over a known row; `reason` names which resolver, from a closed vocabulary
/// (fleetReadFailed, integrationProbeFailed), never an error string. ADDITIVE on purpose: dropping
/// an enum value bricks stored rows (root CLAUDE.md). A lane's optional `scope: "cluster"` marks one
/// computed from cluster rows alone; the fold sets aside a row whose cluster-scoped lanes lag the
/// freshest row's (memql#5259).
@rowAuthz(public, requiresIdentity)
@displayCard(primary="module", secondary="nodeId", tertiary="nodeType", status="state")
concept moduleReadiness {
  module      string!  @description("The readiness module id from the env manifest's modules block: ai, storage, email, githubApp, campaigns, workbench, localApps.")
  nodeId      string!  @description("The reporting node's MEMQL_NODE_ID.")
  nodeType    string!  @description("The reporting node's type.")
  state       enum("configured", "partial", "unconfigured", "notApplicable", "unknown")!  @description("This node's verdict; notApplicable means the node does not host the module; unknown means the node could not evaluate it (see reason) and casts no vote.")
  reason      string   @description("Why the state is unknown, from a closed vocabulary: fleetReadFailed, integrationProbeFailed. Empty for every other state.")
  core        bool     @description("Whether the module is one the first-run wizard walks.")
  lanes       []object @description("One entry per lane: { name, configurableFrom, scope, complete, slots: [{ name, present, source, optional }] }. Presence and source only; scope is the word cluster for a lane computed from cluster rows alone, and absent for a node-scoped one.")
  reportedAt  datetime!  @description("When this node evaluated, RFC3339.")
}

/// Virtual, never persisted: the cluster-wide fold of moduleReadiness rows, one row per module with
/// id = module name. The moduleReadiness builtin answers it; the OS computes the same fold from the
/// live feed with the mirrored function (component/memql/readiness).
///
/// @displayCard's tertiary names "core" rather than the brief's original "disagreement": the loader
/// rejects an array-typed slot ("disagreement" is []string; only string/enum/bool/datetime/int/float
/// display), and core is the one other scalar this concept carries.
@displayCard(primary="module", secondary="state", tertiary="core")
concept moduleVerdict {
  module        string!  @description("The module id.")
  state         enum("configured", "partial", "unconfigured", "unreported")!  @description("Worst state across the live reporting nodes that vote; partial with disagreement when they differ; unreported when no live node voted.")
  core          bool     @description("Whether the module is core.")
  disagreement  []string @description("nodeId=state for every voting reporter when they disagree, worst first; empty otherwise.")
  nodes         []object @description("Per voting reporter: { nodeId, nodeType, state, reportedAt }. A stale or unknown row is not a vote and is not listed here.")
  unknown       []string @description("Live nodes whose row says they could not evaluate the module, sorted. Set aside, never counted.")
  stale         []string @description("Live nodes whose row read the cluster before the freshest evaluation did -- their cluster-scoped lanes disagree with it -- sorted. Set aside until they re-evaluate (memql#5259).")
}

/// Virtual, never persisted: what readinessRecompute answers -- how many modules this node just
/// rewrote, and which node it was. One row, id "current", because it answers one question about one
/// node rather than describing a set.
@displayCard(primary="nodeId", secondary="written")
concept readinessRecomputeResult {
  nodeId   string!   @description("The node that re-evaluated.")
  written  int!      @description("How many moduleReadiness rows were written. Zero is an answer: an unchanged verdict younger than the restatement floor is not rewritten.")
  unknown  []string  @description("Modules this pass could not evaluate, as module=reason with the closed-vocabulary reason; empty when every module was evaluated. The node's recompute loop retries them on its own.")
}

// ---- Measurement and evidence (epic memql#5146, D3 and D5) ------------------
//
// A pull says a model is on a disk. These two say what it DOES there, and what
// it has done since.
//
// modelMeasurement is one probe's answer for one model on one machine, under
// one suite version. modelEvidence is the nightly fold of what actually
// happened afterwards -- the decision records and step receipts a week of real
// calls left behind. The first is a measurement taken on purpose; the second is
// a measurement nobody had to take, and neither substitutes for the other.

/// One probe's figures for one model on one machine, under one suite version.
///
/// KEYED BY (machineId, modelId, suiteVersion), AND THE THIRD IS NOT METADATA. Two figures scored by
/// different suites are not comparable, so a new suite version produces a NEW row rather than
/// overwriting a figure that meant something else. The row id is a digest of the three, so a re-probe
/// under the same suite is a new VERSION of one logical row and the history stays readable.
///
/// EVERY FIGURE IS A STAT OR AN ABSENT REASON, never both and never neither. That is
/// component/proving/figure's discipline carried onto a row, and the reason is a page: a machine
/// nobody has probed showing "0 tok/s" reads exactly like a slow machine, and the two lead to
/// opposite actions. Each figure is an object of the shape
/// { measured: true, median, spreadLow, spreadHigh, n } XOR
/// { measured: false, absentReason, absentDetail }, where absentReason is one of unmeasured,
/// refused or failed. `refused` is NOT a failure -- it is the 32K case put to an 8K model, a
/// question the model never claimed to answer -- and counting it as one would penalise a model in
/// every ranking for a limit it had already declared.
///
/// A MEASURED ZERO IS A REAL ANSWER. Five structured cases that ran and all failed is 0.0 with n=5,
/// and it says do not route structured work to this model; that is a different sentence from the
/// absence a crashed runtime leaves, and the whole shape above exists to keep them apart.
///
/// TIER: the composite owner, clusterOwner. A measurement is a fact about somebody's machine -- it
/// says what their hardware does -- so the owner tier is right, and a plain one would hide every
/// machine's figures from the operator who has to explain the routing.
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="modelId", secondary="machineId", tertiary="measuredAt", status="suiteVersion")
concept modelMeasurement {
  ownerUserId          string!  @serverSet  @description("v1:identity:user.id who owns the machine the suite ran on. THE ROW-AUTHZ OWNER FIELD, stamped from the actor and never taken from caller args. The probe's report arrives on an agent replica, which runs the write under auth.ContextWithUserActor for the registration's owner -- the borrowed-authority shape every other write about somebody's machine already uses.")
  machineId            string!  @description("v1:worker:registration.id the suite ran on. A figure with no machine is a figure about nothing: the whole content of a measurement is which hardware produced it, which is also why a probe names one machine and has nothing to fall through to.")
  modelId              string!  @description("The runtime's own id, byte-identical to the model label and to v1:models:modelProfile.modelId, so a measurement joins to both by string equality and never by a fuzzy match.")
  suiteVersion         string!  @description("The probe suite this run was scored under (component/worker/probe.SuiteVersion). Part of the key rather than metadata: two figures from different suites are not comparable, so a bump produces new rows and the machine page shows the older ones as measured under an older suite rather than silently mixing them.")
  measuredAt           datetime!  @description("When the machine finished the suite, server-stamped from the report's arrival rather than taken from the machine: a clock this cluster does not control must not decide which of two measurements is newer.")
  structuredValidity   object  @description("Figure. Fraction of the structured cases whose output validated against the platform's own schemas. THE FACT THE ROUTER NEEDS: a model's parameter count says nothing about whether its structured output satisfies the schemas this cluster actually sends.")
  toolCallCorrectness  object  @description("Figure. Fraction of the tool cases where the model called the right tool with arguments satisfying its schema. A runtime handed tools it cannot honour answers prose, which surfaces three layers away as an agent that stopped using its tools for no reason a reader can see.")
  throughputTps        object  @description("Figure, tokens per second, over the 8K and 32K cases as ONE figure with a spread. Two numbers would invite a reader to quote the short prompt, and a single best case is what the spread exists to prevent.")
  ttftMs               object  @description("Figure, time to first token in milliseconds, over the same two cases.")
  probeError           string  @description("The machine's own sentence when the probe itself failed. Empty on a clean run, and PRESENT ALONGSIDE FIGURES when some cases ran and some did not -- that is a real state rather than a contradiction, and each figure says for itself which it was.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="machineId", target=registration, direction="outgoing")
}

/// One model's week at one level, folded from what actually happened.
///
/// A MEASUREMENT AND AN EVIDENCE ROW ANSWER DIFFERENT QUESTIONS. The probe asks a model to do things
/// nobody needed done, under controlled conditions, and reports how it went. This row is the record
/// of real calls: how many, how many failed the structured contract, how often a repair or a retry
/// followed, how often a run parked. Neither substitutes for the other -- a model can probe well and
/// fail in service, and a model with a bad week can be perfectly capable.
///
/// IT PROPOSES AND NEVER APPLIES. Above a 0.3 structured failure rate over at least twenty calls,
/// the nightly fold opens a v1:work:approval of kind routingReview carrying a generated rule hashed
/// over its exact text; approving arms it and declining is recorded so the same week's evidence does
/// not re-propose. Automatic demotion was considered and rejected: it violates the never-a-silent-edit
/// rule, and a week of bad luck on one schema is not a reason to route a whole level elsewhere.
///
/// THE CALL COUNT IS ON THE ROW EVEN WHEN IT IS UNDER THE FLOOR, so an operator asking why nothing
/// was proposed reads the answer rather than inferring it.
///
/// TIER: clusterOwner. It spans every owner's calls by nature -- the question is how a MODEL behaved
/// across the fleet, not how it behaved for one person -- so there is no owner to scope it to.
@rowAuthz(clusterOwner)
@displayCard(primary="modelId", secondary="level", tertiary="week", status="proposal")
concept modelEvidence {
  modelId             string!  @description("The runtime's own id, matching v1:router:call and the model label byte for byte.")
  level               enum("fast", "strong", "reasoning", "embeddings")!  @description("The level these calls were serving. Evidence is per level because a model can be right for one and wrong for another, and a demotion that took a model out of every level for a failure at one would be a heavier act than the evidence supports.")
  week                string!  @description("The ISO week the fold covered, as YYYY-Www. A string rather than a pair of timestamps because it is a KEY -- one row per model per level per week -- and two folds of the same week must land on one row rather than two.")
  calls               int!  @description("Decision records for this model at this level in the week. Recorded even when it is under the twenty-call floor, so a fold that proposed nothing has a readable reason.")
  structuredFailures  int  @description("Calls whose structured contract was violated. The numerator of the rate the threshold reads.")
  repairs             int  @description("Steps re-run with the violation as guidance. A repair is cheaper than a resample and it is evidence, not a failure.")
  retries             int  @description("Steps retried after a transient failure.")
  parks               int  @description("Runs that parked on an approval while this model was serving them.")
  proposal            enum("", "none", "demotion", "promotion", "declined")  @description("What the fold did with this week's evidence. `none` is the fold having looked and decided nothing -- distinct from the empty string, which is a row no fold has reached yet. `declined` records a person's decision so the same week's evidence does not re-propose, which is the difference between a proposal and a nag. NO @default, deliberately: every writer of this row is a fold that has already decided, so a declared default would document a create-time value nothing ever stamps.")
  approvalId          string  @description("v1:work:approval.id of the routingReview this row opened, when it opened one.")
  ruleHash            string  @description("SHA-256 of the RENDERED rule source the proposal carries. The approval hashes the same string, so an approved decision can never carry to a different rule -- which is the whole guarantee, since two renderers of one grammar would drift and the drift would be silent.")
  foldedAt            datetime!  @description("When the fold ran.")

  @relationship(type="parent", field="approvalId", target=approval, direction="outgoing")
}
