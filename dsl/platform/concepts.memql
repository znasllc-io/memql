// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use agents.concepts.{ agent }
use identity.concepts.{ user }
use planner.concepts.{ plan }

@namespace("platform")
@description("Instance-wide encrypted secret. Lives in the reserved _system partition (via @scope(\"global\")). The cleartext value is NEVER stored -- only a NaCl secretbox ciphertext (base64(nonce||ct)) under MEMQL_MASTER_KEY and a short fingerprint for UI display. Used for instance-level API keys, OAuth client secrets, Azure/Graph credentials, etc. For per-tenant overrides (BYOK) use v1:platform:partitionSecret; the resolver falls back partition -> global automatically.")
concept globalSecret {
  name            string    @required  @description("Secret name (uppercase with underscores by convention).")
  encryptedValue  string    @required  @description("Base64-encoded nonce || NaCl-secretbox ciphertext, sealed under MEMQL_MASTER_KEY. Opaque -- never rendered to humans.")
  fingerprint     string    @required  @description("Last 4 chars of the cleartext, prefixed with '...'. For UI display only; lets operators tell rotated secrets apart without leaking the value.")
  kind            string    @description("Optional tag to group secrets by type. Examples: 'vendor_api_key', 'oauth_secret', 'smtp_password'. Folded router API keys use 'vendor_api_key'.")
  description     string    @description("Human-readable description of the secret's purpose.")
  addedBy         string    @description("Identity subject that wrote the secret.")
  active          bool      @default("true")  @description("When false the resolver skips this row and falls back. Useful for rotating a key without deleting history.")
  lastUsedAt      datetime  @description("Last time the resolver decrypted this secret. Empty until first use.")
  rotatedAt       datetime  @description("Timestamp of the most recent rotation (optional).")
}

@namespace("platform")
@description("Instance-wide plaintext configuration variable. Lives in the reserved _system partition (via @scope(\"global\")) and is visible to every tenant. Used for instance-level defaults like provider names, feature flags, log levels, and tuning knobs. For per-tenant overrides use v1:platform:partitionVariable. For sensitive values use v1:platform:globalSecret.")
concept globalVariable {
  name         string  @required  @description("Variable name (uppercase with underscores by convention).")
  value        string  @required  @description("Variable value, always stored as string. Callers parse if they need typed data.")
  description  string  @description("Human-readable description of the variable's purpose.")
  active       bool    @default("true")  @description("When false the resolver ignores this row.")
}

// ---- concepts/v1/platform/globalSecret/seed.memql ----

@actor("system")

// No default secret seeds. Operators populate v1:platform:globalSecret via:
//   * `make secrets-seed` (reads ~/.memql/dev-secrets.yaml locally)
//   * `make prod-seed-secrets ENV=...` (reads from GCP Secret Manager
//     in staging/prod)
//   * `make secret-set NAME=... VALUE=... SCOPE=global` (one-offs)
// Seeding a secret at the concept-file level would require committing
// ciphertext, which requires a static MEMQL_MASTER_KEY -- antithetical
// to per-install keys. Keep this file empty.

// ---- concepts/v1/platform/partitionSecret/concept.memql ----

@namespace("platform")
@description("Partition-scoped encrypted secret. Holds per-tenant sensitive values (BYOK vendor API keys, per-tenant Twilio/SMTP creds, etc.). Same wire shape as v1:platform:globalSecret, different scope. The cleartext value is NEVER stored -- only a NaCl secretbox ciphertext under MEMQL_MASTER_KEY and a fingerprint. When the partition-scoped resolver (resolveSecret) cannot find a row, it falls back to v1:platform:globalSecret so a tenant's BYOK key wins over the instance default but the instance default is always available.")
concept partitionSecret {
  name            string    @required  @description("Secret name (uppercase with underscores by convention).")
  encryptedValue  string    @required  @description("Base64-encoded nonce || NaCl-secretbox ciphertext, sealed under MEMQL_MASTER_KEY. Opaque -- never rendered to humans.")
  fingerprint     string    @required  @description("Last 4 chars of the cleartext, prefixed with '...'. For UI display only.")
  kind            string    @description("Optional tag to group secrets by type. Examples: 'vendor_api_key', 'oauth_secret'. BYOK vendor keys use 'vendor_api_key'.")
  description     string    @description("Human-readable description of the secret's purpose.")
  addedBy         string    @description("Identity subject that wrote the secret.")
  active          bool      @default("true")  @description("When false the resolver skips this row and falls back to the global v1:platform:globalSecret.")
  lastUsedAt      datetime  @description("Last time the resolver decrypted this secret. Empty until first use.")
  rotatedAt       datetime  @description("Timestamp of the most recent rotation (optional).")
}

// ---- concepts/v1/platform/partitionVariable/concept.memql ----

@namespace("platform")
@description("Partition-scoped plaintext configuration variable. Holds per-tenant non-sensitive overrides (default chat provider, default language, feature flags scoped to a single tenant, etc.). Same wire shape as v1:platform:globalVariable, different scope. When the partition-scoped resolver (resolveVariable) cannot find a row, it falls back to v1:platform:globalVariable so a tenant's override wins over the instance default but the instance default is always available.")
concept partitionVariable {
  name         string  @required  @description("Variable name (uppercase with underscores by convention).")
  value        string  @required  @description("Variable value, always stored as string. Callers parse if they need typed data.")
  description  string  @description("Human-readable description of the variable's purpose.")
  active       bool    @default("true")  @description("When false the resolver skips this row and falls back to the global v1:platform:globalVariable.")
}

@namespace("platform")
@description("Persisted trace tree for a single policy evaluation. The engine writes one row per evaluation when the resolved policy carries @traces_persisted or when the caller requests PersistTrace=true on the EvaluatePolicy options. The row carries the policy name, the tier, the caller (actor / partition), the args hash (for cache lookup and audit correlation), the JSON-serialized PolicyTrace tree, the computed result, the wall-clock duration in milliseconds, and any error message that arose during evaluation. Retention is governed by the MEMQL_POLICYTRACE_RETENTION_DAYS env var (default 90); the daily purge automation hard-deletes rows whose `createdAt + retentionDays < now`. Distinct from v1:identity:auditEvent, which is the lightweight @audited per-eval row -- policyTrace is the heavyweight 'I'm debugging WHY this returned X' artifact.")
concept policyTrace {
  policyName   string    @required @description("Name of the policy that produced this trace.")
  tier         string    @required @description("Tier of the policy at evaluation time -- 'core' or 'bff'.")
  actorUserId  string    @description("Caller's v1:identity:user id. May be empty for server-internal calls.")
  actorRole    string    @description("Caller's cluster-wide role (owner / admin / writer / reader). Empty when unauthenticated.")
  callerPartition string @description("Active partition envelope at evaluation time.")
  argsHash     string    @required @description("SHA-256 hex of canonicalized args JSON. Used for cache lookup and audit correlation.")
  resultJson   string    @required @description("JSON-encoded return value of the policy.")
  traceJson    string    @required @description("Full PolicyTrace tree serialized as JSON (name / tier / args / result / durationMs / subcalls / breadcrumbs / error).")
  durationMs   float     @required @description("Wall-clock duration of the top-level evaluation in milliseconds.")
  error        string    @description("Error message captured when the evaluation aborted; empty on success.")

  @relationship(type="parent", field="actorUserId", target=user, direction="outgoing")
}

// ---- concepts/v1/platform/missingCapability/concept.memql ----

@namespace("platform")
@description("A capability the platform itself cannot yet provide -- a missing tool, missing integration, missing liveSource connector kind, missing knowledge domain category, etc. Distinct from v1:cognition:unmetCapability which fires when the chat router can't find a specialist for an utterance: missingCapability fires when even creating the right specialist wouldn't solve the problem because the underlying platform surface doesn't exist. Logged by the Planner Agent during its capability-gap detection step before agent creation. Becomes the product backlog -- 'these are the things the platform can't do yet that users actually want.' Global-scoped so it's visible across tenants for prioritization.")
concept missingCapability {
  kind            enum("tool", "integration", "liveSource", "connectorKind", "knowledgeDomain", "modelCapability", "other") @required @description("What category of platform extension would close this gap. 'tool' = an agent-callable action that doesn't exist yet (e.g. 'sendSlackMessage'). 'integration' = a backing service we don't speak to yet (e.g. Jira). 'liveSource' = a volatile data source we'd want bound to agents but don't have a query for. 'connectorKind' = a brand-new liveConnector implementation kind (e.g. 'snowflake'). 'knowledgeDomain' = a category-level gap, e.g. agents trying to act in a domain we never seeded. 'modelCapability' = a model-level feature we don't support yet (e.g. structured-output with strict schemas on a new provider).")
  capability      string  @required @description("Short identifier for the missing thing, e.g. 'sendSlackMessage', 'jira.createIssue', 'erp.inventory.live'. Stable across multiple sightings so duplicate signals collapse onto one row.")
  description     string  @required @description("Human-readable description: what the platform was being asked to do that it couldn't. Surfaced in the product backlog view.")
  requestedFromPlanId  string @description("v1:planner:plan.id where the gap was detected. Lets the platform team trace back to 'what was the user trying to accomplish when we hit this wall'.")
  requestedByAgentId   string @description("v1:agents:agent.id of the agent (typically the Planner Agent) that logged the gap. Empty for system-level detection.")
  partitionId         string  @description("Optional space scope where the gap was detected. Useful for attributing 'this gap blocked work in space X'.")
  partitionScope  string  @description("Partition where the gap was detected. Empty = unknown. Helps de-duplicate platform-wide vs tenant-specific gaps.")
  sightingCount   int     @default("1") @description("How many times this gap has been logged. New sightings of the same (kind, capability) increment rather than creating new rows. Drives 'most-requested capability' prioritization.")
  firstSeenAt     datetime @description("When the first sighting was logged.")
  lastSeenAt      datetime @description("When the most recent sighting was logged.")
  status          enum("open", "in_progress", "resolved", "wontfix") @default("open") @description("Lifecycle. 'open' = logged, nothing done yet. 'in_progress' = the platform team is working on it (manually set). 'resolved' = the capability shipped; the Planner Agent's next sighting will recreate as a fresh row if it still doesn't work. 'wontfix' = explicit dismissal.")
  resolution      string  @description("Free-text note when status='resolved' or 'wontfix' explaining what shipped (or why we won't ship it).")
  exampleGoals    []string @description("List of Plan.goal strings that triggered this gap. Capped at the most recent N (engine policy); gives the prioritization view 'real users wanted X, Y, Z'.")

  @relationship(type="interactsWith", field="requestedFromPlanId", target=plan, direction="outgoing")
  @relationship(type="interactsWith", field="requestedByAgentId", target=agent, direction="outgoing")
}

// ---- concepts/v1/platform/outboundRequest/concept.memql ----

@namespace("platform")
@description("A staged outbound delivery (memql#2521): the durable outbox row a product automation or logic body creates when it decides something must leave the cluster (an email, a webhook call). The engine-owned outbound worker drains pending/retrying rows, performs the delivery through the deploy-configured transport (per-medium allowlists, credentials from env/globalSecret -- NEVER from this row), and stamps the status transitions back, so delivery state is ordinary graph state products can query and react to. See docs/internal/design/outbound-delivery-adr.md.")
concept outboundRequest {
  medium        enum("email", "webhook") @required @description("Delivery transport. 'email' delivers via the engine email integration (Graph/SMTP/log per deployment). 'webhook' POSTs the payload as JSON to the target URL.")
  target        string  @required @description("Where to deliver: a recipient email address for medium='email', an absolute URL for medium='webhook'. Must match the deployment's per-medium allowlist or the row fails fast.")
  subject       string  @description("Email subject line. Ignored for medium='webhook'.")
  body          string  @required @description("What to deliver: the email text body, or the JSON body POSTed to a webhook. Capped by MEMQL_OUTBOUND_MAX_PAYLOAD_BYTES at drain time. Never secret material. (Named body, not payload: shape paths reserve the payload prefix.)")
  status        enum("pending", "sending", "sent", "retrying", "failed") @default("pending") @description("Delivery lifecycle. 'pending' = staged, awaiting the worker. 'sending' = a replica claimed it and is delivering. 'sent' = transport accepted it (sentAt stamped). 'retrying' = a retryable failure; eligible again at nextAttemptAt. 'failed' = permanent failure or attempts exhausted (see lastError).")
  attempts      int     @default("0") @description("Delivery attempts made so far. Incremented on each failure; bounded by MEMQL_OUTBOUND_MAX_ATTEMPTS.")
  lastError     string  @description("Most recent delivery error, truncated to 4KB. Empty on success.")
  nextAttemptAt datetime @description("When a 'retrying' row becomes eligible again (bounded exponential backoff with jitter). Compared Go-side by the worker.")
  sentAt        datetime @description("When the transport accepted the delivery.")
  dedupeKey     string  @description("Optional caller idempotency key, passed through to the receiver (webhook: X-Memql-Dedupe-Key header) so external systems can deduplicate at-least-once redelivery.")
  requestedBy   string  @description("Provenance: which product automation/logic staged this row. Free-form; surfaces in delivery audit queries.")
}
