// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.


use common.builtins.{ datasyncDispatchInbound, datasyncReconcileDomains }

// ---- The sync runtime's automations (epic memql#4378) ----
//
// Both load on every node type, because every binary loads every concept.
// Both no-op on a node with no connector bound, which is the common case
// -- the builtin answers "skipped" rather than being absent, for the
// reason integrations/shopify's own inbound automation records: an
// executor that is missing fails every inbound row from every source.

/// Offer every staged inbound delivery to the connector its source names. The connector decides
/// whether the delivery is its own; a source nothing serves is skipped, not failed.
@trigger(event="node.created", concept="v1:platform:inboundRequest")
automation dispatchInboundToConnector {
  args {
    id     any
    source any
    body   any
  }
  dispatch := builtin datasyncDispatchInbound(
    inboundRequestId: args.id,
    source: args.source,
    body: args.body
  )
}

/// Sweep mirrored domains whose interval says they are due. Every 10 minutes, because the interval
/// that matters is the DOMAIN's -- this only decides how often the runtime asks the question, and a
/// domain reconciling every 6 hours is not swept 36 times in between.
@trigger(schedule="0 */10 * * * *")
automation reconcileMirroredDomains {
  sweep := builtin datasyncReconcileDomains()
}

// ---- Custom domains (epic memql#4805) ----

/// Walk every non-terminal custom-domain binding: verify its two DNS records, provision the ones
/// that are ready, and take down the ones being removed.
///
/// EVERY TWO MINUTES, and the number is a decision about the person waiting rather than about load.
/// Somebody has just pasted two records into a registrar and is watching this panel; a propagation
/// that finished thirty seconds ago should not take ten minutes to be noticed. The cost is bounded
/// by the population -- one row per bound hostname, not per request -- and a pass over rows with
/// nothing to do is two status reads and no lookups at all.
///
/// THIS IS THE ONLY RETRY. There is deliberately no manual re-check button anywhere in the product
/// (design D5): a button invites hammering exactly the two things that must not be hammered, a
/// recursive resolver and an ACME endpoint, and it would make the fastest path to a certificate the
/// one where somebody clicks fastest.
@trigger(schedule="0 */2 * * * *")
automation reconcileCustomDomains {
  sweep := builtin customDomainReconcile()
}

/// The same sweep for an account's reserved MemQL name (epic memql#5168), on the same schedule and
/// for the same reasons.
///
/// A SEPARATE AUTOMATION rather than a second statement on the one above. Statements in an
/// automation run in order and a failed one ends the run, so folding these would make a DNS provider
/// timing out on one client's own domain the reason another client's front door stopped being
/// reconciled.
/// They are independent sweeps over independent concepts and they fail independently.
///
/// TWO MINUTES, matched to its sibling: a door's three CNAMEs and a client's own domain propagate
/// on the same internet, and an operator watching both stops in the same window should not see one
/// tick twice as often as the other for no reason they can name.
///
/// THIS IS THE ONLY RETRY. There is no manual re-check button on the MemQL address stop either, and
/// the stop says so -- an absent control with no explanation reads as an omission.
@trigger(schedule="0 */2 * * * *")
automation reconcileAccountFrontDoors {
  sweep := builtin accountFrontDoorReconcile()
}

// ---- update detection (epic memql#4794, D11) ----

/// Notice a push or release for a repository this cluster tracks as a package. Rides the existing
/// inbound seam -- the receiver has already checked the source allowlist and the per-source HMAC by
/// the time a row exists -- so this adds no HTTP surface at all. A delivery matching no package is
/// a no-op: most of a cluster's webhooks are about something else.
@trigger(event="node.created", concept="v1:platform:inboundRequest")
automation notePackageUpstreamFromWebhook {
  args {
    id     any
    source any
    body   any
  }
  note := builtin packageNoteUpstreamFromWebhook(
    inboundRequestId: args.id,
    source: args.source,
    body: args.body
  )
}

/// The polling fallback for clusters no webhook can reach. Every 10 minutes, which is the cadence
/// of a cue rather than of a deploy -- nothing here deploys anything, and the person who sees the
/// cue decides whether a ten-minute-old answer was worth acting on.
@trigger(schedule="0 */10 * * * *")
automation pollPackageUpstreams {
  poll := builtin packagePollUpstream()
}

/// Close the runs whose nodes are gone (epic memql#4900, task memql#4902).
///
/// EVERY TWO MINUTES, which is the cadence the threshold is a multiple of: a run heartbeats every
/// fifteen seconds, a stranded one is noticed within a couple of minutes of its node going away, and
/// the OS's rail stops claiming a deploy is building when nothing is.
///
/// Scheduled, so it runs on the CRON LEADER only (component/automations.CronLeader) -- one replica
/// closing each stranded row once, with no advisory lock of its own to get wrong. It is also a
/// MAINTENANCE automation (component/auth/maintenance_actor.go): its read is every owner's runs,
/// which the composite tier admits only to a cluster owner, and the default automation actor is a
/// reader.
@trigger(schedule="0 */2 * * * *")
automation sweepAbandonedPackageDeployments {
  sweep := builtin packageSweepAbandoned()
}

/// Probe due published websites once per cluster through the elected cron leader.
/// No observation means unknown; a saved live state never establishes health.
@trigger(schedule="0 */2 * * * *")
automation checkDeployableHealth {
  sweep := builtin siteHealthSweep()
}

/// The FOURTH observation of a storefront preview, and the only passive one (epic memql#5531,
/// issue memql#5547): an order arrived in the mirror under a store somebody is exercising a
/// candidate against.
///
/// IT FIRES ON EVERY MIRRORED ORDER, which during a backfill is thousands, and that is why the
/// builtin's FIRST act is a map lookup rather than a read. A cluster with no preview open -- which
/// is every cluster almost all of the time -- pays one query every thirty seconds and nothing per
/// order. See integrations/sitepreview/order.go for the cache and its bound.
///
/// AN ORDER ON A STORE NOBODY IS PREVIEWING RECORDS NOTHING, and that is not a failure: it is the
/// ordinary case, and a refusal per mirrored order would make a backfill's log unreadable.
///
/// WHY AN AUTOMATION AND NOT A HOOK IN THE CONNECTOR. The observation belongs to
/// v1:platform:sitePreviewObservation, which is the preview feature's concept; putting the write in
/// integrations/shopify would make the package that talks to Shopify own a platform row, and the
/// module taxonomy is exactly the thing that keeps those separate. An automation is the seam that
/// already exists for "something was written, and another part of the system cares".
@trigger(event="node.created", concept="v1:shopify:order")
automation recordPreviewOrderObservation {
  args {
    id       any
    storeId  any
  }

  noted := builtin sitePreviewNoteOrder(
    orderId: args.id ?? "",
    storeId: args.storeId ?? ""
  )
}
