// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use platform.logic.{ logicBootstrapDefaultPartition, logicPurgeExpiredPolicyTraces }

@enabled
@trigger(event="system.startup")
@description("Seed the default partition row on startup")
automation bootstrapDefaultPartition {
  step run {
    logic bootstrapDefaultPartition { event: event }
  }
}

// purgeExpiredPolicyTraces
// ========================
//
// Daily 02:30 UTC sweep over v1:platform:policyTrace rows older
// than MEMQL_POLICYTRACE_RETENTION_DAYS (default 90). Same
// observation-only pattern as auditEventRetentionSweep:
// MemQL has no row-removal mutation today, so this cron emits
// a "would-expire N rows" publishEvent each tick. Flip to a
// per-row delete once the engine grows a delete() mutation.
//
// Schedule chosen as 02:30 UTC (offset from the 02:00 archive
// purge so the two crons don't contend on the same DB window).
@enabled
@trigger(schedule="0 30 2 * * *")
@description("Daily 02:30 UTC sweep: identifies policy traces past MEMQL_POLICYTRACE_RETENTION_DAYS. Observation-only until MemQL gains row-removal support.")
automation purgeExpiredPolicyTraces {
  step run {
    logic purgeExpiredPolicyTraces { event: event }
  }
}
