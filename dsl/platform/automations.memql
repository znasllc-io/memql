// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.


use common.builtins.{ datasyncDispatchInbound, datasyncReconcileDomains, datasyncContinueBackfills, datasyncRetryInbound }

// ---- The sync runtime's automations (epic memql#4378) ----
//
// Both load on every node type, because every binary loads every concept.
// Both no-op on a node with no connector bound, which is the common case
// -- the builtin answers "skipped" rather than being absent, for the
// reason integrations/shopify's own inbound automation records: an
// executor that is missing fails every inbound row from every source.

/// Offer every staged inbound delivery to the connector its source names. The connector decides
/// whether the delivery is its own; a source nothing serves is skipped, not failed. It hands the
/// dispatcher the row's id and nothing else: the dispatcher reads the source, the body, the delivery
/// metadata, the verifying tier and the signature verdict from the row itself, absent fields
/// included -- a mailbox-reader row carries no headersJson, and a row staged before verifiedBy
/// existed carries no tier.
@trigger(event="node.created", concept="v1:platform:inboundRequest")
@journalOnWrite
automation dispatchInboundToConnector {
  args {
    id  any
  }
  dispatch := builtin datasyncDispatchInbound(inboundRequestId: args.id)
}

/// Sweep mirrored domains whose interval says they are due. Every 10 minutes, because the interval
/// that matters is the DOMAIN's -- this only decides how often the runtime asks the question, and a
/// domain reconciling every 6 hours is not swept 36 times in between.
@trigger(schedule="0 */10 * * * *")
automation reconcileMirroredDomains {
  sweep := builtin datasyncReconcileDomains()
}

/// Carry every queued or running backfill on. Every 5 minutes: a backfill is queued by a connect,
/// a wider grant or a boot, and one store's past arriving within minutes of connecting is the
/// point. A pass works in rounds for four minutes. In each round every store with work left takes
/// one step, so a store's domains follow one another within the pass and no store waits for
/// another to finish; a store still runs one backfill at a time. A round in which every store only
/// waited on an export its origin is still preparing is followed by a ten-second pause.
/// single: a pass that outlasts five minutes is not overlapped by the next one in this process.
@trigger(schedule="0 */5 * * * *")
@mode(single)
automation continueQueuedBackfills {
  continued := builtin datasyncContinueBackfills()
}

/// Try again the failed deliveries whose next try has come. Every minute, because the first retry
/// is due one minute after a failure; a pass with nothing due is one bounded read. Each row is
/// claimed before it is dispatched, so a pass that overlaps the last, or a second cron leader during
/// a failover, never tries one delivery twice at once; single keeps this process from starting a
/// second pass while one runs.
@trigger(schedule="0 * * * * *")
@mode(single)
automation retryFailedInboundDeliveries {
  retried := builtin datasyncRetryInbound()
}

// ---- Custom domains (epic memql#4805) ----

/// Walk every non-terminal custom-domain binding: verify its two DNS records, provision the ones
/// that are ready, and take down the ones being removed.
///
/// EVERY TWO MINUTES, and the number is a decision about the person waiting rather than about load.
/// Somebody has just pasted two records into a registrar and is watching this panel; a propagation
/// that finished thirty seconds ago should not take ten minutes to be noticed. The cost is bounded
/// by the population -- one row per bound hostname, not per request -- and a pass over rows with
/// nothing to do is two status reads and no lookups at all.
///
/// THIS IS THE ONLY RETRY. There is deliberately no manual re-check button anywhere in the product
/// (design D5): a button invites hammering exactly the two things that must not be hammered, a
/// recursive resolver and an ACME endpoint, and it would make the fastest path to a certificate the
/// one where somebody clicks fastest.
@trigger(schedule="0 */2 * * * *")
automation reconcileCustomDomains {
  sweep := builtin customDomainReconcile()
}

/// The same sweep for an account's reserved MemQL name (epic memql#5168), on the same schedule and
/// for the same reasons.
///
/// A SEPARATE AUTOMATION rather than a second statement on the one above. Statements in an
/// automation run in order and a failed one ends the run, so folding these would make a DNS provider
/// timing out on one client's own domain the reason another client's front door stopped being
/// reconciled.
/// They are independent sweeps over independent concepts and they fail independently.
///
/// TWO MINUTES, matched to its sibling: a door's three CNAMEs and a client's own domain propagate
/// on the same internet, and an operator watching both stops in the same window should not see one
/// tick twice as often as the other for no reason they can name.
///
/// THIS IS THE ONLY RETRY. There is no manual re-check button on the MemQL address stop either, and
/// the stop says so -- an absent control with no explanation reads as an omission.
@trigger(schedule="0 */2 * * * *")
automation reconcileAccountFrontDoors {
  sweep := builtin accountFrontDoorReconcile()
}

// ---- update detection (epic memql#4794, D11) ----

/// Notice a push or release for a repository this cluster tracks as a package. Rides the existing
/// inbound seam -- the receiver has already checked the source allowlist and the per-source HMAC by
/// the time a row exists -- so this adds no HTTP surface at all. A delivery matching no package is
/// a no-op: most of a cluster's webhooks are about something else. It hands the feed the row's id
/// and nothing else: the feed reads the source, the body and the signature verdict from the row
/// itself, so what moves a package's update cue is the delivery the receiver verified.
@trigger(event="node.created", concept="v1:platform:inboundRequest")
@journalOnWrite
automation notePackageUpstreamFromWebhook {
  args {
    id  any
  }
  note := builtin packageNoteUpstreamFromWebhook(inboundRequestId: args.id)
}

/// The polling fallback for clusters no webhook can reach. Every 10 minutes, which is the cadence
/// of a cue rather than of a deploy -- nothing here deploys anything, and the person who sees the
/// cue decides whether a ten-minute-old answer was worth acting on.
@trigger(schedule="0 */10 * * * *", node="workbench", lease="package-poll")
automation pollPackageUpstreams {
  poll := builtin packagePollUpstream()
}

/// Close the runs that stopped reporting progress (epic memql#4900, task memql#4902).
///
/// EVERY TWO MINUTES, which is the cadence the threshold is a multiple of: a run heartbeats every
/// fifteen seconds, a stranded one is noticed within a couple of minutes of its last beat, and the
/// OS's rail stops claiming a deploy is building when nothing is.
///
/// Scheduled, so it runs on the CRON LEADER only (component/automations.CronLeader) -- one replica
/// closing each stranded row once, with no advisory lock of its own to get wrong. It is also a
/// MAINTENANCE automation (component/auth/maintenance_actor.go): its read is every owner's runs,
/// which the composite tier admits only to a cluster owner, and the default automation actor is a
/// reader.
@trigger(schedule="0 */2 * * * *")
automation sweepAbandonedPackageDeployments {
  sweep := builtin packageSweepAbandoned()
}

/// Probe due published websites once per cluster through the elected cron leader.
/// No observation means unknown; a saved live state never establishes health.
@trigger(schedule="0 */2 * * * *")
automation checkDeployableHealth {
  sweep := builtin siteHealthSweep()
}

/// Fold the edge's request log into every deployable's website statistics (the 2026-11-08
/// statistics design, section 5).
///
/// EVERY FIVE MINUTES ON THE CRON LEADER, so while runs succeed a figure is at most five minutes
/// behind the traffic it counts, and one replica writes each run. A run folds each request into
/// its day's state once it is two hours old, reads the last two hours again, and publishes today
/// -- every hour of it, because a visit is a window over the whole day's page views and a page view
/// now can stop an earlier hour's one-page visit from being a bounce -- and every earlier day still
/// in the request log that is not yet final. A day becomes final when its fold reaches its end, at
/// 02:00 UTC the next day, so yesterday's late requests are counted, and the days an outage left
/// open are folded by the next run that succeeds (component/sitetraffic/rollup.go).
///
/// THE WORK IS A BUILTIN, builtin siteStatisticsRollup in component/sitetraffic, because none of it
/// is graph work. It reads the edge_request log and writes plain rollup tables, none of them a
/// concept, and its figures are a COUNT(DISTINCT) over visitors and a window over each visitor's
/// page views -- neither a query nor a continuous aggregate can fold them.
///
/// A MAINTENANCE automation (component/auth/maintenance_actor.go): the builtin admits this
/// automation's maintenance principal and no other caller, so the default reader actor would be
/// refused on every run.
@trigger(schedule="0 */5 * * * *")
automation siteStatisticsRollupSweep {
  roll := builtin siteStatisticsRollup()
}

/// Keep the country database current: download DB-IP's IP-to-Country Lite file when the stored
/// release is older than this month (the 2026-11-08 statistics design).
///
/// DAILY AT 04:10 UTC ON THE CRON LEADER, BUT A DOWNLOAD HAPPENS ONCE A MONTH: the builtin does
/// nothing while the stored release is the current month, so the daily schedule exists only to
/// retry. DB-IP serves the current and the previous month and answers 404 for older ones, which is
/// why the cluster fetches the file itself instead of pinning one in the image; a first-of-month
/// 404 falls back to the previous month and the next day's run picks up the new one.
///
/// OFFLINE IS NOT A FAILURE: a cluster with no route to DB-IP keeps the stored database (or none,
/// and then visits have no country), the builtin logs a Warn and answers with the reason, and the
/// run still succeeds, so a quiet cluster does not fail every day.
///
/// A MAINTENANCE automation (component/auth/maintenance_actor.go): the builtin admits this
/// automation's maintenance principal and no other caller. IP Geolocation by DB-IP, CC BY 4.0.
@trigger(schedule="0 10 4 * * *")
automation geoCountryRefreshSweep {
  refresh := builtin geoCountryRefresh()
}

/// The FOURTH observation of a storefront preview, and the only passive one (epic memql#5531,
/// issue memql#5547): an order arrived in the mirror under a store somebody is exercising a
/// candidate against.
///
/// IT FIRES ON EVERY MIRRORED ORDER, which during a backfill is thousands, and that is why the
/// builtin's FIRST act is a map lookup rather than a read. A cluster with no preview open -- which
/// is every cluster almost all of the time -- pays one query every thirty seconds and nothing per
/// order. See integrations/sitepreview/order.go for the cache and its bound.
///
/// AN ORDER ON A STORE NOBODY IS PREVIEWING RECORDS NOTHING, and that is not a failure: it is the
/// ordinary case, and a refusal per mirrored order would make a backfill's log unreadable.
///
/// WHY AN AUTOMATION AND NOT A HOOK IN THE CONNECTOR. The observation belongs to
/// v1:platform:sitePreviewObservation, which is the preview feature's concept; putting the write in
/// integrations/shopify would make the package that talks to Shopify own a platform row, and the
/// module taxonomy is exactly the thing that keeps those separate. An automation is the seam that
/// already exists for "something was written, and another part of the system cares".
@trigger(event="node.created", concept="v1:shopify:order")
automation recordPreviewOrderObservation {
  args {
    id       any
    storeId  any
  }

  noted := builtin sitePreviewNoteOrder(
    orderId: args.id ?? "",
    storeId: args.storeId ?? ""
  )
}

/// Reconcile unsettled bindings independently; a provider failure on one does not stop the rest.
@template
automation customDomainReconcileWorkflow {
 args { bindings []any! }
 for binding in args.bindings if binding.status != "live" && binding.status != "removed" {
  builtin customDomainReconcileBinding(bindingId: binding.id) on error continue
 }
}

/// Each selected account advances its DNS proof independently.
@template
automation accountDomainReconcileWorkflow {
 args { ids []string! }
 for id in args.ids { builtin customDomainReconcileAccount(accountId: id) on error continue }
}

/// Continue existing doors even if reservation reads fail, then report that failure honestly.
@template
automation accountDoorReconcileWorkflow {
 builtin customDomainSyncReservations() on error continue
 doors := builtin customDomainReadDoors()
 for door in doors if door.status != "live" && door.status != "removed" {
  builtin customDomainReconcileDoor(doorId: door.id) on error continue
 }
 builtin customDomainRequireReservations()
}

/// Resume declared retention from shared database cursors every hour.
@trigger(schedule="0 40 * * * *")
automation retireDeclaredConceptVersions {
  sweep := builtin conceptRetentionSweep(dryRun: false)
}

/// Nightly 04:20 UTC, after the 03:20 log and 03:40 work-journal retention: give
/// back the space their deletes left inside closed chunks. At most one chunk a
/// night, chosen for the most space returned among those worth at least 256 MiB
/// and 30% of the chunk; the handler owns the room, WAL and ownership guards.
@trigger(schedule="0 20 4 * * *")
automation reclaimClosedChunkSpace {
  compact := builtin closedChunkCompaction(dryRun: false, minReclaimBytes: 268435456, minReclaimPercent: 30, measureChunks: 4)
}
