// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.traits.{ isActiveRecord, isNotDeleted }

// ---- queries/v1/platform/globalVariable.memql ----

// globalVariable -- Get Single Instance-Wide Configuration Variable
// ======================================================================
//
// Returns a single instance-wide (global) configuration variable by
// name from v1:platform:globalVariable. Used for system configuration
// lookups that are NOT partition-scoped.
//
// Arguments:
//   name (string, required) - The variable name to retrieve
//
// Returns:
//   Array with 0 or 1 variable record:
//   - id: Variable identifier
//   - name: Variable name
//   - value: Variable value (typically string or boolean)
//
// Usage:
//   globalVariable({name: "MEMQL_AUTO_PROVISION_USERS"})
//

/// Get a single instance-wide configuration variable by name (v1:platform:globalVariable)
@unbounded("global variable by unique name -- bounded to a single row")
query globalVariable globalVariable {
  args {
    name  string!
  }
  filter  name==args.name && isActiveRecord
  shape   variableFull
}

// ---- queries/v1/platform/globalVariables.memql ----

// globalVariables -- Get Multiple Instance-Wide Configuration Variables
// ==========================================================================
//
// Returns multiple instance-wide (global) configuration variables by
// name list from v1:platform:globalVariable. Used for bulk
// system-config retrieval.
//
// Arguments:
//   names (array of strings, required) - The variable names to retrieve
//
// Returns:
//   Array of variable records:
//   - id: Variable identifier
//   - name: Variable name
//   - value: Variable value
//
// Usage:
//   globalVariables({names: ["MEMQL_DEFAULT_USER_ROLE", "MEMQL_DEFAULT_USER_THEME"]})
//

/// Get multiple instance-wide configuration variables by name list (v1:platform:globalVariable)
@unbounded("global variables by the requested name set -- bounded by the caller's name list")
query globalVariable globalVariables {
  args {
    names  array!
  }
  filter  name in args.names && isActiveRecord
  shape   variableFull
}

// ---- queries/v1/platform/userDefaults.memql ----

// userDefaults - Query User Provisioning Variables (Internal)
// ============================================================
//
// Returns the default configuration variables used when auto-provisioning new users.
// This is an internal function used by the bootstrapUser automation to retrieve
// default values for new user accounts.
//
// The function queries the v1:platform:globalVariable concept
// (instance-wide defaults) for specific named variables that control
// user provisioning behavior and default settings.
//
// Variables Retrieved:
//   MEMQL_DEFAULT_USER_ROLE     - Default role assigned to new users (e.g., "user", "admin")
//   MEMQL_DEFAULT_USER_THEME    - Default UI theme for new users (e.g., "light", "dark")
//   MEMQL_DEFAULT_USER_LANGUAGE - Default language preference for new users (e.g., "en-US", "es-MX")
//   MEMQL_AUTO_PROVISION_USERS  - Whether to auto-create user records on first login ("true"/"false")
//   MEMQL_UPDATE_LAST_SEEN      - Whether to track user last-seen timestamps ("true"/"false")
//
// Arguments:
//   None - Returns all provisioning-related variables.
//
// Returns:
//   Array of variable records with fields:
//   - id: Variable identifier
//   - globalVariable.name: Variable name (e.g., "MEMQL_DEFAULT_USER_ROLE")
//   - globalVariable.value: Variable value
//   - globalVariable.active: Whether the variable is active
//
// Note:
//   This function is designed to be used by the bootstrapUser automation
//   when creating new user accounts, not called directly from external
//   clients. (It formerly carried @internal, retired under 2026.08 --
//   #2620 ruling / #2708; the annotation only hid it from discovery.)
//
// Usage:
//   userDefaults()  // Returns all user provisioning variables
//

/// Returns default configuration variables for user provisioning. Used by bootstrapUser automation.
@unbounded("user-default variables -- a fixed bounded allow-list of names consumed whole")
query globalVariable userDefaults {
  filter  isActiveRecord && name in ["MEMQL_DEFAULT_USER_ROLE", "MEMQL_DEFAULT_USER_THEME", "MEMQL_DEFAULT_USER_LANGUAGE", "MEMQL_AUTO_PROVISION_USERS", "MEMQL_UPDATE_LAST_SEEN"]
}

/// Per Q7: list missingCapability rows by status, sorted by sightingCount desc. Backs the
/// platform-roadmap prioritization view -- 'most-requested capabilities that the platform doesn't
/// yet support'. Status filter: 'open' for active backlog, 'in_progress' / 'resolved' / 'wontfix'
/// for the audit view.
query missingCapability missingCapabilitiesByStatus {
  args {
    status  string!
  }
  filter  status==args.status
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   missingCapabilityFull
}

/// Per Q7: dedup lookup the Planner Agent runs before logging a new sighting. Returns the existing
/// row (if any) for the (kind, capability) pair so the Planner can call
/// bumpMissingCapabilitySighting instead of creating a duplicate row.
@unbounded("missing capability by (kind,name) -- bounded to a single row")
query missingCapability missingCapabilityByKindAndName {
  args {
    kind        string!
    capability  string!
  }
  filter  kind==args.kind && capability==args.capability
  shape   missingCapabilityFull
}

// ---- queries/v1/platform/outboundRequestsByStatus.memql ----

/// Outbound requests in a given delivery status, oldest first (memql#2521). The outbound worker
/// drains 'pending' and 'retrying' through this; operators and products use it to audit delivery
/// state. Bounded first page: the worker drains batches per poll, so a burst larger than one page
/// simply takes extra polls.
query outboundRequest outboundRequestsByStatus {
  args {
    status  string!
  }
  filter  status==args.status
  sort     "row.createdAt", "asc"
  paginate 50
  shape   outboundRequestFull
}

// ---- queries/v1/platform/inboundRequestsByStatus.memql ----

/// Inbound requests in a given handling status, oldest first (memql#2957). Products drain
/// 'received' through this when they prefer a sweep to the node.created automation; operators use
/// it to audit what arrived. Bounded first page, same as the outbound counterpart.
query inboundRequest inboundRequestsByStatus {
  args {
    status  string!
  }
  filter  status==args.status
  sort     "row.createdAt", "asc"
  paginate 50
  shape   inboundRequestFull
}

// ---- queries/v1/platform/inboundRequestById.memql ----

/// One staged inbound request by its row id. The read a product's handler does when an automation
/// hands it `event.payload.id` and it needs the body, the source and the verification bit (memql#3461 --
/// the campaign feedback ingestion reads all three before it will act on a payload). A by-id read
/// returns at most one row, so it is not a list and declares no pagination.
@unbounded("one inbound request by row id -- bounded to a single row")
query inboundRequest inboundRequestById {
  args {
    requestId  string!
  }
  filter  row.id==args.requestId
  shape   inboundRequestFull
}

// ---- queries/v1/platform/inboundRequestByDedupeKey.memql ----

/// Idempotency lookup the inbound receiver runs before staging (memql#2957): at-least-once
/// redelivery of the same event must collapse onto the existing row rather than stage a duplicate.
@unbounded("inbound request by the sender's dedupe key -- bounded to a single row")
query inboundRequest inboundRequestByDedupeKey {
  args {
    source     string!
    dedupeKey  string!
  }
  filter  source==args.source && dedupeKey==args.dedupeKey
  shape   inboundRequestFull
}

/// Resolve a request Host to the site that answers it. The edge's hot path -- called once per
/// cache miss, not once per request.
///
/// The caller term is the COMPOSITE tier's own predicate, written out (memql#4344). It used to be a
/// bare `actor.isClusterOwner==true`, which under the composite tier would narrow the query to
/// cluster owners ALONE and leave a user unable to resolve their own deployable -- the admin gate is
/// one BRANCH of the tier now, not the whole of it. The engine ANDs this same term in from the
/// concept's declaration; restating it is what the land gate asks for, so that a reader of the query
/// can see the scope without resolving the concept (TestRowAuthzEnforcementLandGate). It is an
/// OWNERSHIP floor rather than a fail-open selection: a false admin gate leaves exactly the caller's
/// own rows. The edge still reads every site because it calls this under a synthetic cluster-owner
/// actor (component/edge's systemEdgeActor), which the second branch admits.
@unbounded("site by hostname -- bounded to a single row (hostname is cluster-unique)")
@actor
query site siteByHostname {
  args {
    hostname  string!
  }
  filter  hostname==args.hostname && isNotDeleted && (ownerUserId==actor.userId || actor.isClusterOwner==true)
  shape   siteFull
}

/// The deployables this caller may see: their OWN sites, or every site in the cluster when the
/// caller is a cluster owner. The portal's primary screen.
///
/// The name predates self-serve deployables and is kept: it is the same read, and the composite tier
/// is what decides how far "all" reaches for a given actor. The caller term is that tier's own
/// predicate written out -- see siteByHostname for why the bare admin gate it replaced would now
/// collapse the read to cluster owners alone.
@actor
query site sitesAll {
  filter  isNotDeleted && (ownerUserId==actor.userId || actor.isClusterOwner==true)
  shape   siteFull
  sort    "hostname", "asc"
}

/// Resolve a site by its own row id (memql#3717). The seam the portal's rollback picker wraps in
/// successive `asOf` timestamps to walk a row's history one version back at a time -- there is no
/// single query that returns every version at once (D10 / #2880), so re-issuing this one under each
/// prior `createdAt` IS the walk. Deliberately carries NO `asOf latest`: that would make the query
/// unwrappable by a caller's own `asOf`, which is exactly the capability the walk needs
/// (dsl/deployment/queries.memql:78-97 documents the same reasoning). Owner-or-cluster-owner per
/// v1:platform:site's composite tier -- see siteByHostname for why the bare admin gate this
/// replaced would now collapse the read to cluster owners alone.
@unbounded("site by id -- bounded to a single row (id is the row's own primary key)")
@actor
query site siteById {
  args {
    siteId  string!
  }
  filter  row.id==args.siteId && isNotDeleted && (ownerUserId==actor.userId || actor.isClusterOwner==true)
  shape   siteFull
}

// ---- The sync runtime's reads (epic memql#4378) ----
//
// Every one of these is cluster-owner gated by its concept's declared
// tier AND states that tier as a top-level conjunct, which is what
// TestRowAuthzEnforcementLandGate requires of an authored query over a
// tier-declaring concept. The drain worker reads them under the engine's
// own operator identity -- the campaigns precedent -- so the conjunct is
// satisfied rather than worked around.

/// Entries one connector still owes delivery on, oldest first so a row's changes leave in the order
/// they were made. `failed` is included: a failed entry is a retry that is due, not a terminal
/// state -- the worker skips the ones whose nextAttemptAt has not come.
@actor
query outboxEntry outboxPending {
  args {
    target  string!
  }
  filter    target==args.target && status in ["pending", "failed"] && actor.isClusterOwner==true
  sort      "row.createdAt", "asc"
  paginate  100
  shape     outboxEntryFull
}

/// The operator's dead-letter queue for one connector: entries that exhausted their attempts and
/// are waiting for a person. Never retried automatically -- that is what makes them dead rather
/// than failed.
@actor
query outboxEntry outboxDeadLetters {
  args {
    target  string!
  }
  filter    target==args.target && status=="dead" && actor.isClusterOwner==true
  sort      "row.createdAt", "desc"
  paginate  100
  shape     outboxEntryFull
}

/// One entry by its own row id -- the seam the retry and discard mutations resolve through.
@unbounded("outbox entry by id -- bounded to a single row (id is the row's own primary key)")
@actor
query outboxEntry outboxEntryById {
  args {
    entryId  string!
  }
  filter  row.id==args.entryId && actor.isClusterOwner==true
  shape   outboxEntryFull
}

/// Health for one (concept, connector, direction). Sorted newest-first because the row id is
/// deterministic per domain, so the append-only history IS the health timeline and the caller wants
/// its tip.
@actor
query syncState syncStateFor {
  args {
    conceptId  string!
    connector  string!
    direction  string!
  }
  filter  conceptId==args.conceptId && connector==args.connector && direction==args.direction && actor.isClusterOwner==true
  sort    "row.createdAt", "desc"
  shape   syncStateFull
}

/// Every domain's health -- the Data origins page's health half.
@actor
query syncState syncStatesAll {
  args {
    connector  string
  }
  filter    actor.isClusterOwner==true && when(args.connector) { connector==args.connector }
  sort      "row.createdAt", "desc"
  paginate  100
  shape     syncStateFull
}
