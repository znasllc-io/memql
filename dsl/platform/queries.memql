// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.traits.{ isActiveRecord, isNotArchived, isNotDeleted, statusIsActive, statusIsArchived }

// ---- queries/v1/platform/globalVariable.memql ----

// globalVariable -- Get Single Instance-Wide Configuration Variable
// ======================================================================
//
// Returns a single instance-wide (global) configuration variable by
// name from v1:platform:globalVariable. Used for system configuration
// lookups that are NOT partition-scoped.
//
// Arguments:
//   name (string, required) - The variable name to retrieve
//
// Returns:
//   Array with 0 or 1 variable record:
//   - id: Variable identifier
//   - name: Variable name
//   - value: Variable value (typically string or boolean)
//
// Usage, as the string a client sends to Execute:
//   globalVariable(name: "MEMQL_AUTO_PROVISION_USERS")
//

/// Get a single instance-wide configuration variable by name (v1:platform:globalVariable)
@unbounded("global variable by unique name -- bounded to a single row")
query globalVariable globalVariable {
  args {
    name  string!
  }
  filter  row => row.name == args.name && isActiveRecord(row)
  shape   variableFull
}

// ---- queries/v1/platform/globalVariables.memql ----

// globalVariables -- Get Multiple Instance-Wide Configuration Variables
// ==========================================================================
//
// Returns multiple instance-wide (global) configuration variables by
// name list from v1:platform:globalVariable. Used for bulk
// system-config retrieval.
//
// Arguments:
//   names (array of strings, required) - The variable names to retrieve
//
// Returns:
//   Array of variable records:
//   - id: Variable identifier
//   - name: Variable name
//   - value: Variable value
//
// Usage, as the string a client sends to Execute:
//   globalVariables(names: ["MEMQL_DEFAULT_USER_ROLE", "MEMQL_DEFAULT_USER_THEME"])
//

/// Get multiple instance-wide configuration variables by name list (v1:platform:globalVariable)
@unbounded("global variables by the requested name set -- bounded by the caller's name list")
query globalVariable globalVariables {
  args {
    names  array!
  }
  filter  row => row.name in args.names && isActiveRecord(row)
  shape   variableFull
}

// ---- queries/v1/platform/userDefaults.memql ----

// userDefaults - Query User Provisioning Variables (Internal)
// ============================================================
//
// Returns the default configuration variables used when auto-provisioning new users.
// This is an internal function used by the bootstrapUser automation to retrieve
// default values for new user accounts.
//
// The function queries the v1:platform:globalVariable concept
// (instance-wide defaults) for specific named variables that control
// user provisioning behavior and default settings.
//
// Variables Retrieved:
//   MEMQL_DEFAULT_USER_ROLE     - Default role assigned to new users (e.g., "user", "admin")
//   MEMQL_DEFAULT_USER_THEME    - Default UI theme for new users (e.g., "light", "dark")
//   MEMQL_DEFAULT_USER_LANGUAGE - Default language preference for new users (e.g., "en-US", "es-MX")
//   MEMQL_AUTO_PROVISION_USERS  - Whether to auto-create user records on first login ("true"/"false")
//   MEMQL_UPDATE_LAST_SEEN      - Whether to track user last-seen timestamps ("true"/"false")
//
// Arguments:
//   None - Returns all provisioning-related variables.
//
// Returns:
//   Array of variable records with fields:
//   - id: Variable identifier
//   - globalVariable.name: Variable name (e.g., "MEMQL_DEFAULT_USER_ROLE")
//   - globalVariable.value: Variable value
//   - globalVariable.active: Whether the variable is active
//
// Note:
//   This function is designed to be used by the bootstrapUser automation
//   when creating new user accounts, not called directly from external
//   clients. (It formerly carried @internal, retired under 2026.08 --
//   #2620 ruling / #2708; the annotation only hid it from discovery.)
//
// Usage, as the string a client sends to Execute:
//   userDefaults()  // Returns all user provisioning variables
//

/// Returns default configuration variables for user provisioning. Used by bootstrapUser automation.
@unbounded("user-default variables -- a fixed bounded allow-list of names consumed whole")
query globalVariable userDefaults {
  filter  row => isActiveRecord(row)
              && row.name in ["MEMQL_DEFAULT_USER_ROLE", "MEMQL_DEFAULT_USER_THEME", "MEMQL_DEFAULT_USER_LANGUAGE", "MEMQL_AUTO_PROVISION_USERS", "MEMQL_UPDATE_LAST_SEEN"]
}

/// Per Q7: list missingCapability rows by status, sorted by sightingCount desc. Backs the
/// platform-roadmap prioritization view -- 'most-requested capabilities that the platform doesn't
/// yet support'. Status filter: 'open' for active backlog, 'in_progress' / 'resolved' / 'wontfix'
/// for the audit view.
query missingCapability missingCapabilitiesByStatus {
  args {
    status  string!
  }
  filter  row => row.status == args.status
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   missingCapabilityFull
}

/// Per Q7: dedup lookup the Planner Agent runs before logging a new sighting. Returns the existing
/// row (if any) for the (kind, capability) pair so the Planner can call
/// bumpMissingCapabilitySighting instead of creating a duplicate row.
@unbounded("missing capability by (kind,name) -- bounded to a single row")
query missingCapability missingCapabilityByKindAndName {
  args {
    kind        string!
    capability  string!
  }
  filter  row => row.kind == args.kind && row.capability == args.capability
  shape   missingCapabilityFull
}

// ---- queries/v1/platform/outboundRequestsByStatus.memql ----

/// Outbound requests in a given delivery status, oldest first (memql#2521). The outbound worker
/// drains 'pending' and 'retrying' through this; operators and products use it to audit delivery
/// state. Bounded first page: the worker drains batches per poll, so a burst larger than one page
/// simply takes extra polls.
query outboundRequest outboundRequestsByStatus {
  args {
    status  string!
  }
  filter  row => row.status == args.status
  sort     "row.createdAt", "asc"
  paginate 50
  shape   outboundRequestFull
}

// ---- queries/v1/platform/inboundRequestsByStatus.memql ----

/// Inbound requests in a given handling status, oldest first (memql#2957). Products drain
/// 'received' through this when they prefer a sweep to the node.created automation; operators use
/// it to audit what arrived. Bounded first page, same as the outbound counterpart.
query inboundRequest inboundRequestsByStatus {
  args {
    status  string!
  }
  filter  row => row.status == args.status
  sort     "row.createdAt", "asc"
  paginate 50
  shape   inboundRequestFull
}

// ---- queries/v1/platform/inboundRequestById.memql ----

/// One staged inbound request by its row id. The read a product's handler does when an automation
/// hands it the staged row's id (`args.id`) and it needs the body, the source and the verification
/// bit (memql#3461 -- the campaign feedback ingestion reads all three before it will act on a
/// payload). A by-id read returns at most one row, so it is not a list and declares no pagination.
@unbounded("one inbound request by row id -- bounded to a single row")
query inboundRequest inboundRequestById {
  args {
    requestId  string!
  }
  filter  row => row.id == args.requestId
  shape   inboundRequestFull
}

// ---- queries/v1/platform/inboundRequestByDedupeKey.memql ----

/// Idempotency lookup the inbound receiver runs before staging (memql#2957): at-least-once
/// redelivery of the same event must collapse onto the existing row rather than stage a duplicate.
@unbounded("inbound request by the sender's dedupe key -- bounded to a single row")
query inboundRequest inboundRequestByDedupeKey {
  args {
    source     string!
    dedupeKey  string!
  }
  filter  row => row.source == args.source && row.dedupeKey == args.dedupeKey
  shape   inboundRequestFull
}

/// Resolve a request Host to the site that answers it. The edge's hot path -- called once per
/// cache miss, not once per request.
///
/// The engine applies the site's organization boundary and app permissions. The edge resolves
/// every served site under its synthetic routing actor; ordinary callers see only authorized
/// organization sites or legacy untied rows admitted by their existing owner rules.
// @cache(30) REASON (memql#4534): TWO LAYERS, deliberately aligned. The edge
// resolver keeps its own per-replica host -> site map in front of this read
// (component/edge/resolve.go, TTL from MEMQL_EDGE_SITE_CACHE_TTL_SECONDS,
// default 30s in app/transport_edge.go), so a site row is cached twice on the
// way to a request. Both layers are event-invalidated on a site write -- the
// edge's off graph.node.*.v1:platform:site, this one off
// cache.invalidate.v1:platform:site -- so in normal operation neither goes
// stale. The TTLs are what remains if an invalidation is ever missed, and the
// INNER backstop must not be looser than the outer one: at the 60s default,
// the edge's 30s bound would be an illusion on any miss, because the layer
// behind it could still hand back a minute-old row. Matching them at 30s makes
// the composition say what it looks like it says.
@cache(30)
@unbounded("site by hostname -- bounded to a single row (hostname is cluster-unique)")
@actor
query site siteByHostname {
  args {
    hostname  string!
  }
  filter  row => row.hostname == args.hostname
              && isNotDeleted(row)

  shape   siteFull
}

/// The deployables within this caller's current organization and app scope, with standing
/// access for cluster operators. The Deployables app's primary screen.
///
/// ARCHIVED ROWS ARE EXCLUDED HERE and listed by sitesArchived instead (epic memql#4794, D10). The
/// exclusion is written out rather than folded into a trait, because it is the one conjunct whose
/// counterpart query deliberately inverts it -- and a reader comparing the two needs to see the same
/// term in both -- here `isNotArchived`, there `statusIsArchived`. The trait is `row.status != "archived"`
/// rather than an allow-list of the other three: status is required, so every row carries one, and
/// != is null-safe against a non-empty literal (memql#1685) -- while an allow-list would silently
/// drop a row the day a fifth value is added.
///
/// The name predates self-serve deployables and is kept: it is the same read, and the concept's tier
/// is what decides how far "all" reaches for a given actor.
///
/// NO CALLER TERM, DELIBERATELY (memql#5303, design 2026-09-11-app-access-grants D4 / D12). The
/// declaration and the engine's strict organization boundary decide the authorized rows.
/// Ownership alone does not bypass organization membership for ordinary callers.
/// This read used to restate the tier's first two arms as
/// `(row.ownerUserId == actor.userId || actor.isClusterOwner == true)`, and an AND with that conjunct can
/// never be widened by the third: a member of Acme's group was admitted to Acme's sites by the tier
/// and then filtered back out by the query, so the list showed the tie to nobody. The engine ANDs
/// the tier in from the declaration; tierDecidesTheRead (component/memql) records this construct as
/// one the tier decides, and TestAPackageTiedToTheSelfAccountIsReadableByItsGroupAndByStaff reads
/// it against a real database for a member, a developer and a stranger.
@actor
query site sitesAll {
  filter  row => isNotDeleted(row) && isNotArchived(row)
  shape   siteFull
  sort    "hostname", "asc"
}

/// Resolve a site by its own row id (memql#3717). The seam the portal's rollback picker wraps in
/// successive `asOf` timestamps to walk a row's history one version back at a time -- there is no
/// single query that returns every version at once (D10 / #2880), so re-issuing this one under each
/// prior `createdAt` IS the walk. Deliberately carries NO `asOf latest`: that would make the query
/// unwrappable by a caller's own `asOf`, which is exactly the capability the walk needs
/// (dsl/deployment/queries.memql:78-97 documents the same reasoning). No caller term: the concept's
/// tier decides the row, for the reason sitesAll gives (memql#5303, D4) -- a site tied to an account
/// is readable by that account's group, and this is the read every site builtin resolves its target
/// through before writing, so the gate a write runs behind admits the same people the list does.
@unbounded("site by id -- bounded to a single row (id is the row's own primary key)")
@actor
query site siteById {
  args {
    siteId  string!
  }
  filter  row => row.id == args.siteId && isNotDeleted(row)
  shape   siteFull
}

// ---- Storefront preview (epic memql#5531) ----
//
// v1:platform:sitePreviewGrant and v1:platform:sitePreviewObservation both
// declare @rowAuthz(owner="ownerUserId", clusterOwner), and every read below
// STATES THAT TIER as a top-level conjunct on top of the declaration.
//
// THAT IS THE OPPOSITE OF WHAT sitesAll DOES, and the difference is the third
// arm. v1:platform:site's tier carries `account="accountId"` as well, so a
// restated `own || clusterOwner` there is a narrowing the declaration never
// asked for -- it filtered a client's own people back out of their own sites.
// These two concepts have no third arm: the conjunct is exactly the tier, so
// stating it changes no result set and makes the scope legible in the filter
// rather than only in the declaration. TestRowAuthzEnforcementLandGate is what
// asks for it, and adjudicating it into tierDecidesTheRead instead would have
// been wrong -- the tier does NOT decide identically for every caller here, it
// decides differently for an owner and for an operator, which is the case that
// entry's own note says is not a candidate.
//
// THE EDGE'S READ IS THE ONE TO BE CAREFUL WITH. sitePreviewGrantByToken turns
// a cookie into a permission to see an unpublished version, so it filters on
// the token DIGEST and on nothing else a caller supplies -- the edge asks it
// under its own synthetic cluster-owner actor, which is what the second arm
// admits. It is still only half the decision: the edge compares the grant's
// candidateRef against the site's, and its expiry and revocation against the
// clock, in component/edge/preview.go -- deliberately in Go rather than in this
// filter, because "the candidate has not changed" is a comparison between two
// rows, and `expiresAt > now` written here would be a freshness rule a reader
// of this file could believe was the whole gate.

/// Resolve a preview grant by the SHA-256 of the token presented, for the edge (issue memql#5545).
///
/// THE DIGEST IS THE ARGUMENT, never the token. The plain `mql_prv_<43>` exists in the operator's
/// URL and cookie and nowhere else; the edge hashes what it was presented and asks this. So a read
/// of the row -- by an operator, out of a backup, in a log -- hands nobody a working preview.
///
/// IT IS NOT THE WHOLE GATE, and the note above says why the rest is in Go. This answers "is there
/// a grant for this digest"; whether it is expired, revoked, for THIS site, and for the candidate
/// the site is currently carrying are four more questions, and three of them compare against
/// something no filter can see.
@unbounded("preview grant by token digest -- bounded to a single row; the digest is the credential and two rows cannot share one")
@actor
query sitePreviewGrant sitePreviewGrantByToken {
  args {
    tokenHash  string!
  }
  filter  row => row.tokenHash == args.tokenHash
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   sitePreviewGrantFull
}

/// Resolve one preview by its own row id -- what the probe and the OS's detail read resolve their
/// target through, so the gate a probe runs behind admits the same people the list does.
@unbounded("preview grant by id -- bounded to a single row (id is the row's own primary key)")
@actor
query sitePreviewGrant sitePreviewGrantById {
  args {
    grantId  string!
  }
  filter  row => row.id == args.grantId
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   sitePreviewGrantFull
}

/// The previews open against one deployable, newest first -- what the Deployables page lists so an
/// operator can see what is out there and end it.
///
/// EVERY GRANT, INCLUDING THE SPENT ONES. Expiry and revocation are shown rather than filtered,
/// because the question this list answers after something unexpected lands in a development store
/// is "who opened a preview of this, and when", and a filtered list answers it for the last half
/// hour only. The OS draws the state; this read does not decide it.
@actor
query sitePreviewGrant sitePreviewGrantsForSite {
  args {
    siteId  string!
  }
  filter  row => row.siteId == args.siteId
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   sitePreviewGrantFull
  sort    "row.createdAt", "desc"
}

/// Every preview that is still usable, cluster-wide -- what the passive order observation reads to
/// decide whether an order arriving in the mirror belongs to anybody's exercise (issue memql#5547).
///
/// THE DEPLOYMENT'S READ, NOT A PERSON'S, and the conjunct says so: it filters on
/// actor.isClusterOwner alone, so the only caller it answers for is the synthetic operator identity
/// integrations/sitepreview stamps. The question -- is anybody previewing against this store -- is
/// the cluster's rather than any operator's, and an owner-scoped read would answer it for one
/// person's previews and silently miss everybody else's.
///
/// UNBOUNDED, AND THE REASON IS THE SWEEP'S. A paginated read would answer for the first page of
/// open previews and quietly record nothing for the rest, which is `customDomainsToReconcile`'s
/// reasoning exactly. The population is bounded by the thing itself: a preview lasts half an hour
/// by default, so this is the handful open right now rather than every one ever issued.
///
/// BOTH ENDS ARE FILTERED HERE. `revokedAt == nil` and `expiresAt > now` are the two ways a preview
/// stops being usable, and a caller re-checks them anyway -- the filter is what keeps the answer
/// small, the Go check is what keeps it correct against a clock that moved between the read and the
/// write.
///
/// NO SORT, and it is not an omission: a sort makes a query paginated, which is precisely what
/// `@unbounded` is here to refuse. The caller indexes the answer by store and never reads it in
/// order.
@unbounded("every preview still usable right now -- bounded by the grant lifetime, and a sweep read that paginated would silently record nothing past its first page")
@actor
query sitePreviewGrant sitePreviewGrantsOpen {
  filter  row => row.revokedAt == nil
              && row.expiresAt > now
              && actor.isClusterOwner == true
  shape   sitePreviewGrantFull
}

/// What the engine observed during one exercise, oldest first -- the four steps in the order they
/// happen, which is the order they are drawn in.
@actor
query sitePreviewObservation sitePreviewObservationsForGrant {
  args {
    grantId  string!
  }
  filter  row => row.grantId == args.grantId
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   sitePreviewObservationFull
  sort    "observedAt", "asc"
}

/// Everything the engine has observed of any preview of one deployable, newest first.
///
/// The read behind the deployable page's preview panel: it shows the LAST exercise without the page
/// having to know which grant that was, which matters because the grant that ran it may already
/// have expired. An empty answer is "nobody has exercised this", which the OS draws as unmeasured
/// rather than as four failures.
@actor
query sitePreviewObservation sitePreviewObservationsForSite {
  args {
    siteId  string!
  }
  filter  row => row.siteId == args.siteId
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   sitePreviewObservationFull
  sort    "observedAt", "desc"
}

// ---- Custom domains (epic memql#4805) ----
//
// v1:platform:customDomain is clusterOwner tier, so every read below states
// `actor.isClusterOwner==true` as a top-level conjunct on top of the declared
// tier -- what TestRowAuthzEnforcementLandGate requires of an authored query
// over a tier-declaring concept, and what the edge's synthetic operator actor
// and the sweep's own satisfy rather than work around.
//
// THE EDGE READ IS THE ONE TO BE CAREFUL WITH. `liveCustomDomainByHostname` is
// what turns a client's own Host header into one of this cluster's sites, so it
// filters on `row.status == "live"` and nothing looser: a `pending_dns` row is a
// hostname somebody typed into a form, and resolving it would let anyone serve
// a site at any name they could spell. The removal path is covered by the same
// conjunct -- `removing` and `removed` both stop resolving the moment the
// status is written, before the Ingress is anywhere near gone.

/// Resolve a request Host to the site a LIVE custom domain binds it to (design D8). The edge's one
/// extra resolution step, asked only after siteByHostname misses.
///
/// `row.status == "live"` is the whole security property of this read. A row reaches `live` only after
/// both DNS checks passed AND the certificate came back Ready, so a hostname answering here is one
/// whose owner proved control of the name and whose traffic this cluster can actually terminate
/// TLS for. Every other status resolves to nothing, which is why a removal takes effect at the
/// speed of a row write rather than at the speed of an Ingress deletion.
@cache(30)
@unbounded("live custom domain by hostname -- bounded to a single row (hostname is cluster-unique)")
@actor
query customDomain liveCustomDomainByHostname {
  args {
    hostname  string!
  }
  filter  row => row.hostname == args.hostname && row.status == "live" && actor.isClusterOwner == true
  shape   customDomainFull
}

/// Every custom domain bound to one deployable, including removed ones. What the Domains panel
/// lists.
///
/// REMOVED ROWS ARE INCLUDED DELIBERATELY. The concept's rows survive removal because the history
/// is the audit, and a list that hid them would make "we un-bound acme.com last Tuesday" a fact
/// only the database remembers. The panel renders a removed row with its terminal status rather
/// than dropping it, so the walk somebody watched stays where they watched it.
@actor
query customDomain customDomainsForSite {
  args {
    siteId  string!
  }
  filter    row => row.siteId == args.siteId && actor.isClusterOwner == true
  sort      "hostname", "asc"
  paginate  100
  shape     customDomainFull
}

/// Every custom domain this cluster knows about. The sweep's read, and the panel's live seed.
///
/// NO STATUS FILTER, and that is what makes it usable as a live collection's seed: a subscription
/// delivers every row the concept writes, so a seed narrowed to non-terminal rows would give the
/// browser a list that grows a `live` row the first time one is touched and never has one on load.
/// The sweep does its own narrowing in Go, over a set this small enough to be honest about -- one
/// row per bound hostname, not per request.
@actor
query customDomain customDomainsAll {
  filter    row => actor.isClusterOwner == true
  sort      "hostname", "asc"
  paginate  200
  shape     customDomainFull
}

/// Every binding the reconciliation sweep still has work for: everything but `live` and `removed`.
///
/// UNPAGINATED, DELIBERATELY, and the narrowing is what makes that defensible. `customDomainsAll`
/// carries a page size because it backs a list somebody scrolls; a SWEEP that read a page would
/// silently never reconcile the bindings past it, and the symptom is a domain that verifies for
/// nobody with nothing in any log to say why. The set here is bounded by how many domains are in
/// flight at once -- a cluster can serve five hundred and have none of them here -- rather than by
/// how many it has ever bound.
///
/// The two settled statuses are excluded rather than filtered out in Go, so a pass over a cluster
/// with nothing happening does no DNS lookups and reads almost nothing.
/// NO `sort`, and the parser is right to insist: a sorted query is a bounded one, and this read is
/// deliberately unbounded. Order costs nothing here either -- the sweep advances each binding
/// independently, so no row's outcome depends on which was looked at first.
@unbounded("custom domains awaiting reconciliation -- an internal sweep that must see all of them, bounded by how many are in flight rather than by how many exist")
@actor
query customDomain customDomainsToReconcile {
  filter  row => row.status in ["pending_dns", "verifying", "issuing", "removing"]
              && actor.isClusterOwner == true
  shape   customDomainFull
}

/// One custom domain by its own row id -- the seam the sweep re-reads through and the panel's
/// gap-recovery read.
@unbounded("custom domain by id -- bounded to a single row (id is the row's own primary key)")
@actor
query customDomain customDomainById {
  args {
    domainId  string!
  }
  filter  row => row.id == args.domainId && actor.isClusterOwner == true
  shape   customDomainFull
}

// ---- The per-account front door (epic memql#5168) ----

/// One LIVE front door by the name it serves beneath -- the edge's third and last resolution step.
///
/// TAKES THE RESERVED NAME, NOT THE HOST, and that split is deliberate. A row stores
/// `memql.acme.com`; the host the edge was asked for is `app.memql.acme.com`. A filter compiles to
/// SQL over stored fields and cannot prepend a label, so one side has to compose -- and doing it in
/// Go (frontdoor.AccountReservedNameFromAppHost, the pinned inverse of AccountRoleHost) keeps the
/// label spelled once. A denormalized appHost column would be a second spelling that drifts the
/// first time the label changes, and the symptom would be every client's door resolving to nothing.
///
/// `row.status == "live"` carries the whole security property, liveCustomDomainByHostname's reasoning one
/// domain over: a door reaches `live` only after all three of its hosts pointed at this cluster AND
/// its certificate came back Ready. Every other status resolves to nothing, so a teardown takes
/// effect at the speed of a row write rather than at the speed of an Ingress deletion.
@cache(30)
@unbounded("live account front door by reserved name -- bounded to a single row (one live door per account, and a reserved name is cluster-unique)")
@actor
query accountFrontDoor liveAccountFrontDoorByReservedName {
  args {
    reservedName  string!
  }
  filter  row => row.reservedName == args.reservedName && row.status == "live" && actor.isClusterOwner == true
  shape   accountFrontDoorFull
}

/// Every front door the reconciliation sweep still has work for: everything but `live` and
/// `removed`.
///
/// UNPAGINATED for customDomainsToReconcile's reason -- a sweep that read a page would silently
/// never reconcile the doors past it, and the symptom is a client's name that verifies for nobody
/// with nothing in any log to say why. Bounded by how many doors are in flight at once, not by how
/// many the cluster has ever served.
///
/// `live` IS EXCLUDED, and the teardown still works, because the sweep does not discover a cleared
/// reservation by walking live doors -- it walks accounts, and a reservation that has gone missing
/// moves its door to `removing` through the account side of the pass. Reading every live door on
/// every tick to ask whether its account still wants it would make the steady state of a healthy
/// cluster the most expensive one.
/// NO `sort`, and the parser is right to insist: a sorted query is a bounded one. Order costs
/// nothing here -- each door advances independently of the others.
@unbounded("account front doors awaiting reconciliation -- an internal sweep that must see all of them, bounded by how many are in flight rather than by how many exist")
@actor
query accountFrontDoor accountFrontDoorsToReconcile {
  filter  row => row.status in ["pending_dns", "verifying", "issuing", "removing"]
              && actor.isClusterOwner == true
  shape   accountFrontDoorFull
}

/// Every front door ever opened for one account, including removed ones. What the Accounts app's
/// MemQL address stop reads.
///
/// REMOVED ROWS ARE INCLUDED, customDomainsForSite's reasoning: the rows survive removal because
/// the history is the audit, and a list that hid them would make "we stopped serving their name
/// last Tuesday" a fact only the database remembers. There is one LIVE door per account; there may
/// be several removed ones, because changing a client's domain tears the old one down (design D9).
@actor
query accountFrontDoor accountFrontDoorsForAccount {
  args {
    accountId  string!
  }
  filter    row => row.accountId == args.accountId && actor.isClusterOwner == true
  sort      "row.createdAt", "desc"
  paginate  50
  shape     accountFrontDoorFull
}

/// Every front door this cluster knows about. The Accounts rail's live seed and the operator's
/// fleet-wide read.
///
/// NO STATUS FILTER, customDomainsAll's reasoning: a subscription delivers every row the concept
/// writes, so a seed narrowed to non-terminal rows would give the browser a list that grows a
/// `live` row the first time one is touched and never has one on load.
@actor
query accountFrontDoor accountFrontDoorsAll {
  filter    row => actor.isClusterOwner == true
  sort      "reservedName", "asc"
  paginate  200
  shape     accountFrontDoorFull
}

/// One front door by its own row id -- the seam the sweep re-reads through.
@unbounded("account front door by id -- bounded to a single row (id is the row's own primary key)")
@actor
query accountFrontDoor accountFrontDoorById {
  args {
    doorId  string!
  }
  filter  row => row.id == args.doorId && actor.isClusterOwner == true
  shape   accountFrontDoorFull
}

/// Every front door that is not `removed` -- what the sweep compares against the accounts holding a
/// reservation, in both directions (design D9).
///
/// INCLUDES `live`, which is the whole point and is what `accountFrontDoorsToReconcile` deliberately
/// leaves out. A door only ever leaves `live` because the RESERVATION behind it went away, and
/// noticing that is a question about the account rather than about the door -- so the sweep reads
/// the reservations, reads this, and takes the difference. Re-checking every live door's DNS on
/// every tick would make the steady state of a healthy cluster the most expensive one; reading this
/// costs a row per account an operator typed.
///
/// Includes `removing` too, so a door already coming down is not asked to come down again on every
/// pass.
///
/// UNPAGINATED for accountFrontDoorsToReconcile's reason: a sweep that read a page would silently
/// never notice the withdrawn reservations past it, and the symptom is a cluster still answering on
/// a client's name after their domain changed.
/// NO `sort`, and the parser is right to insist: a sorted query is a bounded one.
@unbounded("open account front doors -- an internal sweep that must see all of them, bounded by how many accounts hold a reserved name")
@actor
query accountFrontDoor accountFrontDoorsOpen {
  filter  row => row.status in ["pending_dns", "verifying", "issuing", "live", "removing"]
              && actor.isClusterOwner == true
  shape   accountFrontDoorFull
}

// ---- The sync runtime's reads (epic memql#4378) ----
//
// Every one of these is cluster-owner gated by its concept's declared
// tier AND states that tier as a top-level conjunct, which is what
// TestRowAuthzEnforcementLandGate requires of an authored query over a
// tier-declaring concept. The drain worker reads them under the engine's
// own operator identity -- the campaigns precedent -- so the conjunct is
// satisfied rather than worked around.

/// Entries one connector still owes delivery on, oldest first so a row's changes leave in the order
/// they were made. `failed` is included: a failed entry is a retry that is due, not a terminal
/// state -- the worker skips the ones whose nextAttemptAt has not come.
@actor
query outboxEntry outboxPending {
  args {
    target  string!
  }
  filter    row => row.target == args.target
                && row.status in ["pending", "failed"]
                && actor.isClusterOwner == true
  sort      "row.createdAt", "asc"
  paginate  100
  shape     outboxEntryFull
}

/// The operator's dead-letter queue for one connector: entries that exhausted their attempts and
/// are waiting for a person. Never retried automatically -- that is what makes them dead rather
/// than failed.
@actor
query outboxEntry outboxDeadLetters {
  args {
    target  string!
  }
  filter    row => row.target == args.target && row.status == "dead" && actor.isClusterOwner == true
  sort      "row.createdAt", "desc"
  paginate  100
  shape     outboxEntryFull
}

/// One entry by its own row id -- the seam the retry and discard mutations resolve through.
@unbounded("outbox entry by id -- bounded to a single row (id is the row's own primary key)")
@actor
query outboxEntry outboxEntryById {
  args {
    entryId  string!
  }
  filter  row => row.id == args.entryId && actor.isClusterOwner == true
  shape   outboxEntryFull
}

/// Health for one (concept, connector, direction). Sorted newest-first because the row id is
/// deterministic per domain, so the append-only history IS the health timeline and the caller wants
/// its tip.
@actor
query syncState syncStateFor {
  args {
    conceptId  string!
    connector  string!
    direction  string!
  }
  filter  row => row.conceptId == args.conceptId
              && row.connector == args.connector
              && row.direction == args.direction
              && actor.isClusterOwner == true
  sort    "row.createdAt", "desc"
  shape   syncStateFull
}

/// Every domain's health -- the Data origins page's health half.
@actor
query syncState syncStatesAll {
  args {
    connector  string
  }
  filter    row => actor.isClusterOwner == true && (args.connector == nil || row.connector == args.connector)
  sort      "row.createdAt", "desc"
  paginate  100
  shape     syncStateFull
}

// ---- packages (epic memql#4794) ----
//
// THE ARCHIVE IS A PLACE, NOT A VOID (D10), and these queries are where that
// is either true or a slogan. Every list in this tree inherits the isNotDeleted
// tradition, which filters a retired row out of every surface -- and section A
// of the design names that as exactly why D10 exists: an operator who deleted a
// deployable could not find it again to see what it had been. So the default
// lists here filter on status DELIBERATELY rather than by inheritance, and the
// archive listings deliberately do NOT: they select archived rows and return
// them, marked.
//
// NO CALLER TERM ON THE READS THE APP AND THE BUILTINS MAKE (memql#5303,
// design 2026-09-11-app-access-grants D4 / D12). Both concepts declare
// `@rowAuthz(owner="ownerUserId", clusterOwner, account="accountId")`, and
// the engine also enforces current organization membership and app permissions.
// Ownership alone does not bypass that boundary for an ordinary caller.
// These reads used to restate the first two arms as
// `(row.ownerUserId == actor.userId || actor.isClusterOwner == true)`, exactly as
// v1:platform:site's did (memql#4344) -- and an AND with that conjunct cannot
// be widened by the third arm, so a package tied to the cluster's own account
// was admitted by the tier and filtered out by the query, for everyone but its
// owner. The engine ANDs the tier in from the declaration; each construct below
// is recorded in tierDecidesTheRead (component/memql/rowauthz_enforce_gate_test.go)
// and read against a real database by
// TestAPackageTiedToTheSelfAccountIsReadableByItsGroupAndByStaff.
//
// The two FEED reads (packagesByRepoUrl, packagesTrackingRepos) keep the
// written-out term: they run under the engine's own operator identity and are
// not a person's view.

/// The packages this caller may see, active only. The OS packages list.
@actor
query package packagesAll {
  filter  row => statusIsActive(row)
  sort    "name", "asc"
  shape   packageFull
}

/// Archived packages -- the Archived filter's read. Deliberately selects archived
/// rows instead of inheriting a filter that would hide them; see the note above.
@actor
query package packagesArchived {
  filter  row => statusIsArchived(row)
  sort    "name", "asc"
  shape   packageFull
}

/// One package by its row id, whatever its status -- detail opens on an archived
/// package too, which is the point of a visible archive.
@actor
query package packageById {
  args {
    packageId  string!
  }
  filter  row => row.id == args.packageId
  shape   packageFull
}

/// Packages tracking a given repository URL -- the D11 webhook feed's match, and
/// the OS's duplicate check when somebody adds a repo that is already tracked.
///
/// ACTIVE ONLY, exactly as packagesTrackingRepos (memql#5293). Both feeds reach a
/// package through this read -- the webhook directly, the poll per repository --
/// and without the filter they went on writing the two feed-owned fields onto an
/// archived source, and an armed one would have auto-deployed it. An archived
/// source is a place, not a feed target; a re-added source is a new row and
/// matches on its own.
@actor
query package packagesByRepoUrl {
  args {
    repoUrl  string!
  }
  filter  row => row.repoUrl == args.repoUrl
              && statusIsActive(row)

  sort    "name", "asc"
  shape   packageFull
}

/// Every repo-sourced package, for the D11 polling feed's sweep. Runs under the
/// engine's own operator identity, which the admin branch admits; a person
/// calling it reads exactly their own, which is harmless and correct.
@actor
query package packagesTrackingRepos {
  filter    row => row.sourceKind == "repo"
                && statusIsActive(row)

  sort      "name", "asc"
  paginate  200
  shape     packageFull
}

/// One package's deployment timeline, newest first. Append-only, so this IS the
/// history of what was attempted -- not a summary of it.
@actor
query packageDeployment packageDeployments {
  args {
    packageId  string!
  }
  filter    row => row.packageId == args.packageId
  sort      "row.createdAt", "desc"
  paginate  50
  shape     packageDeploymentFull
}

/// Every deploy parked at the confirm gate that is waiting for this caller, newest first -- the
/// Deployables list's "a deploy is waiting for you" mark, and the ONE parked-runs feed the OS retains
/// at its app root (epic memql#4885, design section A). That feed is a deliberate exception to the
/// rule that a deployment timeline is retained by the page and never by the root: the rule guards
/// against subscribing a window to every deploy in the cluster, and a feed over parked runs alone
/// is the handful of rows a person needs to see before they open anything.
///
/// No `paginate`, deliberately, and the reason is the population: a run parks here only between a
/// person's Analyze and their Deploy, so a caller has a handful of these at most and a cluster owner
/// a handful per person -- a page size would be a bound on a set that is bounded by how many things
/// somebody has half-composed. The sort is what keeps the read a bounded one for the parser.
@actor
query packageDeployment packageDeploymentsAwaitingConfirm {
  filter  row => row.status == "awaiting_confirm"
  sort    "row.createdAt", "desc"
  shape   packageDeploymentFull
}

/// One deployment attempt by id -- what the OS polls while a deploy advances and
/// what the confirm gate reads the report from.
@actor
query packageDeployment packageDeploymentById {
  args {
    deploymentId  string!
  }
  filter  row => row.id == args.deploymentId
  shape   packageDeploymentFull
}

/// Every run that is still moving, across every owner -- the abandoned sweep's read (epic
/// memql#4900, task memql#4902).
///
/// CLUSTER-OWNER TIER BY ITS ACTOR rather than by a spec: the concept's composite tier already
/// admits a cluster owner to every row, and the sweep runs under the maintenance actor, which IS
/// one. So the filter says only what it is looking for -- a run at a non-terminal status -- and the
/// tier decides who may see it (memql#5303, D4: no caller term, as every read in this section). The
/// same query read by an ordinary caller answers their own stranded runs and those of the packages
/// they are tied to, which is correct and is not a second code path.
///
/// TWO EXCLUSIONS THAT ARE NOT TERMINAL STATUSES, and both were bugs.
///
/// `awaiting_confirm` is a run PARKED WAITING FOR A PERSON. Nothing is running, so nothing
/// heartbeats, so the sweep closed every parked run ninety seconds after it parked -- the confirm
/// gate had a fuse, and the run died saying "this cluster lost the node that was running this
/// deploy", which was not true of any of them. Measured on a live instance: five runs abandoned in
/// one afternoon, every one of them stopped at `awaiting_confirm`. A parked run rests until the
/// person answers or cancels it; that is the whole point of the gate.
///
/// `cancelled` IS terminal (epic memql#4937, D3) and was simply missed here when it was added --
/// so a person's own stop was swept and overwritten with "this cluster lost the node", which tells
/// somebody their deliberate click was a fault. The authority on which statuses are terminal is
/// `packageDeploymentTerminalStatuses` in component/packages/pipeline.go, and
/// TestInFlightQueryExcludesEveryTerminalStatus holds this filter to it so the two cannot drift
/// again.
///
/// The AGE comparison is deliberately NOT here. "older than the threshold" is arithmetic against a
/// window the sweep is already holding (it comes from the env registry), so comparing in Go over a
/// bounded page keeps ONE answer to "how old is too old" rather than two that can disagree.
@actor
query packageDeployment packageDeploymentsInFlight {
  filter    row => row.status != "succeeded"
                && row.status != "refused"
                && row.status != "failed"
                && row.status != "abandoned"
                && row.status != "cancelled"
                && row.status != "awaiting_confirm"
  sort      "row.createdAt", "asc"
  paginate  500
  shape     packageDeploymentFull
}

/// The sites this package deployed -- the detail panel's deployables list, and
/// the D10 archive gate's own read: a package with a non-archived site refuses to
/// archive, and this is what counts them. Carries NO status filter for exactly
/// that reason; the caller decides what a non-archived site is.
@actor
query site sitesForPackage {
  args {
    packageId  string!
  }
  filter  row => row.packageId == args.packageId && isNotDeleted(row)
  sort    "hostname", "asc"
  shape   siteFull
}

/// Archived sites -- the OS Archived filter for deployables. The default list
/// (sitesAll) shows every non-archived site; this is its counterpart, and the two
/// together are the whole population.
@actor
query site sitesArchived {
  filter  row => statusIsArchived(row) && isNotDeleted(row)
  sort    "hostname", "asc"
  shape   siteFull
}

// ---- source credentials (epic memql#4885) ----
//
// Two reads for people and one for the engine, and the split is the whole
// security shape of the concept: no client-reachable query carries a shape
// that projects `encryptedValue`, and the one query that does is @serverOnly,
// resolved under the PACKAGE OWNER's actor from inside a fetch. The caller term
// on the two people-facing reads is the composite tier's own predicate written
// out -- UNLIKE the package queries above since memql#5303: a credential is a
// personal token, the concept declares no account argument, and the record
// keeps these reads owner-or-cluster-owner.

/// Every credential this caller holds, revoked ones included and marked -- the Settings Sources
/// group. A cluster owner reads every row's metadata, which is the oversight the composite tier
/// exists for; nothing here can return the ciphertext, because the card shape does not carry it.
///
/// The composite term is PARENTHESIZED even though it stands alone, and the parens are load-bearing:
/// the struct form splices this filter after the concept predicate (buildStructQueryExpr), and a
/// bare top-level `a || b` reaches the row-authz shadow analyzer in a shape isCompositeScopeConjunct
/// does not recognise, so TestRowAuthzEnforcementLandGate reports the read undecidable. Written
/// the way every composite-tier sibling writes the term, it is recognised as the tier's own.
@actor
query sourceCredential sourceCredentialsMine {
  filter  row => row.ownerUserId == actor.userId || actor.isClusterOwner == true
  sort    "label", "asc"
  shape   sourceCredentialCard
}

/// One credential by id -- the Source stop's credential chip. Card shape, so metadata only.
@unbounded("credential by id -- bounded to a single row (id is the row's own primary key)")
@actor
query sourceCredential sourceCredentialById {
  args {
    credentialId  string!
  }
  filter  row => row.id == args.credentialId
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   sourceCredentialCard
}

/// THE ONE READ THAT RETURNS CIPHERTEXT, and @serverOnly for exactly that reason: it exists so the
/// fetcher and the poll can unseal a credential from inside a fetch, under
/// auth.ContextWithUserActor(ctx, <the package's owner>), into a local that dies with the call.
///
/// DELIBERATELY NO cluster-owner branch. A cluster owner never needs ciphertext through a query --
/// decryption happens only inside a fetch, and a cluster owner deploying somebody's package fetches
/// under that package's OWN credential, resolved as its owner. The owner term is the whole
/// authorization: a package naming somebody else's credential resolves zero rows here and is
/// refused by name (credential_not_found) before any request leaves the cluster.
///
/// actor.userId scoping is not the fix, and it is already here -- the filter IS owner-scoped. What
/// @serverOnly adds over the scope is the WIRE: a client-callable projection of `encryptedValue` is
/// a ciphertext oracle even for the row's own owner, and nothing a person does needs one, because
/// no browser holds the master key. The only legitimate caller is component/packages, from inside
/// a fetch, under the package owner's borrowed actor and stamped internal origin.
@serverOnly
@unbounded("sealed credential by id -- bounded to a single row (id is the row's own primary key)")
@actor
query sourceCredential sourceCredentialSealedById {
  args {
    credentialId  string!
  }
  filter  row => row.id == args.credentialId && row.ownerUserId == actor.userId
  shape   sourceCredentialSealed
}

// ---- GitHub App grants (epic memql#4912, C5/C6) ----
//
// Two server-only reads, and both run under the GRANT OWNER's actor: the
// connect callback borrows the state row's user before it reads, and
// sourceRepositories runs under the person who clicked. So both are
// owner-scoped exactly as sourceCredentialSealedById is, and that term IS the
// whole authorization.
//
// There is deliberately no cross-owner read here. An earlier draft carried two,
// for a webhook that would have kept installation ids current -- a delivery
// names a GitHub identity and never a MemQL user, so finding the grant it
// belongs to reaches past this concept's tier. The only mechanism for that runs
// the automation as a synthetic CLUSTER OWNER over a body from outside the
// cluster, in exchange for one stale chip on a card, so the ids are refreshed
// on the three paths carrying the owner's own actor instead. Section G of
// docs/superpowers/specs/2026-09-03-github-connect-design.md is the argument.
//
// @serverOnly on both, and caller-scoping is NOT what either withholds: the
// filters ARE caller-scoped. What the annotation withholds is the WIRE. Both
// carry sourceCredentialSealed, which projects `encryptedValue` and
// `refreshToken`, and a client-callable projection of either is a ciphertext
// oracle even for the row's own owner -- exactly the argument
// sourceCredentialSealedById already records. Nothing a person does needs
// them: a grant is unsealed only inside a fetch, a poll, a probe or the
// callback, into a local that dies with the call.

/// The caller's grant for one GitHub account. The connect callback's read, and the compare half of
/// its decision: a grant already here is UPDATED in place, and its absence is what mints a new row.
///
/// Keyed on `externalId`, GitHub's numeric user id, rather than on the login: a person who renames
/// their GitHub account must not acquire a second grant, and a login is a display string that moves.
///
/// actor.userId scoping is not the fix, and it is already here -- the filter IS owner-scoped. What
/// @serverOnly withholds is the WIRE: the sealed shape projects `encryptedValue` and `refreshToken`,
/// and a client-callable projection of either is a ciphertext oracle even for the row's own owner.
@serverOnly
@unbounded("one grant per (owner, GitHub account) -- bounded by construction, not by a page")
@actor
query sourceCredential githubAppGrantByExternalId {
  args {
    externalId  string!
  }
  filter  row => row.kind == "github_app"
              && row.externalId == args.externalId
              && row.ownerUserId == actor.userId
  shape   sourceCredentialSealed
}

/// The caller's active grant. What sourceRepositories and the prefill probe resolve when no
/// credential was named -- a person who has connected GitHub should not have to say which grant,
/// because there is one.
///
/// Revoked grants are excluded by the trait rather than by a bare `row.status == "active"`, and the
/// exclusion is the point: a disconnected grant must read as ABSENT here, so the surface offers
/// Connect rather than a picker that would refuse every repository in it.
///
/// actor.userId scoping is not the fix, and it is already here -- the filter IS owner-scoped, and it
/// carries no cluster-owner branch for the reason sourceCredentialSealedById records. What
/// @serverOnly withholds is the WIRE: this projects the two sealed fields, and no surface a person
/// touches has any use for them.
@serverOnly
@actor
query sourceCredential githubAppGrantForCaller {
  filter  row => row.kind == "github_app" && statusIsActive(row) && row.ownerUserId == actor.userId
  sort    "row.createdAt", "desc"
  shape   sourceCredentialSealed
}

/// Every node's latest verdict on every module: the rows the OS folds live and the moduleReadiness
/// builtin folds on demand. Modules times nodes, consumed whole. Any signed-in caller (the concept's
/// tier); no caller term is written because public, requiresIdentity injects nothing.
@unbounded("module readiness -- modules times nodes, consumed whole by the fold")
query moduleReadiness moduleReadinessAll {
  shape   moduleReadinessFull
  asOf    latest
}

/// The cluster's active embedder.
///
/// ONE ROW, AT A LITERAL ID, so this reads by id rather than by a filter that could return two
/// (memql#5137, D6). A query that answered "which embedder is active" with a list would have no way
/// to choose, and the caller would pick the first -- which is map order wearing a query's name.
@unbounded("the active embedder binding -- one row at a literal id")
@cache(60)
query embedderBinding activeEmbedderBinding {
  filter  row => row.id == "active"
  shape   embedderBindingFull
}

// ---- Measurement and evidence reads (epic memql#5146) ----
//
// The measurement reads are OWNER-SCOPED BY THE TIER rather than by a filter,
// and that is worth stating because the queries below look permissive. The
// concept declares @rowAuthz(owner="ownerUserId", clusterOwner), so a caller
// asking for another person's machine gets zero rows without this file having
// to check -- the same shape every read about somebody's machine already takes.

/// Every measurement for one machine, newest first. The machine page's per-model figures.
///
/// KEYED ON THE MACHINE rather than on the model, because the page is about one machine and a
/// person reading it wants every model it has been measured on -- including the ones they have
/// forgotten they pulled.
@actor
query modelMeasurement measurementsForMachine {
  args {
    machineId  string!
  }
  // The tier's own predicate, spelled out as a top-level conjunct. Declaring a
  // tier narrows every read over the concept, and the enforcement gate requires
  // the filter to IMPLY the tier rather than merely not contradict it -- a read
  // that leaves it implicit is one whose narrowing nobody can check.
  filter   row => row.machineId == args.machineId
               && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  sort     "measuredAt", "desc"
  paginate 200
  shape    modelMeasurementFull
}

/// Every measurement of one model across the machines the caller can read, newest first.
///
/// The fleet-wide half of the same question. A cluster owner sees every machine's figures for a
/// model, which is the read that makes "this model is slow" answerable as "on which hardware".
@actor
query modelMeasurement measurementsForModel {
  args {
    modelId  string!
  }
  filter   row => row.modelId == args.modelId
               && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  sort     "measuredAt", "desc"
  paginate 200
  shape    modelMeasurementFull
}

/// The most recent folded weeks, newest first. The routing evidence view.
///
/// Cluster-owner only by the concept's tier: the question is how a MODEL behaved across the fleet,
/// which is nobody's personal data and everybody's calls.
@actor
query modelEvidence recentModelEvidence {
  args {
    week  string
  }
  // The cluster-owner conjunct stays outside the guard, as a top-level
  // conjunct: that is the term the implication analyzer reads. It used to
  // have to come FIRST as well, when the guard was a `when()` block the
  // analyzer could not see past, so a filter that opened with one was
  // undecidable rather than merely strict -- and an undecidable read is one
  // the enforcement gate cannot pass whatever it actually does. The
  // `(args.week == nil || ...)` guard is an ordinary conjunct, and order no
  // longer matters.
  filter   row => actor.isClusterOwner == true && (args.week == nil || row.week == args.week)
  sort     "foldedAt", "desc"
  paginate 200
  shape    modelEvidenceFull
}

/// One model's evidence at one level for one week -- the row a fold reads before deciding whether
/// it has already proposed, and the row a decline writes back to.
///
/// THE THREE ARGUMENTS ARE THE KEY. A fold that read only by model would re-propose at every level
/// on the same evidence, and one that read only by week would collapse two models into one row.
@actor
query modelEvidence modelEvidenceForKey {
  args {
    modelId  string!
    level    string!
    week     string!
  }
  filter   row => actor.isClusterOwner == true
               && row.modelId == args.modelId
               && row.level == args.level
               && row.week == args.week
  sort     "foldedAt", "desc"
  paginate 5
  shape    modelEvidenceFull
}

/// Every measurement the caller may see, newest first (epic memql#5146, D4).
///
/// The read the LIVE CATALOG makes, so the measured ordering and the page read one fact rather than
/// two. Two readers of "which model is strongest" would disagree eventually, and the disagreement
/// would be invisible, because both answers are plausible.
///
/// UNFILTERED BEYOND THE TIER, deliberately. The concept's own tier decides what comes back -- a
/// plain user sees their own machines' figures, a cluster owner sees the fleet's -- and narrowing
/// further here would be a second implementation of a decision the declaration already made.
@actor
query modelMeasurement measurementsForCaller {
  // PARENTHESIZED, and it is not decoration. A bare top-level disjunction is
  // undecidable to the implication analyzer -- it cannot expand one -- so the
  // enforcement gate reports the read as undecidable rather than as safe or
  // unsafe. The parentheses make it a single composite conjunct the analyzer
  // can match against the tier.
  filter   row => row.ownerUserId == actor.userId || actor.isClusterOwner == true
  sort     "measuredAt", "desc"
  paginate 500
  shape    modelMeasurementFull
}
