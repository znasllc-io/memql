// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@enabled
@useConcept(policyTrace)
@description("Recent persisted policy traces for the named policy, most-recent first.")
query policyTracesForPolicy {
  args {
    policyName  string  @required
  }
  filter  policyTrace.policyName==args.policyName
  shape   policyTraceFull
}

// ---- queries/v1/platform/allPolicyTraces.memql ----

// allPolicyTraces
// ===============
//
// Returns every persisted PolicyTrace row. The
// purgeExpiredPolicyTraces cron iterates the result and per-row
// tests whether createdAt + MEMQL_POLICYTRACE_RETENTION_DAYS is
// past `timestamp()` -- same shape as queryExpiredAuditEvents
// in the identity tree (MemQL filter expressions can't inline
// addDuration today).
//

@enabled
@useConcept(policyTrace)
@description("All persisted policy traces; the retention sweep iterates and per-row checks createdAt + retention-days < now.")
query queryAllPolicyTraces {
  filter  policyTrace.policyName!=""
  shape   policyTraceFull
}

// ---- queries/v1/platform/globalVariable.memql ----

// queryGlobalVariable -- Get Single Instance-Wide Configuration Variable
// ======================================================================
//
// Returns a single instance-wide (global) configuration variable by
// name from v1:platform:globalVariable. Used for system configuration
// lookups that are NOT partition-scoped.
//
// Arguments:
//   name (string, required) - The variable name to retrieve
//
// Returns:
//   Array with 0 or 1 variable record:
//   - id: Variable identifier
//   - name: Variable name
//   - value: Variable value (typically string or boolean)
//
// Usage:
//   queryGlobalVariable({name: "MEMQL_AUTO_PROVISION_USERS"})
//

@enabled
@useConcept(globalVariable)
@description("Get a single instance-wide configuration variable by name (v1:platform:globalVariable)")
query queryGlobalVariable {
  args {
    name  string  @required
  }
  filter  globalVariable.name==args.name; traitIsActiveRecord
  shape   variableFull
}

// ---- queries/v1/platform/globalVariables.memql ----

// queryGlobalVariables -- Get Multiple Instance-Wide Configuration Variables
// ==========================================================================
//
// Returns multiple instance-wide (global) configuration variables by
// name list from v1:platform:globalVariable. Used for bulk
// system-config retrieval.
//
// Arguments:
//   names (array of strings, required) - The variable names to retrieve
//
// Returns:
//   Array of variable records:
//   - id: Variable identifier
//   - name: Variable name
//   - value: Variable value
//
// Usage:
//   queryGlobalVariables({names: ["MEMQL_DEFAULT_USER_ROLE", "MEMQL_DEFAULT_USER_THEME"]})
//

@enabled
@useConcept(globalVariable)
@description("Get multiple instance-wide configuration variables by name list (v1:platform:globalVariable)")
query queryGlobalVariables {
  args {
    names  array  @required
  }
  filter  globalVariable.name in args.names; traitIsActiveRecord
  shape   variableFull
}

// ---- queries/v1/platform/listPartitions.memql ----

// Returns partition rows the caller is allowed to see. Cluster-wide
// owners bypass the ACL (caller.partitions resolves to a
// match-everything sentinel); everyone else sees only partitions
// present in their AccessContext.PartitionACL.
//
// Post-filter in component/grpc/server.go was retired in the Phase 4
// Step 26 rollout -- the filter now lives in the query itself.
//
// The CLI still dedupes to latest-per-id, pins "default" first, and
// sorts the rest alphabetically because directives like sort() /
// paginate() / asOf() cannot appear inside a function body (engine
// init fails). See docs/core/memql-authoring-rules.md gotcha #1.

@enabled
@useConcept(partition)
@description("List partitions visible to the caller (owner sees all)")
query queryListPartitions {
  filter  partition.name in caller.partitions
}

// ---- queries/v1/platform/userDefaults.memql ----

// userDefaults - Query User Provisioning Variables (Internal)
// ============================================================
//
// Returns the default configuration variables used when auto-provisioning new users.
// This is an internal function used by the bootstrapUser automation to retrieve
// default values for new user accounts.
//
// The function queries the v1:platform:globalVariable concept
// (instance-wide defaults) for specific named variables that control
// user provisioning behavior and default settings.
//
// Variables Retrieved:
//   MEMQL_DEFAULT_USER_ROLE     - Default role assigned to new users (e.g., "user", "admin")
//   MEMQL_DEFAULT_USER_THEME    - Default UI theme for new users (e.g., "light", "dark")
//   MEMQL_DEFAULT_USER_LANGUAGE - Default language preference for new users (e.g., "en-US", "es-MX")
//   MEMQL_AUTO_PROVISION_USERS  - Whether to auto-create user records on first login ("true"/"false")
//   MEMQL_UPDATE_LAST_SEEN      - Whether to track user last-seen timestamps ("true"/"false")
//
// Arguments:
//   None - Returns all provisioning-related variables.
//
// Returns:
//   Array of variable records with fields:
//   - id: Variable identifier
//   - globalVariable.name: Variable name (e.g., "MEMQL_DEFAULT_USER_ROLE")
//   - globalVariable.value: Variable value
//   - globalVariable.active: Whether the variable is active
//
// Note:
//   This function is marked @internal and should not be called directly from
//   external clients. It's designed to be used by the bootstrapUser automation
//   when creating new user accounts.
//
// Usage:
//   userDefaults()  // Returns all user provisioning variables
//

@enabled
@useConcept(globalVariable)
@internal
@description("Returns default configuration variables for user provisioning. Used by bootstrapUser automation.")
query queryUserDefaults {
  filter  globalVariable.active==true; globalVariable.name in ["MEMQL_DEFAULT_USER_ROLE", "MEMQL_DEFAULT_USER_THEME", "MEMQL_DEFAULT_USER_LANGUAGE", "MEMQL_AUTO_PROVISION_USERS", "MEMQL_UPDATE_LAST_SEEN"]
}
