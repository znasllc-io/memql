// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// purgeExpiredPolicyTraces
// ========================
//
// Daily 02:30 UTC sweep over v1:platform:policyTrace rows older
// than MEMQL_POLICYTRACE_RETENTION_DAYS (default 90). Same
// observation-only pattern as auditEventRetentionSweep:
// MemQL has no row-removal mutation today, so this cron emits
// a "would-expire N rows" publishEvent each tick. Flip to a
// per-row delete once the engine grows a delete() mutation.
//
// Schedule chosen as 02:30 UTC (offset from the 02:00 archive
// purge so the two crons don't contend on the same DB window).
/// Daily 02:30 UTC sweep over v1:platform:policyTrace rows older than
/// MEMQL_POLICYTRACE_RETENTION_DAYS (default 90). Currently observation-only: emits a
/// 'platform.policyTrace.retention.observed' event with the candidate count. Per-row delete lands
/// when the engine grows a delete() mutation.
logic purgeExpiredPolicyTraces {
  args {
    event object!
  }
  body {
  allTraces := query allPolicyTraces()
  retentionDays := query globalVariable( name: "MEMQL_POLICYTRACE_RETENTION_DAYS" )

  emitObservation := publishEvent(
    topic: "platform.policyTrace.retention.observed",
    payload: {
      candidateCount: allTraces.count(),
      retentionDays: retentionDays.first().payload.value ?? "90",
      timestamp: now
    }
  )

  return allTraces.count()
  }
}

