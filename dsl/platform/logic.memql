// ---- logic/v1/platform/bootstrapDefaultPartition.memql ----

// Ensure the "default" partition exists in v1:platform:partition.
//
// Without this row the CLI's partition list shows up empty even
// though every query implicitly targets "default" -- confusing. Run
// on every startup; createPartition is idempotent (same id "default"
// just appends a new identical version).
//
// Runs on ALL node types but every node hits the same shared
// database, so the redundant inserts are harmless and the row
// converges to its expected state on first boot.
@useMutation(mutationCreatePartition)
@description("Ensures the 'default' partition exists in v1:platform:partition on every startup. Without this row the CLI's partition list shows empty even though queries implicitly target 'default'. Idempotent (re-runs append-only versions of the same id). Runs on every node type; the shared database makes the redundant inserts harmless.")
logic logicBootstrapDefaultPartition {
  args {
    event object
  }
  body {
    return mutationCreatePartition({
      name:          "default",
      partitionType: "standard",
      config:        {}
    })
  }
}

// purgeExpiredPolicyTraces
// ========================
//
// Daily 02:30 UTC sweep over v1:platform:policyTrace rows older
// than MEMQL_POLICYTRACE_RETENTION_DAYS (default 90). Same
// observation-only pattern as auditEventRetentionSweep:
// MemQL has no row-removal mutation today, so this cron emits
// a "would-expire N rows" publishEvent each tick. Flip to a
// per-row delete once the engine grows a delete() mutation.
//
// Schedule chosen as 02:30 UTC (offset from the 02:00 archive
// purge so the two crons don't contend on the same DB window).
@useQuery(queryAllPolicyTraces, queryGlobalVariable)
@description("Daily 02:30 UTC sweep over v1:platform:policyTrace rows older than MEMQL_POLICYTRACE_RETENTION_DAYS (default 90). Currently observation-only: emits a 'platform.policyTrace.retention.observed' event with the candidate count. Per-row delete lands when the engine grows a delete() mutation.")
logic logicPurgeExpiredPolicyTraces {
  args {
    event object @required
  }
  body {
  allTraces := queryAllPolicyTraces({})
  retentionDays := queryGlobalVariable({ name: "MEMQL_POLICYTRACE_RETENTION_DAYS" })

  emitObservation := publishEvent({
    topic: "platform.policyTrace.retention.observed",
    payload: {
      candidateCount: allTraces.Len(),
      retentionDays: coalesce(retentionDays.First().payload.value, "90"),
      timestamp: timestamp()
    }
  })

  return allTraces.Len()
  }
}

    logic purgeExpiredPolicyTraces { event: event }

    logic purgeExpiredPolicyTraces { event: event }
