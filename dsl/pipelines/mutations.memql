// mutations.memql
//
// Writes over the pipelines namespace. Same-domain constructs are ambient, so
// there is no `use pipelines.*` line here (#2617).
//
// WHY EVERY WRITE HERE IS @serverOnly. A pipeline row says which repository,
// installation and grant a cluster drives checks under, and a run row is the
// cluster's testimony about what it checked and how that ended -- the same
// testimony GitHub shows as a required status. A client-reachable write is a
// forged result: a person could mark their own failing run `success`, point
// their pipeline at an installation their grant does not reach, or open a run
// GitHub never asked for. Scoping to actor.userId does not address any of
// that; it would make the forgery correctly attributed and no less a forgery.
// The only writer is component/pipelinerun, after it has proved the grant
// (packages.InstallationToken, verifyGrantRepository) and read the manifest,
// and it writes under the package OWNER'S borrowed authority with internal
// origin. The client-reachable acts are the builtins in builtins.memql, each
// of which checks that the caller owns what it touches.
//
// THE OWNER IS STAMPED, NEVER ACCEPTED. Both creates stamp ownerUserId from
// actor.userId, which under that borrowed authority is the package owner;
// ownerUserId is @serverSet on every concept here, so no argument can name it.
//
// THE UPDATES CARRY NO DEFAULTS, on purpose. Each is a read-merge, and a run
// row has several writers -- the trigger, the driver on whichever agent
// replica holds the lease, a person's cancel, the conclusion -- so a `??`
// default on any argument would write that default over another writer's
// value the moment a write that did not name it landed. Every argument is
// written only when named, and a writer clearing a field names it with its
// empty value ("" for a string, false for cancelRequested, {} or [] for the
// collections). The merge is SHALLOW: heads, timings, notes and stages are
// always sent whole.

/// Connect a pipeline: the one row of a source, at an id derived from the package id. Reconnecting
/// re-runs this insert on the same id, which is a read-merge -- it restates the configuration, marks
/// the pipeline active again and moves connectedAt, while the poll's heads and the timing table
/// survive. compute defaults to `cluster` here, on the create, because nothing about a laptop is a
/// default (plan decision 8).
/// First-PR qualification supplies status qualification at this same atomic insert; it never
/// creates an active row and then disconnects it. Only the native owner-bound opener uses that
/// state, and the ordinary connect path still defaults to active after checking the default head.
///
/// @serverOnly rather than actor.userId scoping: the row is only true after component/pipelinerun
/// has minted a token through the caller's grant and read a `pipeline:` block at the repository's
/// head, and a client-written row could name an installation or a grant nothing verified. The
/// owner is stamped from actor.userId, which under the borrowed authority is the package owner.
@serverOnly
@actor
mutation pipeline createPipeline {
  args {
    pipelineId      string!
    packageId       string!
    accountId       string
    name            string!
    repository      string!
    defaultBranch   string
    installationId  string!
    credentialId    string!
    delivery        string!
    compute         string
    status          string
    secretNames     []string
    channelIds      []string
  }
  insert {
    accept { packageId, accountId, name, repository, defaultBranch, installationId, credentialId, delivery, secretNames, channelIds }
    stamp {
      id: args.pipelineId
      ownerUserId: actor.userId
      compute: args.compute ?? "cluster"
      status: args.status ?? "active"
      connectedAt: now
    }
  }
}

/// Advance a pipeline: its configuration, its status, the poll's heads, the timing table. Read-merge
/// with no defaults, so every field not named keeps its value -- see the header for why.
///
/// @serverOnly: heads decides which SHAs the poll treats as already seen and timings decides how a
/// full run's shards are split, so a client-written value is a way to suppress runs or skew them,
/// and actor.userId scoping would only mean the caller skews their own -- which is still the
/// defect. Disconnecting is the pipelinesDisconnect capability, which checks the caller owns the
/// pipeline before it writes status here.
@serverOnly
mutation pipeline updatePipeline {
  args {
    pipelineId        string!
    name              string
    defaultBranch     string
    delivery          string
    compute           string
    status            string
    secretNames       []string
    channelIds        []string
    heads             object
    timings           object
    timingsRunId      string
    timingsUpdatedAt  string
  }
  update {
    accept { name, defaultBranch, delivery, compute, status, secretNames, channelIds, heads, timings, timingsRunId, timingsUpdatedAt }
    stamp {
      id: args.pipelineId
    }
  }
}

/// Open a run: every open-time field, at a fresh id per attempt. A fork is opened already completed
/// and refused, and a check run GitHub would not take is opened carrying checkRunState and its note,
/// which is why those arrive here as arguments. conclusion and checkRunState are stamped empty when
/// not named, because empty is their pending value.
///
/// @createOnly on the lifecycle fields the DRIVER owns after this write: should a second open ever
/// land on an existing run's id, it must not put a completed or claimed run back to queued.
/// The qualification authority is create-only too: a retry cannot rewrite its approved scope.
///
/// @serverOnly: a run row is the cluster's claim that GitHub asked for a check at this SHA, and a
/// client-opened run would put a check run on a commit nobody pushed; actor.userId scoping would
/// attribute that claim correctly and refuse nothing. The owner is stamped from actor.userId, the
/// pipeline owner's borrowed authority.
@createOnly("status", "conclusion", "checkRunState", "cancelRequested", "qualification")
@serverOnly
@actor
mutation run createPipelineRun {
  args {
    runId           string!
    pipelineId      string!
    accountId       string
    repository      string!
    sha             string!
    mode            string!
    event           string!
    runKey          string!
    attempt         int!
    trigger         string!
    rerunOf         string
    rerunFailedOnly bool
    deliveryId      string
    inboundRequestId string
    pullRequest     int
    headBranch      string
    releaseTag      string
    baseSha         string
    title           string
    version         string
    policySnapshot  object
    qualification   object
    status          string!
    conclusion      string
    refusalCode     string
    refusalMessage  string
    refusalScope    string
    checkRunId      string
    checkRunState   string
    notes           []object
    queuedAt        string!
    finishedAt      string
    durationMs      int
  }
  insert {
    accept { pipelineId, accountId, repository, sha, mode, event, runKey, attempt, trigger, rerunOf, deliveryId, inboundRequestId, pullRequest, headBranch, releaseTag, baseSha, title, version, policySnapshot, qualification, status, refusalCode, refusalMessage, refusalScope, checkRunId, notes, queuedAt, finishedAt, durationMs }
    stamp {
      id: args.runId
      ownerUserId: actor.userId
      conclusion: args.conclusion ?? ""
      checkRunState: args.checkRunState ?? ""
      rerunFailedOnly: args.rerunFailedOnly ?? false
      cancelRequested: false
    }
  }
}

/// Advance a run: the claim and its heartbeat, the work run it compiled into, the stages as they
/// finish, the check run's state, a cancel request, the conclusion. Read-merge with no defaults --
/// four writers share this row, and a default on any argument would erase another's value (see the
/// header).
///
/// @serverOnly: only the driver knows what a run actually did, and the conclusion is what GitHub
/// shows as the required check, so actor.userId scoping would let a caller close their own failing
/// run as a success, which is the whole failure mode. Cancelling is the pipelinesCancel capability,
/// which checks the caller owns the run before it writes cancelRequested here.
@serverOnly
mutation run updatePipelineRun {
  args {
    reviewEvidence     object
    selectionFacts     object
    maintenanceState   string
    maintenanceGoalId  string
    maintenanceMessage string
    runId              string!
    treeHash           string
    status             string
    conclusion         string
    refusalCode        string
    refusalMessage     string
    refusalScope       string
    failureCode        string
    failureMessage     string
    checkRunId         string
    checkRunState      string
    notes              []object
    workRunId          string
    workGoalId         string
    driverNodeId       string
    driverLeaseId      string
    driverHeartbeatAt  string
    cancelRequested    bool
    cancelledBy        string
    stages             []object
    startedAt          string
    finishedAt         string
    durationMs         int
  }
  update {
    accept { reviewEvidence, selectionFacts, maintenanceState, maintenanceGoalId, maintenanceMessage, treeHash, status, conclusion, refusalCode, refusalMessage, refusalScope, failureCode, failureMessage, checkRunId, checkRunState, notes, workRunId, workGoalId, driverNodeId, driverLeaseId, driverHeartbeatAt, cancelRequested, cancelledBy, stages, startedAt, finishedAt, durationMs }
    stamp {
      id: args.runId
    }
  }
}

/// Open a release train: one departure's row, written when the coordinator starts building it.
///
/// @createOnly on state: a second create landing on an existing train's id must not put a running,
/// landed or cancelled train back to building.
///
/// @serverOnly: a train row is the cluster's record of what it is about to merge into main on the
/// owner's approval, and a client-written one could claim pull requests on board that never passed
/// or a head the owner never saw; actor.userId scoping would attribute that claim correctly and
/// refuse nothing. The owner is stamped from actor.userId, the pipeline owner's borrowed authority.
@createOnly("state")
@serverOnly
@actor
mutation train createPipelineTrain {
  args {
    trainId         string!
    pipelineId      string!
    accountId       string
    repository      string!
    branch          string!
    departure       string!
    state           string!
    requested       []int
    replaces        string
    onBoard         []object
    leftOff         []object
    dropped         []object
    version         string
    baseSha         string
    headSha         string
    pullRequest     int
    pullRequestUrl  string
    runId           string
    notified        []string
    departedAt      string!
    updatedAt       string
  }
  insert {
    accept { pipelineId, accountId, repository, branch, departure, state, requested, replaces, onBoard, leftOff, dropped, version, baseSha, headSha, pullRequest, pullRequestUrl, runId, notified, departedAt, updatedAt }
    stamp {
      id: args.trainId
      ownerUserId: actor.userId
      rebuilds: 0
      retried: false
    }
  }
}

/// Advance a release train: its state, what is on board, the run, the approval, the landing. A
/// read-merge with no defaults: the coordinator writes only the fields a transition changes.
///
/// @serverOnly: the state is what lands commits on main -- a client that could write `landing` or an
/// approvedSha would skip the owner's approval, which is the one decision a train never makes for
/// them; actor.userId scoping would refuse nothing, since the owner is the caller it would admit.
@serverOnly
mutation train updatePipelineTrain {
  args {
    trainId         string!
    state           string
    onBoard         []object
    leftOff         []object
    dropped         []object
    version         string
    baseSha         string
    headSha         string
    pullRequest     int
    pullRequestUrl  string
    runId           string
    rebuilds        int
    retried         bool
    approvedBy      string
    approvedSha     string
    landedSha       string
    heldReason      string
    notified        []string
    updatedAt       string
  }
  update {
    accept { state, onBoard, leftOff, dropped, version, baseSha, headSha, pullRequest, pullRequestUrl, runId, rebuilds, retried, approvedBy, approvedSha, landedSha, heldReason, notified, updatedAt }
    stamp {
      id: args.trainId
    }
  }
}

/// Create a notification channel (D16, memql#5480) at a caller-chosen id. The owner is stamped from the
/// actor, which under the borrowed authority is the person saving it.
///
/// @serverOnly rather than actor.userId scoping: a channel names a globalSecret the notify stage will
/// resolve and POST to, and is unique by name per owner; both checks are made by the channel builtin in
/// component/pipelinerun before this write, and a client-written row would skip them.
@serverOnly
@actor
mutation channel createPipelineChannel {
  args {
    channelId   string!
    accountId   string
    name        string!
    kind        string!
    secretRef   string
    recipients  []string
  }
  insert {
    accept { accountId, name, kind, secretRef, recipients }
    stamp {
      id: args.channelId
      ownerUserId: actor.userId
      status: "active"
    }
  }
}

/// Change a channel: its name, kind, secret reference, recipients or status. Read-merge with no
/// defaults, so a field not named keeps its value.
///
/// @serverOnly for createPipelineChannel's reason, and actor.userId scoping is no more the fix here
/// than there: the builtin checks the name stays unique and the secret name is outside the platform's
/// MEMQL_ namespace before it writes here, and an owner-scoped client write would skip both.
@serverOnly
mutation channel updatePipelineChannel {
  args {
    channelId   string!
    name        string
    kind        string
    secretRef   string
    recipients  []string
    status      string
  }
  update {
    accept { name, kind, secretRef, recipients, status }
    stamp {
      id: args.channelId
    }
  }
}
