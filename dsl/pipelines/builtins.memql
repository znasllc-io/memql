// pipelines domain -- the Go-backed capabilities behind a pipeline (epic
// memql#5477). Every executor is integration.pipelines.*, the plug-in in
// component/pipelinerun.
//
// TWO ARE THE RUNNER'S: pipelinesTrigger, for the automation on a staged
// GitHub delivery, and pipelinesPoll, for the every-minute schedule. Neither
// has a person behind it, and each reads across owners under the runner's own
// identity. They carry no @sdk, which keeps them out of the generated SDKs AND
// NOTHING MORE: @sdk has no engine effect, a builtin takes no @serverOnly, and
// any signed-in client's query can name a builtin. So the gate is in the
// HANDLER: each refuses a call that did not arrive with internal origin --
// which the automation executor stamps on a tree-loaded automation's step
// context, and on nothing a client sends -- before it reads anything. And the
// trigger takes no delivery from its caller: it is handed the staged row's id
// and reads the body, the headers and the receiver's signature verdict from
// the row.
//
// THE REST ARE A PERSON'S, and AUTHORIZATION IS NOT IN THESE DECLARATIONS
// beyond the part: each runs under the CALLER's actor and resolves its target
// through an owner-scoped read first (the package for preview and connect, the
// pipeline for disconnect, the run for re-run and cancel), so a caller who does
// not own it resolves zero rows and is refused by name before anything is
// written -- save a cluster owner's disconnect, which reaches any pipeline so
// an operator can free a repository a departed owner's pipeline holds. The part
// is the door, exactly as for the Deployables actions beside them in
// dsl/platform/builtins.memql, and each act has its own (task memql#5498):
// previewing, connecting and disconnecting is `app:deployables/connect`,
// re-running is `app:deployables/rerun`, cancelling is
// `app:deployables/cancel`. The installations read is the Settings Pipelines
// item's (`read app:settings/pipelines`): it asks GitHub about the cluster's
// own app, which is an owner's question, not a source's.

@executor("integration.pipelines.trigger")
@args(profile="object")
@description("Open the pipeline runs a staged GitHub delivery asks for (design record D4-D6). Only the shipped automation reaches it: a call without internal origin is refused before anything is read. Reads the v1:platform:inboundRequest row by its id -- a row on the github source that the inbound receiver signature-verified, or nothing opens -- classifies the event from the SIGNED body's shape -- the X-GitHub-Event header is a cross-check only -- and, for every active pipeline of the delivery's repository whose installation matches, opens one run keyed on (repository, SHA, mode, event): a pull request opened, synchronized or reopened runs affected, a merge group, a push to the default branch and a published release run full, and a re-requested check run or suite re-runs the original's mode and event as a new attempt. A fork's pull request is REFUSED with a failing check run, never queued. A redelivery, or a poll that saw the same head, opens nothing: the run key is the dedup. A delivery matching no pipeline is a no-op, because most of a cluster's webhooks are about something else.")
builtin pipelinesTrigger {
  inboundRequestId  string!  @description("The v1:platform:inboundRequest row the inbound receiver staged. Its body, headers and signature verdict are read from the row; no argument can supply them.")
}

@executor("integration.pipelines.poll")
@description("The polling delivery, every minute (D4, D11). Only the schedule reaches it: a call without internal origin is refused before anything is read. For each active pipeline whose delivery is poll, read the default branch's head and the open pull requests' heads through the owner's grant, and open a push run for a moved default head and a pull_request run (fork-aware) for a new or moved pull request head. The FIRST poll of a pipeline records its heads as a baseline and opens nothing, so connecting never floods a repository's history with runs. Closed pull requests' keys are dropped. Then, on a node that drives runs, recover: claim and drive every queued run no agent claimed and every in-progress run whose driver stopped renewing its lease.")
builtin pipelinesPoll {
}

@sdk
@executor("integration.pipelines.connect")
@args(profile="object")
@requiresCapability("execute", "app:deployables/connect")
@description("Connect a pipeline to one of the caller's sources (D12, D14). The caller must own the package, which must be a GitHub repository source fetched under a grant; the grant must reach the repository, proved by minting an installation token through it. Reads memql-package.yaml at the repository's default-branch head: a source with no `pipeline:` block is refused with pipeline_not_declared; a block that does not validate, or a step whose need or secret this connection's compute and secretNames do not allow, is refused with its own pipeline_* code; and a repository another source already runs is refused with pipeline_already_connected, so a pipeline that could never compile is never connected. Creates the source's one pipeline -- its id derived from the package id -- or reconnects it, which restates the configuration and keeps what the poll has seen. Answers {pipelineId, repository, delivery, compute, stages}, the stages being the block's stage names in order.")
builtin pipelinesConnect {
  packageId    string!    @description("The v1:platform:package source to connect. Must be the caller's own.")
  delivery     string!    @description("How changes reach the pipeline: webhook (a GitHub delivery to this cluster's inbound seam) or poll (every minute, for a cluster GitHub cannot reach).")
  compute      string     @description("Where steps may run: cluster, the default, or cluster_and_fleet to let a step naming a need the cluster cannot meet route to a machine in the caller's fleet.")
  secretNames  []string   @description("The globalSecret NAMES the pipeline's steps may resolve -- the allowlist. A name beginning MEMQL_ is refused. Values are never sent here or stored on the pipeline.")
}

@sdk
@executor("integration.pipelines.disconnect")
@args(profile="object")
@requiresCapability("execute", "app:deployables/connect")
@description("Disconnect one of the caller's pipelines -- or, for a cluster owner, any pipeline, so an operator can free a repository a departed owner's pipeline holds. It opens no more runs, and a run an agent has yet to start concludes with pipeline_disconnected. The pipeline row and every run stay, because they are the history the source's Runs list shows; connecting again reactivates the same pipeline.")
builtin pipelinesDisconnect {
  pipelineId  string!  @description("The v1:pipelines:pipeline to disconnect. Must be the caller's own, unless the caller is a cluster owner.")
}

@sdk
@executor("integration.pipelines.rerun")
@args(profile="object")
@requiresCapability("execute", "app:deployables/rerun")
@description("Re-run one of the caller's pipeline runs: open the next attempt of its run key with the original's mode and event, trigger rerun, rerunOf naming the original, and a new check run. The original stays exactly as it ended.")
builtin pipelinesRerun {
  runId  string!  @description("The v1:pipelines:run to re-run. Must be the caller's own.")
}

@sdk
@executor("integration.pipelines.cancel")
@args(profile="object")
@requiresCapability("execute", "app:deployables/cancel")
@description("Ask one of the caller's pipeline runs to stop. It flags the row and ends nothing itself: the agent driving the run reads the flag at its next heartbeat, cancels what is executing and concludes the run cancelled. A queued run no agent has claimed is concluded cancelled on the spot.")
builtin pipelinesCancel {
  runId  string!  @description("The v1:pipelines:run to stop. Must be the caller's own.")
}
