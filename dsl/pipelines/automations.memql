/// Routine successful builds need two days of downloads; failed runs need a
/// week for diagnosis. Release evidence gets two weeks before unpinned files
/// qualify. Native publication references and deliberately kept Library files
/// always survive these windows. Age begins at actual run completion.
@template
automation pipelineArtifactRetentionPolicy {
  args { terminal bool! ageSeconds int! eventName string! conclusion string! }
  keepSeconds := args.eventName == "release" ? 1209600 :
    args.conclusion == "success" ? 172800 : 604800
  if args.terminal && args.ageSeconds >= keepSeconds {
    return builtin pipelineRetentionSweepPage()
  }
  return {retained: true}
}

/// One bounded page a minute, fairly rotated across producers. A durable
/// per-producer lease protects the pass if cron leadership changes replicas.
@trigger(schedule="30 * * * * *", node="agent", lease="pipelines-artifact-retention")
automation sweepPipelineArtifacts {
  result := builtin pipelinesSweepArtifacts()
}

/// Cleanup one authorized page. Byte retirement precedes Library removal;
/// retained files are skipped, while an unconfirmed provider effect stops the
/// page. A later invocation resumes through the same permanent native journal.
@template
automation retirePipelineArtifacts {
  args { dryRun bool! }
  items := builtin pipelineRetentionItems()
  if !args.dryRun {
    for item in items {
      builtin pipelineRetentionFence(intentId: item.intentId)
      outcome := builtin pipelineRetentionRetire(intentId: item.intentId)
      if !outcome.retained {
        builtin pipelineRetentionPurge(intentId: item.intentId)
      }
    }
  }
  return builtin pipelineRetentionReport()
}

// automations.memql
//
// The pipelines namespace's two triggers (epic memql#5477): a GitHub delivery
// staged on the inbound seam, and the every-minute poll. Both only OPEN runs;
// an agent node claims and drives each one (plan decision 10), so neither
// automation executes a step itself.
//
// NEITHER RUNS UNDER THE MAINTENANCE PRINCIPAL. Both builtins read across
// owners, and component/pipelinerun does those reads under its own synthetic
// cluster-owner actor and every write under the owner's borrowed authority, so
// the automation's default actor is never what a read is judged by.

/// A GitHub delivery opens pipeline runs (design record D4-D6). Filtered to the first, received
/// version of a github row: a status write republishes node.created, and a redelivery collapses onto
/// the same row id, so the trigger's run key is what keeps either from opening a second run. It hands
/// the trigger the row's id and nothing else: the trigger reads the body, the headers and the
/// signature verdict from the row itself. The call is retried, because the delivery is staged once
/// and fires this once: a gate the trigger could not take within its five seconds must not lose it,
/// and the run key makes a retry open only what the failed attempt did not.
@trigger(event="node.created", concept="v1:platform:inboundRequest")
@filter(row => row.source == "github" && row.status == "received")
@journalOnWrite
automation triggerPipelinesOnGitHubDelivery {
  args {
    id  any
  }

  opened := builtin pipelinesTrigger(inboundRequestId: args.id) retry(3)
}

/// Every minute: delivery=poll pipelines read the default branch's head and the open pull requests'
/// heads and open runs for SHAs not seen, and runs no agent claimed, or whose driver went silent, are
/// claimed again (D4, D11). Scheduled, and placed on AGENT replicas only, behind a cron lease of its
/// own (`pipelines-poll`, app/automation_schedule_placement.go): the recovery half claims runs to
/// drive them, and only an agent drives.
@trigger(schedule="0 * * * * *", node="agent", lease="pipelines-poll")
automation pollPipelines {
  polled := builtin pipelinesPoll()
}

/// Once a day: active pipelines are checked at their current default-branch head, and only a
/// manifest declaring a daily or weekly cadence opens the due calendar periods. Weekly scans pin
/// the first head opened that UTC week, including catch-up after a missed Monday. The ordinary
/// agent driver handles each run; this automation executes no pipeline step itself.
@trigger(schedule="0 30 3 * * *", node="agent", lease="pipelines-daily-scan")
automation schedulePipelines {
  scheduled := builtin pipelinesSchedule()
}

/// The default pipeline workflow: stages in manifest order, independent steps
/// concurrently, and declared follow-up stages even after an earlier failure.
/// The pipeline runtime supplies compiled steps and enforces the run lease.
/// A different installed automation may compose these same bounded operations.
@template
automation runPipelineStages {
  args { stages []any! }

  for stage in args.stages {
    facts := builtin pipelineWorkflowFacts()
    if facts.stopped {
      return
    }
    failed := facts.steps.where(prior => prior.stageIndex < stage.stageIndex &&
      (prior.status == "failed" || prior.status == "refused" || prior.status == "cancelled")).first()
    continues := stage.steps.count() > 0 && stage.steps.all(item => item.kind == "notify" || item.runAfterFailure)
    if failed != nil && !continues {
      for item in stage.steps {
        builtin pipelineSkipStep(stepKey: item.key, code: "pipeline_stage_blocked",
          reason: "Not run: stage " + failed.stage + " failed.")
      }
    } else {
      for item in stage.steps parallel(16) {
        action executePipelineStep(stepKey: item.key)
        // Publish the recorded outcome without waiting for slower siblings.
        action reportPipelineProgress()
      }
      if stage.stageIndex < args.stages.count() - 1 {
        action reportPipelineProgress()
      }
    }
  }
}

/// Deliver once, then observe GitHub's asynchronous ingestion. An uncertain
/// write is never retried. The native host accepts only its actual complete
/// receipt; leaving this bounded polling window pending fails the report step.
@template
automation pipelineSARIFDelivery {
  upload := builtin pipelineReportPublish()
  if upload.state != "accepted" { return upload }
  for delay in [2, 5, 10, 20, 30, 60, 60, 60] {
    observed := builtin pipelineReportObserve(waitSeconds: delay)
    if observed.state != "accepted" { return observed }
  }
  return upload
}

/// Stage applicability is pipeline policy: the manifest declares the events
/// and modes, and the sealed workflow decides which stages a run includes.
@template
automation pipelineStageIncluded {
  args { event string! mode string! on []string! runSchedule string! stageSchedule string! }
  if args.event == "schedule" {
    return args.on.any(value => value == "schedule") && args.runSchedule == args.stageSchedule
  }
  if args.event == "manual" {
    return args.on.count() == 0 || args.on.any(value => value == "manual")
  }
  return args.on.count() == 0 || args.on.any(value => value == args.event || value == args.mode)
}

/// Full versus affected package coverage is pipeline policy. Go supplies
/// path and graph facts; this sealed decision keeps any uncertainty on the
/// full-coverage side so an unreadable change cannot produce a false green.
@template
automation pipelinePackageSelection {
  args { mode string! known bool! graphComplete bool! changed []any! }

  moduleGraphChanged := args.changed.any(path =>
    path.baseName == "go.mod" || path.baseName == "go.sum" ||
    path.baseName == "go.work" || path.baseName == "go.work.sum")
  full := args.mode != "affected" || !args.known || args.changed.count() == 0 ||
    !args.graphComplete || args.changed.any(path => !path.repositoryPath) ||
    args.changed.any(path => path.path == "memql-package.yaml") || moduleGraphChanged ||
    args.changed.any(path => path.vendored || path.configuredFull)
  reason := args.mode != "affected" ? "full run mode" :
    !args.known ? "the changed-file comparison is unavailable" :
    args.changed.count() == 0 ? "the change list is empty" :
    !args.graphComplete ? "the import graph is incomplete" :
    args.changed.any(path => !path.repositoryPath) ? "a changed path is not repository-relative" :
    args.changed.any(path => path.path == "memql-package.yaml") ? "the pipeline manifest changed" :
    moduleGraphChanged ? "a Go module graph file changed" :
    args.changed.any(path => path.vendored) ? "vendored code changed" :
    args.changed.any(path => path.configuredFull) ? "a configured full-selection path changed" : ""
  return {full: full, reason: reason}
}

/// Each packages step's source and db-gated filter are pipeline policy. The
/// manifest supplies the step's declarations; this sealed decision chooses
/// the coverage that Go mechanically applies to the import graph.
@template
automation pipelinePackageStepSelection {
  args { mode string! packages string! selectionFull bool! only string! }
  coverage := args.mode != "affected" || args.packages == "all" || args.selectionFull ? "all" : "affected"
  packageFilter := args.only == "" ? "all" : args.only
  return {coverage: coverage, filter: packageFilter}
}

/// A bucket can skip a step only when the run remains safely narrowed, the
/// change list is complete, and no path matched its configured globs. A full
/// package-selection decision runs every bucketed step.
@template
automation pipelineBucketIncluded {
  args { mode string! known bool! changedCount int! selectionFull bool! pathsValid bool! matched bool! }
  return args.mode != "affected" || args.selectionFull || !args.known || args.changedCount == 0 || !args.pathsValid || args.matched
}

/// Pull requests test affected packages; trees that land or ship test the full set.
/// Check re-requests keep their original run's mode and do not select one here.
@template
automation pipelineModeForEvent {
  args { event string! }
  switch args.event {
    case "pull_request" { return "affected" }
    case "merge_group", "push", "release", "schedule", "manual" { return "full" }
    default { return "" }
  }
}

/// Copy and outcome styling are authored separately from the native email/Discord codecs.
@template
automation pipelineNotificationCopy {
 args {
  eventName string! outcome string! pipeline string! version string! sha string! branch string!
  prNumber int! prLabel string! commitTitle string! failedStage string! failedStep string! failedCode string!
  failedMessage string! stages int! stageCount string! durationMs number! duration string!
 }
 subject := args.eventName == "release" ? ("Release" + (args.version == "" ? "" : " " + args.version)) :
  args.eventName == "manual" ? ("Manual run" + (args.sha == "" ? "" : " " + args.sha)) :
  args.eventName == "schedule" ? "Scheduled security scan" :
  args.eventName == "push" ? (args.branch == "" ? ("Push" + (args.sha == "" ? "" : " " + args.sha)) : "Push to " + args.branch) :
  args.eventName == "pull_request" ? ("Pull request" + (args.prNumber > 0 ? " #" + args.prLabel : "")) :
  (args.eventName == "merge_group" ? "Merge queue" : "Run") + (args.sha == "" ? "" : " " + args.sha)
 verdict := args.outcome == "passed" ? " passed" : args.outcome == "recovered" ? " recovered" :
  args.outcome == "failed" ? (" failed" + (args.failedStage == "" ? "" : " at " + args.failedStage)) : ""
 headline := subject + verdict
 commit := args.commitTitle + (args.sha == "" ? "" : ((args.commitTitle == "" ? "" : " ") + "(" + args.sha + ")"))
 passed := (args.stages > 0 ? "All " + args.stageCount + (args.stages == 1 ? " stage" : " stages") + " passed" : "All stages passed") +
  (args.durationMs > 0 ? " in " + args.duration : "") + "."
 failed := (args.failedStep == "" ? "The run" : args.failedStep) + " failed" + (args.failedCode == "" ? "" : ": " + args.failedCode) + "." +
  (args.failedMessage == "" ? "" : " " + args.failedMessage)
 summary := args.outcome == "passed" ? passed : args.outcome == "recovered" ? "Passed after the previous run failed. " + passed :
  args.outcome == "failed" ? failed : ""
 return {username: "MemQL Pipelines", subject: subject, headline: headline,
  title: (args.pipeline == "" ? "" : args.pipeline + " · ") + headline,
  lines: [commit, summary].where(line => line != ""), color: args.outcome == "failed" ? 15158332 : 3066993}
}

/// Release runs export the tag; other runs and unresolved release tags export the commit.
@template
automation pipelineVersionForEvent {
 args { eventName string! sha string! tag string! }
 return args.eventName == "release" && args.tag != "" ? args.tag : args.sha
}

/// Notification outcome is separate from the native aggregation of actual step receipts.
@template
automation pipelineNotificationOutcome {
 args { failed bool! previousFailed bool! }
 return args.failed ? "failed" : args.previousFailed ? "recovered" : "passed"
}

/// A current pull request head replaces older affected validation. Native code
/// still proves repository, request identity and current head before cancellation.
@template
automation pipelineSupersessionPolicy {
 args { event string! mode string! previousMode string! trigger string! }
 return args.event == "pull_request" && args.mode == "affected" && args.previousMode == "affected" && args.trigger != "rerun"
}

/// A queue ref that no longer names the checked tree cannot still land. Unknown
/// provider state retains the run; installations may choose a stricter policy.
@template
automation pipelineRunReconciliation {
 args { event string! trigger string! refState string! status string! }
 return args.event == "merge_group" && (args.refState == "absent" || args.refState == "moved") ? "cancel" : "continue"
}

/// Installations opt into bounded diagnosis through their own policy and
/// analysis template. A copied engine default creates no repair or writer.
@template
automation pipelineMaintenancePolicy {
 args { event string! conclusion string! failureCode string! attempt int! repository string! sha string! }
 return {action: "none", template: "", reason: ""}
}

/// Evidence reuse is explicitly enabled by an installation, separately from a
/// source command's opt-in verification contract. Generic defaults rerun work.
@template
automation pipelineEvidenceReuse {
 args { event string! sourceEvent string! sourceMode string! ageSeconds int! }
 return false
}

/// Independent review is an installed-policy opt-in. An empty reviewer leaves
/// legacy pipeline behavior unchanged and never starts a model call.
@template
automation pipelineIndependentReviewPolicy {
  args { repository string! pipelineId string! ownerUserId string! }
  return ""
}

/// Only an installed policy may permit a pool step to fall back from opted-in
/// Fleet capacity to cloud Jobs. The portable default spends no cloud budget;
/// live machine consent and the operator's cloud admission still apply.
@template
automation pipelineComputePlacementPolicy {
  args { repository string! pipelineId string! ownerUserId string! event string! }
  return {fleetWaitSeconds: 0, cloudFallback: false}
}
