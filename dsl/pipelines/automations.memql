// automations.memql
//
// The pipelines namespace's two triggers (epic memql#5477): a GitHub delivery
// staged on the inbound seam, and the every-minute poll. Both only OPEN runs;
// an agent node claims and drives each one (plan decision 10), so neither
// automation executes a step itself.
//
// NEITHER RUNS UNDER THE MAINTENANCE PRINCIPAL. Both builtins read across
// owners, and component/pipelinerun does those reads under its own synthetic
// cluster-owner actor and every write under the owner's borrowed authority, so
// the automation's default actor is never what a read is judged by.

/// A GitHub delivery opens pipeline runs (design record D4-D6). Filtered to the first, received
/// version of a github row: a status write republishes node.created, and a redelivery collapses onto
/// the same row id, so the trigger's run key is what keeps either from opening a second run. It hands
/// the trigger the row's id and nothing else: the trigger reads the body, the headers and the
/// signature verdict from the row itself. The call is retried, because the delivery is staged once
/// and fires this once: a gate the trigger could not take within its five seconds must not lose it,
/// and the run key makes a retry open only what the failed attempt did not.
@trigger(event="node.created", concept="v1:platform:inboundRequest")
@filter(row => row.source == "github" && row.status == "received")
automation triggerPipelinesOnGitHubDelivery {
  args {
    id  any
  }

  opened := builtin pipelinesTrigger(inboundRequestId: args.id) retry(3)
}

/// Every minute: delivery=poll pipelines read the default branch's head and the open pull requests'
/// heads and open runs for SHAs not seen, and runs no agent claimed, or whose driver went silent, are
/// claimed again (D4, D11). Scheduled, and placed on AGENT replicas only, behind a cron lease of its
/// own (`pipelines-poll`, app/automation_schedule_placement.go): the recovery half claims runs to
/// drive them, and only an agent drives.
@trigger(schedule="0 * * * * *", node="agent", lease="pipelines-poll")
automation pollPipelines {
  polled := builtin pipelinesPoll()
}

/// The default pipeline workflow: stages in manifest order, independent steps
/// concurrently, and declared follow-up stages even after an earlier failure.
/// The pipeline runtime supplies compiled steps and enforces the run lease.
/// A different installed automation may compose these same bounded operations.
@template
automation runPipelineStages {
  args { stages []any! }

  for stage in args.stages {
    facts := builtin pipelineWorkflowFacts()
    if facts.stopped {
      return
    }
    failed := facts.steps.where(prior => prior.stageIndex < stage.stageIndex &&
      (prior.status == "failed" || prior.status == "refused" || prior.status == "cancelled")).first()
    continues := stage.steps.count() > 0 && stage.steps.all(item => item.kind == "notify" || item.runAfterFailure)
    if failed != nil && !continues {
      for item in stage.steps {
        builtin pipelineSkipStep(stepKey: item.key, code: "pipeline_stage_blocked",
          reason: "Not run: stage " + failed.stage + " failed.")
      }
    } else {
      for item in stage.steps parallel(16) {
        action executePipelineStep(stepKey: item.key)
      }
      if stage.stageIndex < args.stages.count() - 1 {
        action reportPipelineProgress()
      }
    }
  }
}

/// Stage applicability is pipeline policy: the manifest declares the events
/// and modes, and the sealed workflow decides which stages a run includes.
@template
automation pipelineStageIncluded {
  args { event string! mode string! on []string! }
  return args.on.count() == 0 || args.on.any(value => value == args.event || value == args.mode)
}

/// Pull requests test affected packages; trees that land or ship test the full set.
/// Check re-requests keep their original run's mode and do not select one here.
@template
automation pipelineModeForEvent {
  args { event string! }
  switch args.event {
    case "pull_request" { return "affected" }
    case "merge_group", "push", "release" { return "full" }
    default { return "" }
  }
}

/// Copy and outcome styling are authored separately from the native email/Discord codecs.
@template
automation pipelineNotificationCopy {
 args {
  eventName string! outcome string! pipeline string! version string! sha string! branch string!
  prNumber int! prLabel string! commitTitle string! failedStage string! failedStep string! failedCode string!
  failedMessage string! stages int! stageCount string! durationMs number! duration string!
 }
 subject := args.eventName == "release" ? ("Release" + (args.version == "" ? "" : " " + args.version)) :
  args.eventName == "push" ? (args.branch == "" ? ("Push" + (args.sha == "" ? "" : " " + args.sha)) : "Push to " + args.branch) :
  args.eventName == "pull_request" ? ("Pull request" + (args.prNumber > 0 ? " #" + args.prLabel : "")) :
  (args.eventName == "merge_group" ? "Merge queue" : "Run") + (args.sha == "" ? "" : " " + args.sha)
 verdict := args.outcome == "passed" ? " passed" : args.outcome == "recovered" ? " recovered" :
  args.outcome == "failed" ? (" failed" + (args.failedStage == "" ? "" : " at " + args.failedStage)) : ""
 headline := subject + verdict
 commit := args.commitTitle + (args.sha == "" ? "" : ((args.commitTitle == "" ? "" : " ") + "(" + args.sha + ")"))
 passed := (args.stages > 0 ? "All " + args.stageCount + (args.stages == 1 ? " stage" : " stages") + " passed" : "All stages passed") +
  (args.durationMs > 0 ? " in " + args.duration : "") + "."
 failed := (args.failedStep == "" ? "The run" : args.failedStep) + " failed" + (args.failedCode == "" ? "" : ": " + args.failedCode) + "." +
  (args.failedMessage == "" ? "" : " " + args.failedMessage)
 summary := args.outcome == "passed" ? passed : args.outcome == "recovered" ? "Passed after the previous run failed. " + passed :
  args.outcome == "failed" ? failed : ""
 return {username: "MemQL Pipelines", subject: subject, headline: headline,
  title: (args.pipeline == "" ? "" : args.pipeline + " · ") + headline,
  lines: [commit, summary].where(line => line != ""), color: args.outcome == "failed" ? 15158332 : 3066993}
}

/// Release runs export the tag; other runs and unresolved release tags export the commit.
@template
automation pipelineVersionForEvent {
 args { eventName string! sha string! tag string! }
 return args.eventName == "release" && args.tag != "" ? args.tag : args.sha
}

/// Notification outcome is separate from the native aggregation of actual step receipts.
@template
automation pipelineNotificationOutcome {
 args { failed bool! previousFailed bool! }
 return args.failed ? "failed" : args.previousFailed ? "recovered" : "passed"
}
