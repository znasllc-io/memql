// shapes.memql
//
// Full projections, one per pipelines concept. Explicit rather than the
// default projection so a later field that ought to stay server-side cannot
// leak by being added to the concept (the Users app lesson, clients/os/README.md).
// Every field here is a name or a fact a person reads: no row in this
// namespace holds a token or a secret value, and secretNames, credentialId and
// secretRef are projected deliberately because they are NAMES.

/// The pipeline's human-facing facts, without polling heads or timing tables.
@row
shape pipeline pipelineSummary {
  row.id
  row.createdAt
  ownerUserId
  accountId
  packageId
  name
  repository
  defaultBranch
  installationId
  delivery
  compute
  status
  secretNames
  channelIds
  connectedAt
}

/// All OS run facts and actions, without immutable execution-policy payloads
/// or replica lease bookkeeping. Steps and artifacts remain detail reads.
@row
shape run pipelineRunSummary {
  row.id
  row.createdAt
  ownerUserId
  accountId
  pipelineId
  repository
  sha
  mode
  event
  runKey
  attempt
  trigger
  rerunOf
  rerunFailedOnly
  pullRequest
  headBranch
  title
  version
  status
  conclusion
  refusalCode
  refusalMessage
  refusalScope
  failureCode
  failureMessage
  checkRunId
  checkRunState
  notes
  workRunId
  workGoalId
  maintenanceState
  maintenanceGoalId
  maintenanceMessage
  cancelRequested
  stages
  queuedAt
  startedAt
  finishedAt
  durationMs
}

/// Every pipeline field the OS and the SDK read.
@row
shape pipeline pipelineFull {
  row.id
  row.createdAt
  ownerUserId
  accountId
  packageId
  name
  repository
  defaultBranch
  installationId
  credentialId
  delivery
  compute
  status
  secretNames
  channelIds
  heads
  timings
  timingsRunId
  timingsUpdatedAt
  connectedAt
}

/// Every run field: the Runs list, the run page and the driver all read runs through this shape, so
/// a field missing here is a field none of them can see.
@row
shape run pipelineRunFull {
  row.id
  row.createdAt
  ownerUserId
  accountId
  pipelineId
  repository
  sha
  treeHash
  mode
  event
  runKey
  attempt
  trigger
  rerunOf
  rerunFailedOnly
  deliveryId
  inboundRequestId
  pullRequest
  headBranch
  releaseTag
  baseSha
  title
  version
  policySnapshot
  qualification
  reviewEvidence
  selectionFacts
  maintenanceState
  maintenanceGoalId
  maintenanceMessage
  status
  conclusion
  refusalCode
  refusalMessage
  refusalScope
  failureCode
  failureMessage
  checkRunId
  checkRunState
  notes
  workRunId
  workGoalId
  driverNodeId
  driverLeaseId
  driverHeartbeatAt
  cancelRequested
  cancelledBy
  stages
  queuedAt
  startedAt
  finishedAt
  durationMs
}

/// Every channel field.
@row
shape channel pipelineChannelFull {
  row.id
  row.createdAt
  ownerUserId
  accountId
  name
  kind
  secretRef
  recipients
  status
}
