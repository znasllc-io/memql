/// Bounded operation within an authorized evidence workflow.
@executor("integration.router.routingReadEvidenceWindows")
@args(profile="object")
builtin routingReadEvidenceWindows {
 days number!
 failureCategories []any!
}

/// Bounded operation within an authorized evidence workflow.
@executor("integration.router.routingEvaluateEvidence")
@args(profile="object")
builtin routingEvaluateEvidence {
 key string!
}

/// Bounded operation within an authorized evidence workflow.
@executor("integration.router.routingPriorEvidence")
@args(profile="object")
builtin routingPriorEvidence {
 key string!
}

/// Bounded operation within an authorized evidence workflow.
@executor("integration.router.routingOpenEvidenceReview")
@args(profile="object")
builtin routingOpenEvidenceReview {
 key string!
 days number!
}

/// Bounded operation within an authorized evidence workflow.
@executor("integration.router.routingWriteEvidence")
@args(profile="object")
builtin routingWriteEvidence {
 key string!
 outcome string!
}

/// Bounded operation within an authorized evidence workflow.
@executor("integration.router.routingRenderEvidenceProposal")
@args(profile="object")
builtin routingRenderEvidenceProposal {
 form object!
 reason string!
}

// ---- Routes (design record 2026-10-18-routes) ----

/// The routes this person can pick for a message in Ask -- Auto, Local and Apps, then their own --
/// each saying whether it can serve every job for them right now, and why not when it cannot. One
/// row: {routes, revision}. The revision is the routing document's, for routeSave and routeReset.
@sdk
@executor("routesForActor")
builtin routesForActor { }

/// Save a route. Without an id, create one of your own (name required). With your own route's id,
/// change it. With `local` or `apps`, change that route for the whole cluster: owner or developer,
/// and the revision from routesForActor. Each job holds one to four sources -- fleet:, app: or
/// federation: -- in the order they are tried. Search and memory is never a route's: every route
/// uses the cluster's embedding model.
@sdk
@executor("routeSave")
builtin routeSave {
  id string
  name string
  fast []string!
  strong []string!
  reasoning []string!
  revision integer
}

/// Delete one of your own routes. Built-in routes cannot be deleted.
@sdk
@executor("routeDelete")
builtin routeDelete {
  id string!
}

/// Restore the cluster's Local or Apps route to MemQL's default. Owner or developer, with the
/// revision from routesForActor.
@sdk
@executor("routeReset")
builtin routeReset {
  id string!
  revision integer!
}

/// Auto's balance for the whole cluster -- Speed, Cost and Quality, 0 to 100 each -- with MemQL's
/// recommended values and whether they were changed. One row.
@sdk
@executor("autoBalance")
builtin autoBalance { }

/// Change Auto's balance for the whole cluster. Owner or developer, with the revision from
/// autoBalance. Reliability always weighs the mean of the three, so no setting trades it away.
@sdk
@executor("autoBalanceSave")
builtin autoBalanceSave {
  speed integer!
  cost integer!
  quality integer!
  revision integer!
}

/// Return Auto's balance to MemQL's recommended values. Owner or developer.
@sdk
@executor("autoBalanceReset")
builtin autoBalanceReset {
  revision integer!
}

/// Your monthly AI budget and what you have spent with metered vendors this month. Your own
/// machines and app subscriptions never count. One row.
@sdk
@executor("myBudget")
builtin myBudget { }

/// Set your monthly AI budget in US dollars, or remove it by leaving monthlyLimitUSD out. Auto
/// keeps your calls inside it.
@sdk
@executor("myBudgetSave")
builtin myBudgetSave {
  monthlyLimitUSD number
}

// ---- Fleet capacity (design record 2026-10-18-routes, "Fleet capacity") ----

/// What each machine you can use can take on right now. One row: {machines, measuredAt}. Each
/// machine says how many calls are in flight against its slots, the memory free for a model and
/// the models already loaded (memory.reported is false when its cockpit does not report capacity,
/// and it is then admitted on its slots alone), how fast it has answered over the last two hours,
/// and whether it is degraded. Every route's fleet door admits machines on these figures before
/// choosing one.
@sdk
@executor("fleetCapacity")
builtin fleetCapacity { }

// ---- API keys (design record 2026-11-21-vendor-accounts-and-api-keys) ----
//
// A person's own API key at a model vendor: the second kind of account that can pay for a vendor
// call, beside the cluster's own. Every client path to a key is one of these builtins. The rows
// beneath them are read and written by integrations/vendorkeys alone, and each builtin decides who
// is asking before it reads or writes anything.
//
// THE KEY CROSSES THE WIRE ONCE, in vendorKeyAdd, for the reason a source credential's token does: a
// secret cannot be sealed in a browser, because the key that seals it exists on nodes and must
// never exist on a laptop. It is sealed there and never sent back. No builtin returns it.
//
// A KEY IS ADDED AND CHANGED BY A PERSON, IN THEIR OWN SESSION. Not by a personal access token, a
// badge, delegated access or a step of a run: a key spends its owner's money, and a run's journal
// would keep whatever a step was handed.

/// Add an API key for Anthropic or OpenAI, as yours. The key is checked first, by listing the
/// vendor's models with it, which sends no prompt and costs nothing; a key the vendor refuses is
/// not saved. Then it is sealed and stored. Your first key at a vendor is your default there. One
/// row: the key's card, which never carries the key.
@sdk
@executor("integration.vendorkeys.add")
@args(profile="object")
@requiresCapability("execute", "app:fleet/keys")
builtin vendorKeyAdd {
  vendor  enum("anthropic", "openai")!  @description("The vendor the key is for.")
  label   string!  @description("Your name for the key, 1 to 60 characters, unlike your other keys' names.")
  key     string!  @secret @description("The API key itself. Read once, checked, sealed and discarded; never stored or echoed in the clear. An organization's admin key is refused.")
}

/// The API keys you can see. One row: {mine, lent, all}. `mine` are your own keys, with their state
/// and settings. `lent` are short cards of keys other people lent to you: the name, the vendor, the
/// owner and whether it works. `all` is every active key on the cluster, for a cluster owner who
/// asks, and is empty for anybody else. No card carries a key's value.
@sdk
@executor("integration.vendorkeys.forActor")
@args(profile="object")
builtin vendorKeysForActor {
  all  boolean  @description("A cluster owner may ask for every active key on the cluster, to stop one. Ignored for anybody else.")
}

/// Change one of your keys: its name, whether it is your default at its vendor, and whether Auto
/// may use it. Leave out what you are not changing. Only the key's owner may: a cluster owner can
/// check and remove a key and cannot change one. One row: the key's card.
@sdk
@executor("integration.vendorkeys.update")
@args(profile="object")
builtin vendorKeyUpdate {
  keyId      string!  @description("The key to change.")
  label      string   @description("A new name, 1 to 60 characters.")
  isDefault  boolean  @description("True makes this your default key at its vendor, in place of the one that was.")
  autoUse    boolean  @description("True lets Auto pay with this key, for you and for the people it is lent to. Off for a new key.")
}

/// Check a key now, by listing its vendor's models with it. It sends no prompt and costs nothing.
/// The key's owner or a cluster owner may. One row: the key's card after the check.
@sdk
@executor("integration.vendorkeys.check")
@args(profile="object")
builtin vendorKeyCheck {
  keyId  string!  @description("The key to check.")
}

/// Remove a key. It stops paying at once and is never used again; the record of it stays. This does
/// not revoke the key at the vendor: delete it there too. The key's owner or a cluster owner may.
/// One row: the key's card.
@sdk
@executor("integration.vendorkeys.remove")
@args(profile="object")
builtin vendorKeyRemove {
  keyId  string!  @description("The key to remove.")
}

/// Who you can lend one of your keys to, and who it is lent to now. One row: {people, groups,
/// currentPeople, currentGroups, everyone, sharing}. The people and groups offered are the ones a
/// machine of yours could be lent to: the groups you are in and the people in them, or everyone when
/// you may already read every person on the cluster. Somebody already on the list is named even
/// when they are no longer offered, so you can see who has the key and take them off. Only the
/// key's owner may ask.
@sdk
@executor("integration.vendorkeys.shareDirectory")
@args(profile="object")
builtin vendorKeyShareDirectory {
  keyId  string!  @description("One of your own keys.")
}

/// Lend one of your keys to named people and groups, or take it back. A person it is lent to pays
/// with it for their own calls, after their own key and before the cluster's account; Auto spends
/// it only if you switched that on for the key. There is no way to lend a key to everyone. Each
/// person and group can be paused without being removed, and the whole list can be. Save the whole
/// audience every time: what you leave out is no longer lent to. Only the key's owner may, in their
/// own session; a cluster owner cannot lend somebody else's key. One row: the key's card.
@sdk
@executor("integration.vendorkeys.setSharing")
@args(profile="object")
builtin vendorKeySetSharing {
  keyId           string!   @description("One of your own keys.")
  mode            enum("owner", "people")!  @description("owner keeps the key to you and clears the list. people lends it to the users and groups named.")
  paused          boolean   @description("Pause everybody at once while keeping the list. Left out, the pause stays as it was.")
  userIds         []string  @description("Under people: the users the key is lent to.")
  groupIds        []string  @description("Under people: the groups whose active members may use the key.")
  pausedUserIds   []string  @description("Users on the list whose own grant is paused.")
  pausedGroupIds  []string  @description("Groups on the list whose grant is paused.")
}

/// What one of your keys paid for this month, from the call records: how many calls and their
/// estimated cost, in total and for each person who used it. One row: {month, calls, estimatedCost,
/// priced, people}. The cost is this cluster's estimate from each model's listed price, not your
/// vendor's invoice; `priced` is false when a model that was called has no price listed here, and
/// the total then leaves those calls out. Only the key's owner may ask.
@sdk
@executor("integration.vendorkeys.activity")
@args(profile="object")
builtin vendorKeyActivity {
  keyId  string!  @description("One of your own keys.")
}
