// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use router.concepts.{ budget }

// Caching (5.5 / memql#1969): the router budget config is a small bounded set
// consulted on routing decisions and changes rarely. 5.4 invalidation evicts
// on any v1:router:budget write; the v1:router:* created/updated/deleted
// forward rules in component/node/routing.go guarantee the eviction fires on
// every replica (this namespace is not in the default forward set).
@enabled
@unbounded("router budgets (optionally by scope) -- a small bounded config set consumed whole")
@description("Returns all active budget rows for the current partition.")
@cache(ttl="120")
query budget queryRouterBudgets {
  args {
    scope  string
  }
  filter  when(args.scope) { payload.scope==args.scope } && traitIsActiveRecord
  shape   budgetFull
}
