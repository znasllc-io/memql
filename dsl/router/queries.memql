// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.traits.{ isActiveRecord }

// Caching (5.5 / memql#1969): the router budget config is a small bounded set
// consulted on routing decisions and changes rarely. 5.4 invalidation evicts
// on any v1:router:budget write; the v1:router:* created/updated/deleted
// forward rules in component/node/routing.go guarantee the eviction fires on
// every replica (this namespace is not in the default forward set).
/// Returns all active budget rows for the current partition.
@unbounded("router budgets (optionally by scope) -- a small bounded config set consumed whole")
@cache(120)
query budget routerBudgets {
  args {
    scope  string
  }
  filter  row => (args.scope == nil || row.scope == args.scope) && isActiveRecord(row)
  shape   budgetFull
}

/// The recent AI routing decisions, newest first. This is how a rule is
/// checked: a rule set nobody can read the consequences of is a set of
/// assertions.
///
/// FLOORED AT admin, WHICH ADMITS ADMIN, DEVELOPER AND OWNER. On this ladder
/// developer (300) outranks admin (200), so an admin floor is the WIDER of the
/// two readings and satisfies memql#5132's "owner or developer" rather than
/// contradicting it.
///
/// The width is a recorded ruling (the AI-settings record's D7): a decision
/// record carries no prompt content, and an admin answering "why did this go
/// to a vendor" needs it. The shape this query projects was built for exactly
/// that reader -- it deliberately omits the prompt and the error message,
/// which are the two fields most likely to carry something a reader of this
/// list should not see -- so a floor that excluded admins would have been the
/// shape and the gate disagreeing about who the list is for.
///
/// v1:router:call declares no @rowAuthz tier, so this gate is the whole of the
/// authorization. Declaring a tier on the concept would narrow every existing
/// read of the cost ledger, and none of the tiers the model can express is
/// true of this row -- memql#5162 records why.
///
/// There is no `limit` argument: the struct-query paginate directive accepts an
/// integer literal only, so a caller-supplied page size is not expressible
/// here. Callers page with the keyset cursor instead, which is the read a live
/// decision list wants anyway.
@requiresRank("admin")
query call routerDecisionsRecent {
  args {
    /// Only decisions at or after this RFC3339 timestamp.
    since    string
    /// Only decisions resolved at this level.
    level    enum("fast", "strong", "reasoning", "embeddings")
    /// Only decisions served through this door.
    door     enum("local", "app", "federation")
    /// Only decisions the named rule made.
    rule     string
    /// Only decisions with this outcome. A park is recorded as its refusal code.
    outcome  string
  }
  filter   row => (args.since == nil || row.createdAt >= args.since)
               && (args.level == nil || row.level == args.level)
               && (args.door == nil || row.door == args.door)
               && (args.rule == nil || row.rule == args.rule)
               && (args.outcome == nil || row.outcome == args.outcome)
  shape    routerDecision
  sort     "row.createdAt", "desc"
  paginate 200
}

// ---- The sharing ledger's read (epic memql#5146) ----

/// Every call served by ONE machine in a window, for that machine's sharing
/// ledger.
///
/// SCOPED BY SURFACE, NOT BY OWNER, and the difference is a wrong answer rather
/// than a style choice. `machineOwnerUserId` is deliberately EMPTY for a call a
/// person ran on their own machine -- it names whose machine served a call when
/// that machine was somebody ELSE's -- so `row.machineOwnerUserId == actor.userId`
/// would return only the calls OTHER people ran on your hardware and none of
/// your own. The fold counts the owner's own calls alongside everybody else's,
/// because the figure answers "how busy has this machine been" rather than "how
/// much have I lent it out", so that filter would show near-zero on a machine
/// its owner uses constantly.
///
/// AUTHORIZATION IS THE CALLER'S OWNERSHIP OF THE MACHINE, checked in the
/// builtin before this runs: `fleetSharingLedger` resolves the registration
/// through the caller's own machines and refuses one that is not theirs, which
/// is the same gate the pull and the probe use. The surface argument is then
/// derived from a registration id the caller has already been proven to own,
/// so it cannot be pointed at somebody else's machine by passing a different
/// string.
///
/// It is a SEPARATE query from routerCallsInWindow for that reason: the fold's
/// read is gated on `actor.isClusterOwner`, which is right for a maintenance
/// sweep and returns zero rows for the machine owner this one serves.
@unbounded("one machine's calls for one ISO week -- the window is the bound, and the fold needs every call in it to count people correctly")
query call routerCallsOnMachine {
  args {
    /// The execution surface, as `fleet:<registrationId>`.
    surface  string!
    /// Inclusive lower bound, RFC3339.
    since    string!
    /// Exclusive upper bound, RFC3339.
    until    string!
  }
  filter  row => row.executionSurface == args.surface
              && row.createdAt >= args.since
              && row.createdAt < args.until
  shape   routerCallLedger
}

// ---- The evidence fold's read (epic memql#5146, D5) ----

/// Every router call in a window, for the nightly evidence fold.
///
/// It reads under `actor.isClusterOwner==true` because its only caller is the fold, running under
/// the cluster's MAINTENANCE PRINCIPAL. The question is how a MODEL behaved across the fleet, not
/// how it behaved for one person, so there is no owner to scope to -- and writing the conjunct is
/// what makes the failure LOUD: strip the principal and this returns zero rows, and the filter says
/// why. Without it a fold that proposes nothing is indistinguishable from a fleet where every model
/// is behaving, which is the one shape of silence this feature exists to break.
@actor
@unbounded("the nightly evidence fold -- an internal sweep that must see every call in the window")
query call routerCallsInWindow {
  args {
    /// Inclusive lower bound, RFC3339.
    since  string!
    /// Exclusive upper bound, RFC3339.
    until  string!
  }
  filter  row => actor.isClusterOwner == true && row.createdAt >= args.since && row.createdAt < args.until
  shape   routerCallEvidence
}
