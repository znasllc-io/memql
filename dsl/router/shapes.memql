use router.concepts.{ budget, call }

@row
@description("Full projection of a v1:router:budget record. The current-period spend is computed client-side by summing v1:router:call rows within the period window -- not stored on the row itself.")
shape budget budgetFull {
  row.id
  row.createdAt
  payload.scope
  payload.scopeId
  payload.periodType
  payload.limitUSD
  payload.alertThresholdPct
  payload.alertSent
  payload.resetAt
  payload.active
}

@row
@description("Comprehensive projection of v1:router:call for the AI Router dashboard -- attribution, provider, token counts, cost, latency, outcome.")
shape call callFull {
  row.id
  row.createdAt
  payload.requestId
  payload.agentId
  payload.userId
  payload.spaceId
  payload.promptName
  payload.policyName
  payload.vendor
  payload.model
  payload.providerName
  payload.inputTokens
  payload.outputTokens
  payload.cachedInputTokens
  payload.tokensEstimated
  payload.inputCost
  payload.outputCost
  payload.cachedInputCost
  payload.totalCost
  payload.pricingConfigured
  payload.timeToFirstTokenMs
  payload.totalDurationMs
  payload.tokensPerSec
  payload.streaming
  payload.outcome
  payload.errorCategory
  payload.errorMessage
  payload.fallbackFromModel
}
