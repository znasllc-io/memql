// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Full projection of a v1:router:budget record. The current-period spend is computed client-side
/// by summing v1:router:call rows within the period window -- not stored on the row itself.
@row
shape budget budgetFull {
  row.id
  row.createdAt
  scope
  scopeId
  periodType
  limitUSD
  alertThresholdPct
  alertSent
  resetAt
  active
}

/// One AI routing decision, as an operator reads it. Projects what was asked
/// for, what served, which rule and policy decided, and what it cost.
///
/// It deliberately projects NEITHER the prompt nor the error message. A
/// decision record answers "why did this go to a vendor", and neither of those
/// is needed to answer it -- while both are the fields most likely to carry
/// something a reader of this list should not see.
@row
shape call routerDecision {
  row.id
  row.createdAt
  requestId
  promptName
  level
  requestedLevel
  servedLevel
  degraded
  rule
  policy
  door
  providerName
  vendor
  model
  servedModel
  servedEffort
  considered
  touches
  minContextTokens
  machineOwnerUserId
  totalCost
  totalDurationMs
  outcome
  billing
  executionSurface
}

/// What the sharing ledger reads: WHERE a call went, WHO it was for, and how
/// much intelligence it asked for. Nothing else, and the narrowness is the
/// promise rather than an economy -- somebody who lends their machine is
/// entitled to know it is being used and not to read what it was used for, so
/// the projection that reaches the fold cannot carry a prompt to leak.
///
/// It is a SEPARATE shape from routerDecision and routerCallEvidence and must
/// stay one. routerDecision answers "why did this go to a vendor" for an
/// operator and projects promptName, model, considered and the costs;
/// routerCallEvidence answers "how did this MODEL behave" for the nightly
/// fold. This one answers "what happened on ONE MACHINE" for the person who
/// lent it. Reusing either of the others would hand this reader fields the
/// promise says they do not get.
///
/// `userId` is projected because PEOPLE ARE COUNTED, and never rendered. The
/// fold turns it into a cardinality and drops it.
@row
shape call routerCallLedger {
  row.id
  executionSurface
  userId
  level
  row.createdAt
}

/// Full projection of one router call, for the nightly evidence fold.
///
/// NARROW ON PURPOSE. The fold counts calls, structured failures and outcomes; it does not read
/// costs, tokens or error messages, and projecting them would put a week of prompt-adjacent text
/// through a sweep that has no use for it.
@row
shape call routerCallEvidence {
  row.id
  model
  promptName
  // The fold groups by (model, level): a model that fails structured output at
  // `reasoning` may be fine at `fast`, so a proposal that did not name a level
  // would demote it everywhere on evidence from one rung. It was READ by the
  // fold and not projected here, which is a value of "" -- every call folding
  // into one empty-level bucket, silently.
  level
  outcome
  errorCategory
  billing
  row.createdAt
}
