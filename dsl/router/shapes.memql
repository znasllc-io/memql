// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@useConcept(budget)
@description("Full projection of a v1:router:budget record. The current-period spend is computed client-side by summing v1:router:call rows within the period window -- not stored on the row itself.")
shape budgetFull {
  row.id
  row.createdAt
  budget.scope
  budget.scopeId
  budget.periodType
  budget.limitUSD
  budget.alertThresholdPct
  budget.alertSent
  budget.resetAt
  budget.active
}

@row
@useConcept(call)
@description("Comprehensive projection of v1:router:call for the AI Router dashboard -- attribution, provider, token counts, cost, latency, outcome.")
shape callFull {
  row.id
  row.createdAt
  call.requestId
  call.agentId
  call.userId
  call.spaceId
  call.promptName
  call.policyName
  call.vendor
  call.model
  call.providerName
  call.inputTokens
  call.outputTokens
  call.cachedInputTokens
  call.tokensEstimated
  call.inputCost
  call.outputCost
  call.cachedInputCost
  call.totalCost
  call.pricingConfigured
  call.timeToFirstTokenMs
  call.totalDurationMs
  call.tokensPerSec
  call.streaming
  call.outcome
  call.errorCategory
  call.errorMessage
  call.fallbackFromModel
}
