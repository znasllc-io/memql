use common.builtins.{ routingProposalCatalog, routingGeneratePolicyProposal, routingGenerateRuleProposal }

// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// routingEvidenceFold
// ===================
//
// Nightly, fold the week's router calls into per-model, per-level evidence and
// propose a demotion where the evidence carries one (epic memql#5146, D5).
//
// NIGHTLY, not every two minutes, and the cadence says what it is for. The
// model-pull and model-probe sweeps close a spinner somebody is looking at
// right now; this one summarises a week, and nobody is waiting on it. 03:30
// puts it after the day's traffic and before anyone reads the result.
//
// IT PROPOSES AND NEVER APPLIES. A rule that appeared overnight because a
// threshold was crossed is an edit nobody made, and a week of bad luck on one
// schema is not a reason to route a whole level elsewhere. The fold opens a
// v1:work:approval of kind routingReview carrying the exact rule text, hashed,
// and a person decides. Declining is RECORDED, which is the difference between
// a proposal and a nag.
//
// It runs on the CRON LEADER, so exactly one replica folds, and it is on the
// maintenance-principal list (component/auth/maintenance_actor.go) because
// routerCallsInWindow reads EVERY owner's calls by nature -- the question is
// how a MODEL behaved across the fleet, not how it behaved for one person.
// Without the principal the read returns zero rows and no error, the fold
// proposes nothing, and a fleet with a failing model is indistinguishable from
// one where everything is behaving: the exact silence this feature exists to
// break.

/// Nightly evidence review. The bounded host binds selected windows and exact proposal hashes;
/// routingEvidenceWorkflow and routingEvidenceProposal own the decisions.
@trigger(schedule="0 30 3 * * *")
automation routingEvidenceFold {
  fold := builtin routingEvidenceFold()
}


/// Compose a routing policy draft; the engine validates the returned proposal and exact revision.
@template
automation routingPolicyProposalWorkflow {
 args { sentence string! }
 catalog := builtin routingProposalCatalog()
 builtin routingGeneratePolicyProposal(prompt: "composeRoutingPolicy", data: { sentence: args.sentence, catalog: catalog.encoded })
}

/// Compose a routing rule draft from the current catalog and supported match keys.
@template
automation routingRuleProposalWorkflow {
 args { sentence string! whenKeys []any! }
 catalog := builtin routingProposalCatalog()
 builtin routingGenerateRuleProposal(prompt: "compileRule", data: {
  sentence: args.sentence, whenKeys: args.whenKeys, policies: catalog.policies,
  levels: ["fast", "strong", "reasoning", "embeddings"]
 })
}

/// Count evidence, consult the review policy, and persist its outcome. Applying a rule always needs native approval validation.
@template
automation routingEvidenceWorkflow {
 keys := builtin routingReadEvidenceWindows(days: 7, failureCategories: ["structured", "schema", "validation", "contract"])
 for key in keys {
  proposed := builtin routingEvaluateEvidence(key: key)
  if proposed {
   prior := builtin routingPriorEvidence(key: key)
   if prior in ["declined", "demotion", "promotion"] {
    builtin routingWriteEvidence(key: key, outcome: prior)
   } else {
    builtin routingOpenEvidenceReview(key: key, days: 14)
    builtin routingWriteEvidence(key: key, outcome: "none")
   }
  } else {
   builtin routingWriteEvidence(key: key, outcome: "none")
  }
 }
}

/// Evidence floors, thresholds, proposed routing form and explanation are review policy.
@template
automation routingEvidenceProposal {
 args {
  valid bool! model string! level string! week string! calls int! failures int!
  callsText string! failuresText string! failureRate number! percent string! direction string!
  measured bool! validity number! validityPercent string!
 }
 if !args.valid { return false }
 if args.direction == "demotion" {
  if args.calls < 20 || args.failureRate <= 0.3 { return false }
  builtin routingRenderEvidenceProposal(
   form: {description: "Generated from " + args.week + " evidence: " + args.failuresText + " of " + args.callsText + " structured calls to " + args.model + " at level " + args.level + " failed.",
    policy: "localFirst", precedence: 50, onUnavailable: "degrade", excludes: ["fleet:" + args.model]},
   reason: args.failuresText + " of " + args.callsText + " structured calls to " + args.model + " at level " + args.level + " failed in " + args.week + " (" + args.percent + "%), over the 20-call floor and above the 30% threshold. Approving adds a rule excluding it at that level; declining records the decision so this week's evidence does not ask again."
  )
 } else {
  if !args.measured || args.validity < 0.9 { return false }
  builtin routingRenderEvidenceProposal(
   form: {description: "Generated from a probe: " + args.model + " measured well enough at level " + args.level + " to be routed again.",
    policy: "localFirst", precedence: 50, onUnavailable: "degrade", excludes: []},
   reason: args.model + " is excluded at level " + args.level + ", and a probe since then measured " + args.validityPercent + "% structured validity -- at or above the 90% bar. Approving retires the exclusion; declining records the decision so this week's evidence does not ask again."
  )
 }
 return true
}
