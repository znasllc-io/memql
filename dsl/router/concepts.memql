// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use agents.concepts.{ agent }

/// Spend limit for a partition or a specific agent within a partition. The router checks the
/// current-period spend against this cap before every AI call; over-budget calls are refused with a
/// typed error that surfaces in the UI as a clear 'budget reached' state. Rolls over at periodType
/// boundary (UTC day, week, or month).
@displayCard(primary="scopeId", secondary="scope", tertiary="periodType", status="active")
concept budget {
  scope            enum("partition", "agent")!  @description("Whether this budget caps the whole partition or a single agent.")
  scopeId          string  @description("When scope=agent, the v1:agents:agent id being capped. Empty when scope=partition.")
  periodType       enum("daily", "weekly", "monthly")!  @description("Budget window. Resets at UTC midnight / Monday / first-of-month.")
  limitUSD         float!  @description("Maximum USD spend allowed during one period. The router refuses calls once ledger totals reach this figure.")
  alertThresholdPct int    @description("Emit an alert event when spend crosses this percentage of the limit (e.g. 80 for early warning). 0 disables early alerts.")
  alertSent        bool    @description("True when the threshold alert for the current period has been emitted. setBudget does not write it, and it does not need to: an absent value reads as false, i.e. not yet alerted, which is the correct born state. Reset to false on period rollover.")
  resetAt          datetime  @description("The next UTC moment the period rolls over. The router uses this to decide whether to reset alertSent.")
  active           bool  @description("When false the budget is ignored (calls proceed unchecked). Useful for temporary overrides during incident response.")

  @relationship(type="references", field="scopeId", target=agent, direction="outgoing")
}

/// One AI invocation recorded by the MemQL AI Router. Every call through the router -- agent
/// replies, prompt renders, suggest endpoints, TTS, transcription -- produces exactly one row here
/// with attribution, token counts, latency, and cost. Partition-scoped usage ledger; the
/// time-series axis rides the shared MemoryNodes hypertable.
/// @rowAuthz(public, requiresIdentity) -- THE TIER THAT IS TRUE OF THIS ROW,
/// and it is not the one memql#5162 recommended. The issue asked for an unowned
/// RANK FLOOR; measuring the readers showed a rank floor cannot serve them.
///
/// `userId` here is ATTRIBUTION -- the person whose call was served -- and not
/// ownership. The row is the DEPLOYMENT'S: nobody can delete it, nobody can
/// edit it, and it exists whether or not that person still does. So
/// `owner="userId"` was the obvious declaration and the wrong one; it asserts a
/// guarantee nothing provides, and TestDeclaredOwnerFieldsAreServerStamped
/// refuses it, correctly -- recordRouterCall writes the field from CALLER ARGS.
/// It cannot be server-stamped either, because the writer's actor IS
/// system:router, so stamping actor.userId would make the router the owner of
/// every row.
///
/// THREE CONSTRUCTS READ THIS CONCEPT AND THEIR AUTHORIZATIONS ARE THREE
/// DIFFERENT KINDS. That is the measurement memql#5162 did not have, and it is
/// what rules a rank floor out:
///
///   routerDecisionsRecent   @requiresRank("admin")        admin and above
///   routerCallsInWindow     actor.isClusterOwner==true    the maintenance principal
///   routerCallsOnMachine    NO rank gate -- fleetSharingLedger proves the
///                           caller owns the machine first, and the surface
///                           argument is derived from a registration already
///                           proven theirs                 ANY rank
///
/// The Fleet app carries no role floor, so the third reader is a plain writer
/// who paired a laptop, asking how busy their own machine has been. A rank
/// floor on the ROWS would empty that surface for exactly the person it is for
/// -- and with no error, which fleetSharingLedger's own description refuses by
/// name: a read that fails answers `readable: false` rather than zero, because
/// telling somebody who lent their machine that nobody used it is a specific
/// claim and a failed read is not evidence for it.
///
/// So the honest tier is the one that says there is no row-level distinction
/// this concept can draw, AND that this is not an invitation to the internet.
/// That is what requiresIdentity is for in its own words, and its documentation
/// prescribes what comes next: authorization for such a concept lives at the
/// SURFACE, where @requiresRank puts it. All three gates above are already
/// there.
///
/// WHAT THIS CHANGES, since a tier that changed nothing would be the failure
/// memql#5162 is about: the concept leaves the undeclared population, where it
/// admitted EVERY caller on the read path and on the subscription path --
/// including an anonymous one, because `rowAuthzAdmits` answers ADMIT for an
/// undeclared concept. An anonymous caller is refused now. What it does not
/// change is which signed-in callers reach it through an unbound read; that
/// stays the surfaces' business, and saying so plainly is the point.
@rowAuthz(public, requiresIdentity)
@displayCard(primary="model", secondary="promptName", tertiary="vendor", status="outcome")
concept call {
  requestId           string!  @description("Correlates this AI call to an upstream request -- an agent turn, a suggest envelope, a prompt invocation. Free-form string; uniqueness is not enforced across partitions.")
  agentId             string  @description("Agent whose reply this call was generating; empty for non-agent AI calls (suggest, render, TTS, etc).")
  userId              string  @description("Identity subject of the end-user driving this call, when resolvable. Empty for system-triggered calls.")
  // Epic 3 3.2 (#1899): partitionId (a product-layer notion) dropped from the
  // core AI call ledger. The tenant scope is `partition` (already recorded on
  // this row); per-space AI-cost attribution is a product concern for the
  // product pack, not core.
  promptName          string  @description("Name of the MemQL prompt invoked when the call went through InvokeAI (e.g. agentReply, plannerAgent).")
  policyName          string  @description("Routing policy that picked the provider. Reserved for Phase 2+ when policies land; Phase 1 leaves this empty.")

  vendor              string!  @description("Vendor family: openai or anthropic. Derived from provider .memql @type.")
  model               string!  @description("Model identifier as sent to the vendor (e.g. gpt-5.4-mini, claude-sonnet-4-6).")
  providerName        string!  @description("MemQL provider registry name (e.g. stream54Mini, streamClaudeSonnet).")

  inputTokens         int     @description("Tokens in the input/prompt.")
  outputTokens        int     @description("Tokens generated in the output.")
  cachedInputTokens   int     @description("Portion of input tokens served from the provider's prompt cache.")
  tokensEstimated     bool    @description("True when token counts are derived from a char-count heuristic rather than provider-reported usage. Phase 1 always estimates; Phase 2 will flip this to false when the vendor's real usage is available.")

  inputCost           float   @description("USD cost of non-cached input tokens for this call.")
  outputCost          float   @description("USD cost of output tokens for this call.")
  cachedInputCost     float   @description("USD cost of the cached-input portion.")
  totalCost           float   @description("USD total cost for this call. Equal to inputCost + outputCost + cachedInputCost.")
  pricingConfigured   bool    @description("True when the provider declared pricing annotations in its .memql file. False means cost fields are 0 because nobody has configured pricing yet, not because the call was free.")

  timeToFirstTokenMs  int     @description("Wall-clock ms from call start to first streamed token. 0 for non-streaming calls (chat, suggest, TTS).")
  totalDurationMs     int!  @description("Wall-clock ms from call start to completion (success or error).")
  tokensPerSec        float   @description("Output tokens per second for streaming calls (computed end-of-stream). 0 for non-streaming or too-short calls.")
  streaming           bool    @description("True when the call used a streaming provider path.")

  outcome             enum("ok", "error", "cancelled", "fallback_used")!  @description("Final state of this call. `fallback_used` marks a failed pre-flight attempt in a policy chain whose successor succeeded (or failed and fell further).")
  errorCategory       string  @description("Short classifier when outcome=error: timeout, rate_limit, auth, upstream, cancelled, other.")
  errorMessage        string  @description("Truncated error string for debugging (max 500 chars). Must not contain PII or secrets.")
  fallbackFromModel   string  @description("On outcome=fallback_used rows, the model that failed and triggered the retry. Empty on ok/error/cancelled rows.")

  // THE DECISION (epic memql#5127, design D10). Every resolution writes these,
  // on a hit AND on a park. A rule is falsifiable only if the decisions it made
  // can be read back, and before this the router accumulated exactly this
  // report and dropped it with the stack frame the moment an entry won.
  level               enum("fast", "strong", "reasoning", "embeddings")  @description("The level the call was resolved at, after any rule override. A call declares a level rather than a model; the four are closed.")
  requestedLevel      enum("fast", "strong", "reasoning", "embeddings")  @description("The level the CALL declared, before a rule overrode it. Equal to level when no rule raised or lowered it, which is what makes a rule's effect visible without diffing the rule set.")
  servedLevel         enum("fast", "strong", "reasoning", "embeddings")  @description("The level that actually served. It differs from level only when degraded is true.")
  degraded            bool    @description("True when the chain was exhausted at the requested level and the winning rule said degrade, so the router walked down a level. No degradation is silent: this field and servedLevel are what say so.")
  rule                string  @description("Name of the rule that matched. Empty only for a call pinned with an explicit provider, which consults no rule.")
  policy              string  @description("Name of the policy that rule named, after policy: expansion. Distinct from policyName, which is the pre-rules field and is kept for rows written before this epic.")
  door                enum("local", "app", "federation", "session")  @description("Which door the winning entry belongs to: a model on the user's own hardware, a signed-in subscription app, a metered vendor, or -- since epic memql#5391 -- an app that was handed the whole STEP rather than serving one turn. The first three are the words v1:platform:inferenceStatus.doorsOpen uses. `session` is a FOURTH VALUE rather than a flag on `app` because this field is what a reader filters on, and 'a subscription app answered this turn' and 'a subscription app was handed this step and drove its own loop' are different answers: folding them would make the whole history of a cluster whose only door is a signed-in Claude Code read as ordinary chat turns.")
  considered          []object  @description("The door report: [{entry, door, reason}] for every chain entry the walk passed over, in the order it tried them, plus the one it took. KEPT ON SUCCESS as well as on a refusal -- what a chain did not pick is half the decision, and it is the only way to tell a policy that had no alternative from one whose alternatives were all shut.")
  touches             []string  @description("The call's footprint: a work step's footprint union, or an agent turn's knowledge-domain concept ids. Empty otherwise. A rule matches it with startsWith semantics, so a decision can be filtered by what the call was about.")
  minContextTokens    int     @description("The context-window floor this resolution was made against, estimated from the rendered prompt plus the completion budget. Never zero. It sits beside the winning model's window, which is what makes an under-counted estimate diagnosable rather than merely wrong.")
  servedModel         string  @description("The model the SURFACE REPORTED serving this call with (epic memql#5391, design D9), as distinct from `model`, which is what the CHAIN resolved. For an app door those are different facts: the chain resolves `app:claude-code` and the app itself reports `claude-opus-5`, and the gap between them is the only way to see an app that rerouted or ignored a model pin. EMPTY MEANS THE SURFACE DID NOT SAY, which is recorded as unknown -- never the requested value, because a servedModel copied from the request would record as measured something nobody measured. Empty is also the ordinary reading for every vendor provider, where what was asked for is what ran and `model` already says it.")
  servedEffort        string  @description("The reasoning effort the surface REPORTED running at, beside servedModel and under the same rule (epic memql#5391, design D9). An app that states no effort -- Claude Code's headless output states none -- or that ignored the one it was given leaves this empty. A token count spent at an unknown effort cannot be compared with one spent at a known one, which is why the absence is recorded rather than filled in.")
  machineOwnerUserId  string  @description("Whose machine served a local call. Empty until shared team machines land (epic memql#5146); a local call on the caller's own machine leaves it empty rather than repeating userId.")

  billing             enum("metered", "subscription", "local", "unknown")  @description("Who PAID for this call (memql#4362, memql#4681). metered = MemQL's own vendor spend, which is what totalCost is about and what the dollar ceiling counts. subscription = the call ran inside an app the user already pays for, so the tokens are real but MemQL was not billed for them. local = the call ran on a model hosted by one of the user's OWN MACHINES, so there is no vendor and no bill at all; it must be STAMPED EXPLICITLY by the fleet path and is never inferred, because inferring it would claim work ran on somebody's hardware when nobody established that. unknown = the surface could not tell, which is recorded AS unknown rather than folded into any of the others -- the number the owner asked for, what they were actually charged for, is only worth having if silence stays visible. An absent value reads as metered, the conservative direction: unattributed spend counts against the ceiling rather than disappearing into a bucket the ceiling cannot see.")
  executionSurface    string  @description("Where the call ran (memql#4362, memql#4681): empty for MemQL's own provider calls, 'cockpit-app:<appId>' for a call made by a local app on a user's machine through a delegated session, 'fleet:<registrationId>' for a model served by a machine in the user's fleet. Lets a cost reader separate 'what we spent' from 'what ran somewhere we do not pay for' without joining to the session or registration row -- and, for the fleet case, answers 'which of my machines did this' from the ledger alone.")
}

/// Virtual projection of a registered AI provider entry. Never persisted -- rows are produced at
/// query time by the integration.router.listModels capability from the live provider registry.
/// Lives in the concept registry so the engine can shape results without a database round-trip.
@displayCard(primary="providerName", secondary="model", tertiary="vendor", status="available")
concept modelCatalog {
  providerName              string  @description("Registry name (e.g. stream54Mini).")
  providerType              string  @description("Raw @type annotation from the .memql file (OpenAI, AnthropicStream, etc).")
  vendor                    string  @description("Vendor family (openai, anthropic).")
  model                     string  @description("Vendor-side model id.")
  description               string  @description("Human-readable description from the .memql @description annotation.")
  modality                  string  @description("text, tts, stt, embedding, etc.")
  isDefault                 bool    @description("True when the provider carries the @default annotation.")
  available                 bool    @description("True when the provider was instantiated successfully (auth + client).")
  inputCostPerMillion       float   @description("USD per million input tokens.")
  outputCostPerMillion      float   @description("USD per million output tokens.")
  cachedInputCostPerMillion float   @description("USD per million cached-input tokens.")
  pricingConfigured         bool    @description("True when any non-zero pricing annotation is set.")
  contextWindow             int     @description("Maximum token context window.")
}

/// Virtual projection of a registered AI Router policy. Never persisted -- rows are produced at
/// query time by the integration.router.listPolicies capability from the live policy registry.
/// Lives in the concept registry so the engine can shape results without a database round-trip.
@displayCard(primary="name", secondary="description", tertiary="primary")
concept policyCatalog {
  name                   string  @description("Policy name, e.g. balancedChat.")
  description            string  @description("Human-readable description from the @description annotation.")
  primary                string  @description("Primary provider registry name.")
  fallbacks              []string  @description("Fallback provider registry names, in try-order.")
  chain                  []string  @description("Full chain (primary + fallbacks) for convenience.")
}
