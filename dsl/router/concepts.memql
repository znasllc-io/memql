// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@version("1.0.0")
@namespace("router")
@description("Spend limit for a partition or a specific agent within a partition. The router checks the current-period spend against this cap before every SI call; over-budget calls are refused with a typed error that surfaces in the UI as a clear 'budget reached' state. Rolls over at periodType boundary (UTC day, week, or month).")
concept budget {
  scope            enum("partition", "agent")  @required  @description("Whether this budget caps the whole partition or a single agent.")
  scopeId          string  @description("When scope=agent, the v1:agents:agent id being capped. Empty when scope=partition.")
  periodType       enum("daily", "weekly", "monthly")  @required  @description("Budget window. Resets at UTC midnight / Monday / first-of-month.")
  limitUSD         float   @required  @description("Maximum USD spend allowed during one period. The router refuses calls once ledger totals reach this figure.")
  alertThresholdPct int    @description("Emit an alert event when spend crosses this percentage of the limit (e.g. 80 for early warning). 0 disables early alerts.")
  alertSent        bool    @default("false")  @description("True when the threshold alert for the current period has been emitted. Reset to false on period rollover.")
  resetAt          datetime  @description("The next UTC moment the period rolls over. The router uses this to decide whether to reset alertSent.")
  active           bool    @default("true")  @description("When false the budget is ignored (calls proceed unchecked). Useful for temporary overrides during incident response.")
}

@version("1.0.0")
@namespace("router")
@description("One SI invocation recorded by the memQL SI Router. Every call through the router -- agent replies, prompt renders, suggest endpoints, TTS, transcription -- produces exactly one row here with attribution, token counts, latency, and cost. Partition-scoped usage ledger; the time-series axis rides the shared MemoryNodes hypertable.")
concept call {
  requestId           string  @required  @description("Correlates this SI call to an upstream request -- cognition turn, suggest envelope, prompt invocation. Free-form string; uniqueness is not enforced across partitions.")
  agentId             string  @description("Agent whose reply this call was generating; empty for non-agent SI calls (suggest, render, TTS, etc).")
  userId              string  @description("Identity subject of the end-user driving this call, when resolvable. Empty for system-triggered calls.")
  // Epic 3 3.2 (#1899): spaceId (a CoPresent product notion) dropped from the
  // core SI call ledger. The tenant scope is `partition` (already recorded on
  // this row); per-space SI-cost attribution is a product concern for the
  // CoPresent pack, not core.
  promptName          string  @description("Name of the MemQL prompt invoked when the call went through InvokeAI (e.g. agentReply, cognitionRouting).")
  policyName          string  @description("Routing policy that picked the provider. Reserved for Phase 2+ when policies land; Phase 1 leaves this empty.")

  vendor              string  @required  @description("Vendor family: openai or anthropic. Derived from provider .memql @type.")
  model               string  @required  @description("Model identifier as sent to the vendor (e.g. gpt-5.4-mini, claude-sonnet-4-6).")
  providerName        string  @required  @description("memQL provider registry name (e.g. stream54Mini, streamClaudeSonnet).")

  inputTokens         int     @description("Tokens in the input/prompt.")
  outputTokens        int     @description("Tokens generated in the output.")
  cachedInputTokens   int     @description("Portion of input tokens served from the provider's prompt cache.")
  tokensEstimated     bool    @description("True when token counts are derived from a char-count heuristic rather than provider-reported usage. Phase 1 always estimates; Phase 2 will flip this to false when the vendor's real usage is available.")

  inputCost           float   @description("USD cost of non-cached input tokens for this call.")
  outputCost          float   @description("USD cost of output tokens for this call.")
  cachedInputCost     float   @description("USD cost of the cached-input portion.")
  totalCost           float   @description("USD total cost for this call. Equal to inputCost + outputCost + cachedInputCost.")
  pricingConfigured   bool    @description("True when the provider declared pricing annotations in its .memql file. False means cost fields are 0 because nobody has configured pricing yet, not because the call was free.")

  timeToFirstTokenMs  int     @description("Wall-clock ms from call start to first streamed token. 0 for non-streaming calls (chat, suggest, TTS).")
  totalDurationMs     int     @required  @description("Wall-clock ms from call start to completion (success or error).")
  tokensPerSec        float   @description("Output tokens per second for streaming calls (computed end-of-stream). 0 for non-streaming or too-short calls.")
  streaming           bool    @description("True when the call used a streaming provider path.")

  outcome             enum("ok", "error", "cancelled", "fallback_used")  @required  @description("Final state of this call. `fallback_used` marks a failed pre-flight attempt in a policy chain whose successor succeeded (or failed and fell further).")
  errorCategory       string  @description("Short classifier when outcome=error: timeout, rate_limit, auth, upstream, cancelled, other.")
  errorMessage        string  @description("Truncated error string for debugging (max 500 chars). Must not contain PII or secrets.")
  fallbackFromModel   string  @description("On outcome=fallback_used rows, the model that failed and triggered the retry. Empty on ok/error/cancelled rows.")
}

@version("1.0.0")
@namespace("router")
@description("Virtual projection of a registered SI provider entry. Never persisted -- rows are produced at query time by the integration.router.listModels capability from the live provider registry. Lives in the concept registry so the engine can shape results without a database round-trip.")
concept modelCatalog {
  providerName              string  @description("Registry name (e.g. stream54Mini).")
  providerType              string  @description("Raw @type annotation from the .memql file (OpenAI, AnthropicStream, etc).")
  vendor                    string  @description("Vendor family (openai, anthropic).")
  model                     string  @description("Vendor-side model id.")
  description               string  @description("Human-readable description from the .memql @description annotation.")
  modality                  string  @description("text, tts, stt, embedding, etc.")
  isDefault                 bool    @description("True when the provider carries the @default annotation.")
  available                 bool    @description("True when the provider was instantiated successfully (auth + client).")
  inputCostPerMillion       float   @description("USD per million input tokens.")
  outputCostPerMillion      float   @description("USD per million output tokens.")
  cachedInputCostPerMillion float   @description("USD per million cached-input tokens.")
  pricingConfigured         bool    @description("True when any non-zero pricing annotation is set.")
  contextWindow             int     @description("Maximum token context window.")
}

@version("1.0.0")
@namespace("router")
@description("Virtual projection of a registered SI Router policy. Never persisted -- rows are produced at query time by the integration.router.listPolicies capability from the live policy registry. Lives in the concept registry so the engine can shape results without a database round-trip.")
concept policyCatalog {
  name                   string  @description("Policy name, e.g. balancedChat.")
  description            string  @description("Human-readable description from the @description annotation.")
  primary                string  @description("Primary provider registry name.")
  fallbacks              []string  @description("Fallback provider registry names, in try-order.")
  chain                  []string  @description("Full chain (primary + fallbacks) for convenience.")
  maxLatencyMs           int     @description("Max wall-clock latency allowed; 0 = no limit.")
  maxTimeToFirstTokenMs  int     @description("Max time-to-first-token allowed; 0 = no limit.")
  preferredRoles         []string  @description("Agent roles this policy is preferred for by default.")
}
