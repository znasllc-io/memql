// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use agents.concepts.{ agent }
use identity.concepts.{ user }

/// Spend limit for a partition or a specific agent within a partition. The router checks the
/// current-period spend against this cap before every AI call; over-budget calls are refused with a
/// typed error that surfaces in the UI as a clear 'budget reached' state. Rolls over at periodType
/// boundary (UTC day, week, or month).
@displayCard(primary="scopeId", secondary="scope", tertiary="periodType", status="active")
@belongsTo(cluster)
concept budget {
  scope            enum("partition", "agent", "user")!  @description("Whether this budget caps the whole partition, a single agent, or one person's own metered spend. A `user` budget is a person's monthly AI budget (design record 2026-10-18-routes): Auto keeps that person's calls inside it, preferring free sources from 80% and leaving vendors out at 100%. It is written only by myBudgetSave, at an id derived from the person.")
  scopeId          string  @description("When scope=agent, the v1:agents:agent id being capped; when scope=user, the person's v1:identity:user id. Empty when scope=partition.")
  periodType       enum("daily", "weekly", "monthly")!  @description("Budget window. Resets at UTC midnight / Monday / first-of-month.")
  limitUSD         float!  @description("Maximum USD spend allowed during one period. The router refuses calls once ledger totals reach this figure.")
  alertThresholdPct int    @description("Emit an alert event when spend crosses this percentage of the limit (e.g. 80 for early warning). 0 disables early alerts.")
  alertSent        bool    @description("True when the threshold alert for the current period has been emitted. setBudget does not write it, and it does not need to: an absent value reads as false, i.e. not yet alerted, which is the correct born state. Reset to false on period rollover.")
  resetAt          datetime  @description("The next UTC moment the period rolls over. The router uses this to decide whether to reset alertSent.")
  active           bool  @description("When false the budget is ignored (calls proceed unchecked). Useful for temporary overrides during incident response.")

  @relationship(type="references", field="scopeId", target=agent, direction="outgoing")
}

/// One AI invocation recorded by the MemQL AI Router. Every call through the router -- agent
/// replies, prompt renders, suggest endpoints, TTS, transcription -- produces exactly one row here
/// with attribution, token counts, latency, and cost. Partition-scoped usage ledger; the
/// time-series axis rides the shared MemoryNodes hypertable.
/// @rowAuthz(public, requiresIdentity) -- THE TIER THAT IS TRUE OF THIS ROW,
/// and it is not the one memql#5162 recommended. The issue asked for an unowned
/// RANK FLOOR; measuring the readers showed a rank floor cannot serve them.
///
/// `userId` here is ATTRIBUTION -- the person whose call was served -- and not
/// ownership. The row is the DEPLOYMENT'S: nobody can delete it, nobody can
/// edit it, and it exists whether or not that person still does. So
/// `owner="userId"` was the obvious declaration and the wrong one; it asserts a
/// guarantee nothing provides, and TestDeclaredOwnerFieldsAreServerStamped
/// refuses it, correctly -- recordRouterCall writes the field from CALLER ARGS.
/// It cannot be server-stamped either, because the writer's actor IS
/// system:router, so stamping actor.userId would make the router the owner of
/// every row.
///
/// THREE CONSTRUCTS READ THIS CONCEPT AND THEIR AUTHORIZATIONS ARE THREE
/// DIFFERENT KINDS. That is the measurement memql#5162 did not have, and it is
/// what rules a rank floor out:
///
///   routerDecisionsRecent   @requiresRank("admin")        admin and above
///   routerCallsInWindow     actor.isClusterOwner==true    the maintenance principal
///   routerCallsOnMachine    NO rank gate -- fleetSharingLedger proves the
///                           caller owns the machine first, and the surface
///                           argument is derived from a registration already
///                           proven theirs                 ANY rank
///
/// The Fleet app carries no role floor, so the third reader is a plain writer
/// who paired a laptop, asking how busy their own machine has been. A rank
/// floor on the ROWS would empty that surface for exactly the person it is for
/// -- and with no error, which fleetSharingLedger's own description refuses by
/// name: a read that fails answers `readable: false` rather than zero, because
/// telling somebody who lent their machine that nobody used it is a specific
/// claim and a failed read is not evidence for it.
///
/// So the honest tier is the one that says there is no row-level distinction
/// this concept can draw, AND that this is not an invitation to the internet.
/// That is what requiresIdentity is for in its own words, and its documentation
/// prescribes what comes next: authorization for such a concept lives at the
/// SURFACE, where @requiresRank puts it. All three gates above are already
/// there.
///
/// WHAT THIS CHANGES, since a tier that changed nothing would be the failure
/// memql#5162 is about: the concept leaves the undeclared population, where it
/// admitted EVERY caller on the read path and on the subscription path --
/// including an anonymous one, because `rowAuthzAdmits` answers ADMIT for an
/// undeclared concept. An anonymous caller is refused now. What it does not
/// change is which signed-in callers reach it through an unbound read; that
/// stays the surfaces' business, and saying so plainly is the point.
@rowAuthz(public, requiresIdentity)
@displayCard(primary="model", secondary="promptName", tertiary="vendor", status="outcome")
@belongsTo(cluster)
concept call {
  requestId           string!  @description("Correlates this AI call to an upstream request -- an agent turn, a suggest envelope, a prompt invocation. Free-form string; uniqueness is not enforced across partitions.")
  agentId             string  @description("Agent whose reply this call was generating; empty for non-agent AI calls (suggest, render, TTS, etc).")
  userId              string  @description("Identity subject of the end-user driving this call, when resolvable. Empty for system-triggered calls -- read callerKind beside it, which says which kind of caller the blank belongs to.")
  callerKind          enum("user", "system", "connector", "anonymous", "unattributed")  @description("What kind of caller made this call (memql#5581), so that an empty userId is an ANSWER rather than a gap. `user` is a person and userId names them; `system` is the cluster acting -- a maintenance sweep, a boot seed, an automation's system actor -- and correctly has no user; `connector` is a mirror's writer; `anonymous` is the identity-less caller a public-reads bridge admits; `unattributed` is a context nobody stamped, which is the one honest answer for a Go call site that established no caller at all. DERIVED from the context at the seam that builds the request and never supplied by a caller, the way auth.CallOrigin is. NOTHING ROUTES ON IT: no rule key branches on the caller kind, because a rule that read it would turn evidence into an input. Absent on rows written before this field existed, which is the ambiguity it removes going forward.")
  cacheKind           enum("exact", "semantic")  @description("Which CACHE answered this call, when one did (memql#5581). ABSENT MEANS A PROVIDER ANSWERED, which is what every row written before this field was -- it is not 'unknown', because a row reaches this ledger either through an observer wrapping a real provider call or through the cache path that names its kind, and there is no third writer. On a row naming a cache every token count and every cost is a REAL ZERO: nothing was sent and MemQL was not billed, so a reader summing totalCost over a warm page gets the true answer rather than a call that never happened. tokensEstimated and pricingConfigured are false on such a row for the same reason -- nothing was estimated and no cost was computed. The DECISION is carried whole, `considered` included: the calls a cache serves are by definition the ones that repeat, and dropping their records would make them the ones the rule corpus can never be checked against.")
  // Epic 3 3.2 (#1899): partitionId (a product-layer notion) dropped from the
  // core AI call ledger. The tenant scope is `partition` (already recorded on
  // this row); per-space AI-cost attribution is a product concern for the
  // product pack, not core.
  promptName          string  @description("Name of the MemQL prompt invoked when the call went through InvokeAI (e.g. agentReply, plannerAgent).")
  policyName          string  @description("Routing policy that picked the provider. Reserved for Phase 2+ when policies land; Phase 1 leaves this empty.")

  vendor              string!  @description("Vendor family: openai or anthropic. Derived from provider .memql @type.")
  model               string!  @description("Model identifier as sent to the vendor (e.g. gpt-5.4-mini, claude-sonnet-4-6).")
  providerName        string!  @description("MemQL provider registry name (e.g. stream54Mini, streamClaudeSonnet).")

  apiEquivalent object @description("Dated official API-equivalent estimate for the served model; independent of billing, with source evidence, cache/context assumptions and freshness.")
  electricityEstimate object @description("Local-inference electricity estimate with tariff and energy evidence. Missing watts or an applicable confirmed tariff is unavailable, never zero.")
  actualBilling object @description("Billing receipt status. Unavailable without independent billing evidence; zero subscription cost is not free work.")
  inputTokens         int     @description("Tokens in the input/prompt.")
  outputTokens        int     @description("Tokens generated in the output.")
  cachedInputTokens   int     @description("Portion of input tokens served from the provider's prompt cache.")
  tokensEstimated     bool    @description("True when token counts are derived from a char-count heuristic rather than provider-reported usage. Phase 1 always estimates; Phase 2 will flip this to false when the vendor's real usage is available.")

  inputCost           float   @description("USD cost of non-cached input tokens for this call.")
  outputCost          float   @description("USD cost of output tokens for this call.")
  cachedInputCost     float   @description("USD cost of the cached-input portion.")
  totalCost           float   @description("USD total cost for this call. Equal to inputCost + outputCost + cachedInputCost.")
  pricingConfigured   bool    @description("True when the provider declared pricing annotations in its .memql file. False means cost fields are 0 because nobody has configured pricing yet, not because the call was free.")

  timeToFirstTokenMs  int     @description("Wall-clock ms from call start to first streamed token. 0 for non-streaming calls (chat, suggest, TTS).")
  totalDurationMs     int!  @description("Wall-clock ms from call start to completion (success or error).")
  tokensPerSec        float   @description("Output tokens per second for streaming calls (computed end-of-stream). 0 for non-streaming or too-short calls.")
  streaming           bool    @description("True when the call used a streaming provider path.")

  outcome             enum("ok", "error", "cancelled", "fallback_used")!  @description("Final state of this call. `fallback_used` marks a failed pre-flight attempt in a policy chain whose successor succeeded (or failed and fell further).")
  errorCategory       string  @description("Short classifier when outcome=error: timeout, rate_limit, auth, upstream, cancelled, other.")
  errorMessage        string  @description("Truncated error string for debugging (max 500 chars). Must not contain PII or secrets.")
  fallbackFromModel   string  @description("On outcome=fallback_used rows, the model that failed and triggered the retry. Empty on ok/error/cancelled rows.")

  // THE DECISION (epic memql#5127, design D10). Every resolution writes these,
  // on a hit AND on a park. A rule is falsifiable only if the decisions it made
  // can be read back, and before this the router accumulated exactly this
  // report and dropped it with the stack frame the moment an entry won.
  level               enum("fast", "strong", "reasoning", "embeddings")  @description("The level the call was resolved at, after any rule override. A call declares a level rather than a model; the four are closed.")
  requestedLevel      enum("fast", "strong", "reasoning", "embeddings")  @description("The level the CALL declared, before a rule overrode it. Equal to level when no rule raised or lowered it, which is what makes a rule's effect visible without diffing the rule set.")
  servedLevel         enum("fast", "strong", "reasoning", "embeddings")  @description("The level that actually served. It differs from level only when degraded is true.")
  degraded            bool    @description("True when the chain was exhausted at the requested level and the winning rule said degrade, so the router walked down a level. No degradation is silent: this field and servedLevel are what say so.")
  rule                string  @description("Name of the rule that matched. Empty only for a call pinned with an explicit provider, which consults no rule.")
  policy              string  @description("Name of the policy that rule named, after policy: expansion. Distinct from policyName, which is the pre-rules field and is kept for rows written before this epic.")
  door                enum("local", "app", "federation", "session")  @description("Which door the winning entry belongs to: a model on the user's own hardware, a signed-in subscription app, a metered vendor, or -- since epic memql#5391 -- an app that was handed the whole STEP rather than serving one turn. The first three are the words v1:platform:inferenceStatus.doorsOpen uses. `session` is a FOURTH VALUE rather than a flag on `app` because this field is what a reader filters on, and 'a subscription app answered this turn' and 'a subscription app was handed this step and drove its own loop' are different answers: folding them would make the whole history of a cluster whose only door is a signed-in Claude Code read as ordinary chat turns.")
  considered          []object  @description("The door report: [{entry, door, reason}] for every chain entry the walk passed over, in the order it tried them, plus the one it took. KEPT ON SUCCESS as well as on a refusal -- what a chain did not pick is half the decision, and it is the only way to tell a policy that had no alternative from one whose alternatives were all shut.")
  touches             []string  @description("The call's footprint: a work step's footprint union, or an agent turn's knowledge-domain concept ids. Empty otherwise. A rule matches it with startsWith semantics, so a decision can be filtered by what the call was about.")
  minContextTokens    int     @description("The context-window floor this resolution was made against, estimated from the rendered prompt plus the completion budget. Never zero. It sits beside the winning model's window, which is what makes an under-counted estimate diagnosable rather than merely wrong.")
  servedModel         string  @description("The model the SURFACE REPORTED serving this call with (epic memql#5391, design D9), as distinct from `model`, which is what the CHAIN resolved. For an app door those are different facts: the chain resolves `app:claude-code` and the app itself reports `claude-opus-5`, and the gap between them is the only way to see an app that rerouted or ignored a model pin. EMPTY MEANS THE SURFACE DID NOT SAY, which is recorded as unknown -- never the requested value, because a servedModel copied from the request would record as measured something nobody measured. Empty is also the ordinary reading for every vendor provider, where what was asked for is what ran and `model` already says it.")
  servedEffort        string  @description("The reasoning effort the surface REPORTED running at, beside servedModel and under the same rule (epic memql#5391, design D9). An app that states no effort -- Claude Code's headless output states none -- or that ignored the one it was given leaves this empty. A token count spent at an unknown effort cannot be compared with one spent at a known one, which is why the absence is recorded rather than filled in.")
  machineOwnerUserId  string  @description("Whose machine took a local call. Empty until shared team machines land (epic memql#5146); a local call on the caller's own machine leaves it empty rather than repeating userId.")

  billing             enum("metered", "subscription", "local", "unknown")  @description("Who PAID for this call (memql#4362, memql#4681). metered = MemQL's own vendor spend, which is what totalCost is about and what the dollar ceiling counts. subscription = the call ran inside an app the user already pays for, so the tokens are real but MemQL was not billed for them. local = the call ran on a model hosted by one of the user's OWN MACHINES, so there is no vendor and no bill at all; it must be STAMPED EXPLICITLY by the fleet path and is never inferred, because inferring it would claim work ran on somebody's hardware when nobody established that. unknown = the surface could not tell, which is recorded AS unknown rather than folded into any of the others -- the number the owner asked for, what they were actually charged for, is only worth having if silence stays visible. An absent value reads as metered, the conservative direction: unattributed spend counts against the ceiling rather than disappearing into a bucket the ceiling cannot see.")
  executionSurface    string  @description("Where the call ran (memql#4362, memql#4681): empty for MemQL's own provider calls, 'cockpit-app:<appId>' for a call made by a local app on a user's machine through a delegated session, 'fleet:<registrationId>' for a call a machine in the user's fleet took, whether it served it or failed it, so read outcome before counting a row as served (memql#6414). A machine that declined the call before handing it to a runtime ran nothing and is not named. Lets a cost reader separate 'what we spent' from 'what ran somewhere we do not pay for' without joining to the session or registration row -- and, for the fleet case, answers 'which of my machines did this' from the ledger alone.")
  route               string  @description("The route a PERSON chose for this call in Ask (design record 2026-10-18-routes): `local`, `apps` or the id of one of their own routes. EMPTY MEANS AUTO -- the rules decided, which is every call nobody chose a route for and every call made before routes existed. It is what History filters on to answer 'what did my Apps route actually do'.")
  accountKind         enum("cluster", "key")  @description("Which ACCOUNT paid for a vendor text call (design record 2026-11-21-vendor-accounts-and-api-keys, K15): `cluster` is the cluster's own account at the vendor, its workload identity federation; `key` is a person's API key. ABSENT MEANS THE SOURCE TAKES NO ACCOUNT: a local model, an app, and the vendor surfaces a key does not pay for (vision, speech, transcription, embeddings, images), which are every row written before this field. On a `fallback_used` row it is the account that FAILED. A key's spend is metered spend, so billing stays `metered` whichever account paid.")
  accountKeyId        string  @description("The id of the v1:router:vendorKey that paid, when accountKind is `key`; empty otherwise. THE KEY'S NAME AND FINGERPRINT ARE NEVER ON THIS ROW: every signed-in person can read a call record, so a screen resolves the name through the key's own read, and a person who may not see the key reads 'a key'.")
  accountKeyOwnerUserId string  @description("The v1:identity:user the paying key belongs to, when accountKind is `key`; empty otherwise. It differs from userId when the key was lent: userId is whose call it was, this is whose money paid.")

  // The two ids a key-paid row carries name rows, so they are declared: a
  // key's activity is read by the key's id, which arrives bare.
  @relationship(type="references", as="paidByKey", field="accountKeyId", target=vendorKey, direction="outgoing")
  @relationship(type="references", as="paidByKeyOwner", field="accountKeyOwnerUserId", target=user, direction="outgoing")
}

/// A route a PERSON made and named (design record 2026-10-18-routes, "Your own routes"): which
/// sources serve each job when they pick it for a message in Ask. The built-in routes -- Auto,
/// Local and Apps -- are not rows; their cluster-wide overrides live in the routing document beside
/// the policies and rules, under one revision.
///
/// SEARCH AND MEMORY IS NEVER A ROUTE'S, which is why there is no field for it. Every route serves
/// embeddings from the cluster's bound embedder: the index holds vectors from exactly one model, and
/// a route that chose another would write vectors into a space they do not belong to.
///
/// Each job is an ordered list of one to four chain entries -- `fleet:`, `app:` or `federation:`,
/// never `policy:` and never `embedder:` -- validated by routeSave before anything is written. A
/// call under the route tries them in order and NEVER falls through to a source the route does not
/// name: that is what makes "Apps" mean apps.
///
/// The composite tier admits the owner and the cluster's maintenance principal: the router reads a
/// person's route under that principal on whichever node runs the call, and the only wire read
/// (routesForOwner) filters on the caller, so nobody reads somebody else's route through it.
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="name", secondary="ownerUserId", tertiary="updatedAt", status="active")
@belongsTo(cluster)
concept route {
  ownerUserId  string!   @description("The v1:identity:user id of the person whose route this is. Stamped from the caller by the write; never an argument.")
  name         string!   @description("What the person called it -- 'Emergency', 'Out of credits'. One to forty characters, unique per person ignoring case.")
  fast         []string  @description("Quick tasks (level fast): the sources tried, in order.")
  strong       []string  @description("Main work (level strong): the sources tried, in order.")
  reasoning    []string  @description("Deep reasoning (level reasoning): the sources tried, in order.")
  active       bool      @description("False once the person deleted it. A deleted route is kept as history and never offered again.")
  updatedAt    datetime  @description("When the route was last written.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
}

// ---- API keys (design record 2026-11-21-vendor-accounts-and-api-keys) ----

/// A PERSON'S API KEY at a model vendor (design record 2026-11-21-vendor-accounts-and-api-keys,
/// decisions K1 to K6 and K16). It is the second kind of ACCOUNT that can pay for a vendor call; the
/// first is the cluster's own workload identity federation, which has no row.
///
/// IT BELONGS TO THE PERSON WHO ADDED IT. The cluster's own work never spends one and there is no
/// cluster key: a call with no acting person, and a call made for a visitor under a person's
/// borrowed authority, is paid by the cluster's account or by nothing. Its owner may lend it to
/// named people and groups, and Auto spends it only after its owner switches that on.
///
/// THIS ROW HOLDS WHAT ITS OWNER DECIDES: the vendor, the name, the sealed value, whether it is the
/// default, the Auto switch, who it is lent to, and removal. What the engine OBSERVES about the key
/// (the last check, a refusal, a hold for credit, the last use) is v1:router:vendorKeyState, a row of
/// its own. The split is the point: the engine stamps what it observes from any replica, often, and
/// a write is a read-merge of the whole row, so an engine stamp on THIS row could put back a share
/// its owner had just taken away.
///
/// THE VALUE IS SEALED, exactly as a source credential's is: component/secret.Encrypt under
/// MEMQL_MASTER_KEY, on the node that received it, into `encryptedValue`. It is unsealed for one
/// request to the vendor's own address and nowhere else, and never after the key is removed.
///
/// NO CLIENT WRITES THIS ROW. @serverWritten requires internal origin for every write, a raw insert
/// and an inline update included, and every named write is @serverOnly: integrations/vendorkeys is
/// the only writer, after it has checked who is asking and, for a new key, asked the vendor whether
/// it accepts the key.
///
/// NO CLIENT READS IT EITHER, by any path. The tier below would admit the owner and a cluster owner
/// to a raw read; clientUnreadableConcepts (component/memql/site_access_guards.go) refuses them,
/// because what a caller may see of a key differs by who they are and only the builtins decide it:
/// the owner sees everything but the value, a person it is lent to sees a short card, a cluster
/// owner sees its facts. For the same reason a write publishes NO GRAPH EVENT: an event carries the
/// whole row, the sealed value included, to every subscriber, and nothing may subscribe to a key or
/// trigger on one. Cache invalidation is a separate channel that carries the concept's name alone.
///
/// A REMOVED KEY'S ROW STAYS. Removal is one-way; the row is the record of what paid for the calls
/// that name it, and a deleted row answers no question after an incident. Removing a key here does
/// not revoke it at the vendor, and the sealed value remains in the row's history.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="label", secondary="vendor", tertiary="fingerprint", status="status")
@belongsTo(cluster)
concept vendorKey {
  ownerUserId     string!  @description("The v1:identity:user this key belongs to: the person who added it, whose money it spends. Stamped by createVendorKey from the actor the write runs as and never an argument. It never moves: a cluster owner who removes a key does not come to own it.")
  vendor          enum("anthropic", "openai")!  @description("The vendor the key is for. A key is sent to that vendor's own public API address and nowhere else; a cluster that sends the vendor's calls to another address uses no key for it.")
  label           string!  @description("The owner's name for the key, one to 60 characters, unique among that person's active keys. It is never written on a call record: a screen resolves it through the key's own read, so a person who may not see the key reads 'a key'.")
  encryptedValue  string!  @secret  @description("Base64-encoded nonce || NaCl-secretbox ciphertext of the key, sealed under MEMQL_MASTER_KEY by component/secret.Encrypt on the node that received it. Opaque: never rendered, projected by the one sealed shape a @serverOnly read carries, and unsealed only inside one request to the vendor into a local that dies with it. @secret redacts a rejected value in the function-args validator, which matches by argument name, so the writer's argument is named encryptedValue too.")
  fingerprint     string!  @description("The last four characters of the key, prefixed with '...', for telling two keys apart without revealing either. Display only.")
  isDefault       bool     @description("True for the one key of its owner at this vendor that pays first for the owner's own calls. The owner's other keys at the vendor are used only when a source pins them.")
  autoUse         bool     @description("True once the key's owner switched on 'Let Auto use this key'. False for a new key. A call nobody chose a route for is paid by a key only when this is true; choosing the API route, a route of one's own, or pinning a vendor model is the telling, and Auto is not.")
  checkedBy       enum("list", "use")  @description("How the key is checked. `list` is the default: its vendor's models are listed with it, which sends no prompt and costs no tokens. `use` is a key that may not list models (a restricted key): it is checked only by the real calls it pays for, and the daily check skips it.")
  status          enum("active", "removed")!  @description("`active` pays; `removed` never pays again and is never unsealed again. One-way: a removed key is not restored, a new one is added.")
  addedAt         datetime!  @description("When the key was added, stamped from the clock. Among keys lent to a person, the one added earliest is tried first.")
  removedAt       datetime   @description("When the key was removed, or empty.")
  removedBy       string     @description("The v1:identity:user who removed it: its owner, or a cluster owner stopping a key on their cluster. Supplied by the integration from the authenticated caller.")

  // WHO THE KEY IS LENT TO. A machine's sharing block (v1:worker:registration.sharing)
  // without its cluster-wide mode: there is no way to lend a key to everyone, because a
  // key is one person's money. Admission is the same rule a machine's is
  // (component/worker.Sharing), judged on every call from the rows.
  sharing {
    mode            enum("owner", "people")  @description("Who else may spend this key. owner, the default and the absent case, is its owner only. people is exactly the users in userIds and the active members of the active groups in groupIds.")
    paused          bool      @description("Pause every borrower while keeping the audience. The owner's own calls are not affected.")
    userIds         []string  @description("Under people: the v1:identity:user ids the key is lent to. Empty under owner.")
    groupIds        []string  @description("Under people: the v1:identity:group ids whose active members may spend the key, resolved on every call from the membership rows.")
    pausedUserIds   []string  @description("Listed users whose own grant is paused. A group grant that still admits them is independent.")
    pausedGroupIds  []string  @description("Listed groups whose grant is paused.")
    sharedAt        datetime  @description("When the owner last changed who the key is lent to, stamped from the clock.")
    sharedBy        string    @description("Who changed it, stamped from the actor: the record of who lent a key must not be writable by whoever is holding the keyboard.")
  }

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="removedBy", field="removedBy", target=user, direction="outgoing")
}

/// WHAT THE ENGINE OBSERVED ABOUT ONE API KEY (design record
/// 2026-11-21-vendor-accounts-and-api-keys, decisions K1, K11 and K13): whether the vendor accepts
/// it, a hold while its account is out of credit, and when it was last checked and last used. One
/// row per key, at the key's own short id.
///
/// A ROW OF ITS OWN so that the engine never writes v1:router:vendorKey. Every real call a key pays
/// for is evidence about it, the evidence arrives on whichever replica made the call, and a write is
/// a read-merge of the whole row: if these stamps lived beside the sharing block, a stale engine
/// write could undo an owner's decision to stop lending.
///
/// OLDER EVIDENCE NEVER REPLACES NEWER. `evidenceAt` is the time of the evidence behind `state`. A
/// long call that started before a key was revoked can finish, successfully, after the refusal was
/// recorded; its late good verdict carries an earlier time and is dropped by the writer.
///
/// @serverWritten and client-unreadable for vendorKey's reasons: it is the engine's own account of
/// something only the engine did, and its `detail` is a vendor's words about a person's account.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="keyId", secondary="vendor", status="state")
@belongsTo(cluster)
concept vendorKeyState {
  keyId        string!  @description("The v1:router:vendorKey this row is about. The row's own short id is the key's.")
  ownerUserId  string!  @description("The key's owner, stamped by createVendorKeyState from the actor the write runs as, which is the owner adding the key. The row-authz key; it never moves.")
  vendor       enum("anthropic", "openai")!  @description("The key's vendor, copied at creation so a sweep reads one concept.")
  state        enum("good", "refused", "credit")!  @description("`good`: the vendor served a call or a check with the key. `refused`: the vendor does not accept it, and it is passed over until a check or its owner says otherwise. `credit`: its account is out of credit or at a spend limit, and it is passed over until heldUntil.")
  evidenceAt   datetime!  @description("The time of the evidence behind `state`: when the call or check that produced it STARTED. A verdict with an earlier time than this is not written.")
  detail       string    @description("The vendor's words behind a refusal or a hold, with anything key-shaped removed, at most 300 characters. Empty when good.")
  heldUntil    datetime  @description("Under `credit`: when the next real call may try the key again, one hour after the evidence. Compared with the clock at the time of a call; a past time holds nothing.")
  checkedAt    datetime  @description("When the key's models were last listed, by the add, the daily check or Check now.")
  goodAt       datetime  @description("When the vendor last served a call or a check with the key, stamped at most once an hour. The daily check lists the models of any active key whose goodAt is more than 24 hours old.")
  lastUsedAt   datetime  @description("When a real call was last paid by the key, to within an hour. A heartbeat: it must never enter an arrival-cue fingerprint.")
  notifiedAt   datetime  @description("When the owner was last told the key went from good to refused or out of credit. One notice per fall: none again until the key has been good since.")

  @relationship(type="parent", field="keyId", target=vendorKey, direction="outgoing")
  @relationship(type="references", as="keyOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// Virtual projection of a registered AI provider entry. Never persisted -- rows are produced at
/// query time by the integration.router.listModels capability from the live provider registry.
/// Lives in the concept registry so the engine can shape results without a database round-trip.
@displayCard(primary="providerName", secondary="model", tertiary="vendor", status="available")
@belongsTo(cluster)
concept modelCatalog {
  providerName              string  @description("Registry name (e.g. stream54Mini).")
  providerType              string  @description("Raw @type annotation from the .memql file (OpenAI, AnthropicStream, etc).")
  vendor                    string  @description("Vendor family (openai, anthropic).")
  model                     string  @description("Vendor-side model id.")
  description               string  @description("Human-readable description from the .memql @description annotation.")
  modality                  string  @description("text, tts, stt, embedding, etc.")
  isDefault                 bool    @description("True when the provider carries the @default annotation.")
  available                 bool    @description("True when the provider was instantiated successfully (auth + client).")
  inputCostPerMillion       float   @description("USD per million input tokens.")
  outputCostPerMillion      float   @description("USD per million output tokens.")
  cachedInputCostPerMillion float   @description("USD per million cached-input tokens.")
  pricingConfigured         bool    @description("True when any non-zero pricing annotation is set.")
  contextWindow             int     @description("Maximum token context window.")
}

/// Virtual projection of a registered AI Router policy. Never persisted -- rows are produced at
/// query time by the integration.router.listPolicies capability from the live policy registry.
/// Lives in the concept registry so the engine can shape results without a database round-trip.
@displayCard(primary="name", secondary="description", tertiary="primary")
@belongsTo(cluster)
concept policyCatalog {
  name                   string  @description("Policy name, e.g. balancedChat.")
  description            string  @description("Human-readable description from the @description annotation.")
  primary                string  @description("Primary provider registry name.")
  fallbacks              []string  @description("Fallback provider registry names, in try-order.")
  chain                  []string  @description("Full chain (primary + fallbacks) for convenience.")
}
