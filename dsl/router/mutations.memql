// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Record a single AI call through the MemQL AI Router. Writes one v1:router:call row per call for
/// observability, usage reporting, and cost attribution.
mutation call recordRouterCall {
  args {
    callId              string!
    requestId           string!
    agentId             string
    userId              string
    promptName          string
    policyName          string
    vendor              string!
    model               string!
    providerName        string!
    inputTokens         int
    outputTokens        int
    cachedInputTokens   int
    tokensEstimated     bool
    inputCost           float
    outputCost          float
    cachedInputCost     float
    totalCost           float
    pricingConfigured   bool
    timeToFirstTokenMs  int
    totalDurationMs     int!
    tokensPerSec        float
    streaming           bool
    outcome             string!
    errorCategory       string
    errorMessage        string
    fallbackFromModel   string
    /// Who paid: metered | subscription | local | unknown. Absent reads as metered.
    billing             enum("metered", "subscription", "local", "unknown")
    /// Where the call ran; empty for MemQL's own provider calls.
    executionSurface    string
    /// The level the call was resolved at, after any rule override.
    level               string
    /// The level the CALL declared, before a rule overrode it.
    requestedLevel      string
    /// The level that actually served; differs from level only when degraded.
    servedLevel         string
    /// True when the chain was exhausted at the requested level and the rule said degrade.
    degraded            bool
    /// The rule that matched. Empty only for a call pinned with an explicit provider.
    rule                string
    /// The policy that rule named, after policy: expansion.
    policy              string
    /// local | app | federation -- which door the winning entry belongs to.
    door                string
    /// The door report: every entry the walk passed over, and the one it took.
    considered          []object
    /// The call's footprint, so a decision can be filtered by what it was about.
    touches             []string
    /// The context-window floor this resolution was made against. Never zero.
    minContextTokens    int
    /// Whose machine served a local call. Empty until shared machines land.
    machineOwnerUserId  string
  }
  insert {
    accept { requestId, agentId, userId, promptName, policyName, vendor, model, providerName, inputTokens, outputTokens, cachedInputTokens, tokensEstimated, inputCost, outputCost, cachedInputCost, totalCost, pricingConfigured, timeToFirstTokenMs, totalDurationMs, tokensPerSec, streaming, outcome, errorCategory, errorMessage, fallbackFromModel, executionSurface, level, requestedLevel, servedLevel, degraded, rule, policy, door, considered, touches, minContextTokens, machineOwnerUserId }
    stamp {
      id: args.callId
      // NOT in accept{}: a concept-level @default is documentation and is
      // never applied on insert, so the "absent reads as metered" rule has
      // to be written here to be real. It is the fail-safe direction --
      // unattributed spend counts against the dollar ceiling rather than
      // disappearing into the covered bucket, where the one control that
      // stops runaway cost could not see it.
      billing: args.billing ?? "metered"
    }
  }
}

// ---- mutations/v1/router/setBudget.memql ----

// setBudget
// =========
//
// Upserts a spend cap for the current partition or a specific agent.
// Called from the frontend's /router/settings page.

/// Create or update a budget cap. Scope 'partition' covers all agents; scope 'agent' targets one
/// v1:agents:agent by scopeId.
mutation budget setBudget {
  args {
    id                 string!
    scope              string!
    scopeId            string
    periodType         string!
    limitUSD           float!
    alertThresholdPct  int
    resetAt            string
    active             bool
  }
  insert {
    accept { id, scope, scopeId, periodType, limitUSD, alertThresholdPct, resetAt }
    stamp {
      active: args.active ?? true
    }
  }
}
