// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Record a single AI call through the memQL AI Router. Writes one v1:router:call row per call for
/// observability, usage reporting, and cost attribution.
mutate call recordRouterCall {
  args {
    callId              string!
    requestId           string!
    agentId             string
    userId              string
    promptName          string
    policyName          string
    vendor              string!
    model               string!
    providerName        string!
    inputTokens         int
    outputTokens        int
    cachedInputTokens   int
    tokensEstimated     bool
    inputCost           float
    outputCost          float
    cachedInputCost     float
    totalCost           float
    pricingConfigured   bool
    timeToFirstTokenMs  int
    totalDurationMs     int!
    tokensPerSec        float
    streaming           bool
    outcome             string!
    errorCategory       string
    errorMessage        string
    fallbackFromModel   string
  }
  insert {
    accept { requestId, agentId, userId, promptName, policyName, vendor, model, providerName, inputTokens, outputTokens, cachedInputTokens, tokensEstimated, inputCost, outputCost, cachedInputCost, totalCost, pricingConfigured, timeToFirstTokenMs, totalDurationMs, tokensPerSec, streaming, outcome, errorCategory, errorMessage, fallbackFromModel }
    stamp {
      id: args.callId
    }
  }
}

// ---- mutations/v1/router/setBudget.memql ----

// setBudget
// =========
//
// Upserts a spend cap for the current partition or a specific agent.
// Called from the frontend's /router/settings page.

/// Create or update a budget cap. Scope 'partition' covers all agents; scope 'agent' targets one
/// v1:agents:agent by scopeId.
mutate budget setBudget {
  args {
    id                 string!
    scope              string!
    scopeId            string
    periodType         string!
    limitUSD           float!
    alertThresholdPct  int
    resetAt            string
    active             bool
  }
  insert {
    args.id
    args.scope
    args.scopeId
    args.periodType
    args.limitUSD
    args.alertThresholdPct
    args.resetAt
    active: args.active ?? true
  }
}
