// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@enabled
@useConcept(call)
@description("Record a single SI call through the memQL SI Router. Writes one v1:router:call row per call for observability, usage reporting, and cost attribution.")
mutation mutationRecordRouterCall {
  args {
    requestId           string  @required
    agentId             string
    userId              string
    spaceId             string
    promptName          string
    policyName          string
    vendor              string  @required
    model               string  @required
    providerName        string  @required
    inputTokens         int
    outputTokens        int
    cachedInputTokens   int
    tokensEstimated     bool
    inputCost           float
    outputCost          float
    cachedInputCost     float
    totalCost           float
    pricingConfigured   bool
    timeToFirstTokenMs  int
    totalDurationMs     int     @required
    tokensPerSec        float
    streaming           bool
    outcome             string  @required
    errorCategory       string
    errorMessage        string
    fallbackFromModel   string
  }
  insert call {
    id: args.requestId
    args.requestId
    args.agentId
    args.userId
    args.spaceId
    args.promptName
    args.policyName
    args.vendor
    args.model
    args.providerName
    args.inputTokens
    args.outputTokens
    args.cachedInputTokens
    args.tokensEstimated
    args.inputCost
    args.outputCost
    args.cachedInputCost
    args.totalCost
    args.pricingConfigured
    args.timeToFirstTokenMs
    args.totalDurationMs
    args.tokensPerSec
    args.streaming
    args.outcome
    args.errorCategory
    args.errorMessage
    args.fallbackFromModel
  }
}

// ---- mutations/v1/router/setBudget.memql ----

// setBudget
// =========
//
// Upserts a spend cap for the current partition or a specific agent.
// Called from the CoPresent /router/settings page.

@enabled
@useConcept(budget)
@description("Create or update a budget cap. Scope 'partition' covers all agents; scope 'agent' targets one v1:copresent:agent by scopeId.")
mutation mutationSetBudget {
  args {
    id                 string  @required
    scope              string  @required
    scopeId            string
    periodType         string  @required
    limitUSD           float   @required
    alertThresholdPct  int
    resetAt            string
    active             bool
  }
  insert budget {
    args.id
    args.scope
    args.scopeId
    args.periodType
    args.limitUSD
    args.alertThresholdPct
    args.resetAt
    active: coalesce(args.active, true)
  }
}
