use installation.builtins.{ installationApplications }

/// Perform one admitted revision pass and record the controller's current facts.
/// Native start mode binds the original operator and installed execution recipe.
/// A replacement observer cannot write; controller facts do not complete an update.
@template
automation installationRevisionWorkflow {
  applications := builtin installationApplications()
  current := builtin installationRevisionRead()
  if current.mayApply {
    if current.needsWrite {
      builtin installationRevisionConfiguration()
      builtin installationRevisionResolve()
      builtin installationRevisionCompatibility()
      for app in applications {
        for role in ["rollback", "candidate"] {
          builtin installationRevisionReopenSource(application: app.key, role: role)
          builtin installationRevisionRenderSource(application: app.key, role: role)
        }
      }
      builtin installationRevisionVerifyResources()
      automation installationArtifactWorkflow()
      builtin installationRevisionRecheckResources()
      builtin installationRevisionVerifyStorage()
      builtin installationRevisionVerifyProtected()
      builtin installationRevisionReobserveConfig()
      builtin installationRevisionBegin()
    }
    for app in applications { builtin installationRevisionApply(application: app.key) }
  }
  for app in applications { builtin installationRevisionObserve(application: app.key) }
}

/// Requalify the exact applied revision before recording installation completion.
/// Every native proof is fresh; a controller success alone never closes the attempt.
@template
automation installationCompletionWorkflow {
  state := builtin installationCompletionRead()
  if !state.converged { return }
  builtin installationCompletionConfiguration()
  builtin installationRevisionResolve()
  builtin installationRevisionCompatibility()
  applications := builtin installationApplications()
  for app in applications {
    for role in ["rollback", "candidate"] {
      builtin installationRevisionReopenSource(application: app.key, role: role)
      builtin installationRevisionRenderSource(application: app.key, role: role)
    }
  }
  builtin installationRevisionVerifyResources()
  automation installationArtifactWorkflow()
  builtin installationRevisionRecheckResources()
  builtin installationRevisionVerifyStorage()
  builtin installationRevisionVerifyProtected()
  builtin installationCompletionPrepareWorkloads()
  automation installationWorkloadWorkflow()
  builtin installationCompletionContinuity()
  builtin installationCompletionReobserve()
  builtin installationCompletionRecord()
}
