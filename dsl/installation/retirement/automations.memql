/// Reconcile a bounded page of each capture, preserving native progress for another pass.
/// Every external operation retains its journal, actor and immutable scope gates.
@template
automation installationRetirementWorkflow {
  builtin installationRetirementBegin()
  builtin installationRetirementStop()
  requirements := builtin installationRetirementRequirements()
  for capture in requirements {
    builtin installationRetirementFence(role: capture.key)
    builtin installationRetirementRelease(role: capture.key)
    pending := builtin installationRetirementPage(role: capture.key)
    for artifact in pending.items {
      builtin installationRetirementArtifact(role: capture.key, intentId: artifact.intentId)
    }
    builtin installationRetirementPage(role: capture.key)
  }
  observed := builtin installationRetirementObserve()
  if observed.ready {
    builtin installationRetirementComplete()
  }
}
