/// Read candidate and rollback image bytes in a scoped installation preparation.
/// Native ports bind the complete inventory, signed artifacts and registry trust;
/// this recipe chooses ordering and stops on the first unavailable image.
@template
automation installationArtifactWorkflow {
  requirements := builtin installationArtifactRequirements()
  for item in requirements {
    builtin installationArtifactCheck(key: item.key)
  }
  builtin installationArtifactsComplete()
}

// Selection and ordering are visible here. Each native operation preserves
// its own evidence and journal gates even if a different recipe omits a step.
@template
automation installationPrepareWorkflow {
  builtin installationResolvePublications()
  builtin installationCheckCompatibility()
  builtin installationReservePreparation()
  applications := builtin installationApplications()
  for app in applications {
    for role in ["rollback", "candidate"] {
      builtin installationCaptureSource(application: app.key, role: role)
      dependencies := builtin installationSourceRequirements(application: app.key, role: role)
      for dependency in dependencies {
        builtin installationCaptureDependency(application: app.key, role: role, key: dependency.key)
        builtin installationVerifyDependency(application: app.key, role: role, key: dependency.key)
        builtin installationAcknowledgeDependency(application: app.key, role: role, key: dependency.key)
      }
      builtin installationVerifySourceGraph(application: app.key, role: role)
      builtin installationAcknowledgeSource(application: app.key, role: role)
      builtin installationRenderSource(application: app.key, role: role)
    }
  }
  builtin installationVerifyResources()
  automation installationArtifactWorkflow()
  builtin installationRecheckResources()
  builtin installationVerifyStorage()
  builtin installationVerifyProtected()
  builtin installationContinuityBaseline()
  builtin installationReobserveConfiguration()
  builtin installationPromotePreparation()
}

/// Prepare immutable signed image pins, save their intent, then open a draft PR.
@template
automation installationOverlayProposalWorkflow {
 builtin releaseOverlayRead()
 builtin releaseOverlayBuild()
 builtin releaseOverlayReserve()
 builtin releaseOverlayPropose()
}

/// One read of the exact PR; only a verified merge becomes selectable.
@template
automation installationOverlayObservationWorkflow {
 builtin releaseOverlayObserve()
}
