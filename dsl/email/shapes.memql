/// Restricted encrypted storage projection, consumed by the capture integration.
@row
shape capturedMessage capturedEmailStored {
  row.id
  row.createdAt
  encryptedValue
}

@row
shape connectionState emailConnectionStateStored {
  accountId
  row.id
  row.createdAt
  encryptedValue
}

@row
shape sendOperation emailSendOperationStored {
  row.id
  row.createdAt
  accountId
  status
  nextPollAt
  encryptedValue
}

@row
shape connectionState emailConnectionIndex {
 row.id
 accountId
}
