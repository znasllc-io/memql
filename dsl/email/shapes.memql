/// Restricted encrypted storage projection, consumed by the capture integration.
@row
shape capturedMessage capturedEmailStored {
  row.id
  row.createdAt
  encryptedValue
}

/// A sealed connection state as its gated readers take it. purpose and nextAttemptAt are the
/// feedback indexer's schedule, which it re-reads under the row's gate so a look another replica
/// already took is not taken (and written) again.
@row
shape connectionState emailConnectionStateStored {
  accountId
  purpose
  nextAttemptAt
  row.id
  row.createdAt
  encryptedValue
}

@row
shape sendOperation emailSendOperationStored {
  row.id
  row.createdAt
  accountId
  status
  nextPollAt
  encryptedValue
}

@row
shape connectionState emailConnectionIndex {
 row.id
 accountId
}
