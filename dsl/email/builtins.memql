@sdk
@executor("integration.email.inbox")
@description("Read the last 100 captured test messages from the last seven days. Owner or developer only; capture must be explicitly configured. This is a sensitive test inbox, not evidence of Internet delivery.")
builtin emailInbox {}

@sdk
@executor("integration.email.azureSetup")
@description("Connect the selected organization to Microsoft Azure email. Owner or developer only. Sign-in credentials stay encrypted on the cluster; responses expose only sign-in instructions and resource choices.")
builtin emailAzureSetup {
  accountId string!
  action string!
  sessionId string
  options object
}
