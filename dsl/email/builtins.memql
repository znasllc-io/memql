@sdk
@executor("integration.email.inbox")
@description("Read the last 100 captured test messages from the last seven days. Owner or developer only; capture must be explicitly configured. This is a sensitive test inbox, not evidence of Internet delivery.")
builtin emailInbox {}

@sdk
@executor("integration.email.azureSetup")
@description("Configure one Microsoft Azure connection for the cluster with accountId self, then manage each organization's domain and sender using that saved connection. Owner or developer only. Credentials stay encrypted on the cluster.")
builtin emailAzureSetup {
  accountId string!
  action string!
  sessionId string
  options object
}
