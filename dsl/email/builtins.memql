@sdk
@executor("integration.email.inbox")
@description("Read the last 100 captured test messages from the last seven days. Owner or developer only; capture must be explicitly configured. This is a sensitive test inbox, not evidence of Internet delivery.")
builtin emailInbox {}

@sdk
@executor("integration.email.azureSetup")
@description("Configure one Microsoft Azure connection for the cluster with accountId self, then manage each organization's domain and sender using that saved connection. Owner or developer only. Credentials stay encrypted on the cluster.")
builtin emailAzureSetup {
  accountId string!
  action string!
  sessionId string
  options object
}

// Private installation operations: registered for boot audit but callable only
// through the native startup workflow scope, never through a wire caller.
@executor("integration.email.emailInstallationConnect")
builtin emailInstallationConnect {}
@executor("integration.email.emailInstallationPrepare")
builtin emailInstallationPrepare {}
@executor("integration.email.emailInstallationProvision")
builtin emailInstallationProvision {}
@executor("integration.email.emailInstallationSender")
builtin emailInstallationSender {}

@executor("integration.email.emailInstallationAccount")
builtin emailInstallationAccount {}
