/// An encrypted message captured by an explicitly configured test transport.
/// There is no Internet receipt or external delivery implied by this record.
/// Bodies and recipient addresses are decrypted only by the gated email capability.
@displayCard(primary="id", secondary="createdAt")
@rowAuthz(clusterOwner)
concept capturedMessage {
  encryptedValue string! @description("Encrypted message, including recipient and authentication links. Never broadcast as plaintext.")
}
