/// Restricted transport storage read. The public capability checks test-inbox access first.
/// actor.userId scoping cannot represent an operator test inbox: identity services
/// send to recipients who may not have an account. The owner/developer gate runs
/// before this query is called under the internal capture service actor.
@actor
@serverOnly
@cache(0)
query capturedMessage capturedEmails {
  args { since datetime! }
  filter row => row.createdAt >= args.since && actor.isClusterOwner == true
  sort "row.createdAt", "desc"
  paginate 100
  shape capturedEmailStored
}

/// Internal encrypted state lookup after operator or delivery authorization.
/// actor.userId scoping cannot represent a transport shared by an organization's
/// workers; the integration validates the requesting actor before unsealing.
@actor
@serverOnly
@cache(0)
query connectionState emailConnectionStateById {
  args { stateId string! }
  filter row => row.id == args.stateId && actor.isClusterOwner == true
  shape emailConnectionStateStored
}
