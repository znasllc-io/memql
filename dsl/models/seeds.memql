  params:           4660000000
  quant:            "Q4_K_M"
  sizeBytes:        4000000000
  memoryNeedBytes:  8000000000
  contextWindow:    262144
  flags:            ["structured", "tools", "thinking", "vision", "streaming"]
  dimensions:       0
  license:          "apache-2.0"
  source:           "https://ollama.com/library/qwen3.5:4b"
  reviewedAt:       "2026-10-15T00:00:00Z"
  recommendedFor:   []
