// queries.memql
//
// Reads over the compose namespace. Same-domain constructs are ambient, so
// there is no `use compose.*` line here (#2617).
//
// Public record reads spell the composite tier out as a top-level conjunct,
// `(row.ownerUserId == actor.userId || actor.isClusterOwner == true)`.
// TestRowAuthzEnforcementLandGate (component/memql) refuses a read over a
// tiered concept that no top-level conjunct narrows, and it has no
// exemption list -- so the filter says out loud what the concept's tier
// already implies, and the gate can see it.
//
// Complete catalogs remain available to explicit editor pickers. OS directories
// use the Browse queries below: archive/search filters precede ten-row paging,
// and each filter keeps an independent session cursor in the client.

/// Everything materialized, newest first: the Materialized view's one read and the Files app's
/// Materializer place. Owned, with the cluster-owner escape -- which is what makes "everything
/// materialized in THIS INSTANCE" (the epic's words) a claim this read can honestly make. A plain
/// owner tier has no bypass on the read path, so an operator would silently see one person's subset.
@actor
query composition compositions {
  args {
    status  string
    format  string
  }
  filter    row => (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
                && (args.status == nil || row.status == args.status)
                && (args.format == nil || row.format == args.format)
  sort      "row.createdAt", "desc"
  paginate  50
  // The retained feed also supplies the open Composer. Provenance must
  // survive reloads rather than appearing only after a live update.
  shape     compositionFull
}

/// One composition in full, for the open Composer and the record panel. Gated to its owner, so a
/// caller cannot read somebody else's composition even holding its id.
@actor
query composition compositionById {
  args {
    compositionId  string!
  }
  filter  row => row.id == args.compositionId
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   compositionFull
}

/// The compositions produced by one recipe, newest first. Backs the recipe row's "what it has
/// made" and the evidence that a re-run matched the catalog: two runs of one recipe, one with
/// models and one without.
@actor
query composition compositionsForRecipe {
  args {
    recipeId  string!
  }
  filter    row => row.recipeId == args.recipeId
                && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  sort      "row.createdAt", "desc"
  paginate  50
  shape     compositionCard
}

/// The composition that produced one Library file, if one did. Backs the Files app's inspector
/// line ("Made in the Materializer from 3 sources") and its Open in Materializer act -- the one
/// direction of the seam agreed with the Files-places epic, which never edits a composition.
@actor
query composition compositionForOutputFile {
  args {
    fileId  string!
  }
  filter  row => row.outputFileId == args.fileId
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  sort    "row.createdAt", "desc"
  shape   compositionCard
}

/// The caller's templates, newest first: the Templates section and the Target column's picker.
@actor
query composeTemplate composeTemplates {
  args {
    format  string
  }
  filter    row => (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
                && (args.format == nil || row.format == args.format)
  sort      "row.createdAt", "desc"
  paginate  50
  shape     composeTemplateFull
}

/// One template by id, gated to its owner. Backs the template editor and the render step's own
/// resolution -- which runs under the caller's actor, so a composition naming somebody else's
/// template resolves zero rows and is refused rather than rendering through it.
@actor
query composeTemplate composeTemplateById {
  args {
    templateId  string!
  }
  filter  row => row.id == args.templateId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   composeTemplateFull
}

/// The caller's recipes, newest first: the Templates section's recipe list and the Composer's
/// "run one again" affordance.
@actor
query recipe composeRecipes {
  filter    row => row.ownerUserId == actor.userId || actor.isClusterOwner == true
  sort      "row.createdAt", "desc"
  paginate  50
  shape     composeRecipeFull
}

/// One recipe by id, gated to its owner. Backs running a recipe: the selectors it holds are
/// resolved under the caller's own actor, so a recipe can never widen what its runner may read.
@actor
query recipe composeRecipeById {
  args {
    recipeId  string!
  }
  filter  row => row.id == args.recipeId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   composeRecipeFull
}

/// Execution identities and output metadata. The executor checks the owner and work run before
/// loading the separately stored, owner-only input snapshot.
@actor
query composition compositionExecutionById {
  args {
    compositionId string!
  }
  filter row => row.id == args.compositionId
             && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape compositionExecution
}

/// The input snapshot captured under this owner. Account membership and cluster ownership grant
/// no access: source payloads may have been private even when the resulting composition is shared.
@actor
query compositionInput compositionInputById {
  args {
    compositionId string!
  }
  filter row => row.id == args.compositionId && row.ownerUserId == actor.userId
  shape compositionInputFull
}

/// Owned output receipts for one executing run, used by document revision review.
@actor
query composition compositionsForRun {
 args { runId string! }
 filter row => row.ownerUserId == actor.userId && row.runId == args.runId
 sort "row.createdAt", "desc"
 paginate 2
 shape compositionFull
}

/// Output-to-composition directory. Ordinary Files browsing supplies visible ids;
/// the Materializer place requests compact output membership explicitly.
@actor
query composition compositionOutputIndex {
  args {
    fileIds []string
  }
  filter row => (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
    && row.outputFileId != nil && row.outputFileId != ""
    && (args.fileIds == nil || row.outputFileId in args.fileIds)
  sort "row.createdAt", "desc", "row.id", "desc"
  paginate 50
  shape compositionOutput
}

/// Recent directory page. Search and archive selection precede the cursor;
/// by-id reads remain available for links outside these ten records.
@actor
query composition compositionsBrowse {
  args {
    search string
    includeArchived bool
    format string
  }
  filter row => (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
    && (args.includeArchived == true || row.archived != true)
    && (args.format == nil || args.format == "" || row.format == args.format)
    && (args.search == nil || trim(args.search) == "" || row.name.includes(trim(args.search), true) || row.statement.includes(trim(args.search), true))
  sort "row.createdAt", "desc", "row.id", "asc"
  paginate 10
  shape compositionFull
}

/// Recent directory page. Search and archive selection precede the cursor;
/// by-id reads remain available for links outside these ten records.
@actor
query composeTemplate composeTemplatesBrowse {
  args {
    search string
    includeArchived bool
    format string
  }
  filter row => (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
    && (args.includeArchived == true || row.archived != true)
    && (args.format == nil || args.format == "" || row.format == args.format)
    && (args.search == nil || trim(args.search) == "" || row.name.includes(trim(args.search), true) || row.description.includes(trim(args.search), true))
  sort "row.createdAt", "desc", "row.id", "asc"
  paginate 10
  shape composeTemplateFull
}

/// Recent directory page. Search and archive selection precede the cursor;
/// by-id reads remain available for links outside these ten records.
@actor
query recipe composeRecipesBrowse {
  args {
    search string
    includeArchived bool
    format string
  }
  filter row => (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
    && (args.includeArchived == true || row.archived != true)
    && (args.format == nil || args.format == "" || row.format == args.format)
    && (args.search == nil || trim(args.search) == "" || row.name.includes(trim(args.search), true) || row.description.includes(trim(args.search), true))
  sort "row.createdAt", "desc", "row.id", "asc"
  paginate 10
  shape composeRecipeFull
}
