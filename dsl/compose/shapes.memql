// shapes.memql
//
// Projections over the compose concepts. EXPLICIT rather than the default
// projection, for the reason the Users app records in clients/os/README.md:
// a query with no shape projects every field of its concept, so a later
// field lands in every browser that ever opened the list without anybody
// deciding it should.
//
// The Materializer's retained feed supplies both its list and its open
// Composer, so it uses Full: sources and model contributions must remain
// visible after a reload. Card is for secondary lookups whose callers only
// need identity and state, such as the Files output-to-composition join.

/// A composition summary for secondary lookups: identity, output and state. The Materializer's
/// shared list-and-detail feed uses compositionFull so reloading retains its provenance.
@row
shape composition compositionCard {
  row.id
  row.createdAt
  ownerUserId
  name
  statement
  status
  format
  outputKind
  templateId
  outputFileId
  folderId
  accountIds
  goalId
  runId
  recipeId
  provenanceEmbedded
  provenanceNote
  deployableKind
  failureReason
  archived
}

/// Everything about one composition, for the open Composer and the record panel. The two list
/// fields the card omits are the whole reason this shape exists.
@row
shape composition compositionFull {
  row.id
  row.createdAt
  ownerUserId
  name
  statement
  status
  format
  outputKind
  sources
  templateId
  outputFileId
  folderId
  accountIds
  goalId
  runId
  recipeId
  modelsUsed
  provenanceEmbedded
  provenanceNote
  sha256
  failureReason
  deployableKind
  archived
}

/// One template, everywhere it appears -- the Templates list, the Target column's picker, and the
/// record panel's "rendered through" line. One shape rather than a card/full pair: `placeholders`
/// is what a picker needs in order to say what a template will ask for BEFORE it is chosen, so
/// there is no reading of a template that wants less than this.
@row
shape composeTemplate composeTemplateFull {
  row.id
  row.createdAt
  ownerUserId
  name
  description
  fileId
  format
  placeholders
  accountIds
  archived
}

/// One recipe. Same reasoning as the template shape: `sourceSelectors` is what makes a recipe row
/// legible ("the invoices matching status=open"), so a card without it would be a name and a date.
@row
shape recipe composeRecipeFull {
  row.id
  row.createdAt
  ownerUserId
  name
  description
  sourceSelectors
  templateId
  format
  outputKind
  folderId
  accountIds
  lastRunAt
  runCount
  archived
}

/// Persisted identities and result needed to adopt a materialization on a different replica.
@row
shape composition compositionExecution {
  row.id
  ownerUserId
  name
  status
  goalId
  runId
  outputFileId
  format
  sha256
  modelsUsed
  provenanceEmbedded
  provenanceNote
  deployableKind
}

/// Owner-only request and source snapshot, read when execution resumes on another replica.
@row
shape compositionInput compositionInputFull {
  row.id
  ownerUserId
  compositionId
  request
}
