
/// A display-only mismatch benefits from observing the UI. Other needs retain the original host call.
logic agentRecoveryUsesDesktop {
 args { needs []string! }
 return args.needs.count() == 1 && "display" in args.needs
}

/// Human wording for the bounded recovery consent card.
logic agentRecoveryExplanation {
 args { needs []string! action string! }
 if "available_capacity" in args.needs { return "The Workbench queue is full. This command has not started. May it run on your connected computer?" }
 reasons := args.needs.select(need => need == "display" ? "a graphical display" : need == "gpu" ? "a GPU" : need == "macos_tooling" ? "macOS-only tooling" : need == "user_files" ? "files that are on your own machine" : need == "os" ? "a different operating system" : need).reduce("", (text, word) => text == "" ? word : text + ", " + word)
 return "The sandboxed workbench cannot run this " + args.action + " step: it needs " + reasons + "."
}

/// Only a verified consent refusal is a reason to ask for access.
logic agentRecoveryNeedsConsent {
 args { errorCode string! }
 return args.errorCode == "denied_no_per_task_approval" || args.errorCode == "denied_by_scope" || args.errorCode == "execution_destination_requires_permission"
}

/// Reconsider before spending the last calls, or after repeated discovery/evidence.
/// A review uses the next ordinary model call. Only continued stalling asks the
/// person; approaching a cap alone does not interrupt productive work.
logic agentProgressRecovery {
 args {
  limit int!
  used int!
  discoveryRounds int!
  repeatedRounds int!
  reviewActive bool!
  stalledAfterReview int!
  reviewedLimit int!
 }
 stalled := args.discoveryRounds >= 3 || args.repeatedRounds >= 3
 nearLimit := args.limit >= 6 && (args.used >= args.limit * 0.75 || args.limit - args.used <= 3)
 mustAsk := args.reviewActive && (args.stalledAfterReview >= 2 || (args.stalledAfterReview > 0 && args.limit > 0 && args.limit - args.used <= 1))
 if args.limit > 0 && args.used >= args.limit { return "continue" }
 if mustAsk { return "ask" }
 if nearLimit && args.reviewedLimit != args.limit { return "review_budget" }
 return !args.reviewActive && stalled ? "review_stalled" : "continue"
}
