// prompts.memql
//
// Agent-namespace prompt declarations. These are the SYSTEM prompts the
// platform-bootstrapped agents (Planner, Trainer) carry on their
// providerConfig. The bodies live in prompts/<name>.tmpl.

@defaultProvider("reasoningClaudeOpus")
@templateFile("prompts/plannerAgent.tmpl")
@description("System prompt for the user's Planner Agent -- the orchestrator persona that owns Plan decomposition, Task dispatch, retry decisions, and escalation to the user. Paired with Claude Opus 4.6 + extended thinking (reasoningClaudeOpus) so the model reasons over the plan + specialists + phase state before emitting each structured-output action. Invoked by the planner-service on every Plan loop iteration. Output contract: one structured-output decision per turn (decompose / dispatchTask / retry / createSpecialist / extendSpecialist / spawnTrainingPlan / escalate / markPlanSucceeded / markPlanFailed).")
prompt plannerAgent {
  plan          object  @required @description("Current v1:planner:plan row with goal, phases, status, tokenBudget, tokenSpent, retryThreshold.")
  tasks         []object         @description("All v1:planner:task rows under this plan, semantic + toolInvocation, sorted by createdAt. Lets the Planner see what's been attempted and what's still queued.")
  specialists   []object @required @description("Agents available in the space, with roleSlug, capabilities.tools, capabilities.domains, and lineage. The Planner picks dispatch targets from this list.")
  feedbackResponse object       @description("User's response when resuming from an awaitingFeedback parking event. Carries {response, respondedBy, respondedAt}.")
  partition     string  @required @description("Active partition envelope -- needed when proposing createSpecialist (the new agent lands in this partition).")
  now           string  @required @description("RFC3339 wall-clock at invocation. Lets the Planner reason about elapsed time, deadlines, refresh windows.")
}

@defaultProvider("streamClaudeOpus")
@templateFile("prompts/trainerAgent.tmpl")
@description("System prompt for the user's Trainer Agent -- the specialist persona that runs knowledge-domain training via web search + reasoning. Paired with a strong-reasoning + web-search-capable model. Invoked when the planner-service picks up a Plan of kind='trainSpecialist'. Output contract: a sequence of tool calls (webSearch / fetchUrl / writeKnowledgeChunk / markChunkSuperseded / embedChunk) followed by a respondToUser envelope summarizing chunks written, sources consulted, and confidence.")
prompt trainerAgent {
  plan              object  @required @description("Current v1:planner:plan row, kind='trainSpecialist', input={specialistId, topic, mode, domainId}.")
  targetSpecialist  object  @required @description("The agent being trained -- role, description, domains, existing chunk summaries (truncated for refresh mode).")
  existingCorpus    []object         @description("For mode='refresh': summaries of existing chunks in the target domain, with createdAt. Lets the Trainer decide what's still current.")
  partition         string  @required @description("Active partition -- new chunks land in this partition.")
  now               string  @required @description("RFC3339 wall-clock.")
}

@defaultProvider("strongReasoning")
@templateFile("prompts/agentFactoryAnalyze.tmpl")
@description("Structured-output prompt invoked by the General Assistant's ensureAgent tool to analyze a goal + decide whether to match, extend, or create an agent. Output JSON contract: { action: 'match'|'extend'|'create', targetAgentId?: string, roleSlug: string, domainIds: []string, liveSourceIds: []string, toolSlugs: []string, reasoning: string }. The ensureAgent executor reads the structured output, validates against the role catalog + existing agents, and issues the appropriate mutation.")
prompt agentFactoryAnalyze {
  goal              string    @required @description("The user-stated goal driving the agent-provisioning decision. Forwarded verbatim from the ensureAgent tool call.")
  existingAgents    []object  @required @description("Compact snapshot of the user's existing agents -- [{id, name, roleSlug, capabilities: {domains, tools}}]. The factory uses this to decide whether an existing agent already fits (match) or could fit with additions (extend).")
  roleCatalog       []object  @required @description("Compact snapshot of the v1:agents:agentRole catalog -- [{slug, name, category, lockedDomainIds, defaultDomainIds, lockedToolSlugs, defaultToolSlugs, tier}]. The factory must pick roleSlug from this set; user-created roles are also valid but predefined ones cover almost every common case.")
  domainCatalog     []object  @required @description("Compact snapshot of v1:common:knowledgeDomain rows -- [{id, name, category, scope}]. The factory references domain ids by their stable slug-style id.")
  liveSourceCatalog []object            @description("Compact snapshot of v1:knowledge:liveSource rows -- [{id, name, sourceType, refreshIntervalMs}]. The factory references live-source ids when the role needs streams (inventory, market data, etc.).")
  toolCatalog       []object  @required @description("Compact snapshot of registered tools -- [{name, description, allowedRoles}]. The factory must pick toolSlugs from this set. Tools whose allowedRoles excludes the chosen roleSlug cannot be selected.")
  now               string    @required @description("RFC3339 wall-clock.")
}
