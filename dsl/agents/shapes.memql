// shapes.memql
//
// Agent-namespace projections. Houses the full presentation shape
// (agentFull) consumed by every BFF that lists agents, the authoritive
// agentAuthorizationFull projection for the standing-grants surface,
// and the dedupe-step shapes the planner uses.

/// AgentAuthorization projection. Backs the agent settings 'Standing authorizations' table where
/// the user reviews and revokes grants, plus the agent's prompt-context resolver that needs to read
/// the current standing computer_use scope.
@row
shape agentAuthorization agentAuthorizationFull {
  row.id
  agentId
  userId
  planKind
  spaceScope
  computerUseScope
  tokenBudgetCap
  expiresAt
  active
  row.createdAt
}

// Comprehensive agent projection with all configuration fields.
//
// Owner fields:
//
//   - payload.ownerUserId -- explicit "who owns this agent" pointer
//     stamped on the create mutation. Required for auto-seeded
//     agents (the GA, provisioned at engine startup whose actor is
//     `system:seed:...`, not the user) so owner-keyed lookups
//     resolve to a real user id.
//   - createdBy -- engine-auto-stamped from the request actor at
//     insert time. For user-created specialists this IS the user,
//     so resolveAgentOwner / scanCreatedBy fall back to it after
//     ownerUserId.

/// Comprehensive agent projection with all configuration fields
@row
shape agent agentFull {
  row.id
  ownerUserId
  name
  description
  personality
  systemPrompt
  role
  roleSlug
  kind
  capabilities
  providerConfig
  groupIds
  active
  deleted
  row.createdAt
  row.createdBy
}

/// Minimal agent projection used by agentRoleSlugsInUse: just id + roleSlug, since the create-agent
/// dropdown only needs to know which slugs are taken (not the full agent payload).
@row
shape agent agentRoleSlugLite {
  row.id
  roleSlug
}

/// Compact agent projection the layered-dedupe similarity step consumes. Carries only the fields
/// that influence dedupe decisions: identity (id, roleSlug, name, description), capabilities the
/// Planner reasons about (domains, tools, keywords), and the lineage that lets the Planner avoid
/// daisy-chaining extensions (extendedFromAgentId, extensionGoals). Embedding (roleEmbedding) is
/// included so the dedupe-Layer-1 cosine math has the data it needs without a second row fetch.
@row
shape agent agentMinimalForDedupe {
  row.id
  name
  role
  roleSlug
  kind
  description
  capabilities
  lineage
  roleEmbedding
}

/// Full projection of an agentRole catalog row. Carries every field the cockpit's role picker + the
/// agent-creation factory need: slug + display + category + tier for the picker; the skill-id lock
/// + default + forbidden lists + maxSkills cap for the materialization step (Phase 2 cut: #158 --
/// replaces the seven flat domain/tool/liveKnowledge lists with a single skill-id surface);
/// recommended policy / gender / system-prompt hints for the agent's initial values. predefined is
/// included so the UI can render predefined rows as locked.
@row
shape agentRole agentRoleFull {
  row.id
  slug
  name
  description
  category
  tier
  lockedSkillIds
  defaultSkillIds
  availableSkillIds
  forbiddenSkillIds
  maxSkills
  recommendedPolicySlug
  systemPromptHints
  active
  predefined
}

/// Full skillChangeEvent projection. Carries the changeKind + before/after snapshots + actor
/// attribution (agent or user) + originating Plan link so the cockpit trace viewer (cockpit#125)
/// can render an agent's skill-attach history inline with the plan task detail. Phase 3 surface
/// (memql#159); rows are append-only.
@row
shape skillChangeEvent skillChangeEventFull {
  row.id
  targetAgentId
  skillId
  changeKind
  before
  after
  actorAgentId
  actorUserId
  planId
  row.createdAt
}
