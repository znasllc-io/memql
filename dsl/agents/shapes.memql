// shapes.memql
//
// Agent-namespace projections. Houses the full presentation shape
// (agentFull) consumed by every BFF that lists agents, the authoritive
// agentAuthorizationFull projection for the standing-grants surface,
// and the dedupe-step shapes the planner uses.

use agents.concepts.{ agent, agentAuthorization, agentRole, avatarPersona, skill, skillChangeEvent }

@row
@description("AgentAuthorization projection. Backs the agent settings 'Standing authorizations' table where the user reviews and revokes grants, plus the agent's prompt-context resolver that needs to read the current standing computer_use scope.")
shape agentAuthorization agentAuthorizationFull {
  row.id
  payload.agentId
  payload.userId
  payload.planKind
  payload.spaceScope
  payload.computerUseScope
  payload.tokenBudgetCap
  payload.expiresAt
  payload.active
  row.createdAt
}

// Comprehensive agent projection with all configuration fields.
//
// Owner fields:
//
//   - payload.ownerUserId -- explicit "who owns this agent" pointer
//     stamped on the create mutation. Required for auto-seeded
//     agents (the GA, provisioned at engine startup whose actor is
//     `system:seed:...`, not the user) so owner-keyed lookups
//     resolve to a real user id.
//   - createdBy -- engine-auto-stamped from the request actor at
//     insert time. For user-created specialists this IS the user,
//     so resolveAgentOwner / scanCreatedBy fall back to it after
//     ownerUserId.

@row
@description("Comprehensive agent projection with all configuration fields")
shape agent agentFull {
  row.id
  payload.ownerUserId
  payload.name
  payload.description
  payload.personality
  payload.systemPrompt
  payload.role
  payload.roleSlug
  payload.kind
  payload.capabilities
  payload.avatar
  payload.providerConfig
  payload.triggerBehavior
  payload.groupIds
  payload.active
  payload.deleted
  payload.audioControl
  payload.gender
  row.createdAt
  row.createdBy
}

@row
@description("Minimal agent projection used by queryAgentRoleSlugsInUse: just id + roleSlug, since the create-agent dropdown only needs to know which slugs are taken (not the full agent payload).")
shape agent agentRoleSlugLite {
  row.id
  payload.roleSlug
}

@row
@description("Compact agent projection the layered-dedupe similarity step consumes. Carries only the fields that influence dedupe decisions: identity (id, roleSlug, name, description), capabilities the Planner reasons about (domains, tools, keywords), and the lineage that lets the Planner avoid daisy-chaining extensions (extendedFromAgentId, extensionGoals). Embedding (roleEmbedding) is included so the dedupe-Layer-1 cosine math has the data it needs without a second row fetch.")
shape agent agentMinimalForDedupe {
  row.id
  payload.name
  payload.role
  payload.roleSlug
  payload.kind
  payload.description
  payload.capabilities
  payload.lineage
  payload.roleEmbedding
}

@row
@description("Full projection of an agentRole catalog row. Carries every field the cockpit's role picker + the agent-creation factory need: slug + display + category + tier for the picker; the skill-id lock + default + forbidden lists + maxSkills cap for the materialization step (Phase 2 cut: #158 -- replaces the seven flat domain/tool/liveKnowledge lists with a single skill-id surface); recommended policy / gender / system-prompt hints for the agent's initial values. predefined is included so the UI can render predefined rows as locked.")
shape agentRole agentRoleFull {
  row.id
  payload.slug
  payload.name
  payload.description
  payload.category
  payload.tier
  payload.lockedSkillIds
  payload.defaultSkillIds
  payload.availableSkillIds
  payload.forbiddenSkillIds
  payload.maxSkills
  payload.recommendedPolicySlug
  payload.recommendedGender
  payload.systemPromptHints
  payload.active
  payload.predefined
}

@row
@description("Lightweight skill projection: slug + display + tier + tags. Backs catalog list / picker surfaces where the caller doesn't yet need the domain / tool composition. Faster + smaller than skillFull so the cockpit's Skills admin list and the role-edit picker don't pay for the bundle payload until the user expands a row.")
shape skill skillSummary {
  row.id
  payload.slug
  payload.name
  payload.description
  payload.tier
  payload.tags
  payload.category
  payload.predefined
  payload.active
}

@row
@description("Full skill projection: the catalog row plus its bundle composition + Phase 3 mint provenance. Backs the Skills admin detail view, the Planner Agent's mintSkill candidate read, the trace viewer's mint-event detail, and the agent factory's attach path (Phase 2). Keeps domainIds / toolSlugs / liveSourceIds inline so a single read fully describes what attaching the skill will do to an agent. originatingPlanId / mintedByAgentId are empty for predefined catalog rows and populated for planner-minted ones.")
shape skill skillFull {
  row.id
  payload.slug
  payload.name
  payload.description
  payload.category
  payload.tags
  payload.domainIds
  payload.toolSlugs
  payload.liveSourceIds
  payload.tier
  payload.predefined
  payload.active
  payload.originatingPlanId
  payload.mintedByAgentId
  row.createdAt
  row.createdBy
}

@row
@description("Full skillChangeEvent projection. Carries the changeKind + before/after snapshots + actor attribution (agent or user) + originating Plan link so the cockpit trace viewer (cockpit#125) can render an agent's skill-attach history inline with the plan task detail. Phase 3 surface (memql#159); rows are append-only.")
shape skillChangeEvent skillChangeEventFull {
  row.id
  payload.targetAgentId
  payload.skillId
  payload.changeKind
  payload.before
  payload.after
  payload.actorAgentId
  payload.actorUserId
  payload.planId
  row.createdAt
}

@row
@description("Avatar persona catalog projection (memql#609). Backs the Create-Assistant persona picker (copresent#239) and the agent-display hydration of a stamped avatarPersonaId. Carries the vendor + vendor-issued personaId the voice-agent resolves at session start.")
shape avatarPersona avatarPersonaFull {
  row.id
  payload.vendor
  payload.personaId
  payload.name
  payload.gender
  payload.imageRef
  payload.previewRef
  payload.active
  row.createdAt
}
