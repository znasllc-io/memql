// skills/foundational.memql
//
// Foundational skills shipped with every memQL installation. These
// are NOT product-specific; every cluster gets them so the agent
// factory + the Planner Agent always have a known-good baseline to
// bundle. One v1:agents:skill catalog row per `seed`. Materialized by
// the SeedMaterializer at engine startup; idempotent. predefined=true
// marks each row as locked in the cockpit's Skills admin view.

use agents.concepts.{ skill }

/// Universal headless capability surface: workbench filesystem + shell + http_fetch on the per-Plan
/// sandbox. Every agent ends up with this -- the role-factory injects it as a locked skill on
/// creation (mirrors the existing universal workbench_use baseline). No agent authorization wall:
/// the blast radius is contained to the per-Plan workspace.
seed skill workbench-baseline {
  slug:          "workbench-baseline"
  name:          "Workbench Baseline"
  description:   "Filesystem + shell + http_fetch on the per-Plan sandbox. The first-choice surface for any headless work an agent needs to do (writing files, running shell commands, fetching URLs)."
  category:      "foundational"
  tags:          ["universal", "headless"]
  domainIds:     ["workbench"]
  toolSlugs:     ["workbench-use"]
  liveSourceIds: []
  tier:          "A"
  predefined:    true
}

/// Computer use on the user's own machine: shell + filesystem + http (headless via workerHost) and
/// mouse + keyboard + screenshot (embodied via workerComputer). Opt-in per role; gated at dispatch
/// by v1:agents:agentAuthorization.computerUseScope plus the per-Plan kill switch. The
/// standing-grant model + per-action scope card live with the worker integration; this skill
/// bundles the tool surface the role-factory copies onto the agent's capabilities when the user
/// opts in.
seed skill operator-computer-use {
  slug:          "operator-computer-use"
  name:          "Operator Computer Use"
  description:   "Drive the user's own machine end-to-end -- shell, files, HTTP, mouse / keyboard / screenshot. Opt-in per agent; the user-grants gate runs at dispatch time."
  category:      "foundational"
  tags:          ["computer-use", "opt-in"]
  domainIds:     ["computer-use"]
  toolSlugs:     ["workerHost", "workerComputer", "workerStatus", "requestComputerUseScope", "canvasPublish"]
  liveSourceIds: []
  tier:          "B"
  predefined:    true
}

/// Delegate produce-an-artifact requests to the planner. Bundles the produceArtifact tool so the
/// Assistant can hand off 'create / make / build a file' requests to the async planner pipeline
/// (which routes/creates a specialist, researches, and writes the deliverable into the Library)
/// instead of authoring deliverables inline in a chat turn. Assistant-only -- specialists are the
/// delegates, they never delegate. The tool itself is @allowedRoles(assistant), so a specialist
/// that somehow carries this skill still cannot call it.
seed skill delegation-baseline {
  slug:          "delegation-baseline"
  name:          "Delegation Baseline"
  description:   "Hand off produce-an-artifact requests to the planner (async). The conversational front door delegates file/document/deliverable creation rather than authoring it inline."
  category:      "foundational"
  tags:          ["universal", "assistant", "planner"]
  domainIds:     []
  toolSlugs:     ["produceArtifact"]
  liveSourceIds: []
  tier:          "A"
  predefined:    true
}
