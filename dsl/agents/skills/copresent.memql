// skills/copresent.memql
//
// CoPresent product skills. Skills the Planner Agent attaches when
// the work is CoPresent-flavored (UI walkthroughs, the BFF surface,
// the canvas timeline, the voice-agent pipeline). The CoPresent BFF
// itself lives in the memql-bff-copresent repo -- these skills live
// here because the skill catalog is global; the BFF consumes the
// resolved bundle through the agent factory at attach time.

use agents.concepts.{ skill }

@description("CoPresent web frontend literacy: the panel layout (spaces / agents / knowledge / tasks / settings), routing model, the create-modal flows, the PresencePanel + chat surface, the canvas timeline. Pairs with operator-computer-use when the agent is also driving the UI; the knowledge here is what makes those drives coherent.")
seed skill copresent-ui {
  slug:          "copresent-ui"
  name:          "CoPresent UI"
  description:   "CoPresent web app surface area: panels, routing, create-modal flows, presence + chat + canvas. The knowledge baseline behind every UI-walkthrough agent."
  category:      "product"
  tags:          ["copresent", "frontend"]
  domainIds:     ["copresent-ui", "frontend-development"]
  toolSlugs:     []
  liveSourceIds: []
  tier:          "A"
  predefined:    true
}

@description("CoPresent BFF API surface: the gRPC + REST endpoints the frontend consumes, the guest-invite flow, the canvas mutations, the per-Plan attachment pipeline. Used by agents working on the CoPresent backend rather than the frontend itself.")
