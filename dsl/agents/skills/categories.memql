// skills/categories.memql
//
// One baseline skill per agentRole category. Each bundles every
// knowledge domain the corresponding role catalog locks across its
// specialists, so a role's `lockedSkillIds = [workbench-baseline,
// <category>-baseline]` reproduces the pre-Phase-2 domain reach
// without forcing the role to enumerate the bundle twice. Phase 3
// (mintSkill) lets the Planner Agent propose finer-grained skills
// (e.g. medical-cardiology, trades-welding-specialty) when a role's
// agent needs to specialise beyond the category baseline; until then
// these baselines plus Phase 1's cross-cutting catalog cover every
// predefined role.
//
// Tier policy: each baseline carries the highest tier across the
// roles in its category. Tier C medical (every medical role is
// regulated). Tier B legal + personal-finance corner + electrician
// (covered under trades). Tier A for the rest.

use agents.concepts.{ skill }

@description("Knowledge baseline for every white-collar professional role -- accounting / HR / IT support / operations / project management / sales+marketing / executive assistant / data + software roles / security. Bundles the union of locked domains across professional.memql so a role's lockedSkillIds = [workbench-baseline, professional-baseline] reproduces the pre-Phase-2 domain reach. Phase 3 mintSkill carves narrower specializations off this when a planner-minted specialist needs them.")
seed skill professional-baseline {
  slug:          "professional-baseline"
  name:          "Professional Baseline"
  description:   "Cross-cutting baseline for every white-collar role: org workflows, business literacy, the core knowledge domains the professional catalog locks across its specialists."
  category:      "professional"
  tags:          ["category-baseline", "professional"]
  domainIds:     ["business-administration", "accounting-principles", "financial-data", "employee-records", "talent-acquisition", "customer-relations", "service-level-agreements", "quality-metrics", "sales-pipeline", "technical-documentation", "ticket-management", "process-optimization", "project-data", "research-methodology", "data-analysis", "curriculum-design", "training-development", "stakeholder-communications", "data-engineering", "software-development", "frontend-development", "cloud-platforms", "infrastructure-as-code", "cybersecurity", "machine-learning"]
  toolSlugs:     []
  liveSourceIds: []
  tier:          "B"
  predefined:    true
}

@description("Knowledge baseline for every regulated medical role -- family doctor / pediatrician / dentist / physical therapist / nurse educator / pharmacist educator / veterinarian educator / mental health educator. Bundles the union of locked domains across medical.memql. Tier C: every medical role is high-stakes regulated. The advisory framing reaches the agent through this skill's DOMAINS -- Tier-B/C domains carry it as seeded chunk content -- not through any agent-factory disclaimer injection, which does not exist (memql#3068).")
seed skill medical-baseline {
  slug:          "medical-baseline"
  name:          "Medical Baseline"
  description:   "Cross-cutting baseline for every medical role: patient communication, common chronic conditions, primary-care anchors. Pairs with role-specific specialty Phase 3 skills."
  category:      "medical"
  tags:          ["category-baseline", "medical"]
  domainIds:     ["family-medicine", "patient-communication", "pediatrics", "child-development", "dentistry", "oral-health", "physical-therapy", "musculoskeletal-health", "nursing-fundamentals", "clinical-pharmacology-basics", "veterinary-medicine", "pet-health", "mental-health", "psychology-fundamentals"]
  toolSlugs:     []
  liveSourceIds: []
  tier:          "C"
  predefined:    true
}

@description("Knowledge baseline for every legal role -- compliance / immigration / family law / estate / personal-legal. Tier B: the 'general legal info, not personal advice' framing reaches the agent through this skill's Tier-B DOMAINS, which carry it as seeded chunk content. The agent factory injects no disclaimer (memql#3068). Practising-attorney boundaries are enforced at the role level (no role grants tools that send communications on behalf of a client without explicit user approval).")
seed skill legal-baseline {
  slug:          "legal-baseline"
  name:          "Legal Baseline"
  description:   "Cross-cutting baseline for every legal role: contracts, regulatory framing, common personal-legal domains. Pairs with role-specific specialty Phase 3 skills."
  category:      "legal"
  tags:          ["category-baseline", "legal"]
  domainIds:     ["legal-documents", "contracts-agreements", "regulatory-compliance", "immigration-law", "family-law", "estate-planning-personal", "personal-legal"]
  toolSlugs:     []
  liveSourceIds: []
  tier:          "B"
  predefined:    true
}

@description("Knowledge baseline for skilled trades -- general contracting, electrical, plumbing, HVAC, carpentry, automotive, welding, landscaping. Tier B because electrical / HVAC carry real-world safety stakes; the 'consult a licensed pro for code and permitting questions' framing reaches the agent through this skill's Tier-B DOMAINS as seeded chunk content, not through an agent-factory injection (memql#3068).")
seed skill trades-baseline {
  slug:          "trades-baseline"
  name:          "Trades Baseline"
  description:   "Cross-cutting baseline for every skilled-trades role: code awareness, safety practice, the common cross-trade fundamentals. Pairs with role-specific specialty Phase 3 skills."
