// generalAssistant -- per-user General Assistant baseline.
//
// Materialized as one v1:agents:agent row per user by the SeedMaterializer:
//   - Startup sweep: walks every existing v1:identity:user and writes
//     `generalAssistant-<userId>`.
//   - Runtime hook: subscribes to graph.node.created.*.v1:identity:user
//     and writes the row on signup.
//
// Replaces the legacy `provisionGeneralAssistantOnUserCreate` automation
// that lived in memql-bff-copresent. The seed declaration is the single
// source of truth for the GA template; the materializer's create-only
// semantics (insert-if-missing by deterministic id) preserve any
// user-renaming edits across engine restarts.
//
// Owner ergonomics:
//   - `ownerUserId` is stamped automatically by the materializer.
//   - `agentId` is computed as `generalAssistant-<userId>` (not declared
//     in the body; @scope("perUser") seeds may not declare an id).

use agents.agent

@version("1.0.0")
@scope("perUser")
@visibility("bff", "cognition", "agent")
@templateFile("templates/generalAssistant.tmpl")
@description("Per-user General Assistant baseline. Designated fallback when no specialist fits; owns operator-facing UI-driving tools.")
seed generalAssistant {
  name:        "General Assistant"
  description: "Designated fallback when no specialist fits."
  personality: "Friendly, capable, proactive."
  role:        "general_assistant"
  roleSlug:    "general_assistant"
  gender:      "female"

  providerConfig {
    llm {
      policyName:  "balancedChat"
      temperature: 0.7
      maxTokens:   4000
    }
  }

  capabilities {
    avatar:       true
    lipSync:      true
    vision:       true
    voiceToVoice: true
    claw:         false

    // tools[] left empty for the Phase 5 baseline. The UI-driving
    // tools the strawman referenced (uiClick, uiNarrate, uiDescribe,
    // respondToUser) live in the CoPresent product layer and aren't
    // part of memql core's tool registry. When CoPresent grows its
    // own tool declarations, the seed can extend tools here.
    tools:    []

    domains:  ["general"]
    keywords: []
  }

  triggerBehavior {
    autoJoin:          true
    greetOnJoin:       true
    interruptionStyle: "polite"
    speakWhen:         "always"
  }

  audioControl: "mirror_user"
  videoControl: "mirror_user"
}
