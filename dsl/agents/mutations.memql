// mutations.memql
//
// Agent-namespace mutations -- the platform's canonical write surface
// for v1:agents:agent + v1:agents:agentAuthorization + v1:agents:payload.
// Every BFF and every internal seeder writes through these;
// product-specific mutations (e.g. CoPresent's space-join flow) layer
// on top, never re-implement the row write.

@enabled
@useConcept(agent)
@description("Create a new AI agent template. The `kind` arg defaults to `user`; only the SeedMaterializer (running under the system actor) passes `kind: \"system\"` when it materializes platform agents like the MemQL Planner / MemQL Trainer. User-facing callers should omit the field -- omission gets the safe default; an explicit `system` from a user caller is accepted by the mutation but caught downstream by consumers that gate on kind.")
mutation mutationCreateAgent {
  args {
    agentId          string
    ownerUserId      string
    name             string  @required
    description      string
    personality      string
    role             string
    roleSlug         string
    kind             string
    gender           string
    audioControl     string
    videoControl     string
    avatarPersonaId  string
    avatarVendor     string
    capabilities     object
    avatar           object
    providerConfig   object
    triggerBehavior  object
    active           bool
    deleted          bool
  }
  insert agent {
    id: args.agentId
    args.ownerUserId
    args.name
    args.description
    args.personality
    args.capabilities
    args.avatar
    args.providerConfig
    args.triggerBehavior
    role: coalesce(args.role, "specialist")
    roleSlug: coalesce(args.roleSlug, "")
    kind: coalesce(args.kind, "user")
    gender: coalesce(args.gender, "female")
    audioControl: coalesce(args.audioControl, "mirror_user")
    videoControl: coalesce(args.videoControl, "mirror_user")
    args.avatarPersonaId
    args.avatarVendor
    active: coalesce(args.active, true)
    deleted: coalesce(args.deleted, false)
  }
}

@enabled
@useConcept(agentAuthorization)
@description("Grant a standing authorization for an agent to trigger a plan kind without per-Plan approval.")
mutation mutationCreateAgentAuthorization {
  args {
    authId            string
    agentId           string  @required
    userId            string  @required
    planKind          string  @required
    spaceScope        string  @required
    tokenBudgetCap    int
    expiresAt         string
    computerUseScope  string
  }
  insert agentAuthorization {
    id: args.authId
    args.agentId
    args.userId
    args.planKind
    args.spaceScope
    args.tokenBudgetCap
    args.expiresAt
    computerUseScope: coalesce(args.computerUseScope, "")
    active: true
  }
}

@enabled
@useConcept(agent)
@description("Soft-delete an agent (active:false, deleted:true).")
mutation mutationDeleteAgent {
  args {
    agentId  string  @required
  }
  insert agent {
    id: args.agentId
    active: false
    deleted: true
  }
}

@enabled
@useConcept(agentAuthorization)
@description("Soft-revoke a standing authorization. User-revocable from the agent's settings at any time.")
mutation mutationRevokeAgentAuthorization {
  args {
    authId  string  @required
  }
  insert agentAuthorization {
    id: args.authId
    active: false
  }
}

@enabled
@useConcept(agent)
@description("Partial update of a v1:agents:agent row. Only the fields you pass are changed; other fields inherit from the prior row.")
mutation mutationUpdateAgent {
  args {
    agentId  string  @required
    payload  object  @required
  }
  update agent {
    id: args.agentId
    args.payload
  }
}

@enabled
@useConcept(agentRole)
@description("Insert (or version) a v1:agents:agentRole catalog row. Called by the SeedMaterializer when it walks role seed declarations under dsl/agents/roles/ (the materializer stamps the seed body's `id` into `agentRoleId`); also callable directly when a user mints a custom (non-predefined) role from the UI. predefined=true marks the row as locked in the UI; user-created roles default to false and remain fully editable. The mutation is partition-agnostic for global-scoped concepts -- the engine stamps every v1:agents:agentRole insert into the _system slot regardless of the envelope.")
mutation mutationCreateAgentRole {
  args {
    agentRoleId             string
    slug                    string  @required
    name                    string  @required
    description             string
    category                string
    tier                    string
    lockedDomainIds         array
    defaultDomainIds        array
    availableDomainIds      array
    lockedToolSlugs         array
    defaultToolSlugs        array
    lockedLiveKnowledgeIds  array
    recommendedPolicySlug   string
    recommendedGender       string
    systemPromptHints       string
    active                  bool
    predefined              bool
  }
  insert agentRole {
    id: coalesce(args.agentRoleId, args.slug)
    args.slug
    args.name
    args.description
    category: coalesce(args.category, "professional")
    tier: coalesce(args.tier, "A")
    lockedDomainIds: coalesce(args.lockedDomainIds, [])
    defaultDomainIds: coalesce(args.defaultDomainIds, [])
    availableDomainIds: coalesce(args.availableDomainIds, [])
    lockedToolSlugs: coalesce(args.lockedToolSlugs, [])
    defaultToolSlugs: coalesce(args.defaultToolSlugs, [])
    lockedLiveKnowledgeIds: coalesce(args.lockedLiveKnowledgeIds, [])
    args.recommendedPolicySlug
    args.recommendedGender
    args.systemPromptHints
    active: coalesce(args.active, true)
    predefined: coalesce(args.predefined, false)
  }
}
