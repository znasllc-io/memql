// mutations.memql
//
// Agent-namespace mutations -- the platform's canonical write surface
// for v1:agents:agent + v1:agents:agentAuthorization + v1:agents:agentRole.
// Every BFF and every internal seeder writes through these;
// product-specific mutations (e.g. the product pack's space-join flow)
// layer on top, never re-implement the row write.

/// Create a new AI agent template. The `kind` arg defaults to `assistant` -- the safe value for the
/// frontend's create-agent modal flow. The SeedMaterializer (running under the
/// `system:seedMaterializer` actor) passes `kind: "system"` when materializing platform agents
/// (MemQL Planner / MemQL Trainer). The planner integration (running under the `system:planner`
/// actor; memql#399) passes `kind: "specialist"` when auto-provisioning a specialist for a Plan's
/// capability gap. User-actor calls that try to pass `kind in ("system", "specialist")` are
/// rejected pre-insert by an engine-level actor-scope guard
/// (component/memql/agent_kind_actor_validation.go, memql#403); the mutation surface itself stays
/// permissive on `kind` so the seed + planner paths can keep writing their values with the
/// rejection one layer up.
mutate agent createAgent {
  args {
    agentId          string
    ownerUserId      string
    name             string!
    description      string
    personality      string
    role             string
    roleSlug         string
    kind             string
    gender           string
    audioControl     string
    videoControl     string
    avatarPersonaId  string
    avatarVendor     string
    capabilities     object
    avatar           object
    providerConfig   object
    triggerBehavior  object
    active           bool
    deleted          bool
  }
  insert {
    accept { ownerUserId, name, description, personality, capabilities, avatar, providerConfig, triggerBehavior, avatarPersonaId, avatarVendor }
    stamp {
      id: args.agentId
      role: args.role ?? "specialist"
      roleSlug: args.roleSlug ?? ""
      kind: args.kind ?? "assistant"
      gender: args.gender ?? "female"
      audioControl: args.audioControl ?? "mirror_user"
      videoControl: args.videoControl ?? "mirror_user"
      active: args.active ?? true
      deleted: args.deleted ?? false
    }
  }
}

// WHY userId IS STAMPED (memql#3081). It used to be accepted, and it is the key the standing
// computer-use grant is READ by -- four Go call sites resolve a user's envelope ceiling through
// `agentAuthorizationsForSelf` (authoring_capability_store.go, worker/store.go,
// computer_use_status_agent.go, mint_skill_handler.go). So a caller-supplied value let a row be
// written as `{userId: <someone else>, computerUseScope: "full"}`, raising THAT user's standing
// ceiling on a grant they never approved -- on the concept whose own field doc says "Only the
// granting user can revoke".
//
// Every layer that could have caught it was structurally unable to: the mutation grammar cannot
// express an owner predicate (memql#3079), the field carries neither @internal nor @serverSet so
// validateMutationCallerArgs never inspects it, the mutation is on the client surface via the
// generated SDK (so @serverOnly was not in play), and -- until memql#3177 -- the concept declared
// no row-authz tier. It declares `@rowAuthz(owner="userId")` now, which is what turns the stamp
// below from an attribution fix into an enforced ownership key: a CREATE has no target row, so a
// stamp is the only thing that can decide its owner, and the guard on every later write compares
// against what this line wrote.
//
// This is deliberately NOT in the /// doc block: that text flows into the generated SDK, where a
// consumer wants the contract rather than the history.
/// Grant a standing authorization for an agent to trigger a plan kind without per-Plan approval.
/// The granting user is the CALLER -- userId is stamped from actor.userId and is not an argument.
@actor
mutate agentAuthorization createAgentAuthorization {
  args {
    authId            string
    agentId           string!
    planKind          string!
    spaceScope        string!
    tokenBudgetCap    int
    expiresAt         string
    computerUseScope  string
  }
  insert {
    accept { agentId, planKind, spaceScope, tokenBudgetCap, expiresAt }
    stamp {
      id: args.authId
      userId: actor.userId
      computerUseScope: args.computerUseScope ?? ""
      active: true
    }
  }
}

/// Soft-delete an agent (active:false, deleted:true). Read-merges the existing row so the caller
/// only passes the agent id; every other required field (kind, name, ...) inherits from the
/// persisted row instead of being re-supplied (memql#1628).
mutate agent deleteAgent {
  args {
    agentId  string!
  }
  update {
    id: args.agentId
    active: false
    deleted: true
  }
}

// TARGETING (memql#3177, carrying memql#3129). `authId` is a caller-supplied target with
// nothing in the mutation relating it to the caller, and the grammar cannot express such a
// relation -- a mutation carries no filter and `update` takes `id:` plus field assignments
// (memql#3079). So before the concept declared a tier, any authenticated caller who knew an
// authId could revoke a stranger's standing grant. It is closed at the ENGINE now, not here:
// `v1:agents:agentAuthorization` declares `@rowAuthz(owner="userId")`, so executeWrite
// resolves the target row before the read-merge and refuses when its userId is not the
// caller's (component/memql/rowauthz_write_guard.go, memql#3174). Do not read the absence of
// a guard in this body as the absence of a guard.
/// Soft-revoke a standing authorization. User-revocable from the agent's settings at any time.
/// SELF-SERVICE: only the granting user (the row's userId) may revoke their own grant -- the
/// engine refuses a write onto anyone else's row under the concept's declared owner tier.
/// Read-merges the existing row so the caller only passes the auth id;
/// agentId/userId/planKind/spaceScope inherit from the persisted row (memql#1628).
mutate agentAuthorization revokeAgentAuthorization {
  args {
    authId  string!
  }
  update {
    id: args.authId
    active: false
  }
}

/// Partial update of a v1:agents:agent row. Only the fields you pass are changed; other fields
/// inherit from the prior row.
mutate agent updateAgent {
  args {
    agentId  string!
    payload  object!
  }
  update {
    id: args.agentId
    args.payload
  }
}

// THE SPLAT (memql#3177, carrying memql#3138). `args.payload` lands VERBATIM: memql#401's
// overlay-wins protection is populated only from EXPLICIT block fields (see the hoist-and-
// delete pass in component/memql/function_loader.go), so a bare splat re-stamps nothing. That
// made `userId` -- the field the concept's owner tier is keyed on -- caller-writable through
// this mutation, and the two-call escalation was: create a grant for yourself with
// `computerUseScope:"full"` (correctly stamped to you), then update it with
// `{userId:"<victim>"}`; the read-merge keeps the scope and active flag, and the victim's
// standing ceiling is now `full` on a grant they never approved.
//
// `userId: actor.userId` below is the fix, in updateNote's idiom (dsl/notes/mutations.memql):
// an explicit field alongside the splat becomes the PayloadOverlayTemplate, which
// renderMutationTemplate applies AFTER the splat, so the server's value wins over anything the
// caller sent. It needs the `@actor` binding to resolve, and the parsed-tree gate in
// dsl/agentauthz_stamped_userid_test.go pins both.
//
// SELF-SERVICE ONLY, ruled by the repo owner 2026-08-06 on memql#3177. Re-stamping makes this
// mutation self-service by construction, and that is the intent, not a side effect: it makes
// the concept's own "only the granting user may update their grant" text TRUE rather than
// deleting it. An admin gate was considered and REJECTED -- it does not stop this escalation,
// because the attacker updates a row they legitimately own. If an operator surface is ever
// wanted it lands as its own separately-named mutation with `requiresOwnerOrAdmin` as a
// top-level conjunct, never as a second meaning for this one.
/// Partial update of a v1:agents:agentAuthorization row. Mirrors updateAgent semantics: only the
/// fields passed in `payload` change; everything else inherits from the prior row. Backs the canvas
/// mintSkillApprovalRequested card's 'Approve & always allow this tier' action (pack#38, memql#169)
/// -- the SPA reads the current skillTierAllowlist, appends the approved tier, and writes the whole
/// array back as `{skillTierAllowlist: [...]}`. SELF-SERVICE, and enforced two ways: the row's
/// `userId` is re-stamped from actor.userId so a payload cannot reassign the grant, and the engine
/// refuses the write outright when the target row's userId is not the caller's (the concept's
/// declared owner tier -- memql#3177).
@actor
mutate agentAuthorization updateAgentAuthorization {
  args {
    authId   string!
    payload  object!
  }
  update {
    id: args.authId
    userId: actor.userId
    args.payload
  }
}

/// Mint a new v1:agents:skill catalog row from a Planner Agent mintSkill action (Phase 3 /
/// memql#159). The caller is the planner integration; it has already run the authority gate
/// (action='mintSkill' on the planner's agentAuthorization + tier in skillTierAllowlist) and the
/// catalog-search heuristic (no existing skill covers >60% of the requested bundle) before invoking
/// this. predefined is hard-stamped false -- the runtime mint surface is for user-/planner-created
/// rows only; the predefined catalog stays in dsl/agents/skills/*.memql. originatingPlanId +
/// mintedByAgentId carry the Phase 3 provenance triad. Server-side enforcement: the tier-validation
/// rule from Phase 1 still applies (skill.tier >= max(domain tier)) -- a mint that violates it
/// rejects with the same error path as the load-time check.
mutate skill mintSkill {
  args {
    skillId            string
    slug               string!
    name               string!
    description        string
    category           string
    tags               array
    domainIds          array
    toolSlugs          array
    liveSourceIds      array
    tier               string!
    originatingPlanId  string
    mintedByAgentId    string
  }
  insert {
    id: args.skillId ?? args.slug
    args.slug
    args.name
    args.description
    category: args.category ?? "specialized"
    tags: args.tags ?? []
    domainIds: args.domainIds ?? []
    toolSlugs: args.toolSlugs ?? []
    liveSourceIds: args.liveSourceIds ?? []
    args.tier
    predefined: false
    active: true
    args.originatingPlanId
    args.mintedByAgentId
  }
}

/// Materialize a v1:agents:skill catalog row from a `seed skill ...` declaration under
/// dsl/agents/skills/*.memql. Matches the SeedMaterializer's `mutationCreate<Concept>` naming
/// convention -- the materializer stamps the seed body's id into `skillId` and forwards every other
/// seed body field as a same-named arg, so this mutation's arg surface mirrors the on-disk seed
/// body 1:1. Sibling to `mintSkill`: same row shape, but the seed path is for the predefined
/// catalog (predefined defaults true) and carries no originatingPlanId / mintedByAgentId provenance
/// triad. Was missing pre-#344, which made every skill seed in the bundled catalog fail to
/// materialize with `function "createSkill" not found`. The materializer convention itself lives in
/// component/memql/seed_materializer.go.
mutate skill createSkill {
  args {
    skillId        string
    slug           string!
    name           string!
    description    string
    category       string
    tags           array
    domainIds      array
    toolSlugs      array
    liveSourceIds  array
    tier           string!
    predefined     bool
    active         bool
  }
  insert {
    id: args.skillId ?? args.slug
    args.slug
    args.name
    args.description
    category: args.category ?? "specialized"
    tags: args.tags ?? []
    domainIds: args.domainIds ?? []
    toolSlugs: args.toolSlugs ?? []
    liveSourceIds: args.liveSourceIds ?? []
    args.tier
    predefined: args.predefined ?? true
    active: args.active ?? true
  }
}

/// Append a v1:agents:skillChangeEvent row recording a skill attach / reconfigure on an agent.
/// Phase 2 (#158) cut: every Planner Agent extendSpecialist / createSpecialist flow that lands a
/// skill on an agent issues one of these per skill. Phase 3 also writes them from the cockpit
/// Skills admin view when a human attaches a skill manually. Empty actorAgentId + actorUserId is
/// allowed for system-driven attaches (the migration tool writes events with
/// actorUserId='system:migration:phase2'). The caller is responsible for providing
/// skillChangeEventId -- mint via the standard NewShortId / MustFromMap helpers caller-side.
mutate skillChangeEvent createSkillChangeEvent {
  args {
    skillChangeEventId  string!
    targetAgentId       string!
    skillId             string!
    changeKind          string
    before              object
    after               object
    actorAgentId        string
    actorUserId         string
    planId              string
  }
  insert {
    id: args.skillChangeEventId
    args.targetAgentId
    args.skillId
    changeKind: args.changeKind ?? "attached"
    before: args.before ?? {}
    after: args.after ?? {}
    args.actorAgentId
    args.actorUserId
    args.planId
  }
}

/// Insert (or version) a v1:agents:agentRole catalog row. Called by the SeedMaterializer when it
/// walks role seed declarations under dsl/agents/roles/ (the materializer stamps the seed body's
/// `id` into `agentRoleId`); also callable directly when a user mints a custom (non-predefined)
/// role from the UI. predefined=true marks the row as locked in the UI; user-created roles default
/// to false and remain fully editable. Phase 2 cut (#158): the args surface collapses the seven
/// flat lockedDomain / defaultDomain / availableDomain / lockedTool / defaultTool / forbiddenTool /
/// lockedLiveKnowledge fields into the five skill-id fields the role catalog now carries plus a
/// maxSkills cap. The mutation is partition-agnostic for global-scoped concepts -- the engine
/// stamps every v1:agents:agentRole insert into the _system slot regardless of the envelope.
mutate agentRole createAgentRole {
  args {
    agentRoleId             string
    slug                    string!
    name                    string!
    description             string
    category                string
    tier                    string
    lockedSkillIds          array
    defaultSkillIds         array
    availableSkillIds       array
    forbiddenSkillIds       array
    maxSkills               integer
    recommendedPolicySlug   string
    recommendedGender       string
    systemPromptHints       string
    active                  bool
    predefined              bool
  }
  insert {
    id: args.agentRoleId ?? args.slug
    args.slug
    args.name
    args.description
    category: args.category ?? "professional"
    tier: args.tier ?? "A"
    lockedSkillIds: args.lockedSkillIds ?? []
    defaultSkillIds: args.defaultSkillIds ?? []
    availableSkillIds: args.availableSkillIds ?? []
    forbiddenSkillIds: args.forbiddenSkillIds ?? []
    maxSkills: args.maxSkills ?? 5
    args.recommendedPolicySlug
    args.recommendedGender
    args.systemPromptHints
    active: args.active ?? true
    predefined: args.predefined ?? false
  }
}

/// Insert a v1:agents:avatarPersona catalog row (memql#609). Called by the SeedMaterializer when it
/// walks the avatar-persona seed declarations under dsl/agents/avatarPersonas.memql -- the
/// materializer stamps the seed body's `id` (the seed name) into `avatarPersonaId`. The seeds
/// themselves are hand-curated in dsl/agents/avatarPersonas.memql (the vendor-issued faceId pasted
/// in per persona). Global operator catalog: the engine stamps the insert into the _system slot
/// regardless of the caller's partition, exactly like createAgentRole / createSkill.
mutate avatarPersona createAvatarPersona {
  args {
    avatarPersonaId  string
    vendor           string!
    personaId        string!
    name             string!
    gender           string!
    imageRef         string
    previewRef       string
    active           bool
  }
  insert {
    accept { vendor, personaId, name, gender, imageRef, previewRef }
    stamp {
      id: args.avatarPersonaId ?? args.personaId
      active: args.active ?? true
    }
  }
}
