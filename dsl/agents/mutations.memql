// mutations.memql
//
// Agent-namespace mutations -- the platform's canonical write surface
// for v1:agents:agent + v1:agents:agentAuthorization + v1:agents:agentRole.
// Every BFF and every internal seeder writes through these;
// product-specific mutations (e.g. CoPresent's space-join flow) layer
// on top, never re-implement the row write.

use agents.concepts.{ agent, agentAuthorization, agentRole }

@enabled
@description("Create a new AI agent template. The `kind` arg defaults to `assistant` -- the safe value for the CoPresent CreateAgentModal flow. The SeedMaterializer (running under the `system:seedMaterializer` actor) passes `kind: \"system\"` when materializing platform agents (MemQL Planner / MemQL Trainer). The planner integration (running under the `system:planner` actor; memql#399) passes `kind: \"specialist\"` when auto-provisioning a specialist for a Plan's capability gap. User-actor calls that try to pass `kind in (\"system\", \"specialist\")` are rejected pre-insert by an engine-level actor-scope guard (component/memql/agent_kind_actor_validation.go, memql#403); the mutation surface itself stays permissive on `kind` so the seed + planner paths can keep writing their values with the rejection one layer up.")
mutation agent mutationCreateAgent {
  args {
    agentId          string
    ownerUserId      string
    name             string  @required
    description      string
    personality      string
    role             string
    roleSlug         string
    kind             string
    gender           string
    audioControl     string
    videoControl     string
    avatarPersonaId  string
    avatarVendor     string
    capabilities     object
    avatar           object
    providerConfig   object
    triggerBehavior  object
    active           bool
    deleted          bool
  }
  insert agent {
    id: args.agentId
    args.ownerUserId
    args.name
    args.description
    args.personality
    args.capabilities
    args.avatar
    args.providerConfig
    args.triggerBehavior
    role: coalesce(args.role, "specialist")
    roleSlug: coalesce(args.roleSlug, "")
    kind: coalesce(args.kind, "assistant")
    gender: coalesce(args.gender, "female")
    audioControl: coalesce(args.audioControl, "mirror_user")
    videoControl: coalesce(args.videoControl, "mirror_user")
    args.avatarPersonaId
    args.avatarVendor
    active: coalesce(args.active, true)
    deleted: coalesce(args.deleted, false)
  }
}

@enabled
@description("Grant a standing authorization for an agent to trigger a plan kind without per-Plan approval.")
mutation agentAuthorization mutationCreateAgentAuthorization {
  args {
    authId            string
    agentId           string  @required
    userId            string  @required
    planKind          string  @required
    spaceScope        string  @required
    tokenBudgetCap    int
    expiresAt         string
    computerUseScope  string
  }
  insert agentAuthorization {
    id: args.authId
    args.agentId
    args.userId
    args.planKind
    args.spaceScope
    args.tokenBudgetCap
    args.expiresAt
    computerUseScope: coalesce(args.computerUseScope, "")
    active: true
  }
}

@enabled
@description("Soft-delete an agent (active:false, deleted:true).")
mutation agent mutationDeleteAgent {
  args {
    agentId  string  @required
  }
  insert agent {
    id: args.agentId
    active: false
    deleted: true
  }
}

@enabled
@description("Soft-revoke a standing authorization. User-revocable from the agent's settings at any time.")
mutation agentAuthorization mutationRevokeAgentAuthorization {
  args {
    authId  string  @required
  }
  insert agentAuthorization {
    id: args.authId
    active: false
  }
}

@enabled
@description("Partial update of a v1:agents:agent row. Only the fields you pass are changed; other fields inherit from the prior row.")
mutation agent mutationUpdateAgent {
  args {
    agentId  string  @required
    payload  object  @required
  }
  update agent {
    id: args.agentId
    args.payload
  }
}

@enabled
@description("Partial update of a v1:agents:agentAuthorization row. Mirrors mutationUpdateAgent semantics: only the fields passed in `payload` change; everything else inherits from the prior row. Backs the canvas mintSkillApprovalRequested card's 'Approve & always allow this tier' action (memql-bff-copresent#38, memql#169) -- the SPA reads the current skillTierAllowlist, appends the approved tier, and writes the whole array back as `{skillTierAllowlist: [...]}`. Per the agentAuthorization concept's revocation contract this is an OWNED write: only the granting user (the row's payload.userId) may update their own authorization grant.")
mutation agentAuthorization mutationUpdateAgentAuthorization {
  args {
    authId   string  @required
    payload  object  @required
  }
  update agentAuthorization {
    id: args.authId
    args.payload
  }
}

@enabled
@description("Mint a new v1:agents:skill catalog row from a Planner Agent mintSkill action (Phase 3 / memql#159). The caller is the planner integration; it has already run the authority gate (action='mintSkill' on the planner's agentAuthorization + tier in skillTierAllowlist) and the catalog-search heuristic (no existing skill covers >60% of the requested bundle) before invoking this. predefined is hard-stamped false -- the runtime mint surface is for user-/planner-created rows only; the predefined catalog stays in dsl/agents/skills/*.memql. originatingPlanId + mintedByAgentId carry the Phase 3 provenance triad. Server-side enforcement: the tier-validation rule from Phase 1 still applies (skill.tier >= max(domain tier)) -- a mint that violates it rejects with the same error path as the load-time check.")
mutation skill mutationMintSkill {
  args {
    skillId            string
    slug               string  @required
    name               string  @required
    description        string
    category           string
    tags               array
    domainIds          array
    toolSlugs          array
    liveSourceIds      array
    tier               string  @required
    originatingPlanId  string
    mintedByAgentId    string
  }
  insert skill {
    id: coalesce(args.skillId, args.slug)
    args.slug
    args.name
    args.description
    category: coalesce(args.category, "specialized")
    tags: coalesce(args.tags, [])
    domainIds: coalesce(args.domainIds, [])
    toolSlugs: coalesce(args.toolSlugs, [])
    liveSourceIds: coalesce(args.liveSourceIds, [])
    args.tier
    predefined: false
    active: true
    args.originatingPlanId
    args.mintedByAgentId
  }
}

@enabled
@description("Materialize a v1:agents:skill catalog row from a `seed skill ...` declaration under dsl/agents/skills/*.memql. Matches the SeedMaterializer's `mutationCreate<Concept>` naming convention -- the materializer stamps the seed body's id into `skillId` and forwards every other seed body field as a same-named arg, so this mutation's arg surface mirrors the on-disk seed body 1:1. Sibling to `mutationMintSkill`: same row shape, but the seed path is for the predefined catalog (predefined defaults true) and carries no originatingPlanId / mintedByAgentId provenance triad. Was missing pre-#344, which made every skill seed in the bundled catalog fail to materialize with `function \"mutationCreateSkill\" not found`. The materializer convention itself lives in component/memql/seed_materializer.go.")
mutation skill mutationCreateSkill {
  args {
    skillId        string
    slug           string  @required
    name           string  @required
    description    string
    category       string
    tags           array
    domainIds      array
    toolSlugs      array
    liveSourceIds  array
    tier           string  @required
    predefined     bool
    active         bool
  }
  insert skill {
    id: coalesce(args.skillId, args.slug)
    args.slug
    args.name
    args.description
    category: coalesce(args.category, "specialized")
    tags: coalesce(args.tags, [])
    domainIds: coalesce(args.domainIds, [])
    toolSlugs: coalesce(args.toolSlugs, [])
    liveSourceIds: coalesce(args.liveSourceIds, [])
    args.tier
    predefined: coalesce(args.predefined, true)
    active: coalesce(args.active, true)
  }
}

@enabled
@description("Append a v1:agents:skillChangeEvent row recording a skill attach / reconfigure on an agent. Phase 2 (#158) cut: every Planner Agent extendSpecialist / createSpecialist flow that lands a skill on an agent issues one of these per skill. Phase 3 also writes them from the cockpit Skills admin view when a human attaches a skill manually. Empty actorAgentId + actorUserId is allowed for system-driven attaches (the migration tool writes events with actorUserId='system:migration:phase2'). The caller is responsible for providing skillChangeEventId -- mint via the standard NewShortId / MustFromMap helpers caller-side.")
mutation skillChangeEvent mutationCreateSkillChangeEvent {
  args {
    skillChangeEventId  string  @required
    targetAgentId       string  @required
    skillId             string  @required
    changeKind          string
    before              object
    after               object
    actorAgentId        string
    actorUserId         string
    planId              string
  }
  insert skillChangeEvent {
    id: args.skillChangeEventId
    args.targetAgentId
    args.skillId
    changeKind: coalesce(args.changeKind, "attached")
    before: coalesce(args.before, {})
    after: coalesce(args.after, {})
    args.actorAgentId
    args.actorUserId
    args.planId
  }
}

@enabled
@description("Insert (or version) a v1:agents:agentRole catalog row. Called by the SeedMaterializer when it walks role seed declarations under dsl/agents/roles/ (the materializer stamps the seed body's `id` into `agentRoleId`); also callable directly when a user mints a custom (non-predefined) role from the UI. predefined=true marks the row as locked in the UI; user-created roles default to false and remain fully editable. Phase 2 cut (#158): the args surface collapses the seven flat lockedDomain / defaultDomain / availableDomain / lockedTool / defaultTool / forbiddenTool / lockedLiveKnowledge fields into the five skill-id fields the role catalog now carries plus a maxSkills cap. The mutation is partition-agnostic for global-scoped concepts -- the engine stamps every v1:agents:agentRole insert into the _system slot regardless of the envelope.")
mutation agentRole mutationCreateAgentRole {
  args {
    agentRoleId             string
    slug                    string  @required
    name                    string  @required
    description             string
    category                string
    tier                    string
    lockedSkillIds          array
    defaultSkillIds         array
    availableSkillIds       array
    forbiddenSkillIds       array
    maxSkills               integer
    recommendedPolicySlug   string
    recommendedGender       string
    systemPromptHints       string
    active                  bool
    predefined              bool
  }
  insert agentRole {
    id: coalesce(args.agentRoleId, args.slug)
    args.slug
    args.name
    args.description
    category: coalesce(args.category, "professional")
    tier: coalesce(args.tier, "A")
    lockedSkillIds: coalesce(args.lockedSkillIds, [])
    defaultSkillIds: coalesce(args.defaultSkillIds, [])
    availableSkillIds: coalesce(args.availableSkillIds, [])
    forbiddenSkillIds: coalesce(args.forbiddenSkillIds, [])
    maxSkills: coalesce(args.maxSkills, 5)
    args.recommendedPolicySlug
    args.recommendedGender
    args.systemPromptHints
    active: coalesce(args.active, true)
    predefined: coalesce(args.predefined, false)
  }
}
