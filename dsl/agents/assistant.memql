// assistant -- per-user Assistant baseline.
//
// Materialized as one v1:agents:agent row per user by the SeedMaterializer:
//   - Startup sweep: walks every existing v1:identity:user and writes
//     `assistant-<userId>`.
//   - Runtime hook: subscribes to graph.node.created.v1:identity:user
//     and writes the row on signup.
//
// Replaces the legacy `provisionAssistantOnUserCreate` automation
// that lived in memql-bff-copresent. The seed declaration is the single
// source of truth for the GA template; the materializer's create-only
// semantics (insert-if-missing by deterministic id) preserve any
// user-renaming edits across engine restarts.
//
// Owner ergonomics:
//   - `ownerUserId` is stamped automatically by the materializer.
//   - `agentId` is computed as `assistant-<userId>` (not declared
//     in the body; @scope("perUser") seeds may not declare an id).

use agents.concepts.{ agent }

@scope("perUser")
@templateFile("templates/assistant.tmpl")
@description("Per-user Assistant baseline. Designated fallback when no specialist fits; owns operator-facing UI-driving tools.")
seed agent assistant {
  name:        "Sofia"
  description: "Designated fallback when no specialist fits."
  personality: "Friendly, capable, proactive."
  kind:        "assistant"
  role:        "assistant"
  roleSlug:    "assistant"
  gender:      "female"

  providerConfig {
    llm {
      policyName:  "balancedChat"
      temperature: 0.7
      maxTokens:   4000
    }
  }

  capabilities {
    avatar:       true
    lipSync:      true
    vision:       true
    voiceToVoice: true
    claw:         false

    // skillIds is the sole capability surface post the skills primitive
    // migration (2026-05-21). The Assistant baseline carries the
    // operator suite + the supporting knowledge baselines + the
    // headless / embodied execution surfaces:
    //
    //   - copresent-takeover     autopilot UI drive -- the AI does it FOR
    //                            the user (uiClick / uiNavigate / uiType /
    //                            ... operator primitives; slug expands at
    //                            dispatch via component/memql/operator_caps.go).
    //   - copresent-guide        immersive, voice-driven Scenes over the same
    //                            operator primitives -- the AI does it WITH
    //                            the user. Both replaced the retired single
    //                            copresent-control skill (copresent#187).
    //   - copresent-ui           knowledge baseline behind UI walkthroughs
    //                            (panels, routing, create-modal flows,
    //                            presence + chat + canvas).
    //   - copresent-canvas       canvas timeline authoring (row shape,
    //                            kind / data / visibility / importance).
    //   - workbench-baseline     workbench-use (filesystem + shell + http
    //                            on the per-Plan sandbox). Universal,
    //                            no scope gate.
    //   - operator-computer-use  workerHost / workerComputer / workerStatus
    //                            on the user's machine. Gated by
    //                            agentAuthorization.computerUseScope +
    //                            kill switch; opt-in per-Plan via
    //                            requestComputerUseScope.
    //
    // The first three live in memql-bff-copresent/dsl/copresent/skills.memql;
    // the last two ship in dsl/agents/skills/foundational.memql in core.
    // memql#376.
    skillIds: [
      "copresent-takeover",
      "copresent-guide",
      "copresent-ui",
      "copresent-canvas",
      "workbench-baseline",
      "operator-computer-use",
    ]

    // tools[] / domains[] are the retired flat-list capability surface
    // (skills migration #158). Kept empty for backward-compat readers
    // that haven't been swept yet; the live capability comes from skillIds
    // above.
    tools:    []
    domains:  []
    keywords: []
  }

  triggerBehavior {
    autoJoin:          true
    greetOnJoin:       true
    interruptionStyle: "polite"
    speakWhen:         "always"
  }

  audioControl: "mirror_user"
  videoControl: "mirror_user"
}
