// plannerAgent -- per-user Planner Agent.
//
// Materialized as one v1:agents:agent row per user by the SeedMaterializer
// (deterministic id `plannerAgent-<userId>`). Replaces the legacy
// `provisionPlannerAgentOnUserCreate` automation + logic in
// dsl/agents/automations.memql (deleted in this commit).
//
// Per the planner-redesign brainstorm (Q2): every user gets a dedicated
// Planner Agent persona that the planner-service invokes to decompose
// Plans, dispatch Tasks, and handle retries. Strong-reasoning provider
// via the streamClaudeOpus policy. Not user-facing in chat: autoJoin +
// greetOnJoin both false, audio + video control always_off.

use agents.concepts.{ agent }

@scope("perUser")
@description("Per-user Planner Agent. Platform orchestration persona -- decomposes Plans into Tasks, dispatches to specialists, manages retries.")
seed agent plannerAgent {
  name:        "MemQL Planner"
  description: "Platform orchestration agent -- decomposes Plans into Tasks, dispatches to specialists, manages retries. Not user-facing in chat."
  personality: "Deliberate, lean, evidence-driven. Never chatty."
  role:        "specialist"
  roleSlug:    "system_planner"
  kind:        "system"
  gender:      "female"

  providerConfig {
    llm {
      // Claude Opus 4.6 + extended thinking. The reasoning surface
      // is exactly what the planner's decompose / createSpecialist /
      // dispatchTask decision tree needs -- the model reasons over
      // its goal + existing specialists + phase outline before
      // emitting the structured-output action. See
      // dsl/providers/providers.memql for the provider definition;
      // the anthropicStreamProvider in component/memql/si_providers.go
      // injects the thinking config into every MessageNewParams call
      // path.
      provider: "reasoningClaudeOpus"
    }
  }

  capabilities {
    avatar:       false
    lipSync:      false
    vision:       false
    voiceToVoice: false
    claw:         false
    domains:      []
    keywords:     []
    tools:        []
  }

  triggerBehavior {
    autoJoin:    false
    greetOnJoin: false
    speakWhen:   "asked"
  }

  audioControl: "always_off"
  videoControl: "always_off"
}
