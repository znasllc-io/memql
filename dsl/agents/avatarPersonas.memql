// avatarPersonas.memql
//
// GENERATED by `make avatar-mint` (cmd/avatar-mint) -- memql#609.
// Operator-curated avatar persona catalog (Anam). The SeedMaterializer
// turns each row into a v1:agents:avatarPersona the Create-Assistant
// picker lists (copresent#239); the agent's avatarVendor/avatarPersonaId
// point at the chosen entry and the voice-agent resolves it at session
// start. Re-run avatar-mint to regenerate. Do not hand-edit personaId --
// it is the vendor-issued avatar id.

use agents.concepts.{ avatarPersona }

// Sofia uses Simli (memql#1237). Anam hard-caps the ephemeral client-audio
// session at ~26-27s regardless of every documented param (escalation: memql#1236),
// so we switch the product avatar to Simli (validated, no cap -- memql#784).
// personaId is the Simli faceId of our custom avatar (created from female_0);
// dispatch.go resolveSimliPlan uses it as the Simli faceId and SIMLI_API_KEY
// authenticates. imageRef/previewRef stay the female_0 source image (served by
// copresent at /avatars/female_0.png) so the Create-Assistant picker shows the
// real face. (Anam avatarId 8981b946 retained in history if we revert.)
@description("Avatar persona Sofia (female) -- Simli custom avatar from avatars/female_0.png (memql#1237).")
seed avatarPersona sofia {
  vendor:     "simli"
  personaId:  "d6ee6443-c99e-4027-885c-5ad9e5f1b307"
  name:       "Sofia"
  gender:     "female"
  imageRef:   "avatars/female_0.png"
  previewRef: "/avatars/female_0.png"
}

