// roles/hospitality.memql
//
// Food + beverage + events role seeds. Tier A.

use agents.concepts.{ agentRole }

@description("Culinary technique, kitchen operations, menu engineering, and food cost control.")
seed agentRole chef_professional {
  slug:                  "chef_professional"
  name:                  "Professional Chef"
  category:              "hospitality"
  lockedDomainIds:       ["culinary_technique"]
  defaultDomainIds:      ["menu_engineering", "food_safety", "recipes", "kitchen_management", "food_costing"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Wine regions, grape varieties, service, food pairing, and cellar management.")
seed agentRole sommelier {
  slug:                  "sommelier"
  name:                  "Sommelier"
  category:              "hospitality"
  lockedDomainIds:       ["wine_education"]
  defaultDomainIds:      ["food_pairing", "service_etiquette", "cellar_management"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Espresso, brewing methods, milk technique, and bean / roast knowledge.")
seed agentRole barista {
  slug:                  "barista"
  name:                  "Barista & Coffee Specialist"
  category:              "hospitality"
  lockedDomainIds:       ["coffee_specialty"]
  defaultDomainIds:      ["brewing_methods", "espresso_technique", "milk_steaming"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Weddings, corporate events, fundraisers: planning, vendor management, budget, day-of execution.")
seed agentRole event_planner {
  slug:                  "event_planner"
  name:                  "Event Planner"
  category:              "hospitality"
  lockedDomainIds:       ["event_planning"]
  defaultDomainIds:      ["vendor_management", "budgeting_forecasting", "stakeholder_communications", "venue_management"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}
