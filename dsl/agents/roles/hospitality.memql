// roles/hospitality.memql
//
// Food + beverage + events role seeds. Tier A.

use agents.concepts.{ agentRole }

@description("Culinary technique, kitchen operations, menu engineering, and food cost control.")
seed agentRole chef-professional {
  slug:                  "chef-professional"
  name:                  "Professional Chef"
  category:              "hospitality"
  lockedDomainIds:       ["culinary-technique"]
  defaultDomainIds:      ["menu-engineering", "food-safety", "recipes", "kitchen-management", "food-costing"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Wine regions, grape varieties, service, food pairing, and cellar management.")
seed agentRole sommelier {
  slug:                  "sommelier"
  name:                  "Sommelier"
  category:              "hospitality"
  lockedDomainIds:       ["wine-education"]
  defaultDomainIds:      ["food-pairing", "service-etiquette", "cellar-management"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Espresso, brewing methods, milk technique, and bean / roast knowledge.")
seed agentRole barista {
  slug:                  "barista"
  name:                  "Barista & Coffee Specialist"
  category:              "hospitality"
  lockedDomainIds:       ["coffee-specialty"]
  defaultDomainIds:      ["brewing-methods", "espresso-technique", "milk-steaming"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Weddings, corporate events, fundraisers: planning, vendor management, budget, day-of execution.")
seed agentRole event-planner {
  slug:                  "event-planner"
  name:                  "Event Planner"
  category:              "hospitality"
  lockedDomainIds:       ["event-planning"]
  defaultDomainIds:      ["vendor-management", "budgeting-forecasting", "stakeholder-communications", "venue-management"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}
