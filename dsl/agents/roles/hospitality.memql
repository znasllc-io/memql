//
// Food + beverage + events role seeds. Tier A.

use agents.agentRole

@version("1.0.0")
@scope("global")
@description("Culinary technique, kitchen operations, menu engineering, and food cost control.")
seed chef_professional {
  id:                    "chef_professional"
  slug:                  "chef_professional"
  name:                  "Professional Chef"
  description:           "Culinary technique, kitchen operations, menu engineering, and food cost control."
  category:              "hospitality"
  lockedDomainIds:       ["culinary_technique"]
  defaultDomainIds:      ["menu_engineering", "food_safety", "recipes", "kitchen_management", "food_costing"]
  lockedToolSlugs:       ["respondToUser"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

