  lockedDomainIds:       ["graphic_design"]
  defaultDomainIds:      ["typography", "color_theory", "brand_strategy", "layout_design", "design_systems"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

