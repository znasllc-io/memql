// roles/creative.memql
//
// Creative + arts role seeds. All Tier A (no advisory framing needed).

use agents.concepts.{ agentRole }

@description("Visual identity, layout, typography, color, and brand-system design.")
seed agentRole graphic-designer {
  slug:                  "graphic-designer"
  name:                  "Graphic Designer"
  category:              "creative"
  lockedDomainIds:       ["graphic-design"]
  defaultDomainIds:      ["typography", "color-theory", "brand-strategy", "layout-design", "design-systems"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

