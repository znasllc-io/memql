// roles/professional.memql
//
// Professional (white-collar business) role seeds. One v1:agents:agentRole
// catalog row per `seed`. Materialized by the SeedMaterializer at engine
// startup; idempotent. predefined=true marks each row as locked in the
// catalog manager UI.

use agents.concepts.{ agentRole }

@description("The designated fallback when no specialist fits. Owns operator-facing UI-driving tools and routes work to other agents when appropriate.")
seed agentRole assistant {
  slug:                  "assistant"
  name:                  "Assistant"
  category:              "professional"
  tier:                  "A"
  lockedDomainIds:       ["copresent-ui", "recent-chat", "computer-use"]
  defaultDomainIds:      ["strategic-planning", "stakeholder-communications", "technical-documentation"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  defaultToolSlugs:      ["uiClick", "uiNarrate", "uiDescribe", "uiAskUser"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Bookkeeping, financial reporting, tax fundamentals, budget cycles, and variance analysis at the corporate level.")
seed agentRole accounting-finance {
  slug:                  "accounting-finance"
  name:                  "Accounting & Finance"
  category:              "professional"
  tier:                  "B"
  lockedDomainIds:       ["accounting-principles", "financial-data"]
  defaultDomainIds:      ["tax-regulations", "budgeting-forecasting", "payroll-benefits", "contracts-agreements"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "strongReasoning"
  systemPromptHints:     "Provide general accounting and finance information. For tax advice specific to a person's situation, recommend a CPA or licensed tax professional."
  predefined:            true
}

