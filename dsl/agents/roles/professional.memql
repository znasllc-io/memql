// roles/professional.memql
//
// Professional (white-collar business) role seeds. One v1:agents:agentRole
// catalog row per `seed`. Materialized by the SeedMaterializer at engine
// startup; idempotent. predefined=true marks each row as locked in the
// catalog manager UI.

use agents.concepts.{ agentRole }

/// Bookkeeping, financial reporting, tax fundamentals, budget cycles, and variance analysis at the
/// corporate level.
seed agentRole accounting-finance {
  slug:                  "accounting-finance"
  name:                  "Accounting & Finance"
  category:              "professional"
  tier:                  "B"
  lockedSkillIds:        ["workbench-baseline", "professional-baseline"]
  defaultSkillIds:       []
  availableSkillIds:     []
  forbiddenSkillIds:     []
  maxSkills:             5
  recommendedPolicySlug: "strongReasoning"
  systemPromptHints:     "Provide general accounting and finance information. For tax advice specific to a person's situation, recommend a CPA or licensed tax professional."
  predefined:            true
}

