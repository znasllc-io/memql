// roles/professional.memql
//
// Professional (white-collar business) role seeds. One v1:agents:agentRole
// catalog row per `seed`. Materialized by the SeedMaterializer at engine
// startup; idempotent. predefined=true marks each row as locked in the
// catalog manager UI.

use agents.agentRole

@version("1.0.0")
@scope("global")
@description("The designated fallback when no specialist fits. Owns operator-facing UI-driving tools and routes work to other agents when appropriate.")
seed general_assistant {
  id:                    "general_assistant"
  slug:                  "general_assistant"
  name:                  "General Assistant"
  description:           "The designated fallback when no specialist fits. Owns operator-facing UI-driving tools and routes work to other agents when appropriate."
  category:              "professional"
  tier:                  "A"
  lockedDomainIds:       ["copresent_ui", "copresent_conversation", "computer_use"]
  defaultDomainIds:      ["strategic_planning", "stakeholder_communications", "technical_documentation"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  defaultToolSlugs:      ["uiClick", "uiNarrate", "uiDescribe", "uiAskUser"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@version("1.0.0")
