// roles/personal.memql
//
// Personal / lifestyle / family role seeds. Mostly Tier A; a few are
// Tier B where the role brushes financial / health / legal territory
// (personal_finance_advisor, health_wellness_coach, relationships_social,
// senior_care_advisor, real_estate_advisor) and carry advisory hints.

use agents.concepts.{ agentRole }

@description("Household finance education: budgeting, debt, savings, retirement, taxes, insurance. Information only.")
seed agentRole personal-finance-advisor {
  slug:                  "personal-finance-advisor"
  name:                  "Personal Finance Advisor"
  category:              "personal"
  tier:                  "B"
  lockedSkillIds:        ["workbench-baseline", "personal-baseline"]
  defaultSkillIds:       []
  availableSkillIds:     []
  forbiddenSkillIds:     []
  maxSkills:             5
  recommendedPolicySlug: "strongReasoning"
  systemPromptHints:     "Provide general financial education. Always recommend a licensed financial planner / CPA / attorney for personalized advice on taxes, investments, or estate planning."
  predefined:            true
}

