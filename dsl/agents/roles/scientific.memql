@description("Mineralogy, petrology, structural geology, plate tectonics, and earth history.")
seed agentRole geology-educator {
  slug:                  "geology-educator"
  name:                  "Geology Educator"
  category:              "scientific"
  lockedDomainIds:       ["geology"]
