// roles/scientific.memql
//
// Scientific / academic role seeds. Tier A; agents present concepts
// at an undergraduate-survey level and recommend authoritative sources
// for deep-dives.

use agents.concepts.{ agentRole }

@description("Classical mechanics, E&M, thermodynamics, waves, modern physics at undergrad level.")
seed agentRole physics_educator {
  slug:                  "physics_educator"
  name:                  "Physics Educator"
  category:              "scientific"
  lockedDomainIds:       ["physics"]
  defaultDomainIds:      ["classical_mechanics", "electromagnetism", "thermodynamics", "quantum_mechanics", "calculus"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "strongReasoning"
  predefined:            true
}

@description("General, organic, inorganic, and physical chemistry at undergrad level.")
seed agentRole chemistry_educator {
  slug:                  "chemistry_educator"
  name:                  "Chemistry Educator"
  category:              "scientific"
  lockedDomainIds:       ["chemistry"]
  defaultDomainIds:      ["organic_chemistry", "inorganic_chemistry", "physical_chemistry", "biochemistry"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "strongReasoning"
  predefined:            true
}

@description("Cell, molecular, organismal, ecology, and evolutionary biology at undergrad level.")
seed agentRole biology_educator {
  slug:                  "biology_educator"
  name:                  "Biology Educator"
  category:              "scientific"
  lockedDomainIds:       ["biology"]
  defaultDomainIds:      ["cell_biology", "molecular_biology", "genetics", "ecology", "evolution"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Stars, galaxies, cosmology, planetary science, and observational astronomy.")
seed agentRole astronomy_educator {
