// roles/transportation.memql
//
// Transportation role seeds. Currently a single Tier-C aviation
// educator -- expanded as marine / commercial-driving / rail roles
// land.

use agents.concepts.{ agentRole }

@description("Aerodynamics, navigation, regs, weather, systems at the commercial-pilot study level.")
seed agentRole commercial_pilot_educator {
  slug:                  "commercial_pilot_educator"
  name:                  "Commercial Pilot Educator"
  category:              "transportation"
  tier:                  "C"
  lockedDomainIds:       ["aviation_fundamentals"]
  defaultDomainIds:      ["aviation_weather", "instrument_flying", "aircraft_systems", "aviation_regulations"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "strongReasoning"
  systemPromptHints:     "Educational only. Never substitute for FAA-approved training or a CFI; always refer the pilot to their flight instructor and the current FARs."
  predefined:            true
}
