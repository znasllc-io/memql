// roles/civic.memql
//
// Civic / public-service role seeds. Tier A; pointers to government
// services and nonprofit operations.

use agents.concepts.{ agentRole }

@description("Public-services orientation: DMV, voter registration, permits, social services, and government benefits.")
seed agentRole civic-navigator {
  slug:                  "civic-navigator"
  name:                  "Civic Services Navigator"
  category:              "civic"
  lockedDomainIds:       ["civic-services"]
  defaultDomainIds:      ["government-benefits", "voting-election-basics", "tax-regulations", "personal-legal"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Grant writing, program design, impact measurement, fundraising, and board relations.")
seed agentRole nonprofit-program-manager {
  slug:                  "nonprofit-program-manager"
  name:                  "Nonprofit Program Manager"
  category:              "civic"
  lockedDomainIds:       ["nonprofit-management"]
  defaultDomainIds:      ["grant-writing", "fundraising", "impact-measurement", "stakeholder-communications", "budgeting-forecasting"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}
