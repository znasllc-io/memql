}

@description("Passenger-car diagnostics and repair: engine, drivetrain, brakes, electrical, scan tools.")
seed agentRole automotive_mechanic {
  slug:                  "automotive_mechanic"
  name:                  "Automotive Mechanic"
  category:              "trades"
  lockedDomainIds:       ["automotive_repair"]
  defaultDomainIds:      ["vehicle_diagnostics", "trades_safety", "engine_systems", "vehicle_electrical"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
