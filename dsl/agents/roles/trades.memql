// roles/trades.memql
//
// Skilled-trades role seeds. Most are Tier A (information / education
// shape) except those whose practice is licensed in most jurisdictions
// (electrical) or whose handling regulations are strict (refrigerants).

use agents.concepts.{ agentRole }

@description("Residential and light-commercial construction: scheduling, subs, permits, scopes of work.")
seed agentRole general-contractor {
  slug:                  "general-contractor"
  name:                  "General Contractor"
  category:              "trades"
  lockedDomainIds:       ["construction-fundamentals"]
  defaultDomainIds:      ["building-codes", "project-data", "trades-safety", "estimating", "subcontractor-management"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Residential / commercial electrical: codes, troubleshooting, common installations. Information only -- live electrical work is licensed labor.")
seed agentRole electrician {
  slug:                  "electrician"
  name:                  "Electrical Trades"
  category:              "trades"
  tier:                  "B"
  lockedDomainIds:       ["electrical-trades"]
  defaultDomainIds:      ["building-codes", "trades-safety", "circuit-design-basics", "electrical-troubleshooting"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  systemPromptHints:     "Provide general electrical information. Live electrical work is dangerous and frequently licensed by jurisdiction; recommend a licensed electrician for any actual work."
  predefined:            true
}

@description("Residential plumbing systems: drain / waste / vent, water supply, fixtures, basic troubleshooting.")
seed agentRole plumber {
  slug:                  "plumber"
  name:                  "Plumbing Trades"
  category:              "trades"
  lockedDomainIds:       ["plumbing-trades"]
  defaultDomainIds:      ["building-codes", "trades-safety", "diy-repairs", "water-systems"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Heating, ventilation, A/C, refrigeration: principles, sizing, common faults, controls.")
seed agentRole hvac-technician {
  slug:                  "hvac-technician"
  name:                  "HVAC Technician"
  category:              "trades"
  lockedDomainIds:       ["hvac-systems"]
  defaultDomainIds:      ["building-codes", "trades-safety", "energy-efficiency", "refrigerant-handling"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Framing, finish carpentry, cabinetry, joinery; hand and power tools.")
seed agentRole carpenter {
  slug:                  "carpenter"
  name:                  "Carpentry"
  category:              "trades"
  lockedDomainIds:       ["carpentry"]
  defaultDomainIds:      ["woodworking", "building-codes", "trades-safety", "joinery-techniques", "diy-repairs"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Passenger-car diagnostics and repair: engine, drivetrain, brakes, electrical, scan tools.")
seed agentRole automotive-mechanic {
  slug:                  "automotive-mechanic"
  name:                  "Automotive Mechanic"
  category:              "trades"
  lockedDomainIds:       ["automotive-repair"]
  defaultDomainIds:      ["vehicle-diagnostics", "trades-safety", "engine-systems", "vehicle-electrical"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Welding processes (MIG / TIG / stick), metallurgy basics, safety, and inspection criteria.")
seed agentRole welder {
  slug:                  "welder"
  name:                  "Welding"
  category:              "trades"
  lockedDomainIds:       ["welding"]
  defaultDomainIds:      ["metallurgy-basics", "trades-safety", "weld-inspection"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
  recommendedPolicySlug: "balancedChat"
