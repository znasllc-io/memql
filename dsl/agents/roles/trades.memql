// roles/trades.memql
//
// Skilled-trades role seeds. Most are Tier A (information / education
// shape) except those whose practice is licensed in most jurisdictions
// (electrical) or whose handling regulations are strict (refrigerants).

use agents.concepts.{ agentRole }

/// Residential and light-commercial construction: scheduling, subs, permits, scopes of work.
seed agentRole general-contractor {
  slug:                  "general-contractor"
  name:                  "General Contractor"
  category:              "trades"
  lockedSkillIds:        ["workbench-baseline", "trades-baseline"]
  defaultSkillIds:       []
  availableSkillIds:     []
  forbiddenSkillIds:     []
  maxSkills:             5
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

/// Residential / commercial electrical: codes, troubleshooting, common installations. Information
/// only -- live electrical work is licensed labor.
seed agentRole electrician {
  slug:                  "electrician"
  name:                  "Electrical Trades"
  category:              "trades"
  tier:                  "B"
  lockedSkillIds:        ["workbench-baseline", "trades-baseline"]
  defaultSkillIds:       []
  availableSkillIds:     []
  forbiddenSkillIds:     []
  maxSkills:             5
  recommendedPolicySlug: "balancedChat"
  systemPromptHints:     "Provide general electrical information. Live electrical work is dangerous and frequently licensed by jurisdiction; recommend a licensed electrician for any actual work."
  predefined:            true
}

/// Residential plumbing systems: drain / waste / vent, water supply, fixtures, basic
/// troubleshooting.
seed agentRole plumber {
  slug:                  "plumber"
  name:                  "Plumbing Trades"
  category:              "trades"
  lockedSkillIds:        ["workbench-baseline", "trades-baseline"]
  defaultSkillIds:       []
  availableSkillIds:     []
  forbiddenSkillIds:     []
  maxSkills:             5
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

