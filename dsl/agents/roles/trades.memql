@description("Landscape design, installation, and maintenance: plants, irrigation, hardscape, seasonal care.")
seed agentRole landscaping-grounds {
  slug:                  "landscaping-grounds"
  name:                  "Landscaping & Grounds"
  category:              "trades"
  lockedDomainIds:       ["landscaping"]
  defaultDomainIds:      ["horticulture", "irrigation-systems", "gardening", "lawn-care"]
  lockedToolSlugs:       ["respondToUser", "workbench-use"]
