// roles/trades.memql
//
// Skilled-trades role seeds. Most are Tier A (information / education
// shape) except those whose practice is licensed in most jurisdictions
// (electrical) or whose handling regulations are strict (refrigerants).

use agents.concepts.{ agentRole }

@description("Residential and light-commercial construction: scheduling, subs, permits, scopes of work.")
seed agentRole general_contractor {
  slug:                  "general_contractor"
  name:                  "General Contractor"
  category:              "trades"
  lockedDomainIds:       ["construction_fundamentals"]
  defaultDomainIds:      ["building_codes", "project_data", "trades_safety", "estimating", "subcontractor_management"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Residential / commercial electrical: codes, troubleshooting, common installations. Information only -- live electrical work is licensed labor.")
seed agentRole electrician {
  slug:                  "electrician"
  name:                  "Electrical Trades"
  category:              "trades"
  tier:                  "B"
  lockedDomainIds:       ["electrical_trades"]
  defaultDomainIds:      ["building_codes", "trades_safety", "circuit_design_basics", "electrical_troubleshooting"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  systemPromptHints:     "Provide general electrical information. Live electrical work is dangerous and frequently licensed by jurisdiction; recommend a licensed electrician for any actual work."
  predefined:            true
}

@description("Residential plumbing systems: drain / waste / vent, water supply, fixtures, basic troubleshooting.")
seed agentRole plumber {
  slug:                  "plumber"
  name:                  "Plumbing Trades"
  category:              "trades"
  lockedDomainIds:       ["plumbing_trades"]
  defaultDomainIds:      ["building_codes", "trades_safety", "diy_repairs", "water_systems"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Heating, ventilation, A/C, refrigeration: principles, sizing, common faults, controls.")
seed agentRole hvac_technician {
  slug:                  "hvac_technician"
  name:                  "HVAC Technician"
  category:              "trades"
  lockedDomainIds:       ["hvac_systems"]
  defaultDomainIds:      ["building_codes", "trades_safety", "energy_efficiency", "refrigerant_handling"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

@description("Framing, finish carpentry, cabinetry, joinery; hand and power tools.")
seed agentRole carpenter {
  slug:                  "carpenter"
  name:                  "Carpentry"
  category:              "trades"
  lockedDomainIds:       ["carpentry"]
  defaultDomainIds:      ["woodworking", "building_codes", "trades_safety", "joinery_techniques", "diy_repairs"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
