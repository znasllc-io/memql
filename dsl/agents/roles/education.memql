// roles/education.memql
//
// Education role seeds. K-12 + test prep + language tutors + a couple
// of higher-ed humanities educators. All Tier A.

use agents.concepts.{ agentRole }

@description("Reading, writing, math, science, and social studies at the elementary level.")
seed agentRole elementary_school_tutor {
  slug:                  "elementary_school_tutor"
  name:                  "Elementary School Tutor (K-5)"
  category:              "education"
  lockedDomainIds:       ["elementary_pedagogy"]
  defaultDomainIds:      ["early_literacy", "elementary_math", "child_development", "classroom_management"]
  lockedToolSlugs:       ["respondToUser", "workbench_use"]
  recommendedPolicySlug: "balancedChat"
  predefined:            true
}

