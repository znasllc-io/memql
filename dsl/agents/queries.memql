// queries.memql
//
// Agent-namespace queries -- the platform's canonical surface for
// reading v1:agents:agent + v1:agents:agentAuthorization rows. Every
// BFF reads through these queries (Cockpit's Agents tab, the product
// SPA's agent panel, the Planner's dedupe lookup) so adding a new BFF means
// "wire it up to call allAgents" -- not "re-implement the agent
// list query."

use common.traits.{ isActiveRecord, isNotDeleted }

/// Returns available AI agent templates. Optional filter: groupId
query agent activeAgents {
  args {
    groupId  string
  }
  filter  isActiveRecord && isNotDeleted && when(args.groupId) { args.groupId in groupIds }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   agentFull
}

// agentAuthorizationsForSelf -- the CALLER's own standing grants
// ==============================================================
//
// RESOLVED 2026-08-06 (memql#3177, carrying memql#3129). This was
// `agentAuthorizationsForUser`: `@public`, `userId==args.userId`, with
// nothing relating the caller to the id they passed. The comment that
// used to sit here said `@public` marked it "intentionally not
// caller-scoped" for the worker dispatcher and deferred the split to
// #54. That deferral is over -- `v1:agents:agentAuthorization` now
// declares `@rowAuthz(owner="userId")`, so an unscoped read of it is no
// longer expressible: #3172's land gate refuses the `args.userId` form
// as undecidable, which is precisely the signal it exists to give.
//
// There is no userId argument BY DESIGN, in the shape memql#3178 landed
// for `patIdentitiesForSelf`: the row set derives from the
// authenticated actor, so a caller cannot name whose grants get listed.
// An ignored argument would still be an argument and the next reader
// would wire it back up.
//
// THE SPLIT #3178 USED FOR PATs IS NOT AVAILABLE HERE, and the reason is
// worth stating so nobody re-proposes it: a second `userId==args.userId`
// arm -- admin-gated or `@serverOnly` -- still binds a concept that
// declares a tier, so #3172's land gate measures it and refuses it too.
// Under a declared tier, `userId==actor.userId` is the only readable
// shape. The four server-side call sites that legitimately resolve
// ANOTHER user's envelope ceiling (the agent's owner, not the caller)
// therefore supply that user's actor envelope for the one Execute call
// -- `auth.ContextWithUserActor(ctx, ownerUserId)`, inline, per call, in
// the #3072 shape epic decision C blesses. They are:
//
//   - component/memql/authoring_capability_store.go  (author envelope)
//   - integrations/agent/worker/store.go             (worker dispatch gate)
//   - integrations/planner/mint_skill_handler.go     (mint authority)
//   - app/computer_use_status_agent.go               (per-turn scope echo)
//
/// The CALLING user's active standing authorizations, across all agents and plan kinds.
@actor
@unbounded("per-user standing authorizations -- a small bounded set the caller evaluates whole for authz decisions")
query agentAuthorization agentAuthorizationsForSelf {
  filter  userId==actor.userId && isActiveRecord
  shape   agentAuthorizationFull
}

// agentById - Get Agent by ID
// ==================================
//
// Retrieves an agent concept by its node ID. Returns the agent's
// configuration including name, personality, provider config,
// capabilities, and trigger behavior.

/// Get an agent by ID with full configuration.
query agent agentById {
  args {
    agentId  string!
  }
  filter  row.id==args.agentId
  shape   agentFull
}

// agentOwner -- agent's owning-user lookup
// ==============================================
//
// Returns the v1:agents:agent row projected through agentFull,
// which exposes BOTH `agent.ownerUserId` and `createdBy`. Callers
// (resolveAgentOwner in app/computer_use_status_agent.go and
// resolveOwnerForAgent in integrations/agent/replier.go) read
// ownerUserId first and fall back to createdBy.

/// Resolve an agent's owning-user (ownerUserId / createdBy) by id.
query agent agentOwner {
  args {
    agentId  string!
  }
  filter  row.id==args.agentId
  shape   agentFull
}

// agentRoleSlugsInUse - Query roleSlugs already taken by an agent
// ================================================================
//
// Returns the list of `agent.roleSlug` values currently in use by
// non-deleted agents in the partition. Used by create-agent UIs to
// filter out already-taken roles from role pickers.

/// Returns the roleSlug values currently occupied by non-deleted agents in this partition. Used by
/// the create-agent UI to filter out already-taken roles.
@unbounded("distinct role slugs in use -- a small bounded dedupe set consumed whole")
query agent agentRoleSlugsInUse {
  filter  isActiveRecord && isNotDeleted
  shape   agentRoleSlugLite
}

// allAgents - Query All AI Agent Templates
// ==========================================
//
// Returns all AI agent templates from the v1:agents:agent concept,
// regardless of active status. Backs the Cockpit Agents tab and any
// agent-management surface that needs to see active + inactive rows.

/// Returns all AI agent templates regardless of active status.
query agent allAgents {
  filter  isNotDeleted
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   agentFull
}

/// The row set behind the in-process agent registry (component/memql/agents.go
/// LoadFromRows). Unpaged where allAgents is a paged UI list: an agent missing
/// from a resolution table is not "on page 2", it is unresolvable, and nothing
/// here follows a cursor. The paged form could not be made to work by following
/// one either -- the engine fills a page from `target*2` PHYSICAL version rows
/// and dedupes to logical rows afterwards, so ordinary edit churn returns a
/// short page that looks exhausted (memql#3209).
///
/// "Unpaged" is not "unbounded": @unbounded rewrites to paginate 1000000, which
/// effectiveWindow clamps to MaxWindow (5000) and evaluateExpression clamps
/// again to MaxResults, default 500. Past 500 agents this truncates, and
/// silently -- revisit it there rather than assuming the read is complete.
///
/// Scoping it to actor.userId is NOT the fix, and would be actively wrong. This
/// is a process-wide catalog built once at startup under the seed materializer's
/// system actor; there is no requesting user at that moment for actor.userId to
/// name, so such a filter would evaluate against an empty actor, load zero
/// agents and silently disable every specialist. The read is unscoped BECAUSE
/// it is a catalog -- the ownership question that raises is answered at LOOKUP
/// time, not here.
///
/// @serverOnly because the projection carries every user's systemPrompt. That
/// is admissible for a server-internal catalog read and not admissible on the
/// generated client SDK, where a caller could pull other users' personas
/// verbatim.
@serverOnly
@unbounded("the in-process agent registry must be COMPLETE -- a truncated page silently makes an agent unresolvable, and the paged form cannot self-heal under version churn")
query agent agentsForRegistry {
  filter  isNotDeleted
  shape   agentFull
}

// `@public` marks this query as intentionally not caller-scoped.
// Both callsites are system-actor paths: the planner agent loop
// (`integrations/planner/agent_loop.go:loadSpecialists`, runs under
// `systemActorContext`) and the agent factory's dedupe lookup
// (`integrations/agents/factory.go:loadExistingAgents`, called from
// inside the agent tool loop). A user-facing entry point would
// instead want a `queryMyActiveAgents` variant scoped by
// `actor.userId`; splitting tracked as a follow-up under #54.
/// Per Q10 layered dedupe Layer 1: list every active agent owned by a user (any roleSlug, any space
/// scope). The Planner Agent's createSpecialist decision feeds this list into the similarity check
/// before proposing a new agent. Platform-infrastructure agents (payload.kind=='system' -- MemQL
/// Planner, MemQL Trainer) are returned by this query and filtered out structurally by
/// loadExistingAgents in integrations/agents/factory.go before they enter the dedupe candidate
/// pool; the filter lives one layer up rather than in the query so the same query can serve other
/// callers that legitimately need system rows.
@public
@unbounded("per-user agents minimal projection for dedupe -- the caller must see all to dedupe")
query agent activeAgentsForUser {
  args {
    ownerUserId  string!
  }
  filter  ownerUserId==args.ownerUserId && isActiveRecord && isNotDeleted
  shape   agentMinimalForDedupe
}

// `@public` marks this query as intentionally not caller-scoped.
// Single callsite: the autoJoinAI automation runs as a system actor
// (system:automation:autoJoinAI) and needs to resolve the space
// owner's General Assistant from the ownerUserId stamped on the
// space row -- NOT from the createdBy actor field, which varies by
// caller (signup automation, login automation, frontend hook).
// Inconsistent agentId resolution across the three callers was the
// root cause of the duplicate-participants regression in memql#273.
/// Resolve the active General Assistant agent owned by a user. Returns 0 or 1 rows. Used by
/// autoJoinAI to derive a canonical agent id consistent across all callers of
/// mutationCreateDailySpace -- the space row's ownerUserId is the same regardless of who triggered
/// the mutation, while args.event.payload.actor (createdBy) varies. memql#273.
@public
@unbounded("the per-user assistant agent (roleSlug==assistant singleton) -- bounded to a single row")
query agent assistantAgentForUser {
  args {
    ownerUserId  string!
  }
  filter  ownerUserId==args.ownerUserId && roleSlug=="assistant" && isActiveRecord && isNotDeleted
  shape   agentMinimalForDedupe
}

// Caching (5.5 / memql#1969): single-row role lookup off the rarely-
// changing role catalog; same cross-node eviction guarantee as
// activeAgentRoles (v1:agents:* forwarded in component/node/routing.go).
/// Resolve a single agentRole row by its slug. Used by the role catalog seeder (idempotency check)
/// and by the agent-creation path (look up the locked + default sets when materializing a new agent
/// for the slug).
@unbounded("agent role by unique slug -- bounded to a single row")
@cache(300)
query agentRole agentRoleBySlug {
  args {
    slug  string!
  }
  filter  slug==args.slug && isActiveRecord
  shape   agentRoleFull
}

// Caching (5.5 / memql#1969): the agentRole catalog is a small,
// admin-defined registry read on every agent detail render and routing
// decision, and it changes rarely -- an ideal long-TTL cache. 5.4
// invalidation evicts on any v1:agents:agentRole write; the deleted +
// updated + created forward rules in component/node/routing.go guarantee
// that eviction fires on every replica (this namespace is not in the
// default forward set). NOTE: the @cache annotation is kept contiguous
// with the @-annotation block below -- the SDK generator's description
// preamble walker stops at the first non-@ line, so a comment between the
// annotations and the `query` header would drop the SDK doc string.
//
// `@public` below is the REFERENCE-DATA kind, not the #54-debt kind the
// three @public queries earlier in this file carry. Those take a
// caller-supplied userId/ownerUserId and return per-user rows; this one
// has no per-caller dimension at all -- `concept agentRole` declares no
// owner field and no @pii field, and `agentRoleFull` omits
// row.createdBy. dsl/rbac/queries.memql's header is the doctrine and the
// reference case. Same marker, two meanings: read this before adding the
// construct to a list of the other kind (memql#2918).
//
// Justified by WHAT IT RETURNS, not by when it runs. "There is no caller
// yet" is the argument the audit doc says leads to @serverOnly, and it
// would be wrong here twice over: a pending-invite guest and a
// MEMQL_IDENTITY_ENABLED=false caller can both reach this, and
// @serverOnly is runtime-enforced so it would break the live SDK and
// cockpit callers.
//
// COSTS ONE SUPPRESSOR, deliberately. @public is matched ahead of the
// flagged bucket in test/dslconformance/conformance_test.go, and it is a hard blocker on
// memql#2920 tier inference (cmd/memqlmigrate/rowauthz_infer.go). It
// suppresses nothing today only because `agentRoleBySlug` already blocks
// v1:agents:agentRole from being declared. If that query ever becomes
// caller-gated, this annotation silently keeps the concept undeclared.
// UNSCOPED BY DESIGN, and the omission is deliberate rather than forgotten
// (memql#2985). This filter carries no caller-scope term, so one user's
// custom role is listed for every other user in the deployment.
//
// The catalog is global because routing needs it to be: cognition and the
// conductor resolve an agent's role while dispatching a turn, and they have
// to see the same role surface regardless of whose agent it is. A per-creator
// filter would make a role resolvable only in its creator's sessions.
//
// The honest limit of that argument, recorded so the next reader does not
// have to re-derive it: it justifies the PREDEFINED rows being global, and
// does not by itself require user-minted ones to be. Exposing a custom role's
// name and description to other users in the deployment is a KNOWN trade
// carried deliberately, not a consequence nobody noticed -- but note it is
// recorded here rather than ruled on anywhere traceable, so treat it as the
// current state of the argument rather than as a settled decision. The scoped
// alternative is expressible today if it is revisited --
// `isActiveRecord && (predefined || row.createdBy == actor.userId)` loads and
// pushes down, since the engine stamps createdBy -- but it removes @public
// and changes the wire contract for the cockpit role picker and the agent
// factory's loadRoleCatalog, so it wants its own review.
//
// Note this is a READ decision only. Predefined rows are locked on the WRITE
// path by validateAgentRolePredefinedLock, which is a separate concern and
// enforced regardless (memql#2985).

/// List every active agentRole row. Backs the role picker on the cockpit's agent-creation surface
/// and on the role-management view. predefined rows render with a lock icon and are locked on the
/// write path too (validateAgentRolePredefinedLock); user-created rows are fully editable.
/// Deliberately unscoped -- every caller sees every role, including other users' custom ones. See
/// the note above.
@public
@unbounded("agent role catalog -- a small admin-defined bounded set consumed whole")
@cache(300)
query agentRole activeAgentRoles {
  filter  isActiveRecord
  shape   agentRoleFull
}

// Caching (5.5 / memql#1969): single-row lookup off the small admin-defined
// skill catalog; v1:agents:* writes are forwarded cross-node (routing.go) so
// 5.4 invalidation evicts on every replica.
/// Resolve a single skill catalog row by its slug. Used by the planner-driven mintSkill / attach
/// flows to look up a candidate skill's full composition before deciding whether to apply it.
@unbounded("skill by unique slug -- bounded to a single row")
@cache(300)
query skill skillBySlug {
  args {
    slug  string!
  }
  filter  slug==args.slug && isActiveRecord
  shape   skillFull
}

// Caching (5.5 / memql#1969): bounded admin-defined skill catalog read on the
// Skills picker; rarely changes. Cross-node eviction guaranteed by the
// v1:agents:* forward rules in component/node/routing.go.
/// List every active skill catalog row -- summary projection. Backs the Skills picker on the
/// role-edit surface (cockpit#124) and the Planner Agent's candidate scan when deciding which skill
/// bundle to attach in extendSpecialist. Predefined rows render with a lock icon; user-created rows
/// are fully editable.
@unbounded("skill catalog (summary) -- a small admin-defined bounded registry consumed whole")
@cache(300)
query skill activeSkills {
  filter  isActiveRecord
  shape   skillSummary
}

// Caching (5.5 / memql#1969): the heavier full-bundle skill catalog read on
// every agent detail render (cockpit#124); bounded + rarely changing -- the
// highest-value catalog cache. Cross-node eviction via v1:agents:* forwarding
// (component/node/routing.go).
/// List every active skill catalog row with its full bundle composition (domainIds + toolSlugs +
/// liveSourceIds). Heavier projection than activeSkills; use this when a caller needs to resolve
/// agent capabilities by unioning skill bundles in-process (cockpit#124's Agents view does this on
/// every detail render). The catalog is small (25 rows in Phase 2; growth tracked via the Phase 3
/// mintSkill roadmap) so the single-shot full-list query is cheaper than N skillBySlug round-trips.
@unbounded("skill catalog (full) -- a small admin-defined bounded registry consumed whole")
@cache(300)
query skill activeSkillsFull {
  filter  isActiveRecord
  shape   skillFull
}

/// Per #157 (Phase 1 of the skills rollout): list active skills that bundle a caller-supplied
/// knowledge domain id. The Planner Agent's Phase 2 refresh loop calls queryDueRefreshDomains first
/// (already shipping), then fans out one call per stale domain id to discover 'which skills are
/// downstream of this domain and want a re-attach run after the underlying knowledge refreshes
/// complete'. Pure derivation -- no new state. Argument-as-scalar (rather than list intersection)
/// mirrors activeAgents's per-group fanout pattern so the existing DSL push-down operator surface
/// stays sufficient.
@unbounded("skills needing refresh on a stale domain -- an internal refresh sweep over the bounded skill catalog")
query skill skillNeedsRefresh {
  args {
    staleDomainId  string!
  }
  filter  isActiveRecord && when(args.staleDomainId) { args.staleDomainId in domainIds }
  shape   skillSummary
}

/// Phase 3 (memql#159 / cockpit#125): list v1:agents:skillChangeEvent rows for a target agent.
/// Backs the cockpit planner trace viewer's per-agent skill-history surface -- the operator selects
/// a Plan, sees its ownerAgentId, and this query feeds the timeline of every attach / reconfigure
/// recorded against that agent (newest first). The skillChangeEvent rows are append-only, so this
/// is just a filter + sort against the time-series.
query skillChangeEvent skillChangeEventsForAgent {
  args {
    targetAgentId  string!
  }
  filter  targetAgentId==args.targetAgentId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   skillChangeEventFull
}

/// List active avatar personas in the operator catalog (memql#609). Backs the Create-Assistant
/// persona picker (frontend#239); the SPA filters to the user's selected gender client-side over
/// this small catalog. `vendor` is an OPTIONAL filter -- omit it to list every active persona
/// across vendors; pass vendor="simli" to scope to custom Simli avatars (memql#1708: the predicate
/// was a hardcoded vendor==simli that silently dropped every other vendor's personas from the list,
/// even though by-id reads returned them). Rows are hand-curated as seeds in
/// dsl/agents/avatarPersonas.memql.
@unbounded("avatar persona catalog -- a small bounded set consumed whole")
query avatarPersona avatarPersonas {
  args {
    vendor  enum("anam", "simli")
  }
  filter  isActiveRecord && when(args.vendor) { vendor==args.vendor }
  shape   avatarPersonaFull
}

/// Resolve a single avatar persona by id. Hydrates an agent's stamped avatarPersonaId for display
/// and resolves the vendor + vendor-issued personaId.
query avatarPersona avatarPersonaById {
  args {
    avatarPersonaId  string!
  }
  filter  row.id==args.avatarPersonaId
  shape   avatarPersonaFull
}
