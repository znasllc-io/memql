// queries.memql
//
// Agent-namespace queries -- the platform's canonical surface for
// reading v1:agents:agent + v1:agents:agentAuthorization rows. Every
// BFF reads through these queries (Cockpit's Agents tab, CoPresent's
// agent panel, the Planner's dedupe lookup) so adding a new BFF means
// "wire it up to call queryAllAgents" -- not "re-implement the agent
// list query."

use agents.concepts.{ agent, agentAuthorization, agentRole, avatarPersona, skill, skillChangeEvent }

@enabled
@description("Returns available AI agent templates. Optional filter: groupId")
query agent queryActiveAgents {
  args {
    groupId  string
  }
  filter  traitIsActiveRecord && traitIsNotDeleted && when(args.groupId) { args.groupId in payload.groupIds }
  shape   agentFull
}

// `@public` marks this query as intentionally not caller-scoped --
// the only callsite is the worker dispatcher (`integrations/agent/
// worker/store.go:AgentAuthorization`), which runs under the agent
// node's system actor when resolving an outgoing worker call's
// scope grants. Splitting into a caller-self variant + a system-
// only variant is tracked as a follow-up under #54 once the worker
// dispatcher's auth model is settled.
@enabled
@public
@description("All active standing authorizations granted by a user, across all agents and plan kinds.")
query agentAuthorization queryAgentAuthorizationsForUser {
  args {
    userId  string  @required
  }
  filter  payload.userId==args.userId && traitIsActiveRecord
  shape   agentAuthorizationFull
}

// queryAgentById - Get Agent by ID
// ==================================
//
// Retrieves an agent concept by its node ID. Returns the agent's
// configuration including name, personality, provider config,
// capabilities, and trigger behavior.

@enabled
@description("Get an agent by ID with full configuration.")
query agent queryAgentById {
  args {
    agentId  string  @required
  }
  filter  id==args.agentId
  shape   agentFull
}

// queryAgentOwner -- agent's owning-user lookup
// ==============================================
//
// Returns the v1:agents:agent row projected through agentFull,
// which exposes BOTH `agent.ownerUserId` and `createdBy`. Callers
// (resolveAgentOwner in app/computer_use_status_agent.go and
// resolveOwnerForAgent in integrations/agent/replier.go) read
// ownerUserId first and fall back to createdBy.

@enabled
@description("Resolve an agent's owning-user (ownerUserId / createdBy) by id.")
query agent queryAgentOwner {
  args {
    agentId  string  @required
  }
  filter  id==args.agentId
  shape   agentFull
}

// agentRoleSlugsInUse - Query roleSlugs already taken by an agent
// ================================================================
//
// Returns the list of `agent.roleSlug` values currently in use by
// non-deleted agents in the partition. Used by create-agent UIs to
// filter out already-taken roles from role pickers.

@enabled
@description("Returns the roleSlug values currently occupied by non-deleted agents in this partition. Used by the create-agent UI to filter out already-taken roles.")
query agent queryAgentRoleSlugsInUse {
  filter  traitIsActiveRecord && traitIsNotDeleted
  shape   agentRoleSlugLite
}

// allAgents - Query All AI Agent Templates
// ==========================================
//
// Returns all AI agent templates from the v1:agents:agent concept,
// regardless of active status. Backs the Cockpit Agents tab and any
// agent-management surface that needs to see active + inactive rows.

@enabled
@description("Returns all AI agent templates regardless of active status.")
query agent queryAllAgents {
  filter  traitIsNotDeleted
  shape   agentFull
}

// `@public` marks this query as intentionally not caller-scoped.
// Both callsites are system-actor paths: the planner agent loop
// (`integrations/planner/agent_loop.go:loadSpecialists`, runs under
// `systemActorContext`) and the agent factory's dedupe lookup
// (`integrations/agents/factory.go:loadExistingAgents`, called from
// inside the agent tool loop). A user-facing entry point would
// instead want a `queryMyActiveAgents` variant scoped by
// `actor.userId`; splitting tracked as a follow-up under #54.
@enabled
@public
@description("Per Q10 layered dedupe Layer 1: list every active agent owned by a user (any roleSlug, any space scope). The Planner Agent's createSpecialist decision feeds this list into the similarity check before proposing a new agent. Platform-infrastructure agents (payload.kind=='system' -- MemQL Planner, MemQL Trainer) are returned by this query and filtered out structurally by loadExistingAgents in integrations/agents/factory.go before they enter the dedupe candidate pool; the filter lives one layer up rather than in the query so the same query can serve other callers that legitimately need system rows.")
query agent queryActiveAgentsForUser {
  args {
    ownerUserId  string  @required
  }
  filter  payload.ownerUserId==args.ownerUserId && traitIsActiveRecord && traitIsNotDeleted
  shape   agentMinimalForDedupe
}

// `@public` marks this query as intentionally not caller-scoped.
// Single callsite: the autoJoinAI automation runs as a system actor
// (system:automation:autoJoinAI) and needs to resolve the space
// owner's General Assistant from the ownerUserId stamped on the
// space row -- NOT from the createdBy actor field, which varies by
// caller (signup automation, login automation, frontend hook).
// Inconsistent agentId resolution across the three callers was the
// root cause of the duplicate-participants regression in memql#273.
@enabled
@public
@description("Resolve the active General Assistant agent owned by a user. Returns 0 or 1 rows. Used by autoJoinAI to derive a canonical agent id consistent across all callers of mutationCreateDailySpace -- the space row's ownerUserId is the same regardless of who triggered the mutation, while args.event.payload.actor (createdBy) varies. memql#273.")
query agent queryAssistantAgentForUser {
  args {
    ownerUserId  string  @required
  }
  filter  payload.ownerUserId==args.ownerUserId && payload.roleSlug=="assistant" && traitIsActiveRecord && traitIsNotDeleted
  shape   agentMinimalForDedupe
}

@enabled
@description("Resolve a single agentRole row by its slug. Used by the role catalog seeder (idempotency check) and by the agent-creation path (look up the locked + default sets when materializing a new agent for the slug).")
query agentRole queryAgentRoleBySlug {
  args {
    slug  string  @required
  }
  filter  payload.slug==args.slug && traitIsActiveRecord
  shape   agentRoleFull
}

@enabled
@description("List every active agentRole row. Backs the role picker on the cockpit's agent-creation surface and on the role-management view. predefined rows render with a lock icon; user-created rows are fully editable.")
query agentRole queryActiveAgentRoles {
  filter  traitIsActiveRecord
  shape   agentRoleFull
}

@enabled
@description("Resolve a single skill catalog row by its slug. Used by the planner-driven mintSkill / attach flows to look up a candidate skill's full composition before deciding whether to apply it.")
query skill querySkillBySlug {
  args {
    slug  string  @required
  }
  filter  payload.slug==args.slug && traitIsActiveRecord
  shape   skillFull
}

@enabled
@description("List every active skill catalog row -- summary projection. Backs the Skills picker on the role-edit surface (cockpit#124) and the Planner Agent's candidate scan when deciding which skill bundle to attach in extendSpecialist. Predefined rows render with a lock icon; user-created rows are fully editable.")
query skill queryActiveSkills {
  filter  traitIsActiveRecord
  shape   skillSummary
}

@enabled
@description("List every active skill catalog row with its full bundle composition (domainIds + toolSlugs + liveSourceIds). Heavier projection than queryActiveSkills; use this when a caller needs to resolve agent capabilities by unioning skill bundles in-process (cockpit#124's Agents view does this on every detail render). The catalog is small (25 rows in Phase 2; growth tracked via the Phase 3 mintSkill roadmap) so the single-shot full-list query is cheaper than N querySkillBySlug round-trips.")
query skill queryActiveSkillsFull {
  filter  traitIsActiveRecord
  shape   skillFull
}

@enabled
@description("Per #157 (Phase 1 of the skills rollout): list active skills that bundle a caller-supplied knowledge domain id. The Planner Agent's Phase 2 refresh loop calls queryDueRefreshDomains first (already shipping), then fans out one call per stale domain id to discover 'which skills are downstream of this domain and want a re-attach run after the underlying knowledge refreshes complete'. Pure derivation -- no new state. Argument-as-scalar (rather than list intersection) mirrors queryActiveAgents's per-group fanout pattern so the existing DSL push-down operator surface stays sufficient.")
query skill querySkillNeedsRefresh {
  args {
    staleDomainId  string  @required
  }
  filter  traitIsActiveRecord && when(args.staleDomainId) { args.staleDomainId in payload.domainIds }
  shape   skillSummary
}

@enabled
@description("Phase 3 (memql#159 / cockpit#125): list v1:agents:skillChangeEvent rows for a target agent. Backs the cockpit planner trace viewer's per-agent skill-history surface -- the operator selects a Plan, sees its ownerAgentId, and this query feeds the timeline of every attach / reconfigure recorded against that agent (newest first). The skillChangeEvent rows are append-only, so this is just a filter + sort against the time-series.")
query skillChangeEvent querySkillChangeEventsForAgent {
  args {
    targetAgentId  string  @required
  }
  filter  payload.targetAgentId==args.targetAgentId
  shape   skillChangeEventFull
}

@enabled
@description("List active avatar personas in the operator catalog (memql#609). Backs the Create-Assistant persona picker (copresent#239); the SPA filters to the user's selected gender client-side over this small catalog. `vendor` is an OPTIONAL filter -- omit it to list every active persona across vendors; pass vendor=\"simli\" to scope to custom Simli avatars (memql#1708: the predicate was a hardcoded vendor==simli that silently dropped every other vendor's personas from the list, even though by-id reads returned them). Rows are hand-curated as seeds in dsl/agents/avatarPersonas.memql.")
query avatarPersona queryAvatarPersonas {
  args {
    vendor  string  @enum("anam", "simli")  @description("Optional vendor filter. Omit to list every active persona; pass to scope to one vendor.")
  }
  filter  traitIsActiveRecord && when(args.vendor) { payload.vendor==args.vendor }
  shape   avatarPersonaFull
}

@enabled
@description("Resolve a single avatar persona by id. Hydrates an agent's stamped avatarPersonaId for display and resolves the vendor + vendor-issued personaId.")
query avatarPersona queryAvatarPersonaById {
  args {
    avatarPersonaId  string  @required
  }
  filter  id==args.avatarPersonaId
  shape   avatarPersonaFull
}
