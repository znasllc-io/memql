// queries.memql
//
// Agent-namespace queries -- the platform's canonical surface for
// reading v1:agents:agent + v1:agents:agentAuthorization rows. Every
// BFF reads through these queries (Cockpit's Agents tab, CoPresent's
// agent panel, the Planner's dedupe lookup) so adding a new BFF means
// "wire it up to call queryAllAgents" -- not "re-implement the agent
// list query."

@enabled
@useConcept(agent)
@description("Returns available AI agent templates. Optional filter: groupId")
query queryActiveAgents {
  args {
    groupId  string
  }
  filter  traitIsActiveRecord; traitIsNotDeleted; ?.payload.groupIds has args.groupId
  shape   agentFull
}

@enabled
@useConcept(agentAuthorization)
@description("All active standing authorizations granted by a user, across all agents and plan kinds.")
query queryAgentAuthorizationsForUser {
  args {
    userId  string  @required
  }
  filter  payload.userId==args.userId; traitIsActiveRecord
  shape   agentAuthorizationFull
}

// queryAgentById - Get Agent by ID
// ==================================
//
// Retrieves an agent concept by its node ID. Returns the agent's
// configuration including name, personality, provider config,
// capabilities, and trigger behavior.

@enabled
@useConcept(agent)
@description("Get an agent by ID with full configuration.")
query queryAgentById {
  args {
    agentId  string  @required
  }
  filter  id==args.agentId
  shape   agentFull
}

// queryAgentOwner -- agent's owning-user lookup
// ==============================================
//
// Returns the v1:agents:agent row projected through agentFull,
// which exposes BOTH `agent.ownerUserId` and `createdBy`. Callers
// (resolveAgentOwner in app/computer_use_status_agent.go and
// resolveOwnerForAgent in integrations/agent/replier.go) read
// ownerUserId first and fall back to createdBy.

@enabled
@useConcept(agent)
@description("Resolve an agent's owning-user (ownerUserId / createdBy) by id.")
query queryAgentOwner {
  args {
    agentId  string  @required
  }
  filter  id==args.agentId
  shape   agentFull
}

// agentRoleSlugsInUse - Query roleSlugs already taken by an agent
// ================================================================
//
// Returns the list of `agent.roleSlug` values currently in use by
// non-deleted agents in the partition. Used by create-agent UIs to
// filter out already-taken roles from role pickers.

@enabled
@useConcept(agent)
@description("Returns the roleSlug values currently occupied by non-deleted agents in this partition. Used by the create-agent UI to filter out already-taken roles.")
query queryAgentRoleSlugsInUse {
  filter  traitIsActiveRecord; traitIsNotDeleted
  shape   agentRoleSlugLite
}

// allAgents - Query All AI Agent Templates
// ==========================================
//
// Returns all AI agent templates from the v1:agents:agent concept,
// regardless of active status. Backs the Cockpit Agents tab and any
// agent-management surface that needs to see active + inactive rows.

@enabled
@useConcept(agent)
@description("Returns all AI agent templates regardless of active status.")
query queryAllAgents {
  filter  traitIsNotDeleted
  shape   agentFull
}

@enabled
@useConcept(agent)
@description("Per Q10 layered dedupe Layer 1: list every active agent owned by a user (any roleSlug, any space scope). The Planner Agent's createSpecialist decision feeds this list into the similarity check before proposing a new agent. Platform-infrastructure agents (payload.kind=='system' -- MemQL Planner, MemQL Trainer) are returned by this query and filtered out structurally by loadExistingAgents in integrations/agents/factory.go before they enter the dedupe candidate pool; the filter lives one layer up rather than in the query so the same query can serve other callers that legitimately need system rows.")
query queryActiveAgentsForUser {
  args {
    ownerUserId  string  @required
  }
  filter  payload.ownerUserId==args.ownerUserId; traitIsActiveRecord; traitIsNotDeleted
  shape   agentMinimalForDedupe
}

@enabled
@useConcept(agentRole)
@description("Resolve a single agentRole row by its slug. Used by the role catalog seeder (idempotency check) and by the agent-creation path (look up the locked + default sets when materializing a new agent for the slug).")
query queryAgentRoleBySlug {
  args {
    slug  string  @required
  }
  filter  payload.slug==args.slug; traitIsActiveRecord
  shape   agentRoleFull
}

@enabled
@useConcept(agentRole)
@description("List every active agentRole row. Backs the role picker on the cockpit's agent-creation surface and on the role-management view. predefined rows render with a lock icon; user-created rows are fully editable.")
query queryActiveAgentRoles {
  filter  traitIsActiveRecord
  shape   agentRoleFull
}
