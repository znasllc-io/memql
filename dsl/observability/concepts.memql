// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. This domain
// houses the runtime side of the architecture framework: live
// configuration of the observe runtime, the per-call invocation
// hypertable surface, and continuous-aggregate-backed metric
// rollups. See component/observe/ for the Go runtime that emits
// against these concepts and docs/architecture/observability.md
// (forthcoming) for the end-to-end picture.

use identity.concepts.{ user }

/// Live per-function observability configuration. Created on demand: a function only has a
/// codeProfile row when someone wanted to set a non-default level on it (incident response, hot
/// path under investigation, etc.). Resolution at call time is codeProfile -> MEMQL_OBSERVE_LEVEL
/// default -> off. Keyed by codeReference, which matches the model.Node.ID for the Method or Func
/// node in topology.model.json (e.g.
/// 'method:github.com/znasllc-io/memql/component/auth.(*Handler).Login'). Cockpit writes these from
/// the drill-down 'bump verbosity for this method' control; the observe runtime reads them through
/// a CDC-driven cache.
concept codeProfile {
  codeReference  string!  @description("Fully-qualified node id from the architecture model. Format documented in component/architecture/model/ids.go. The single join key shared by static topology, live profile, raw invocations, and aggregate metrics.")
  level          enum("off", "count", "meta", "verbose")!  @default("off")  @description("Capture verbosity. off = not instrumented. count = duration + error only. meta = + arg types/sizes. verbose = + full arg/return values, subject to redaction.")
  sampleRate     float  @description("Fraction of calls to capture at the chosen level. 1.0 = every call (verbose locally / on incident). 0.01 = 1% (verbose-in-prod sampling). The runtime's PRNG draws once per call. Convention: 1.0 -- NOT applied on insert, and no mutation is bound to this concept, so a writer must supply it; an absent value reads as 0.0, which captures nothing.")
  retentionDays  int  @description("How long the resulting code_invocation hypertable rows survive before the retention policy drops them. Aggregates (codeMetric rollups) outlive this -- the trendline is preserved, the forensic detail is short-lived. Convention: 7 -- NOT applied on insert, and no mutation is bound to this concept, so a writer must supply it.")
  redactArgs     []string  @description("Names of arguments to force-redact regardless of value. The default redact-by-name pattern catches obvious cases (pass*, token*, secret*); use this to pin individual params that don't match the pattern. NOTE: a //memql:observe source marker on the function declares the SAFE list (its inverse); when both exist, redactArgs here wins.")
  reason         string  @description("Free-text rationale for non-default levels. Surfaces in the cockpit list view so you can audit 'why is this method being captured at verbose?' at a glance. Example: 'INC-2026-05-14 -- intermittent 500s.")
  setBy          string  @description("v1:identity:user.id of the user who applied this profile. Empty for env-bootstrapped rows.")
  expiresAt      datetime  @description("Optional automatic-off timestamp. The codeProfileExpiry cron flips level back to 'off' when now > expiresAt. Lets the cockpit say 'bump to verbose for the next hour' without leaking a hot-path tap into the steady state.")

  @relationship(type="parent", field="setBy", target=user, direction="outgoing")
}

/// One captured invocation of a Method or Func. Backed by the code_invocation TimescaleDB
/// hypertable (see scripts/dev/migrations/observability/); rows are time-partitioned,
/// jsonb-compressed after 24h, and dropped per codeProfile.retentionDays. The mutation surface goes
/// through the engine like any other concept so the engine's auth + partition middleware applies
/// uniformly, but the read path on the hot drill-down view is intended to use the continuous
/// aggregates (codeMetric) rather than these raw rows. Hand-querying invocation rows directly is
/// fine for forensic 'last 20 calls to X' lookups.
concept invocation {
  codeReference  string!  @description("Fully-qualified node id of the Method/Func that ran. Join key shared with codeProfile and codeMetric.")
  occurredAt     datetime!  @description("Wall-clock time when the call started. The hypertable time column.")
  durationNs     int!  @description("End - start in nanoseconds. Recorded as an integer to keep the column type SQL-friendly; cockpit renders as ms.")
  errorMessage   string  @description("Empty on success. Captures the error.Error() text the caller deferred-Read at End(). Truncated server-side at 4KB.")
  args           object  @description("Captured arguments shaped per codeProfile.level: count -> nil, meta -> name -> shape-string (e.g. 'string(len=42)'), verbose -> name -> value. Redacted entries appear as '<redacted>'. Authoritative redaction rules live in component/observe/helper.go.")
  result         object  @description("Captured return value at verbose level only; nil otherwise. Same redaction rules as args -- a Result tagged for redaction at the call site never lands here verbatim.")
  traceId        string  @description("Distributed-trace identifier when the caller's context carried one (set via observe.SetTraceExtractor). Lets the cockpit cross-link an invocation row to the corresponding span in any OTel-compatible viewer.")
  spanId         string  @description("Span id within traceId. Same source as traceId.")
  level          enum("count", "meta", "verbose")!  @description("Level the row was captured at. Echoed onto the record so a consumer reading the hypertable can tell 'this is a meta-level row, args are shape strings not values' without consulting the profile.")
}

/// Aggregate observability rollups for a code reference over a time window. Backed by TimescaleDB
/// continuous aggregates over the code_invocation hypertable -- callCount, p50/p95/p99 durations,
/// errorRate -- so the cockpit's drill-down sparkline can query the metric for any (codeReference,
/// kind, window) in O(few rows) regardless of how many raw invocations the function had. Aggregates
/// outlive raw rows: when codeProfile.retentionDays evicts the underlying invocation chunk, the
/// matching codeMetric rows for that chunk are preserved by the policy so the trendline stays
/// continuous.
concept codeMetric {
  codeReference  string!  @description("Fully-qualified node id. Same join key as codeProfile / invocation.")
  windowStart    datetime!  @description("Inclusive start of the aggregation window. Matches a TimescaleDB time_bucket boundary -- typically 1m or 1h aligned.")
  windowEnd      datetime!  @description("Exclusive end. windowEnd - windowStart is the bucket size; cockpit reads bucket size from the difference rather than from a separate field.")
  bucket         enum("1m", "1h")!  @description("Bucket size identifier. Mirrors the continuous-aggregate view used to produce the row, kept as a field so consumers don't have to math out the diff.")
  callCount      int!  @description("Number of invocations in [windowStart, windowEnd).")
  errorCount     int!  @default("0")  @description("Subset of callCount where errorMessage was non-empty.")
  errorRate      float  @description("Convenience: errorCount / callCount, populated by the materialization step. Consumers can compute it themselves if the row was hand-inserted.")
  p50DurationNs  int  @description("50th-percentile latency in nanoseconds across the bucket.")
  p95DurationNs  int  @description("95th-percentile latency.")
  p99DurationNs  int  @description("99th-percentile latency. Same scale as p50/p95.")
  totalDurationNs int  @description("Sum of all durations in the bucket. Lets cockpit show 'time spent in X' on the topology overlay without pulling raw rows.")
}
