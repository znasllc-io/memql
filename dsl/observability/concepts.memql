// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. This domain
// houses the runtime side of the architecture framework: live
// configuration of the observe runtime, the per-call invocation
// hypertable surface, and continuous-aggregate-backed metric
// rollups. See component/observe/ for the Go runtime that emits
// against these concepts and docs/architecture/observability.md
// (forthcoming) for the end-to-end picture.

use identity.concepts.{ user }

/// Live per-function observability configuration. Created on demand: a function only has a
/// codeProfile row when someone wanted to set a non-default level on it (incident response, hot
/// path under investigation, etc.). Resolution at call time is codeProfile -> MEMQL_OBSERVE_LEVEL
/// default -> off. Keyed by codeReference, which matches the model.Node.ID for the Method or Func
/// node in topology.model.json (e.g.
/// 'method:github.com/znasllc-io/memql/component/auth.(*Handler).Login'). Cockpit writes these from
/// the drill-down 'bump verbosity for this method' control; the observe runtime reads them through
/// a CDC-driven cache.
@displayCard(primary="codeReference", secondary="reason", tertiary="setBy", status="level")
concept codeProfile {
  codeReference  string!  @description("Fully-qualified node id from the architecture model. Format documented in component/architecture/model/ids.go. The single join key shared by static topology, live profile, raw invocations, and aggregate metrics.")
  level          enum("off", "count", "meta", "verbose")!  @default("off")  @description("Capture verbosity. off = not instrumented. count = duration + error only. meta = + arg types/sizes. verbose = + full arg/return values, subject to redaction.")
  sampleRate     float  @description("Fraction of calls to capture at the chosen level. 1.0 = every call (verbose locally / on incident). 0.01 = 1% (verbose-in-prod sampling). The runtime's PRNG draws once per call. Convention: 1.0 -- NOT applied on insert, and no mutation is bound to this concept, so a writer must supply it; an absent value reads as 0.0, which captures nothing.")
  retentionDays  int  @description("How long the resulting code_invocation hypertable rows survive before the retention policy drops them. Aggregates (codeMetric rollups) outlive this -- the trendline is preserved, the forensic detail is short-lived. Convention: 7 -- NOT applied on insert, and no mutation is bound to this concept, so a writer must supply it.")
  redactArgs     []string  @description("Names of arguments to force-redact regardless of value. The default redact-by-name pattern catches obvious cases (pass*, token*, secret*); use this to pin individual params that don't match the pattern. NOTE: a //memql:observe source marker on the function declares the SAFE list (its inverse); when both exist, redactArgs here wins.")
  reason         string  @description("Free-text rationale for non-default levels. Surfaces in the cockpit list view so you can audit 'why is this method being captured at verbose?' at a glance. Example: 'INC-2026-05-14 -- intermittent 500s.")
  setBy          string  @description("v1:identity:user.id of the user who applied this profile. Empty for env-bootstrapped rows.")
  expiresAt      datetime  @description("Optional automatic-off timestamp. The codeProfileExpiry cron flips level back to 'off' when now > expiresAt. Lets the cockpit say 'bump to verbose for the next hour' without leaking a hot-path tap into the steady state.")

  @relationship(type="parent", field="setBy", target=user, direction="outgoing")
}

/// One captured invocation of a Method or Func. Backed by the code_invocation TimescaleDB
/// hypertable (see scripts/dev/migrations/observability/); rows are time-partitioned,
/// jsonb-compressed after 24h, and dropped per codeProfile.retentionDays. The mutation surface goes
/// through the engine like any other concept so the engine's auth + partition middleware applies
/// uniformly, but the read path on the hot drill-down view is intended to use the continuous
/// aggregates (codeMetric) rather than these raw rows. Hand-querying invocation rows directly is
/// fine for forensic 'last 20 calls to X' lookups.
@displayCard(primary="codeReference", secondary="occurredAt", tertiary="durationNs", status="level")
concept invocation {
  codeReference  string!  @description("Fully-qualified node id of the Method/Func that ran. Join key shared with codeProfile and codeMetric.")
  occurredAt     datetime!  @description("Wall-clock time when the call started. The hypertable time column.")
  durationNs     int!  @description("End - start in nanoseconds. Recorded as an integer to keep the column type SQL-friendly; cockpit renders as ms.")
  errorMessage   string  @description("Empty on success. Captures the error.Error() text the caller deferred-Read at End(). Truncated server-side at 4KB.")
  arguments      object  @description("Captured arguments shaped per codeProfile.level: count -> nil, meta -> name -> shape-string (e.g. 'string(len=42)'), verbose -> name -> value. Redacted entries appear as '<redacted>'. Authoritative redaction rules live in component/observe/helper.go. Spelled out in full because `args` is a reserved engine namespace and cannot be a payload property (memql#3613); the backing column is still code_invocation.args.")
  result         object  @description("Captured return value at verbose level only; nil otherwise. Same redaction rules as arguments -- a Result tagged for redaction at the call site never lands here verbatim.")
  traceId        string  @description("Distributed-trace identifier when the caller's context carried one (set via observe.SetTraceExtractor). Lets the cockpit cross-link an invocation row to the corresponding span in any OTel-compatible viewer.")
  spanId         string  @description("Span id within traceId. Same source as traceId.")
  level          enum("count", "meta", "verbose")!  @description("Level the row was captured at. Echoed onto the record so a consumer reading the hypertable can tell 'this is a meta-level row, args are shape strings not values' without consulting the profile.")
}

/// Aggregate observability rollups for a code reference over a time window. Backed by TimescaleDB
/// continuous aggregates over the code_invocation hypertable -- callCount, p50/p95/p99 durations,
/// errorRate -- so the cockpit's drill-down sparkline can query the metric for any (codeReference,
/// kind, window) in O(few rows) regardless of how many raw invocations the function had. Aggregates
/// outlive raw rows: when codeProfile.retentionDays evicts the underlying invocation chunk, the
/// matching codeMetric rows for that chunk are preserved by the policy so the trendline stays
/// continuous.
@displayCard(primary="codeReference", secondary="windowStart", tertiary="callCount", status="bucket")
concept codeMetric {
  codeReference  string!  @description("Fully-qualified node id. Same join key as codeProfile / invocation.")
  windowStart    datetime!  @description("Inclusive start of the aggregation window. Matches a TimescaleDB time_bucket boundary -- typically 1m or 1h aligned.")
  windowEnd      datetime!  @description("Exclusive end. windowEnd - windowStart is the bucket size; cockpit reads bucket size from the difference rather than from a separate field.")
  bucket         enum("1m", "1h")!  @description("Bucket size identifier. Mirrors the continuous-aggregate view used to produce the row, kept as a field so consumers don't have to math out the diff.")
  callCount      int!  @description("Number of invocations in [windowStart, windowEnd).")
  errorCount     int!  @default("0")  @description("Subset of callCount where errorMessage was non-empty.")
  errorRate      float  @description("Convenience: errorCount / callCount, populated by the materialization step. Consumers can compute it themselves if the row was hand-inserted.")
  p50DurationNs  int  @description("50th-percentile latency in nanoseconds across the bucket.")
  p95DurationNs  int  @description("95th-percentile latency.")
  p99DurationNs  int  @description("99th-percentile latency. Same scale as p50/p95.")
  totalDurationNs int  @description("Sum of all durations in the bucket. Lets cockpit show 'time spent in X' on the topology overlay without pulling raw rows.")
}

/// One persisted log line from any node type or from the MemQL OS front end
/// (epic memql#4893). Backed by the log_line TimescaleDB hypertable
/// (component/database/memory-nodes/migrations/20260903000000_log_line_hypertable),
/// written by the store sink core/logger installs beside every node's console
/// handler and by logsRecordClient for OS lines, and NEVER a graph row: like
/// invocation, this concept declares the table's shape and nothing maps a
/// field to a column. Rows are read through the @sdk builtins in
/// builtins.memql (logsSearch, logsTail, logsSources), all floored at admin
/// in their Go handlers, which is why the concept declares no row tier --
/// no row of it ever passes graph admission. Retention is the nightly
/// logsRetentionSweep automation: archive to blob storage first, delete
/// second, thirty days by MEMQL_LOGS_RETENTION_DAYS. `subject` plus
/// `subjectConcept` is the one seam between a line and the thing it is about
/// (a deployment, a site, a plan); logger.Subject stamps both. Design:
/// docs/superpowers/specs/2026-09-03-logs-design.md.
@displayCard(primary="message", secondary="component", tertiary="node", status="level")
concept logLine {
  occurredAt      datetime!  @description("When the line was written. The hypertable time column; createdAt on the wire.")
  nodeType        enum("identity", "bff", "agent", "planner", "workbench", "mcp", "edge", "os")!  @description("Which kind of process wrote it. `os` is the MemQL OS front end, whose lines arrive through logsRecordClient.")
  node            string  @description("MEMQL_NODE_ID of the writing replica (the pod name). Blank for an OS line, which has no node.")
  level           enum("debug", "info", "warn", "error")!  @description("The slog level. `debug` persists only on a node whose MEMQL_LOGS_LEVEL says so.")
  component       string!  @description("The logger's component attribute, dotted parent.child (`edge`, `packages.pipeline`). An OS line carries `os.<app>` or `os.shell`.")
  app             string  @description("The OS app id for an OS line (`files`, `deployables`); blank for an engine line. The per-app Logs section selects on it.")
  message         string!  @description("The line's message, capped at 4 KiB.")
  attributes      object  @description("Every other attribute the line carried, already through the console redactor, keys dotted for groups. Never holds a `payload` or `body` key: those are redacted before they get here.")
  subject         string  @description("Bare id of what the line is about -- a deployment, a site, a plan -- stamped by logger.Subject. Blank when the line is about nothing in particular.")
  subjectConcept  string  @description("The concept id of `subject` (`v1:platform:site`). An app's slice of the store is `app` OR any of the concepts the app owns.")
  session         string  @description("The OS tab session that wrote an OS line (`os-<shortId>`, minted once per tab and kept in sessionStorage). A correlation key, never an authority; blank for an engine line.")
  userId          string  @serverSet  @description("v1:identity:user.id of the person whose browser wrote an OS line, stamped server-side from the actor and never accepted from the caller. Blank for an engine line.")

  @relationship(type="references", as="recordedBy", field="userId", target=user, direction="outgoing")
}

/// One bucket of one deployable's traffic, folded from the edge's request log (epic memql#4906,
/// the Run epic of the Deployables program). A DECLARATION OF A RELATION'S SHAPE, the `invocation`
/// and `codeMetric` precedent: rows live in the edge_request_1m / _1h aggregates TimescaleDB
/// maintains, never in the graph, and reach a client as synthetic nodes from `siteTrafficInWindow`.
/// Nothing maps a field here to a column; the mapping is component/sitetraffic's.
///
/// AN ABSENT ROW IS THE UNMEASURED ANSWER. A window nothing recorded produces NO ROW for that
/// deployable, and a window with requests and no errors produces a row whose errorCount is 0 --
/// "nobody visited" and "we were not recording" send a person to two different places, which is
/// the same rule campaignStats states about a unique-open count it could not measure.
///
/// windowEnd - windowStart says whether a row is a BUCKET or a SUMMARY: a bucket's span is the
/// bucket size and a summary's is the window the caller asked for. Read the span rather than
/// looking for a flag, which is codeMetric's own convention.
@displayCard(primary="siteId", secondary="bucket", tertiary="windowStart", status="bucket")
concept siteTraffic {
  siteId            string!  @description("The v1:platform:site this traffic belongs to, as a BARE id -- what the edge stamped on the rows and what a client sends. Authorization is this deployable's own: a caller reads its traffic exactly when they may read it, checked through siteById / sitesAll under their actor.")
  bucket            enum("1m", "1h")!  @description("Which aggregate the row came from. A minute bucket answers an hour-long window; an hour bucket answers a day or a week, because a week of minute buckets is ten thousand rows to draw one line.")
  windowStart       datetime!  @description("Inclusive start of the row's window, aligned to the bucket boundary for a bucket row and to the caller's own window for a summary row.")
  windowEnd         datetime!  @description("Exclusive end. Half-open, so two adjacent windows add up rather than double-counting the instant they share.")
  requestCount      int!  @description("Requests the edge served for this deployable in the window, whatever the outcome -- including the ones it refused to serve because the deployable was paused or in draft. A request to a deployable is a request to it.")
  errorCount        int!  @description("The 5xx subset: the deployable failing. Counted apart from clientErrorCount because folding the two together makes a healthy site with a broken inbound link look unhealthy.")
  clientErrorCount  int!  @description("The 4xx subset: somebody asking for a page this deployable does not have. Worth showing beside the 5xx count and never instead of it.")
  bytesTotal        int!  @description("Response bytes served in the window, as counted through the edge's own writer. A hijacked connection (a WebSocket through the API proxy) contributes 0, because its bytes leave through the raw connection -- an undercount that is named rather than guessed at.")
  lastServedAt      datetime  @description("The newest request in the window. ABSENT rather than zero when the relation answered no timestamp: a zero datetime renders as the year 1, which is a worse answer than none.")
}
