// Per-construct DSL layout: every <kind>s.memql file in a domain holds
// every construct of that kind in the domain. The builtins here are the
// whole read and write surface of the log store (epic memql#4893): the
// v1:observability:logLine concept is backed by a dedicated hypertable
// that no DSL query can reach, so each read is a Go-served builtin -- the
// dataOrigins / modelCatalog pattern -- returning logLine rows, and the one
// client write is a builtin because a bare mutation has no seam for a cap
// or a rate limit. Every read is floored at admin (owner, developer, admin
// under the one ladder) and the two archive acts at owner -- IN THE GO
// HANDLER, the integrationConfigure precedent, because a builtin carries no
// @requiresRank (its annotation set is closed: @alias, @args, @description,
// @disabled, @enabled, @executor, @sdk). Executors live in component/logstore. Design: docs/superpowers/specs/2026-09-03-logs-design.md.

@description("Lines inside [windowStart, windowEnd), newest first, narrowed by every facet given. `apps` and `subjectConcepts` together form ONE scope predicate ORed -- an app's slice is 'lines tagged with me OR about the things I own' -- and every other facet ANDs. `text` is a case-insensitive substring of the message. Keyset-paged: pass the oldest row's occurredAt and id back as beforeAt and beforeId for the next page. `limit` defaults to 200 and is capped at 500. Admin and above; the handler repeats the floor.")
@sdk
@executor("integration.logs.search")
builtin logsSearch {
  windowStart      datetime!  @description("Inclusive start of the window (RFC 3339).")
  windowEnd        datetime!  @description("Exclusive end of the window (RFC 3339).")
  nodeTypes        []string   @description("Node types to include (identity, bff, ..., os). Empty means every node type.")
  nodes            []string   @description("Node ids to include. Empty means every node.")
  components       []string   @description("Component names to include, exact. Empty means every component.")
  apps             []string   @description("OS app ids; ORed with subjectConcepts into the scope predicate.")
  levels           []string   @description("Levels to include (debug, info, warn, error). Empty means every level.")
  subject          string     @description("Only lines about this bare id.")
  subjectConcept   string     @description("Only lines whose subject is of this concept, used with `subject` to disambiguate.")
  subjectConcepts  []string   @description("Concept ids an app owns; ORed with `apps` into the scope predicate.")
  session          string     @description("Only lines from this OS tab session.")
  userId           string     @description("Only OS lines written by this user.")
  text             string     @description("Case-insensitive substring of the message.")
  limit            int        @description("Rows per page: 1 to 500, default 200.")
  beforeAt         datetime   @description("Keyset cursor: the occurredAt of the oldest row already seen.")
  beforeId         string     @description("Keyset cursor: the id of that row.")
}

@description("The live tail: lines newer than a keyset cursor, OLDEST first so a client appends, narrowed by the same facets as logsSearch (the same scope rule for `apps` and `subjectConcepts`). With no cursor it answers the newest `limit` lines in ascending order -- the baseline a stream starts from after any facet change. Poll it with the newest row's occurredAt and id as afterAt and afterId; an empty answer is 'nothing new', never an error. `limit` defaults to 200 and is capped at 500. Admin and above.")
@sdk
@executor("integration.logs.tail")
builtin logsTail {
  nodeTypes        []string   @description("Node types to include. Empty means every node type.")
  nodes            []string   @description("Node ids to include. Empty means every node.")
  components       []string   @description("Component names to include, exact.")
  apps             []string   @description("OS app ids; ORed with subjectConcepts into the scope predicate.")
  levels           []string   @description("Levels to include. Empty means every level.")
  subject          string     @description("Only lines about this bare id.")
  subjectConcept   string     @description("Only lines whose subject is of this concept.")
  subjectConcepts  []string   @description("Concept ids an app owns; ORed with `apps`.")
  session          string     @description("Only lines from this OS tab session.")
  userId           string     @description("Only OS lines written by this user.")
  text             string     @description("Case-insensitive substring of the message.")
  limit            int        @description("Rows per answer: 1 to 500, default 200.")
  afterAt          datetime   @description("Keyset cursor: the occurredAt of the newest row already seen.")
  afterId          string     @description("Keyset cursor: the id of that row.")
}

@description("What logged inside [windowStart, windowEnd): one row per distinct component, per (nodeType, node) and per OS app, each with its line count. The facet lists in the Logs app come from here, so a value that never logged in the window is never offered, and the portal -- which is not instrumented and has no component name -- is absent by construction rather than by a list. Admin and above.")
@sdk
@executor("integration.logs.sources")
builtin logsSources {
  windowStart  datetime!  @description("Inclusive start of the window (RFC 3339).")
  windowEnd    datetime!  @description("Exclusive end of the window (RFC 3339).")
}

@description("What this cluster keeps: the retention in days, whether an archive is configured and which container, the store level and the per-second cap on the answering node, the lines written and dropped (by reason) since that node started, and the oldest and newest occurredAt in the store with an estimated row count. One row. Admin and above.")
@sdk
@executor("integration.logs.status")
builtin logsStatus {
}

@description("Record lines from the MemQL OS front end: window errors, unhandled rejections and console warnings, batched by the shell. Every line is stamped nodeType=os, node blank, and userId from the caller's actor -- never from the payload -- so a line can never claim to be somebody else's. `session` is the tab's own correlation id (4 to 64 URL-safe characters). Refused WHOLE with a sentence when a call carries more than 50 lines, a message over 4 KiB or attributes over 8 KiB, and with reason `rate_limited` when the (user, session) bucket -- 120 lines, refilled two per second -- is empty; the shell drops and counts rather than retrying. A client `at` within five minutes of the node clock is kept, one outside it is replaced. Any signed-in principal may call it; an anonymous or connector actor is refused. Answers { accepted, dropped, reason }.")
@sdk
@executor("integration.logs.recordClient")
builtin logsRecordClient {
  session  string!    @description("The tab session id the shell minted (`os-<shortId>`).")
  lines    []object!  @description("Up to 50 of { at, level, app, component, message, attributes, subject, subjectConcept }. `level` and `message` are required per line.")
}

@description("Run the retention sweep now: archive every expired UTC day per node type as logs/<day>/<nodeType>.ndjson.gz in MEMQL_LOGS_ARCHIVE_CONTAINER, then delete that day; at most sixty days per run. NO ARCHIVE, NO DELETE: with no container configured the sweep keeps every line and says so in its own log line. A second sweep while one runs answers skipped. The nightly logsRetentionSweep automation calls this on the cron leader; an owner may call it by hand. Answers { daysArchived, rowsArchived, rowsDeleted, skipped, refused }.")
@sdk
@executor("integration.logs.sweep")
builtin logsSweep {
}

@description("The archived days: one row per logs/<day>/<nodeType>.ndjson.gz object in the archive container with its size, newest day first. Empty when no archive is configured, and the row says which. Admin and above.")
@sdk
@executor("integration.logs.archiveList")
builtin logsArchiveList {
}

@description("Bring an archived day back into the store: download logs/<day>/<nodeType>.ndjson.gz (every node type of the day when nodeType is blank), gunzip, and insert the rows with ON CONFLICT DO NOTHING on (occurredAt, id), so running it twice restores nothing twice. A restored day is older than the retention boundary by definition and is swept again at the next nightly run; read it now. Owner only. Answers { restored, skipped, objects }.")
@sdk
@executor("integration.logs.archiveRestore")
builtin logsArchiveRestore {
  day       string!  @description("The UTC day, YYYY-MM-DD.")
  nodeType  string   @description("One node type, or blank for every node type archived that day.")
}
