// shapes.memql
//
// Shapes for the planner domain. Moved here from
// memql-bff-copresent/dsl/copresent/shapes.memql on 2026-05-17 as
// part of the "all plan / task DSL belongs in core" cleanup -- the
// planner is a node type (build tag planner, see app/integrations_planner_init.go)
// and its data shapes have to be uniformly available on every binary
// that loads concepts, not just on the copresent BFF.

@row
@useConcept(plan)
@description("Comprehensive plan projection for the Tasks page row, the plan.created / plan.completed canvas cards, and the planner's own routing decisions. Carries every Plan field including lifecycle timestamps, the per-kind input/output blobs, and the token + estimate accounting the Tasks page progress strips read.")
shape planFull {
  row.id
  plan.spaceId
  plan.kind
  plan.status
  plan.goal
  plan.ownerAgentId
  plan.requestedBy
  plan.input
  plan.output
  plan.errorMessage
  plan.startedAt
  plan.completedAt
  plan.cancelledBy
  plan.phases
  plan.estimate
  plan.estimatedAt
  plan.tokenBudget
  plan.tokenSpent
  plan.tokenAllocatedToChildren
  plan.tokenCapDisabled
  plan.parentPlanId
  plan.retryThreshold
  row.createdAt
  row.createdBy
}

@row
@useConcept(task)
@description("Comprehensive task projection for the Tasks page expand-drawer (which lists Tasks under a Plan) and the planner's per-Task lifecycle automations. Carries the metrics rollup (tokensSpent, llmCallCount, toolCallCount, modelBreakdown[]) so per-task token cost surfaces in the cockpit's planner detail pane.")
shape taskFull {
  row.id
  task.planId
  task.category
  task.parentTaskId
  task.kind
  task.logicalStepId
  task.attemptNumber
  task.toolName
  task.toolArgs
  task.toolResult
  task.status
  task.seq
  task.phase
  task.executionSurface
  task.executorBackend
  task.input
  task.output
  task.metrics
  task.errorMessage
  task.startedAt
  task.completedAt
  task.parkedAt
  task.parkedAtCheckpoint
  row.createdAt
  row.createdBy
}

@row
@useConcept(taskState)
@description("TaskState projection. Used by the planner to bootstrap an agent's resume context after a paused / awaitingFeedback Task is resumed.")
shape taskStateFull {
  row.id
  taskState.taskId
  taskState.workingMemory
  taskState.reasoningChain
  taskState.toolCallHistory
  taskState.pendingSubPlanIds
  row.createdAt
}
