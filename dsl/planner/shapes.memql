// shapes.memql
//
// Shapes for the planner domain. Moved here from
// memql-bff-copresent/dsl/copresent/shapes.memql on 2026-05-17 as
// part of the "all plan / task DSL belongs in core" cleanup -- the
// planner is a node type (build tag planner, see app/integrations_planner_init.go)
// and its data shapes have to be uniformly available on every binary
// that loads concepts, not just on the copresent BFF.

use planner.concepts.{ plan, task, taskState, responsibility }

@row
@description("Comprehensive plan projection for the Tasks page row, the plan.created / plan.completed canvas cards, and the planner's own routing decisions. Carries every Plan field including lifecycle timestamps, the per-kind input/output blobs, and the token + estimate accounting the Tasks page progress strips read.")
shape plan planFull {
  row.id
  payload.spaceId
  payload.kind
  payload.status
  payload.goal
  payload.ownerAgentId
  payload.requestedBy
  payload.input
  payload.output
  payload.errorMessage
  payload.startedAt
  payload.completedAt
  payload.cancelledBy
  payload.phases
  payload.estimate
  payload.estimatedAt
  payload.tokenBudget
  payload.tokenSpent
  payload.tokenAllocatedToChildren
  payload.tokenCapDisabled
  payload.metrics
  payload.parentPlanId
  payload.retryThreshold
  row.createdAt
  row.createdBy
}

@row
@description("Comprehensive task projection for the Tasks page expand-drawer (which lists Tasks under a Plan) and the planner's per-Task lifecycle automations. Carries the metrics rollup (tokensSpent, llmCallCount, toolCallCount, modelBreakdown[]) so per-task token cost surfaces in the cockpit's planner detail pane.")
shape task taskFull {
  row.id
  payload.planId
  payload.category
  payload.parentTaskId
  payload.kind
  payload.logicalStepId
  payload.attemptNumber
  payload.toolName
  payload.toolArgs
  payload.toolResult
  payload.status
  payload.seq
  payload.phase
  payload.dependsOn
  payload.executionSurface
  payload.executorBackend
  payload.input
  payload.output
  payload.metrics
  payload.errorMessage
  payload.startedAt
  payload.completedAt
  payload.parkedAt
  payload.parkedAtCheckpoint
  row.createdAt
  row.createdBy
}

@row
@description("TaskState projection. Used by the planner to bootstrap an agent's resume context after a paused / awaitingFeedback Task is resumed.")
shape taskState taskStateFull {
  row.id
  payload.taskId
  payload.workingMemory
  payload.reasoningChain
  payload.toolCallHistory
  payload.pendingSubPlanIds
  row.createdAt
}

@row
@description("Comprehensive responsibility projection (epic #631). Carries every field across the reactive / standing / recurring archetypes -- trigger discriminator, schedule (recurring), condition (reactive), target binding (assistant / specialist / unassigned + assignedAgentId / assignedRoleSlug), scope pin, lifecycle status + enabled flag, and the lastEvaluatedAt / lastResult run bookkeeping the reactive-loop epic #632 consumes.")
shape responsibility responsibilityFull {
  row.id
  payload.ownerUserId
  payload.statement
  payload.trigger
  payload.schedule
  payload.condition
  payload.targetKind
  payload.assignedAgentId
  payload.assignedRoleSlug
  payload.successCriteria
  payload.notifyHow
  payload.scopeSpaceId
  payload.enabled
  payload.status
  payload.intakeStatus
  payload.intakeRequest
  payload.intakeResponse
  payload.lastEvaluatedAt
  payload.lastResult
  row.createdAt
  row.createdBy
}
