// prompts.memql
//
// Planner-namespace prompt declarations for the reactive loop
// (epic #632 / program #629). Bodies live in prompts/<name>.tmpl.
//
// The headline construct is reactiveConductor -- the convergence
// reasoning step (C4 / #641): given a user's space goals, their active
// responsibilities, and recent memory (recall), it answers "what should
// happen now?" and emits zero or more proactive actions. It is a
// LOGIC prompt (structured-output, not prose) -- the planner integration
// parses the JSON and dispatches each emitted action through the same
// Plan / assignment machinery the rest of the loop uses.

@defaultProvider("streamClaudeSonnet")
@templateFile("prompts/reactiveConductor.tmpl")
@description("Structured-output convergence prompt for the reactive-loop heartbeat (epic #632, C4 / #641). Given a single user's active space goals, their active responsibilities, and recent memory (recall), it decides what -- if anything -- should happen proactively right now. Sonnet, not Opus: the workload is pattern-matching goals against standing duties + recent state, not novel chain-of-thought. Output contract: {actions: [{kind, responsibilityId?, statement, rationale, confidence}], silentReason?}. kind in {createPlan, surfaceNudge, extendSpecialist, none}. Emitting an EMPTY actions list (with silentReason) is the correct, common output -- the loop stays silent when nothing is actionable. The planner integration applies a quiet/dedup guard on top so a confident-but-repetitive action does not spam the user.")
prompt reactiveConductor {
  user             object! @description("Compact identity of the user whose context this tick reasons over -- {userId}. Output actions are scoped to this user.")
  spaceGoals       []object          @description("Active space goals for the user -- [{partitionId, name, statement, timeframe}] drawn from v1:cognition:space.goal on the user's active spaces. The direction the user is pursuing; empty when no space carries a goal.")
  responsibilities []object          @description("The user's active + enabled responsibilities -- [{id, statement, trigger, schedule, targetKind, assignedAgentId, lastEvaluatedAt, lastResult}]. The standing duties the convergence weighs against the goals. Empty when the user has none.")
  recentMemory     []object          @description("Top-k recent + relevant memories from recall() -- [{content, createdAt, _score}]. Grounds the decision in what just happened so the loop does not re-surface work already in flight or re-nudge something just handled.")
  now              string! @description("RFC3339 wall-clock at invocation. Lets the conductor reason about elapsed time, schedule windows, and quiet hours.")
}

@defaultProvider("chat54Mini")
@templateFile("prompts/goalComplexityTriage.tmpl")
@description("Goal complexity triage (epic #836 / #837; sectionable extension #1394). The CHEAP, first-pass classifier that runs BEFORE the expensive plannerAgent decompose loop on every goal-bearing Plan. It answers one question: is this goal a TRIVIAL single self-contained deliverable (e.g. 'a list of 10 birds', 'a haiku about the sea', 'a one-page markdown summary'), MODERATE (a few clear steps, an existing specialist, no research/training), or COMPLEX (multi-phase program, multiple specialists, research, or a durable reused capability). Trivial routes to ONE direct production turn -- NO decompose recursion, NO specialist creation, NO training -- which is the cost fix: a one-line deliverable must never trigger the Opus+thinking decompose loop. It ALSO surfaces whether a non-trivial deliverable is SECTIONABLE (#1394): one conceptually-simple deliverable made of INDEPENDENT sections (e.g. '10 folk tales, each a complete story') that can be produced concurrently and assembled -- the planner then GENERATES a parallel plan-automation instead of a serial decompose chain. Fast/cheap tier (chat54Mini) by design. Output contract: {complexity: 'trivial'|'moderate'|'complex', reasoning: '<one short sentence>', sectionable?: bool, assembly?: '<one sentence>', sections?: [{label, instruction}]}.")
prompt goalComplexityTriage {
  goal  string! @description("The user-stated goal driving the Plan, verbatim. The single most important input -- the classification is inferred from it.")
  now   string            @description("Optional RFC3339 wall-clock; opaque, never required.")
}
