// queries.memql
//
// Planner-namespace queries. Moved here from
// memql-bff-copresent/dsl/copresent/queries.memql on 2026-05-17 as
// part of the "all plan / task DSL belongs in core" cleanup -- the
// planner is a core node type (see app/integrations_planner_init.go,
// built with -tags planner) and its read surface has to be uniformly
// available on every binary that loads concepts.

// queryAllPlans
// =============
//
// Returns every Plan in the active partition, regardless of space.
// Backs the global Tasks panel (?panel=tasks) -- previously the panel
// was scoped to a single space via queryPlansForSpace, which made
// users miss work running in other spaces and confused the model
// "tasks belong to a space, not to the user." Tasks ARE global to
// the user's partition; the per-space pinning is a UI convenience,
// not a data boundary.
//
// Sort follows the concept default (newest first by createdAt). The
// frontend groups by status and sorts current-space rows to the top
// of each group at render time -- the backend stays simple.
//
// No arguments -- partition isolation comes from the request envelope.
//
// Returns: Array of plan records (planFull shape).

use planner.concepts.{ plan, task, taskState, responsibility }

// payload.spaceId!="" is the tautological row-matches-all predicate:
// spaceId is @required on the Plan concept, so every row passes. We
// can't use traitIsNotDeleted / traitIsActiveRecord because Plans
// don't carry the `deleted` or `active` fields those traits filter
// on.
@enabled
@description("Every Plan. Backs the global Tasks panel; the frontend pins current-space rows to the top of each lifecycle group.")
query plan queryAllPlans {
  filter  payload.spaceId!=""
  shape   planFull
}

@enabled
@description("Plans in awaitingFeedback whose feedbackRequest.timeoutAt is in the past. Backs feedbackTimeoutAutoPause.")
query plan queryAwaitingFeedbackPlansPastTimeout {
  filter  payload.status=="awaitingFeedback"; payload.feedbackRequest.timeoutAt < now()
  shape   planFull
}

// queryDueTrainAgentRetryPlans
// ============================
//
// Returns ALL queued trainAgentRetryStep Plans. The training
// integration's poll loop filters them in Go by
// input.nextAttemptAt < time.Now() before running each one.
//
// (We can't push the time filter into the query: memQL's comparison
// evaluator doesn't accept now() as a literal RHS -- TimestampExprFunc
// is unsupported in normalizeScalarValue. See
// component/memql/executor.go:1456. Keeping the filter in Go is
// fine because there are at most a handful of queued retry-Plans
// at a time -- the backoff schedule (5min / 30min / 2h) bounds the
// queue size to one row per failed step per training run, none of
// which is read-bound.)
//
// The poll loop wakes every 60s; this query result is therefore
// at most a one-row-per-failed-training-step set.

@enabled
@description("All queued trainAgentRetryStep Plans. The training poll loop filters by input.nextAttemptAt in Go.")
query plan queryDueTrainAgentRetryPlans {
  filter  payload.kind=="trainAgentRetryStep"; payload.status=="queued"
  shape   planFull
}

// queryHistoricalPlanMetrics
// ==========================
//
// Returns succeeded Plans of a given kind with their metrics rollup,
// scoped to a time window. Used by the estimation system to build
// the historical curve per (planKind) bucket.
//
// Estimation logic per Q5: blend the LLM heuristic seed with the
// historical curve weighted by sample size:
//   weight = min(1, sampleSize / N_threshold)
//   p50 = (1 - weight) * heuristic.p50 + weight * historical.p50
// Same for p90. As the bucket grows, the heuristic's contribution
// fades.

@enabled
@description("Succeeded Plans of a kind, with metrics, for estimation bucket queries.")
query plan queryHistoricalPlanMetrics {
  args {
    planKind  string  @required
  }
  filter  payload.kind==args.planKind; payload.status=="succeeded"
  shape   planFull
}

// queryPlanById
// =============
//
// Single Plan lookup. Used by the canvas card when it needs the
// latest Plan state for live status updates.
//
// Arguments:
//   planId (string, required) - The Plan id to fetch.
//
// Returns:
//   Single plan record (planFull shape) or empty array if missing.

@enabled
@description("Single Plan by id.")
query plan queryPlanById {
  args {
    planId  string  @required
  }
  filter  id==args.planId
  shape   planFull
}

// queryPlansForSpace
// ==================
//
// Returns every Plan in a space, regardless of status. The Tasks page
// groups client-side by status (Active / Done) and applies a visual
// filter for the Done window (default 7 days, per the v1 design).
// Sort order follows the concept default (newest first by createdAt);
// the frontend re-orders within each group as needed.
//
// Arguments:
//   spaceId (string, required) - The cognition space whose Plans to read.
//
// Returns:
//   Array of plan records (planFull shape).

@enabled
@description("All Plans in a space (Tasks page list). Frontend groups by status and applies the Done-window visual filter.")
query plan queryPlansForSpace {
  args {
    spaceId  string  @required
  }
  filter  payload.spaceId==args.spaceId
  shape   planFull
}

// queryRunningTrainAgentPlans
// ===========================
//
// Returns every Plan currently in `running` for kind `trainAgent`.
// Backs the Training Studio's "this agent is being trained right
// now" lock: the frontend filters the result by the agent slot's
// id (extracted from `plan.input.agentId` on each row) and
// disables Studio interactions when a match is found.
//
// Why no agentId filter on the server: memQL queries don't yet
// support nested-object paths like `plan.input.agentId` in the
// where clause -- the bound list of in-flight training Plans is
// at most a handful (one per concurrent training run across the
// tenant), so client-side filtering by agent is cheap.
//
// trainAgent's lifecycle is queued (millisecond window in
// beginPlan) -> running (the bulk of the ~90s pipeline) -> one of
// {succeeded, failed, cancelled}. We filter only on `running`
// because (a) the queued window is too short to matter for the
// lock, and (b) memQL has no OR operator so a single status
// filter is the cleanest path.

@enabled
@description("All currently-running trainAgent Plans across the tenant. Backs the Training Studio's per-agent in-flight lock; frontend filters by plan.input.agentId.")
query plan queryRunningTrainAgentPlans {
  filter  payload.kind=="trainAgent"; traitStatusIsRunning
  shape   planFull
}

@enabled
@description("Latest persisted state for a Task (planner reads this on resume).")
query plan queryTaskStateById {
  args {
    taskId  string  @required
  }
  filter  payload.taskId==args.taskId
  shape   taskStateFull
}

// queryTasksForPlan
// =================
//
// All Tasks belonging to a Plan, in seq order (the planner emits
// Tasks with monotonically increasing seq; v0.1 executes them
// sequentially). Used by the Tasks-page expand-drawer when a Plan
// row is clicked, and by the planner itself when checking whether
// the next Task is ready to start.
//
// Arguments:
//   planId (string, required) - The parent Plan id.
//
// Returns:
//   Array of task records (taskFull shape).

@enabled
@description("All Tasks for a Plan, in seq order.")
query taskState queryTasksForPlan {
  args {
    planId  string  @required
  }
  filter  payload.planId==args.planId
  shape   taskFull
}

// -----------------------------------------------------------------------------
// Responsibility reads (epic #631 / program #629).
//
// All three are owned-tier: the filter binds payload.ownerUserId to
// actor.userId server-side so a caller can only ever read their own
// directives -- cross-user reads are impossible. The reactive-loop
// epic #632 consumes queryDueResponsibilities.
// -----------------------------------------------------------------------------

// queryResponsibilitiesForUser
// ============================
//
// Every responsibility owned by the caller, regardless of status or
// trigger. Backs the settings / management surface where the user
// reviews and edits all their standing directives. The ownerUserId ==
// actor.userId predicate is the only gate -- no userId arg, so a
// caller can never request another user's rows.
@enabled
@description("Every responsibility owned by the caller (all statuses + triggers). Backs the management surface. The ownerUserId predicate binds to actor.userId server-side so cross-user reads are impossible.")
query responsibility queryResponsibilitiesForUser {
  filter  payload.ownerUserId==actor.userId
  shape   responsibilityFull
}

// queryActiveResponsibilities
// ===========================
//
// The caller's active, enabled directives -- the live working set the
// evaluator/dispatcher cares about. status=='active' is expressed via
// the traitStatusIsActive trait (inline payload.status=="active" is
// rejected by the conformance test). enabled==true filters out
// soft-disabled rows.
@enabled
@description("The caller's active + enabled responsibilities -- the live working set. Owned tier (ownerUserId == actor.userId). status filtered via traitStatusIsActive; enabled==true drops soft-disabled rows.")
query responsibility queryActiveResponsibilities {
  filter  payload.ownerUserId==actor.userId; traitStatusIsActive; payload.enabled==true
  shape   responsibilityFull
}

// queryDueResponsibilities
// ========================
//
// The candidate set the reactive-loop evaluator (epic #632) walks each
// heartbeat: the caller's active, enabled responsibilities that are
// either recurring (a cron schedule that may be due) or reactive (a
// condition pending evaluation). standing directives are always-on and
// don't need a due-check, so they're excluded here.
//
// Due-ness itself is NOT pushed into the filter. The MemQL comparison
// evaluator can't evaluate a cron expression against now(), and it has
// no OR operator to union the recurring + reactive sets in one query.
// So this query returns the bounded candidate set (active + enabled +
// trigger in {recurring, reactive}) and the Go evaluator does the
// cron-due check (recurring) and the condition-match check (reactive)
// per row -- mirroring queryDueTrainAgentRetryPlans, which returns
// queued retry-Plans and filters by nextAttemptAt in Go.
//
// Two passes because there's no OR: the evaluator calls this once per
// trigger value. trigger is a required arg so the caller picks the
// archetype; the recurring + reactive results are merged Go-side.
@enabled
@description("The caller's active + enabled responsibilities of a given trigger archetype (recurring or reactive) -- the candidate set the reactive-loop evaluator (epic #632) checks for due-ness. Owned tier (ownerUserId == actor.userId). Cron-due / condition-match filtering happens Go-side (no OR operator + no cron arithmetic in the filter), mirroring queryDueTrainAgentRetryPlans.")
query responsibility queryDueResponsibilities {
  args {
    trigger  string  @required  @enum("reactive", "recurring")
  }
  filter  payload.ownerUserId==actor.userId; traitStatusIsActive; payload.enabled==true; payload.trigger==args.trigger
  shape   responsibilityFull
}

// queryResponsibilityById
// =======================
//
// Single responsibility lookup by id. Used by the intake dispatcher
// (issue #637 -- integrations/planner/responsibility_intake.go) to load
// the row it is processing, and by the management UI for a live single-
// row refresh. Filters on id only (system reads it under system:planner);
// per-row authz on the human-facing read paths stays on
// queryResponsibilitiesForUser, which owner-scopes. Mirrors queryPlanById.
@enabled
@description("Single v1:planner:responsibility by id. Used by the intake dispatcher (#637) and the management UI's single-row refresh. Filters on id only -- mirrors queryPlanById; the owner-scoped list reads stay on queryResponsibilitiesForUser.")
query responsibility queryResponsibilityById {
  args {
    responsibilityId  string  @required
  }
  filter  id==args.responsibilityId
  shape   responsibilityFull
}
