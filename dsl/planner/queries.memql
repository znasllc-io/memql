// queries.memql
//
// Planner-namespace queries. Moved here from the product pack's
// queries file (in the carrier repo) on 2026-05-17 as
// part of the "all plan / task DSL belongs in core" cleanup -- the
// planner is a core node type (see app/integrations_planner_init.go,
// built with -tags planner) and its read surface has to be uniformly
// available on every binary that loads concepts.

// allPlans
// =============
//
// Returns every Plan in the active partition, regardless of space.
// Backs the global Tasks panel (?panel=tasks) -- previously the panel
// was scoped to a single space via plansForSpace, which made
// users miss work running in other spaces and confused the model
// "tasks belong to a space, not to the user." Tasks ARE global to
// the user's partition; the per-space pinning is a UI convenience,
// not a data boundary.
//
// Sort follows the concept default (newest first by createdAt). The
// frontend groups by status and sorts current-space rows to the top
// of each group at render time -- the backend stays simple.
//
// No arguments -- partition isolation comes from the request envelope.
//
// Returns: Array of plan records (planFull shape).

// payload.partitionId!="" is the tautological row-matches-all predicate:
// partitionId is @required on the Plan concept, so every row passes. We
// can't use isNotDeleted / isActiveRecord because Plans
// don't carry the `deleted` or `active` fields those traits filter
// on.
/// Every Plan. Backs the global Tasks panel; the frontend pins current-space rows to the top of
/// each lifecycle group.
query plan allPlans {
  filter  partitionId!=""
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   planFull
}

/// Plans in awaitingFeedback whose feedbackRequest.timeoutAt is in the past. Backs
/// feedbackTimeoutAutoPause.
@unbounded("feedback-timeout auto-pause cron sweep -- an internal sweep that must see all")
query plan awaitingFeedbackPlansPastTimeout {
  filter  status=="awaitingFeedback" && feedbackRequest.timeoutAt < now
  shape   planFull
}

/// Plans still in a pre-dispatch status (planning / queued). Backs the stranded-plan watchdog
/// (memql#1389); the age + dedup check runs Go-side.
@unbounded("stranded-plan recovery sweep -- an internal sweep that must see all")
query plan strandedCandidatePlans {
  filter  status in ["planning", "queued"]
  shape   planFull
}

// historicalPlanMetrics
// ==========================
//
// Returns succeeded Plans of a given kind with their metrics rollup,
// scoped to a time window. Used by the estimation system to build
// the historical curve per (planKind) bucket.
//
// Estimation logic per Q5: blend the LLM heuristic seed with the
// historical curve weighted by sample size:
//   weight = min(1, sampleSize / N_threshold)
//   p50 = (1 - weight) * heuristic.p50 + weight * historical.p50
// Same for p90. As the bucket grows, the heuristic's contribution
// fades.

/// Succeeded Plans of a kind, with metrics, for estimation bucket queries.
query plan historicalPlanMetrics {
  args {
    planKind  string!
  }
  filter  kind==args.planKind && status=="succeeded"
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   planFull
}

// planById
// =============
//
// Single Plan lookup. Used by the canvas card when it needs the
// latest Plan state for live status updates.
//
// Arguments:
//   planId (string, required) - The Plan id to fetch.
//
// Returns:
//   Single plan record (planFull shape) or empty array if missing.

/// Single Plan by id.
query plan planById {
  args {
    planId  string!
  }
  filter  id==args.planId
  shape   planFull
}

// plansForSpace
// ==================
//
// Returns every Plan in a space, regardless of status. The Tasks page
// groups client-side by status (Active / Done) and applies a visual
// filter for the Done window (default 7 days, per the v1 design).
// Sort order follows the concept default (newest first by createdAt);
// the frontend re-orders within each group as needed.
//
// Arguments:
//   partitionId (string, required) - The cognition space whose Plans to read.
//
// Returns:
//   Array of plan records (planFull shape).

/// All Plans in a space (Tasks page list). Frontend groups by status and applies the Done-window
/// visual filter.
query plan plansForSpace {
  args {
    partitionId  string!
  }
  filter  partitionId==args.partitionId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   planFull
}

// ---- Per-account task-queue reads (epic memql#902 / #909) ----
//
// The frontend's Tasks UX shows the caller their active vs waiting Plans and
// each waiting Plan's queue position. These two owned-tier reads are its data
// source: payload.requestedBy==actor.userId binds the caller server-side so a
// caller only ever sees their own account's Plans (the account == the user in
// v1). The cap comes from accountEntitlement (#903); the active count is
// the length of activePlansForUser; the queue order + per-Plan position
// come from waitingPlansForUser sorted by createdAt.

/// The caller's currently-RUNNING Plans -- the account's active tasks occupying concurrency slots
/// (epic memql#902 / #909). Owned tier: payload.requestedBy==actor.userId binds server-side so a
/// caller only sees their own. The active count is the result length; pair with accountEntitlement
/// for the cap and waitingPlansForUser for the queue.
@actor
query plan activePlansForUser {
  filter  requestedBy==actor.userId && statusIsRunning
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   planFull
}

/// The caller's Plans parked in the per-account waiting queue (status=waitingForSlot) because the
/// account is at its concurrency cap (epic memql#902 / #909). Owned tier
/// (payload.requestedBy==actor.userId). FIFO order is by row.createdAt of the waitingForSlot
/// version (carried in planFull); the frontend derives each Plan's queue position from that
/// ascending order -- MemQL has no in-query window/rank function.
@actor
query plan waitingPlansForUser {
  filter  requestedBy==actor.userId && status=="waitingForSlot"
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   planFull
}

/// Latest persisted state for a Task (planner reads this on resume).
@unbounded("task state by taskId -- bounded to a single row")
query taskState taskStateById {
  args {
    taskId  string!
  }
  filter  taskId==args.taskId
  shape   taskStateFull
}

// tasksForPlan
// =================
//
// All Tasks belonging to a Plan, in seq order (the planner emits
// Tasks with monotonically increasing seq; v0.1 executes them
// sequentially). Used by the Tasks-page expand-drawer when a Plan
// row is clicked, and by the planner itself when checking whether
// the next Task is ready to start.
//
// Arguments:
//   planId (string, required) - The parent Plan id.
//
// Returns:
//   Array of task records (taskFull shape).

/// All Tasks for a Plan, in seq order.
@unbounded("tasks within one plan -- bounded by the plan; the caller runs the whole plan")
query task tasksForPlan {
  args {
    planId  string!
  }
  filter  planId==args.planId
  shape   taskFull
}

// -----------------------------------------------------------------------------
// Responsibility reads (epic #631 / program #629).
//
// All three are owned-tier: the filter binds payload.ownerUserId to
// actor.userId server-side so a caller can only ever read their own
// directives -- cross-user reads are impossible. The reactive-loop
// epic #632 consumes dueResponsibilities.
// -----------------------------------------------------------------------------

/// Every responsibility owned by the caller (all statuses + triggers). Backs the management
/// surface. The ownerUserId predicate binds to actor.userId server-side so cross-user reads are
/// impossible.
@actor
query responsibility responsibilitiesForUser {
  filter  ownerUserId==actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   responsibilityFull
}

/// The caller's active + enabled responsibilities -- the live working set. Owned tier (ownerUserId
/// == actor.userId). status filtered via statusIsActive; enabled==true drops soft-disabled rows.
@actor
query responsibility activeResponsibilities {
  filter  ownerUserId==actor.userId && statusIsActive && enabled==true
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   responsibilityFull
}

/// The caller's active + enabled responsibilities of a given trigger archetype (recurring or
/// reactive) -- the candidate set the reactive-loop evaluator (epic #632) checks for due-ness.
/// Owned tier (ownerUserId == actor.userId). Cron-due / condition-match filtering happens Go-side
/// (no OR operator + no cron arithmetic in the filter), mirroring queryDueRefreshDomains.
@unbounded("responsibilities due for a trigger -- an internal scheduler sweep that must see all due")
@actor
query responsibility dueResponsibilities {
  args {
    trigger  enum("reactive", "recurring")!
  }
  filter  ownerUserId==actor.userId && statusIsActive && enabled==true && trigger==args.trigger
  shape   responsibilityFull
}

/// Every active + enabled responsibility in the partition, regardless of owner -- the cross-user
/// sweep the reactive-loop heartbeat (epic #632) walks each tick. Cron-sweep-helper shape (no owner
/// filter; classifies as 'other' like queryAllArchivedSpacesAcrossUsers). The planner poller reads
/// this under the system actor, then impersonates each row's ownerUserId for the owned-tier
/// per-user writes.
@unbounded("cross-user active responsibilities -- an internal scheduler sweep that must see all")
query responsibility activeResponsibilitiesAcrossUsers {
  filter  statusIsActive && enabled==true
  shape   responsibilityFull
}

/// Every Plan the reactive loop spawned for a responsibility, matched on the input.responsibilityId
/// back-pointer. Backs the C1 dedup guard (one live Plan per continuous responsibility).
/// Terminal-vs-live filtering happens Go-side (no NOT/OR in MemQL filters).
query plan plansForResponsibility {
  args {
    responsibilityId  string!
  }
  filter  input.responsibilityId==args.responsibilityId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   planFull
}

/// Single v1:planner:responsibility by id. Used by the intake dispatcher (#637) and the management
/// UI's single-row refresh. Filters on id only -- mirrors planById; the owner-scoped list reads
/// stay on responsibilitiesForUser.
query responsibility responsibilityById {
  args {
    responsibilityId  string!
  }
  filter  id==args.responsibilityId
  shape   responsibilityFull
}
