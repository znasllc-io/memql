// concepts.memql
//
// Concepts in the planner namespace.

@version("1.0.0")
@namespace("planner")
@description("A user-visible unit of work the planner orchestrates. Per the v1 brainstorm Q1 (Option D): Plan + Task model where Plans CAN nest via parentPlanId, Tasks always belong to one Plan and never recurse. Plans are the user mental anchor (the thing the user dropped a file for, asked a question about, or kicked off as a workflow); Tasks are the engineer-facing decomposition. Lifecycle covers queued / routing / running (with sub-states for paused / awaitingFeedback / needsAgent), succeeded / failed / cancelled. The planner emits Tasks per Q3's outline+per-phase incremental strategy: the Plan's `phases` array carries the coarse outline, Tasks emerge per phase with a phase tag.")
concept plan {
  spaceId             string  @required @description("v1:cognition:space.id this Plan belongs to. Tasks page is per-space; estimation buckets and budget rollups scope to the space.")
  parentPlanId        string  @description("When set, this Plan is a CHILD Plan -- spawned by a parent Plan's running agent via requestSubPlan, OR spawned as a refinement of a completed Plan via the user's [Refine ...] action on the plan.completed card. Sub-plans inherit parent's authorization (Q4) and carved-out token allocations (Q6). Cancelling a parent cancels all running children; cancelling a child does NOT cancel the parent.")
  kind                string  @required @description("Plan-kind discriminator. v1 surface: analyzeFile, refineAnalysis, embedDomainItems, inferEntitySchema, materializeSpreadsheetRows, agentProactive, conductResearch, executeWorkflow, trainSpecialist (Trainer Agent dispatch), adHocAction (synthetic single-Task wrapper for ad-hoc tool calls in chat). New kinds added as planner tool surface grows. Estimation buckets key on (kind, phase.kind).")
  mode                string  @description("Optional discriminator within a kind. Currently used by trainSpecialist Plans: mode='initial' for a fresh training run, mode='refresh' for an incremental update on an existing knowledge domain (the Trainer's prompt branches on this). Empty/null for kinds that don't carry a mode.")
  retryThreshold      int     @default("3") @description("Max attemptNumber the Planner Agent will allow for any single logicalStepId before escalating to awaitingFeedback with feedbackReason='retry_threshold_hit'. Per-Plan tunable; defaults to 3. The Planner Agent enforces this in its prompt logic by emitting 'escalate' when attempts exhaust; the engine doesn't enforce a hard cap.")
  status              enum("planning", "queued", "routing", "running", "paused", "awaitingFeedback", "needsAgent", "succeeded", "failed", "cancelled") @required @default("planning") @description("Lifecycle. planning = freshly created; the planner agent is decomposing the goal into phases + emitting task definitions, nothing is dispatched yet. queued = planning is complete; phases + tasks are visible and the plan waits for the user (or an automation) to click Run. routing = planner is picking an agent. running = agent's Tasks executing. paused = user paused (Q12) or feedback timeout (Q20). awaitingFeedback = agent called requestUserFeedback. needsAgent = no good-fit agent in space, parked awaiting user create. succeeded / failed / cancelled = terminal.")
  goal                string  @required @description("Human-readable description of what the Plan is trying to accomplish. Surfaced on the Tasks page row + on the plan.created canvas card. LLM-generated from trigger context.")
  ownerAgentId        string  @description("v1:agents:agent.id of the agent the planner assigned. Set when status transitions queued -> routing -> running. Null while queued/routing or while in needsAgent state.")
  requestedBy         string  @required @description("v1:identity:user.id of the user whose action created the Plan. Owner-private canvas cards key off this; Tasks page filters when scoped to 'my plans'.")
  triggerSource       enum("user.explicit", "user.implicit", "agent.proactive", "system", "subplan.inherited") @required @default("user.explicit") @description("Per Q4: user.explicit = user dropped file / clicked button; user.implicit = user said something in chat that Cognition triaged as plan-worthy; agent.proactive = an agent decided on its own; system = cron / automation; subplan.inherited = parent Plan spawned this child Plan.")
  authorizedBy        string  @description("v1:identity:user.id that authorized the trigger (typically same as requestedBy for user.explicit; the agent owner for agent.proactive standing authorizations; literal 'system.allowlist' for system-triggered).")
  recommendationCardId  string  @description("Set when status=needsAgent and a plan.needsAgent canvas card was emitted; lets the agent-create flow find this Plan when the user clicks [Create X agent] on the card and re-route on agent save (Q22).")
  input               object  @required @description("Per-kind input shape. analyzeFile: {attachmentId, hint?}. refineAnalysis: {parentPlanId, feedback}. conductResearch: {query, scope}. executeWorkflow: {workflowId, args}. Discriminated by kind; validated at create.")
  output              object  @description("Per-kind output shape, populated at terminal status. analyzeFile: {summary, documentId, structuredCount, knowledgeDomainSuggestions[]}. refineAnalysis: {refinedSummary, additionalSections[]}. Built by the planner at Plan-completion time from rolled-up Task outputs.")
  refinementContext   object  @description("For refinement child Plans (Q9): {parentPlanId, userFeedback, parentResultSnapshot}. The planner uses this to constrain the agent's prompt -- 'this isn't a new analysis from scratch; refine what's already there'. Distinct from input so the planner can quickly distinguish refinement from fresh analysis.")
  phases              []object @description("Per Q3 (outline+per-phase incremental): coarse outline generated at Plan-creation time, refined per phase. Each phase: {kind: string, label: string, status: 'pending'|'active'|'done', expectedTaskCount: int, completedTaskCount: int, startedAt?: datetime, completedAt?: datetime, estimate?: {p50Ms, p90Ms, confidence}}. Drives the Tasks page progress strip + estimation rollup.")
  estimate            object  @description("Per Q5 (LLM heuristic seed + historical refinement): {p50Ms, p90Ms, confidence: 'heuristic'|'mixed'|'historical', sampleSize}. Refreshed at phase boundaries. Drives the canvas card estimate strip and the Tasks page row remaining-time.")
  estimatedAt         datetime @description("When the current estimate was computed.")
  tokenBudget         int     @description("Per Q6 (Plan-level enforcement): allocated at creation from User.preferences.defaultPlanTokenBudget. Hard-stop ceiling: pre-call check rejects if tokenSpent + estimatedCallCost > budget. Null = use the user default.")
  tokenSpent          int     @default("0") @description("Rolled up from Task token costs + planner's own LLM calls (outline / per-phase replanning / estimate prompts). Surfaced as the token bar on Tasks page rows.")
  tokenAllocatedToChildren  int @default("0") @description("Sum of unspent allocations to running child Plans. Subtracted when checking child-spawn capacity; returned to available budget when the child completes.")
  tokenCapDisabled    bool @default("false") @description("Per-Plan opt-out (Q6). When true, no soft warnings, no hard stop. Observability metric still records spend.")
  metrics             object  @description("Per Q7 rolled-up metrics: {startedAt, completedAt, totalDurationMs, totalTokensSpent, planningTokensSpent, executionTokensSpent, llmCallCount, toolCallCount, retryCount, replanCount, modelBreakdown[{tag, tokens}], phaseBreakdown[{kind, durationMs, tokensSpent}]}. Updated incrementally; finalized at terminal status. Backs estimation buckets + the plan.completed card.")
  errorMessage        string  @description("Populated when status transitions to failed.")
  startedAt           datetime @description("When the agent picked up the Plan and Tasks began running.")
  completedAt         datetime @description("When status reached terminal.")
  cancelledBy         string  @description("v1:identity:user.id when the user cancelled, or sentinel 'system.timeout' / 'system.tokenBudget' / 'parent.cancelled' for system cancellations.")
  pausedAt            datetime @description("When last paused. Null if never paused or currently running.")
  totalPausedMs       int @default("0") @description("Sum of paused durations across the Plan's life, for 'how long was this actually working' observability.")
  pauseExtendsDeadline  bool @default("false") @description("Per Q12: by default pause time counts against the 8-hour deadline. User can flip per-Plan to 'pausing extends my deadline'.")
  feedbackRequest     object  @description("Per Q18 (awaitingFeedback status): {question, kind: 'choice'|'text'|'multi', options?: [{label, value}], requiredFields?, askedAt, askedByTaskId, timeoutAt}. Set when status transitions to awaitingFeedback; cleared on resume.")
  feedbackResponse    object  @description("User's response to the most recent feedbackRequest: {response, respondedBy, respondedAt}. Carried into the agent's resume context.")
  computerUseScope    enum("", "observe", "interact", "full") @default("") @description("Per-Plan declared computer_use scope (Q9 layer 2 narrowing). When non-empty, the planner gates worker tool dispatch to actions within this scope. Must equal or be NARROWER than the agent's standing AgentAuthorization.computerUseScope; an attempt to widen elevates the Plan to awaitingFeedback with reason=scope_elevation_required. Empty = no worker calls allowed for this Plan. NOTE: the `interact` enum value is retired -- the read path treats it as `full`. New Plans should pick observe or full only.")
  feedbackReason      enum("", "feedback_required", "scope_elevation_required", "kill_switch_engaged", "retry_threshold_hit") @default("") @description("Discriminator on the awaitingFeedback variant. Empty = legacy feedback (free-form question via feedbackRequest). scope_elevation_required = a worker tool call hit a scope wall; the canvas card shows the requested scope + Approve/Deny. kill_switch_engaged = the user flipped User.preferences.computerUseEnabled to false; the card shows a re-enable link. retry_threshold_hit = the Planner Agent gave up after Plan.retryThreshold consecutive failures at the same logicalStepId; the canvas card asks the user 'what should we try next?'.")
  chatAnchorMessageId string  @description("Per Q11: when this Plan was spawned from a chat message (user dropped a file or asked a Plan-worthy question), this is the message id the chat completion / awaiting-feedback subordinate line should anchor to.")
}

@version("1.0.0")
@namespace("planner")
@description("A scheduled or recurring background task assigned to an agent for a specific user. Defines what the agent should do periodically (e.g. 'every Monday morning summarize last week's marketing performance') without the user having to ask each time. The reactive-collaboration phase 3 surface; pairs with the heartbeat-driven topic listener for ad-hoc dispatch and the action utterance lane for surfacing results. Per-user-per-agent today; per-space scoping is a future extension.")
concept standingTask {
  name           string    @required @description("Human-readable task name (e.g. 'Weekly marketing summary'). Shown in admin / settings UIs.")
  agentId        string    @required @description("v1:agents:agent.id of the agent that runs this task. The agent's domains/keywords/tools are what's available during execution.")
  userId         string    @required @description("Owner of this task assignment. Output posts into the user's DM-with-agent space (or outputSpaceId if set).")
  schedule       string    @required @description("Cron-style schedule string (e.g. '0 9 * * 1' for Monday 9am). Empty schedule = manual / heartbeat-only trigger.")
  prompt         string    @required @description("The instruction the agent runs each tick. Should be self-contained (no per-tick context injection); the agent's standard prompt context is added automatically by the runner.")
  tools          []string  @description("Optional tool whitelist for this task. Empty = no tools (research/summary mode). When non-empty the runner restricts the agent to this subset for the task duration.")
  enabled        bool      @default("true") @description("When false the runner skips this task. Soft-disable without deleting.")
  outputSpaceId  string    @description("Optional override for where the result posts. Defaults to the user's DM space with this agent.")
  lastRunAt      datetime  @description("Last time the runner fired this task. Empty means it has never run.")
  lastResult     string    @description("Headline of the most recent run's result. UI surface for 'last task output' widgets.")
}

@version("1.0.0")
@namespace("planner")
@description("One executable step inside a Plan. Two flavors discriminated by `category`: 'semantic' rows are what the Planner Agent decomposes a Plan into (one per logical step); 'toolInvocation' rows are auto-stamped by the engine on every tool call an agent makes (one per call). Tool-call rows attach to their executing semantic row via `parentTaskId`, giving one level of recursion -- semantic Tasks never have a `parentTaskId`, tool-call Tasks always do. Sub-goal nesting still happens at the Plan level via `parentPlanId` (Q1); the recursion here is purely mechanical record-keeping. Per Q13 each Task declares its executionSurface so the planner can route inProcess work to the agent node and containerExecutor work to NemoClaw / homegrown sandboxes.")
concept task {
  planId            string  @required @description("v1:planner:plan.id this Task belongs to. Every Task -- semantic or toolInvocation -- lives under exactly one Plan, even ad-hoc tool calls in chat (which get a synthetic single-Task Plan of kind=adHocAction).")
  category          enum("semantic", "toolInvocation") @required @default("semantic") @description("What kind of record this is. 'semantic' = Planner-created decomposition step (the user-meaningful unit). 'toolInvocation' = engine-auto-stamped record of a tool call by an executing agent. Engine validation: category='toolInvocation' MUST have parentTaskId set pointing at a category='semantic' row; category='semantic' MUST have parentTaskId=null.")
  parentTaskId      string  @description("Set only when category='toolInvocation'; points at the semantic Task that was executing when this tool call fired. Lets us reconstruct 'all the things that happened while Architect was producing the system design' with one query. One level of recursion only.")
  kind              string  @required @description("Sub-discriminator inside a category. For category='semantic': fileProcessor, llmAnalyze, embedChunks, dedupCheck, browseUrl, browseClick, browseRead, runCommand, callTool, persistResult. For category='toolInvocation': the tool name (e.g. 'webSearch', 'clawReadFile', 'workerComputer'). Estimation buckets key on (plan.kind, task.kind).")
  logicalStepId     string  @description("Stable identifier for the semantic step this Task is an attempt at. Set by the Planner Agent at decomposition time; shared across retry attempts so threshold counting is a simple group-by. Only meaningful for category='semantic' rows; null for toolInvocation rows.")
  attemptNumber     int     @default("1") @description("Which attempt at logicalStepId this row represents. Increments per retry. The Planner Agent enforces the per-Plan retryThreshold by emitting an 'escalate' action when attemptNumber > Plan.retryThreshold.")
  toolName          string  @description("Populated by the auto-stamper for category='toolInvocation'. The bare tool name as the agent invoked it. Empty for category='semantic'.")
  toolArgs          object  @description("Tool-call arguments captured at dispatch time. Populated for category='toolInvocation'; empty for category='semantic'.")
  toolResult        object  @description("Tool-call result captured when the dispatched call returned. Populated for category='toolInvocation' when status=succeeded. Empty for category='semantic'.")
  status            enum("queued", "running", "paused", "succeeded", "failed", "cancelled") @required @default("queued") @description("Lifecycle. queued = emitted by planner; running = agent executing; paused = parent Plan is paused or this Task hit a checkpoint while parent is paused (Q12); succeeded / failed / cancelled = terminal. Cancellation cascades from the parent Plan.")
  seq               int     @required @description("Order within the parent Plan. Tasks within a phase execute in seq order; v0.2+ may add a dependsOn[] for full DAG execution.")
  phase             string  @description("Per Q3: phase tag matching one of the parent Plan's phases[].kind values. Lets the Tasks page render 'Phase 2 of 4: classifying' progress without joining tables.")
  executionSurface  enum("inProcess", "containerExecutor") @required @default("inProcess") @description("Per Q13: inProcess = runs inside the agent node's process (LLM + tool calls only); containerExecutor = runs in a sandboxed container (NemoClaw today, future homegrown variants pluggable). Default inProcess.")
  executorBackend   string  @description("When executionSurface=containerExecutor, names the registered backend ('nemoclaw' / future ids). Workspace config can set a default; per-Task override via this field.")
  input             object  @required @description("Per-kind input shape, carried forward from the parent Plan's input + any prior Task's output as the planner emits this Task.")
  output            object  @description("Per-kind output shape, populated when status reaches succeeded. The Plan's output is computed from its Tasks' outputs (or directly assigned by the planner at Plan-completion time).")
  metrics           object  @description("Per-Task observability rollup: {startedAt, completedAt, durationMs, tokensSpent, llmCallCount, toolCallCount, modelBreakdown[{tag, tokens}]}. Rolls up into the parent Plan's metrics.")
  errorMessage      string  @description("Populated when status transitions to failed.")
  startedAt         datetime
  completedAt       datetime
  parkedAt          datetime @description("Per Q18: set when the Task hits a checkpoint while parent is paused / awaitingFeedback. The runner exits cleanly; on resume the planner re-invokes from the parkedAtCheckpoint marker + persisted TaskState.")
  parkedAtCheckpoint  string @description("Task-kind-specific resume marker. fileProcessor: 'between-pages'; llmAnalyze: 'between-calls'; runCommand: 'between-commands'. The agent's resume code path knows what each marker means.")

  @relationship(type="parent", field="parentTaskId", target="v1:planner:task", direction="outgoing")
}

@version("1.0.0")
@namespace("planner")
@description("Persisted working state of a Task that's parked awaiting user feedback (or has been paused mid-execution). The async-parking + planner re-invocation model from Q18: when an agent calls requestUserFeedback, the agent's process exits cleanly after persisting its working state; when the user responds, the planner re-invokes the agent with this state as bootstrap context. Same machinery powers Pause/Resume (Q12) and refinement-Plan parent-Task resumption (Q9). Per Task; written when the Task transitions to awaitingFeedback / paused; read on resume.")
concept taskState {
  taskId            string  @required @description("v1:planner:task.id this state belongs to. One row per (taskId, persisted-version-seq); the planner reads the latest on resume.")
  workingMemory     object  @description("Intermediate results from previous tool calls in this Task. Free-form per agent kind; the agent's prompt template knows how to consume.")
  reasoningChain    string  @description("The agent's internal 'what I'm doing and why' summary so it can pick up the thread on re-invocation.")
  toolCallHistory   []object @description("Replayable tool-call log: list of {toolName, args, result, error?} in order. Agent prompt either replays or uses as a 'what's been done so far' summary.")
  pendingSubPlanIds []string @description("Sub-Plan ids the agent was orchestrating when it parked. Resume waits on these to complete before continuing.")
}
