/// Responsibility cadence and placement use the common scheduler and shared lease.
@trigger(schedule="@every 45s", node="planner", lease="responsibility-sweep")
automation pursueResponsibilities {
 builtin plannerPursueResponsibilities()
}

/// Process each selected owner independently, under authority bound by the native reader.
@template
automation plannerResponsibilitySweep {
 owners := builtin plannerResponsibilityOwners()
 for owner in owners {
  builtin plannerProcessOwner(owner: owner) on error continue
 }
}

/// Honor individual responsibilities before reasoning across the owner's whole working set.
@template
automation plannerOwnerWorkflow {
 args { ids []string! }
 for id in args.ids {
  builtin plannerProcessResponsibility(id: id) on error continue
 }
 builtin plannerConverge()
}

/// Standing directives are context; reactive directives are reevaluated and recurring ones use cron facts.
@template
automation plannerResponsibilityDue {
 args { trigger string! recurringDue bool! }
 return args.trigger == "reactive" || (args.trigger == "recurring" && args.recurringDue)
}

/// A live goal suppresses reactive work; a shared cooldown also covers delayed visibility and replica handoff.
@template
automation plannerResponsibilityWorkflow {
 args { row object! recurringDue bool! }
 if args.row.id == "" { return false }
 if args.row.trigger == "standing" {
  standingAgent := automation plannerRouteResponsibility(row: args.row)
  if standingAgent == "" { return false }
  standingClaim := builtin plannerClaimResponsibility(purpose: "standing-eval", minutes: 30)
  if !standingClaim { return false }
  builtin plannerRecordEvaluation(result: "standing directive active on standingAgent " + standingAgent)
  return true
 }
 due := automation plannerResponsibilityDue(trigger: args.row.trigger, recurringDue: args.recurringDue)
 if !due { return false }
 if args.row.trigger != "recurring" {
  live := builtin plannerHasLiveGoal()
  if live { return false }
 }
 claimed := builtin plannerClaimResponsibility(purpose: "honor", minutes: 30)
 if !claimed { return false }
 agent := automation plannerRouteResponsibility(row: args.row)
 receipt := builtin plannerTryHonor(agentId: agent)
 if !receipt.ok {
  builtin plannerRecordEvaluation(result: "honor failed: " + receipt.result)
  return false
 }
 builtin plannerRecordEvaluation(result: receipt.result)
 return true
}

/// Route assistants directly; reuse a bound specialist or resolve one before assigning and injecting context.
@template
automation plannerRouteResponsibility {
 args { row object! }
 if args.row.targetKind == "assistant" {
  assistant :=  builtin plannerResolveAssistant()
  if assistant != "" && assistant != args.row.assignedAgentId {
   builtin plannerAssignResponsibility(kind: "assistant", agentId: assistant, roleSlug: "")
  }
  return assistant
 }
 if args.row.targetKind == "specialist" && args.row.assignedAgentId != "" {
  automation plannerInjectStanding(row: args.row, agentId: args.row.assignedAgentId)
  return args.row.assignedAgentId
 }
 agent := builtin plannerResolveSpecialist()
 if agent == "" { builtin plannerWorkflowRefusal(message: "factory resolved no agent for responsibility " + args.row.id) }
 builtin plannerAssignResponsibility(kind: "specialist", agentId: agent, roleSlug: args.row.assignedRoleSlug)
 automation plannerInjectStanding(row: args.row, agentId: agent)
 return agent
}

/// Standing context is periodically reasserted through one idempotent append operation.
@template
automation plannerInjectStanding {
 args { row object! agentId string! }
 if args.row.trigger == "standing" && args.agentId != "" && args.row.statement != "" {
  claimed := builtin plannerClaimResponsibility(purpose: "standing-inject", minutes: 30)
  if claimed { builtin plannerAppendDirective(agentId: args.agentId) }
 }
}

/// Trigger archetypes choose whether honoring means opening work or adding context.
@template
automation plannerHonorResponsibility {
 args { row object! agentId string! }
 opensGoal := logic plannerTriggerOpensGoal(trigger: args.row.trigger)
 if opensGoal {
  goal := automation plannerOpenResponsibility(row: args.row, agentId: args.agentId)
  return "opened " + args.row.trigger + " goal " + goal + " (agent " + args.agentId + ")"
 }
 if args.row.trigger == "standing" {
  automation plannerInjectStanding(row: args.row, agentId: args.agentId)
  return "injected standing directive into agent " + args.agentId
 }
 builtin plannerWorkflowRefusal(message: "unknown trigger " + args.row.trigger)
}

/// Goal wording and input are authored; the native opener always binds the selected owner and responsibility.
@template
automation plannerOpenResponsibility {
 args { row object! agentId string! }
 statement := args.row.statement == "" ? "Honor responsibility " + args.row.id : args.row.statement
 return builtin plannerOpenResponsibilityGoal(statement: statement, input: {
  responsibilityId: args.row.id, trigger: args.row.trigger, statement: statement, successCriteria: args.row.successCriteria
 })
}

/// Run the conductor at most hourly per owner and stay quiet when there is nothing to reason about.
@template
automation plannerConvergenceWorkflow {
 args { owner string! responsibilities []any! observedAt string! }
 claimed := builtin plannerClaimConvergence(minutes: 60)
 if !claimed { return }
 goals := builtin plannerSpaceGoals()
 if goals.count() == 0 && args.responsibilities.count() == 0 { return }
 memory := builtin plannerRecentMemory(text: "active goals and standing responsibilities I am pursuing", k: 8)
 actions := builtin plannerConvergenceTurn(prompt: "reactiveConductor", data: {
  user: {userId: args.owner}, spaceGoals: goals, responsibilities: args.responsibilities, recentMemory: memory, now: args.observedAt
 })
 for id in actions {
  builtin plannerDispatchConvergence(id: id) on error continue
 }
}

/// Confidence, duplicate suppression and action routing belong to the conductor's DSL recipe.
@template
automation plannerConvergenceAction {
 args { action object! statementKey string! }
 if args.action.confidence < 0.6 { return }
 if args.action.kind != "createPlan" && args.action.kind != "surfaceNudge" && args.action.kind != "extendSpecialist" { return }
 key := args.action.responsibilityId == "" ? args.statementKey : args.action.responsibilityId
 claimed := builtin plannerClaimAction(key: key, minutes: 30)
 if !claimed { return }
 if args.action.kind == "createPlan" {
  builtin plannerConvergenceGoal()
 } else if args.action.kind == "surfaceNudge" {
  if args.action.responsibilityId != "" {
   builtin plannerConvergenceNudge(result: "nudge: " + args.action.statement)
  } else { builtin plannerLogNudge() }
 } else if args.action.responsibilityId != "" {
  builtin plannerConvergenceSpecialist()
 }
}

/// The default Spine: owned reuse before paid reasoning; policy is ordinary installed DSL.
@template
automation defaultWorkSpine {
 context := builtin spineContext()
 if !context.conversational {
  exact := builtin spineCandidates(kind: "exact")
  procedures := builtin spineCandidates(kind: "procedure")
  for candidate in procedures.candidates {
   return builtin spineUseCandidate(handle: candidate.handle)
  }
  for candidate in exact.candidates {
   return builtin spineUseCandidate(handle: candidate.handle)
  }
  near := builtin spineCandidates(kind: "near")
  for candidate in near.candidates {
   if candidate.similarity >= 0.82 { return builtin spineUseCandidate(handle: candidate.handle) }
  }
 }
 triage := builtin spineClassify()
 if triage.conversational && triage.workload != "quick" && triage.acknowledgement == "" {
  builtin spineAcknowledge()
 }
 route := logic workSpineRoute(triage: triage)
 if triage.requiresFile && route == "sectionable" {
  automation workSpineDocumentSections()
 }
 if route != "author" {
  sections := builtin spinePrepareSections(route: route)
  if sections.valid || (triage.conversational && triage.intent != "automation") {
   return automation workSpineDraft()
  }
 }
 return automation workSpineAuthor(repairAttempts: context.repairAttempts)
}

/// A routing pass can group many drafts under one heading; require an executable decomposition before drafting.
@template
automation workSpineDocumentSections {
 first := builtin spineRefineSections(prompt: "workDocumentSections", maxWords: 800, timeoutSeconds: 120)
 if first.ok {
  review := builtin spineReviewSections(prompt: "workDocumentCoverage", timeoutSeconds: 180)
  if review.ok { return true }
 }
 repaired := builtin spineRefineSections(prompt: "workDocumentSectionsRepair", maxWords: 800, timeoutSeconds: 480)
 if repaired.ok {
  repairedReview := builtin spineReviewSections(prompt: "workDocumentCoverage", timeoutSeconds: 180)
  if repairedReview.ok { return true }
  return builtin spineRefuse(message: repairedReview.message)
 }
 return builtin spineRefuse(message: repaired.message)
}

/// Retry representation only when the host proves no persistence was attempted.
@template
automation workSpineDraft {
 draft := builtin spineDraft(mode: "default")
 if draft.ok { return true }
 if draft.hasCatalog {
  live := builtin spineDraft(mode: "live")
  if live.ok { return true }
  if live.hasLiveSections {
   inlineLive := builtin spineDraft(mode: "inline")
   if inlineLive.ok { return true }
   return builtin spineRefuse(message: inlineLive.message)
  }
  return builtin spineRefuse(message: live.message)
 }
 if draft.hasLiveSections {
  inline := builtin spineDraft(mode: "inline")
  if inline.ok { return true }
  return builtin spineRefuse(message: inline.message)
 }
 return builtin spineRefuse(message: draft.message)
}

/// Design and emit once, then repair within the native call and iteration ceilings.
@template
automation workSpineAuthor {
 args { repairAttempts []int! }
 builtin spineDesign()
 builtin spineEmit()
 validation := builtin spineValidate()
 if validation.ok { return builtin spinePersist() }
 for attempt in args.repairAttempts {
  builtin spineRepair()
  repaired := builtin spineValidate()
  if repaired.ok { return builtin spinePersist() }
 }
 return builtin spineRefuse(message: "The authored draft did not pass Gate 1 within the repair budget.")
}

/// Encode the default execution recipe as ordinary journaled automation steps.
/// Native operations bind validated data and quote source; sequencing and instructions live here.
@template
automation workSpineDraftProgram {
 facts := builtin spineDraftFacts()
 inputHeading := "\n\nGoal input (JSON):\n"
 if facts.navigation { return builtin spineDraftAppend(kind: "navigation") }
 if !facts.fanout {
  if facts.file && facts.research {
   builtin spineDraftAppend(kind: "research", inputHeading: inputHeading, instruction: facts.goal + "\nGather the evidence required for this deliverable using authorized capabilities. Preserve source references, uncertainties and the complete draft. Do not save the final file: the next step renders it from your result.")
  }
  return builtin spineDraftAppend(kind: facts.file ? "file" : "answer", instruction: facts.goal, inputHeading: inputHeading)
 }
 for section in facts.sections {
  if section.catalog {
   builtin spineDraftAppend(kind: "catalog", section: section.name)
  } else {
   instruction := logic workSpineSectionInstruction(section: section, goal: facts.goal)
   builtin spineDraftAppend(kind: section.live ? "live" : "inline", section: section.name, instruction: instruction, inputHeading: inputHeading)
  }
 }
 builtin spineDraftAppend(kind: "collect")
 if facts.file && facts.prose && facts.sections.any(section => section.deliver) {
  return builtin spineDraftAppend(kind: "file", instruction: facts.goal, inputHeading: inputHeading, sectionKeys: facts.sections.where(section => section.deliver).select(section => section.name))
 }
 if facts.file || facts.intelligence {
  kind := facts.sections.any(section => section.dependent) ? "sections" : "independent sections"
  return builtin spineDraftAppend(kind: facts.file ? "file" : "answer", inputHeading: inputHeading, sectionsHeading: "\n\nCompleted sections:\n", instruction: facts.goal + "\n\nAssemble the completed " + kind + " into the requested deliverable. Verify completeness. " + facts.assembly)
 }
 return builtin spineDraftAppend(kind: "returnSections")
}

/// Replan only the unfinished suffix. Native validation preserves the completed journal prefix.
@template
automation workSpineReplan {
 context := builtin spineRemedyContext()
 if !context.hasFailedStep { return builtin spineRemedyAsk(reason: "This run was to be re-planned from the step it failed at, and it has no failed step to re-plan from.") }
 if !context.hasGoal { return builtin spineRemedyAsk(reason: "This run's goal could not be read, so there is no plan to re-plan from its failed step.") }
 if !context.sandbox { return false }
 draft := builtin spineRemedyGenerate(prompt: "replanGap")
 if !draft.available { return false }
 if !draft.ok { return builtin spineRemedyAsk(reason: "The re-plan for this run's failed step could not be made: " + draft.message) }
 if draft.goalAlreadyServed { return builtin spineRemedyAsk(reason: "The re-plan found nothing left to do: it judged the completed steps already serve the goal. Retry the failed step, or abandon the run.") }
 validation := builtin spineRemedyValidate(preserveInvocation: [{from: "runAgentTurn", to: "ai", argument: "templateId"}])
 if !validation.ok {
  reason := logic workSpineReplanRefusal(stage: validation.stage, message: validation.message)
  return builtin spineRemedyAsk(reason: reason)
 }
 persisted := builtin spineRemedyPersist()
 if !persisted.ok { return builtin spineRemedyAsk(reason: "The re-planned draft could not be made this run's template: " + persisted.message) }
 return builtin spineRemedyInstall()
}

/// Repair uses the existing guided step rerun, with a human question only when the run is still waiting.
@template
automation workSpineRepair {
 repair := builtin spineRemedyRepair()
 if repair.ok { return true }
 if repair.moved { return false }
 return builtin spineRemedyAsk(reason: "The failed step could not be run again with the violation as guidance: " + repair.message)
}

/// Replanning reads a bounded evidence view. Full receipts remain in the journal
/// and completed step identities/source are never removed by this policy.
@template
automation workReplanEvidencePolicy {
 return {perStepCharacters: 600, totalCharacters: 16000}
}
