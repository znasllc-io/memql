/// Reactive and recurring responsibilities open work; standing ones add context.
logic plannerTriggerOpensGoal {
 args { trigger string }
 return args.trigger == "reactive" || args.trigger == "recurring"
}

/// Value-only routing; classification and effects remain in the enclosing Spine.
logic workSpineRoute {
 args { triage object! }
 if args.triage.conversational && args.triage.intent != "automation" && !args.triage.sectionable {
  return "trivial"
 }
 if args.triage.complexity == "trivial" { return "trivial" }
 if args.triage.sectionable { return "sectionable" }
 return "author"
}

/// Reusable section instruction policy, shared by inline and cataloguable live sections.
logic workSpineSectionInstruction {
 args { section object! goal string! }
 prefix := args.section.effectful ? "Carry out only the section below, one part of a larger goal, and report what you did as text. Make only the changes this section describes." : args.section.live ? "Produce only the section below, one part of a larger goal, and return its complete content as text. This is an intermediate drafting step: do not create or save files and do not call composition tools." : args.section.dependent ? "Produce only the section below and return its complete content as text; it builds on the results of earlier sections, given after the goal input. This is an intermediate drafting step: do not create or save files and do not call composition tools. Final assembly will produce the deliverable." : "Produce only the independent section below and return its complete content as text. This is an intermediate drafting step: do not create or save files and do not call composition tools. Final assembly will produce the deliverable."
 dependency := args.section.effectful && args.section.dependent && !args.section.live ? " It builds on the results of earlier sections, given after the goal input." : ""
 goal := args.section.live ? "" : "\n\nOverall goal (context only): " + args.goal
 purpose := args.section.live || args.section.purpose != "" ? "\nPurpose: " + args.section.purpose : ""
 finished := args.section.postcondition == "" ? "" : "\nIt is finished when: " + args.section.postcondition
 progress := "\n\nCurrent section completion: Compare recorded evidence with this section's requested output and completion condition. Once this section's requested output and any stated postcondition are supported, return that output now using the supplied completion contract. Keep requested prose and drafts complete; use a concise handoff only when the requested output is evidence or action receipts. Later sections are not unfinished work for this section; retain their relevant constraints without doing their work now. Before another read, name the missing fact or applicable instruction it will resolve. Reuse established facts and recall saved results; refresh them when changed, stale or contradicted. Repeating the same successful fetch or the same truncated prefix is not progress. Target the missing passage or change the bounded retrieval to obtain the missing bytes. Do not skip applicable instructions or claim an unmet postcondition; report a concrete blocker when required evidence cannot be obtained."
 return prefix + dependency + goal + "\n\nSection: " + args.section.label + "\n" + args.section.instruction + purpose + finished + progress
}

/// Explain which mandatory validator refused a proposed replan.
logic workSpineReplanRefusal {
 args { stage string! message string! }
 if args.stage == "source" { return "The re-planned draft does not compile: " + args.message }
 if args.stage == "prefix" { return "The re-planned draft does not keep the completed steps where they would be served: " + args.message }
 if args.stage == "invocation" { return "The revised plan would lose a capability needed to complete the work: " + args.message }
 return "The re-planned draft asks for arguments this run was not given: " + args.message
}
