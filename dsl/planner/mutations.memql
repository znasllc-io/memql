// -----------------------------------------------------------------------------
// Responsibility CRUD (epic #631 / program #629).
//
// A responsibility is a user-authored standing directive aimed at an
// agent, in three archetypes (reactive / standing / recurring). It
// folds in and replaces the retired standingTask concept -- recurring
// responsibilities carry the cron schedule standingTask used to.
//
// Authorization (owned tier): create stamps ownerUserId from
// actor.userId; the status + evaluation update paths re-stamp
// ownerUserId: actor.userId so the conformance classifier buckets
// them as owned and a caller can only ever rewrite their own rows.
// -----------------------------------------------------------------------------

/// Create a v1:planner:responsibility in status='draft'. ownerUserId is stamped from actor.userId
/// (owned tier) so a caller cannot author a directive owned by someone else. trigger discriminates
/// the archetype: recurring carries schedule, reactive carries condition, standing carries neither.
/// Single write path for responsibility creation.
@actor
mutation responsibility createResponsibility {
  args {
    responsibilityId  string
    statement         string!
    trigger           enum("reactive", "standing", "recurring")!
    schedule          string
    condition         object
    targetKind        enum("assistant", "specialist", "unassigned")
    assignedAgentId   string
    assignedRoleSlug  string
    successCriteria   string
    notifyHow         string
    scopePartitionId      string
    enabled           bool
  }
  insert {
    accept { statement, trigger, schedule, condition, assignedAgentId, assignedRoleSlug, successCriteria, notifyHow, scopePartitionId }
    stamp {
      id: args.responsibilityId
      ownerUserId: actor.userId
      targetKind: args.targetKind ?? "unassigned"
      enabled: args.enabled ?? true
      status: "draft"
    }
  }
}

/// Update an existing v1:planner:responsibility's editable fields (statement / schedule / condition
/// / target binding / scope / enabled). Partial-update via update() -- only the fields you pass
/// change; required fields inherit from the prior row. ownerUserId re-stamped from actor.userId
/// (owned tier) so a caller can only rewrite their own rows.
@actor
mutation responsibility updateResponsibility {
  args {
    responsibilityId  string!
    statement         string
    trigger           enum("reactive", "standing", "recurring")
    schedule          string
    condition         object
    targetKind        enum("assistant", "specialist", "unassigned")
    assignedAgentId   string
    assignedRoleSlug  string
    successCriteria   string
    notifyHow         string
    scopePartitionId      string
    enabled           bool
  }
  update {
    accept { statement, trigger, schedule, condition, targetKind, assignedAgentId, assignedRoleSlug, successCriteria, notifyHow, scopePartitionId, enabled }
    stamp {
      id: args.responsibilityId
      ownerUserId: actor.userId
    }
  }
}

/// Transition a v1:planner:responsibility's lifecycle status (draft / active / paused / archived).
/// Partial-update via update(); ownerUserId re-stamped from actor.userId (owned tier).
@actor
mutation responsibility setResponsibilityStatus {
  args {
    responsibilityId  string!
    status            enum("draft", "active", "paused", "archived")!
  }
  update {
    id: args.responsibilityId
    ownerUserId: actor.userId
    args.status
  }
}

/// Record the outcome of an evaluation/run on a v1:planner:responsibility: stamp lastEvaluatedAt to
/// now and lastResult to the run headline. Called by the reactive-loop evaluator (epic #632) after
/// a reactive condition check, a recurring scheduled tick, or a standing review. ownerUserId
/// re-stamped from actor.userId (owned tier).
@actor
mutation responsibility recordResponsibilityEvaluation {
  args {
    responsibilityId  string!
    lastResult        string!
  }
  update {
    id: args.responsibilityId
    ownerUserId: actor.userId
    args.lastResult
    lastEvaluatedAt: now
  }
}

/// Persist a routing decision onto a v1:planner:responsibility (epic #632, C2): bind the resolved
/// agent (assignedAgentId), optional role slug (assignedRoleSlug), and flip targetKind off
/// 'unassigned' onto the concrete kind (assistant / specialist). Called by the reactive-loop router
/// after agentFactoryAnalyze + createSpecialist/extendSpecialist mint or match an agent.
/// Partial-update via update(); ownerUserId re-stamped from actor.userId (owned tier) so the router
/// can only rewrite the row's own owner -- the poller impersonates the responsibility's owner in
/// the AccessContext before calling, so this lands as an owned write.
@actor
mutation responsibility assignResponsibility {
  args {
    responsibilityId  string!
    targetKind        enum("assistant", "specialist")!
    assignedAgentId   string
    assignedRoleSlug  string
  }
  update {
    accept { targetKind, assignedAgentId, assignedRoleSlug }
    stamp {
      id: args.responsibilityId
      ownerUserId: actor.userId
    }
  }
}

// -----------------------------------------------------------------------------
// Responsibility intake (issue #637 -- epic #631 / program #629).
//
// The intake dispatcher (integrations/planner/responsibility_intake.go)
// runs the responsibilityIntake prompt on a freshly-created draft and
// writes the result through these three mutations. They are called by the
// system:planner actor, NOT the owner, so -- exactly like
// updatePlanStatus -- they DO NOT re-stamp ownerUserId (the
// partial update() inherits it from the prior row) and never reference a
// user-scope field, so they classify as system writes rather than the
// owned tier. Authoring the row stays owned (createResponsibility
// stamps ownerUserId from the human caller); these intake transitions are
// engine-internal bookkeeping on a row the human already owns.
// -----------------------------------------------------------------------------

/// Mark a v1:planner:responsibility's intake as in-progress (issue #637). The intake dispatcher
/// calls this when it claims a freshly-created draft so a created+updated double-fire (or a
/// multi-node race) doesn't run the responsibilityIntake prompt twice -- intakeStatus flips '' ->
/// 'pending'. System write (system:planner actor): no ownerUserId re-stamp, no user-scope
/// reference, so it's engine-internal bookkeeping on a row the human already owns.
mutation responsibility markResponsibilityIntakePending {
  args {
    responsibilityId  string!
  }
  update {
    id: args.responsibilityId
    intakeStatus: "pending"
  }
}

/// Apply the responsibilityIntake result to a draft v1:planner:responsibility (issue #637). The
/// dispatcher stamps the inferred field set (trigger / schedule / condition / targetKind /
/// assignedRoleSlug / successCriteria / notifyHow) plus the intake outcome. When intake was CLEAR
/// (no questions) the dispatcher passes status='active' + intakeStatus='clear' so the row goes
/// straight live; when intake produced 1-2 questions it passes status='draft' +
/// intakeStatus='awaitingAnswers' + intakeRequest so the row parks for the user (mirrors the Plan
/// awaitingFeedback surfacing). Partial-update: only the supplied fields change. System write -- no
/// ownerUserId re-stamp.
mutation responsibility applyResponsibilityIntake {
  args {
    responsibilityId  string!
    trigger           enum("reactive", "standing", "recurring")
    schedule          string
    condition         object
    targetKind        enum("assistant", "specialist", "unassigned")
    assignedRoleSlug  string
    successCriteria   string
    notifyHow         string
    status            enum("draft", "active", "paused", "archived")
    intakeStatus      enum("", "pending", "awaitingAnswers", "clear", "applied")
    intakeRequest     object
  }
  update {
    accept { trigger, schedule, condition, targetKind, assignedRoleSlug, successCriteria, notifyHow, status, intakeStatus, intakeRequest }
    stamp {
      id: args.responsibilityId
    }
  }
}

/// Fold the user's answers to the intake clarifying questions back into a v1:planner:responsibility
/// and re-stamp the re-inferred field set (issue #637). Called after the user answers the
/// intakeRequest questions: the dispatcher re-runs responsibilityIntake with the answers folded in,
/// then writes the final trigger / schedule / condition / targetKind / assignedRoleSlug /
/// successCriteria / notifyHow, records intakeResponse for audit, sets intakeStatus='applied', and
/// flips status='active'. System write -- no ownerUserId re-stamp.
mutation responsibility foldResponsibilityIntakeAnswers {
  args {
    responsibilityId  string!
    intakeResponse    object!
    trigger           enum("reactive", "standing", "recurring")
    schedule          string
    condition         object
    targetKind        enum("assistant", "specialist", "unassigned")
    assignedRoleSlug  string
    successCriteria   string
    notifyHow         string
  }
  update {
    accept { trigger, schedule, condition, targetKind, assignedRoleSlug, successCriteria, notifyHow, intakeResponse }
    stamp {
      id: args.responsibilityId
      intakeStatus: "applied"
      status: "active"
    }
  }
}
