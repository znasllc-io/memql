// mutations.memql
//
// Planner-namespace mutations. The planner is a core node type (build
// tag planner; see app/integrations_planner_init.go). Its write
// surface is owned here so every binary that loads concepts can
// resolve the full plan / task / taskState mutation API regardless of
// which product layer (copresent or otherwise) is wired in on top.
//
// History: mutationCreatePlan / mutationCreateTask / mutationUpdatePlanStatus
// / mutationUpdateTaskStatus / mutationPersistTaskState /
// mutationCreateScopeElevationPlan were originally authored in
// memql-bff-copresent/dsl/copresent/mutations.memql. They moved
// here on 2026-05-17 because the BFF binary the cockpit connects to
// can't be guaranteed to have copresent in its DSL graph -- and the
// Planner tab's queryAllPlans / mutationCreatePlan calls were
// failing with "function not found" as a result.

use planner.concepts.{ plan, task, taskState, responsibility }

@enabled
@description("Create a synthetic Plan that wraps an ad-hoc tool call made outside any user-initiated planning context. Per Q5: every tool call must produce a Task; Tasks must have a parent Plan; chat-driven tool calls (no user-facing Plan) get a synthetic Plan with kind='adHocAction' so the invariant holds. Status is set to running and completes immediately when the synthetic semantic Task wrapping the tool call resolves.")
mutation plan mutationCreateAdHocPlan {
  args {
    planId        string  @required
    spaceId       string  @required
    agentId       string  @required
    ownerUserId   string  @required
    goal          string  @required
  }
  insert plan {
    id: args.planId
    args.spaceId
    args.ownerUserId
    kind: "adHocAction"
    status: "running"
    args.goal
    requestedBy: args.ownerUserId
    ownerAgentId: args.agentId
    triggerSource: "user.implicit"
    authorizedBy: args.ownerUserId
    input: {kind: "adHocAction"}
  }
}

@enabled
@description("Create a semantic Task -- the Planner-decision unit. Differs from mutationCreateTask (in bff-copresent) by carrying the new category/logicalStepId/attemptNumber fields explicitly. Used by the Planner Agent at decomposition time and by the taskstamp Stamper to materialize the parent semantic Task for ad-hoc tool calls.")
mutation task mutationCreateSemanticTask {
  args {
    taskId          string  @required
    planId          string  @required
    kind            string  @required
    seq             int     @required
    logicalStepId   string
    attemptNumber   int
    phase           string
    input           object  @required
  }
  insert task {
    id: args.taskId
    args.planId
    category: "semantic"
    args.kind
    status: "queued"
    args.seq
    args.phase
    args.logicalStepId
    attemptNumber: coalesce(args.attemptNumber, 1)
    executionSurface: "inProcess"
    args.input
  }
}

@enabled
@description("Create a toolInvocation Task -- the engine-auto-stamped record of an agent tool call. Per Q5+Q6: every tool call by an executing agent produces one of these, parented to the semantic Task that was executing when the tool fired. The engine's tool-dispatch wrapper inserts this row at dispatch time then calls mutationCompleteToolInvocation when the call returns. parentTaskId is required (a toolInvocation row must have a semantic parent); the engine enforces this invariant.")
mutation task mutationCreateToolInvocationTask {
  args {
    taskId          string  @required
    planId          string  @required
    parentTaskId    string  @required
    toolName        string  @required
    toolArgs        object
    seq             int     @required
  }
  insert task {
    id: args.taskId
    args.planId
    args.parentTaskId
    category: "toolInvocation"
    kind: args.toolName
    toolName: args.toolName
    args.toolArgs
    status: "running"
    args.seq
    attemptNumber: 1
    input: coalesce(args.toolArgs, {})
    startedAt: now()
  }
}

@enabled
@description("Update a toolInvocation Task to a terminal state with its result or error. Companion to mutationCreateToolInvocationTask. Status MUST be 'succeeded' or 'failed' (the only terminal transitions a toolInvocation can take -- there is no 'paused' or 'cancelled' on a tool call). On succeeded: toolResult populated. On failed: errorMessage populated.")
mutation task mutationCompleteToolInvocation {
  args {
    taskId        string  @required
    status        string  @required
    toolResult    object
    errorMessage  string
    completedAt   string
  }
  update task {
    id: args.taskId
    args.status
    args.toolResult
    args.errorMessage
    completedAt: coalesce(args.completedAt, now())
  }
}

// -----------------------------------------------------------------------------
// Plan / Task mutations moved from copresent on 2026-05-17.
//
// These were originally authored in memql-bff-copresent/dsl/copresent/
// mutations.memql but the planner is a core node type (build tag
// planner, see app/integrations_planner_init.go); its write surface
// has to be uniformly available on every binary that loads
// concepts, not gated behind copresent being in the import graph.
// The user-cockpit's Planner tab calls these directly, and reproducing
// the "function not found" gating message every 3 seconds was the
// concrete symptom that surfaced the layering bug.
// -----------------------------------------------------------------------------

// mutationCreatePlan -- single write path for Plan creation.
// Status defaults to 'queued' so the routePlanOnQueue automation
// fires immediately. Optional fields accept the full v1 surface
// (parentPlanId for sub-plans, triggerSource for tiered trust,
// chatAnchorMessageId for chat completion lines, tokenBudget +
// pauseExtendsDeadline for budget/deadline overrides).

@enabled
@description("Insert a v1:planner:plan row in status='queued'. Single write path for Plan creation across all trigger sources.")
mutation plan mutationCreatePlan {
  args {
    planId                string
    spaceId               string  @required
    parentPlanId          string
    kind                  string  @required
    goal                  string  @required
    requestedBy           string  @required
    triggerSource         string
    authorizedBy          string
    ownerAgentId          string
    input                 object  @required
    refinementContext     object
    tokenBudget           int
    pauseExtendsDeadline  bool
    chatAnchorMessageId   string
  }
  insert plan {
    id: args.planId
    args.spaceId
    args.parentPlanId
    args.kind
    status: "planning"
    args.goal
    args.requestedBy
    triggerSource: coalesce(args.triggerSource, "user.explicit")
    args.authorizedBy
    args.ownerAgentId
    args.input
    args.refinementContext
    args.tokenBudget
    pauseExtendsDeadline: coalesce(args.pauseExtendsDeadline, false)
    args.chatAnchorMessageId
  }
}

// mutationStartPlan
// =================
//
// Flip a queued Plan to running. Called from the cockpit's Run
// button after the planner has finished decomposing + emitting the
// task list and the user has reviewed them. The dispatch surface
// that consumes status==running events on the planner / agent nodes
// then drives the actual task execution.
@enabled
@description("Promote a Plan from queued (planning complete, tasks emitted) to running. Triggered by the user clicking Run in the cockpit Planner tab, or by an automation that auto-runs plans on the user's behalf.")
mutation plan mutationStartPlan {
  args {
    planId  string  @required
  }
  update plan {
    id: args.planId
    status: "running"
    startedAt: now()
  }
}

// mutationCreateScopeElevationPlan
// =================================
//
// Single write path for scope-elevation Plan creation. Distinct
// from mutationCreatePlan (which writes status='queued' for the
// normal planner pickup path) -- this mutation lands the Plan
// directly in awaitingFeedback / scope_elevation_required so the
// emitScopeElevationCanvasCard automation fires and the card
// shows up on the canvas without going through the routing /
// running lifecycle first.
//
// Triggered by:
//   - integrations/agent/worker/integration.go:handleRequestScope,
//     in turn invoked by the agent's `requestComputerUseScope`
//     tool when an LLM-decided computer_use task needs a scope
//     the agent doesn't currently have.
//
// Resulting state:
//   status              = "awaitingFeedback"
//   feedbackReason      = "scope_elevation_required"
//   computerUseScope    = the requested scope (observe / interact / full)
//   feedbackRequest     = { question, kind: "choice", options: [{label, value}, ...] }
//                         where the question is the agent's intent + summary
//                         and options offer the requested scope down to "deny".
//
// On user approval (frontend):
//   1. mutationUpdateAgentAuthScope on the GA's authorization row
//      with the chosen scope (full / interact / observe).
//   2. mutationUpdatePlanStatus(planId, status='succeeded') so the
//      Plan terminates and the card converts to its post-approval
//      shape.
//
// On deny: mutationUpdatePlanStatus(planId, status='cancelled').

@enabled
@description("Insert a Plan in awaitingFeedback / scope_elevation_required for a pending computer_use task. The emitScopeElevationCanvasCard automation lands the canvas card; the user approves or denies via the card's buttons.")
mutation plan mutationCreateScopeElevationPlan {
  args {
    planId          string  @required
    agentId         string  @required
    ownerUserId     string  @required
    spaceId         string
    intent          string  @required
    summary         string  @required
    requestedScope  string  @required
  }
  insert plan {
    id: args.planId
    kind: "scopeElevation"
    status: "awaitingFeedback"
    feedbackReason: "scope_elevation_required"
    computerUseScope: args.requestedScope
    goal: args.intent
    ownerAgentId: args.agentId
    requestedBy: args.ownerUserId
    triggerSource: "agent.proactive"
    args.spaceId
    input: {
        intent: args.intent,
        summary: args.summary,
        args.requestedScope
      }
    feedbackRequest: {
        question: args.intent,
        kind: "choice",
        options: [
          {label: concat("Allow with ", args.requestedScope, " scope"), value: args.requestedScope},
          {label: "Deny", value: "deny"}
        ]
      }
  }
}

// mutationRequestPlanFeedback
// ===========================
//
// Transition an EXISTING, running Plan to awaitingFeedback /
// feedback_required when the owning agent (via the requestUserFeedback
// tool) needs the user to supply missing detail mid-task. The generic
// counterpart to mutationCreateScopeElevationPlan: that one INSERTS a
// fresh scope-elevation Plan; this one UPDATEs the Plan the agent is
// already running inside (so the chat anchor, goal, ownership, phases,
// and accumulated metrics are all preserved).
//
// Partial-update via update() -- only status / feedbackReason /
// feedbackRequest change; every @required field inherits from the
// prior row.
//
// Triggered by:
//   - integrations/agents/integration.go:handleRequestUserFeedback,
//     invoked by the agent's `requestUserFeedback` tool.
//
// Resulting state:
//   status          = "awaitingFeedback"
//   feedbackReason  = "feedback_required"
//   feedbackRequest = { question, kind: choice|text|multi,
//                       options?: [{label, value}], askedAt,
//                       timeoutAt? }
//
// Resume (existing mechanism, unchanged): the user's answer stamps
// Plan.feedbackResponse {response, respondedBy, respondedAt} and bumps
// status back to running; the planner integration's
// awaitingFeedback -> running subscriber re-invokes the owning agent
// with the persisted TaskState + feedbackResponse in context.
//
// The plan.awaitingFeedback canvas-card producer for the
// feedback_required variant lives in the BFF
// (memql-bff-copresent/dsl/copresent/) and ships in the follow-up BFF
// wave; only the scope_elevation_required producer exists today.

@enabled
@description("Transition an existing running Plan to awaitingFeedback / feedback_required with a feedbackRequest{question, kind, options?, timeoutAt}. Backs the requestUserFeedback agent tool. Partial-update via update() -- only status / feedbackReason / feedbackRequest change; required fields inherit from the prior row. The user's answer (feedbackResponse + status->running) resumes the Plan via the existing planner re-invocation path.")
mutation plan mutationRequestPlanFeedback {
  args {
    planId           string  @required
    feedbackRequest  object  @required
  }
  update plan {
    id: args.planId
    status: "awaitingFeedback"
    feedbackReason: "feedback_required"
    args.feedbackRequest
  }
}

@enabled
@description("Insert a v1:planner:task row in status='queued'. Single write path for Task creation, called by the planner during decomposition.")
mutation task mutationCreateTask {
  args {
    taskId            string
    planId            string  @required
    kind              string  @required
    seq               int     @required
    phase             string
    executionSurface  string
    executorBackend   string
    input             object  @required
  }
  insert task {
    id: args.taskId
    args.planId
    args.kind
    status: "queued"
    args.seq
    args.phase
    executionSurface: coalesce(args.executionSurface, "inProcess")
    args.executorBackend
    args.input
  }
}

@enabled
@description("Persist a Task's working state for async parking + planner re-invocation. Called when a Task transitions to paused / awaitingFeedback.")
mutation taskState mutationPersistTaskState {
  args {
    stateId            string
    taskId             string  @required
    workingMemory      object
    reasoningChain     string
    toolCallHistory    object
    pendingSubPlanIds  object
  }
  insert taskState {
    id: args.stateId
    args.taskId
    args.workingMemory
    args.reasoningChain
    args.toolCallHistory
    args.pendingSubPlanIds
  }
}

// mutationUpdatePlanStatus -- partial Plan status transition.
// Bumps payload.status; optional args land any additional state the
// transition produces (assigned agent, output, error, lifecycle
// timestamps, pause/feedback bookkeeping, recommendationCardId,
// metrics rollups, estimate refresh, token spend updates, etc.).
//
// Uses update() (read-merge-validate-write) instead of insert() so
// the caller doesn't have to re-pass every @required field on the
// Plan concept (spaceId, kind, goal, requestedBy, triggerSource,
// input). The engine reads the latest existing row, splats the
// supplied fields on top, validates the merged payload against the
// concept schema, and appends the merged row -- queries keep
// resolving by createdAt-desc so the new row wins.

@enabled
@description("Update a Plan's status with the full v1 lifecycle field set (paused/awaitingFeedback/needsAgent + metrics + estimate + token spend). Partial-update via update() -- only the fields you pass are changed; required fields inherit from the prior row.")
mutation plan mutationUpdatePlanStatus {
  args {
    planId                    string  @required
    status                    string  @required
    ownerAgentId              string
    output                    object
    errorMessage              string
    startedAt                 string
    completedAt               string
    cancelledBy               string
    pausedAt                  string
    totalPausedMs             int
    feedbackRequest           object
    feedbackResponse          object
    feedbackReason            string
    recommendationCardId      string
    phases                    []object
    estimate                  object
    estimatedAt               string
    tokenSpent                int
    tokenAllocatedToChildren  int
    metrics                   object
    computerUseScope          string
  }
  update plan {
    id: args.planId
    args.status
    args.ownerAgentId
    args.output
    args.errorMessage
    args.startedAt
    args.completedAt
    args.cancelledBy
    args.pausedAt
    args.totalPausedMs
    args.feedbackRequest
    args.feedbackResponse
    args.feedbackReason
    args.recommendationCardId
    args.phases
    args.estimate
    args.estimatedAt
    args.tokenSpent
    args.tokenAllocatedToChildren
    args.metrics
    args.computerUseScope
  }
}

// mutationRecordPlannerInvocation -- bump the cumulative per-plan LLM
// spend counters without touching status. Used by the Planner Agent
// loop after every plannerAgent call to advance metrics.llmCallCount +
// tokenSpent so the hard per-plan ceiling (memql#819) keeps climbing
// toward its limit across cycles / retries. Partial-update so the
// Plan's @required fields (status, goal, etc.) inherit from the prior
// row -- this is NOT a status transition.
@enabled
@description("Record a planner-agent LLM invocation against a Plan: advance metrics.llmCallCount + tokenSpent without changing status. Caller computes the new totals Go-side (the parser has no arithmetic).")
mutation plan mutationRecordPlannerInvocation {
  args {
    planId      string  @required
    tokenSpent  int
    metrics     object
  }
  update plan {
    id: args.planId
    args.tokenSpent
    args.metrics
  }
}

// mutationUpdateTaskStatus -- partial Task status transition.
// Partial-update via update() so the caller doesn't have to re-pass
// the Task concept's @required fields (planId, kind, seq,
// executionSurface, input). The engine reads the latest existing
// row by id, splats the supplied fields on top, validates the
// merged payload, and appends the merged row.

@enabled
@description("Update a Task's status with optional output / error / lifecycle / metrics / parking fields. Partial-update via update() -- only the fields you pass change; required fields inherit from the prior row.")
mutation task mutationUpdateTaskStatus {
  args {
    taskId              string  @required
    status              string  @required
    output              object
    errorMessage        string
    startedAt           string
    completedAt         string
    parkedAt            string
    parkedAtCheckpoint  string
    metrics             object
  }
  update task {
    id: args.taskId
    args.status
    args.output
    args.errorMessage
    args.startedAt
    args.completedAt
    args.parkedAt
    args.parkedAtCheckpoint
    args.metrics
  }
}

// -----------------------------------------------------------------------------
// Responsibility CRUD (epic #631 / program #629).
//
// A responsibility is a user-authored standing directive aimed at an
// agent, in three archetypes (reactive / standing / recurring). It
// folds in and replaces the retired standingTask concept -- recurring
// responsibilities carry the cron schedule standingTask used to.
//
// Authorization (owned tier): create stamps ownerUserId from
// actor.userId; the status + evaluation update paths re-stamp
// ownerUserId: actor.userId so the conformance classifier buckets
// them as owned and a caller can only ever rewrite their own rows.
// -----------------------------------------------------------------------------

@enabled
@description("Create a v1:planner:responsibility in status='draft'. ownerUserId is stamped from actor.userId (owned tier) so a caller cannot author a directive owned by someone else. trigger discriminates the archetype: recurring carries schedule, reactive carries condition, standing carries neither. Single write path for responsibility creation.")
mutation responsibility mutationCreateResponsibility {
  args {
    responsibilityId  string
    statement         string  @required
    trigger           string  @required  @enum("reactive", "standing", "recurring")
    schedule          string
    condition         object
    targetKind        string  @enum("assistant", "specialist", "unassigned")
    assignedAgentId   string
    assignedRoleSlug  string
    successCriteria   string
    notifyHow         string
    scopeSpaceId      string
    enabled           bool
  }
  insert responsibility {
    id: args.responsibilityId
    ownerUserId: actor.userId
    args.statement
    args.trigger
    args.schedule
    args.condition
    targetKind: coalesce(args.targetKind, "unassigned")
    args.assignedAgentId
    args.assignedRoleSlug
    args.successCriteria
    args.notifyHow
    args.scopeSpaceId
    enabled: coalesce(args.enabled, true)
    status: "draft"
  }
}

@enabled
@description("Update an existing v1:planner:responsibility's editable fields (statement / schedule / condition / target binding / scope / enabled). Partial-update via update() -- only the fields you pass change; required fields inherit from the prior row. ownerUserId re-stamped from actor.userId (owned tier) so a caller can only rewrite their own rows.")
mutation responsibility mutationUpdateResponsibility {
  args {
    responsibilityId  string  @required
    statement         string
    trigger           string  @enum("reactive", "standing", "recurring")
    schedule          string
    condition         object
    targetKind        string  @enum("assistant", "specialist", "unassigned")
    assignedAgentId   string
    assignedRoleSlug  string
    successCriteria   string
    notifyHow         string
    scopeSpaceId      string
    enabled           bool
  }
  update responsibility {
    id: args.responsibilityId
    ownerUserId: actor.userId
    args.statement
    args.trigger
    args.schedule
    args.condition
    args.targetKind
    args.assignedAgentId
    args.assignedRoleSlug
    args.successCriteria
    args.notifyHow
    args.scopeSpaceId
    args.enabled
  }
}

@enabled
@description("Transition a v1:planner:responsibility's lifecycle status (draft / active / paused / archived). Partial-update via update(); ownerUserId re-stamped from actor.userId (owned tier).")
mutation responsibility mutationSetResponsibilityStatus {
  args {
    responsibilityId  string  @required
    status            string  @required  @enum("draft", "active", "paused", "archived")
  }
  update responsibility {
    id: args.responsibilityId
    ownerUserId: actor.userId
    args.status
  }
}

@enabled
@description("Record the outcome of an evaluation/run on a v1:planner:responsibility: stamp lastEvaluatedAt to now() and lastResult to the run headline. Called by the reactive-loop evaluator (epic #632) after a reactive condition check, a recurring scheduled tick, or a standing review. ownerUserId re-stamped from actor.userId (owned tier).")
mutation responsibility mutationRecordResponsibilityEvaluation {
  args {
    responsibilityId  string  @required
    lastResult        string  @required
  }
  update responsibility {
    id: args.responsibilityId
    ownerUserId: actor.userId
    args.lastResult
    lastEvaluatedAt: now()
  }
}

@enabled
@description("Persist a routing decision onto a v1:planner:responsibility (epic #632, C2): bind the resolved agent (assignedAgentId), optional role slug (assignedRoleSlug), and flip targetKind off 'unassigned' onto the concrete kind (assistant / specialist). Called by the reactive-loop router after agentFactoryAnalyze + createSpecialist/extendSpecialist mint or match an agent. Partial-update via update(); ownerUserId re-stamped from actor.userId (owned tier) so the router can only rewrite the row's own owner -- the poller impersonates the responsibility's owner in the AccessContext before calling, so this lands as an owned write.")
mutation responsibility mutationAssignResponsibility {
  args {
    responsibilityId  string  @required
    targetKind        string  @required  @enum("assistant", "specialist")
    assignedAgentId   string
    assignedRoleSlug  string
  }
  update responsibility {
    id: args.responsibilityId
    ownerUserId: actor.userId
    args.targetKind
    args.assignedAgentId
    args.assignedRoleSlug
  }
}

// -----------------------------------------------------------------------------
// Responsibility intake (issue #637 -- epic #631 / program #629).
//
// The intake dispatcher (integrations/planner/responsibility_intake.go)
// runs the responsibilityIntake prompt on a freshly-created draft and
// writes the result through these three mutations. They are called by the
// system:planner actor, NOT the owner, so -- exactly like
// mutationUpdatePlanStatus -- they DO NOT re-stamp ownerUserId (the
// partial update() inherits it from the prior row) and never reference a
// user-scope field, so they classify as system writes rather than the
// owned tier. Authoring the row stays owned (mutationCreateResponsibility
// stamps ownerUserId from the human caller); these intake transitions are
// engine-internal bookkeeping on a row the human already owns.
// -----------------------------------------------------------------------------

@enabled
@description("Mark a v1:planner:responsibility's intake as in-progress (issue #637). The intake dispatcher calls this when it claims a freshly-created draft so a created+updated double-fire (or a multi-node race) doesn't run the responsibilityIntake prompt twice -- intakeStatus flips '' -> 'pending'. System write (system:planner actor): no ownerUserId re-stamp, no user-scope reference, so it's engine-internal bookkeeping on a row the human already owns.")
mutation responsibility mutationMarkResponsibilityIntakePending {
  args {
    responsibilityId  string  @required
  }
  update responsibility {
    id: args.responsibilityId
    intakeStatus: "pending"
  }
}

@enabled
@description("Apply the responsibilityIntake result to a draft v1:planner:responsibility (issue #637). The dispatcher stamps the inferred field set (trigger / schedule / condition / targetKind / assignedRoleSlug / successCriteria / notifyHow) plus the intake outcome. When intake was CLEAR (no questions) the dispatcher passes status='active' + intakeStatus='clear' so the row goes straight live; when intake produced 1-2 questions it passes status='draft' + intakeStatus='awaitingAnswers' + intakeRequest so the row parks for the user (mirrors the Plan awaitingFeedback surfacing). Partial-update: only the supplied fields change. System write -- no ownerUserId re-stamp.")
mutation responsibility mutationApplyResponsibilityIntake {
  args {
    responsibilityId  string  @required
    trigger           string  @enum("reactive", "standing", "recurring")
    schedule          string
    condition         object
    targetKind        string  @enum("assistant", "specialist", "unassigned")
    assignedRoleSlug  string
    successCriteria   string
    notifyHow         string
    status            string  @enum("draft", "active", "paused", "archived")
    intakeStatus      string  @enum("", "pending", "awaitingAnswers", "clear", "applied")
    intakeRequest     object
  }
  update responsibility {
    id: args.responsibilityId
    args.trigger
    args.schedule
    args.condition
    args.targetKind
    args.assignedRoleSlug
    args.successCriteria
    args.notifyHow
    args.status
    args.intakeStatus
    args.intakeRequest
  }
}

@enabled
@description("Fold the user's answers to the intake clarifying questions back into a v1:planner:responsibility and re-stamp the re-inferred field set (issue #637). Called after the user answers the intakeRequest questions: the dispatcher re-runs responsibilityIntake with the answers folded in, then writes the final trigger / schedule / condition / targetKind / assignedRoleSlug / successCriteria / notifyHow, records intakeResponse for audit, sets intakeStatus='applied', and flips status='active'. System write -- no ownerUserId re-stamp.")
mutation responsibility mutationFoldResponsibilityIntakeAnswers {
  args {
    responsibilityId  string  @required
    intakeResponse    object  @required
    trigger           string  @enum("reactive", "standing", "recurring")
    schedule          string
    condition         object
    targetKind        string  @enum("assistant", "specialist", "unassigned")
    assignedRoleSlug  string
    successCriteria   string
    notifyHow         string
  }
  update responsibility {
    id: args.responsibilityId
    args.trigger
    args.schedule
    args.condition
    args.targetKind
    args.assignedRoleSlug
    args.successCriteria
    args.notifyHow
    args.intakeResponse
    intakeStatus: "applied"
    status: "active"
  }
}
