// Organization registry reads and account-specific views of related work.
// True organization-owned concepts are filtered by the engine's current
// membership and scoped-permission boundary. Multi-account artifacts and
// knowledge records keep their separate sharing/label semantics; grouping
// them here does not turn a label into singular ownership.

use campaigns.concepts.{ campaign }
use campaigns.shapes.{ campaignFull }
use common.traits.{ isNotArchived, isNotDeleted, statusIsActive }
use identity.concepts.{ invitation }
use identity.shapes.{ invitationAdminSummary }
use knowledge.concepts.{ knowledgeDomain }
use knowledge.shapes.{ knowledgeDomainFull }
use library.concepts.{ artifact }
use library.shapes.{ artifactFull }
use platform.concepts.{ site }
use platform.shapes.{ siteFull }

/// Accounts authorized for this caller, including clients a cluster operator
/// may manage. Organization members use the same query for their pickers.
/// Archived rows are excluded unless includeArchived is explicitly true;
/// omitted and false both return only current organizations.
@actor
query account clientAccountsAll {
  args {
    includeArchived  boolean
  }
  filter  row => isNotArchived(row) || args.includeArchived == true
  shape   clientAccountFull
  sort    "name", "asc"
}

/// Resolve one account by its own row id. The detail view's read on open, and
/// the read every tie surface uses to put a name on an id it holds.
@unbounded("account by id -- bounded to a single row (id is the row's own primary key)")
@actor
query account clientAccountById {
  args {
    accountId  string!
  }
  filter  row => row.id == args.accountId
  shape   clientAccountFull
}

/// The `self` singleton, if it has been materialized. The boot seed's existence
/// probe, and nothing else calls it.
///
/// IT CARRIES THE COMPOSITE TIER, AND THE AUTOMATION IS ELEVATED TO MATCH.
/// The first cut of this query omitted the tier conjunct, on the reasoning that
/// the caller is a boot automation with no signed-in person behind it. The
/// row-authz land gate refused it, and the gate was right: enforcement ANDs the
/// tier into every read of this concept whatever the filter says, so omitting
/// it does not make the read unscoped -- it makes the read SILENTLY narrowed,
/// and the `self` row is cluster-owned (ownerUserId empty), which the owned
/// branch can never match.
///
/// What that would have cost is worse than the two maintenance sweeps whose
/// entries sit beside this automation's in component/auth/maintenance_actor.go,
/// and worse in the opposite direction. A narrowed sweep skips work and looks
/// idle. A narrowed probe here reports the row ABSENT -- and absent means
/// CREATE, so the seed would re-run on every boot forever, which is precisely
/// the clobbering D3 forbids. `seedSelfAccount` is therefore on the maintenance
/// allowlist, which runs it as RoleOwner: the cluster-owner escape is the only
/// branch that can see this row, and the automation now has it.
///
/// @serverOnly is the other half. An ungated read projecting contact fields is
/// the `searchUsers` shape the PII gate exists to refuse (memql#2883), and the
/// app has no business calling this one -- it reads the same row through
/// `clientAccountById`, which carries the same tier and is on the wire.
///
/// WHY actor.userId SCOPING IS NOT THE FIX. There is no actor and there is no
/// owner. The caller is a boot automation, so no person is signed in for
/// `actor.userId` to name; and the row it looks for is CLUSTER-OWNED --
/// `ownerUserId` is empty by design, because the owner's own company is the
/// deployment's row rather than whichever principal happened to boot it, and
/// sameRowAuthzOwner refuses an empty owner outright. So a self-scoped filter
/// would match zero rows for the only caller this query will ever have, and
/// borrowing one user's authority (auth.ContextWithUserActor) would not help
/// either: there is no owner to borrow. The cluster-owner escape is the only
/// branch that can see this row, which is why the automation is on the
/// maintenance list rather than this query being scoped.
@actor
@serverOnly
@unbounded("the self account singleton -- bounded to a single row (literal id)")
query account existingSelfAccount {
  filter  row => row.id == "v1:accounts:account:self"
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   clientAccountFull
}

// ---------------------------------------------------------------------------
// The four rollups
// ---------------------------------------------------------------------------

/// The deployables tied to one account.
///
/// `isNotDeleted` is `sitesAll`'s own conjunct, repeated here rather than
/// referenced: this is the same read that query makes, narrowed by the tie
/// field, and a soft-deleted site must stay gone from a rollup for the reason
/// it is gone from the list.
///
/// NO CALLER TERM, DELIBERATELY (memql#5303, design 2026-09-11-app-access-grants
/// D4). This is the account VIEW -- the one read whose whole purpose is the tie
/// -- and it used to carry `(ownerUserId==actor.userId ||
/// actor.isClusterOwner==true)` beside the tie field, which is the tier's first
/// two arms restated minus the third: a member of Acme's group was admitted to
/// Acme's sites by `account="accountId"` and then filtered out by this query.
/// The tier decides the row set; TestAccountGrantReachesTheAccountView reads it
/// for a member and a stranger, and tierDecidesTheRead records the construct.
///
/// `isNotArchived` joined them when v1:platform:site gained the archived rung
/// (epic memql#4794, D10), and it is not optional for a ROLLUP: the band this
/// feeds says "and N more, in Deployables", so a count that included archived
/// sites would point the reader at a list that disagrees with it. A band is a
/// count of what is currently filed for a client, not of everything ever --
/// which is the same reading libraryItemsForAccount already takes.
@actor
query site sitesForAccount {
  args {
    accountId  string!
  }
  filter  row => row.accountId == args.accountId && isNotDeleted(row) && isNotArchived(row)
  shape   siteFull
  sort    "hostname", "asc"
}

/// The Library items labelled with one account.
///
/// `accountIds` is a LIST (D5 -- "one or two accounts" is the owner's own
/// framing), so the tie term is membership rather than equality.
///
/// ARCHIVED ROWS ARE EXCLUDED, matching `libraryArtifacts` rather than this
/// file's own `clientAccountsAll`: the account filter above is a view over the
/// registry a person is administering, while this is a count of what is
/// currently filed for a client. `row.archived != true` rather than
/// `row.archived == false`, because a row promoted before the field existed
/// carries no key at all and `row.archived == false` would silently exclude it.
@actor
query artifact libraryItemsForAccount {
  args {
    accountId  string!
  }
  filter  row => args.accountId in row.accountIds && row.archived != true && row.ownerUserId == actor.userId
  shape   artifactFull
  sort    "updatedAt", "desc"
}

/// The knowledge domains tagged with one account.
///
/// A TAG AND NOTHING MORE (D5). This read is the only consumer of
/// `v1:knowledge:knowledgeDomain.accountId` in the tree, and the field is
/// consulted by nothing in routing, attachment, retrieval or scoring. A domain
/// tagged with an account trains, attaches and answers exactly as an untagged
/// one does.
///
/// No tier conjunct, and that is now declared rather than absent (memql#4809):
/// `v1:knowledge:knowledgeDomain` carries `@rowAuthz(public, requiresIdentity)`,
/// meaning its rows have no row-level distinction to draw and its authorization
/// lives at the surface instead.
///
/// @requiresRank("admin") is that surface half here, and the floor is a rung
/// ABOVE its sibling `knowledgeDomainsAll` on the same concept deliberately:
/// this read is reached from the Accounts app (`roles: { min: "admin" }`) and
/// answers a question about one CLIENT, while the catalog list answers a
/// question about the cluster. Same rows, two questions, two floors -- which is
/// exactly the asymmetry a per-row tier could not have expressed.
@requiresRank("admin")
query knowledgeDomain domainsForAccount {
  args {
    accountId  string!
  }
  filter  row => row.accountId == args.accountId
  shape   knowledgeDomainFull
  sort    "name", "asc"
}

/// The guest invitations sent on behalf of one account.
///
/// `invitationAdminSummary`, NEVER `invitationFull`, and this is the rule the
/// Users app's own review wrote (memql#4735): `invitationFull` projects
/// `tokenHash`, `previousTokenHash` and `bindingHash` -- not the plaintext
/// token, but the key the resolve path looks an invitation up BY -- and a
/// rollup that says how many guests a client has has never needed them.
///
/// `@requiresRank("developer")` is `pendingUserInvitations`' own gate, carried
/// here for the same reason: the invitation concept declares no row tier, so
/// this floor IS the authorization on this read, and a rollup that dropped it
/// would be the shortest path in the product to reading every invitation in
/// the cluster. It FOLLOWS that gate rather than restating one, which is what
/// keeps the two in step -- the pair widened together when developers gained
/// the admission capability, and moved together from a spec conjunct to the
/// annotation in epic memql#5166. Below the floor the CALL is now refused
/// rather than the result emptied, which is the more honest answer: an empty
/// list is indistinguishable from "nobody is waiting".
@actor
@requiresRank("developer")
query invitation invitationsForAccount {
  args {
    accountId  string!
  }
  filter  row => row.accountId == args.accountId
  shape   invitationAdminSummary
  sort    "row.createdAt", "desc"
}

/// The email campaigns run for one account.
///
/// The composite-tier term is `campaigns`' own conjunct, repeated here rather than referenced: this
/// is the same read that query makes, narrowed by the tie field. `sitesForAccount` above dropped its
/// copy under memql#5303 (D4) because v1:platform:site declares the account argument; campaigns
/// keep theirs, because a rollup that dropped the tier predicate would be the shortest path in the
/// product to reading every operator's campaigns.
///
/// It counts CAMPAIGNS and not sends. A band that said "4,182" would be counting delivery rows,
/// which is a number about one busy week rather than about the client -- and the delivery ledger is
/// deliberately not readable in bulk from here at all (memql#4823). Cancelled and failed campaigns
/// are included: a rollup is what is filed for this client, and a send that failed is still work
/// that happened.
@actor
query campaign campaignsForAccount {
  args {
    accountId  string!
  }
  filter  row => row.accountId == args.accountId
  shape   campaignFull
  sort    "row.createdAt", "desc"
}

/// Every active account, for the boot backfill that gives each one its group.
///
/// A SWEEP SET, not a page, and NOT clientAccountsAll (epic memql#5165, D5).
/// That query is the Accounts app's list: it carries the caller-scope
/// disjunction an operator surface needs and an @requiresRank floor, both of
/// which are wrong for a sweep running under the seed materializer's system
/// actor at boot, where there is no requesting user for actor.userId to name
/// and no role for a rank floor to clear. usersForSeedSweep is the same
/// argument for the same reason one rung down.
@actor
@serverOnly
@unbounded("the boot backfill must see EVERY active account -- a truncated page leaves an account with no group, which is a client whose people can reach none of their work, and nothing reports it")
query account accountsForGroupSweep {
  filter  row => actor.isClusterOwner == true && statusIsActive(row)
  shape   accountIdRef
}

/// Every active account whose domain is set and whose ownership is not yet proven.
///
/// THE WALK'S WHOLE COST CONTROL. A verified account never comes back from this
/// read, so a cluster whose clients are all verified spends one query per tick
/// and no DNS lookups at all -- which is what makes a two-minute schedule
/// affordable. The Go walk re-states the same two conditions as a guard rather
/// than trusting this filter, so a future widening here cannot silently start
/// spending lookups on rows that are done.
///
/// actor.userId scoping is not the fix and is not available: the walk runs from
/// a scheduled automation under the engine's own actor, where actor.userId names
/// nobody -- and scoping it to one person would leave every other client's
/// domain unverified forever.
@actor
@serverOnly
@unbounded("the domain walk must see EVERY account still waiting on its DNS record -- a truncated page leaves a client's domain unverified indefinitely, and the person watching the panel has no way to tell that from a record they typed wrong")
query account accountsForDomainWalk {
  filter  row => actor.isClusterOwner == true
              && statusIsActive(row)
              && row.domainStatus != "verified"
              && row.domain != ""
  shape   accountDomainWalk
}

/// Every active account that HOLDS a reserved MemQL name -- the account front door's work list
/// (epic memql#5168).
///
/// IT RETURNS EVERY ACCOUNT WITH A NAME, HELD OR NOT, and the Go side splits them -- because the
/// sweep has two jobs over one set and a second query would read the same rows twice. HELD is
/// `memqlReservedAt`, NOT `memqlDomain`: the reservation is stamped in the SAME write that verifies
/// the domain, and only when the name also passed the guardrails, so a non-empty memqlDomain with
/// no memqlReservedAt is a name somebody typed that this cluster has not agreed to serve. Opening a
/// door for one would request a certificate for three hosts whose ownership is unproven. The unheld
/// ones get memqlReservationReason written instead, so the Accounts rail can say WHY rather than
/// inferring it from the ownership stop beside it.
///
/// SHARES accountDomainWalk's shape rather than adding one: the sweep reads exactly the three
/// fields that projection already carries (the id, the name, and whether it is held), and a second
/// shape over the same three would be a second thing to keep in step.
///
/// actor.userId scoping is not the fix and is not available, accountsForDomainWalk's reasoning: the
/// sweep runs from a scheduled automation under the engine's own actor, where actor.userId names
/// nobody, and scoping it to one person would leave every other client's front door unreconciled.
@actor
@serverOnly
@unbounded("the account front-door sweep must see EVERY held reservation -- a truncated page leaves a client's door unopened, or worse leaves a withdrawn one serving, and the person watching the stop has no way to tell either from a record they typed wrong")
query account accountsWithAReservedName {
  filter  row => actor.isClusterOwner == true && statusIsActive(row) && row.memqlDomain != ""
  shape   accountDomainWalk
}

/// The account, if any, that has PROVEN this domain and switched joining on.
///
/// ALL THREE CONDITIONS ARE HERE rather than in the Go that calls it (epic
/// memql#5165, D9): active, `row.domainStatus == "verified"`, and joinOnDomain. A
/// condition checked in Go after a broader read is one somebody can drop while
/// the read keeps working -- and each of these is the difference between a
/// client's group and a stranger's.
///
/// SORTED, so a cluster where two accounts happen to name one domain gives one
/// stable answer rather than a different one per replica. Two accounts CAN name
/// the same domain -- nothing stops an operator typing it twice -- and joining
/// somebody to both would hand one person reach into two clients on an
/// ambiguity nobody declared.
///
/// actor.userId scoping is not the fix and would break the feature: this runs at
/// ARRIVAL, from the invitation-acceptance and first-sign-in seams, where the
/// caller is the person being provisioned and they own no account at all.
@actor
@serverOnly
query account accountForDomainJoin {
  args {
    domain  string!
  }
  filter  row => actor.isClusterOwner == true
              && row.domain == args.domain
              && statusIsActive(row)
              && row.domainStatus == "verified"
              && row.joinOnDomain == true
  shape   accountIdRef
  sort    "row.createdAt", "asc"
}
