use common.traits.{ statusIsActive }

/// Minimal organization facts for authenticated work context.
@row
shape account workOrganizationContext {
  row.id
  name
  status
}

@actor
@unbounded("one organization, still subject to current row permissions")
query account workViewerOrganization {
  args { accountId string! }
  filter row => row.id == args.accountId && statusIsActive(row)
  shape workOrganizationContext
}
