// The boot seed: the owner's own company, as account #1.
//
// SEEDED, not special-cased, for the reason the portal is site #1: the
// Accounts app is where clients are managed, and an instance whose registry
// opens empty gives its owner nothing to recognize -- the first thing they
// should see is themselves, already in it. It also gives the four tie pickers
// a target on a cluster where nobody has typed anything yet.
//
// ===========================================================================
// AN AUTOMATION RATHER THAN A `seed` BLOCK, AND THE REASON IS MECHANICAL
// ===========================================================================
// The declarative seed path would have been the obvious home for this. It is
// not available: the SeedMaterializer derives the mutation it calls from the
// CONCEPT name -- `"create" + ucFirst(conceptName)` (seed_materializer.go) --
// so a `seed account self { ... }` block resolves to `createAccount`, which
// `dsl/identity/mutations.memql` has owned since long before this domain
// existed and which writes an entirely different concept. There is no hook to
// point it at `createClientAccount`, and renaming the concept to reach one
// would change `v1:accounts:account:self` -- the id the OS, the design record
// and the custom-domains epic all key on.
//
// So the seed takes the other shape the engine already has for a literal-id
// singleton, which is the one D3 names anyway: `bootstrapCluster`'s
// startup-triggered, absence-gated create (dsl/cluster/automations.memql).
// Same machinery, opposite gate -- see dsl/accounts/logic.memql.
use identity.builtins.{ groupEnsureForAccount, groupArchiveForAccount }
use platform.builtins.{ accountDomainReconcile }

/// Materialize the owner's own company on first startup
@trigger(event="system.startup")
automation seedSelfAccount {
  args {
    domain any
    node any
  }

  step decide {
    logic selfAccountAbsent (
      event
    )
  }

  // THE ID IS A LITERAL, and that is the accurate statement rather than a
  // shortcut: there is exactly one company that is this instance's owner.
  // It is also what makes the gate above meaningful -- a minted id would be
  // absent on every boot forever.
  //
  // `name` is a STARTER, not a claim. Nothing a boot can read knows what this
  // company is called, so the row says so plainly and the first-run card asks
  // (D7). `configuredAt` is left unwritten and that absence IS the card.
  //
  // `domain` comes from MEMQL_DOMAIN, forwarded onto the startup payload by
  // app/cluster.go. Every field binds an explicit key + a `??` fallback, mirroring
  // bootstrapCluster: a multi-segment path evaluates to nil when absent, and a
  // nil argument for a required arg trips validation.
  step selfAccount {
    if steps.decide.result == true {
      mutation createClientAccount (
        accountId: "v1:accounts:account:self",
        name:      "My company",
        domain:    domain ?? ""
      )
    }
  }

  // THE SELF ACCOUNT'S DOMAIN IS VERIFIED BY THE FACT OF THE DEPLOYMENT
  // (epic memql#5165, section B). This cluster SERVES that domain -- its
  // front door answers on it, its certificate names it -- so asking the
  // owner to publish a TXT record proving they own it would be the cluster
  // asking itself for evidence it already is.
  //
  // A SECOND STEP rather than arguments on createClientAccount, because
  // that mutation is client-reachable and @requiresRank("admin"): letting a
  // caller pass domainStatus would let any admin declare any client's domain
  // verified, which is the one thing the walk exists to decide.
  //
  // Gated on the same absence check as the create, so a re-boot writes no
  // version. Changing the self account's domain afterwards puts it through
  // the ordinary walk like anybody else's -- the reset in
  // component/memql/account_domain_validation.go does not exempt it.
  step selfAccountDomain {
    if steps.decide.result == true {
      mutation recordAccountDomainCheck (
        accountId:        "v1:accounts:account:self",
        domainStatus:     "verified",
        domainVerifiedAt: now,
        memqlReservedAt:  now
      )
    }
  }
}

// ---- The account's own group (epic memql#5165, D5) ----
//
// Every account gets one, and the two writers below are the whole lifecycle:
// created with the account, archived with it. The third writer is the boot
// backfill in component/memql/seed_materializer.go, which calls the SAME
// builtin for every active account -- so the property that matters is
// idempotency, and it comes from the derived id acct-<accountShortId> rather
// than from any of the three callers being careful.

/// Give a new account its group.
@trigger(event="node.created", concept="v1:accounts:account", partition="*")
automation ensureAccountGroup {
  args {
    id any
  }

  step ensure {
    builtin groupEnsureForAccount (
      accountId: id
    )
  }
}

/// Archive an account's groups when the account is archived, and remove their
/// memberships.
///
/// THE FILTER IS WHAT MAKES THIS CORRECT, not a refinement of it. `node.updated`
/// fires on every write to an account -- the domain walk alone writes
/// domainLastCheckedAt every two minutes -- so without the status test this
/// would run a cascade on a live account hundreds of times a day, and each run
/// would find nothing to do only because the groups it walks are already
/// active. The one time it mattered would be indistinguishable from the noise.
@trigger(event="node.updated", concept="v1:accounts:account", partition="*")
@filter(row => row.status == "archived")
automation archiveAccountGroup {
  args {
    id any
  }

  step cascade {
    builtin groupArchiveForAccount (
      accountId: id
    )
  }
}

/// Walk every client's own domain: mint its ownership token, check the TXT
/// record, and stamp verification and the reserved MemQL name on success.
///
/// THE SAME TWO MINUTES reconcileCustomDomains uses, and for the same reason:
/// somebody has just pasted a record into a registrar and is watching the
/// panel. The cost is bounded by the population of UNVERIFIED accounts rather
/// than by all of them -- accountsForDomainWalk excludes the verified -- so a
/// cluster whose clients are all set up pays one query per tick.
@trigger(schedule="0 */2 * * * *")
automation reconcileAccountDomains {
  step walk {
    builtin accountDomainReconcile ()
  }
}
