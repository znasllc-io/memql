// The boot seed: the owner's own company, as account #1.
//
// SEEDED, not special-cased, for the reason the portal is site #1: the
// Accounts app is where clients are managed, and an instance whose registry
// opens empty gives its owner nothing to recognize -- the first thing they
// should see is themselves, already in it. It also gives the four tie pickers
// a target on a cluster where nobody has typed anything yet.
//
// ===========================================================================
// AN AUTOMATION RATHER THAN A `seed` BLOCK, AND THE REASON IS MECHANICAL
// ===========================================================================
// The declarative seed path would have been the obvious home for this. It is
// not available: the SeedMaterializer derives the mutation it calls from the
// CONCEPT name -- `"create" + ucFirst(conceptName)` (seed_materializer.go) --
// so a `seed account self { ... }` block resolves to `createAccount`, which
// `dsl/identity/mutations.memql` has owned since long before this domain
// existed and which writes an entirely different concept. There is no hook to
// point it at `createClientAccount`, and renaming the concept to reach one
// would change `v1:accounts:account:self` -- the id the OS, the design record
// and the custom-domains epic all key on.
//
// So the seed takes the other shape the engine already has for a literal-id
// singleton, which is the one D3 names anyway: `bootstrapCluster`'s
// startup-triggered, absence-gated create (dsl/cluster/automations.memql).
// Same machinery, opposite gate -- see dsl/accounts/logic.memql.
use identity.builtins.{ groupEnsureForAccount, groupArchiveForAccount }
use platform.builtins.{ accountDomainReconcile }

/// Materialize the owner's own company on first startup
@trigger(event="system.startup")
automation seedSelfAccount {
  args {
    node any
  }

  decide := logic selfAccountAbsent(event: event)

  // THE ID IS A LITERAL, and that is the accurate statement rather than a
  // shortcut: there is exactly one company that is this instance's owner.
  // It is also what makes the gate above meaningful -- a minted id would be
  // absent on every boot forever.
  //
  // `name` is a STARTER, not a claim. Nothing a boot can read knows what this
  // company is called, so the row says so plainly and the first-run card asks
  // (D7). `configuredAt` is left unwritten and that absence IS the card.
  //
  // The installation hostname is infrastructure, not a claim about the
  // company's domain. Leave it absent until a person supplies a domain;
  // the ordinary TXT walk then proves ownership and reserves its front door.
  // In particular, memql.<installation-domain> is reserved cluster space.
  if decide == true {
    selfAccount := mutation createClientAccount(
      accountId: "v1:accounts:account:self",
      name:      "My company"
    )
  }
}

// ---- The account's own group (epic memql#5165, D5) ----
//
// Every account gets one, and the two writers below are the whole lifecycle:
// created with the account, archived with it. The third writer is the boot
// backfill in component/memql/seed_materializer.go, which calls the SAME
// builtin for every active account -- so the property that matters is
// idempotency, and it comes from the derived id acct-<accountShortId> rather
// than from any of the three callers being careful.

// ---- Why these two fire rarely and leave nothing behind when they write nothing ----
//
// EVERY WRITE TO AN ACCOUNT PUBLISHES node.created, carrying `firstVersion`
// (the store is append-only: component/memql/executor_mutation.go), and every
// update() also publishes node.updated. Unfiltered, ensureAccountGroup ran on
// every version of every account, beside refreshAccountGroup, and both are
// event handlers whose run and step rows were journaled up front: on
// production (2026-11-06) one account written 1,439 times in a day by its two
// sweeps started 2,880 journaled runs, each finding its group already in place.
//
// So ensureAccountGroup fires on an account's FIRST version only, the forge's
// recordRouted pattern (dsl/forge/automations.memql). Nothing is lost by it:
// refreshAccountGroup still calls the same idempotent builtin on every later
// write to an active account, and the boot backfill covers every active
// account whatever was missed.
//
// And both carry @journalOnWrite: a run whose builtin wrote nothing -- the
// group already exists and its name already matches -- leaves no v1:work:run
// and no v1:work:step at all. groupEnsureForAccount writes its group through
// the engine (integrations/groups' WriteGroup), so a run that does create or
// rename one still opens its journal at that write, and a failure is journaled
// as before. Allowed here: neither is @journalRequired, a before-write hook or
// triggered by a v1:work:* row (component/automations/journal_required.go).

/// Give a new account its group, on the account's first version.
@trigger(event="node.created", concept="v1:accounts:account")
@filter(row => args.firstVersion == true)
@journalOnWrite
automation ensureAccountGroup {
  args {
    firstVersion bool
    id any
  }

  ensure := builtin groupEnsureForAccount(accountId: args.id)
}

/// Keep the same derived group when a company is renamed. The builtin writes
/// nothing when the name already matches, and never adds permissions.
@trigger(event="node.updated", concept="v1:accounts:account")
@filter(row => row.status == "active")
@journalOnWrite
automation refreshAccountGroup {
  args { id any }
  ensure := builtin groupEnsureForAccount(accountId: args.id)
}

/// Archive an account's groups when the account is archived, and remove their
/// memberships.
///
/// THE FILTER IS WHAT MAKES THIS CORRECT, not a refinement of it. `node.updated`
/// fires on every write to an account -- the domain walk alone restamps
/// domainLastCheckedAt every thirty minutes while an unverified account's check
/// keeps failing -- so without the status test this would run a cascade on a
/// live account dozens of times a day, and each run would find nothing to do
/// only because the groups it walks are already active. The one time it
/// mattered would be indistinguishable from the noise.
@trigger(event="node.updated", concept="v1:accounts:account")
@filter(row => row.status == "archived")
automation archiveAccountGroup {
  args {
    id any
  }

  cascade := builtin groupArchiveForAccount(accountId: args.id)
}

/// Walk every client's own domain: mint its ownership token, check the TXT
/// record, and stamp verification and the reserved MemQL name on success.
///
/// THE SAME TWO MINUTES reconcileCustomDomains uses, and for the same reason:
/// somebody has just pasted a record into a registrar and is watching the
/// panel. The cost is bounded by the population of UNVERIFIED accounts rather
/// than by all of them -- accountsForDomainWalk excludes the verified -- so a
/// cluster whose clients are all set up pays one query per tick. An unverified
/// account is looked up on every tick but WRITTEN only when its answer changes,
/// or every thirty minutes while the same failure repeats, to keep its "Last
/// looked" honest (accountDomainStampRefresh, integrations/customdomain).
@trigger(schedule="0 */2 * * * *")
automation reconcileAccountDomains {
  walk := builtin accountDomainReconcile()
}

/// Display text for an account's derived group. Membership and authority remain native invariants.
@template
automation accountGroupPresentation {
 args { accountId string! name string! }
 name := args.name == "" ? "Account " + args.accountId : args.name
 return { name: name, description: "Everyone who works on " + name + "." }
}
