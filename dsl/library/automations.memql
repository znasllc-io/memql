// library domain -- promotion triggers.
//
// Event-driven population of the Library index. Each backing-row creation
// event folds into a v1:library:artifact index row. The createArtifact write
// lives directly in the automation's mutation step, binding its args from the
// trigger event payload (which IS the created row), with coalesce on the
// optional fields. #2235: this replaces the former promotion-logic indirection
// (each index* logic did the write inline -- an ADR §2.1 logic-purity
// violation). Mirrors the cluster registerNode/deregisterNode form: the logic
// is gone; the write is an event-bound mutation step.
//
// Authoring note (#2235): inside a step a mutation is the bare `<mutation>{ ... }`
// call (brace body, NOT `mutate <name>` and NOT `name({...})`); a multi-segment
// path like event.payload.summary is nil when absent, and passing nil for a
// string field trips the v1:library:artifact "expected string, got null"
// rejection (the #1626 failure), so the optional fields coalesce to "".

use library.mutations.{ createArtifact }
use library.concepts.{ memory, generatedOutput }
use notes.concepts.{ note }
use todos.concepts.{ todo }
use calendar.concepts.{ calendarEvent }

@enabled
@trigger(event="node.created", concept="v1:library:generatedOutput", partition="*")
@description("On generated-output creation, promote the new v1:library:generatedOutput into the Library as an artifact index row (lens=artifact, kind=generated_output). #2235.")
automation indexGeneratedOutputOnCreate {
  step persist {
    createArtifact {
      sourceConceptRef:     canonicalId(event.payload.id, generatedOutput),
      ownerUserId:          event.payload.ownerUserId,
      lens:                 "artifact",
      kind:                 "generated_output",
      source:               event.payload.source,
      title:                event.payload.title,
      summary:              coalesce(event.payload.summary, ""),
      format:               event.payload.format,
      mimeType:             coalesce(event.payload.mimeType, ""),
      live:                 false,
      partitionId:          coalesce(event.payload.partitionId, ""),
      agentId:              coalesce(event.payload.producedByAgentId, ""),
      producedByPlanId:     coalesce(event.payload.producedByPlanId, ""),
      producedByWorkerId:   coalesce(event.payload.producedByWorkerId, ""),
      producedByWorkerName: coalesce(event.payload.producedByWorkerName, "")
    }
  }
}

@enabled
@trigger(event="node.created", concept="v1:notes:note", partition="*")
@description("On note creation, promote it into the Library Records lens (lens=record, kind=note, source=agent_generated). #2235.")
automation indexNoteOnCreate {
  step persist {
    createArtifact {
      sourceConceptRef: canonicalId(event.payload.id, note),
      ownerUserId:      event.payload.ownerUserId,
      lens:             "record",
      kind:             "note",
      source:           "agent_generated",
      title:            coalesce(event.payload.title, "Untitled note"),
      summary:          coalesce(event.payload.body, ""),
      live:             false
    }
  }
}

