// library domain -- promotion triggers.
//
// Event-driven population of the Library index. Each backing-row creation
// event folds into a v1:library:artifact index row. The createArtifact write
// is the automation's own `mutation` statement, reading its args from the
// trigger payload (which IS the created row), with `??` on the optional
// fields. #2235: this replaces the former promotion-logic indirection (each
// index* logic did the write inline -- an ADR §2.1 logic-purity violation).
// Mirrors the cluster registerNode/deregisterNode form.
//
// A payload field that is absent reads nil, and passing nil for a string field
// trips the v1:library:artifact "expected string, got null" rejection (the
// #1626 failure), so the optional fields coalesce to "".
//
// sourceConceptRef binds args.id, the created row's id, DIRECTLY: a
// node.created event's payload id IS the stored canonical concept id
// (e.g. v1:library:memory:mem-...), so no canonicalId() wrapping is needed.
// The #2235 library-index-promotion conformance dimension guards all five paths.

/// On generated-output creation, promote the new v1:library:generatedOutput into the Library as an
/// artifact index row (lens=artifact, kind=generated_output). #2235.
@trigger(event="node.created", concept="v1:library:generatedOutput")
automation indexGeneratedOutputOnCreate {
  args {
    format any
    id any
    mimeType any
    ownerUserId any
    partitionId any
    producedByAgentId any
    producedByPlanId any
    producedByWorkerId any
    producedByWorkerName any
    source any
    summary any
    title any
  }

  persist := mutation createArtifact(
    sourceConceptRef:     args.id,
    ownerUserId:          args.ownerUserId,
    lens:                 "artifact",
    kind:                 "generated_output",
    source:               args.source,
    title:                args.title,
    summary:              args.summary ?? "",
    format:               args.format,
    mimeType:             args.mimeType ?? "",
    live:                 false,
    partitionId:          args.partitionId ?? "",
    agentId:              args.producedByAgentId ?? "",
    producedByPlanId:     args.producedByPlanId ?? "",
    producedByWorkerId:   args.producedByWorkerId ?? "",
    producedByWorkerName: args.producedByWorkerName ?? ""
  )
}

/// On note creation, promote it into the Library Records lens (lens=record, kind=note,
/// source=agent_generated). #2235.
@trigger(event="node.created", concept="v1:notes:note")
automation indexNoteOnCreate {
  args {
    body any
    id any
    ownerUserId any
    title any
  }

  persist := mutation createArtifact(
    sourceConceptRef: args.id,
    ownerUserId:      args.ownerUserId,
    lens:             "record",
    kind:             "note",
    source:           "agent_generated",
    title:            args.title ?? "Untitled note",
    summary:          args.body ?? "",
    live:             false
  )
}

