// library domain -- promotion triggers.
//
// Event-driven population of the Library index. Each backing-row creation
// event folds into a v1:library:artifact index row. The createArtifact write
// lives directly in the automation's mutation step, binding its args from the
// trigger event payload (which IS the created row), with coalesce on the
// optional fields. #2235: this replaces the former promotion-logic indirection
// (each index* logic did the write inline -- an ADR §2.1 logic-purity
// violation). Mirrors the cluster registerNode/deregisterNode form: the logic
// is gone; the write is an event-bound mutation step.
//
// Authoring note (#2235): inside a step a mutation is the bare `<mutation>{ ... }`
// call (brace body, NOT `mutate <name>` and NOT `name({...})`); a multi-segment
// path like event.payload.summary is nil when absent, and passing nil for a
// string field trips the v1:library:artifact "expected string, got null"
// rejection (the #1626 failure), so the optional fields coalesce to "".
//
// sourceConceptRef binds event.payload.id DIRECTLY. The earlier
// `canonicalId(event.payload.id, <concept>)` form resolved to nil in a
// top-level step arg (the concept-ref builtin does not evaluate there), so
// createArtifact failed with "required argument sourceConceptRef is missing" --
// silently breaking Library promotion (proven on a seeded DB; forward-fixes
// #2265's canonicalId-in-step bug). canonicalId is unnecessary anyway: a
// node.created event's payload.id IS the stored canonical concept id
// (e.g. v1:library:memory:mem-...), so the direct bind yields the identical ref.
// The #2235 library-index-promotion conformance dimension guards all five paths.

/// On generated-output creation, promote the new v1:library:generatedOutput into the Library as an
/// artifact index row (lens=artifact, kind=generated_output). #2235.
@trigger(event="node.created", concept="v1:library:generatedOutput", partition="*")
automation indexGeneratedOutputOnCreate {
  args {
    format any
    id any
    mimeType any
    ownerUserId any
    partitionId any
    producedByAgentId any
    producedByPlanId any
    producedByWorkerId any
    producedByWorkerName any
    source any
    summary any
    title any
  }

  step persist {
    mutation createArtifact (
      sourceConceptRef:     id,
      ownerUserId:          ownerUserId,
      lens:                 "artifact",
      kind:                 "generated_output",
      source,
      title:                title,
      summary:              summary ?? "",
      format,
      mimeType:             mimeType ?? "",
      live:                 false,
      partitionId:          partitionId ?? "",
      agentId:              producedByAgentId ?? "",
      producedByPlanId:     producedByPlanId ?? "",
      producedByWorkerId:   producedByWorkerId ?? "",
      producedByWorkerName: producedByWorkerName ?? ""
    )
  }
}

/// On note creation, promote it into the Library Records lens (lens=record, kind=note,
/// source=agent_generated). #2235.
@trigger(event="node.created", concept="v1:notes:note", partition="*")
automation indexNoteOnCreate {
  args {
    body any
    id any
    ownerUserId any
    title any
  }

  step persist {
    mutation createArtifact (
      sourceConceptRef: id,
      ownerUserId:      ownerUserId,
      lens:             "record",
      kind:             "note",
      source:           "agent_generated",
      title:            title ?? "Untitled note",
      summary:          body ?? "",
      live:             false
    )
  }
}

