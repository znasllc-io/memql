// library domain -- promotion triggers.
//
// Event-driven population of the Library index. Each backing-row
// creation event folds into a v1:library:artifact index row via the
// matching promotion logic. Records (notes / todos / calendar events /
// memory) and live sources are wired the same way on #696.

use library.logic.{ indexGeneratedOutput, indexNote, indexTodo, indexCalendarEvent, indexMemory }

@enabled
@trigger(event="node.created", concept="v1:library:generatedOutput", partition="*")
@description("On generated-output creation, promote the new v1:library:generatedOutput into the Library as an artifact index row. decide (pure logic builds the args) -> persist (the single createArtifact write). #2235.")
automation indexGeneratedOutputOnCreate {
  step decide {
    logic indexGeneratedOutput { event: event }
  }
  step persist {
    createArtifact({ sourceConceptRef: field(step("decide"), "sourceConceptRef"), ownerUserId: field(step("decide"), "ownerUserId"), lens: field(step("decide"), "lens"), kind: field(step("decide"), "kind"), source: field(step("decide"), "source"), title: field(step("decide"), "title"), summary: field(step("decide"), "summary"), format: field(step("decide"), "format"), mimeType: field(step("decide"), "mimeType"), live: field(step("decide"), "live"), partitionId: field(step("decide"), "partitionId"), agentId: field(step("decide"), "agentId"), producedByPlanId: field(step("decide"), "producedByPlanId"), producedByWorkerId: field(step("decide"), "producedByWorkerId"), producedByWorkerName: field(step("decide"), "producedByWorkerName") })
  }
}

@enabled
@trigger(event="node.created", concept="v1:notes:note", partition="*")
@description("On note creation, promote it into the Library Records lens. decide (pure logic builds the args) -> persist (the single createArtifact write). #2235.")
automation indexNoteOnCreate {
  step decide {
    logic indexNote { event: event }
  }
  step persist {
    createArtifact({ sourceConceptRef: field(step("decide"), "sourceConceptRef"), ownerUserId: field(step("decide"), "ownerUserId"), lens: field(step("decide"), "lens"), kind: field(step("decide"), "kind"), source: field(step("decide"), "source"), title: field(step("decide"), "title"), summary: field(step("decide"), "summary"), live: field(step("decide"), "live") })
  }
}

