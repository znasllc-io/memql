// library domain -- promotion triggers.
//
// Event-driven population of the Library index. Each backing-row
// creation event folds into a v1:library:artifact index row via the
// matching promotion logic. Records (notes / todos / calendar events /
// memory) and live sources are wired the same way on #696.

use library.logic.{ logicIndexGeneratedOutput, logicIndexNote, logicIndexTodo, logicIndexCalendarEvent, logicIndexMemory }

@enabled
@trigger(event="node.created", concept="v1:library:generatedOutput", partition="*")
@description("On generated-output creation, promote the new v1:library:generatedOutput into the Library as an artifact index row.")
automation indexGeneratedOutputOnCreate {
  step run {
    logic indexGeneratedOutput { event: event }
  }
}

@enabled
@trigger(event="node.created", concept="v1:notes:note", partition="*")
@description("On note creation, promote it into the Library Records lens.")
automation indexNoteOnCreate {
  step run {
    logic indexNote { event: event }
  }
}

@enabled
@trigger(event="node.created", concept="v1:todos:todo", partition="*")
@description("On to-do creation, promote it into the Library Records lens.")
automation indexTodoOnCreate {
  step run {
    logic indexTodo { event: event }
  }
}

@enabled
@trigger(event="node.created", concept="v1:calendar:calendarEvent", partition="*")
@description("On calendar-event creation, promote it into the Library Records lens.")
automation indexCalendarEventOnCreate {
  step run {
    logic indexCalendarEvent { event: event }
  }
}

@enabled
@trigger(event="node.created", concept="v1:library:memory", partition="*")
@description("On memory creation, promote it into the Library Records lens.")
automation indexMemoryOnCreate {
  step run {
    logic indexMemory { event: event }
  }
}

