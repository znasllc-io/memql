// library domain -- promotion triggers.
//
// Event-driven population of the Library index. Each backing-row
// creation event folds into a v1:library:artifact index row via the
// matching promotion logic. Records (notes / todos / calendar events /
// memory) and live sources are wired the same way on #696.

use library.logic.{ indexGeneratedOutput, indexNote, indexTodo, indexCalendarEvent, indexMemory }

@enabled
@trigger(event="node.created", concept="v1:library:generatedOutput", partition="*")
@description("On generated-output creation, promote the new v1:library:generatedOutput into the Library as an artifact index row. decide (pure logic builds the args) -> persist (the single createArtifact write). #2235.")
automation indexGeneratedOutputOnCreate {
  step decide {
    logic indexGeneratedOutput { event: event }
  }
  step persist {
    createArtifact({ sourceConceptRef: field(decide.result, "sourceConceptRef"), ownerUserId: field(decide.result, "ownerUserId"), lens: field(decide.result, "lens"), kind: field(decide.result, "kind"), source: field(decide.result, "source"), title: field(decide.result, "title"), summary: field(decide.result, "summary"), format: field(decide.result, "format"), mimeType: field(decide.result, "mimeType"), live: field(decide.result, "live"), partitionId: field(decide.result, "partitionId"), agentId: field(decide.result, "agentId"), producedByPlanId: field(decide.result, "producedByPlanId"), producedByWorkerId: field(decide.result, "producedByWorkerId"), producedByWorkerName: field(decide.result, "producedByWorkerName") })
  }
}

@enabled
@trigger(event="node.created", concept="v1:notes:note", partition="*")
@description("On note creation, promote it into the Library Records lens. decide (pure logic builds the args) -> persist (the single createArtifact write). #2235.")
automation indexNoteOnCreate {
  step decide {
    logic indexNote { event: event }
  }
  step persist {
    createArtifact({ sourceConceptRef: field(decide.result, "sourceConceptRef"), ownerUserId: field(decide.result, "ownerUserId"), lens: field(decide.result, "lens"), kind: field(decide.result, "kind"), source: field(decide.result, "source"), title: field(decide.result, "title"), summary: field(decide.result, "summary"), live: field(decide.result, "live") })
  }
}

