// library domain -- Go-backed edit capabilities.
//
// These builtins expose the library edit integration
// (integrations/library/) to the DSL. The integration owns the
// read-then-compute-then-append dance the version history needs (next
// versionNumber = latest + 1, fresh version id, optimistic concurrency
// check) -- none of which MemQL can express on its own. See
// dsl/library/concepts.memql (documentVersion) and the integration
// package header for the full design (memql#1228-1231).

@sdk
@executor("integration.library.editDocument")
@args(profile="object")
@description("Append a new version of a Library document with new content. Reads the current latest version, computes the next versionNumber + parentVersionId, appends an immutable v1:library:documentVersion snapshot (authorKind=user|assistant) and re-inserts the backing generatedOutput so the Library viewer reflects the edit. Optimistic concurrency via expectedVersion. The caller retains their own authority for reads and writes. Backs both the user edit (memql#1229) and the assistant editDocument tool (memql#1231).")
builtin editDocument {
  documentId       string!
  content          string
  attachmentId     string
  note             string
  authorKind       enum("user", "assistant", "system")
  authorId         string
  expectedRevision string
  expectedVersion  int
  producedByPlanId string
  partitionId          string
}

@executor("integration.library.editDocumentAsAssistant")
@args(profile="object")
@description("Assistant-facing document edit (memql#1231). Backs the agent editDocument tool: appends a new version authored by the calling agent (authorKind=assistant, authorId=agentId) to an existing logical document, re-inserting the backing generatedOutput so the Library viewer reflects the revision. ownerUserId is threaded from the document row. Delegates to the same append path as the user edit.")
builtin assistantEditDocument {
  documentId       string!
  content          string
  attachmentId     string
  note             string
  agentId          string
  producedByPlanId string
  partitionId          string
  expectedRevision string
  expectedVersion  int
}

@sdk
@executor("integration.library.restoreDocumentVersion")
@args(profile="object")
@description("Restore a Library document to an earlier version by APPENDING a new latest version equal to the chosen one (memql#1230). Forward-only and non-destructive: history is never deleted; the restore lands as a new version (authorKind=system) with note 'restored from vN'. ownerUserId is threaded from the document row.")
builtin restoreDocumentVersion {
  documentId  string!
  versionId   string!
  authorId    string
}

// ---- artifact labels (memql artifacts-labels D2) ----
//
// Add/remove rather than set-the-whole-array: MemQL has no array append, and
// a caller that must send the FULL new label list would clobber whatever
// another agent or the person themselves added concurrently -- the expected
// case, not a rare race. Each capability loads the artifact row, merges the
// single label in or out, and writes back; both are idempotent (adding a
// label already present, or removing one absent, succeeds and changes
// nothing). @sdk: the portal calls these same builtins directly (via the
// generated SDK), and the agent tool (dsl/library/tools.memql) wraps them
// too -- one implementation serves both callers, unlike the editDocument
// pair above which needs two builtins because the user/assistant paths
// differ in authorKind attribution.

@sdk
@executor("integration.library.addArtifactLabel")
@args(profile="object")
@description("Add a label to a Library artifact index row. Idempotent -- a label already present is left alone and nothing is written. artifactId is the v1:library:artifact row id; the load + write-back run under a synthetic actor derived from the row's own ownerUserId, so a caller can only ever label an artifact they own.")
builtin libraryAddArtifactLabel {
  artifactId  string!
  label       string!
}

@sdk
@executor("integration.library.removeArtifactLabel")
@args(profile="object")
@description("Remove a label from a Library artifact index row. Idempotent -- a label already absent is left alone and nothing is written. Same owner-threaded load/write shape as libraryAddArtifactLabel.")
builtin libraryRemoveArtifactLabel {
  artifactId  string!
  label       string!
}

/// Re-stamp a file-backed artifact index row from its backing v1:library:file (epic memql#4806).
/// The upload route calls it after a supersede, because a new version changes facts the INDEX
/// carries -- the title when the new bytes arrived under a different name, the format and mimeType,
/// the updatedAt watermark the Library sorts on and the fingerprint the Files list pulses from.
/// Without it the list would go on showing the old name until the analysis pass happened to finish.
///
/// Idempotent and information-free: it copies what the file row already says, carrying the
/// index-only fields (labels, archived, folderId) forward exactly as the analysis pass's own
/// re-stamp does. A failed carry-forward read SKIPS the write rather than writing zeroes over real
/// values -- a stale watermark is the documented price, wiping labels is not.
@executor("integration.library.restampFileArtifact")
@args(profile="object")
@description("Re-stamp a file-backed Library artifact index row from its backing file row, so a new version's name, format and watermark reach the list immediately. Idempotent; reads the file under the caller's own actor, so it can only ever touch an artifact they own.")
builtin libraryRestampFileArtifact {
  fileId  string!
}

// ---- the analysis / search / train half (memql#4342) ----
//
// Three builtins, and the first one is the odd one out: it is a second
// DSL NAME for a capability that already exists
// (integration.embedding.store), declared here so the Library's analysis
// pass can reach the ONE embedding write-path from Go through Execute.
// The alternative -- giving this integration its own pgvector INSERT --
// would be a second write-path to keep in step with the first, which is
// exactly what the engine's own harness/action embed hooks avoid by
// dispatching the same capability. An executor is a target, not a
// possession; nothing about naming it twice changes what it does.
//
// The other two are the Library's own Go capabilities, both @sdk because
// the portal calls them directly through the generated client and both
// wrapped by an agent tool in dsl/library/tools.memql. One
// implementation, two callers -- the artifact-label pair's shape.

/// Embed one Library file chunk into node_vectors so librarySimilarArtifacts can find it.
@executor("integration.embedding.store")
@args(profile="object")
@description("Store an embedding vector for one v1:library:fileChunk row. A second DSL name for integration.embedding.store, declared in the library namespace so the analysis pass reaches the shared embedding write-path rather than opening a second one. vectorField must stay 'content': similarTo's join filters on that exact value, so a vector written under any other field name is stored, kept and never matched.")
builtin libraryEmbedChunk {
  nodeId       string!  @description("Canonical node id of the chunk row the vector attaches to -- v1:library:fileChunk:<shortId>. Canonical, not bare: this is the key node_vectors joins to MemoryNodes on.")
  text         string!  @description("The chunk text to embed. The same text stored on the row, so a match can quote what it matched.")
  concept      string   @description("Concept of the node, stored alongside the vector for filtered queries. v1:library:fileChunk.")
  vectorField  string   @description("Which embedding field this is. 'content' -- see the description above before changing it.")
  provider     string   @description("Embedding provider name. Defaults to embedding3Small, which is what the rest of the tree embeds with; a Library chunk embedded by a different provider is not comparable to the query vector.")
}

/// Search the caller's Library by meaning and get whole artifacts back, best match first.
@sdk
@executor("integration.library.similarArtifacts")
@args(profile="object")
@description("Semantic search over the caller's own Library (design 3.2). Runs similarTo across the v1:library:fileChunk rows the analysis pass embedded, keeps only chunks the acting user owns, folds them up to artifacts by best score, and re-reads each surviving artifact through the owner-gated libraryArtifactById before returning it -- so a hit on somebody else's file cannot be returned even though the underlying vector operator is concept-scoped rather than row-scoped. Pass text to search by a phrase, or artifactId to find artifacts like an existing one (its summary, else its first chunk, becomes the query, and the seed artifact is excluded from its own results). Each result carries artifactId, fileId, score, the matched chunk's seq and snippet, and the artifact's title / kind / summary / labels.")
builtin librarySimilarArtifacts {
  text        string   @description("The phrase to search by. Set this OR artifactId.")
  artifactId  string   @description("Find artifacts similar to this one. Set this OR text.")
  limit       int      @description("Maximum artifacts to return. Defaults to 5; capped at 50, because each returned artifact costs one further owner-gated read.")
}

/// Train a Library file into a knowledge domain -- the deliberate second act after upload.
@sdk
@executor("integration.library.trainFile")
@args(profile="object")
@description("Train a Library file into a knowledge domain (design D7 -- upload and train are two acts, and nothing is trained by default). Reconstructs the file's extracted text from the chunks the analysis pass wrote, runs integration.knowledge.ingest over it with sourceRef 'artifact:<artifactId>' so every knowledge chunk points back at the Library row it came from, appends the domain to the file's trainedIntoDomainIds and writes an audit event. Two refusals: the file is resolved under the caller's own actor, so another user's file is simply not found; and the domain must be one the caller may write to, which a cluster owner always is and which everyone else needs the cluster's wired knowledge-domain authorizer to confirm -- with none wired the call is refused rather than writing into a domain nobody vouched for. Idempotent: training the same file into the same domain again re-ingests the same content and records no second domain.")
builtin libraryTrainFile {
  fileId    string!  @description("The v1:library:file row id to train. Must belong to the acting user.")
  domainId  string!  @description("Id of the knowledge domain to train the file into.")
}

/// Read revision-bound feedback after checking current access to the artifact.
@sdk
@executor("integration.library.documentReview")
@args(profile="object")
builtin libraryDocumentReview {
  artifactId string!
}

/// Save feedback against the exact saved revision. A repeated requestId returns
/// the original receipt; changed content under that requestId is refused.
@sdk
@executor("integration.library.addDocumentComment")
@args(profile="object")
builtin libraryAddDocumentComment {
  attachments []object
  artifactId string!
  expectedVersion int!
  expectedRevision string!
  anchor object!
  body string!
  requestId string!
}

/// Capture selected current feedback and start its analysis run.
@sdk
@executor("integration.library.requestDocumentRevision")
@args(profile="object")
builtin libraryRequestDocumentRevision {
 artifactId string!
 expectedVersion int!
 expectedRevision string!
 commentIds []string!
 instruction string!
 requestId string!
}

/// Read the owned analysis, proposed replacements, decision and saved result.
@sdk
@executor("integration.library.documentRevisionStatus")
@args(profile="object")
builtin libraryDocumentRevisionStatus {
 requestId string!
}

/// Revalidate and read the immutable source captured for the current owned run.
@executor("integration.library.revisionInput")
@args(profile="object")
builtin libraryRevisionInput { requestId string! }

/// Decode and validate replacements only within the selected source passages.
@executor("integration.library.revisionProposal")
@args(profile="object")
builtin libraryRevisionProposal { requestId string! response any! }

/// Park the current run on an exact proposal; return only after human approval.
@executor("integration.library.reviewRevision")
@args(profile="object")
builtin libraryReviewRevision { requestId string! proposal object! question string! }

/// Only its approved, server-owned run may execute this revision.
@executor("integration.library.executeDocumentRevision")
@args(profile="object")
builtin libraryExecuteDocumentRevision {
 requestId string!
}

