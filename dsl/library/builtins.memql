// library domain -- Go-backed edit capabilities.
//
// These builtins expose the library edit integration
// (integrations/library/) to the DSL. The integration owns the
// read-then-compute-then-append dance the version history needs (next
// versionNumber = latest + 1, fresh version id, optimistic concurrency
// check) -- none of which MemQL can express on its own. See
// dsl/library/concepts.memql (documentVersion) and the integration
// package header for the full design (memql#1228-1231).

/// Append a new version of a Library document with new content. Reads the current latest version,
/// computes the next versionNumber + parentVersionId, appends an immutable
/// v1:library:documentVersion snapshot (authorKind=user|assistant) and re-inserts the backing
/// generatedOutput so the Library viewer reflects the edit. Optimistic concurrency via
/// expectedVersion. ownerUserId is threaded from the document row, never the caller. Backs both the
/// user edit (memql#1229) and the assistant editDocument tool (memql#1231).
@sdk
@executor("integration.library.editDocument")
@args(profile="object")
builtin editDocument {
  documentId       string!
  content          string
  attachmentId     string
  note             string
  authorKind       enum("user", "assistant", "system")
  authorId         string
  expectedVersion  int
  producedByPlanId string
  partitionId          string
}

/// Assistant-facing document edit (memql#1231). Backs the agent editDocument tool: appends a new
/// version authored by the calling agent (authorKind=assistant, authorId=agentId) to an existing
/// logical document, re-inserting the backing generatedOutput so the Library viewer reflects the
/// revision. ownerUserId is threaded from the document row. Delegates to the same append path as
/// the user edit.
@executor("integration.library.editDocumentAsAssistant")
@args(profile="object")
builtin assistantEditDocument {
  documentId       string!
  content          string
  attachmentId     string
  note             string
  agentId          string
  producedByPlanId string
  partitionId          string
  expectedVersion  int
}

/// Restore a Library document to an earlier version by APPENDING a new latest version equal to the
/// chosen one (memql#1230). Forward-only and non-destructive: history is never deleted; the restore
/// lands as a new version (authorKind=system) with note 'restored from vN'. ownerUserId is threaded
/// from the document row.
@sdk
@executor("integration.library.restoreDocumentVersion")
@args(profile="object")
builtin restoreDocumentVersion {
  documentId  string!
  versionId   string!
  authorId    string
}
