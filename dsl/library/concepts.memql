// library domain -- the Library index.
//
// The Library is the user-facing, provenance-aware home for
// everything the app creates or ingests: uploaded documents,
// generated outputs (workbench / computer-use / agent), and the
// structured records the assistant manages (notes, to-dos, calendar
// events, memories) plus live-data sources. See the Library epic
// (frontend#296).
//
// `artifact` is the LOCKED design choice (memql#693): a single thin
// INDEX row that points at an underlying source concept and carries
// the shared provenance / kind / type spine, so the Library panel can
// list / search / filter / sort across heterogeneous sources with one
// query surface instead of N client-side fan-queries. The index row
// owns NO content of its own -- the bytes / payload live on the
// backing concept (v1:knowledge:document + v1:common:attachment,
// v1:notes:note, v1:knowledge:liveSource, etc.); the index carries
// only what the listing + facets need.
//
// Per-row authz tier: owned. Every read filters on
// payload.ownerUserId==actor.userId; every write stamps ownerUserId
// from actor.userId server-side so a caller can never see or mutate
// another user's index rows.

use identity.concepts.{ user }
use agents.concepts.{ agent }
use cognition.concepts.{ utterance }
use common.concepts.{ attachment }
use planner.concepts.{ plan }
use worker.concepts.{ registration }

/// A single Library index row pointing at one underlying source concept (document / generated
/// output / note / to-do / calendar event / memory / live source). Carries the shared provenance +
/// type spine the Library panel needs to list / search / filter / sort across heterogeneous
/// sources, while the actual content stays on the backing concept referenced by sourceConceptRef.
/// The LOCKED backend shape for the Library epic (memql#693): a real index concept, not a UI
/// projection. Per-row authz: the COMPOSITE tier (memql#4312) -- the owner, or a cluster owner.
/// Every read already carried ownerUserId==actor.userId by hand; the declaration is what extends
/// that to the paths a filter cannot reach (subscriptions, graph expansion, a raw query string) and
/// what gives an operator console the cross-user view a plain owner= tier has no bypass for.
@displayCard(primary="title", secondary="summary", tertiary="updatedAt", status="lens")
@rowAuthz(owner="ownerUserId", clusterOwner)
concept artifact {
  ownerUserId      string!  @description("v1:identity:user.id that owns this index row. Stamped from actor.userId at create time and re-stamped on every update so ownership can never be reassigned. The load-bearing per-row authz key.")

  lens             enum("artifact", "record")!  @description("Which Library lens this row belongs to. 'artifact' = file-like, content-bearing item opened in a type-aware viewer (documents, generated outputs). 'record' = structured memql row read/edited as data (notes, to-dos, calendar events, memories, live sources). Drives the Artifacts | Records toggle in the Library panel.")

  kind             enum("document", "generated_output", "note", "todo", "calendar_event", "memory", "live_source", "file")!  @description("The flavor of the backing concept. document = uploaded file (v1:knowledge:document); generated_output = an output produced on the workbench / via computer-use / by an agent; note = v1:notes:note; todo = v1:todos:todo; calendar_event = v1:calendar:calendarEvent; memory = user-facing assistant memory; live_source = v1:knowledge:liveSource; file = v1:library:file, the Library's own first-class byte-bearing row (the sixth backing concept, memql#4340). Extensible -- new sources append a value.")

  source           enum("uploaded", "exported", "workbench_generated", "computer_use", "agent_generated", "derived", "user_created", "live")!  @description("Provenance -- WHERE this item came from. uploaded = user-provided file; exported = written out of another artifact by the export route (v1:library:file only); workbench_generated = produced in a v1:workbench:workspace container; computer_use = produced at the computer-use level; agent_generated = emitted by an agent as a standalone deliverable; derived = computed from another artifact; user_created = the person wrote it themselves in the portal, rather than a tool producing it for them; live = a current-state read against a live source (paired with live==true). Rendered as the per-row source label in the Library list. THIS ENUM IS THE UNION OF EVERY BACKING ROW'S OWN source, and it has to be: indexFileOnCreate and its five siblings pass the backing value straight through to createArtifact, so a value a backing concept can hold and this one cannot is a promotion that REFUSES -- the row never gets an index row and never appears in the Library, with nothing on the failing path to say why. `exported` is here for exactly that reason (memql#4342 found it missing). TestEveryBackingSourceValueIsPromotable pins the containment.")

  sourceConceptRef string!  @description("Fully-qualified reference to the backing row, e.g. 'v1:knowledge:document:<id>', 'v1:notes:note:<id>', 'v1:knowledge:liveSource:<id>'. The Library drill-in resolves content + children (document->documentChunk, liveSource->liveSnapshot) through this ref. Also the idempotency key for the write-path (one index row per source ref).")

  title            string!  @description("Display title for the list row. Copied from the backing concept at index time (document.fileName, note.title, liveSource.name, etc.).")

  summary          string  @description("Optional short summary / description for the list row. From document.summary, liveSource.description, etc. when available.")

  format           enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "conversation", "other")  @description("High-level content classification for artifacts -- picks the viewer in the Library (markdown / Word document / PDF / Excel spreadsheet) and falls back to a metadata-only card for 'other'. Mirrors v1:knowledge:document.format with 'document' added for Word-style docs. Null for record-lens rows.")

  mimeType         string  @description("MIME type of the backing bytes when this is a content-bearing artifact, copied from the attachment. Used alongside format to pick the viewer.")

  live             bool    @default("false")  @description("True when this row is a live-data source (kind=live_source, source=live). The Library renders a LIVE badge + freshness indicator computed from the backing liveSource's latest liveSnapshot (materializedAt / expiresAt). False for everything else.")

  scope            enum("workspace", "private")  @description("Shared-vs-private visibility tier, mirrored from the backing source's own scope (currently only v1:knowledge:liveSource carries one). 'workspace' MEANT a partition-shared row with NO single owner (ownerUserId empty), surfaced through a non-owned libraryWorkspaceLiveSources read (#723). memql#4340's tier ends that: an owner tier is ANDed into every read of this concept and every row is admitted against it on the way out, so an empty ownerUserId is now unreachable on every path and that read is owner-scoped like its siblings. The value survives as a mirrored FACET of the backing source's own scope; a genuinely ownerless partition-shared Library row needs a concept that can express one, which the index no longer is. 'private' = owner-scoped like everything else. Null for the ordinary owned rows (documents / notes / to-dos / memories) that have no shared tier.")

  labels           []string  @description("Free-text labels the owner or their agents put on this artifact to say what it was for. Rendered as chips in the portal Artifacts page and filterable one label at a time. Distinct from v1:worker:registration.labels (routing among a user's own workers) and v1:cluster:node.labels (arbitrary node metadata), which are key=value OBJECT maps -- these are display labels on a []string, matching note.tags and skill.tags.")

  archived         bool  @default("false")  @description("Soft delete: true once the owner archives the item, which removes it from the default Library list without destroying the row or its provenance (memql#4340). The engine is append-only by (id, createdAt), so an archive is a re-version carrying archived=true rather than a DELETE -- the history, the labels and the sourceConceptRef all survive. archiveArtifact sets it, and archives the backing v1:library:file when the artifact is one. createArtifact writes `archived: args.archived ?? false` so every promoted row carries an explicit value -- not because the list filter requires it (measured: `archived != true` DOES return a row whose payload has no archived key at all, so rows written before this field existed keep listing), but because a row that states its own answer is what makes the filter readable and what stops the next author reaching for `archived == false`, which is the spelling a missing key would silently exclude.")

  folderId         string  @description("v1:library:folder.id this item is filed under -- the ORGANIZATIONAL TRUTH of the Files app's Drive-model tree (memql#4781, design D3). An id, never a path string; empty or absent means the root. Any kind can be filed, not only files. moveArtifactToFolder is the re-filing write (a read-merge update, so labels and archived survive a move); at promotion time createArtifact carries the backing row's initial filing forward, after which THIS copy is authoritative and the backing row's is not tracked further. Every folder filter runs CLIENT-SIDE over the owner's snapshot, because rows promoted before this field existed have no key at all and `folderId == \"\"` cannot match them -- the `archived != true` lesson, applied to a field where the honest reader is the fold, not the filter.")

  partitionId          string  @description("v1:cognition:space.id this item belongs to, when space-scoped (documents, generated outputs). Empty for user-global records (notes / to-dos / memories). Backs the per-space facet filter.")

  agentId          string  @description("v1:agents:agent.id associated with this item, when one applies (e.g. the agent that produced a generated output or owns a memory). Backs the per-agent facet filter.")

  producedByPlanId string  @description("v1:planner:plan.id that produced this item, when it came from a plan (documents carry document.planId; generated outputs carry the producing plan). Provenance back-pointer surfaced in the detail view.")

  producedByWorkerId string  @description("v1:worker:registration.id of the worker MACHINE this item is associated with, WHEN A MACHINE IS KNOWN (memql#4781 generalized this from its original computer-use-only meaning): the machine a computer-use output was produced on, or the machine a file was uploaded from (indexFileOnCreate forwards the file row's verified uploadedFromWorkerId here). Lets the Files app say WHICH of the user's registered computers an item came from, and detect when it is the machine the user is currently on. Empty when no machine is honestly known -- a browser upload names none.")

  producedByWorkerName string  @description("Human-readable name of the machine producedByWorkerId names (e.g. 'MacBook-Pro'), copied from the worker registration at write time so the Files app can label the row without a join. Empty unless producedByWorkerId is set. Generalized alongside producedByWorkerId: 'produced on' for computer-use outputs, 'uploaded from' for files -- the kind and source decide the verb, the field carries the machine.")

  validationStatus enum("none", "unvalidated", "validated", "rejected", "partiallyValidated", "superseded")  @default("none")  @description("Validation rollup for document-backed artifacts, mirrored from v1:knowledge:document.validationStatus so the Library can facet on it without a join. 'none' for items that have no validation lifecycle (records, generated outputs).")

  accountIds       []string  @description("The v1:accounts:account rows this item is labelled with -- who it is about, or who it was produced for (epic memql#4800, D5). A LIST, because \"one or two accounts\" is the owner's own framing: a contract naming two clients is one file, and forcing it to pick would be the schema disagreeing with the filing cabinet. Optional plain references with NO read effect: row authorization on the index is exactly what it was, `libraryItemsForAccount` reads through the ordinary owner-scoped path and narrows nothing, and a row with no key at all behaves as untied under every filter -- which is every row promoted before this field existed, so the Files browse filter reads absence and the empty list as the same answer, the way the folderId fold already has to. Edited from the Files inspector's account labels; browse filters on it CLIENT-SIDE over the seeded snapshot, for the reason every other Files facet does.")

  updatedAt        datetime  @description("RFC3339 watermark of the most recent change to the backing item, stamped on every index write. The default Library sort key (most-recent first).")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="agentId", target=agent, direction="outgoing")
  @relationship(type="references", field="producedByPlanId", target=plan, direction="outgoing")
  @relationship(type="references", field="producedByWorkerId", target=registration, direction="outgoing")
  @relationship(type="references", field="folderId", target=folder, direction="outgoing")
}

// ---- generatedOutput: the home concept for app-produced deliverables ----
//
// Documents (v1:knowledge:document) cover user-UPLOADED files. The
// Library also surfaces things the system PRODUCES -- a result computed
// on the workbench ("list the 10 most beautiful birds"), a file written
// at the computer-use level, or a standalone deliverable an agent emits.
// Those had no home concept; generatedOutput is it. Like document, the
// raw bytes (when file-backed) live on a v1:common:attachment row; the
// inline-text case keeps the body here directly. Each generatedOutput is
// auto-promoted to an artifact index row by indexGeneratedOutput.
//
// NOTE: the Go producers that emit these rows (workbench / computer-use /
// agent integrations promoting their terminal outputs) are the remaining
// integration step tracked on #694 -- the DSL surface here is complete and
// the document path already has a live producer (the attachment handler).

/// A deliverable PRODUCED through the app (as opposed to an uploaded document): a workbench result,
/// a computer-use output, or a standalone agent output. Carries either inline text (body) or a
/// reference to file bytes (attachmentId -> v1:common:attachment). Auto-promoted into the Library
/// by indexGeneratedOutput on creation. Per-row authz: owned -- ownerUserId is stamped from
/// actor.userId on every write and reads gate on ownerUserId==actor.userId.
@displayCard(primary="title", secondary="summary", tertiary="createdAt")
@rowAuthz(owner="ownerUserId")
concept generatedOutput {
  ownerUserId       string!  @serverSet  @description("v1:identity:user.id this output belongs to (the user the producing agent / plan acts for). Stamped from actor.userId on every write and never accepted as a mutation arg; the producing integrations run the mutation under that user's actor (auth.ContextWithUserActor), which binds the AccessContext actor.userId resolves from. @serverSet turns 'never accepted as a mutation arg' from a convention into a LOAD-TIME rejection: a mutation that writes this field from caller args now fails to load (memql#3175). The raw insert() surface bypasses accept/stamp entirely and is covered separately -- the engine server-stamps this field from the @rowAuthz declaration above on every non-template write (memql#3059 / #3175). The per-row authz key for Library reads.")
  title             string!  @description("Display title for the output, e.g. 'Ten most beautiful birds'.")
  summary           string  @description("Optional short description / preview of the output.")
  body              string  @description("Inline text content for text-style outputs (markdown / plain text) produced directly without a file. File-backed outputs leave this empty and carry bytes on the attachment.")
  attachmentId      string  @description("Back-reference to v1:common:attachment when the output is file-backed (a generated .docx / .pdf / .xlsx). The bytes live on the attachment row in GCS; this concept carries the metadata projection.")
  format            enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "other")! @default("markdown")  @description("Content classification -- picks the Library viewer. Mirrors the artifact.format vocabulary.")
  mimeType          string  @description("MIME type of the backing bytes when attachment-backed.")
  source            enum("workbench_generated", "computer_use", "agent_generated", "derived", "user_created")!  @description("Provenance -- where the output was produced. Copied onto the artifact index row's source field. user_created is the portal's own create path: a person typed the content rather than a tool producing it, and calling that 'derived' would render a false provenance label on their own row.")
  partitionId           string  @description("v1:cognition:space.id this output was produced in, when space-scoped.")
  producedByPlanId  string  @description("v1:planner:plan.id that produced this output, when it came from a plan.")
  producedByAgentId string  @description("v1:agents:agent.id that produced this output, when an agent emitted it.")
  producedByWorkerId   string  @description("v1:worker:registration.id of the worker MACHINE that produced this output, when source=computer_use. Empty otherwise. Copied onto the artifact index row.")
  producedByWorkerName string  @description("Human-readable name of the producing worker machine, copied from the worker registration at production time. Empty unless producedByWorkerId is set.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="attachmentId", target=attachment, direction="outgoing")
  @relationship(type="references", field="producedByPlanId", target=plan, direction="outgoing")
  @relationship(type="references", field="producedByAgentId", target=agent, direction="outgoing")
  @relationship(type="references", field="producedByWorkerId", target=registration, direction="outgoing")
}

// ---- documentVersion: append-only version history for a logical document ----
//
// Library documents (generatedOutput rows, and uploaded knowledge
// documents surfaced as artifacts) had NO version history before
// memql#1228: producing or editing a document OVERWROTE the backing
// row, so the prior content was lost and there was no provenance for
// "who changed what, when". documentVersion is the fix.
//
// Each documentVersion row is an IMMUTABLE content snapshot of one
// logical document at one point in its history. The history is
// append-only: editing a document (by the user via memql#1229, by an
// assistant via memql#1231, or restoring an earlier version via
// memql#1230) never mutates an existing version -- it APPENDS a new
// one with the next monotonic versionNumber. The artifact index row
// (and the backing generatedOutput) always points at the LATEST
// version; the full history stays retained behind it.
//
// Storage / time-series choice (memql#1228): like every other concept,
// documentVersion rows live in the MemoryNodes TimescaleDB hypertable,
// which is partitioned on createdAt -- so version history is inherently
// time-partitioned with no extra physical table. createdAt is the
// hypertable time dimension and the natural ordering key for "show me
// the history" reads. History is LONG-LIVED: the migration
// (20260609000000_document_version_history) sets a long-window
// compression policy (compress chunks older than 90 days, segment by
// concept so a single document's history decompresses contiguously)
// and deliberately sets NO retention policy -- versions are never
// dropped on a schedule. See that migration's header for the full
// rationale.
//
// Per-row authz tier: owned. ownerUserId is stamped from actor.userId on
// every append -- the edit/restore handlers resolve the backing
// document's owner and run the append under that owner's actor, so the
// stamped value is the document owner and no caller can supply it
// (memql#2989); every read gates on ownerUserId==actor.userId so a
// caller can only ever see their own document history.

/// An immutable content snapshot of one logical Library document at one point in its edit history.
/// Appended -- never overwritten -- whenever a document is produced, edited (by user or assistant),
/// or restored, with a monotonically increasing versionNumber. The artifact index + backing
/// document always point at the LATEST version while the full append-only history is retained
/// behind it. Backed by the MemoryNodes TimescaleDB hypertable (partitioned on createdAt);
/// long-lived, compression-after-90-days, no retention drop (memql#1228). Per-row authz: owned --
/// ownerUserId is stamped from actor.userId on append; reads gate on
/// ownerUserId==actor.userId.
@displayCard(primary="documentId", secondary="note", tertiary="createdAt")
@rowAuthz(owner="ownerUserId")
concept documentVersion {
  ownerUserId      string!  @serverSet  @description("v1:identity:user.id that owns the logical document this version belongs to. Stamped from actor.userId on every append and never accepted from caller args: the edit/restore handlers resolve the backing document's owner and run the append under that owner's actor, so the stamped value is the document owner and ownership cannot be forged. @serverSet makes that a LOAD-TIME rejection rather than a convention, and the engine server-stamps the field from the @rowAuthz declaration above on the raw insert() surface that bypasses accept/stamp (memql#3059 / #3175). The load-bearing per-row authz key for every history read.")

  documentId       string!  @description("Logical document id this version belongs to -- the stable identity of the document ACROSS all its versions (e.g. the v1:library:generatedOutput id, or the artifact's sourceConceptRef). A PLAIN STRING foreign key, NOT an @relationship: it points across concepts to the backing document, and the only valid @relationship types (parent/contains/alias/equals) don't model a cross-concept content-history link. Every version of the same document shares this value; it is the grouping key for the history queries.")

  versionNumber    int!  @description("Monotonically increasing version number within the logical document, starting at 1 for the first snapshot. Computed server-side as (latest existing versionNumber for this documentId) + 1 on every append -- MemQL has no arithmetic, so the increment is done in the Go edit/restore handlers that read the current latest before inserting. The user-visible 'v3' label and the optimistic-concurrency token (an edit naming an expectedVersion that no longer matches the latest is a conflict).")

  content          string  @description("Inline text content for this version (markdown / plain text). The immutable body snapshot. File-backed documents leave this empty and carry bytes on attachmentId instead. body and/or attachmentId -- at least one is set.")

  attachmentId     string  @description("Back-reference to v1:common:attachment when this version is file-backed (a .docx / .pdf / .xlsx snapshot). The bytes live on the attachment row in blob storage; this version carries the metadata pointer. Empty for inline-text versions.")

  authorKind       enum("user", "assistant", "system")!  @description("Who authored this version. user = a person edited it directly (memql#1229); assistant = an agent revised it on the user's behalf (memql#1231); system = produced automatically (the initial version on document creation, or a restore append from memql#1230). Drives the history view's author badge and the provenance line.")

  authorId         string  @description("Identity of the author. For authorKind=user, the v1:identity:user.id; for authorKind=assistant, the v1:agents:agent.id; empty for system-authored versions. Read alongside authorKind for the 'edited by X' provenance line.")

  note             string  @description("Optional short human-readable note describing the change in this version (e.g. 'fixed the totals', 'restored from v2'). Surfaced in the history list so a user can scan what each version changed without diffing.")

  parentVersionId  string  @description("Id of the documentVersion row this one was derived from (the previous latest at append time, or the chosen source version for a restore). The append-only history's back-pointer chain -- empty only for the very first version of a document.")

  producedByPlanId string  @description("v1:planner:plan.id that produced this version, when an assistant/agent edit came through the planner. Provenance back-pointer mirroring the artifact/generatedOutput spine.")

  partitionId          string  @description("v1:cognition:space.id the edit happened in, when space-scoped. Carried for facet parity with the artifact index; empty for user-global edits.")

  // NOTE: the append timestamp is the row intrinsic `createdAt` (the
  // MemoryNodes hypertable time dimension + the natural history ordering
  // key) -- it is NOT declared as a concept field here because createdAt
  // is a reserved row intrinsic. The shapes project it via row.createdAt
  // and the append mutation stamps it via `createdAt: now` in the
  // insert block.

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="attachmentId", target=attachment, direction="outgoing")
  @relationship(type="parent", field="authorId", target=user, direction="outgoing")
  @relationship(type="references", field="producedByPlanId", target=plan, direction="outgoing")
}

// ---- memory: user-facing assistant (LLM) memory ----
//
// The durable things the assistant remembers about the user across
// sessions -- facts, preferences, standing instructions, episodic
// recollections. No user-facing memory concept existed before; this
// is it (#696). Surfaced in the Library's Records lens so the user can
// see and navigate what the assistant has retained. Per-row authz:
// owned -- created in the user's (or their delegated agent's) session,
// ownerUserId stamped from actor.userId; reads gate on
// ownerUserId==actor.userId. Auto-promoted via indexMemory.

/// A durable memory the assistant retains about the user across sessions (a fact, preference,
/// standing instruction, or episodic recollection). The user-facing LLM-memory concept; surfaced in
/// the Library's Records lens. Per-row authz: owned -- ownerUserId stamped from actor.userId; reads
/// gate on ownerUserId==actor.userId.
@displayCard(primary="title", secondary="content", tertiary="createdAt")
@rowAuthz(owner="ownerUserId")
concept memory {
  ownerUserId       string!  @description("v1:identity:user.id this memory is about / belongs to. Stamped from actor.userId at create time. The per-row authz key.")
  title             string!  @description("Short label for the memory, e.g. 'Prefers concise replies'. The primary display line.")
  content           string!  @description("The memory text itself -- what the assistant should recall.")
  summary           string  @description("Optional one-line summary for dense list rendering.")
  kind              enum("fact", "preference", "instruction", "episodic", "other")! @default("fact")  @description("Memory flavor. fact = stable truth about the user; preference = how they like things done; instruction = a standing directive; episodic = a specific past interaction worth recalling.")
  agentId           string  @description("v1:agents:agent.id that formed / owns this memory, when agent-scoped. Empty for user-global memories.")
  partitionId           string  @description("v1:cognition:space.id this memory was formed in, when space-scoped.")
  sourceUtteranceId string  @description("Optional back-reference to the v1:cognition:utterance that produced this memory -- provenance for 'where did the assistant learn this'.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="agentId", target=agent, direction="outgoing")
  @relationship(type="references", field="sourceUtteranceId", target=utterance, direction="outgoing")
}

// ---- file: the Library's own byte-bearing row ----
//
// The sixth backing concept (memql#4340, design D1). Documents cover
// files a product's knowledge pipeline ingested; generatedOutput covers
// deliverables the app produced. Neither covers "a person put a file in
// their Library" -- any type, any size under the cap, no knowledge
// domain, no space. `file` is that row, and it is what makes the
// Artifacts page a place to PUT things rather than only a place to see
// what the system happened to make.
//
// It rides no other concept's routes deliberately (D1): v1:common:attachment
// is pack-owned, carries a 25 MB cap and a MIME allowlist, and needs a
// space the engine would have to invent. `POST /artifacts` and
// `GET /artifacts/{id}/content` are the pair, inside the multipart
// exception CLAUDE.md already records.
//
// THE INDEX STILL OWNS NO CONTENT. Every byte fact -- name, mimeType,
// size, sha256, blobUrl -- lives here; v1:library:artifact carries only
// what the listing and the facets need, exactly as memql#693 locked it.
// indexFileOnCreate promotes a new file into an artifact index row
// (kind=file, lens=artifact).
//
// TRAINING IS A SEPARATE ACT (D7). A file in the Library is the owner's
// the moment it lands; putting it into a knowledge domain is a decision
// recorded on the row (trainedIntoDomainIds), never a default.

/// A file the owner put in their Library -- uploaded, exported from another artifact, produced by
/// an agent, or derived from another file. The Library's own byte-bearing row: the bytes live in
/// blob storage at blobUrl, and every fact about them (name, mimeType, size, sha256) lives here
/// rather than on the artifact index, which owns no content (memql#693). Any MIME type is accepted;
/// an unknown one is stored opaquely with status=ready and no chunks. Promoted into the Library by
/// indexFileOnCreate. Per-row authz: the composite tier (memql#4312) -- the owner, or a cluster
/// owner; ownerUserId is stamped from actor.userId and never accepted from caller args.
@displayCard(primary="name", secondary="summary", tertiary="createdAt", status="status")
@rowAuthz(owner="ownerUserId", clusterOwner)
concept file {
  ownerUserId  string!  @serverSet  @description("v1:identity:user.id that owns this file. Stamped from actor.userId on every write and never accepted as a mutation arg -- the upload route runs as the authenticated caller, and the detached analysis pass re-enters under that same user's actor (auth.ContextWithUserActor). @serverSet turns 'never a caller arg' into a LOAD-TIME rejection (memql#3175); the engine also server-stamps it from the @rowAuthz declaration above on the raw insert() surface that bypasses accept/stamp (memql#3059). The load-bearing per-row authz key.")

  name         string!  @description("Original filename as the owner sees it, sanitised at upload (path separators and control characters removed, length bounded). Also the filename the export route puts in Content-Disposition, and the last segment of blobUrl.")

  mimeType     string!  @description("Content type as uploaded, or sniffed from the leading bytes when the client sent none. ANY type is accepted -- there is no allowlist here, which is one of the reasons the Library does not ride the attachment routes (design D1). An unrecognised type is stored opaquely: status goes straight to ready, no text is extracted and no chunks are written.")

  size         int!  @description("Size of the stored bytes. Bounded at upload by MEMQL_LIBRARY_MAX_UPLOAD_BYTES (default 256 MB, sized so a site bundle fits). Recorded from what was actually written to blob storage, not from the client's Content-Length.")

  sha256       string  @description("Lowercase hex SHA-256 of the stored bytes. A DEDUP HINT and an integrity check -- NEVER an access key: knowing it grants nothing, because the download route resolves the artifact under the caller's own actor and there are no signed URLs anywhere in this design. OPTIONAL since memql#4782: a one-shot upload computes it inline, but a chunked upload's handler never holds the whole file, so the row lands in 'stored' with this ABSENT and the analysis pass stamps it by streaming the committed blob once. Absent means 'not measured yet', never 'no hash exists' -- readers render a dash, not an error.")

  blobUrl      string!  @description("Where the bytes live: 'library/{userId}/{fileId}/{name}' through integration.storage.upload. A STORAGE PATH, not a URL a browser can fetch -- the bytes only ever reach a viewer through GET /artifacts/{id}/content, which re-checks row admission and streams them; it never redirects.")

  source       enum("uploaded", "exported", "agent_generated", "derived")!  @description("Provenance -- how the file came to be. uploaded = a person put it there; exported = written out of another artifact by the export route; agent_generated = an agent produced it as a standalone deliverable; derived = computed from another file. Copied onto the artifact index row's own source field at promotion.")

  format       enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "conversation", "other")  @description("High-level content classification DERIVED FROM mimeType by the writer that knows the MIME (the upload route, or the analysis pass when the type had to be sniffed). Carried onto the artifact index at promotion, where it picks the Library viewer. Held on the row rather than computed in indexFileOnCreate because an automation step argument has no conditional form -- the mapping is a Go table, and the row is where its answer is recorded once. Defaults to 'other', which renders the metadata-only card.")

  status       enum("stored", "analyzing", "ready", "failed")!  @description("Lifecycle of the analysis pass. stored = bytes are durable and nothing has looked at them yet; analyzing = extraction / chunking / embedding in flight; ready = terminal success (including the unknown-type case, which is ready with no chunks); failed = terminal failure, with failureReason set. Never a silent partial: a pass that gives up sets failed and says why.")

  summary      string  @description("Short description of the contents, written by the analysis pass for the types it can read. Empty for opaque types. Copied onto the artifact index row's summary so the Library list can render it without a join.")

  failureReason string  @description("Why status is failed, in terms an owner can act on ('could not extract text from a password-protected PDF'). Empty unless status==failed. Carried on the row rather than only in a log because the person who uploaded the file is the one who needs to see it.")

  embeddingStatus enum("none", "partial", "complete")  @default("none")  @description("How much of the file is searchable by meaning. none = no chunks embedded (an opaque type, or the pass has not run); partial = some chunks embedded and the pass stopped; complete = every chunk of the file has an embedding. Read by librarySimilarArtifacts to say whether a miss means 'not similar' or 'not indexed yet'.")

  trainedIntoDomainIds []string  @description("Ids of the knowledge domains this file has been trained into, appended one at a time by libraryTrainFile (design D7). Upload and train are two acts: nothing here is trained by default, and this list is the record of every deliberate one. A []string of domain ids rather than a relationship because the target concept is product-owned and the engine tree does not declare it.")

  archived     bool  @default("false")  @description("Soft delete, set by archiveLibraryFile -- and set for you by archiveArtifact when the artifact being archived is backed by this file, so the two never disagree. The bytes are NOT deleted: the row keeps its blobUrl and its provenance, and the append-only history keeps every earlier version.")

  folderId     string  @description("v1:library:folder.id the upload was filed under -- the INITIAL FILING ONLY (memql#4781, design B2). The upload route knows the target folder, and the promotion automation can only forward what the backing row carries: the same 'the writer knew it' reasoning format already uses. After promotion the artifact index's own folderId is authoritative -- a later move updates the index and deliberately never comes back here, so this copy is a record of where the file LANDED, not where it is.")

  uploadedFromWorkerId  string  @description("v1:worker:registration.id of the fleet machine this file was uploaded FROM, when the uploader honestly knows it (memql#4781, design D5): a cockpit push names its own worker registration; a browser physically cannot name a machine and sends nothing -- no identity is ever invented, and nothing here is guessed from a user agent. VERIFIED at write time: the named registration must belong to the uploading user, read under the caller's own actor, and a claim that fails verification REFUSES the upload with a typed error rather than silently blanking -- a silently-dropped field would render as 'uploaded here', which is a lie. This axis is called PROVENANCE; 'origin' stays reserved for the data-origins system (memql#4378). Doubles as the future sync epic's machine half of the (machine, path) key.")

  uploadedFromWorkerName  string  @description("Human-readable name of the machine uploadedFromWorkerId names, resolved from the caller's own verified worker registration at upload time (displayName when the owner set one, else the reported hostname) -- never taken on faith from the request, so the label the Files app renders is the label the fleet already shows for that machine. Empty whenever uploadedFromWorkerId is.")

  uploadedFromPath  string  @description("Absolute path the file occupied on the uploading machine, as the cockpit reported it (e.g. '/Users/a/Reports/q3.pdf'). Stamped only where honestly known -- a browser upload carries none. Stays on THIS row and is deliberately not promoted to the index: the Files app's inspector reads the file row, and the future watched-folder sync epic keys re-pushes on (uploadedFromWorkerId, uploadedFromPath) read from here (design E).")

  versionNumber  int  @description("Which version of this file the CURRENT row holds -- 1 at upload, incremented by supersedeLibraryFileHead each time somebody uploads a new version at this artifact (epic memql#4806, design D1). The head is always the newest version; every superseded one is its own immutable v1:library:fileVersion row. ABSENT MEANS 1, and it has to: every file uploaded before this field existed has no member at all, and a reader that treated absence as 0 would render 'v0' on every file in the Library. The counter lives here rather than being computed from the version rows because a count is not a version number -- a history read the caller could not complete would silently renumber the head.")

  versionUploadedAt  datetime  @description("RFC3339 moment the CURRENT version's bytes arrived. Stamped at upload and re-stamped on every supersede. NOT the same fact as the row intrinsic createdAt, which is why it is declared: MemQL is append-only, so an update materialises a NEW row and createdAt is the moment of the LAST WRITE -- an analysis status transition moves it. The history panel says 'uploaded 3 weeks ago' from this field; reading createdAt would have it say 'uploaded a minute ago' because the summariser finished a minute ago.")

  linkState  enum("synced", "stale", "origin_gone")  @description("How this copy stands against the machine it was pushed from -- the watched-folder backup's per-file state (epic memql#4783). synced = the copy matched the origin when it was last checked; stale = the origin changed and the new bytes have not arrived; origin_gone = the file is no longer at that path, or the machine is no longer reachable. THE INVARIANT IS THAT THIS FIELD ONLY EVER FLAGS: a deletion or a disconnection at the origin sets origin_gone and NEVER archives, moves or deletes the MemQL copy, because the whole point of a backup is that it outlives the thing it copied (design E, D12). ABSENT means this file has no origin link at all -- a browser upload has none to have, and every file stored before this field existed has no member. Absent is deliberately not a fourth state: 'we do not track this file' and 'we track it and it is fine' are different answers and must not share a spelling. The upload route stamps synced on any push that names a (machine, path), because at the instant those exact bytes arrived the copy DID equal the origin; every later transition is reported by the cockpit's verify lane through setLibraryFileLinkState.")

  linkCheckedAt  datetime  @description("RFC3339 moment linkState was last established. Displayed CONTINUOUSLY beside the state rather than fingerprinted into the arrival cue: a verify lane touches this on a schedule for every watched file forever, so naming it as news would strobe the Files list on the sweep's own cycle (the heartbeat rule, clients/os/README.md). It is what makes a stale `synced` honest -- 'synced, checked 3 weeks ago' is a different claim from 'synced', and only one of them is one this row can make.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="uploadedFromWorkerId", target=registration, direction="outgoing")
  @relationship(type="references", field="folderId", target=folder, direction="outgoing")
}

// ---- fileVersion: what a file used to be (epic memql#4806) ----
//
// The engine destroyed nothing before this concept existed -- every write
// was retained in the hypertable and every upload's bytes sat at their own
// immutable path -- but none of it was reachable: the query path returns one
// row per id by design, so there is no client route to an earlier version of
// a row. That is the whole reason documentVersion exists rather than a
// documentHistory read, and it is the reason this concept exists too.
//
// THE HEAD IS THE FILE ROW. v1:library:file always holds the newest bytes,
// so every existing reader -- the content route, the analysis pass, the
// artifact promotion, the Files list -- is unchanged. A supersede snapshots
// the OUTGOING head into one of these rows and then updates the file in
// place, which is what keeps the artifact index's sourceConceptRef (and
// therefore its derived id, and therefore libraryArtifactBySourceConceptRef)
// pointing at the same string forever. Re-pointing it is where the
// version-chained-file-rows alternative died; design D1 has the full
// reasoning.
//
// IMMUTABLE ONCE WRITTEN. Nothing in this epic updates a version row and
// nothing deletes one. Its blobUrl names a path no other version has ever
// used, so superseding cannot overwrite stored bytes -- the library's D12
// durability invariant holds here by construction rather than by care.

/// One superseded version of a Library file: the byte facts, the provenance and the two moments
/// that version had, frozen at the instant it stopped being the head (epic memql#4806, design D1).
/// The newest version is NEVER one of these rows -- it is the v1:library:file itself, which is what
/// lets the artifact index, the content route and the analysis pass go on reading exactly one row.
/// Written only by supersedeLibraryFile through the @serverOnly pair, at the derived id
/// '<fileId>-v<n>' so a retried supersede re-versions the same row instead of appending a duplicate
/// to somebody's history. Per-row authz: the composite tier (memql#4312) -- the owner, or a cluster
/// owner -- matching the file it is a version of.
@displayCard(primary="name", secondary="summary", tertiary="uploadedAt")
@rowAuthz(owner="ownerUserId", clusterOwner)
concept fileVersion {
  ownerUserId  string!  @serverSet  @description("v1:identity:user.id that owns the file this version belongs to. Stamped from actor.userId, never accepted as a mutation arg (@serverSet makes that a load-time rejection, memql#3175); the supersede runs under the uploading caller's actor, and the target file was already resolved under that same actor, so the stamped owner is the file's owner by construction. The load-bearing per-row authz key -- it is duplicated here rather than resolved through fileId because the history read admits or denies each version row in its own right, with no join.")

  fileId       string!  @description("v1:library:file.id this is a version of -- the grouping key libraryFileVersionsForFile reads, and the stable identity of the file ACROSS every version. Never changes: the head keeps its id forever, which is the whole point of design D1.")

  versionNumber  int!  @description("Which version this row froze, 1-based. Every version of a file has exactly one number: 1..N-1 live on these rows and N is the head file row's own versionNumber. The pair (fileId, versionNumber) is unique by construction -- the row id derives from it -- so a client folding head-plus-history keys on this and a retried supersede cannot produce two rows claiming the same number.")

  name         string!  @description("The filename THIS version had. Carried rather than resolved from the file row because a new version may arrive under a different name (a person re-exports 'q3-final.pdf' over 'q3.pdf'), and a history that renamed the past would be telling the reader something that did not happen.")

  mimeType     string!  @description("Content type of THIS version's bytes, as uploaded or sniffed. Same reason as name: a version's own facts are frozen with it, never inherited from whatever the head happens to be now.")

  size         int!  @description("Size of THIS version's stored bytes. Counted by the storage quota exactly like a file row's (design D9): retention is real, superseding destroys nothing, and a quota that ignored history would refuse a person using numbers they cannot see.")

  sha256       string  @description("Lowercase hex SHA-256 of THIS version's bytes, when it was measured. Absent means 'not measured', never 'no hash exists' -- a chunked upload's handler never holds the whole file, so the head can be superseded before the analysis pass has streamed the blob. Readers render a dash. A dedup hint and an integrity check, NEVER an access key: knowing it grants nothing, because the content route resolves the version under the caller's own actor and there are no signed URLs anywhere in this design.")

  blobUrl      string!  @description("Where THIS version's bytes live: 'library/{userId}/{fileId}/v{n}/{name}'. A STORAGE PATH, not a URL a browser can fetch -- the bytes only ever reach a viewer through GET /artifacts/{id}/content?version={n}, which re-checks row admission and streams them. The reason the version mutations are @serverOnly: a caller-authored blobUrl could name another user's object, and the content route would then serve it.")

  format       enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "conversation", "other")  @description("High-level content classification of THIS version, derived from its own mimeType by the writer that knew it. Frozen with the version for the same reason name and mimeType are.")

  summary      string  @description("The summary the analysis pass had written for THIS version's contents when it was superseded, or empty when the pass never ran or the type was opaque. What lets the history say what each version was ABOUT rather than only how big it was.")

  uploadedFromWorkerId  string  @description("v1:worker:registration.id of the fleet machine THIS version was uploaded from, when the uploader honestly knew it. Frozen per version and never inherited (the epic's own rule): a file first dropped from a browser and later pushed from a laptop has one version that names a machine and one that does not, and saying otherwise would invent provenance. Verified at ITS OWN upload, exactly as v1:library:file.uploadedFromWorkerId documents.")

  uploadedFromWorkerName  string  @description("The fleet's own label for the machine uploadedFromWorkerId names, resolved from the verified registration at the moment THIS version was uploaded. Empty whenever uploadedFromWorkerId is. Frozen deliberately: a machine renamed since is still the machine this version came from under the name the fleet used then.")

  uploadedFromPath  string  @description("Absolute path THIS version occupied on the uploading machine, where honestly known -- a browser upload carries none. The future watched-folder epic (#4783) keys its re-pushes on (uploadedFromWorkerId, uploadedFromPath), and per-version history of that pair is what lets it say which push produced which version.")

  uploadedAt   datetime!  @description("RFC3339 moment THIS version's bytes arrived, copied from the head's versionUploadedAt at snapshot time. Declared rather than read from the row intrinsic createdAt because createdAt on this row is when the SNAPSHOT was written -- which is the supersede moment, not the upload moment. The two are different facts and the history panel shows both.")

  supersededAt  datetime!  @description("RFC3339 moment this version stopped being the head, because a newer one landed. Equal to the row's own createdAt in practice; declared because a reader must not have to know that, and because a future re-write of this row for any reason would move the intrinsic and not this.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="fileId", target=file, direction="outgoing")
  @relationship(type="references", field="uploadedFromWorkerId", target=registration, direction="outgoing")
}

// ---- fileChunk: the similarity substrate ----
//
// Chunks live in the library namespace, not on v1:knowledge:documentChunk
// (design D2). That concept requires a knowledge domain, and the domain
// concept is not declared in the engine tree at all -- so riding it would
// make every Library upload a knowledge-domain decision, which is exactly
// the coupling D7 exists to refuse.
//
// Chunking reuses the knowledge splitter's defaults (about 1800
// characters, 180 overlap) and each chunk is embedded through
// integration.embedding.store -- the same call dsl/harness and
// dsl/authoring make. librarySimilarArtifacts runs similarTo over these
// rows and folds the hits up to artifacts by best score.
//
// @no-displayCard: a chunk is machinery, never a row a person is shown.
// Its fields are two foreign keys, a sequence number, a token count and a
// slice of body text with no title -- a forced primary would render the
// first 1800 characters of somebody's PDF as a card heading. The
// documented fallback is the better rendering; the artifact the chunk
// rolls up to is what the Library actually displays.

/// One chunk of a Library file's extracted text, embedded for similarity search. Written by the
/// analysis pass, one row per chunk in file order; librarySimilarArtifacts runs similarTo over these
/// and folds the hits up to their artifacts by best score. Deliberately NOT v1:knowledge:documentChunk,
/// which requires a knowledge domain the engine tree does not declare (design D2). Per-row authz: the
/// composite tier (memql#4312), the same as the file it belongs to -- ownerUserId is stamped from
/// actor.userId, never accepted from caller args.
@rowAuthz(owner="ownerUserId", clusterOwner)
concept fileChunk {
  ownerUserId  string!  @serverSet  @description("v1:identity:user.id that owns the file this chunk came from. Stamped from actor.userId: the analysis pass runs under the file owner's actor, so the chunk lands owned by the same person as its file. @serverSet makes 'never a caller arg' a load-time rejection (memql#3175). The per-row authz key -- it is duplicated here rather than resolved through fileId because a similarity read matches CHUNKS first and must be able to admit or deny each one without a join.")

  fileId       string!  @description("v1:library:file.id this chunk was extracted from. The grouping key for libraryFileChunksForFile, and what a similarity hit resolves back through.")

  artifactId   string!  @description("v1:library:artifact.id of the index row the file was promoted to. Carried on the chunk so a similarity hit folds straight up to the artifact the Library lists, with no second read to resolve the promotion. Written by the analysis pass, which resolves it through libraryArtifactBySourceConceptRef.")

  seq          int!  @description("Zero-based position of this chunk in the file's text, in file order. Chunks overlap by design (about 180 characters), so seq orders them but does not partition the text.")

  text         string!  @description("The chunk body -- the extracted text this row's embedding was computed from. About 1800 characters, the knowledge splitter's default. This is what a similarity match is actually matching against, and what a citation would quote.")

  tokenCount   int  @description("Approximate token count of text, recorded when the embedding was computed. Advisory: it drives batching and cost accounting, and nothing reads it as a correctness signal.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="fileId", target=file, direction="outgoing")
  @relationship(type="references", field="artifactId", target=artifact, direction="outgoing")
}

// ---- folder: the Files app's Drive-model tree ----
//
// The Library's file system (memql#4781, design D3): folder rows plus a
// folderId pointer on the index. THE DRIVE MODEL, NOT POSIX -- ids, never
// path strings; sibling name duplicates allowed (a folder is a collection,
// not a namespace, so there is no uniqueness machinery and no rename
// conflict); no permission tree, because row authz is unchanged and a
// folder confers nothing. A move is one row update; a rename touches
// nothing else.
//
// Depth is capped at 12 and cycles are refused CLIENT-SIDE in v1 (design
// D11): the client holds the owner's whole small tree and the engine has
// no loop construct, so the server-side cascade + integrity guard is a
// recorded hardening follow-up rather than built here. The client's tree
// fold is cycle- and orphan-TOLERANT on top of that (a violating folder
// renders at root with a marker), so a hostile or buggy writer can degrade
// the picture but never break it.

/// One folder in the owner's Library tree (memql#4781, design B1/D3): a named collection artifacts
/// and other folders point INTO via ids -- never a path segment, never a namespace. parentFolderId
/// nests it (empty or absent = root); sibling name duplicates are allowed by design, so there is no
/// uniqueness machinery to fight and a rename touches exactly one row. Archiving is the same soft
/// delete every Library row gets -- the client-driven walk archives contents first (design B5), and
/// a folder that vanishes under its children only degrades the picture: the tree fold renders
/// orphans at root with a marker. A folder whose subtree holds no file at all takes the OTHER
/// disposition instead: `deleted`, which no surface shows and no restore undoes, because there is
/// nothing inside it for anybody to want back. Per-row authz: the composite tier (memql#4312) --
/// the owner, or a cluster owner -- matching artifact and file, whose rows it organizes.
@displayCard(primary="name", tertiary="createdAt")
@rowAuthz(owner="ownerUserId", clusterOwner)
concept folder {
  ownerUserId     string!  @serverSet  @description("v1:identity:user.id that owns this folder. Stamped from actor.userId on every write and never accepted as a mutation arg (@serverSet makes that a load-time rejection, memql#3175); the engine also server-stamps it from the @rowAuthz declaration on the raw insert() surface. The load-bearing per-row authz key -- a folder is the owner's the way their files are, and confers no permissions of its own.")

  name            string!  @description("Display name of the folder, as the owner typed it. NOT a namespace: sibling duplicates are allowed (design D3), so nothing anywhere compares two folders by name -- the id is the identity, and a rename is one field on one row.")

  parentFolderId  string  @description("v1:library:folder.id of the containing folder; empty or absent = a root folder. Declared as a self-referential `references` relationship below -- an edge, not a hierarchy the engine enforces: depth cap (12) and cycle refusal are the CLIENT's in v1 (design D11), and the tree fold tolerates violations defensively, rendering the offender at root with a marker, so a bad write degrades the picture rather than breaking it.")

  archived        bool  @default("false")  @description("Soft delete, set by archiveLibraryFolder. libraryFolders filters it with the null-safe `archived != true` spelling, so rows written before any future field change keep listing. The client-driven archive walk (design B5) archives a folder's CONTENTS first, children-first, then the folder -- idempotent under interruption, and re-running archives the remainder. Removing a desk shortcut is NEVER this write.")

  deleted         bool  @default("false")  @description("The disposition of a folder whose subtree held NO FILE AT ALL, at any depth, when somebody archived it -- set by deleteLibraryFolder, which the archive walk calls instead of archiveLibraryFolder for exactly those folders. Every folder read carries the isNotDeleted trait (the null-safe `deleted != true` spelling, for the reason archived above records), so a deleted folder leaves the tree, the Bin and a by-id resolve together: there is no surface it still appears on. NOT A FLAVOUR OF archived, and the difference is not cosmetic -- nothing archived this row. Archiving exists so a person can get something back, and an empty folder tree has nothing in it to get back, so an archived one would be a line in the Bin that answers no question anybody asked. NO RESTORE PATH RESURRECTS IT: restoreLibraryFolder clears archived and deliberately never touches this field, because a row every surface excludes is a row nothing can ask to have back.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="parentFolderId", target=folder, direction="outgoing")
}

// ---- uploadSession: chunked resumable transfer (memql#4782) ----
//
// Files over the one-shot threshold arrive as CHUNKED SESSIONS over Azure
// block-blob staging (design D8): open a session, PUT 16 MiB chunks to
// staged blocks, commit. The session row is two things at once:
//
//   - THE PER-CHUNK AUTHORIZATION. Every chunk PUT and the complete resolve
//     the session under the caller's own actor, and row admission IS the
//     owner check -- a session that is not yours is a session that is not
//     there. No side table, no bearer re-parse.
//   - THE RECORD OF INIT-TIME FACTS complete needs: the declared size the
//     commit is verified against, the blob path the blocks staged into, the
//     fileId the file row will take, the filing and the verified provenance.
//
// REPLICA-AGNOSTIC BY CONSTRUCTION: staged blocks live with the blob in
// storage and this row lives in the graph, so ANY bff serves any chunk and
// completes any session -- no replica holds session state in memory, which
// is the multi-node rule holding by construction rather than by care.
//
// NO SWEEPER, deliberately. An abandoned session row is inert (its owner
// can read it; nothing else ever will), its staged blocks garbage-collect
// on Azure's ~7-day uncommitted-block clock, and clients purge their local
// resume records on the same clock. The `abandoned` status value exists so
// the lifecycle can be stated in full; nothing writes it in v1 -- abandoning
// IS stopping, and a stopped session needs no write to be abandoned.
//
// @no-displayCard: transfer machinery, never a row a person is shown. Its
// fields are a filename, byte counts, a storage path and a lifecycle enum;
// the row a person sees is the v1:library:file the session completes into,
// which carries the real card. The documented fallback is the better
// rendering for the operator spelunking case.

/// One chunked upload in flight (memql#4782, design C2): the per-chunk authorization row (row
/// admission is the owner check) and the record of init-time facts the complete step needs. Staged
/// blocks live with the blob in Azure, never in any replica's memory, so any bff serves any chunk.
/// Written ONLY by the upload routes through @serverOnly mutations: blobPath and fileId are
/// storage-layer facts a caller must never author -- a forged blobPath would point complete at
/// somebody else's bytes. Abandoned sessions are inert rows; their staging garbage-collects on
/// Azure's ~7-day clock and no sweeper exists. Per-row authz: the composite tier (memql#4312),
/// matching every other Library concept.
@rowAuthz(owner="ownerUserId", clusterOwner)
concept uploadSession {
  ownerUserId  string!  @serverSet  @description("v1:identity:user.id that opened this session. Stamped from actor.userId on every write and never accepted as a mutation arg (@serverSet, memql#3175). The per-row authz key, and therefore the WHOLE per-chunk authorization: chunk PUTs resolve the session under the caller's actor, and a session that is not theirs does not resolve.")

  name         string!  @description("Original filename as the owner will see it, sanitised at session init exactly as the one-shot route sanitises it -- it becomes the last segment of blobPath and, at complete, the file row's name.")

  size         int!  @description("Declared total size in bytes, bounded by MEMQL_LIBRARY_MAX_UPLOAD_BYTES at init. A CLAIM the commit verifies: complete sums the staged blocks and refuses a mismatch, so a client that lied about size gets a refusal, not a truncated file. Also what the chunk route bounds n against (n <= ceil(size / chunkSize)), so staging is bounded by the declaration.")

  mimeType     string  @description("Content type as declared at init; complete passes it to createLibraryFile verbatim, where the one-shot route's own rules (any type accepted, opaque when unknown) apply unchanged.")

  folderId     string  @description("v1:library:folder.id the finished file will be filed under -- the same initial-filing semantics file.folderId documents (memql#4781, design B2), recorded at init because complete must not re-ask the client anything.")

  labels       []string  @description("Labels to apply to the promoted artifact at complete, through the same builtin the one-shot route uses -- so a label applied through a chunked upload is indistinguishable from any other.")

  uploadedFromWorkerId  string  @description("Verified machine provenance, exactly as file.uploadedFromWorkerId documents (design D5): verified against the caller's own fleet at INIT -- fail-fast, before anyone streams gigabytes -- and forwarded to the file row at complete.")

  uploadedFromWorkerName  string  @description("The fleet's own label for the machine, resolved from the caller's verified registration at init (displayName, else hostname). Empty whenever uploadedFromWorkerId is.")

  uploadedFromPath  string  @description("Absolute path the file occupies on the uploading machine, as reported at init. Carried to file.uploadedFromPath at complete; the future sync epic keys on it.")

  blobPath     string!  @description("Where the staged blocks live and the committed blob will land: library/{userId}/{fileId}/{name}, composed SERVER-SIDE at init from the verified actor and the engine-minted fileId. The reason the session mutations are @serverOnly: a caller-authored blobPath could name another user's object, and complete would then mint a file row whose bytes are somebody else's.")

  fileId       string!  @description("The v1:library:file id complete will create -- minted by the engine at init so the blob path, the resume records and the eventual row all agree on one identity before a single byte moves.")

  targetArtifactId  string  @description("The v1:library:artifact this session uploads a NEW VERSION of, when it is a supersede rather than a fresh upload (epic memql#4806, design D7). Empty is the ordinary case and means complete creates a file row; set means complete supersedes the artifact's existing one, and fileId above is then that EXISTING file's id rather than a fresh mint. Recorded at init because the three target gates -- the artifact resolves under the caller's actor, its kind is file, its backing row resolves -- run there, before anybody streams gigabytes; complete must not re-ask the client anything, least of all which artifact it is allowed to write to.")

  chunkSize    int!  @description("Chunk size in bytes -- 16 MiB, a constant of the design (D8), not a knob. Recorded on the row so complete and resume compute ceil(size / chunkSize) from what THIS session was opened with, even if the constant ever changes between releases.")

  status       enum("open", "completed", "abandoned")!  @description("Lifecycle. open = accepting chunks; completed = the block list committed and the file row exists (terminal); abandoned = declared but unwritten in v1 -- a stopped session needs no write to be abandoned, its staging garbage-collects server-side on Azure's ~7-day clock, and the row itself is inert either way. Stamped 'open' at init and never accepted from args: a caller who could re-open a completed session could drive complete twice.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="folderId", target=folder, direction="outgoing")
  @relationship(type="references", field="fileId", target=file, direction="outgoing")
  @relationship(type="references", field="targetArtifactId", target=artifact, direction="outgoing")
  @relationship(type="references", field="uploadedFromWorkerId", target=registration, direction="outgoing")
}

// ---- watchedFolder: a standing promise, not a file (epic memql#4783) ----
//
// One folder on one of the owner's machines, kept arriving in the Library.
// The engine half of the watched-folder backup (memql#4841): the ENGINE holds
// the arrangement, the COCKPIT does the watching, and the split is not
// negotiable in either direction -- only the cockpit can see the origin, and
// only the graph can survive the machine being off.
//
// WHY THE CONFIGURATION LIVES HERE AND NOT IN THE COCKPIT'S policy.yaml. A
// watch is something a person sets up once and then expects to be able to
// see, pause and re-point from wherever they happen to be -- including from a
// browser, on a different machine, while the watching machine is asleep. A
// file on the machine's own disk can answer none of those. It also makes the
// arrangement survive a re-install: the cockpit asks what it is watching
// rather than remembering.
//
// THE COCKPIT READS THIS AS THE OWNING USER, NOT AS THE WORKER. A worker
// token is surface-pinned to WorkerService and cannot read the graph or reach
// the upload routes at all; the cockpit is separately signed in, and every
// read and every push therefore runs under the person's own actor. That is
// what makes the authorization story here exactly the browser's, with no
// second one to keep in step -- and it is why `workerId` below carries no
// engine-side ownership check: the enforcement that matters lives at the
// upload, where verifyProvenance resolves the claimed machine in the CALLER's
// own fleet and refuses anything else.
//
// A WATCH NAMING A MACHINE THE OWNER DOES NOT HAVE IS INERT, NOT DANGEROUS.
// watchedFoldersForWorker filters on ownerUserId, so another person's cockpit
// never sees this row; the worst case is a dangling reference in the owner's
// own list, which the Files app renders as the raw id the way view-kit
// renders every unresolvable lookup.
//
// ONE-WAY FOREVER, and this concept cannot express anything else: there is no
// field for what MemQL would send back, because nothing is ever sent back. A
// deletion at the origin flags (v1:library:file.linkState = origin_gone) and
// never removes the copy -- design E's load-bearing invariant, stated on the
// file row and restated here because this is the row that starts the whole
// arrangement.
/// One folder on one of the owner's fleet machines, continuously backed up into a Library folder
/// (epic memql#4783, the cockpit half memql#4841). The engine holds the arrangement and the state
/// last reported about it; the cockpit does the sweeping, the pushing and the looking-at-the-origin,
/// because it is the only party that can see the origin at all. Per-row authz: the composite tier
/// (memql#4312) -- the owner, or a cluster owner -- matching every other Library concept, so an
/// operator answering "why has this machine stopped backing up" can read the arrangement without
/// being able to rewrite it.
@displayCard(primary="localPath", secondary="workerId", tertiary="lastSweepAt", status="status")
@rowAuthz(owner="ownerUserId", clusterOwner)
concept watchedFolder {
  ownerUserId   string!  @serverSet  @description("v1:identity:user.id that set this watch up. Stamped from actor.userId on every write and never accepted as a mutation arg (@serverSet makes that a load-time rejection, memql#3175). The load-bearing per-row authz key, and also the routing key: a cockpit signed in as this user is the only one that will ever read this row.")

  workerId      string!  @description("v1:worker:registration.id of the machine that does the watching. Deliberately NOT verified against the caller's fleet at write time -- the row is a preference and the gate that matters is at the upload, where verifyProvenance resolves the claimed machine in the caller's own fleet and refuses anything else (see the header). A watch naming a machine the owner does not have is read by no cockpit and pushes nothing.")

  localPath     string!  @description("Absolute path of the folder ON THAT MACHINE, as the person typed it -- '/Users/ana/Clients/2026' or 'C:\\Work\\Renders'. A string the engine never interprets: it has no filesystem to resolve it against, cannot tell a typo from a folder that is merely offline, and must not pretend otherwise. The cockpit is what finds out, and it says so through originState below. Also the PREFIX half of the (machine, path) key every re-push versions on -- each file's own uploadedFromPath is this path plus its position beneath it.")

  folderId      string  @description("v1:library:folder.id everything from this watch is filed under; empty or absent means the Library root. The DESTINATION, and the only part of the arrangement the person can see the contents of without leaving the browser -- which is why the Files app draws the watch as a link between two named ends rather than as a row of settings. Re-pointing it moves nothing that already arrived: files carry their own folderId, so a change here decides where the NEXT push lands, and the app says so at the moment of the change.")

  status        enum("active", "paused")!  @default("active")  @description("Whether the cockpit should be sweeping this folder right now. `paused` is a real state a person wants -- 'stop for today, keep the arrangement' -- and is deliberately not modelled as archived: pausing is reversible in one click and keeps the watch in the list, archiving takes it out of it. The cockpit reads both and skips paused ones; it does NOT delete its local record of a paused watch, so resuming does not re-push everything.")

  excludeGlobs  []string  @description("Path patterns beneath localPath that are skipped, matched by the cockpit against each entry's path RELATIVE to localPath ('node_modules/**', '*.tmp'). Client-side and cockpit-side only: the engine stores the list and never evaluates it, having nothing to evaluate it against. Empty or absent excludes nothing.")

  includeHidden bool  @default("false")  @description("Whether dot-prefixed entries are swept. Off by default because the common case -- a Documents or a client-work folder -- is full of '.DS_Store' and editor state nobody wants versioned, and a backup that silently fills with them is one people turn off.")

  archived      bool  @default("false")  @description("Soft delete: the watch is taken out of the list without destroying the record of what was arranged. Spelled and filtered exactly as its siblings are -- `archived != true`, the null-safe form, so rows written before any future field change keep listing (memql#1685). ARCHIVING A WATCH REMOVES NOTHING THAT ARRIVED THROUGH IT: the files are ordinary Library files owned by the same person, and the one-way invariant does not stop applying because the arrangement ended.")

  originState   enum("ok", "missing", "unreadable", "refused_by_policy")  @description("What the cockpit last SAW at localPath -- the folder-level counterpart of file.linkState, and it has the same absent-is-not-a-state discipline: ABSENT means no cockpit has reported yet, which is a genuine further answer ('waiting for that machine to check in') and must not read as ok. `missing` = nothing is at that path, which is the honest answer to a typo AND to a folder somebody moved, and the engine deliberately cannot tell those apart. `unreadable` = it is there and the process cannot read it (permissions, a TCC prompt nobody answered, an unmounted volume). `refused_by_policy` = THE MACHINE'S OWN OWNER HAS NOT ALLOWED THAT PATH, and it is a separate value rather than a flavour of unreadable because the repair is completely different and lives somewhere else: nothing about the folder is wrong, and no amount of looking at the Library will fix it -- somebody has to add the path to that machine's policy.yaml. Collapsing it into `unreadable` would send a person hunting for a permissions problem that does not exist. THE VETO IS THE POINT: this row is written from a browser and read by a cockpit, so the path in it is a path the CLUSTER is naming on somebody else's machine -- the same situation appsession's CheckWorkspace exists for, and the same answer. A watch is a request; the machine decides. No @default on the field, for the reason knowledgeDomain.tier records: nothing stamps a value at create, and an annotation nothing applies is a silent no-op.")

  lastSweepAt   datetime  @description("RFC3339 moment the cockpit last finished a pass over this folder. SERVER-STAMPED by reportWatchedFolderSweep rather than accepted from the report, for exactly the reason file.linkCheckedAt is: a caller that could name its own check time could claim to have looked when it did not, and the whole value of this field is that it is what makes a stale `ok` honest -- 'backed up, last checked 3 weeks ago' is a different claim from 'backed up'. Rendered CONTINUOUSLY beside the state and never fingerprinted into an arrival cue: a sweep touches this on a schedule forever, so naming it as news would strobe the list on the sweep's own cycle (the heartbeat rule, clients/os/README.md).")

  lastSweepError string  @description("What went wrong on the last pass, in the cockpit's own words, when something did. Empty on a clean pass. Shown verbatim rather than re-worded: the sentence names a path, a permission or an HTTP status the person can act on, and a friendlier paraphrase would lose the only part that helps.")

  filesSeen     int  @description("How many files the last sweep found beneath localPath, after exclusions. The origin's own count, which nothing else in the graph can answer -- the Library knows what ARRIVED, and the difference between the two is exactly what a person wants to see when a backup is behind. Absent on a watch nothing has reported yet.")

  bytesSeen     int  @description("Total size in bytes of those files at the origin. Same reason and same absence as filesSeen; rendered alongside it so 'watching 1,284 files, 42.1 GB' is one sentence about the origin rather than a claim about the copy.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="workerId", target=registration, direction="outgoing")
  @relationship(type="references", field="folderId", target=folder, direction="outgoing")
}
