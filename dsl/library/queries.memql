use common.traits.{ isOpen }

// library domain -- Library reads.
//
// Authz tier: owned. Every filter gates on
// payload.ownerUserId==actor.userId so a caller can only ever read
// their own Library; no arg widens the row set beyond their ownership.
//
// MemQL query filters are equality / membership predicates with no OR
// and no in-filter substring match, so the surface here mirrors the
// notes / calendar pattern: a small set of server-side-narrowed reads
// (all / by lens / by kind / by label / by space / by id) over the owner-scoped
// row set, with free-text SEARCH layered client-side over the returned
// page (the Library list panel, #298). The lens / kind / space facets
// ARE server-side -- as is the label facet, which is a membership
// predicate over a []string rather than an equality. They're the
// high-cardinality narrowing that
// matters; search is the cheap client-side refinement on top.

/// List the caller's entire Library (artifacts + records). Owned: the row set is gated by
/// ownerUserId==actor.userId server-side. The default Library read; the panel filters by lens /
/// kind and searches client-side over this set, or calls the narrower facet queries below when a
/// single facet dominates.
@actor
query artifact libraryArtifacts {
  // archived!=true is what makes archiveArtifact a soft DELETE rather than a
  // flag nobody reads.
  //
  // THE SPELLING IS LOAD-BEARING and `archived == false` is not the same
  // predicate. Every artifact row promoted before memql#4340 has no `archived`
  // member at all, and the two forms disagree about those rows: `!= true`
  // returns them (measured against Postgres --
  // TestArchivedFilterKeepsRowsWrittenBeforeTheFieldExisted), `== false` would
  // not, so the equality form would empty every existing Library on the deploy
  // that introduced the field. createArtifact writes the member on every new
  // row anyway, but the filter must not DEPEND on that.
  //
  // The narrower facet reads below deliberately do NOT carry it -- a caller
  // who asked for one lens, kind or label asked a question about that facet,
  // and the archive filter belongs to the DEFAULT list, which is the one a
  // person lands on.
  filter  ownerUserId==actor.userId && archived!=true
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   artifactFull
}

/// List the caller's Library rows for one lens (artifact | record) -- backs the Artifacts | Records
/// toggle. Owned: ownerUserId==actor.userId gates the row set; payload.lens narrows to the selected
/// lens.
@actor
query artifact libraryArtifactsByLens {
  args {
    lens  string!
  }
  filter  ownerUserId==actor.userId && lens==args.lens
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   artifactFull
}

/// List the caller's Library rows of one kind (document / generated_output / note / todo /
/// calendar_event / memory / live_source) -- backs the kind facet filter. Owned:
/// ownerUserId==actor.userId gates the row set; payload.kind narrows to the selected kind.
@actor
query artifact libraryArtifactsByKind {
  args {
    kind  string!
  }
  filter  ownerUserId==actor.userId && kind==args.kind
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   artifactFull
}

/// List the caller's Library rows carrying a given label -- backs the label facet filter. Owned:
/// ownerUserId==actor.userId gates the row set as a top-level, unguarded conjunct (it must hold even
/// when args.label is absent); the when() membership predicate narrows to rows whose labels include
/// the given value.
@actor
query artifact libraryArtifactsByLabel {
  args {
    label  string!
  }
  filter  ownerUserId==actor.userId && when(args.label) { args.label in labels }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   artifactFull
}

// queryLibraryArtifactsBySpace (the per-space Library facet) moved to the
// product pack (the pack's queries file) in Epic 3
// 3.6 (memql#1903): the per-space filter is a product surface. The
// artifact concept + its optional partitionId facet field stay here (the
// provenance/version spine); the broader partitionId-facet-field decoupling rides
// with the space concept split (3.3, #1900).

/// Fetch a single Library artifact index row by id, gated to the caller. Owned:
/// ownerUserId==actor.userId is the load-bearing guard, so a caller can never read another user's
/// row even with its id. Used by the detail / viewer to resolve the row + its sourceConceptRef
/// before drilling into backing content.
@mcp
@unbounded("library artifact by id (guarded), gated to the owner -- bounded to a single row")
@actor
query artifact libraryArtifactById {
  args {
    artifactId  string!
  }
  filter  when(args.artifactId) { row.id==args.artifactId } && ownerUserId==actor.userId
  shape   artifactFull
}

/// Internal read backing touchArtifact / the label-write capabilities (integrations/library/):
/// resolve the CURRENT Library artifact index row for a backing source ref, gated to the caller.
/// Owned: ownerUserId==actor.userId is the load-bearing guard. sourceConceptRef is the idempotency
/// key createArtifact derives the row's id from (one index row per source ref), so this is bounded
/// to at most one row without needing to re-derive that id in Go -- the coupling a Go-side
/// re-implementation of createArtifact's hash expression would otherwise create.
@unbounded("library artifact by source ref (guarded), gated to the owner -- bounded to a single row by the idempotency-key uniqueness createArtifact enforces")
@actor
query artifact libraryArtifactBySourceConceptRef {
  args {
    sourceConceptRef  string!
  }
  filter  ownerUserId==actor.userId && sourceConceptRef==args.sourceConceptRef
  shape   artifactFull
}

/// Drill-in read: fetch a generated-output's full content (inline body or attachment ref) by id,
/// gated to the caller. Owned: ownerUserId==actor.userId. Called by the Library viewer when opening
/// a generated_output artifact resolved from its sourceConceptRef.
@unbounded("generated output by id (guarded), gated to the owner -- bounded to a single row")
@actor
query generatedOutput generatedOutputById {
  args {
    outputId  string!
  }
  filter  when(args.outputId) { row.id==args.outputId } && ownerUserId==actor.userId
  shape   generatedOutputFull
}

/// List the generated-output rows a Plan produced. Owned: ownerUserId==actor.userId. The planner
/// reads this as the authoritative 'did the deliverable actually get written?' signal for a
/// produceArtifact plan -- promoteWorkbenchOutput stamps producedByPlanId on the row when a
/// workbench fs_write is promoted. The planner stamps the plan's owner as actor before calling, so
/// the read stays inside the owned-row authz model. (memql#939)
@actor
query generatedOutput generatedOutputsForPlan {
  args {
    planId  string!
  }
  filter  ownerUserId==actor.userId && producedByPlanId==args.planId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   generatedOutputFull
}

/// Drill-in read: fetch a memory's full content by id, gated to the caller. Owned:
/// ownerUserId==actor.userId. Called by the Library Records lens when opening a memory artifact
/// resolved from its sourceConceptRef.
@unbounded("memory by id (guarded), gated to the owner -- bounded to a single row")
@actor
query memory memoryById {
  args {
    memoryId  string!
  }
  filter  when(args.memoryId) { row.id==args.memoryId } && ownerUserId==actor.userId
  shape   memoryFull
}

// THIS READ WAS `@public`, AND memql#4340 TOOK THAT AWAY -- not by choice
// here, but because an owner tier and an OWNERLESS row cannot both be true of
// one concept.
//
// #723 gave workspace liveSources (liveSource.scope=="workspace") an empty
// ownerUserId on purpose: partition-shared rows with no single owner, surfaced
// through this one un-gated path while every sibling read stayed owner-scoped.
// Declaring v1:library:artifact's tier (design D8) ends that shape. The tier's
// predicate is ANDed into EVERY read of the concept before it runs and every
// row is separately admitted on its way out -- neither mechanism consults the
// filter, and `@public` on a QUERY is a conformance classification, not an
// enforcement switch. So a row with an empty ownerUserId is now invisible on
// every path, and writing no conjunct here would not have preserved the shared
// read; it would only have hidden the change from the land gate.
//
// What the conjunct records is therefore the truth: this read now returns the
// caller's OWN workspace-scoped live sources. A genuinely partition-shared
// Library row needs a concept that can express "no owner", which the index no
// longer is; that is a design question for whoever brings liveSource promotion
// into the engine tree, and it is deliberately not answered by a filter.
/// List workspace-scoped live sources for the Library Records lens. Gated by
/// ownerUserId==actor.userId -- NOT the un-gated partition-shared read it was
/// before memql#4340, because v1:library:artifact now declares an owner tier and an ownerless row
/// is unreachable on every path. See the note above (#723 for the original shape, D8 for the tier).
@actor
query artifact libraryWorkspaceLiveSources {
  filter  ownerUserId==actor.userId && kind=="live_source" && scope=="workspace"
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   artifactFull
}

// ---- documentVersion: version-history reads (memql#1230) ----
//
// History is grouped by the logical documentId. MemQL is append-only by
// (id, createdAt); since each version is a DISTINCT row with its own id,
// every version of a document persists and is returned by these reads.
// Owned: ownerUserId==actor.userId so a caller can only ever read their
// own document history. The frontend orders the returned set by
// versionNumber (or createdAt) -- both are monotonic.

/// List the append-only version history of a logical document (every retained version, summary
/// projection -- versionNumber, authorKind, author, note, createdAt -- WITHOUT the full body).
/// Owned: ownerUserId==actor.userId gates the row set; payload.documentId narrows to the one
/// document. Backs the Library history drawer (memql#1230); the frontend orders by versionNumber.
/// Each version is a distinct retained row, so no version is ever lost.
@actor
query documentVersion documentVersions {
  args {
    documentId  string!
  }
  filter  ownerUserId==actor.userId && documentId==args.documentId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   documentVersionSummary
}

/// Fetch a single document version's FULL content (immutable body / attachment + provenance) by its
/// version row id, gated to the caller. Owned: ownerUserId==actor.userId is the load-bearing guard.
/// Backs the 'open this version' viewer and the restore-source read (memql#1230).
@unbounded("document version by id (guarded), gated to the owner -- bounded to a single row")
@actor
query documentVersion documentVersionById {
  args {
    versionId  string!
  }
  filter  when(args.versionId) { row.id==args.versionId } && ownerUserId==actor.userId
  shape   documentVersionFull
}

// documentVersionsForOwner backs the Go edit/restore handlers'
// "read the current latest to compute the next versionNumber + set
// parentVersionId" step (memql#1229 / #1231 / #1230). It returns the
// full history for a document under a threaded owner actor (the handler
// runs under withUserActor, not the user's JWT), and the handler picks
// the max versionNumber in Go (MemQL has no ORDER BY / LIMIT / max()).
// Identical filter to documentVersions; kept as a distinct named
// read so the handler dependency is explicit and the user-facing query
// description stays accurate.
/// Internal read for the edit/restore handlers: the full version history of a document (full
/// projection) so the handler can compute the next versionNumber + the parentVersionId from the
/// current latest. Owned: ownerUserId==actor.userId; the handler runs under a threaded owner actor.
/// Mirrors documentVersions' filter with the full content shape.
@actor
query documentVersion documentVersionsForOwner {
  args {
    documentId  string!
  }
  filter  ownerUserId==actor.userId && documentId==args.documentId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   documentVersionFull
}

// artifactsForPlan -- what a goal produced (memql#4372, Nexus)
// ============================================================
//
// The Nexus map draws one node per artifact a goal produced, below the
// road that runs from you to the goal. `artifact.producedByPlanId` is the
// provenance back-pointer the Library already stamps at index time, so
// this is a narrowing of the owned Library rather than a new fact.
//
// Owned, exactly like every other read in this file: the row set is gated
// by `ownerUserId==actor.userId` server-side and the plan id narrows it
// further. Unlike `agentsForPlan` (whose own header explains why an owner
// conjunct there would be a silent emptiness), the owner pointer on an
// artifact is stamped from the actor on every write and is load-bearing --
// so it is a real gate here, not decoration.
//
// Distinct from `generatedOutputsForPlan`, which reads the BACKING
// v1:library:generatedOutput rows a plan wrote. This reads the Library
// INDEX rows, which is what the portal already renders through the
// artifact concept's own display card and what the map's artifact glyph
// links to (/artifacts/:artifactId).
/// The Library artifacts one goal produced -- index rows whose producedByPlanId names the plan.
/// Owned: ownerUserId==actor.userId gates the row set server-side and the plan id narrows it.
/// Backs the Nexus map's artifact lane (memql#4371) and the completion card's "artifacts produced"
/// count (memql#4376). Reads the Library INDEX rows, not the backing generatedOutput rows that
/// generatedOutputsForPlan returns.
@unbounded("the artifacts produced by one goal -- bounded by the plan; the map draws the whole set at once, and a truncated page silently loses an artifact from the scene and from the completion card's count")
@actor
query artifact artifactsForPlan {
  args {
    planId  string!
  }
  filter  ownerUserId==actor.userId && producedByPlanId==args.planId
  shape   artifactFull
}

// ---- file + fileChunk: the byte-bearing reads (memql#4340) ----
//
// Both concepts declare the composite tier, so the ownerUserId conjunct
// written here is no longer the only thing standing between one person's
// files and another's -- the declaration ANDs the same predicate in from
// the concept and admits every row on its way out, which is what covers
// the paths a filter cannot reach. It is written anyway, for the reason
// every sibling read above writes it: a reader auditing this file should
// be able to see the scope of a read without resolving its concept's
// annotation.
//
// WHAT THE COMPOSITE HALF DOES NOT DO, because the obvious reading is
// wrong: it does NOT make these reads return every user's rows to a
// cluster owner. The tier's injected term is `(owner==actor ||
// isClusterOwner)`, but it is ANDed with the filter written here -- and
// `ownerUserId==actor.userId` narrows the result right back to the
// caller's own rows. A cluster owner calling libraryFilesForOwner() sees
// their own files, which is what the name says.
//
// The bypass is real and is measured (TestClusterOwnerSeesEveryLibraryRow),
// but it lives on the paths with no authored filter to AND against: a raw
// query string, graph expansion, a subscription. That is the operator
// reach the composite tier buys, and an operator surface that wants the
// cross-user LIST still needs a read that does not scope itself.

/// Fetch one Library file by id, gated to the caller: ownerUserId==actor.userId, over a concept
/// declaring the composite tier. Backs the artifact detail view and the download / export route, which needs
/// name, mimeType, size and blobUrl together to stream the bytes with correct headers.
@unbounded("library file by id (guarded), gated to the owner -- bounded to a single row")
@actor
query file libraryFileById {
  args {
    fileId  string!
  }
  filter  when(args.fileId) { row.id==args.fileId } && ownerUserId==actor.userId
  shape   libraryFileFull
}

/// List the caller's Library files, newest first, gated by ownerUserId==actor.userId. The
/// file-level read behind the Artifacts page's upload and training surfaces --
/// the artifact index is what the list renders, and this is what answers questions the index does
/// not carry (analysis status, embedding coverage, which domains a file was trained into).
@actor
query file libraryFilesForOwner {
  filter  ownerUserId==actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   libraryFileFull
}

/// List the chunks of one Library file, for the analysis pass to confirm what it wrote and for a
/// similarity hit to resolve back to its file. Gated by ownerUserId==actor.userId; payload.fileId
/// narrows to the one file. The frontend orders by seq, which is
/// monotonic in file order.
@actor
query fileChunk libraryFileChunksForFile {
  args {
    fileId  string!
  }
  filter  ownerUserId==actor.userId && fileId==args.fileId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   libraryFileChunkFull
}

// ---- fileVersion: the history reads (epic memql#4806) ----

/// The superseded versions of one Library file, newest first -- the Files inspector's history
/// panel (design D1). The HEAD IS NOT HERE: the newest version is the v1:library:file row itself,
/// which the caller already holds, and the panel folds the two together. Owned:
/// ownerUserId==actor.userId gates the row set and payload.fileId narrows it to the one file, so a
/// version of somebody else's file is a version that does not exist.
///
/// PAGED AT 200 RATHER THAN UNBOUNDED, and the panel is told which it got. The head's own
/// versionNumber says how many versions exist, so a caller comparing that number against the rows
/// it received can state the boundary out loud instead of quietly showing a prefix -- which is what
/// an unbounded read would do the day the watched-folder epic (#4783) starts pushing a version per
/// save.
@actor
query fileVersion libraryFileVersionsForFile {
  args {
    fileId  string!
  }
  filter  ownerUserId==actor.userId && fileId==args.fileId
  sort     "versionNumber", "desc"
  paginate 200
  shape   libraryFileVersionFull
}

/// One superseded version of one file, by its number -- what GET /artifacts/{id}/content?version={n}
/// resolves through (design D8). Owned: the caller's own actor decides, so an older version of
/// another person's file comes back as the empty result a missing one does, and the route answers
/// both with the same 404 the rest of that path answers with.
///
/// Keyed on (fileId, versionNumber) rather than on the row id: the id is derived from that pair in
/// Go, and re-deriving it here to read it back would put the convention in a second place that can
/// disagree with the first.
@unbounded("one version of one file, gated to the owner and narrowed by (fileId, versionNumber) -- bounded to a single row by construction")
@actor
query fileVersion libraryFileVersionByNumber {
  args {
    fileId         string!
    versionNumber  int!
  }
  filter  ownerUserId==actor.userId && fileId==args.fileId && versionNumber==args.versionNumber
  shape   libraryFileVersionFull
}

/// The sizes of every superseded version the caller holds -- the history half of the storage quota
/// (epic memql#4806, design D9). Superseding destroys nothing, so those bytes are as real as a head
/// file's and count exactly like them; a quota that ignored them would refuse a person with numbers
/// they cannot see. UNBOUNDED for its siblings' reason: a truncated page fails OPEN, admitting an
/// upload the quota should refuse. Owner-scoped, two fields per row.
@unbounded("quota enforcement must sum EVERY superseded version the owner holds -- a truncated page fails open, admitting an upload the quota should refuse; owner-scoped and two fields per row")
@actor
query fileVersion libraryFileVersionSizesForOwner {
  filter  ownerUserId==actor.userId
  shape   libraryFileVersionSize
}

// ---- folder: the Files app's tree reads (memql#4781) ----

/// The caller's whole folder tree, live (memql#4781, design B1). Owned: ownerUserId==actor.userId
/// gates the row set; `archived != true` is the null-safe soft-delete filter, for the reason
/// libraryArtifacts spells out at length. UNBOUNDED ON PURPOSE: the OS folds (folders, artifacts)
/// snapshots into a tree client-side, and a truncated page would silently re-parent every folder
/// whose ancestor fell off the edge -- the fold is orphan-tolerant, so nothing would LOOK broken,
/// which is exactly why the truncation must not happen. The set is small by construction: folders
/// are hand-made organizational rows, bounded by one person's patience, not by data volume.
@unbounded("the caller's whole folder tree -- the client-side tree fold needs every row at once, and a truncated page silently renders missing ancestors' children at root as orphans; owner-scoped and hand-created, so the set is small by construction. No sort either: the fold orders by (name, id) itself, because a picture that depended on wire order would reshuffle while somebody watches")
@actor
query folder libraryFolders {
  filter  ownerUserId==actor.userId && archived!=true
  shape   libraryFolderFull
}

/// Fetch one folder by id, gated to the caller. Owned: ownerUserId==actor.userId is the
/// load-bearing guard. Backs the desk-folder popover's name refresh and the Files app's
/// breadcrumb resolve; archived rows ARE returned here -- a caller asking about a specific id
/// deserves the honest answer, and the archived field says which kind it got.
@unbounded("library folder by id (guarded), gated to the owner -- bounded to a single row")
@actor
query folder libraryFolderById {
  args {
    folderId  string!
  }
  filter  when(args.folderId) { row.id==args.folderId } && ownerUserId==actor.userId
  shape   libraryFolderFull
}

// ---- uploadSession + quota reads (memql#4782) ----

/// Fetch one chunked upload session by id, gated to the caller -- THE per-chunk authorization read
/// (design C2): every chunk PUT, the inventory and the complete resolve the session through this
/// under the caller's own actor, so a session that is not theirs is a session that is not there.
/// Owned: ownerUserId==actor.userId is the load-bearing guard.
@unbounded("upload session by id (guarded), gated to the owner -- bounded to a single row")
@actor
query uploadSession uploadSessionById {
  args {
    uploadId  string!
  }
  filter  when(args.uploadId) { row.id==args.uploadId } && ownerUserId==actor.userId
  shape   uploadSessionFull
}

/// The declared sizes of the caller's OPEN upload sessions -- the in-flight half of the storage
/// quota (memql#4782, design C4): at init and at one-shot upload, the sum of stored file sizes
/// PLUS these declared sizes must stay under MEMQL_LIBRARY_USER_QUOTA_BYTES, or a person could
/// evade the quota by opening sessions they never finish. UNBOUNDED for the quota's reason: a
/// truncated page fails OPEN, admitting bytes the quota should refuse. Owner-scoped, projecting
/// two fields per row.
@unbounded("quota enforcement must see EVERY open session's declared size -- a truncated page fails open, admitting an upload the quota should refuse; owner-scoped and two fields per row")
@actor
query uploadSession openUploadSessionsForOwner {
  filter  ownerUserId==actor.userId && isOpen
  shape   uploadSessionSize
}

/// The sizes of every file the caller holds, ARCHIVED INCLUDED -- the stored half of the storage
/// quota (memql#4782, design C4). Archived files keep their bytes and keep counting: retention is
/// real, and a quota that forgot archived rows would let 'archive then re-upload' mint unbounded
/// storage. UNBOUNDED for the same fail-open reason as its session sibling; owner-scoped, two
/// fields per row.
@unbounded("quota enforcement must sum EVERY file the owner holds, archived included -- a truncated page fails open, admitting an upload the quota should refuse; owner-scoped and two fields per row")
@actor
query file libraryFileSizesForOwner {
  filter  ownerUserId==actor.userId
  shape   libraryFileSize
}
