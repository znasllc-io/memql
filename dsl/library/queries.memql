// library domain -- Library reads.
//
// Authz tier: owned. Every filter gates on
// payload.ownerUserId==actor.userId so a caller can only ever read
// their own Library; no arg widens the row set beyond their ownership.
//
// memQL query filters are equality / membership predicates with no OR
// and no in-filter substring match, so the surface here mirrors the
// notes / calendar pattern: a small set of server-side-narrowed reads
// (all / by lens / by kind / by space / by id) over the owner-scoped
// row set, with free-text SEARCH layered client-side over the returned
// page (the Library list panel, #298). The lens / kind / space facets
// ARE server-side -- they're the high-cardinality narrowing that
// matters; search is the cheap client-side refinement on top.

use library.concepts.{ artifact, generatedOutput, memory, documentVersion }
use library.shapes.{ artifactFull, generatedOutputFull, memoryFull, documentVersionSummary, documentVersionFull }

@enabled
@description("List the caller's entire Library (artifacts + records). Owned: the row set is gated by ownerUserId==actor.userId server-side. The default Library read; the panel filters by lens / kind and searches client-side over this set, or calls the narrower facet queries below when a single facet dominates.")
query artifact libraryArtifacts {
  filter  ownerUserId==actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   artifactFull
}

@enabled
@description("List the caller's Library rows for one lens (artifact | record) -- backs the Artifacts | Records toggle. Owned: ownerUserId==actor.userId gates the row set; payload.lens narrows to the selected lens.")
query artifact libraryArtifactsByLens {
  args {
    lens  string  @required
  }
  filter  ownerUserId==actor.userId && lens==args.lens
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   artifactFull
}

@enabled
@description("List the caller's Library rows of one kind (document / generated_output / note / todo / calendar_event / memory / live_source) -- backs the kind facet filter. Owned: ownerUserId==actor.userId gates the row set; payload.kind narrows to the selected kind.")
query artifact libraryArtifactsByKind {
  args {
    kind  string  @required
  }
  filter  ownerUserId==actor.userId && kind==args.kind
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   artifactFull
}

// queryLibraryArtifactsBySpace (the per-space Library facet) moved to the
// CoPresent pack (memql-bff-copresent/dsl/copresent/queries.memql) in Epic 3
// 3.6 (memql#1903): the per-space filter is a CoPresent-product surface. The
// artifact concept + its optional partitionId facet field stay here (the
// provenance/version spine); the broader partitionId-facet-field decoupling rides
// with the space concept split (3.3, #1900).

@enabled
@description("Fetch a single Library artifact index row by id, gated to the caller. Owned: ownerUserId==actor.userId is the load-bearing guard, so a caller can never read another user's row even with its id. Used by the detail / viewer to resolve the row + its sourceConceptRef before drilling into backing content.")
@mcp
@unbounded("library artifact by id (guarded), gated to the owner -- bounded to a single row")
query artifact libraryArtifactById {
  args {
    artifactId  string  @required
  }
  filter  when(args.artifactId) { id==args.artifactId } && ownerUserId==actor.userId
  shape   artifactFull
}

@enabled
@description("Drill-in read: fetch a generated-output's full content (inline body or attachment ref) by id, gated to the caller. Owned: ownerUserId==actor.userId. Called by the Library viewer when opening a generated_output artifact resolved from its sourceConceptRef.")
@unbounded("generated output by id (guarded), gated to the owner -- bounded to a single row")
query generatedOutput generatedOutputById {
  args {
    outputId  string  @required
  }
  filter  when(args.outputId) { id==args.outputId } && ownerUserId==actor.userId
  shape   generatedOutputFull
}

@enabled
@description("List the generated-output rows a Plan produced. Owned: ownerUserId==actor.userId. The planner reads this as the authoritative 'did the deliverable actually get written?' signal for a produceArtifact plan -- promoteWorkbenchOutput stamps producedByPlanId on the row when a workbench fs_write is promoted. The planner stamps the plan's owner as actor before calling, so the read stays inside the owned-row authz model. (memql#939)")
query generatedOutput generatedOutputsForPlan {
  args {
    planId  string  @required
  }
  filter  ownerUserId==actor.userId && producedByPlanId==args.planId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   generatedOutputFull
}

@enabled
@description("Drill-in read: fetch a memory's full content by id, gated to the caller. Owned: ownerUserId==actor.userId. Called by the Library Records lens when opening a memory artifact resolved from its sourceConceptRef.")
@unbounded("memory by id (guarded), gated to the owner -- bounded to a single row")
query memory memoryById {
  args {
    memoryId  string  @required
  }
  filter  when(args.memoryId) { id==args.memoryId } && ownerUserId==actor.userId
  shape   memoryFull
}

// `@public` marks this query as intentionally NOT caller-scoped. Workspace
// liveSources (liveSource.scope=="workspace") are partition-shared and carry
// no ownerId, so their promoted index rows have an empty ownerUserId that the
// owned reads above can never match -- they'd be invisible to everyone. This
// path surfaces exactly those rows (kind=live_source AND scope=workspace, NO
// owner gate) so every partition member sees the shared sources, mirroring the
// canvasState public/private split. The audit stays honest: the widening is
// bounded to workspace-scoped live sources (private sources keep ownerUserId
// and only ever surface through the owned queries), and partition isolation is
// enforced upstream of the read. The frontend merges this into the Records lens
// alongside the owned libraryArtifactsByLens("record") results (#723).
@enabled
@public
@description("List the partition's workspace-scoped live sources for the Library Records lens. Non-owned by design: workspace liveSources have no single owner (empty ownerUserId), so this reads kind=live_source AND scope=workspace with no caller gate and the frontend merges it into the owned Records results. Private live sources are excluded here -- they surface through the owner-gated queries. See the @public justification above (#723).")
query artifact libraryWorkspaceLiveSources {
  filter  kind=="live_source" && scope=="workspace"
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   artifactFull
}

// ---- documentVersion: version-history reads (memql#1230) ----
//
// History is grouped by the logical documentId. memQL is append-only by
// (id, createdAt); since each version is a DISTINCT row with its own id,
// every version of a document persists and is returned by these reads.
// Owned: ownerUserId==actor.userId so a caller can only ever read their
// own document history. The frontend orders the returned set by
// versionNumber (or createdAt) -- both are monotonic.

@enabled
@description("List the append-only version history of a logical document (every retained version, summary projection -- versionNumber, authorKind, author, note, createdAt -- WITHOUT the full body). Owned: ownerUserId==actor.userId gates the row set; payload.documentId narrows to the one document. Backs the Library history drawer (memql#1230); the frontend orders by versionNumber. Each version is a distinct retained row, so no version is ever lost.")
query documentVersion documentVersions {
  args {
    documentId  string  @required
  }
  filter  ownerUserId==actor.userId && documentId==args.documentId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   documentVersionSummary
}

@enabled
@description("Fetch a single document version's FULL content (immutable body / attachment + provenance) by its version row id, gated to the caller. Owned: ownerUserId==actor.userId is the load-bearing guard. Backs the 'open this version' viewer and the restore-source read (memql#1230).")
@unbounded("document version by id (guarded), gated to the owner -- bounded to a single row")
query documentVersion documentVersionById {
  args {
    versionId  string  @required
  }
  filter  when(args.versionId) { id==args.versionId } && ownerUserId==actor.userId
  shape   documentVersionFull
}

// documentVersionsForOwner backs the Go edit/restore handlers'
// "read the current latest to compute the next versionNumber + set
// parentVersionId" step (memql#1229 / #1231 / #1230). It returns the
// full history for a document under a threaded owner actor (the handler
// runs under withUserActor, not the user's JWT), and the handler picks
// the max versionNumber in Go (MemQL has no ORDER BY / LIMIT / max()).
// Identical filter to documentVersions; kept as a distinct named
// read so the handler dependency is explicit and the user-facing query
// description stays accurate.
@enabled
@description("Internal read for the edit/restore handlers: the full version history of a document (full projection) so the handler can compute the next versionNumber + the parentVersionId from the current latest. Owned: ownerUserId==actor.userId; the handler runs under a threaded owner actor. Mirrors documentVersions' filter with the full content shape.")
query documentVersion documentVersionsForOwner {
  args {
    documentId  string  @required
  }
  filter  ownerUserId==actor.userId && documentId==args.documentId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   documentVersionFull
}
