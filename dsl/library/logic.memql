// library domain -- promotion logic.
//
// One logic per backing source: read the just-created row off the
// triggering event and fold it into a v1:library:artifact index row.
// Wired to creation events by the automations in automations.memql.
// The document path has a live producer today (the attachment handler
// inserts v1:knowledge:document); the generatedOutput path's producers
// (workbench / computer-use / agent integrations) are the remaining
// integration step on #694.

use library.mutations.{ mutationCreateArtifact }
use knowledge.concepts.{ document, liveSource }
use notes.concepts.{ note }
use todos.concepts.{ todo }
use library.concepts.{ memory, generatedOutput }
use calendar.concepts.{ calendarEvent }

// Record + live-source promotion (#696). Notes / to-dos / calendar
// events / memories land in the Records lens (lens=record); their
// provenance is agent_generated (the assistant manages them on the
// user's behalf). Live sources land as LIVE-flagged records
// (lens=record, kind=live_source, source=live, live=true); the
// Library renders freshness from the latest liveSnapshot
// (queryLatestLiveSnapshotForSource).
//
// NOTE on live sources: liveSource.scope is threaded onto the index
// row. Private sources (ownerId set, scope=private) surface through the
// owned reads. Workspace sources carry no ownerId, so the owned index
// can't fan them out per-user -- they instead surface through the
// non-owned queryLibraryWorkspaceLiveSources path (filter scope=workspace,
// no owner gate), which every partition member can read (#723).

@enabled
@description("On v1:knowledge:document creation, promote the uploaded document into a Library artifact index row (lens=artifact, kind=document, source=uploaded). ownerUserId is threaded from the document's uploadedBy. Idempotent via the deterministic artifact id derived from the document's concept ref.")
logic logicIndexDocument {
  args {
    event  object  @required
  }
  body {
    // coalesce(..., "") on the OPTIONAL string fields, mirroring the #1605
    // fix on the generatedOutput path below. document.summary is optional and
    // resolves to an explicit null when absent, which the v1:library:artifact
    // string fields reject ("expected string, but got null"). mimeType /
    // partitionId / planId are @required on document today but are coalesced
    // defensively so an upstream contract change can't reopen this. format is
    // an @enum field ("" is not a member), so it stays raw -- it is @required
    // on document and never null; validationStatus is coalesced to "none"
    // inside mutationCreateArtifact.
    indexed := mutationCreateArtifact({ sourceConceptRef: canonicalId(args.event.payload.id, document), ownerUserId: args.event.payload.uploadedBy, lens: "artifact", kind: "document", source: "uploaded", title: args.event.payload.fileName, summary: coalesce(args.event.payload.summary, ""), format: args.event.payload.format, mimeType: coalesce(args.event.payload.mimeType, ""), live: false, partitionId: coalesce(args.event.payload.partitionId, ""), producedByPlanId: coalesce(args.event.payload.planId, ""), validationStatus: args.event.payload.validationStatus })
    return indexed
  }
}

@enabled
@description("On v1:library:generatedOutput creation, promote the produced deliverable into a Library artifact index row (lens=artifact, kind=generated_output). source + agent / plan provenance are carried from the generatedOutput row. ownerUserId is the producing user. Idempotent via the deterministic artifact id.")
logic logicIndexGeneratedOutput {
  args {
    event  object  @required
  }
  body {
    // coalesce(..., "") on every OPTIONAL ref. Only source=computer_use
    // outputs carry a worker id; agent/workbench/standalone outputs lack
    // producedByAgentId / producedByPlanId / partitionId / summary /
    // mimeType. An absent arg reference resolves to no value and is
    // dropped to an explicit null, which the v1:library:artifact string
    // fields reject ("expected string, but got null") -- so artifact
    // indexing failed for EVERY non-computer-use generated output. The
    // artifact field descriptions already define the empty string as the
    // absent value, so "" is the correct coalesce target.
    // ownerUserId / title / format / source are @required on
    // generatedOutput, so they always carry a value and pass through bare.
    indexed := mutationCreateArtifact({ sourceConceptRef: canonicalId(args.event.payload.id, generatedOutput), ownerUserId: args.event.payload.ownerUserId, lens: "artifact", kind: "generated_output", source: args.event.payload.source, title: args.event.payload.title, summary: coalesce(args.event.payload.summary, ""), format: args.event.payload.format, mimeType: coalesce(args.event.payload.mimeType, ""), live: false, partitionId: coalesce(args.event.payload.partitionId, ""), agentId: coalesce(args.event.payload.producedByAgentId, ""), producedByPlanId: coalesce(args.event.payload.producedByPlanId, ""), producedByWorkerId: coalesce(args.event.payload.producedByWorkerId, ""), producedByWorkerName: coalesce(args.event.payload.producedByWorkerName, "") })
    return indexed
  }
}

@enabled
@description("On v1:notes:note creation, promote it into the Library Records lens (lens=record, kind=note, source=agent_generated).")
logic logicIndexNote {
  args {
    event  object  @required
  }
  body {
    // coalesce(..., "") on summary -- note.body is @required upstream but is
    // coalesced defensively so a null body can never re-trigger the
    // artifact-null rejection. title already falls back to "Untitled note".
    indexed := mutationCreateArtifact({ sourceConceptRef: canonicalId(args.event.payload.id, note), ownerUserId: args.event.payload.ownerUserId, lens: "record", kind: "note", source: "agent_generated", title: coalesce(args.event.payload.title, "Untitled note"), summary: coalesce(args.event.payload.body, ""), live: false })
    return indexed
  }
}

@enabled
@description("On v1:todos:todo creation, promote it into the Library Records lens (lens=record, kind=todo, source=agent_generated).")
logic logicIndexTodo {
  args {
    event  object  @required
  }
  body {
    // title is @required on both todo and the artifact mutation; coalesce to
    // "Untitled to-do" (mirroring logicIndexNote) so a null title can never
    // fail the @required artifact title.
    indexed := mutationCreateArtifact({ sourceConceptRef: canonicalId(args.event.payload.id, todo), ownerUserId: args.event.payload.ownerUserId, lens: "record", kind: "todo", source: "agent_generated", title: coalesce(args.event.payload.title, "Untitled to-do"), live: false })
    return indexed
  }
}

@enabled
@description("On v1:calendar:calendarEvent creation, promote it into the Library Records lens (lens=record, kind=calendar_event, source=agent_generated).")
logic logicIndexCalendarEvent {
  args {
    event  object  @required
  }
  body {
    // title is @required on both calendarEvent and the artifact mutation;
    // coalesce to "Untitled event" so a null title can never fail the
    // @required artifact title.
    indexed := mutationCreateArtifact({ sourceConceptRef: canonicalId(args.event.payload.id, calendarEvent), ownerUserId: args.event.payload.ownerUserId, lens: "record", kind: "calendar_event", source: "agent_generated", title: coalesce(args.event.payload.title, "Untitled event"), live: false })
    return indexed
  }
}

@enabled
@description("On v1:library:memory creation, promote it into the Library Records lens (lens=record, kind=memory, source=agent_generated).")
logic logicIndexMemory {
  args {
    event  object  @required
  }
  body {
    // coalesce(..., "") on the OPTIONAL fields. memory.summary / agentId /
    // partitionId are all optional and resolve to an explicit null when absent,
    // which the v1:library:artifact string fields reject -- this is the
    // failure observed live on 0.9.67 (#1626). title is @required upstream.
    indexed := mutationCreateArtifact({ sourceConceptRef: canonicalId(args.event.payload.id, memory), ownerUserId: args.event.payload.ownerUserId, lens: "record", kind: "memory", source: "agent_generated", title: args.event.payload.title, summary: coalesce(args.event.payload.summary, ""), agentId: coalesce(args.event.payload.agentId, ""), partitionId: coalesce(args.event.payload.partitionId, ""), live: false })
    return indexed
  }
}

@enabled
@description("On v1:knowledge:liveSource creation, promote it into the Library Records lens as a LIVE-flagged record (lens=record, kind=live_source, source=live, live=true). ownerUserId is the source's ownerId (empty for workspace-scoped sources); scope is threaded from liveSource.scope so workspace sources surface through the non-owned queryLibraryWorkspaceLiveSources path while private sources stay owner-gated (#723).")
logic logicIndexLiveSource {
  args {
    event  object  @required
  }
  body {
    // coalesce(..., "") on ownerUserId + summary. liveSource.ownerId is
    // OPTIONAL -- workspace-scoped sources carry no owner, so it resolves to
    // null; the artifact's @required ownerUserId is satisfied by "" (the
    // empty-owner value the workspace-source path expects), but rejects null.
    // description is @required upstream but coalesced defensively. scope
    // carries a @default("workspace") so it is always present; it is an @enum
    // ("" is not a member) and stays raw.
    indexed := mutationCreateArtifact({ sourceConceptRef: canonicalId(args.event.payload.id, liveSource), ownerUserId: coalesce(args.event.payload.ownerId, ""), lens: "record", kind: "live_source", source: "live", title: args.event.payload.name, summary: coalesce(args.event.payload.description, ""), live: true, scope: args.event.payload.scope })
    return indexed
  }
}
