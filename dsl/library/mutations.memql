// library domain -- Library index + generated-output writes.
//
// The Library index is populated by SERVER-SIDE promotion, not by a
// user "save" action: when a backing row is created (a document, a
// generated output, later a note / todo / calendar event / live
// source), an automation folds it into a v1:library:artifact index
// row via mutationCreateArtifact. Because promotion runs on the
// owner's behalf (not as the owner), ownerUserId is threaded from the
// backing row's owner rather than stamped from actor.userId -- the
// same shape v1:knowledge:document uses with its uploadedBy field.
// Reads stay owner-gated (ownerUserId==actor.userId, see #695).
//
// The artifact id is derived deterministically from sourceConceptRef
// (concat("artifact-", hash(ref))) so re-promoting the same source
// re-versions the same logical row instead of creating duplicates --
// the idempotency guarantee #694 calls for.

use library.concepts.{ artifact, generatedOutput, memory, documentVersion }

@enabled
@description("Insert (or re-version) a Library artifact index row for a backing source concept. System / automation-invoked: ownerUserId is threaded from the backing row's owner because promotion runs server-side on the owner's behalf. Idempotent -- the id is derived from sourceConceptRef so re-promoting the same source versions the same row. Not a user-facing tool; the Library is populated automatically.")
mutation artifact mutationCreateArtifact {
  args {
    sourceConceptRef  string  @required
    ownerUserId       string  @required
    lens              string  @required @enum("artifact", "record")
    kind              string  @required @enum("document", "generated_output", "note", "todo", "calendar_event", "memory", "live_source")
    source            string  @required @enum("uploaded", "workbench_generated", "computer_use", "agent_generated", "derived", "live")
    title             string  @required
    summary           string
    format            string  @enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "conversation", "other")
    mimeType          string
    live              bool
    scope             string  @enum("workspace", "private")
    spaceId           string
    agentId           string
    producedByPlanId  string
    producedByWorkerId   string
    producedByWorkerName string
    validationStatus  string  @enum("none", "unvalidated", "validated", "rejected", "partiallyValidated", "superseded")
  }
  insert {
    id: concat("artifact-", hash(args.sourceConceptRef))
    args.sourceConceptRef
    args.ownerUserId
    args.lens
    args.kind
    args.source
    args.title
    args.summary
    args.format
    args.mimeType
    live: coalesce(args.live, false)
    args.scope
    args.spaceId
    args.agentId
    args.producedByPlanId
    args.producedByWorkerId
    args.producedByWorkerName
    validationStatus: coalesce(args.validationStatus, "none")
    // timestamp(), NOT bare `now`: this mutation is invoked from the index
    // automations (logicIndexGeneratedOutput et al.), and the automation step
    // resolver only evaluates the function-call forms timestamp()/now() -- a
    // bare `now` passes through as the literal string "now" and fails the
    // artifact's updatedAt date-time format. (memql#980)
    updatedAt: timestamp()
  }
}

@enabled
@description("Create a generated-output row -- a deliverable PRODUCED through the app (workbench result, computer-use output, or standalone agent output). System / agent-invoked: ownerUserId is the producing user. logicIndexGeneratedOutput folds the new row into the Library index automatically. body carries inline text outputs; attachmentId references file bytes for file-backed outputs.")
mutation generatedOutput mutationCreateGeneratedOutput {
  args {
    outputId          string  @required
    ownerUserId       string  @required
    title             string  @required
    summary           string
    body              string
    attachmentId      string
    format            string  @enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "other")
    mimeType          string
    source            string  @required @enum("workbench_generated", "computer_use", "agent_generated", "derived")
    spaceId           string
    producedByPlanId  string
    producedByAgentId string
    producedByWorkerId   string
    producedByWorkerName string
  }
  insert {
    id: args.outputId
    args.ownerUserId
    args.title
    args.summary
    args.body
    args.attachmentId
    format: coalesce(args.format, "markdown")
    args.mimeType
    args.source
    args.spaceId
    args.producedByPlanId
    args.producedByAgentId
    args.producedByWorkerId
    args.producedByWorkerName
  }
}

@enabled
@description("Create a memory the assistant retains about the user. Owned: ownerUserId is stamped from actor.userId, so a memory can only ever be created for the acting user (or their delegated agent's bound user). logicIndexMemory folds it into the Library Records lens automatically.")
mutation memory mutationCreateMemory {
  args {
    memoryId           string  @required
    title              string  @required
    content            string  @required
    summary            string
    kind               string  @enum("fact", "preference", "instruction", "episodic", "other")
    agentId            string
    spaceId            string
    sourceUtteranceId  string
  }
  insert {
    id: args.memoryId
    ownerUserId: actor.userId
    args.title
    args.content
    args.summary
    kind: coalesce(args.kind, "fact")
    args.agentId
    args.spaceId
    args.sourceUtteranceId
  }
}

// ---- documentVersion: append-only version history (memql#1228) ----
//
// mutationAppendDocumentVersion is the single low-level write for the
// version history. It is NOT a user-facing tool: the user/assistant
// edit + restore flows go through the Go edit handler
// (integration.library.editDocument / restoreDocumentVersion), which
// reads the current latest version, computes the next versionNumber +
// a fresh version id (MemQL has no arithmetic / id-mint), and calls
// THIS mutation to append the immutable snapshot. System / handler-
// invoked: ownerUserId is threaded from the backing document's owner
// because the append runs server-side on the owner's behalf (mirrors
// mutationCreateArtifact). Each call inserts a brand-new immutable row
// (its own versionId) -- the history is append-only, nothing is ever
// overwritten.

@enabled
@description("Append an immutable document-version snapshot to a logical document's history. Handler-invoked (integration.library.editDocument / restoreDocumentVersion) -- ownerUserId is threaded from the backing document's owner, versionNumber + versionId are computed server-side from the current latest. Append-only: every call inserts a new immutable row; nothing is overwritten.")
mutation documentVersion mutationAppendDocumentVersion {
  args {
    versionId        string  @required
    documentId       string  @required
    ownerUserId      string  @required
    versionNumber    int     @required
    content          string
    attachmentId     string
    authorKind       string  @required @enum("user", "assistant", "system")
    authorId         string
    note             string
    parentVersionId  string
    producedByPlanId string
    spaceId          string
  }
  insert {
    id: args.versionId
    args.documentId
    args.ownerUserId
    args.versionNumber
    args.content
    args.attachmentId
    args.authorKind
    args.authorId
    args.note
    args.parentVersionId
    args.producedByPlanId
    args.spaceId
    // timestamp(), NOT bare `now`: this mutation is invoked from the Go
    // edit/restore handlers; the hypertable time dimension + history
    // ordering key must be a real RFC3339 timestamp (same gotcha as
    // mutationCreateArtifact.updatedAt, memql#980).
    createdAt: timestamp()
  }
}

// mutationUpdateGeneratedOutputContent re-inserts a generatedOutput row
// (SAME id) with the new latest content so the artifact index + Library
// viewer -- which resolve content through the backing generatedOutput --
// reflect the edit. memQL is append-only by (id, createdAt), so this
// inserts a new node VERSION of the same logical generatedOutput; reads
// return the latest. Handler-invoked alongside mutationAppendDocument-
// Version; ownerUserId is threaded from the existing row's owner.
@enabled
@description("Re-insert a generatedOutput row (same id, new version) carrying the latest edited content so the Library viewer + artifact index reflect the most recent document version. Append-only by (id, createdAt): a new node version, reads return the latest. Handler-invoked by integration.library.editDocument / restoreDocumentVersion; ownerUserId is threaded from the existing row.")
mutation generatedOutput mutationUpdateGeneratedOutputContent {
  args {
    outputId      string  @required
    ownerUserId   string  @required
    title         string  @required
    summary       string
    body          string
    attachmentId  string
    format        string  @enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "other")
    mimeType      string
    source        string  @required @enum("workbench_generated", "computer_use", "agent_generated", "derived")
    spaceId       string
    producedByPlanId  string
    producedByAgentId string
  }
  insert {
    id: args.outputId
    args.ownerUserId
    args.title
    args.summary
    args.body
    args.attachmentId
    format: coalesce(args.format, "markdown")
    args.mimeType
    args.source
    args.spaceId
    args.producedByPlanId
    args.producedByAgentId
  }
}
