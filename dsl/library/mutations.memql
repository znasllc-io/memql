// library domain -- Library index + generated-output writes.
//
// The Library index is populated by SERVER-SIDE promotion, not by a
// user "save" action: when a backing row is created (a document, a
// generated output, later a note / todo / calendar event / live
// source), an automation folds it into a v1:library:artifact index
// row via createArtifact. Because promotion runs on the
// owner's behalf (not as the owner), ownerUserId is threaded from the
// backing row's owner rather than stamped from actor.userId -- the
// same shape v1:knowledge:document uses with its uploadedBy field.
// Reads stay owner-gated (ownerUserId==actor.userId, see #695).
//
// The artifact id is derived deterministically from sourceConceptRef
// (concat("artifact-", hash(ref))) so re-promoting the same source
// re-versions the same logical row instead of creating duplicates --
// the idempotency guarantee #694 calls for.

/// Insert (or re-version) a Library artifact index row for a backing source concept. System /
/// automation-invoked: ownerUserId is threaded from the backing row's owner because promotion runs
/// server-side on the owner's behalf. Idempotent -- the id is derived from sourceConceptRef so
/// re-promoting the same source versions the same row. Not a user-facing tool; the Library is
/// populated automatically.
mutate artifact createArtifact {
  args {
    sourceConceptRef  string!
    ownerUserId       string!
    lens              enum("artifact", "record")!
    kind              enum("document", "generated_output", "note", "todo", "calendar_event", "memory", "live_source", "file")!
    source            enum("uploaded", "exported", "workbench_generated", "computer_use", "agent_generated", "derived", "user_created", "live")!
    title             string!
    summary           string
    format            enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "conversation", "other")
    mimeType          string
    live              bool
    scope             enum("workspace", "private")
    labels            []string
    archived          bool
    folderId          string
    partitionId           string
    agentId           string
    producedByPlanId  string
    producedByWorkerId   string
    producedByWorkerName string
    validationStatus  enum("none", "unvalidated", "validated", "rejected", "partiallyValidated", "superseded")
  }
  insert {
    id: concat("artifact-", hash(args.sourceConceptRef))
    args.sourceConceptRef
    args.ownerUserId
    args.lens
    args.kind
    args.source
    args.title
    args.summary
    args.format
    args.mimeType
    live: args.live ?? false
    args.scope
    args.labels
    args.folderId
    // Written explicitly rather than left to the concept's @default, which
    // never fires on insert. NOT because the default list needs it: a row with
    // no `archived` member is still returned by `archived != true` (measured,
    // TestArchivedFilterKeepsRowsWrittenBeforeTheFieldExisted). It is written
    // so every row states its own answer -- which is what keeps the next
    // author from "simplifying" the filter to `archived == false`, the one
    // spelling a missing key WOULD silently exclude.
    archived: args.archived ?? false
    args.partitionId
    args.agentId
    args.producedByPlanId
    args.producedByWorkerId
    args.producedByWorkerName
    validationStatus: args.validationStatus ?? "none"
    // now, NOT bare `now`: this mutation is invoked from the index
    // automations (indexGeneratedOutput et al.), and the automation step
    // resolver only evaluates the function-call forms now/now -- a
    // bare `now` passes through as the literal string "now" and fails the
    // artifact's updatedAt date-time format. (memql#980)
    updatedAt: now
  }
}

/// Create a generated-output row -- a deliverable PRODUCED through the app (workbench result,
/// computer-use output, or standalone agent output). Owned: ownerUserId is stamped from
/// actor.userId, so the row can only ever be created for the acting user. Every Go call site runs
/// the mutation under the producing user's actor (withUserActor), so the stamped value is the
/// producing user. indexGeneratedOutput folds the new row into the Library index automatically.
/// body carries inline text outputs; attachmentId references file bytes for file-backed outputs.
@actor
mutate generatedOutput createGeneratedOutput {
  args {
    outputId          string!
    title             string!
    summary           string
    body              string
    attachmentId      string
    format            enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "other")
    mimeType          string
    source            enum("workbench_generated", "computer_use", "agent_generated", "derived", "user_created")!
    partitionId           string
    producedByPlanId  string
    producedByAgentId string
    producedByWorkerId   string
    producedByWorkerName string
  }
  insert {
    accept { title, summary, body, attachmentId, mimeType, source, partitionId, producedByPlanId, producedByAgentId, producedByWorkerId, producedByWorkerName }
    stamp {
      id: args.outputId
      ownerUserId: actor.userId
      format: args.format ?? "markdown"
    }
  }
}

/// Create a memory the assistant retains about the user. Owned: ownerUserId is stamped from
/// actor.userId, so a memory can only ever be created for the acting user (or their delegated
/// agent's bound user). indexMemory folds it into the Library Records lens automatically.
@actor
mutate memory createMemory {
  args {
    memoryId           string!
    title              string!
    content            string!
    summary            string
    kind               enum("fact", "preference", "instruction", "episodic", "other")
    agentId            string
    partitionId            string
  }
  insert {
    accept { title, content, summary, agentId, partitionId }
    stamp {
      id: args.memoryId
      ownerUserId: actor.userId
      kind: args.kind ?? "fact"
    }
  }
}

// ---- documentVersion: append-only version history (memql#1228) ----
//
// appendDocumentVersion is the single low-level write for the
// version history. It is NOT a user-facing tool: the user/assistant
// edit + restore flows go through the Go edit handler
// (integration.library.editDocument / restoreDocumentVersion), which
// reads the current latest version, computes the next versionNumber +
// a fresh version id (MemQL has no arithmetic / id-mint), and calls
// THIS mutation to append the immutable snapshot. Owned: ownerUserId is
// stamped from actor.userId. Both handlers resolve the backing
// document's owner and run the append under that owner's actor
// (`ownerCtx := withUserActor(ctx, ownerUserId)`), so the stamped value
// is the document owner -- the same value the old caller-supplied arg
// carried, minus the ability to forge it (memql#2989). Each call inserts
// a brand-new immutable row (its own versionId) -- the history is
// append-only, nothing is ever overwritten.

/// Append an immutable document-version snapshot to a logical document's history. Handler-invoked
/// (integration.library.editDocument / restoreDocumentVersion) -- ownerUserId is stamped from
/// actor.userId (the handlers run the append under the backing document's owner),
/// versionNumber + versionId are computed server-side from the current
/// latest. Append-only: every call inserts a new immutable row; nothing is overwritten.
@actor
mutate documentVersion appendDocumentVersion {
  args {
    versionId        string!
    documentId       string!
    versionNumber    int!
    content          string
    attachmentId     string
    authorKind       enum("user", "assistant", "system")!
    authorId         string
    note             string
    parentVersionId  string
    producedByPlanId string
    partitionId          string
  }
  insert {
    id: args.versionId
    args.documentId
    ownerUserId: actor.userId
    args.versionNumber
    args.content
    args.attachmentId
    args.authorKind
    args.authorId
    args.note
    args.parentVersionId
    args.producedByPlanId
    args.partitionId
    // now, NOT bare `now`: this mutation is invoked from the Go
    // edit/restore handlers; the hypertable time dimension + history
    // ordering key must be a real RFC3339 timestamp (same gotcha as
    // createArtifact.updatedAt, memql#980).
    createdAt: now
  }
}

/// Re-insert a generatedOutput row (same id, new version) carrying the latest edited content so the
/// Library viewer + artifact index reflect the most recent document version. Append-only by (id,
/// createdAt): a new node version, reads return the latest. Handler-invoked by
/// integration.library.editDocument / restoreDocumentVersion; ownerUserId is stamped from
/// actor.userId, and both handlers run the write under the existing row's owner.
@actor
mutate generatedOutput updateGeneratedOutputContent {
  args {
    outputId      string!
    title         string!
    summary       string
    body          string
    attachmentId  string
    format        enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "other")
    mimeType      string
    source        enum("workbench_generated", "computer_use", "agent_generated", "derived", "user_created")!
    partitionId       string
    producedByPlanId  string
    producedByAgentId string
  }
  insert {
    accept { title, summary, body, attachmentId, mimeType, source, partitionId, producedByPlanId, producedByAgentId }
    stamp {
      id: args.outputId
      ownerUserId: actor.userId
      format: args.format ?? "markdown"
    }
  }
}

// ---- file + fileChunk: the Library's own byte-bearing writes (memql#4340) ----
//
// Unlike createArtifact above, these are OWNER-ACTED rather than
// owner-threaded: every one of them runs as the person whose file it is.
// The upload route runs under the caller's own bearer; the detached
// analysis pass re-enters under that same user via
// auth.ContextWithUserActor, exactly as the campaigns drain worker does
// for the campaign owner. So ownerUserId is stamped from actor.userId and
// is not an argument any caller can name -- which is what the concept's
// @serverSet turns from a convention into a load-time rejection.
//
// The three update-shaped writes take MINIMAL arguments. update{} has
// been a read-merge since memql#1628, so re-supplying the discriminators
// is dead weight, and an absent optional argument is simply not written
// rather than nulled -- which is what lets setLibraryFileStatus advance
// the lifecycle without clobbering a summary an earlier call wrote.

/// Create a Library file row for bytes already written to blob storage. Owner-acted: ownerUserId is
/// stamped from actor.userId, so a file can only ever be created for the person the call runs as.
/// format is the caller's MIME-derived classification, defaulting to 'other' (the metadata-only
/// card) for a type nothing recognises. status starts at 'stored' -- the bytes are durable and
/// nothing has looked at them yet; the analysis pass moves it on through setLibraryFileStatus.
/// That status is STAMPED rather than accepted is load-bearing beyond this mutation:
/// indexFileOnCreate filters on status=="stored" so it promotes exactly once, because
/// graph.node.created fires on every write and a second promotion would wipe the artifact's
/// labels -- a caller-supplied status would let a later write re-enter that state.
/// indexFileOnCreate folds the new row into the Library index automatically.
@actor
mutate file createLibraryFile {
  args {
    fileId    string!
    name      string!
    mimeType  string!
    size      int!
    // Optional since memql#4782: a chunked upload's complete step never held
    // the whole file, so it creates the row with sha256 ABSENT and the
    // analysis pass stamps it by streaming the committed blob once. One-shot
    // callers keep passing the inline hash.
    sha256    string
    blobUrl   string!
    source    enum("uploaded", "exported", "agent_generated", "derived")!
    format    enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "conversation", "other")
    summary   string
    folderId  string
    uploadedFromWorkerId    string
    uploadedFromWorkerName  string
    uploadedFromPath        string
  }
  insert {
    accept { name, mimeType, size, sha256, blobUrl, source, summary, folderId, uploadedFromWorkerId, uploadedFromWorkerName, uploadedFromPath }
    stamp {
      id: args.fileId
      ownerUserId: actor.userId
      format: args.format ?? "other"
      status: "stored"
      embeddingStatus: "none"
      archived: false
      // Every file starts at version 1 and knows when its bytes arrived
      // (epic memql#4806). STAMPED, not accepted: a caller-chosen version
      // number would let an upload claim to be version 40 of a file with no
      // history, and versionUploadedAt is the field the history reads as
      // "uploaded", which must be the moment the engine saw the bytes rather
      // than a moment a client chose. now() rather than a bare `now` for the
      // memql#980 reason the artifact index records.
      versionNumber: 1
      versionUploadedAt: now
    }
  }
}

/// Advance a Library file through the analysis lifecycle: the new status, and whatever the pass
/// learned along with it (a summary, how much of the file is embedded, or why it failed). Every
/// field but the status is optional and an absent one is NOT written, so a later transition cannot
/// blank a summary an earlier one recorded. Handler-invoked by the analysis pass, which runs under
/// the file owner's actor; the read-merge preserves ownerUserId and every byte fact.
mutate file setLibraryFileStatus {
  args {
    fileId           string!
    status           enum("stored", "analyzing", "ready", "failed")!
    summary          string
    embeddingStatus  enum("none", "partial", "complete")
    failureReason    string
    // The analysis pass stamps a chunked upload's hash here (memql#4782,
    // design D10): the pass streams the committed blob once and writes what
    // it measured. Absent on every other transition, and the read-merge
    // keeps whatever an earlier write recorded.
    sha256           string
  }
  update {
    accept { status, summary, embeddingStatus, failureReason, sha256 }
    stamp {
      id: args.fileId
    }
  }
}

/// Record that a Library file has been trained into a knowledge domain (design D7 -- upload and
/// train are two acts, and this is where the second one is written down). Takes the FULL merged
/// list rather than a single id: MemQL has no array append, and a caller sending only the new
/// member would clobber whatever another agent added concurrently -- the same reason the artifact
/// label capabilities merge in Go and write back. libraryTrainFile reads the current list, adds the
/// domain if it is not already there, and calls this; adding a domain twice writes nothing new.
mutate file appendLibraryFileTrainedDomain {
  args {
    fileId                string!
    trainedIntoDomainIds  []string!
  }
  update {
    id: args.fileId
    args.trainedIntoDomainIds
  }
}

/// Archive a Library file -- the soft delete. Sets archived so the file drops out of the owner's
/// default list; the row, its provenance and its bytes all survive, and the append-only history
/// keeps every earlier version. Called directly by the owner, and by archiveFileOnArtifactArchive
/// when the owner archives the artifact the file backs, so the two rows never disagree.
mutate file archiveLibraryFile {
  args {
    fileId  string!
  }
  update {
    id: args.fileId
    archived: true
  }
}

/// Archive a Library artifact index row -- the first write that takes something OUT of the Library,
/// and a soft one. Sets archived so the row drops out of libraryArtifacts (the default list) while
/// keeping its labels, its provenance and its sourceConceptRef intact; nothing is destroyed and the
/// backing row is untouched by this write. When the artifact is a file (kind=file), the backing
/// v1:library:file is archived alongside it by archiveFileOnArtifactArchive rather than here --
/// a mutation body writes one row, and which second row to touch is a decision that depends on the
/// kind.
mutate artifact archiveArtifact {
  args {
    artifactId  string!
  }
  update {
    id: args.artifactId
    archived: true
    updatedAt: now
  }
}

/// Bring a Library artifact index row back out of the Bin (memql#4784) -- the exact inverse of
/// archiveArtifact, and the write that makes archiving a door rather than a one-way door. Nothing
/// was destroyed by the archive, so nothing has to be reconstructed here: the row keeps its labels,
/// its folder, its provenance and its sourceConceptRef throughout, and this write only flips the
/// flag back. updatedAt advances because a restore IS a change a person made.
///
/// THE BACKING FILE IS NOT RESTORED BY AN AUTOMATION, and that asymmetry with the archive path is
/// deliberate. archiveFileOnArtifactArchive rides `node.updated` on v1:library:artifact filtered on
/// `archived == true`; a mirror of it filtered on `archived == false` would fire on essentially
/// EVERY artifact update, since almost no artifact is archived -- and, with the archive automation
/// already in place, the two together close the cycle that automation's own header warns about
/// (each write publishes an event the other subscribes to, and both being idempotent does not stop
/// the events). So restore is a CLIENT-DRIVEN PAIR, exactly as the recursive archive walk is: the
/// Bin calls this and restoreLibraryFile together, and a re-run of an interrupted restore simply
/// finds the half that already landed absent from its next plan.
mutate artifact restoreArtifact {
  args {
    artifactId  string!
  }
  update {
    id: args.artifactId
    archived: false
    updatedAt: now
  }
}

/// Bring a Library file back out of the Bin (memql#4784) -- the inverse of archiveLibraryFile, and
/// the second half of the client-driven restore pair restoreArtifact's header describes. The bytes
/// never went anywhere: an archive is an append-only re-version carrying archived=true, so this
/// write is a re-version carrying false and the blobUrl, the provenance and every earlier version
/// are exactly where they were.
mutate file restoreLibraryFile {
  args {
    fileId  string!
  }
  update {
    id: args.fileId
    archived: false
  }
}

/// Bring a folder back out of the Bin (memql#4784) -- the inverse of archiveLibraryFolder. The
/// CLIENT drives the recursive walk here too, and in the opposite ORDER from the archive: parents
/// OUTWARD-first, so a restored item never appears under a parent that is still archived. A folder
/// restored on its own comes back empty and that is the honest result -- its contents are their own
/// rows and each one is its own decision, which is what lets somebody take one file back out of the
/// Bin without undoing everything they filed there.
///
/// It clears `archived` ONLY, and the absent second line is deliberate. deleteLibraryFolder's
/// disposition is unreachable from every surface -- the Bin's own read carries isNotDeleted -- so
/// nothing can name a deleted folder to restore it, and a write that cleared the field anyway
/// would resurrect exactly the empty-folder noise that write exists to avoid.
mutate folder restoreLibraryFolder {
  args {
    folderId  string!
  }
  update {
    id: args.folderId
    archived: false
  }
}

/// Record how a file's copy stands against the machine it was pushed from (epic memql#4783). Called
/// by the cockpit's verify lane, which is the only party that can see the origin at all -- the
/// engine knows what it received and when, and nothing more.
///
/// IT ONLY EVER FLAGS. There is no state here that removes, hides or supersedes the MemQL copy, and
/// that is the epic's load-bearing invariant rather than an omission: a backup whose copy follows
/// the original into the bin is not a backup. origin_gone is a LABEL on a file that is still whole
/// and still downloadable.
///
/// Deliberately NOT a data-origins mirror (memql#4378). A mirror reconciles deletions and a
/// connector owns its concept; this retains and flags, and Library files stay native.
mutate file setLibraryFileLinkState {
  args {
    fileId     string!
    linkState  enum("synced", "stale", "origin_gone")!
  }
  update {
    id: args.fileId
    linkState: args.linkState
    linkCheckedAt: now
  }
}

/// Write one chunk of a Library file's extracted text, ready for embedding. Owner-acted: ownerUserId
/// is stamped from actor.userId, and the analysis pass runs under the file owner, so a chunk always
/// lands owned by the same person as its file. artifactId is resolved by the pass through
/// libraryArtifactBySourceConceptRef so a similarity hit folds up to the Library row with no second
/// read.
@actor
mutate fileChunk createLibraryFileChunk {
  args {
    chunkId     string!
    fileId      string!
    artifactId  string!
    seq         int!
    text        string!
    tokenCount  int
  }
  insert {
    accept { fileId, artifactId, seq, text, tokenCount }
    stamp {
      id: args.chunkId
      ownerUserId: actor.userId
    }
  }
}

// ---- folder: the Files app's Drive-model writes (memql#4781) ----
//
// All six are CLIENT-REACHABLE, unlike the promotion writes above: the OS
// Files app calls them through the generated SDK, and every one is owned by
// construction -- createLibraryFolder stamps ownerUserId from actor.userId
// (@serverSet makes a caller-supplied owner a load-time rejection), and the
// update-shaped writes are read-merges on a row the composite tier's
// write guard already scopes to its owner.
//
// The update-shaped ones take MINIMAL arguments (the memql#4258 rule):
// update{} has been a read-merge since memql#1628, so re-supplying
// discriminators is dead weight an undeclared-argument DISCARD would hide.
// moveLibraryFolder and moveArtifactToFolder write their target through
// `args.X ?? ""` so an ABSENT argument and an explicit "" both mean "the
// root" -- ?? is blank-coalescing, and for a move-target that collapse is
// the wanted semantics, not a hazard: there is no folder whose id is "".

/// Create a folder in the caller's Library tree (memql#4781, design B1). Owner-acted: ownerUserId
/// is stamped from actor.userId, so a folder can only ever be created for the person the call runs
/// as. parentFolderId nests it under an existing folder; absent means root. Sibling name duplicates
/// are allowed by design (a folder is a collection, not a namespace), so there is no uniqueness
/// check to refuse a name. The client enforces the depth cap (12) and cycle refusal (design D11);
/// the tree fold tolerates violations defensively either way. archived is stamped false explicitly
/// so every row states its own answer -- the same reasoning createArtifact records.
@actor
mutate folder createLibraryFolder {
  args {
    folderId        string!
    name            string!
    parentFolderId  string
  }
  insert {
    accept { name, parentFolderId }
    stamp {
      id: args.folderId
      ownerUserId: actor.userId
      archived: false
    }
  }
}

/// Rename a folder. One field on one row: names are display labels, not namespaces (design D3), so
/// nothing else is touched, no uniqueness is checked, and every artifact filed under the folder is
/// oblivious -- they point at the id, and the id does not change.
mutate folder renameLibraryFolder {
  args {
    folderId  string!
    name      string!
  }
  update {
    id: args.folderId
    args.name
  }
}

/// Move a folder to a new parent -- one row update, the Drive model's whole cost for a move
/// (design D3). An absent parentFolderId (or an explicit "") moves it to the root: ?? is
/// blank-coalescing, and for a move-target that collapse is exactly the wanted semantics, because
/// no folder's id is "". Cycle prevention is the CLIENT's check in v1 (design D11) -- the engine
/// has no ancestor walk to refuse one with -- and the tree fold renders a folder whose ancestor
/// chain revisits itself at root with a marker, so a race between two movers degrades the picture
/// rather than losing anybody's rows.
mutate folder moveLibraryFolder {
  args {
    folderId        string!
    parentFolderId  string
  }
  update {
    id: args.folderId
    parentFolderId: args.parentFolderId ?? ""
  }
}

/// Archive a folder -- the soft delete, same shape as archiveArtifact. The row survives with its
/// name and its place in the tree; libraryFolders' `archived != true` filter drops it from the
/// default read. The CLIENT drives the recursive walk (design B5/D11): contents first via
/// archiveArtifact (whose automation archives backing files), then folders children-first, so this
/// write is always the LAST touch on an emptied branch -- and re-running an interrupted walk
/// archives the remainder idempotently. Artifacts still pointing here render at root with an
/// orphan marker rather than vanishing: the fold is tolerant, and a row is never lost to a
/// dangling pointer.
mutate folder archiveLibraryFolder {
  args {
    folderId  string!
  }
  update {
    id: args.folderId
    archived: true
  }
}

/// Delete a folder whose subtree held no file at all -- the disposition the archive walk takes for
/// an empty branch, instead of archiveLibraryFolder. Same soft delete in the storage sense (the row
/// survives, the engine is append-only), and the opposite of it in the product sense: every folder
/// read carries isNotDeleted, so this row leaves the tree, the Bin and a by-id resolve at once.
///
/// The distinction it draws is the point. Archiving is how somebody gets a thing back later, and a
/// folder holding no file anywhere beneath it has nothing to get back -- archiving one puts a line
/// in the Bin that answers no question anybody asked, next to the files that DO deserve to be
/// there. An already-archived file beneath the folder still counts as a file, because Restore can
/// still reach it, so a folder above one archives like any other.
///
/// NOT @serverOnly, exactly as archiveLibraryFolder is not: the OS Files app drives the walk, the
/// composite tier's write guard already scopes the row to its owner, and no field here is a
/// credential.
///
/// There is deliberately NO inverse. restoreLibraryFolder clears `archived` and never touches
/// `deleted`, because a row every read excludes is a row nothing can ask to have back -- and
/// resurrecting an empty folder would restore the noise this write exists to avoid.
mutate folder deleteLibraryFolder {
  args {
    folderId  string!
  }
  update {
    id: args.folderId
    deleted: true
  }
}

/// Re-file a Library artifact into a folder (memql#4781, design B2) -- the organizational write of
/// the Files app, and deliberately a READ-MERGE update: labels, archived, provenance and every
/// other index field survive a move untouched, which is what makes moving cheap enough to be the
/// only filing operation the tree needs. An absent folderId (or an explicit "") files it at the
/// root -- ?? is blank-coalescing, and no folder's id is "". updatedAt advances because a move IS
/// a change a person made to the row, and the Library's default sort should say so. Works on every
/// content kind (file, document, generated_output); the backing row's own folderId copy is the
/// initial filing only and is deliberately not chased (the index is authoritative after
/// promotion).
mutate artifact moveArtifactToFolder {
  args {
    artifactId  string!
    folderId    string
  }
  update {
    id: args.artifactId
    folderId: args.folderId ?? ""
    updatedAt: now
  }
}

/// Label a Library item with the clients it is about (epic memql#4800, D5) -- the Files inspector's
/// account picker, and its only caller.
///
/// A READ-MERGE update in the shape moveArtifactToFolder set: folder, labels, archived and every
/// other index field survive a re-label untouched, which is what makes labelling cheap enough to be
/// a chip somebody toggles rather than a form they submit.
///
/// `accountIds` is STAMPED with `?? []`, not accepted, for moveArtifactToFolder's reason applied to
/// a list: an accepted arg omitted is dropped and inherited, so REMOVING the last label would
/// silently re-save the label just removed. An explicit empty list is what "no client" looks like,
/// and the coalesce is what lets an omitted arg mean it.
///
/// `updatedAt` advances because a re-label IS a change a person made to the row, and the Library's
/// default sort should say so -- the same call moveArtifactToFolder makes.
///
/// Ids are not validated against the registry: an account has no read effect, and a list filtered
/// against the caller's own visible accounts would quietly DROP a label somebody else's account put
/// there. The Files browse filter reads an unresolvable id as a tie to something not visible.
mutate artifact setArtifactAccounts {
  args {
    artifactId  string!
    accountIds  []string
  }
  update {
    id: args.artifactId
    accountIds: args.accountIds ?? []
    updatedAt: now
  }
}

// ---- uploadSession: the chunked-transfer writes (memql#4782) ----

/// Open a chunked upload session (memql#4782, design C2). @serverOnly, and actor-scoping is NOT the
/// reason it cannot be client-reachable -- ownerUserId IS stamped from actor.userId. The reason is
/// blobPath and fileId: storage-layer facts only the upload route may author, because a
/// caller-supplied blobPath could name ANOTHER user's object and the complete step would then mint
/// a file row whose bytes are somebody else's -- authorization moved from the graph to whoever can
/// type a path. status is stamped 'open' for the sibling reason: a caller who could write status
/// could re-open a completed session and drive complete twice. The handler also runs the quota and
/// provenance checks BEFORE calling this, so a session row's existence implies both passed.
@actor
@serverOnly
mutate uploadSession createUploadSession {
  args {
    uploadId  string!
    name      string!
    size      int!
    mimeType  string
    folderId  string
    labels    []string
    uploadedFromWorkerId    string
    uploadedFromWorkerName  string
    uploadedFromPath        string
    blobPath  string!
    fileId    string!
    chunkSize int!
    targetArtifactId  string
  }
  insert {
    accept { name, size, mimeType, folderId, labels, uploadedFromWorkerId, uploadedFromWorkerName, uploadedFromPath, blobPath, fileId, chunkSize, targetArtifactId }
    stamp {
      id: args.uploadId
      ownerUserId: actor.userId
      status: "open"
    }
  }
}

/// Mark a chunked upload session completed (memql#4782): the block list committed, the file row
/// exists, the session is terminal. @serverOnly, and scoping to actor.userId is not the fix here
/// because it is ALREADY in place -- the write-guard scopes this update to the session's owner,
/// and that owner is exactly who must not call it directly: completion is the STATE the complete
/// handler's idempotency rests on (a completed session answers its ids instead of re-running the
/// commit), so an owner who could flip it from a client could desynchronise their own row from
/// the storage truth it summarises. A read-merge: every init-time fact survives for the audit
/// trail.
@serverOnly
mutate uploadSession completeUploadSession {
  args {
    uploadId  string!
  }
  update {
    id: args.uploadId
    status: "completed"
  }
}


// ---- fileVersion: the supersede pair (epic memql#4806) ----
//
// A supersede is TWO writes and there is no transaction across them, so the
// order is a design decision rather than an accident (design D3): the
// SNAPSHOT lands first, then the head moves. A crash between them leaves a
// version row whose facts equal the head's -- the reader's fold keys on
// versionNumber and the head wins, so one v2 is shown, not two -- and the
// retry is idempotent, because the snapshot's id derives from
// (fileId, versionNumber). The other order loses a version's ROW while its
// bytes stay in storage: history skips a number and nothing says so.
//
// Both are @serverOnly, and blobUrl is why: it is a storage path, and a
// caller-authored one would name another user's object which the content
// route would then stream under ?version={n}. The internal-origin stamp
// lives in component/server/fileversion, a package containing nothing else,
// on the same three preconditions component/server/uploadsession asserts.

/// Freeze the OUTGOING head of a Library file as an immutable version row (epic memql#4806, design
/// D1). Called by the upload route immediately before it moves the head, with the facts it read off
/// the head under the caller's own actor -- so nothing here is a claim the caller made. The id is
/// '<fileId>-v<n>', derived from the pair this row is unique on, which makes a retried supersede
/// re-version the same row rather than append a duplicate to somebody's history. ownerUserId is
/// stamped from actor.userId (@serverSet on the concept makes accepting it a load-time rejection):
/// the target file was resolved under that actor before a byte moved, so the stamped owner is the
/// file's owner by construction.
///
/// @serverOnly, and scoping to actor.userId is not the fix because it is ALREADY in place: the
/// concept's @serverSet stamps ownerUserId from actor.userId and row authz gates every read of the
/// result. What a caller must never AUTHOR is blobUrl -- a storage path, composed server-side from
/// the verified actor and the engine-minted fileId, where a forged value would name another user's
/// object and GET /artifacts/{id}/content?version={n} would stream it back.
@actor
@serverOnly
mutate fileVersion createLibraryFileVersion {
  args {
    versionId      string!
    fileId         string!
    versionNumber  int!
    name           string!
    mimeType       string!
    size           int!
    sha256         string
    blobUrl        string!
    format         enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "conversation", "other")
    summary        string
    uploadedFromWorkerId    string
    uploadedFromWorkerName  string
    uploadedFromPath        string
    uploadedAt     datetime!
  }
  insert {
    accept { fileId, versionNumber, name, mimeType, size, sha256, blobUrl, summary, uploadedFromWorkerId, uploadedFromWorkerName, uploadedFromPath, uploadedAt }
    stamp {
      id: args.versionId
      ownerUserId: actor.userId
      format: args.format ?? "other"
      // The moment this version stopped being the head. Stamped rather than
      // accepted for the reason versionUploadedAt is: it is a fact about when
      // the engine did something, not about what a caller believes.
      supersededAt: now
    }
  }
}

/// Move a Library file's head onto newly uploaded bytes (epic memql#4806, design D1). A read-merge,
/// so ownerUserId, folderId, labels-on-the-index, trainedIntoDomainIds and archived all survive a
/// new version -- the artifact keeps its id, its filing and its labels, and the Files list still
/// shows ONE row.
///
/// status is stamped 'analyzing', NEVER 'stored', and that is load-bearing (design D4):
/// indexFileOnCreate filters on status=="stored" and graph.node.created fires on every write, so a
/// head that re-entered 'stored' would re-run promotion through createArtifact's bare insert{} --
/// wiping the artifact's labels and re-filing it at the file row's stale initial folderId. That is
/// the memql#4288 hazard arriving through the promotion path, as a side effect of uploading a new
/// version.
///
/// sha256 is written UNCONDITIONALLY, blank when the caller could not measure it. An absent arg
/// would read-merge, leaving the PREVIOUS version's hash sitting on these bytes -- not a missing
/// fact but a false one, on a field that exists to be an integrity check. The chunked path's
/// analysis pass stamps the real value when it streams the committed blob; until then absent means
/// 'not measured yet', exactly as the concept says.
///
/// summary is cleared for the same reason: it described bytes that are no longer the head.
///
/// @serverOnly, and actor.userId scoping is not the fix here either -- it is already in place, and
/// the owner is exactly who must not call this directly. Two of the values it writes are not the
/// caller's to choose: blobUrl is a storage path (a forged one points the content route at somebody
/// else's bytes) and the 'analyzing' status is what stops a supersede re-firing indexFileOnCreate,
/// whose bare insert{} promotion would wipe the artifact's labels and re-file it at the file row's
/// stale initial folder. Both gates would become optional the moment this were client-reachable.
@serverOnly
mutate file supersedeLibraryFileHead {
  args {
    fileId         string!
    versionNumber  int!
    name           string!
    mimeType       string!
    size           int!
    sha256         string
    blobUrl        string!
    format         enum("markdown", "document", "pdf", "spreadsheet", "image", "text", "conversation", "other")
    uploadedFromWorkerId    string
    uploadedFromWorkerName  string
    uploadedFromPath        string
  }
  update {
    id: args.fileId
    args.name
    args.mimeType
    args.size
    args.blobUrl
    args.versionNumber
    sha256: args.sha256 ?? ""
    format: args.format ?? "other"
    summary: ""
    failureReason: ""
    status: "analyzing"
    embeddingStatus: "none"
    // Provenance is per-version and never inherited (the epic's rule): a
    // version pushed from a laptop names the laptop, and the browser upload
    // that replaces it names nothing. Writing the blanks explicitly is what
    // makes the second case true -- a read-merge that omitted them would
    // leave the laptop's name on bytes that came from a browser.
    uploadedFromWorkerId: args.uploadedFromWorkerId ?? ""
    uploadedFromWorkerName: args.uploadedFromWorkerName ?? ""
    uploadedFromPath: args.uploadedFromPath ?? ""
    versionUploadedAt: now
  }
}

// ---- watchedFolder: setting a backup up, and reporting on it ----
//
// Five writes, split by WHO makes them. Four are the person's -- create,
// re-point, pause, archive -- and one is the cockpit's: reportWatchedFolderSweep,
// the only way anything ever learns what is actually at the origin.
//
// NONE OF THEM IS @serverOnly, and that is the difference between this family
// and the guest-invitation one. Nothing here is a credential: the arrangement
// names a machine the caller already owns and a folder they already own, and
// the authorization that matters -- may this caller push bytes claiming this
// machine -- lives at the upload route, where verifyProvenance resolves the
// claim in the caller's own fleet. A client-reachable create is therefore
// exactly right; it is what lets the Files app and the cockpit use one API.

/// Start watching a folder on one of the caller's machines (epic memql#4783). Owner-acted:
/// ownerUserId is stamped from actor.userId, so a watch can only ever be created for the person the
/// call runs as. `status` and `archived` are stamped explicitly rather than left to the concept's
/// @default, for createArtifact's reason -- @default is never applied on insert (memql#3038), so a
/// row that states its own answer is the only row whose answer can be read.
///
/// The machine is NOT verified here. That is the header's decision, not an omission: the row is a
/// preference, a watch naming a machine the caller does not own is read by no cockpit, and the push
/// it would attempt is refused at the upload by a check that CAN see the caller's fleet.
@actor
mutate watchedFolder createLibraryWatchedFolder {
  args {
    watchId        string!
    workerId       string!
    localPath      string!
    folderId       string
    excludeGlobs   []string
    includeHidden  boolean
  }
  insert {
    accept { workerId, localPath, folderId, excludeGlobs }
    stamp {
      id: args.watchId
      ownerUserId: actor.userId
      includeHidden: args.includeHidden ?? false
      status: "active"
      archived: false
    }
  }
}

/// Re-point or re-tune a watch: where it files, what it skips, whether it sweeps hidden entries.
/// A read-merge update (memql#1628), so the arguments are MINIMAL -- the machine and the path are
/// deliberately absent, because they are the backup's IDENTITY (the (machine, path) key every
/// re-push is matched on) and re-supplying them would be dead weight that an undeclared-argument
/// DISCARD then hides.
///
/// THE THREE IT DOES TAKE ARE A FULL REPLACE, and each writes its explicit empty rather than a bare
/// `args.X` -- the `?? []` / `?? ""` idiom setArtifactAccounts and renameWorker already use. Omitting
/// one therefore CLEARS it (back to the Library root, back to skipping nothing, back to hiding
/// hidden files), which is the one semantic the caller can rely on: a bare `args.excludeGlobs` would
/// leave "the caller sent nothing" meaning whatever the writer happened to do with an absent value,
/// and that is exactly the ambiguity the idiom exists to remove. The Files form always sends all
/// three, because it shows all three.
///
/// Re-pointing folderId moves NOTHING that already arrived. Files carry their own folderId and the
/// engine has no cascade; this decides where the next push lands. The app says exactly that at the
/// moment of the change, because a person re-pointing a backup reasonably expects otherwise.
mutate watchedFolder updateLibraryWatchedFolder {
  args {
    watchId        string!
    folderId       string
    excludeGlobs   []string
    includeHidden  boolean
  }
  update {
    id: args.watchId
    folderId: args.folderId ?? ""
    excludeGlobs: args.excludeGlobs ?? []
    includeHidden: args.includeHidden ?? false
  }
}

/// Pause or resume a watch. One field on one row, and deliberately not the archive: pausing keeps
/// the arrangement in the list and in the cockpit's local record, so resuming picks up where it
/// left off instead of re-pushing a folder from scratch.
mutate watchedFolder setLibraryWatchedFolderStatus {
  args {
    watchId  string!
    status   enum("active", "paused")!
  }
  update {
    id: args.watchId
    status: args.status
  }
}

/// Stop watching a folder, keeping the record of what was arranged. THE FILES THAT ALREADY ARRIVED
/// ARE UNTOUCHED -- they are ordinary Library files owned by the same person, and the one-way
/// invariant (design E, D12) does not stop applying because the arrangement ended. Nothing here
/// reaches the origin either: archiving a watch does not delete anything on the machine.
mutate watchedFolder archiveLibraryWatchedFolder {
  args {
    watchId  string!
  }
  update {
    id: args.watchId
    archived: true
  }
}

/// Put an archived watch back. The plain inverse of the archive, one field on one row -- which is
/// what lets somebody undo a stop without re-typing a path (memql#4784's restore reasoning, applied
/// to the arrangement rather than to a file).
mutate watchedFolder restoreLibraryWatchedFolder {
  args {
    watchId  string!
  }
  update {
    id: args.watchId
    archived: false
  }
}

/// Record what the cockpit found at the origin on its last pass (epic memql#4783, the cockpit half
/// memql#4841). The counterpart of setLibraryFileLinkState one level up: that one reports on a file,
/// this one on the folder, and both exist because the cockpit is the only party that can see the
/// origin at all -- the engine knows what it received and when, and nothing more.
///
/// `lastSweepAt` IS SERVER-STAMPED, not accepted. A caller that could name its own check time could
/// claim to have looked when it did not, and the entire value of the field is that it makes a stale
/// `ok` honest: "backed up, last checked 3 weeks ago" is a different claim from "backed up", and
/// only one of them is one this row can make. Same reasoning, same shape as linkCheckedAt.
///
/// EVERY REPORT REPLACES THE WHOLE REPORTED STATE. A clean pass sends no error and clears the
/// previous one -- `?? ""` is blank-coalescing, so an absent argument writes the empty string
/// rather than leaving a fixed problem on screen forever. The counts are stamped through the same
/// coalesce, where `0` survives it (?? keeps 0 and false; it falls through on blanks), so "the
/// folder is there and empty" and "nothing has reported" stay different answers.
mutate watchedFolder reportLibraryWatchedFolderSweep {
  args {
    watchId         string!
    originState     enum("ok", "missing", "unreadable", "refused_by_policy")!
    filesSeen       int
    bytesSeen       int
    lastSweepError  string
  }
  update {
    id: args.watchId
    originState: args.originState
    filesSeen: args.filesSeen ?? 0
    bytesSeen: args.bytesSeen ?? 0
    lastSweepError: args.lastSweepError ?? ""
    lastSweepAt: now
  }
}
