// library domain -- row projections.

@row
@description("Comprehensive Library index projection: every payload field plus row id and timestamps. The default shape for the Library list / search / filter reads (memql#695) and the per-item detail view.")
shape artifact artifactFull {
  row.id
  ownerUserId
  lens
  kind
  source
  sourceConceptRef
  title
  summary
  format
  mimeType
  live
  scope
  partitionId
  agentId
  producedByPlanId
  validationStatus
  updatedAt
  row.createdAt
}

@row
@description("Comprehensive generatedOutput projection: every payload field plus row id and timestamps. Used by the Library detail / viewer when drilling into a generated_output artifact.")
shape generatedOutput generatedOutputFull {
  row.id
  ownerUserId
  title
  summary
  body
  attachmentId
  format
  mimeType
  source
  partitionId
  producedByPlanId
  producedByAgentId
  row.createdAt
}

@row
@description("Full memory projection for the Library Records lens detail / drill-in.")
shape memory memoryFull {
  row.id
  ownerUserId
  title
  content
  summary
  kind
  agentId
  partitionId
  sourceUtteranceId
  row.createdAt
}

@row
@description("History-list projection of a document version: the metadata a user scans the edit history with (version number, who, when, what-changed note) WITHOUT the full content body. Backs documentVersions. The full content is fetched on demand per-version via documentVersionFull (documentVersionById).")
shape documentVersion documentVersionSummary {
  row.id
  ownerUserId
  documentId
  versionNumber
  authorKind
  authorId
  note
  parentVersionId
  attachmentId
  producedByPlanId
  partitionId
  row.createdAt
}

@row
@description("Full document-version projection including the immutable content body. Backs documentVersionById (the 'open this version' / restore-source read) and the edit/restore handlers that read the latest version to compute the next versionNumber.")
shape documentVersion documentVersionFull {
  row.id
  ownerUserId
  documentId
  versionNumber
  content
  attachmentId
  authorKind
  authorId
  note
  parentVersionId
  producedByPlanId
  partitionId
  row.createdAt
}

