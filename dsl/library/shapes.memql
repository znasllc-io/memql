// library domain -- row projections.

/// Comprehensive Library index projection: every payload field plus row id and timestamps. The
/// default shape for the Library list / search / filter reads (memql#695) and the per-item detail
/// view.
@row
shape artifact artifactFull {
  row.id
  ownerUserId
  lens
  kind
  source
  sourceConceptRef
  title
  summary
  format
  mimeType
  live
  scope
  labels
  archived
  partitionId
  agentId
  producedByPlanId
  producedByWorkerId
  producedByWorkerName
  validationStatus
  updatedAt
  row.createdAt
}

/// Comprehensive generatedOutput projection: every payload field plus row id and timestamps. Used
/// by the Library detail / viewer when drilling into a generated_output artifact.
@row
shape generatedOutput generatedOutputFull {
  row.id
  ownerUserId
  title
  summary
  body
  attachmentId
  format
  mimeType
  source
  partitionId
  producedByPlanId
  producedByAgentId
  row.createdAt
}

/// Full memory projection for the Library Records lens detail / drill-in.
@row
shape memory memoryFull {
  row.id
  ownerUserId
  title
  content
  summary
  kind
  agentId
  partitionId
  sourceUtteranceId
  row.createdAt
}

/// History-list projection of a document version: the metadata a user scans the edit history with
/// (version number, who, when, what-changed note) WITHOUT the full content body. Backs
/// documentVersions. The full content is fetched on demand per-version via documentVersionFull
/// (documentVersionById).
@row
shape documentVersion documentVersionSummary {
  row.id
  ownerUserId
  documentId
  versionNumber
  authorKind
  authorId
  note
  parentVersionId
  attachmentId
  producedByPlanId
  partitionId
  row.createdAt
}

/// Full document-version projection including the immutable content body. Backs documentVersionById
/// (the 'open this version' / restore-source read) and the edit/restore handlers that read the
/// latest version to compute the next versionNumber.
@row
shape documentVersion documentVersionFull {
  row.id
  ownerUserId
  documentId
  versionNumber
  content
  attachmentId
  authorKind
  authorId
  note
  parentVersionId
  producedByPlanId
  partitionId
  row.createdAt
}


/// Full projection of a Library file row: every payload field plus the row id and creation stamp.
/// Backs libraryFileById and libraryFilesForOwner, and the download / export route which needs
/// name, mimeType, size and blobUrl together to stream the bytes with correct headers.
@row
shape file libraryFileFull {
  row.id
  ownerUserId
  name
  mimeType
  size
  sha256
  blobUrl
  source
  format
  status
  summary
  failureReason
  embeddingStatus
  trainedIntoDomainIds
  archived
  row.createdAt
}

/// Full projection of one file chunk, including the body text the embedding was computed from.
/// Backs libraryFileChunksForFile -- the read the analysis pass uses to confirm what it wrote and
/// the similarity fold uses to resolve a hit back to its file and artifact.
@row
shape fileChunk libraryFileChunkFull {
  row.id
  ownerUserId
  fileId
  artifactId
  seq
  text
  tokenCount
  row.createdAt
}
