// library domain -- row projections.

use library.concepts.{ artifact, generatedOutput }

@row
@description("Comprehensive Library index projection: every payload field plus row id and timestamps. The default shape for the Library list / search / filter reads (memql#695) and the per-item detail view.")
shape artifact artifactFull {
  row.id
  payload.ownerUserId
  payload.lens
  payload.kind
  payload.source
  payload.sourceConceptRef
  payload.title
  payload.summary
  payload.format
  payload.mimeType
  payload.live
  payload.spaceId
  payload.agentId
  payload.producedByPlanId
  payload.validationStatus
  payload.updatedAt
  row.createdAt
}

@row
@description("Comprehensive generatedOutput projection: every payload field plus row id and timestamps. Used by the Library detail / viewer when drilling into a generated_output artifact.")
shape generatedOutput generatedOutputFull {
  row.id
  payload.ownerUserId
  payload.title
  payload.summary
  payload.body
  payload.attachmentId
  payload.format
  payload.mimeType
  payload.source
  payload.spaceId
  payload.producedByPlanId
  payload.producedByAgentId
  row.createdAt
}
