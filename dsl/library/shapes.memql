// library domain -- row projections.

/// Comprehensive Library index projection: every payload field plus row id and timestamps. The
/// default shape for the Library list / search / filter reads (memql#695) and the per-item detail
/// view.
@row
shape artifact artifactFull {
  row.id
  ownerUserId
  lens
  kind
  source
  sourceConceptRef
  title
  summary
  format
  mimeType
  live
  scope
  labels
  archived
  folderId
  partitionId
  agentId
  producedByPlanId
  producedByWorkerId
  producedByWorkerName
  validationStatus
  accountIds
  updatedAt
  row.createdAt
}

/// Comprehensive generatedOutput projection: every payload field plus row id and timestamps. Used
/// by the Library detail / viewer when drilling into a generated_output artifact.
@row
shape generatedOutput generatedOutputFull {
  row.id
  ownerUserId
  title
  summary
  body
  attachmentId
  format
  mimeType
  source
  partitionId
  producedByPlanId
  producedByAgentId
  row.createdAt
}

/// Full memory projection for the Library Records lens detail / drill-in.
@row
shape memory memoryFull {
  row.id
  ownerUserId
  title
  content
  summary
  kind
  agentId
  partitionId
  sourceUtteranceId
  row.createdAt
}

/// History-list projection of a document version: the metadata a user scans the edit history with
/// (version number, who, when, what-changed note) WITHOUT the full content body. Backs
/// documentVersions. The full content is fetched on demand per-version via documentVersionFull
/// (documentVersionById).
@row
shape documentVersion documentVersionSummary {
  row.id
  ownerUserId
  documentId
  versionNumber
  authorKind
  authorId
  note
  parentVersionId
  attachmentId
  producedByPlanId
  partitionId
  row.createdAt
}

/// Full document-version projection including the immutable content body. Backs documentVersionById
/// (the 'open this version' / restore-source read) and the edit/restore handlers that read the
/// latest version to compute the next versionNumber.
@row
shape documentVersion documentVersionFull {
  row.id
  ownerUserId
  documentId
  versionNumber
  content
  attachmentId
  authorKind
  authorId
  note
  parentVersionId
  producedByPlanId
  partitionId
  row.createdAt
}


/// Full projection of a Library file row: every payload field plus the row id and creation stamp.
/// Backs libraryFileById and libraryFilesForOwner, and the download / export route which needs
/// name, mimeType, size and blobUrl together to stream the bytes with correct headers.
@row
shape file libraryFileFull {
  row.id
  ownerUserId
  name
  mimeType
  size
  sha256
  blobUrl
  source
  format
  status
  summary
  failureReason
  embeddingStatus
  trainedIntoDomainIds
  archived
  folderId
  uploadedFromWorkerId
  uploadedFromWorkerName
  uploadedFromPath
  linkState
  linkCheckedAt
  versionNumber
  versionUploadedAt
  row.createdAt
}

/// Full projection of one superseded version of a Library file (epic memql#4806). Backs
/// libraryFileVersionsForFile -- the history panel's read -- and libraryFileVersionById, which the
/// content route resolves ?version={n} through. A concept field is not a readable field until a
/// shape projects it, so this carries every fact the panel renders AND the blobUrl the download
/// streams: the route re-checks row admission through the query, then reads the path off the
/// admitted row.
@row
shape fileVersion libraryFileVersionFull {
  row.id
  ownerUserId
  fileId
  versionNumber
  name
  mimeType
  size
  sha256
  blobUrl
  format
  summary
  uploadedFromWorkerId
  uploadedFromWorkerName
  uploadedFromPath
  uploadedAt
  supersededAt
  row.createdAt
}

/// The quota projection of a file version: the stored size, and nothing a sum does not need.
/// Mirrors libraryFileSize, because superseded bytes count exactly like head bytes (design D9).
@row
shape fileVersion libraryFileVersionSize {
  row.id
  size
}

/// Full projection of a Library folder row (memql#4781): every payload field plus the row id and
/// creation stamp. Backs libraryFolders (the tree read) and libraryFolderById. A concept field is
/// not a readable field until a shape projects it -- this is the projection, and it carries
/// parentFolderId and archived precisely because the client-side tree fold and the archive walk
/// read them.
@row
shape folder libraryFolderFull {
  row.id
  ownerUserId
  name
  parentFolderId
  archived
  row.createdAt
}

/// Full projection of a chunked upload session (memql#4782). Backs uploadSessionById -- the
/// per-chunk authorization read -- so it carries everything the chunk, inventory and complete
/// handlers decide on: the declared size the commit verifies, the blob path the blocks staged
/// into, the fileId and filing and provenance the file row will take, and the status.
@row
shape uploadSession uploadSessionFull {
  row.id
  ownerUserId
  name
  size
  mimeType
  folderId
  labels
  uploadedFromWorkerId
  uploadedFromWorkerName
  uploadedFromPath
  blobPath
  fileId
  chunkSize
  targetArtifactId
  status
  row.createdAt
}

/// The quota projection of an upload session: the declared size, and nothing a sum does not need.
@row
shape uploadSession uploadSessionSize {
  row.id
  size
}

/// The quota projection of a file: the stored size, and nothing a sum does not need.
@row
shape file libraryFileSize {
  row.id
  size
}

/// Full projection of one file chunk, including the body text the embedding was computed from.
/// Backs libraryFileChunksForFile -- the read the analysis pass uses to confirm what it wrote and
/// the similarity fold uses to resolve a hit back to its file and artifact.
@row
shape fileChunk libraryFileChunkFull {
  row.id
  ownerUserId
  fileId
  artifactId
  seq
  text
  tokenCount
  row.createdAt
}

/// Full projection of one watched folder (epic memql#4783, the cockpit half memql#4841). Backs both
/// readers, and deliberately one shape for the two: the cockpit needs the arrangement and the Files
/// app needs the arrangement PLUS what was last reported about it, and two shapes over one row would
/// be two things to keep in step for no gain. A concept field is not a readable field until a shape
/// projects it, so every field the app renders and every field the sweeper acts on is here --
/// including the three that are frequently ABSENT (originState, filesSeen, bytesSeen), because a
/// projection that omitted them would make "nothing has reported yet" unreadable rather than empty.
@row
shape watchedFolder watchedFolderFull {
  row.id
  ownerUserId
  workerId
  localPath
  folderId
  status
  excludeGlobs
  includeHidden
  archived
  originState
  lastSweepAt
  lastSweepError
  filesSeen
  bytesSeen
  row.createdAt
}
