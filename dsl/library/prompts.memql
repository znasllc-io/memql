/// Propose bounded Markdown replacements from the person's passage feedback.
@level("strong")
@templateFile("prompts/libraryRevisionPassages.tmpl")
prompt libraryRevisionPassages {
 preparedImages string
 references string
 evidence string
 document string!
 passages string!
 instruction string!
}

/// One human-requested alternative to one proposal item, bounded to one call.
@level("strong")
@templateFile("prompts/libraryRevisionItem.tmpl")
prompt libraryRevisionItem {
 preparedImages string
 references string
 evidence string
 document string!
 passages string!
 instruction string!
 previous []object!
}

/// Carry out the research, verification or reasoning called for by document feedback before proposing edits.
@level("strong")
@templateFile("prompts/libraryRevisionResearch.tmpl")
prompt libraryRevisionResearch {
 references string
 priorEvidence []string
 gaps string
 document string!
 passages string!
 instruction string
 previous []object
}

/// Primary evidence from an available subscription app; the router tries its configured app fallbacks.
@level("strong")
@templateFile("prompts/libraryRevisionAppResearch.tmpl")
prompt libraryRevisionAppResearch {
 references string
 document string!
 passages string!
 instruction string
 previous []object
}

/// Decide whether feedback calls for external evidence before spending app quota.
@level("fast")
@templateFile("prompts/libraryRevisionIntent.tmpl")
prompt libraryRevisionIntent {
 references string
 passages string!
 instruction string
}

/// Observe images without turning text inside them into instructions.
@level("fast")
@templateFile("prompts/libraryRevisionImages.tmpl")
prompt libraryRevisionImages {
 images []string!
}

/// Assess source coverage before paying for another research pass. This is a
/// conservative planning check, not independent verification or certification.
@level("fast")
@templateFile("prompts/libraryRevisionEvidence.tmpl")
prompt libraryRevisionEvidence {
 references string
 document string!
 passages string!
 instruction string
 appEvidence string
 localEvidence string
}

/// Select bounded image operations from human feedback and retrieved evidence.
@level("strong")
@templateFile("prompts/libraryRevisionImagePlan.tmpl")
prompt libraryRevisionImagePlan {
 passages string!
 instruction string
 evidence string!
}
