// concepts.memql
//
// Concepts in the guide namespace -- the persisted Guide/Scene data
// model for CoPresent Control v2 (epic visionarys-io/copresent#186,
// issue visionarys-io/copresent#556).
//
// A Guide is an immersive, voice-driven experience the GA runs WITH
// the user: an ordered sequence of Scenes the agent narrates while
// driving the Canvas + UI (consent-forward entry, forced voice-to-voice
// inside, per-Scene interruptible / raise-hand semantics, optional
// assistant avatar). Guides are authored on the fly from a voice intake
// (copresent#194) and PERSISTED so they are re-runnable / editable /
// shareable; the first consumer is the first-run walkthrough
// (copresent#195), generalised to anytime "demo me X / teach me Y"
// (copresent#196).
//
// EVOLUTION of v1:curriculum:curriculum + v1:curriculum:segment: the
// Guide/Scene shape reuses the proven parent + ordered-children pattern
// (JSON-encoded action arrays, slug-keyed routing, version pinning) but
// is a NEW namespace rather than a rename, because the Curriculum/Segment
// concept is still in active use by the agent-training-studio. The intro
// onboarding curriculum is the one consumer being retired (copresent#195);
// training keeps Curriculum intact.
//
// RUN-STATE is deliberately CLIENT-ONLY: the live run (current Scene,
// scene index, paused / ended, raise-hand queue, locked-mic flag) lives
// in the copresent GuideSessionContext (copresent#190). The server stores
// only the Guide DEFINITION; nothing about an in-flight run is persisted.
// This mirrors how the Operator Control Session is client-owned today and
// keeps a Guide replayable without server run-state migration.
//
// VISIBILITY: the DSL tree does not use @visibility annotations (no
// concept in the embedded tree carries one as of this writing); the guide
// concepts load on every node type, same as curriculum. The Agent node
// authors Guides (copresent#194) and the BFF serves them to copresent
// through the generated SDK queries below.

@version("1.0.0")
@namespace("guide")
@description("A persisted, re-runnable Guide: an ordered sequence of Scenes the General Assistant narrates while driving the CoPresent UI + Canvas in an immersive voice-to-voice walkthrough. Authored on the fly from a voice intake (copresent#194) and run by the client Guide runtime (copresent#190). Consumed first by the first-run walkthrough (copresent#195), then generalised to anytime demo/teach (copresent#196). Evolves v1:curriculum:curriculum -- same parent+ordered-children shape -- as a distinct namespace so the training-studio Curriculum stays untouched.")
@displayCard(primary="name", secondary="kind", tertiary="description", status="active")
concept guide {
  slug  string  @required  @description("Stable machine-readable identifier. Well-known slugs drive fixed entry points (e.g. 'first-run-walkthrough'); generated Guides get a unique slug at authoring time. The client re-runs a Guide by slug irrespective of node ID.")

  name  string  @required  @description("Human-readable title shown to the user (e.g. 'Welcome to CoPresent', 'Demo: creating a sales agent').")

  description  string  @description("Short summary of what the Guide covers. Surfaced in any authoring / replay picker and on the consent-forward entry prompt.")

  kind  enum("demo", "teach", "walkthrough")  @required  @default("walkthrough")  @description("Category of experience. 'walkthrough' = first-run / feature tour; 'demo' = show me X; 'teach' = teach me how to Y. Drives the avatarEnabled default at generation time (demo / teach default avatar-on; copresent#192) and how the Guide is surfaced.")

  avatarEnabled  bool  @default("false")  @description("Whether the assistant avatar video engages alongside voice while this Guide runs (copresent#192). Per-Guide config: the generator defaults this ON for educational / demo Guides and OFF otherwise; the user / author can override.")

  ownerUserId  string  @description("v1:identity:user.id of the Guide's owner (the user the Guide was generated for, or the author). Null for system-seeded Guides like the generic first-run template.")

  spaceId  string  @description("Optional space scope. When set, the Guide is associated with a specific space; null = workspace-level / not space-bound (e.g. the first-run walkthrough before the user has a space).")

  sceneCount  int  @default("0")  @description("Number of Scenes in this Guide. Stamped by the generator on create so the client can render progress (Scene k of N) without a separate count query.")

  generatedFromIntake  bool  @default("false")  @description("Provenance: true when this Guide was authored on the fly from a voice intake (copresent#194), false for hand-seeded / template Guides. Lets the UI distinguish 'tailored for you' Guides from canned ones.")

  intakeSummary  string  @description("Short summary of the intake that produced this Guide (industry, role, interests, goals). Null for non-generated Guides. Carried for provenance + so a regenerate can reuse the captured context.")

  requiredScopes  []string  @description("Operator tool scopes this Guide's Scenes may use (e.g. 'read', 'navigate', 'highlight', 'create', 'update', 'identity'). Mirrors curriculum.requiredScopes: the client Guide runtime rejects any tool call whose scopes fall outside this set -- defense-in-depth on top of the GA's GA-only operator gating.")

  locales  []string  @description("Locale codes this Guide's content is available in (e.g. 'en-US', 'es-MX'). The client picks the matching variant.")

  version  int  @required  @default("1")  @description("Monotonically increasing version. A replay pins the version it started with so an edit mid-run does not disrupt an in-flight session (mirrors curriculum/onboarding versioning).")

  active  bool  @default("true")  @description("Whether this Guide is available to be run. Soft-disable without deleting the row + its Scenes.")
}

@version("1.0.0")
@namespace("guide")
@description("One Scene in a v1:guide:guide: the unit of a Guide. Carries the narration INTENT the GA voices (it may paraphrase, staying on-intent), the Canvas actions to perform (publish content + live annotation directives), optional avatar directives, and the interruptibility contract (interruptible / allowsQuestions) the locked-Scene control enforces (copresent#191). Scenes are ordered by `order`; the runtime advances on Scene completion / agent decision. Evolves v1:curriculum:segment -- narration + recommended actions + ordering -- without the option-graph branching (a Guide is a linear narrated sequence, not a choose-your-own-path).")
concept scene {
  guideId  string  @required  @description("ID of the v1:guide:guide this Scene belongs to.")

  slug  string  @required  @description("Stable identifier within the Guide (e.g. 'intro', 'show-spaces', 'wrap-up'). Lets authoring reorder Scenes without rebinding references.")

  order  int  @required  @description("0-based position in the Guide's Scene sequence. The runtime plays Scenes in ascending order; gaps are tolerated (sort, don't index).")

  title  string  @description("Short Scene title for the client's progress / navigator affordance (e.g. 'Creating your first space'). Optional; the runtime falls back to a positional label.")

  narrationIntent  string  @required  @description("What the GA should CONVEY in this Scene, expressed for the LLM (intent, not a verbatim script). The agent narrates this naturally over voice, paraphrasing / expanding as long as it stays on-intent. Example: 'Welcome the user by name, explain that spaces are where they collaborate with their assistant, and point at the Spaces nav.'")

  canvasActions  string  @description("JSON array of Canvas directives the GA performs during this Scene, in order. Two directive families: content publish (reuse canvas.publish -- {\"type\":\"publish\",\"kind\":\"card|document|dataview\",\"data\":{...}}) and live annotation (the overlay layer from copresent#193 -- {\"type\":\"annotate\",\"shape\":\"point|arrow|circle|highlight\",\"target\":\"<data-op-id>\"}). Empty / null = a narration-only Scene. The client Guide runtime dispatches these through the same local operator dispatcher as the ui* primitives.")

  avatarDirectives  string  @description("Optional JSON for assistant-avatar behavior during this Scene (copresent#192), e.g. {\"show\":true}. Null inherits the Guide-level avatarEnabled. Reserved for per-Scene avatar nuance; the v1 runtime only needs the Guide-level flag.")

  interruptible  bool  @default("true")  @description("Whether the user can barge in (speak over the agent) during this Scene. When false, the client mutes the user mic TRACK for the Scene's duration (copresent#191) so the narration cannot be interrupted; re-enabled on the next interruptible / allowsQuestions Scene.")

  allowsQuestions  bool  @default("true")  @description("Whether this Scene is an open boundary where a queued raise-hand is acknowledged and questions are taken (copresent#191). A locked Scene (interruptible=false) typically also sets this false; the runtime picks up a pending raise-hand at the next Scene whose allowsQuestions=true.")

  successCondition  string  @description("Optional natural-language description of when this Scene is 'done', used by the agent's judgment to decide when to advance. Example: 'The user has seen the Spaces panel open.' Null = advance when the narration + Canvas actions complete.")

  @relationship(type="parent", field="guideId", target=guide, direction="outgoing")
}
