policy fastCoding { }

// ---- policies/bff/voice/isAvatarVendorAvailable.memql ----

// isAvatarVendorAvailable
// =======================
//
// Returns true iff the named avatar vendor is configured for this
// node. Composed into avatarVendorChoice via policy(...).
//
// args:
//   vendor  string  -- "anam" / "simli" (free-form; unknown vendors fall through to false)
//
// Reads ctx.config.openaiApiKey only as the OpenAI key isn't the
// avatar gate -- ANAM_API_KEY / SIMLI_API_KEY are. They're not in
// the PolicyExposableConfig allow-list yet, so this policy's v1
// surface treats "any caller-supplied vendor that names a known
// vendor" as available. Phase 9 expansion: extend the allow-list
// with the per-vendor keys once the voice-agent integration is
// ready to consume them.

@tier("bff")
@description("Is the named avatar vendor configured + available?")
func (Policy) isAvatarVendorAvailable(ctx any) bool {
  ctx.output = ctx.vendor == "anam"
  return ctx, nil
}

// ---- policies/v1/lowLatencyVoice.memql ----

@primary("streamGroqLlama70B")
@fallback("streamGeminiFlash")
@fallback("stream54Mini")
@maxTimeToFirstTokenMs(800)
@maxLatencyMs(10000)
@description("Low latency voice -- turn-taking in multi-party voice conversations. Groq is the best-in-class for first-token latency; Gemini Flash as a fallback matches the target TTFT envelope.")
policy lowLatencyVoice { }

