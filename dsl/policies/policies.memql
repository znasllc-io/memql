// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@primary("streamClaudeSonnet")
@fallback("stream54Pro")
@fallback("streamGeminiPro")
@maxLatencyMs(60000)
@preferredRole("assistant")
@preferredRole("specialist")
@description("Default chat policy for non-operator agents. Claude Sonnet 4.6 primary, GPT-5.4 Pro as cross-vendor fallback, Gemini Pro as tertiary safety net. Was previously Mini-primary, which produced too many hedged + un-cited replies (the LLM smoothed RAG'd specifics into generic platitudes); the floor for agent replies is now Sonnet-class regardless of role. Use cheapestCapable / lowLatencyVoice for paths that legitimately need Mini-class speed/cost tradeoffs (batch, voice).")
policy balancedChat { }

// ---- policies/v1/cheapestCapable.memql ----

@primary("streamGeminiFlash")
@fallback("streamGroqLlama70B")
@fallback("streamCodestral")
@maxLatencyMs(15000)
@description("Cheapest capable -- bulk suggestion + classification work where cost per call matters more than model ceiling. Gemini Flash primary, Groq Llama 70B second, Mistral Codestral as a structured-output-friendly third.")
policy cheapestCapable { }

// ---- policies/v1/fastCoding.memql ----

@primary("streamCodestral")
@fallback("streamGroqLlama70B")
@fallback("stream54Mini")
@maxLatencyMs(20000)
@description("Fast coding -- cheap + quick for code generation and refactor assistance. Codestral primary (coding-specialized), Groq Llama as fallback (fastest tokens/sec), GPT-5.4 Mini as a last resort.")
policy fastCoding { }

// ---- policies/v1/lowLatencyVoice.memql ----

@primary("streamGroqLlama70B")
@fallback("streamGeminiFlash")
@fallback("stream54Mini")
@maxTimeToFirstTokenMs(800)
@maxLatencyMs(10000)
@description("Low latency voice -- turn-taking in multi-party voice conversations. Groq is the best-in-class for first-token latency; Gemini Flash as a fallback matches the target TTFT envelope.")
policy lowLatencyVoice { }

// ---- policies/v1/strongReasoning.memql ----

@primary("streamClaudeSonnet")
@fallback("stream54Pro")
@fallback("streamGeminiPro")
@maxLatencyMs(60000)
@preferredRole("operator")
@description("Strong reasoning -- for operator-enabled agents driving the UI and for complex tool-calling choreography. Claude Sonnet primary, GPT-5.4 Pro as a second, Gemini Pro as a third.")
policy strongReasoning { }

// ---- policies/v1/backgroundExecution.memql ----

@primary("stream54Mini")
@fallback("streamClaudeHaiku")
@fallback("stream54Nano")
@maxLatencyMs(120000)
@description("Background / batch execution lane -- CHEAP DEFAULT tier (memql#898). Planner-dispatched plan/task execution (e.g. produceArtifact file generation) is routine work that does not need the strong/expensive interactive model, so it defaults to GPT-5.4 Mini with cross-vendor cheap fallbacks (Claude Haiku, then GPT-5.4 Nano). Every entry is OpenAI/Anthropic because only those vendors implement the NON-streaming tool-calling surface the background lane uses. When the cheap tier gets stuck on a turn (repeated tool-call failures), the background executor escalates mid-turn to the backgroundEscalation policy. Kept separate from the interactive chat policies (memql#897) so the batch tier is tuned independently of live chat; higher maxLatencyMs because no human waits on its first token; pairs with the background si_guard rate bucket.")
policy backgroundExecution { }

// ---- policies/v1/backgroundEscalation.memql ----

@primary("streamClaudeSonnet")
@fallback("stream54Pro")
@maxLatencyMs(120000)
@description("Background lane ESCALATION tier (memql#898). The strong/expensive chain the background executor swaps to when the cheap backgroundExecution tier gets stuck on a turn (an explicit stuck signal -- repeated rounds where every tool call errored, which usually means the cheap model is mishandling the workbench/worker tool). Claude Sonnet primary, GPT-5.4 Pro as a tool-capable cross-vendor fallback (both implement the non-streaming tool surface; Gemini does not, so it is intentionally absent here). Escalation happens at most once per turn and reuses the in-progress message history, so it costs one stronger continuation, not a full re-run.")
policy backgroundEscalation { }
