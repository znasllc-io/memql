// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Default chat policy for non-operator agents. Claude Sonnet 4.6 primary, GPT-5.4 Pro as
/// cross-vendor fallback, Claude Haiku as tertiary safety net. Was previously Mini-primary, which
/// produced too many hedged + un-cited replies (the LLM smoothed RAG'd specifics into generic
/// platitudes); the floor for agent replies is now Sonnet-class regardless of role. Use
/// cheapestCapable / lowLatencyVoice for paths that legitimately need Mini-class speed/cost
/// tradeoffs (batch, voice).
@primary("streamClaudeSonnet")
@fallback("stream54Pro")
@fallback("streamClaudeHaiku")
@maxLatencyMs(60000)
@preferredRole("assistant")
@preferredRole("specialist")
policy balancedChat { }

// ---- policies/v1/cheapestCapable.memql ----

/// Cheapest capable -- bulk suggestion + classification work where cost per call matters more than
/// model ceiling. GPT-5.4 Mini primary, Claude Haiku as the cross-vendor second, GPT-5.4 Nano as
/// the rock-bottom third.
@primary("stream54Mini")
@fallback("streamClaudeHaiku")
@fallback("stream54Nano")
@maxLatencyMs(15000)
policy cheapestCapable { }

// ---- policies/v1/fastCoding.memql ----

/// Fast coding -- cheap + quick for code generation and refactor assistance. Codex 5.3 primary
/// (coding-specialized), GPT-5.4 Mini as fallback, Claude Haiku as a cross-vendor last resort.
@primary("streamCodex53")
@fallback("stream54Mini")
@fallback("streamClaudeHaiku")
@maxLatencyMs(20000)
policy fastCoding { }

// ---- policies/v1/lowLatencyVoice.memql ----

/// Low latency voice -- turn-taking in multi-party voice conversations. GPT-5.4 Mini leads on
/// first-token latency within the supported vendors; GPT-5.4 Nano and Claude Haiku back it up
/// inside the target TTFT envelope.
@primary("stream54Mini")
@fallback("stream54Nano")
@fallback("streamClaudeHaiku")
@maxTimeToFirstTokenMs(800)
@maxLatencyMs(10000)
policy lowLatencyVoice { }

// ---- policies/v1/strongReasoning.memql ----

/// Strong reasoning -- for operator-enabled agents driving the UI and for complex tool-calling
/// choreography. Claude Sonnet primary, GPT-5.4 Pro as a second, Claude Opus as a third.
@primary("streamClaudeSonnet")
@fallback("stream54Pro")
@fallback("streamClaudeOpus")
@maxLatencyMs(60000)
@preferredRole("operator")
policy strongReasoning { }

// ---- policies/v1/backgroundExecution.memql ----

/// Background / batch execution lane -- CHEAP DEFAULT tier (memql#898). Planner-dispatched
/// plan/task execution (e.g. produceArtifact file generation) is routine work that does not need
/// the strong/expensive interactive model, so it defaults to GPT-5.4 Mini with cross-vendor cheap
/// fallbacks (Claude Haiku, then GPT-5.4 Nano). Every entry is OpenAI/Anthropic because only those
/// vendors implement the NON-streaming tool-calling surface the background lane uses. When the
/// cheap tier gets stuck on a turn (repeated tool-call failures), the background executor escalates
/// mid-turn to the backgroundEscalation policy. Kept separate from the interactive chat policies
/// (memql#897) so the batch tier is tuned independently of live chat; higher maxLatencyMs because
/// no human waits on its first token; pairs with the background si_guard rate bucket.
@primary("stream54Mini")
@fallback("streamClaudeHaiku")
@fallback("stream54Nano")
@maxLatencyMs(120000)
policy backgroundExecution { }

// ---- policies/v1/backgroundEscalation.memql ----

/// Background lane ESCALATION tier (memql#898). The strong/expensive chain the background executor
/// swaps to when the cheap backgroundExecution tier gets stuck on a turn (an explicit stuck signal
/// -- repeated rounds where every tool call errored, which usually means the cheap model is
/// mishandling the workbench/worker tool). Claude Sonnet primary, GPT-5.4 Pro as a tool-capable
/// cross-vendor fallback (both implement the non-streaming tool surface). Escalation happens at
/// most once per turn and reuses the in-progress message history, so it costs one stronger
/// continuation, not a full re-run.
@primary("streamClaudeSonnet")
@fallback("stream54Pro")
@maxLatencyMs(120000)
policy backgroundEscalation { }
