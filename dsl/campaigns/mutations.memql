// campaigns domain -- caller-scoped writes.
//
// Authz tier: owned. Every mutation stamps ownerUserId from actor.userId,
// never from a caller argument, so a caller can neither create a row owned by
// somebody else nor reassign an existing row's owner. Every update re-stamps
// it for the same reason: an update that omitted it would leave the field to
// the read-merge, and a row whose ownership depends on a merge is a row whose
// ownership can drift.
//
// THE SENDING WRITES ARE HERE NOW (memql#3348), and they are split from the
// operator-facing ones above by WHO CALLS THEM rather than by what they touch:
//
//   - `startCampaign` / `pauseCampaign` / `resumeCampaign` move the campaign
//     through its send lifecycle. An operator triggers them, but only ever
//     through the `campaignStartSend` / `campaignPauseSend` /
//     `campaignResumeSend` builtins, which do the preflight the operator
//     cannot (is a sender configured, is one-click unsubscribe configured, is
//     the audience within the ceiling) and enqueue the engine's own job row.
//   - `recordCampaignDelivery` and `updateCampaignProgress` are written BY THE
//     DRAIN WORKER, running under the campaign owner's actor. They are ordinary
//     owned-tier mutations for exactly that reason: the worker borrows the
//     owner's identity rather than out-ranking it, so `ownerUserId` is stamped
//     from `actor.userId` here like everywhere else in this file. That is what
//     makes v1:campaigns:delivery's declared owner tier true, and it is what
//     took the concept off the owner-stamping gate's exemption list.
//   - `enqueueCampaignSend` / `updateSendJob` / `recordSuppression` write the
//     two clusterOwner-tier engine concepts. They take no actor: their rows
//     have no owner, and reaching them at all requires the engine's own
//     operator identity.
//
// `scheduleCampaign` NO LONGER records an intent nothing acts on (memql#3459).
// It is still an ordinary owned-tier write of the time and the status -- but it
// is now reached through the `campaignScheduleSend` builtin, which does the same
// preflight `campaignStartSend` does and enqueues a `scheduled` send job the
// worker will promote when the time comes. Calling this mutation directly still
// works and still moves the campaign to `scheduled`; what it will not do on its
// own is create the job, so a campaign scheduled that way waits for a hand on
// Start. The builtin is the path the portal takes and the one to document.

/// Create an audience owned by the caller. Owned: ownerUserId is stamped from actor.userId, so a
/// caller can only ever create their own audiences.
@actor
mutate audience createAudience {
  args {
    audienceId   string!
    name         string!
    description  string
    accountId    string
  }
  insert {
    accept { name, description, accountId }
    stamp {
      id: args.audienceId
      ownerUserId: actor.userId
      status: "active"
    }
  }
}

/// Archive an audience: keep it (and every delivery record naming it) readable, but drop it out of
/// the campaign editor's picker. Owned -- ownerUserId is re-stamped from actor.userId, and the
/// engine's row-authz write guard refuses the update outright when the target row's owner is
/// somebody else.
@actor
mutate audience archiveAudience {
  args {
    audienceId  string!
  }
  update {
    id: args.audienceId
    ownerUserId: actor.userId
    status: "archived"
  }
}

/// Add one address to an audience. Owned. source defaults to 'manual' via ?? rather than via the
/// concept's @default, which is never applied on insert.
@actor
mutate recipient addRecipient {
  args {
    recipientId  string!
    audienceId   string!
    email        string!
    displayName  string
    fields       object
    source       string
  }
  insert {
    accept { audienceId, email, displayName, fields }
    stamp {
      id: args.recipientId
      ownerUserId: actor.userId
      subscriptionStatus: "subscribed"
      source: args.source ?? "manual"
    }
  }
}

/// Change one recipient's subscription state -- the write behind an operator honouring an
/// unsubscribe by hand, and the write a future unsubscribe endpoint will reuse. Owned.
///
/// unsubscribedAt is threaded by the caller rather than stamped from `now`, because this same
/// mutation records a state change that HAPPENED EARLIER (a bounce report processed hours later,
/// an unsubscribe forwarded by support) and stamping the clock would date every one of those to
/// the moment the operator got round to it.
@actor
mutate recipient setRecipientSubscription {
  args {
    recipientId         string!
    subscriptionStatus  string!
    unsubscribedAt      datetime
  }
  update {
    accept { subscriptionStatus, unsubscribedAt }
    stamp {
      id: args.recipientId
      ownerUserId: actor.userId
    }
  }
}

/// Create an email template owned by the caller. Lands as a draft; an operator marks it ready with
/// updateTemplate once the copy is finished. Owned.
@actor
mutate template createTemplate {
  args {
    templateId  string!
    name        string!
    subject     string!
    textBody    string!
    htmlBody    string
    accountId   string
  }
  insert {
    accept { name, subject, textBody, htmlBody, accountId }
    stamp {
      id: args.templateId
      ownerUserId: actor.userId
      status: "draft"
    }
  }
}

/// Edit a template's copy or move it along its lifecycle (draft -> ready -> archived). Owned.
@actor
mutate template updateTemplate {
  args {
    templateId  string!
    name        string!
    subject     string!
    textBody    string!
    htmlBody    string
    status      string
    accountId   string
  }
  update {
    accept { name, subject, textBody, htmlBody, status, accountId }
    stamp {
      id: args.templateId
      ownerUserId: actor.userId
    }
  }
}

/// Create a campaign: one audience, one template, an optional intended time. Lands as a draft with
/// its counters zeroed. Owned.
@actor
mutate campaign createCampaign {
  args {
    campaignId   string!
    name         string!
    audienceId   string!
    templateId   string!
    fromName          string
    replyTo           string
    scheduledAt       datetime
    accountId         string
    senderIdentityId  string
    trackOpens        bool
    trackClicks       bool
  }
  insert {
    accept { name, audienceId, templateId, fromName, replyTo, scheduledAt, accountId, senderIdentityId }
    stamp {
      id: args.campaignId
      ownerUserId: actor.userId
      status: "draft"
      recipientCount: 0
      sentCount: 0
      failedCount: 0
      skippedCount: 0
      trackOpens: args.trackOpens ?? true
      trackClicks: args.trackClicks ?? true
    }
  }
}

/// Edit a draft campaign's authoring fields. Deliberately does NOT accept status or any send-state
/// field: lifecycle moves through scheduleCampaign / cancelCampaign, and the counters belong to the
/// sending engine. Owned.
@actor
mutate campaign updateCampaign {
  args {
    campaignId   string!
    name         string!
    audienceId   string!
    templateId   string!
    fromName          string
    replyTo           string
    scheduledAt       datetime
    accountId         string
    senderIdentityId  string
    trackOpens        bool
    trackClicks       bool
  }
  update {
    accept { name, audienceId, templateId, fromName, replyTo, scheduledAt, accountId, senderIdentityId, trackOpens, trackClicks }
    stamp {
      id: args.campaignId
      ownerUserId: actor.userId
    }
  }
}

/// Commit a campaign to a time. Owned.
///
/// scheduledAt written here is THE AUTHORITY on when the send fires (memql#3459) -- the drain worker
/// re-reads this row rather than trusting the copy it stamped on the send job, so moving the date
/// moves the send. What this mutation does not do by itself is create the job the worker scans;
/// `campaignScheduleSend` does both, and is the path the portal takes.
/// SCOPING TO actor.userId IS NOT THE FIX HERE, and that is why the annotation is @serverOnly
/// rather than a tighter filter. These rows are ALREADY owner-scoped -- ownerUserId is stamped
/// from actor.userId on every write, so a caller can only ever reach their own campaign. The
/// problem is not WHOSE row is being written, it is that a caller may not perform this transition
/// at all: a browser flipping status to "sending" with no send job behind it, or stamping counters
/// for deliveries that never happened, desyncs the row from the engine while owning it perfectly.
/// The builtins do the authorization (an owned-tier read under the caller's own actor) and then the
/// preflight; this write is the last step of that, not an operation of its own.
@actor
@serverOnly
mutate campaign scheduleCampaign {
  args {
    campaignId   string!
    scheduledAt  datetime!
  }
  update {
    accept { scheduledAt }
    stamp {
      id: args.campaignId
      ownerUserId: actor.userId
      status: "scheduled"
    }
  }
}

/// Cancel a campaign. Terminal by intent: a cancelled campaign is kept for its history rather than
/// deleted, and re-running it means authoring a new one. Owned.
@actor
mutate campaign cancelCampaign {
  args {
    campaignId  string!
  }
  update {
    id: args.campaignId
    ownerUserId: actor.userId
    status: "cancelled"
  }
}

// ---------------------------------------------------------------------------
// The sending writes (memql#3348).

/// Move a campaign into the sending state and stamp when the run began. Called by the
/// `campaignStartSend` builtin AFTER it has read the campaign under the caller's own actor, which is
/// where the ownership check actually happens; this mutation re-stamps ownerUserId anyway, because a
/// write whose ownership depends on a read-merge is a write whose ownership can drift. Owned.
/// SCOPING TO actor.userId IS NOT THE FIX HERE, and that is why the annotation is @serverOnly
/// rather than a tighter filter. These rows are ALREADY owner-scoped -- ownerUserId is stamped
/// from actor.userId on every write, so a caller can only ever reach their own campaign. The
/// problem is not WHOSE row is being written, it is that a caller may not perform this transition
/// at all: a browser flipping status to "sending" with no send job behind it, or stamping counters
/// for deliveries that never happened, desyncs the row from the engine while owning it perfectly.
/// The builtins do the authorization (an owned-tier read under the caller's own actor) and then the
/// preflight; this write is the last step of that, not an operation of its own.
@actor
@serverOnly
mutate campaign startCampaign {
  args {
    campaignId  string!
  }
  update {
    id: args.campaignId
    ownerUserId: actor.userId
    status: "sending"
    startedAt: now
    lastError: ""
  }
}

/// Pause a running send. The delivery ledger is untouched, which is the whole point: a paused
/// campaign resumes exactly where it stopped because "where it stopped" is the set of recipients
/// with no delivery row, not a cursor that could go stale. Owned.
/// SCOPING TO actor.userId IS NOT THE FIX HERE, and that is why the annotation is @serverOnly
/// rather than a tighter filter. These rows are ALREADY owner-scoped -- ownerUserId is stamped
/// from actor.userId on every write, so a caller can only ever reach their own campaign. The
/// problem is not WHOSE row is being written, it is that a caller may not perform this transition
/// at all: a browser flipping status to "sending" with no send job behind it, or stamping counters
/// for deliveries that never happened, desyncs the row from the engine while owning it perfectly.
/// The builtins do the authorization (an owned-tier read under the caller's own actor) and then the
/// preflight; this write is the last step of that, not an operation of its own.
@actor
@serverOnly
mutate campaign pauseCampaign {
  args {
    campaignId  string!
  }
  update {
    id: args.campaignId
    ownerUserId: actor.userId
    status: "paused"
  }
}

/// Resume a paused send. Deliberately does NOT re-stamp startedAt -- the gap between startedAt and
/// completedAt is the number a deliverability review reads as "how long did this run take", and
/// resetting it on every resume would erase the pause it is meant to reveal. Owned.
/// SCOPING TO actor.userId IS NOT THE FIX HERE, and that is why the annotation is @serverOnly
/// rather than a tighter filter. These rows are ALREADY owner-scoped -- ownerUserId is stamped
/// from actor.userId on every write, so a caller can only ever reach their own campaign. The
/// problem is not WHOSE row is being written, it is that a caller may not perform this transition
/// at all: a browser flipping status to "sending" with no send job behind it, or stamping counters
/// for deliveries that never happened, desyncs the row from the engine while owning it perfectly.
/// The builtins do the authorization (an owned-tier read under the caller's own actor) and then the
/// preflight; this write is the last step of that, not an operation of its own.
@actor
@serverOnly
mutate campaign resumeCampaign {
  args {
    campaignId  string!
  }
  update {
    id: args.campaignId
    ownerUserId: actor.userId
    status: "sending"
  }
}

/// Stamp send progress onto the campaign row. Written by the drain worker under the campaign
/// owner's actor, once per batch and once at completion, so the portal's campaign list shows live
/// counters without aggregating the ledger per row. Owned -- ownerUserId is re-stamped from
/// actor.userId, so the worker can only ever write this onto a campaign it was authorized to read.
///
/// Distinct from `updateCampaign`, which is the operator's authoring write and deliberately refuses
/// to accept status or any counter. The two never overlap in what they accept.
/// SCOPING TO actor.userId IS NOT THE FIX HERE, and that is why the annotation is @serverOnly
/// rather than a tighter filter. These rows are ALREADY owner-scoped -- ownerUserId is stamped
/// from actor.userId on every write, so a caller can only ever reach their own campaign. The
/// problem is not WHOSE row is being written, it is that a caller may not perform this transition
/// at all: a browser flipping status to "sending" with no send job behind it, or stamping counters
/// for deliveries that never happened, desyncs the row from the engine while owning it perfectly.
/// The builtins do the authorization (an owned-tier read under the caller's own actor) and then the
/// preflight; this write is the last step of that, not an operation of its own.
@actor
@serverOnly
mutate campaign updateCampaignProgress {
  args {
    campaignId      string!
    status          string
    recipientCount  int
    sentCount       int
    skippedCount    int
    failedCount     int
    lastError       string
    completedAt     datetime
  }
  update {
    accept { status, recipientCount, sentCount, skippedCount, failedCount, lastError, completedAt }
    stamp {
      id: args.campaignId
      ownerUserId: actor.userId
    }
  }
}

/// Record one recipient's outcome for one campaign. THE writer memql#3348 exists to supply: it is
/// what stamps v1:campaigns:delivery's declared owner field from the actor, and its absence is why
/// that concept sat on the owner-stamping gate's exemption list.
///
/// THE ID IS DERIVED, NOT PASSED, and that is the idempotency mechanism rather than a convenience.
/// (campaignId, recipientId) hashes to exactly one row id, so a resumed, restarted or double-claimed
/// send writes a new VERSION of the same row instead of a second delivery -- the ledger cannot
/// double-count and the worker cannot double-mail, because the row's existence is what removes the
/// recipient from the next batch. Each part is hashed before concatenation (authoring rule 20), so no
/// separator in a caller-supplied id can make two different pairs collide onto one timeline.
///
/// Owned: ownerUserId is stamped from actor.userId. The worker runs this under the CAMPAIGN OWNER'S
/// actor, so the value is the campaign's owner and no caller can name a different one.
/// SCOPING TO actor.userId IS NOT THE FIX HERE, and that is why the annotation is @serverOnly
/// rather than a tighter filter. These rows are ALREADY owner-scoped -- ownerUserId is stamped
/// from actor.userId on every write, so a caller can only ever reach their own campaign. The
/// problem is not WHOSE row is being written, it is that a caller may not perform this transition
/// at all: a browser flipping status to "sending" with no send job behind it, or stamping counters
/// for deliveries that never happened, desyncs the row from the engine while owning it perfectly.
/// The builtins do the authorization (an owned-tier read under the caller's own actor) and then the
/// preflight; this write is the last step of that, not an operation of its own.
@actor
@serverOnly
mutate delivery recordCampaignDelivery {
  args {
    campaignId         string!
    recipientId        string!
    email              string!
    status             enum("pending", "sent", "failed", "skipped")!
    skipReason         string
    lastError          string
    sentAt             datetime
    attempts           int
    nextAttemptAt      datetime
    outboundRequestId  string
  }
  insert {
    accept { campaignId, recipientId, email, status, skipReason, lastError, sentAt, nextAttemptAt, outboundRequestId }
    stamp {
      id: hash(concat(
        hash(canonicalId(args.campaignId, campaign)),
        hash(canonicalId(args.recipientId, recipient))
      ))
      ownerUserId: actor.userId
      attempts: args.attempts ?? 0
    }
  }
}

/// ENGINE: enqueue a send run. One row per campaign, id = the campaign's bare short id, so a restart
/// lands on the same timeline rather than accumulating runs.
///
/// campaignOwnerUserId is the field that decides whose authority the worker borrows, so it is worth
/// being explicit about where it comes from: the `campaignStartSend` builtin reads the campaign row
/// UNDER THE CALLER'S OWN ACTOR and copies the owner off that row. A caller can therefore only ever
/// enqueue a job naming a user they could already act as -- the owned-tier read IS the authorization.
/// Nothing in this mutation's arguments is trusted to say who owns anything.
///
/// `status` exists so ONE mutation covers both ways a job is created (memql#3459): 'queued' for a
/// send starting now, 'scheduled' for one committed to a time. It defaults to 'queued' via ?? rather
/// than being required, so every existing caller is unchanged and the shortest spelling is still the
/// one that sends now. A 'scheduled' job is inert until the worker promotes it.
///
/// clusterOwner tier, so no actor and no owner stamp: these rows have no owner, and reaching them at
/// all requires the engine's own operator identity.
mutate sendJob enqueueCampaignSend {
  args {
    campaignId           string!
    campaignOwnerUserId  string!
    audienceId           string!
    templateId           string!
    status               string
    scheduledAt          datetime
  }
  insert {
    accept { campaignId, campaignOwnerUserId, audienceId, templateId, scheduledAt }
    stamp {
      id: args.campaignId
      status: args.status ?? "queued"
      recipientCount: 0
      sentCount: 0
      skippedCount: 0
      failedCount: 0
      lastError: ""
      throttledUntil: ""
    }
  }
}

/// ENGINE: stamp a send job's progress or lifecycle transition. Called by the drain worker after
/// each batch and on every terminal outcome. clusterOwner tier.
mutate sendJob updateSendJob {
  args {
    sendJobId       string!
    status          string
    recipientCount  int
    sentCount       int
    skippedCount    int
    failedCount     int
    lastError       string
    startedAt         datetime
    completedAt       datetime
    throttledUntil    datetime
    rosterCursor      string
    rosterOutstanding bool
  }
  update {
    accept { status, recipientCount, sentCount, skippedCount, failedCount, lastError, startedAt, completedAt, throttledUntil, rosterCursor, rosterOutstanding }
    stamp {
      id: args.sendJobId
    }
  }
}

/// ENGINE: add an address to the cluster-wide do-not-mail list. The argument is the SHA-256 hex
/// digest of the normalized address -- the address itself never reaches this mutation, which is what
/// makes a cluster-wide list safe to keep. The digest is the row id, so re-suppressing an address
/// appends a version to the same row rather than creating a second one, and the newest reason wins.
///
/// suppressedAt is stamped from the engine clock rather than threaded by the caller. That is the
/// opposite of `setRecipientSubscription`, and deliberately: a recipient's unsubscribedAt can
/// legitimately record something that happened hours earlier, but a suppression takes effect when it
/// is written and dating it earlier would claim a protection that was not in force.
///
/// clusterOwner tier: a caller who could write this could silently suppress a competitor's audience.
mutate suppression recordSuppression {
  args {
    emailDigest       string!
    reason            enum("unsubscribed", "hard_bounce", "complaint", "manual")!
    domain            string
    sourceCampaignId  string
    note              string
  }
  insert {
    accept { reason, domain, sourceCampaignId, note }
    stamp {
      id: args.emailDigest
      suppressedAt: now
    }
  }
}

/// ENGINE: write one replica's counters for one (sending identity, domain, day) bucket (memql#3462).
///
/// ABSOLUTE VALUES, NOT INCREMENTS, and that is the whole concurrency design. Each worker accumulates
/// in memory and writes the running total for its OWN row, so there is no read-modify-write on the
/// send path and no interleaving to lose counts to. Two replicas never touch one row; a reader sums
/// across nodeIds, which it was going to do across domains and days regardless.
///
/// The id is derived from (sendingIdentity, domain, windowStart, nodeId), each part hashed before
/// concatenation (authoring rule 20) so no separator in a domain can alias two buckets onto one
/// timeline. A re-write appends a version to the same row, which is what makes "write the running
/// total" correct rather than duplicating.
///
/// clusterOwner tier: these are the deployment's numbers, not an operator's.
mutate reputationWindow recordReputationWindow {
  args {
    sendingIdentity  string!
    domain           string!
    windowStart      string!
    nodeId           string!
    accepted         int
    hardBounce       int
    softBounce       int
    complaint        int
  }
  insert {
    accept { sendingIdentity, domain, windowStart, nodeId }
    stamp {
      id: hash(concat(hash(args.sendingIdentity), hash(args.domain), hash(args.windowStart), hash(args.nodeId)))
      accepted: args.accepted ?? 0
      hardBounce: args.hardBounce ?? 0
      softBounce: args.softBounce ?? 0
      complaint: args.complaint ?? 0
    }
  }
}

/// ENGINE: record what the warming ramp just decided and why (memql#3462). One row per sending
/// identity, id = the identity, so a restart or a second replica lands on the same timeline rather
/// than starting a competing ramp.
///
/// `reason` is written on every evaluation including the ones that change nothing, because "held" is
/// the ramp's common state and an operator seeing a step that has not moved for two days needs to
/// read why rather than guess.
///
/// clusterOwner tier.
mutate warmupState recordWarmupState {
  args {
    sendingIdentity  string!
    step             int
    ratePerMinute    int
    decision         string
    reason           string
    evaluatedAt      datetime
    stepEnteredAt    datetime
    acceptedInStep   int
  }
  insert {
    accept { sendingIdentity, decision, reason, evaluatedAt, stepEnteredAt }
    stamp {
      id: args.sendingIdentity
      step: args.step ?? 0
      ratePerMinute: args.ratePerMinute ?? 0
      acceptedInStep: args.acceptedInStep ?? 0
    }
  }
}

/// Append a consent grant. No update path exists on consentEvent -- a later
/// withdraw is a new row. Owned: ownerUserId is stamped from actor.userId.
@actor
mutate consentEvent recordConsentGrant {
  args {
    eventId      string!
    emailDigest  string!
    source       string!
    occurredAt   datetime
    recipientId  string
    campaignId   string
  }
  insert {
    accept { emailDigest, source, recipientId, campaignId }
    stamp {
      id: args.eventId
      ownerUserId: actor.userId
      kind: "grant"
      occurredAt: args.occurredAt ?? now
    }
  }
}

/// Append a consent withdraw (unsubscribe / opt-out). Append-only.
@actor
mutate consentEvent recordConsentWithdraw {
  args {
    eventId      string!
    emailDigest  string!
    source       string!
    occurredAt   datetime
    recipientId  string
    campaignId   string
  }
  insert {
    accept { emailDigest, source, recipientId, campaignId }
    stamp {
      id: args.eventId
      ownerUserId: actor.userId
      kind: "withdraw"
      occurredAt: args.occurredAt ?? now
    }
  }
}

/// Append a provider bounce event. Append-only.
@actor
mutate consentEvent recordConsentBounce {
  args {
    eventId      string!
    emailDigest  string!
    source       string!
    occurredAt   datetime
    recipientId  string
    campaignId   string
  }
  insert {
    accept { emailDigest, source, recipientId, campaignId }
    stamp {
      id: args.eventId
      ownerUserId: actor.userId
      kind: "bounce"
      occurredAt: args.occurredAt ?? now
    }
  }
}

/// Append a provider complaint event. Append-only.
@actor
mutate consentEvent recordConsentComplaint {
  args {
    eventId      string!
    emailDigest  string!
    source       string!
    occurredAt   datetime
    recipientId  string
    campaignId   string
  }
  insert {
    accept { emailDigest, source, recipientId, campaignId }
    stamp {
      id: args.eventId
      ownerUserId: actor.userId
      kind: "complaint"
      occurredAt: args.occurredAt ?? now
    }
  }
}

/// Append a suppression event. reason is required -- a suppress without a
/// reason is inexpressible on this path. Send-time suppression list is
/// unchanged (recordSuppression).
@actor
mutate consentEvent recordConsentSuppress {
  args {
    eventId      string!
    emailDigest  string!
    source       string!
    reason       string!
    occurredAt   datetime
    recipientId  string
    campaignId   string
  }
  insert {
    accept { emailDigest, source, reason, recipientId, campaignId }
    stamp {
      id: args.eventId
      ownerUserId: actor.userId
      kind: "suppress"
      occurredAt: args.occurredAt ?? now
    }
  }
}

// ---------------------------------------------------------------------------
// Sending identities (memql#4821)
// ---------------------------------------------------------------------------

/// Declare a mailbox this deployment may send campaign mail as. Owned: ownerUserId is stamped from
/// actor.userId, so a caller can only ever declare their own.
///
/// NO CREDENTIAL CROSSES THIS BOUNDARY, which is why it is an ordinary client-reachable mutation
/// rather than a @serverOnly one. Authentication stays the cluster's single Graph credential; this
/// row says a mailbox exists and may be used. What it CANNOT do is make a mailbox sendable -- that
/// is the tenant's ApplicationAccessPolicy, and an address declared here but missing from that group
/// surfaces as Graph's own 403 on the campaign's lastError. The engine validates the address for RFC
/// shape and header safety before it is stored: it becomes a From header and a URL path segment, and
/// a CR or LF in it would be header injection into every message the identity ever sends.
@actor
mutate senderIdentity createSenderIdentity {
  args {
    senderIdentityId  string!
    address           string!
    fromName          string!
    replyTo           string
    accountId         string
    notes             string
  }
  insert {
    accept { address, fromName, replyTo, accountId, notes }
    stamp {
      id: args.senderIdentityId
      ownerUserId: actor.userId
      status: "active"
    }
  }
}

/// Edit a sending identity's presentation and tie. Deliberately does not accept `status`:
/// enabling and disabling an identity is a deliverability decision with a send-time consequence, and
/// `setSenderIdentityStatus` is the call that makes it, so the two never overlap in what they accept.
@actor
mutate senderIdentity updateSenderIdentity {
  args {
    senderIdentityId  string!
    address           string!
    fromName          string!
    replyTo           string
    accountId         string
    notes             string
  }
  update {
    accept { address, fromName, replyTo, accountId, notes }
    stamp {
      id: args.senderIdentityId
      ownerUserId: actor.userId
    }
  }
}

/// Enable or retire a sending identity. Retiring is a status flip and never a delete: past campaigns
/// name the row, and the reputation and warmup history are keyed on its address, so deleting it
/// would orphan the evidence a deliverability review is made of.
@actor
mutate senderIdentity setSenderIdentityStatus {
  args {
    senderIdentityId  string!
    status            string!
  }
  update {
    accept { status }
    stamp {
      id: args.senderIdentityId
      ownerUserId: actor.userId
    }
  }
}

// ---------------------------------------------------------------------------
// Engagement (memql#4823)
// ---------------------------------------------------------------------------

/// Record one open or click. @serverOnly, and that is the whole security posture of the tracking
/// endpoints: the HTTP callers are an unauthenticated mail client and an unauthenticated browser, so
/// the ONLY thing between them and this row is the signed token the handler verifies first, plus the
/// fact that nothing client-reachable can call this at all. The write runs under internal origin
/// from the handler's Go, having derived every argument from the token's signed payload rather than
/// from the request.
///
/// The id is derived from (deliveryId, kind, occurredAt) so a retried image fetch inside the same
/// second collapses onto one row instead of inflating the total. Per-part hashed, because a
/// separator that can appear inside a part is a separator two distinct events can forge a collision
/// across (authoring rule 20).
/// SCOPING TO actor.userId IS NOT THE FIX: there is no actor to scope by. The HTTP callers are an
/// unauthenticated mail client fetching an image and an unauthenticated browser following a
/// redirect, so actor.userId is empty for every legitimate call, and a self-scoped filter would
/// match nothing while looking correct. The owner comes out of the signed token, not the request.
@actor
@serverOnly
mutate engagementEvent recordEngagementEvent {
  args {
    campaignId  string!
    deliveryId  string!
    kind        string!
    url         string
    occurredAt  datetime
  }
  insert {
    accept { campaignId, deliveryId, kind, url }
    stamp {
      id: hash(concat(
        hash(canonicalId(args.deliveryId, delivery)),
        hash(args.kind),
        hash(args.occurredAt ?? now)
      ))
      ownerUserId: actor.userId
      occurredAt: args.occurredAt ?? now
    }
  }
}

// ---------------------------------------------------------------------------
// Event-email rules (memql#4829)
// ---------------------------------------------------------------------------

/// Author an event-email rule. Lands as a draft: nothing runs until it is generated and activated,
/// so writing this row can never by itself mail anybody -- the same "the row existing is not
/// permission to send" stance v1:campaigns:sendJob's `scheduled` status takes.
@actor
mutate emailRule createEmailRule {
  args {
    emailRuleId       string!
    name              string!
    description       string
    triggerConcept    string!
    eventKind         string!
    condition         string
    templateId        string!
    recipientMode     string!
    recipientRoles    array
    audienceId        string
    recipientField    string
    accountId         string
    senderIdentityId  string
  }
  insert {
    accept { name, description, triggerConcept, eventKind, condition, templateId,
             recipientMode, recipientRoles, audienceId, recipientField, accountId, senderIdentityId }
    stamp {
      id: args.emailRuleId
      ownerUserId: actor.userId
      status: "draft"
      firedCount: 0
    }
  }
}

/// Edit a rule's form. Does NOT accept status, the generated refs or the error: those are the
/// engine's account of what it made of the form, and a caller who could write them could claim a
/// rule was active with nothing behind it.
@actor
mutate emailRule updateEmailRule {
  args {
    emailRuleId       string!
    name              string!
    description       string
    triggerConcept    string!
    eventKind         string!
    condition         string
    templateId        string!
    recipientMode     string!
    recipientRoles    array
    audienceId        string
    recipientField    string
    accountId         string
    senderIdentityId  string
  }
  update {
    accept { name, description, triggerConcept, eventKind, condition, templateId,
             recipientMode, recipientRoles, audienceId, recipientField, accountId, senderIdentityId }
    stamp {
      id: args.emailRuleId
      ownerUserId: actor.userId
    }
  }
}

/// Record what the generator and the activation pipeline made of a rule -- the bundle and construct
/// it produced, the resulting status, and the engine's own sentence when it refused. @serverOnly:
/// the whole value of these fields is that they are the ENGINE's account rather than a claim, and a
/// caller who could set status:"active" would be asserting a live automation that does not exist.
/// SCOPING TO actor.userId IS NOT THE FIX: the row is already owner-scoped and the caller IS the
/// owner. What must not be caller-writable is the CLAIM these fields make -- that a construct was
/// generated, that activation succeeded, that the rule has fired N times. An owner who could set
/// status:"active" would be asserting a live automation that does not exist, and one who could set
/// firedCount would be editing the evidence. The rule's FORM stays client-writable next door.
@actor
@serverOnly
mutate emailRule recordEmailRuleGeneration {
  args {
    emailRuleId    string!
    status         string!
    bundleId       string
    constructName  string
    lastError      string
  }
  update {
    accept { status, bundleId, constructName, lastError }
    stamp {
      id: args.emailRuleId
      ownerUserId: actor.userId
    }
  }
}

/// Stamp that a rule fired. @serverOnly for the same reason the campaign counters are: it is the
/// engine's observation, and these two fields are the rule's LIVENESS -- they move on their own, so
/// a surface that fingerprints them for arrival cues turns the rules list into a strobe.
/// SCOPING TO actor.userId IS NOT THE FIX: the row is already owner-scoped and the caller IS the
/// owner. What must not be caller-writable is the CLAIM these fields make -- that a construct was
/// generated, that activation succeeded, that the rule has fired N times. An owner who could set
/// status:"active" would be asserting a live automation that does not exist, and one who could set
/// firedCount would be editing the evidence. The rule's FORM stays client-writable next door.
@actor
@serverOnly
mutate emailRule recordEmailRuleFiring {
  args {
    emailRuleId  string!
    firedCount   int!
    lastFiredAt  datetime
    lastError    string
  }
  update {
    accept { firedCount, lastError }
    stamp {
      id: args.emailRuleId
      ownerUserId: actor.userId
      lastFiredAt: args.lastFiredAt ?? now
    }
  }
}

/// Pause or resume a rule. The operator's own stop button: pausing keeps the generated construct but
/// disarms it, which is a different thing from deleting the rule and a different thing again from
/// the circuit breaker tripping -- and all three are visible as distinct statuses so nobody has to
/// guess which one happened.
@actor
mutate emailRule setEmailRuleStatus {
  args {
    emailRuleId  string!
    status       string!
  }
  update {
    accept { status }
    stamp {
      id: args.emailRuleId
      ownerUserId: actor.userId
    }
  }
}
