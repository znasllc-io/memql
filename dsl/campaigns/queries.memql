use common.traits.{ statusIsActive, statusIsPending, statusIsArchived }

// campaigns domain -- caller-scoped reads.
//
// The engine applies current organization membership and app permissions to
// organization-owned rows. Queries add selection filters without restating an
// owner-only predicate that would hide authorized peers' work. Cluster
// operators retain their standing scope; legacy untied rows use their existing
// owner rules. Caller-supplied arguments never widen this authorization scope.
//
// The by-id reads are exempt from the pagination rule by shape rather than by
// annotation: an unguarded row.id equality reads at most one row, so it is not
// a list. The list reads all declare sort + paginate.

/// The caller's campaigns, newest first. The portal's campaign list. Owned: the row set is gated by
/// `(row.ownerUserId == actor.userId || actor.isClusterOwner == true)` server-side for legacy untied rows; organization-owned rows follow current membership and app permissions. Optional status
/// filter narrows to one lifecycle bucket; omit it to see everything.
@actor
query campaign campaigns {
  args {
    status  string
  }
  filter    row => true
                && (row.testSourceCampaignId == nil || row.testSourceCampaignId == "")
                && (args.status == nil || row.status == args.status)
  sort      "row.createdAt", "desc"
  paginate  50
  shape     campaignFull
}

/// One authorized campaign by id. Organization members share its editor. Legacy untied rows use: `(row.ownerUserId == actor.userId || actor.isClusterOwner == true)`
/// is the load-bearing guard, so a caller cannot read another operator's campaign even with its id.
@actor
query campaign campaignById {
  args {
    campaignId  string!
  }
  filter  row => row.id == args.campaignId
  shape   campaignFull
}

/// The caller's audiences, newest first. Backs the audience list and the campaign editor's audience
/// picker. Owned.
@actor
query audience audiences {
  args {
    status  string
  }
  filter    row => true
                && (args.status == nil || row.status == args.status)
  sort      "row.createdAt", "desc"
  paginate  50
  shape     audienceFull
}

/// One audience by id, gated to its owner. Owned.
@actor
query audience audienceById {
  args {
    audienceId  string!
  }
  filter  row => row.id == args.audienceId
  shape   audienceFull
}

/// The caller's templates, newest first, as summaries: no body and no document. Backs the template
/// list and the campaign editor's template picker; a template's content is read with templateById.
/// Owned.
@actor
query template templates {
  args {
    status  string
  }
  filter    row => true
                && (args.status == nil || row.status == args.status)
  sort      "row.createdAt", "desc"
  paginate  50
  shape     templateSummary
}

/// One template by id, gated to its owner. Backs the template editor and the campaign editor's
/// preview. Owned.
@actor
query template templateById {
  args {
    templateId  string!
  }
  filter  row => row.id == args.templateId
  shape   templateFull
}

/// The template an organization published from one Library file, for campaignSaveTemplate and the
/// editors that open a file: publishing a file again updates this template, so there is one per
/// organization and file. It answers the template's id and its revision (createdAt) and nothing of
/// its content, which templateById reads. Newest first and one row, so a stray duplicate can never
/// make a save ambiguous. The concept's account tier answers a template outside the caller's
/// organizations as not found, so the file id is not a way into somebody else's templates. Owned.
@actor
query template templateForSource {
  args {
    accountId         string!
    sourceArtifactId  string!
  }
  filter    row => row.accountId == args.accountId
                && row.sourceArtifactId == args.sourceArtifactId
  sort      "row.createdAt", "desc"
  paginate  1
  shape     templateRef
}

/// One email layout by id, for the organization's members. Backs the revision check
/// campaignSaveLayout makes and the editors that open a saved layout. The id is not a capability:
/// the concept's account tier answers a layout outside the caller's organizations as not found.
@actor
query emailLayout emailLayoutById {
  args {
    layoutId  string!
  }
  filter  row => row.id == args.layoutId
  shape   emailLayoutFull
}

/// An organization's email layouts, newest first. Backs the layout picker (through the emailLayouts
/// builtin) and the Email app's Templates section. status narrows to active or archived layouts;
/// omit it to see both.
@actor
query emailLayout emailLayoutsForAccount {
  args {
    accountId  string!
    status     string
  }
  filter    row => row.accountId == args.accountId
                && (args.status == nil || row.status == args.status)
  sort      "row.createdAt", "desc"
  paginate  100
  shape     emailLayoutFull
}

/// Every recipient in one of the caller's audiences, newest first -- including suppressed ones, which
/// is the point: an operator reviewing an audience needs to see the unsubscribes and bounces, not a
/// filtered view that makes them invisible. Owned, and the projection carries @pii fields, so the
/// caller conjunct is doubly load-bearing here.
@actor
query recipient recipientsForAudience {
  args {
    audienceId  string!
  }
  filter    row => true
                && row.audienceId == args.audienceId
  sort      "row.createdAt", "desc"
  paginate  100
  shape     recipientFull
}

/// The subset of an audience a send would actually reach: subscribed addresses only. Distinct from
/// recipientsForAudience because the difference between the two counts IS the suppression rate, and
/// an operator about to schedule a campaign wants both numbers. Owned; @pii projection.
@actor
query recipient sendableRecipientsForAudience {
  args {
    audienceId  string!
  }
  filter    row => true
                && row.audienceId == args.audienceId
                && isSendableRecipient(row)
  sort      "row.createdAt", "desc"
  paginate  100
  shape     recipientFull
}

/// Per-recipient outcomes for one campaign, newest first. Written by the drain worker as it works
/// through the audience (memql#3348), so an operator watching a live send sees the ledger fill in.
/// Owned; @pii projection.
@actor
query delivery deliveriesForCampaign {
  args {
    campaignId  string!
  }
  filter    row => true
                && row.campaignId == args.campaignId
  sort      "row.createdAt", "desc"
  paginate  100
  shape     deliveryFull
}

// ---------------------------------------------------------------------------
// The sending engine's own reads (memql#3348).
//
// Two different callers, two different actors, and the split is deliberate.
//
// The three ENGINE reads below (drainableSendJobs / sendJobById /
// suppressionByDigest) bind clusterOwner-tier concepts and are issued by the
// drain worker under the engine's own operator identity. They name
// `actor.isClusterOwner==true` explicitly even though the tier already injects
// it, because a reader auditing this file should not have to know that
// enforcement exists to see that the read is gated (the telephony admin reads
// set the same precedent).
//
// The two OWNED reads (audienceRosterForSend / deliveryLedgerForCampaign) are
// issued by that same worker under the CAMPAIGN OWNER'S actor. Current
// organization membership and app permissions constrain these reads, so the
// worker gets exactly the owner's authority and no more. That is why the
// engine needs no bypass anywhere: it borrows an identity rather than
// out-ranking one.

/// ENGINE: send jobs the drain worker still has work to do on, oldest first so a long-queued
/// campaign is not starved by a newer one. Cluster-owner gated -- this is the one read in the domain
/// that deliberately spans owners, which is exactly why it may only be issued by the engine's own
/// operator identity and why the row it returns carries no recipient data.
@actor
query sendJob drainableSendJobs {
  filter    row => isDrainableSendJob(row) && actor.isClusterOwner == true
  sort      "row.createdAt", "asc"
  paginate  50
  shape     sendJobFull
}

/// ENGINE: the most recent send jobs in any status, newest first. Cluster-owner gated, and it spans
/// owners for the same reason drainableSendJobs does -- the question it answers is about the cluster,
/// not about one operator. Backs one thing only: the boot-time check behind the unsubscribe-secret
/// rotation warning (memql#3458), which needs to know whether this deployment has ever put a signed
/// unsubscribe link in front of a recipient. The row carries no recipient data.
@actor
query sendJob recentSendJobs {
  filter    row => actor.isClusterOwner == true
  sort      "row.createdAt", "desc"
  paginate  200
  shape     sendJobFull
}

/// ENGINE: send jobs committed to a time and not yet fired, oldest first (memql#3459). Cluster-owner
/// gated, and it spans owners for the same reason drainableSendJobs does -- "which campaigns are due"
/// is an engine-wide scheduling question. The queue lives on engine-owned job rows, then each
/// campaign is revalidated under its recorded owner's current organization authority.
///
/// It deliberately does NOT filter on the due time. The authority on when a send fires is the
/// CAMPAIGN's scheduledAt, which an operator can move with updateCampaign without the job row
/// hearing about it -- so the worker reads every scheduled job and asks the campaign. The set is
/// small by nature (one row per pending scheduled campaign), which is what makes that affordable.
@actor
query sendJob scheduledSendJobs {
  filter    row => isScheduledSendJob(row) && actor.isClusterOwner == true
  sort      "row.createdAt", "asc"
  paginate  200
  shape     sendJobFull
}

/// ENGINE: one send job by id (the id is the campaign's bare short id). Cluster-owner gated. Read
/// after a claim so the worker acts on the row as it stands now rather than as the scan saw it.
@actor
query sendJob sendJobById {
  args {
    sendJobId  string!
  }
  filter  row => row.id == args.sendJobId && actor.isClusterOwner == true
  shape   sendJobFull
}

/// ENGINE: is this address on the cluster-wide do-not-mail list? The argument is the SHA-256 hex
/// digest of the normalized address, which is also the row id -- so this is a single-row read and a
/// caller can only ask about an address it already holds. Cluster-owner gated: the suppression list
/// is engine state, and it is checked under the engine's identity rather than the campaign owner's,
/// precisely so that no operator's authority can decide whether it applies to them.
@actor
query suppression suppressionByDigest {
  args {
    emailDigest  string!
  }
  filter  row => row.id == args.emailDigest && actor.isClusterOwner == true
  shape   suppressionFull
}

/// ENGINE: lookup an organization-scoped suppression by its server-derived composite key.
@actor
query suppression suppressionForOrganization {
  args {
    suppressionId string!
    accountId string!
  }
  filter row => row.id == args.suppressionId && row.accountId == args.accountId && actor.isClusterOwner == true
  shape suppressionFull
}

/// ENGINE (owner-scoped): ONE PAGE of the audience a send is working through, oldest first --
/// including suppressed ones, because a `skipped` delivery row is an outcome the operator is owed
/// rather than a silence. Owned, and read under the campaign owner's actor. @pii projection.
///
/// THE 500 IS A PAGE, NOT A CEILING (memql#3460). It used to be 5000 and it used to be the largest
/// audience this engine could send to: the worker read the roster WHOLE on every batch and diffed it
/// against the ledger, so anything past the bound would have been silently truncated and
/// campaignStartSend refused the send rather than mail a prefix. The worker now walks this query with
/// the engine's keyset cursor, so the roster is unbounded and the number here only decides how much
/// of it is in memory at once.
///
/// The ascending `row.createdAt` ordering is load-bearing under concurrent roster edits, which is the
/// question a cursor over versioned rows has to answer. Reads collapse to the latest version per id
/// (DISTINCT ON), so editing a recipient mid-send moves it FORWARD in this enumeration -- never
/// backward past the cursor. A row can therefore be seen twice in one pass and can never be MISSED,
/// and the worker de-duplicates within a batch. That asymmetry is the whole safety argument: a
/// duplicate costs a wasted comparison, a skip costs somebody their mail.
@actor
query recipient audienceRosterForSend {
  args {
    audienceId  string!
  }
  filter    row => true
                && row.audienceId == args.audienceId
  sort      "row.createdAt", "asc"
  paginate  500
  shape     recipientFull
}

/// ENGINE (owner-scoped): how many recipients an audience holds, as a {count, atLeast} aggregate
/// (memql#3460). Computed server-side rather than by measuring the length of a bounded read, which
/// is why the preflight and the frozen `recipientCount` use it: measuring a page and calling it a
/// total is how the 5000 ceiling came to be load-bearing in the first place. The count still reads
/// up to the engine's window: past it, `count` is the window and `atLeast` is true (memql#6033).
/// Owned.
@actor
query recipient audienceRosterSize {
  args {
    audienceId  string!
  }
  filter  row => true
              && row.audienceId == args.audienceId
  count
}

/// How many people in one audience can be mailed now, as a {count, atLeast} aggregate. Pending and
/// unsubscribed members are on the list but are not counted. The Email app's audience rows, the
/// campaign wizard and the send confirmation name this number. Past the engine's window, `count` is
/// the window and `atLeast` is true, which the Email app says as "5,000 or more" (memql#6033).
@actor
query recipient audienceSubscriberCount {
  args {
    audienceId  string!
  }
  filter  row => true
              && row.audienceId == args.audienceId
              && isSendableRecipient(row)
  count
}

/// ENGINE (owner-scoped): the delivery ledger for ONE PAGE OF RECIPIENTS, in the slim projection --
/// recipient, outcome, attempts, retry due-time and nothing else. THE read that makes a resumed send
/// safe: the worker diffs it against the roster page it just read and mails only what is missing or
/// due (memql#3460).
///
/// Bounded by the CALLER'S id list rather than by a page of its own, and that is what lets the send
/// scale. Reading the whole ledger for a campaign is exactly as unbounded as reading the whole
/// roster, so cursoring one and not the other would have moved the ceiling rather than removed it.
/// The slice of the ledger a batch needs is precisely the slice of the roster it is looking at.
///
/// recipientIds are CANONICAL ids. The relationship-canonicalizing pre-walk rewrites a bare id only
/// on a scalar comparison, not on a list, so a bare id here would compare against a stored
/// `v1:campaigns:recipient:...` and match nothing -- which would read as "nobody has been mailed"
/// and re-mail the page. The worker passes the ids exactly as the roster row returned them.
///
/// Owned, read under the campaign owner's actor. @pii-free projection.
@actor
query delivery deliveriesForRecipients {
  args {
    campaignId    string!
    recipientIds  array!
  }
  filter    row => true
                && row.campaignId == args.campaignId
                && row.recipientId in args.recipientIds
  sort      "row.createdAt", "asc"
  paginate  1000
  shape     deliveryLedgerEntry
}

/// ENGINE (owner-scoped): the delivery ledger for one campaign, oldest first, in the slim projection.
/// Retained for the operator-facing read of a whole run; the SEND path pages through
/// deliveriesForRecipients instead, because a whole-ledger read is as unbounded as a whole-roster one.
/// Owned, read under the campaign owner's actor.
@actor
query delivery deliveryLedgerForCampaign {
  args {
    campaignId  string!
  }
  filter    row => true
                && row.campaignId == args.campaignId
  sort      "row.createdAt", "asc"
  paginate  5000
  shape     deliveryLedgerEntry
}

/// ENGINE: reputation counters from a given UTC day onward, oldest first (memql#3462). The read the
/// warming ramp evaluates and the one an operator runs to answer "what is our complaint rate at
/// gmail.com this week". Cluster-owner gated, and it spans owners for the same reason the suppression
/// list does: one deployment, one sending mailbox, one reputation. The rows carry a domain and four
/// integers and no address.
///
/// windowStart is compared as a STRING because the bucket key is one -- YYYY-MM-DD orders lexically
/// exactly as it orders chronologically, which is the property that makes a string key legitimate
/// here rather than a shortcut.
@actor
query reputationWindow reputationWindowsSince {
  args {
    since  string!
  }
  filter    row => row.windowStart >= args.since && actor.isClusterOwner == true
  sort      "row.createdAt", "asc"
  paginate  5000
  shape     reputationWindowFull
}

/// ENGINE: the warming ramp's state for one sending identity (the id IS the identity). Cluster-owner
/// gated. Backs both the ramp's own evaluation and an operator asking which step it is on and why it
/// last held.
@actor
query warmupState warmupStateForIdentity {
  args {
    sendingIdentity  string!
  }
  filter  row => row.id == args.sendingIdentity && actor.isClusterOwner == true
  shape   warmupStateFull
}

/// Consent event stream for one subscriber, newest first. Export answers
/// status/date/source from these rows: current status is the latest kind.
/// The concept tier and organization boundary authorize every returned row.
@actor
query consentEvent consentEventsBySubscriber {
  args {
    emailDigest  string!
  }
  filter    row => true
                && row.emailDigest == args.emailDigest
  sort      "row.createdAt", "desc"
  paginate  50
  shape     consentEventFull
}

/// Latest consent event for one subscriber -- the derived current status.
/// Owned.
@actor
query consentEvent consentStatus {
  args {
    emailDigest  string!
  }
  filter    row => true
                && row.emailDigest == args.emailDigest
  sort      "row.createdAt", "desc"
  paginate  1
  shape     consentEventFull
}

// ---------------------------------------------------------------------------
// Sender identities (memql#4821)
// ---------------------------------------------------------------------------

/// One recipient by id.
///
/// IT EXISTS TO REMOVE A SCAN FROM A SEND PATH (memql#4829). Every other read of
/// this concept is audience-scoped, which is right for a roster and wrong for
/// the single-recipient send the marketing lane makes: that path holds a
/// recipient id and needs the row, and without this query it had to find the
/// audience first -- from the rule when one named it, and otherwise by walking
/// the caller's audiences and refusing past a bound rather than answering "not
/// found". A bounded scan standing in for a by-id read is a correct answer
/// that gets slower as an operator succeeds, and it refuses at exactly the
/// point somebody has enough audiences to care.
///
/// The tier conjunct is what keeps it safe to expose an unscoped by-id read:
/// an id is not a capability here, and a recipient outside the caller's authorized
/// organization scope is simply not found -- the same answer campaignById gives.
@actor
query recipient recipientById {
  args {
    recipientId  string!
  }
  filter  row => row.id == args.recipientId
  shape   recipientFull
}

/// The memberships for one mailbox in one audience, by address digest. Organization-authorized.
/// The digest is the SHA-256 of the address trimmed and lower-cased (recipient.emailDigest), so a
/// signup or a row-address rule finds a page of the rows a mailbox holds without walking the roster.
/// Matches are in any subscription state, oldest first: the same mailbox can hold more than one row
/// (a manual add beside an earlier row, a race), and one can have opted out while another has not.
/// A FULL page cannot rule out another opted-out row beyond it; the caller must refuse rather than
/// assume it saw every membership. A row carries a digest only if it was written
/// by addRecipient or filled in by the digest sweep, so a mailbox can also hold rows this does not
/// return: recipientsWithoutDigestInAudience is the other half. The caller checks each row's own
/// address before it believes the key; a raw write can set a digest that is not its address's.
@actor
query recipient recipientInAudienceByDigest {
  args {
    audienceId   string!
    emailDigest  string!
  }
  filter    row => row.audienceId == args.audienceId && row.emailDigest == args.emailDigest
  sort      "row.createdAt", "asc"
  paginate  50
  shape     recipientFull
}

/// One page of the rows of an audience that carry no address digest, oldest first.
/// Organization-authorized. Those are the rows written before the digest existed, by a replica still
/// running the previous release, or by a raw write, until the digest sweep fills them in. A lookup by
/// digest cannot see them, so a signup or a row-address rule reads this page too and compares each
/// row's address; a FULL page proves nothing about the rows beyond it and the caller must not read
/// it as "no such row".
@actor
query recipient recipientsWithoutDigestInAudience {
  args {
    audienceId  string!
  }
  filter    row => row.audienceId == args.audienceId && (row.emailDigest == nil || row.emailDigest == "")
  sort      "row.createdAt", "asc"
  paginate  50
  shape     recipientFull
}

/// Every sending identity the caller may use, newest first. Backs the identity picker on the
/// campaign editor and the Senders list in the OS app's Settings. Composite tier, so a cluster
/// owner sees every operator's -- which is what makes "who is this cluster mailing as"
/// answerable at all.
///
/// SORTED BY WHEN IT WAS ADDED, NOT BY ADDRESS, because the sort is also the page cursor. A
/// payload field is not keyset-eligible, so a list ordered by `address` could not continue past
/// its first page: a caller walking it past 200 identities got the first 200 and a list that
/// ended without saying so.
@actor
query senderIdentity senderIdentities {
  args {
    status  string
  }
  filter    row => true
                && (args.status == nil || row.status == args.status)
  sort      "row.createdAt", "desc"
  paginate  200
  shape     senderIdentityFull
}

/// One sending identity by id. The read the send path uses to resolve a campaign's senderIdentityId,
/// under the CAMPAIGN OWNER's borrowed actor -- so an identity the owner cannot read is an identity
/// the send refuses to use, which is the same answer as it not existing.
@actor
query senderIdentity senderIdentityById {
  args {
    senderIdentityId  string!
  }
  filter  row => row.id == args.senderIdentityId

  shape   senderIdentityFull
}

/// The sending identities filed under one account, newest first. The tie is a RECORD, not a scope:
/// this is the same read `senderIdentities` makes, narrowed by the tie field, and the tier conjunct
/// is carried verbatim rather than dropped -- copying `sitesForAccount`'s form exactly (accounts D1).
@actor
query senderIdentity senderIdentitiesForAccount {
  args {
    accountId  string!
  }
  filter  row => row.accountId == args.accountId

  shape   senderIdentityFull
  sort    "row.createdAt", "desc"
}

// ---------------------------------------------------------------------------
// Stats (memql#4823). The engine has no group-by, so an aggregate is either a
// `count` query per bucket or a Go fold over rows. Every bucket that CAN be a
// count is one: a count is exact at any audience size, while a bounded read of
// an unbounded set is a truncation wearing a number's clothes.
// ---------------------------------------------------------------------------

/// How many deliveries this campaign has in one status. The exact figure at any audience size --
/// the portal's page-capped client-side counting is what this replaces.
@actor
query delivery campaignDeliveryCountByStatus {
  args {
    campaignId  string!
    status      string!
  }
  filter  row => true
              && row.campaignId == args.campaignId
              && row.status == args.status
  count
}

/// How many of this campaign's skipped deliveries carry one of the named skip reasons. A list rather
/// than one reason per call because the skipped bucket is reported in three groups and three counts
/// beat seven round trips.
@actor
query delivery campaignSkipCountByReason {
  args {
    campaignId   string!
    skipReasons  array!
  }
  filter  row => true
              && row.campaignId == args.campaignId
              && row.status == "skipped"
              && row.skipReason in args.skipReasons
  count
}

/// TOTAL opens or clicks for a campaign -- every recorded hit, exact. The UNIQUE figure cannot be a
/// count (the engine has no DISTINCT), which is why `campaignEngagementRefs` exists beside this one.
@actor
query engagementEvent campaignEngagementCountByKind {
  args {
    campaignId  string!
    kind        string!
  }
  filter  row => true
              && row.campaignId == args.campaignId
              && row.kind == args.kind
  count
}

/// The delivery references behind a campaign's engagement events, for computing the UNIQUE figure by
/// folding in Go. Deliberately projects the reference and nothing else: this is the one read in the
/// stats path that is bounded, and a lean shape is what keeps the bound generous. A read that comes
/// back AT the bound is reported as unmeasured rather than as a number -- the ledger-page rule.
@actor
query engagementEvent campaignEngagementRefs {
  args {
    campaignId  string!
    kind        string!
  }
  filter    row => true
                && row.campaignId == args.campaignId
                && row.kind == args.kind
  sort      "row.createdAt", "desc"
  paginate  5000
  shape     engagementDeliveryRef
}

/// How many consent events of one kind this campaign produced -- the bounce, complaint and
/// one-click-withdraw figures. Read from the consent stream rather than from delivery rows because a
/// bounce arrives AFTER the transport accepted the message: the delivery says "sent" and stays that
/// way, which is correct and is why it cannot answer this.
@actor
query consentEvent campaignConsentCountByKind {
  args {
    campaignId  string!
    kind        string!
  }
  filter  row => true
              && row.campaignId == args.campaignId
              && row.kind == args.kind
  count
}

// ---------------------------------------------------------------------------
// Event-email rules (memql#4829)
// ---------------------------------------------------------------------------

/// Every event-email rule the caller may see, newest first. The row is the FORM; what runs is the
/// generated authored construct it names.
@actor
query emailRule emailRules {
  args {
    status  string
  }
  filter    row => true
                && (args.status == nil || row.status == args.status)
  sort      "row.createdAt", "desc"
  paginate  200
  shape     emailRuleFull
}

/// One event-email rule by id.
@actor
query emailRule emailRuleById {
  args {
    emailRuleId  string!
  }
  filter  row => row.id == args.emailRuleId
  shape   emailRuleFull
}

/// Internal replay check; actor.userId alone cannot make this a sending API.
@actor
@serverOnly
query singleSendReceipt campaignSingleSendById {
  args { receiptId string! }
  filter row => row.id == args.receiptId && row.ownerUserId == actor.userId
  shape campaignSingleSendFull
}

/// Current repeating instruction for this blueprint; organization authorization applies.
@actor
query campaignSeries campaignSeriesForCampaign {
  args { campaignId string! }
  filter row => row.sourceCampaignId == args.campaignId
  sort "row.createdAt", "desc"
  paginate 1
  shape campaignSeriesFull
}

/// Internal scan across organizations. actor.userId cannot scope the scheduler's work;
/// each result is locked, reread and authorized under its recorded person before use.
@actor
@serverOnly
query campaignSeries dueCampaignSeries {
  args { dueAt datetime! }
  filter row => actor.isClusterOwner == true && statusIsActive(row) && row.nextAt <= args.dueAt
  sort "row.createdAt", "asc"
  paginate 100
  shape campaignSeriesFull
}


/// Organization-authorized newsletter configuration for one deployable.
@actor
query newsletterBinding newsletterForSite {
  args { siteId string! }
  filter row => row.siteId == args.siteId
  sort "row.createdAt", "desc"
  paginate 1
  shape newsletterBindingFull
}

/// Organization-authorized deployable bindings for an audience.
@actor
query newsletterBinding newslettersForAudience {
  args { audienceId string! }
  filter row => row.audienceId == args.audienceId
  sort "row.createdAt", "desc"
  paginate 100
  shape newsletterBindingFull
}

/// Current durable signup and captured address, authorized by its organization.
@actor
query newsletterSignup newsletterSignupById {
  args { signupId string! }
  filter row => row.id == args.signupId
  shape newsletterSignupFull
}

/// Latest welcome outcomes; on-demand because signup volume is shopper-driven.
@actor
query newsletterSignup newsletterWelcomesForAudience {
  args { audienceId string! }
  filter row => row.audienceId == args.audienceId
  sort "row.createdAt", "desc"
  paginate 50
  shape newsletterSignupFull
}

/// Internal cross-organization scan. actor.userId does not identify the
/// recipients; each result is reread under its recorded person's current authority.
@actor
@serverOnly
query newsletterSignup pendingNewsletterWelcomes {
  filter row => actor.isClusterOwner == true && statusIsPending(row)
  sort "row.createdAt", "asc"
  paginate 100
  shape newsletterSignupFull
}

/// Read one prior grant so a retried public submission cannot restamp its date.
@actor
query consentEvent newsletterConsentById {
  args { eventId string! }
  filter row => row.id == args.eventId
  shape consentEventFull
}

/// Shared testing audience for the selected organization.
@actor
query testSettings campaignTestSettings {
  args { accountId string! }
  filter row => row.accountId == args.accountId
  sort "row.createdAt", "desc"
  paginate 1
  shape campaignTestSettingsFull
}

/// Recent test runs for this campaign; counters and deliveries belong to these runs alone.
@actor
query campaign campaignTestRuns {
  args { campaignId string! }
  filter row => row.testSourceCampaignId == args.campaignId
  sort "row.createdAt", "desc"
  paginate 50
  shape campaignFull
}

/// Internal scan of due single-recipient deliveries deferred by the rate limiter.
/// actor.userId scoping would omit other owners' work; internal origin and clusterOwner restrict the sweep.
@actor
@serverOnly
query delivery deferredSingleSends {
 args { dueAt datetime! }
 filter row => actor.isClusterOwner == true && statusIsPending(row) && row.requestId != nil && row.requestId != "" && row.nextAttemptAt <= args.dueAt
 sort "row.createdAt", "asc"
 paginate 100
 shape deferredSendRef
}

/// Organization-authorized email automation read.
@actor
query journey journeys {
 args {
 status string
 }
 filter row => ((args.status == nil || row.status == args.status))
 sort "row.createdAt", "asc"
 paginate 50
 shape journeyFull
}

/// Organization-authorized email automation read.
@actor
query journey journeyById {
 args {
 journeyId string!
 }
 filter row => (row.id == args.journeyId)
 shape journeyFull
}

/// Organization-authorized email automation read.
@actor
query journeyEnrollment journeyEnrollmentCounts {
 args {
 journeyId string!
 status string
 stepId string
 }
 filter row => (row.journeyId == args.journeyId && (args.status == nil || row.status == args.status) && (args.stepId == nil || row.stepId == args.stepId))
 count
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query journey activeJourneys {
 filter row => actor.isClusterOwner == true && (statusIsActive(row))
 sort "row.createdAt", "asc"
 paginate 100
 shape journeyFull
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query journey journeysToRetire {
 filter row => actor.isClusterOwner == true && (statusIsArchived(row) && (row.retiredAt == nil || row.retiredAt == ""))
 sort "row.createdAt", "asc"
 paginate 50
 shape journeyFull
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query journeyEnrollment dueEnrollmentsForJourney {
 args {
 journeyId string!
 dueAt datetime!
 }
 filter row => actor.isClusterOwner == true && (row.journeyId == args.journeyId && (statusIsActive(row) || row.status == "waiting") && row.nextAt <= args.dueAt)
 sort "row.createdAt", "asc"
 paginate 100
 shape journeyEnrollmentFull
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query journeyEnrollment openEnrollmentsForJourney {
 args {
 journeyId string!
 }
 filter row => actor.isClusterOwner == true && (row.journeyId == args.journeyId && (statusIsActive(row) || row.status == "waiting"))
 sort "row.createdAt", "asc"
 paginate 100
 shape journeyEnrollmentFull
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query journeyEnrollment newestJourneyEnrollment {
 args {
 journeyId string!
 }
 filter row => actor.isClusterOwner == true && (row.journeyId == args.journeyId)
 sort "triggeredAt", "desc"
 paginate 1
 shape journeyEnrollmentFull
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query journeyEnrollment journeyEnrollmentById {
 args {
 enrollmentId string!
 }
 filter row => actor.isClusterOwner == true && (row.id == args.enrollmentId)
 shape journeyEnrollmentFull
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query recipient audienceJoinersSince {
 args {
 audienceId string!
 since datetime!
 }
 filter row => actor.isClusterOwner == true && (row.audienceId == args.audienceId && row.joinedAt >= args.since && (isSendableRecipient(row) || row.subscriptionStatus == "pending"))
 sort "row.createdAt", "asc"
 paginate 200
 shape recipientEnrollmentRef
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query recipient audienceConfirmationsSince {
 args {
 audienceId string!
 since datetime!
 }
 filter row => actor.isClusterOwner == true && (row.audienceId == args.audienceId && row.confirmedAt >= args.since && isSendableRecipient(row))
 sort "row.createdAt", "asc"
 paginate 200
 shape recipientEnrollmentRef
}

/// Internal automation state read across all owners. actor.userId scoping would miss other owners' due work; the clusterOwner predicate and internal origin are both mandatory.
@actor
@serverOnly
query journeyEnrollment waitingEnrollmentsForRecipient {
 args {
 recipientId string!
 }
 filter row => actor.isClusterOwner == true && (row.recipientId == args.recipientId && row.status == "waiting")
 sort "row.createdAt", "asc"
 paginate 100
 shape journeyEnrollmentFull
}
