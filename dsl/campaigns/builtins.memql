@executor("integration.campaigns.campaignApplyWarmup")
builtin campaignApplyWarmup {  }

/// Bounded campaign operation within an authorized delivery scope.
@executor("integration.campaigns.campaignDrainableJobs")
builtin campaignDrainableJobs {  }

/// Bounded campaign operation within an authorized delivery scope.
@executor("integration.campaigns.campaignDrainJob")
@args(profile="object")
builtin campaignDrainJob { id string! }

/// Bounded campaign operation within an authorized delivery scope.
@executor("integration.campaigns.campaignFlushReputation")
builtin campaignFlushReputation {  }

/// Bounded campaign operation within an authorized delivery scope.
@executor("integration.campaigns.campaignProcessSelected")
@args(profile="object")
builtin campaignProcessSelected { id string! }

/// Render a published operational rule template and stage one authorized cluster recipient in the server outbox.
@executor("integration.campaigns.stageOperationalEmail")
builtin campaignStageOperationalEmail {
 requestId string!
 templateId string!
 to string!
 displayName string
 dedupeKey string!
 emailRuleId string!
}

/// Retry due single-recipient sends inside the campaign drain scope.
@executor("integration.campaigns.campaignRetryDeferredSends")
builtin campaignRetryDeferredSends { }

@sdk
@description("Save an email automation with an exact revision. Omit expectedRevision to create one under a new caller-generated id. Editable while draft or paused. Never sends mail; returns the revision and what still blocks turning it on.")
@executor("integration.campaigns.saveJourney")
builtin campaignSaveJourney {
  journeyId         string!   @description("Stable caller-generated id; reuse it after an uncertain create.")
  accountId         string!   @description("Owning organization; immutable after creation.")
  name              string!
  description       string
  trigger           object!   @description("{kind: joined | confirmed, audienceId}")
  steps             []object! @description("Ordered steps: {id, kind: send | confirm | wait, templateId?, senderIdentityId?, days?, hours?, minutes?, timeoutDays?}")
  expectedRevision  string    @description("Exact revision from journeyById; omit when creating.")
}

@sdk
@description("Turn an email automation on, pause it, or archive it. Turning on checks templates, senders and the audience first; archiving is permanent and exits everyone still in it.")
@executor("integration.campaigns.setJourneyState")
builtin campaignSetJourneyState {
  journeyId         string!
  action            enum("activate", "pause", "archive")!
  expectedRevision  string!
}

@sdk
@description("Retry email automation runs that failed. Each one starts its step again with no attempts spent; an unsubscribed or suppressed person still leaves instead of being mailed. Leave enrollmentIds empty to retry every failed run of the automation.")
@executor("integration.campaigns.retryEnrollments")
builtin campaignRetryEnrollments {
  journeyId      string!
  enrollmentIds  []string
}

/// One authorized automation enrollment operation, available only inside its native scope.
@executor("integration.campaigns.campaignDrainJourneys")
builtin campaignDrainJourneys {  }

/// One authorized automation enrollment operation, available only inside its native scope.
@executor("integration.campaigns.campaignJourneyExit")
builtin campaignJourneyExit { reason string! }

/// One authorized automation enrollment operation, available only inside its native scope.
@executor("integration.campaigns.campaignJourneyComplete")
builtin campaignJourneyComplete {  }

