@sdk
@executor("integration.campaigns.sendingReadiness")
@description("Check current organization sending permission, the selected sender and unsubscribe setup without sending mail. A campaignId reads that campaign's saved organization and sender. Otherwise select accountId and senderIdentityId explicitly. Readiness is not evidence of delivery and is rechecked when sending.")
builtin campaignSendingReadiness {
  campaignId string
  accountId string
  senderIdentityId string
}

// campaigns domain -- the Go-backed sending surface (memql#3348).
//
// WHY THESE ARE BUILTINS AND NOT MUTATIONS. Everything else an operator
// does to a campaign is a plain mutation, and that is the right default:
// the concept treatment (browsable, view-composable, authorization-gated)
// comes free, and a mutation is auditable in a way a Go call is not. Seven
// operations cannot be expressed that way, and each fails for a specific
// reason rather than for convenience:
//
//   startSend    A PREFLIGHT SPANNING SEVERAL ROWS, then TWO WRITES.
//                Is a sender registered on this node? Is one-click
//                unsubscribe configured? Is the template marked ready? Is
//                the audience non-empty and inside the ceiling? Every one
//                is a read, and a mutation body cannot read. It then has
//                to write the campaign (owned, the operator's row) AND
//                the send job (clusterOwner, the engine's) -- two writes,
//                one per mutation being the language's contract. The
//                usual answer, an automation on the first write, does not
//                work here: the automation actor is neither the owner nor
//                a cluster owner, so it could not write the job, and
//                making the job writable by it means making it writable
//                by anyone -- and whichever row says "send campaign X as
//                user Y" is an instruction the engine carries out under
//                Y's authority.
//
//   scheduleSend Same preflight, same two writes -- and one more reason
//                (memql#3459). "Which campaigns are due?" cannot be asked of
//                a caller-scoped campaign read. The scheduler scans the
//                engine's own clusterOwner-tier job rows, then revalidates
//                the campaign under its recorded owner's current authority.
//
//   pauseSend    Same two-writes problem, campaign plus job.
//   resumeSend
//
//   suppress     Writes the CLUSTER-WIDE do-not-mail list, whose key is a
//   recordFeedback SHA-256 digest of the address. The digesting has to
//                happen server-side or the address travels instead of the
//                digest, which defeats the point of a digest-keyed list.
//                Both also carry an admin gate that is a role check
//                rather than a row predicate, because the rows they write
//                have no owner to gate on.
//
//   ingestFeedback  PARSING, of a shape a filter expression has no business
//                attempting: a DSN is folded RFC 822 field groups inside a
//                MIME report, and an SES payload is JSON nested inside JSON
//                inside a string (memql#3461). Its gate is the one exception
//                to the paragraph above -- it is ORIGIN and CONFIGURATION
//                rather than a role, because the call asserts nothing. Every
//                address and every verdict comes out of a body a third party
//                signed with a secret the operator configured, arriving at a
//                source the operator allowlisted, in a format the operator
//                named. And only the shipped automation drives it: the
//                handler refuses a call without internal origin before it
//                reads the row (epic memql#5477), because re-processing a
//                trusted webhook is not idempotent where it matters -- each
//                pass counts its reports into the sending ramp's reputation
//                window again and appends another consent event. Requiring
//                admin would have meant every deployment minting a
//                service-account credential for an automation to present;
//                origin is the same property with no credential at all.
//
// Campaign actions first read under the caller's identity, then require
// update permission on data in the campaign's organization and access to the
// Campaigns app there. Shared read access alone cannot send mail. Parent
// resources must agree on organization; the worker rechecks the recorded
// owner's current authority before each delivery. Job owner, audience and
// template are copied from the persisted campaign, never caller overrides.
//
// WHICH OF THESE ARE @sdk, AND WHY (memql#4239). @sdk is a statement about the
// PUBLIC CLIENT SURFACE -- `make sdk-gen` emits a typed Go + TypeScript method
// only for a builtin that carries it -- and nothing else: it has no engine
// effect, and every builtin here is reachable on the wire by name with or
// without it. The four campaign-scoped actions carry it. They are the
// operator's own verbs on their own campaign, the portal's buttons already
// drive them, and their authorization includes the organization action gate above, so a
// typed method advertises nothing a caller could not already do to a row
// they own. The other three do not carry it, for two different reasons:
// suppress and recordFeedback are admin-gated writes to the cluster-wide
// list that no client drives yet (marking them is a one-line decision for
// whoever adds the first caller, not a statement that they are internal);
// ingestFeedback is the automation's door, and its HANDLER keeps it so -- a
// staged inbound row's id is no secret (the staged rows are readable), so the
// absence of @sdk is not what stops a client, the internal-origin refusal is.

@description("Preflight and start a campaign send. Refuses -- rather than partially sending -- when no email sender is registered on the node, when one-click unsubscribe is not configured (MEMQL_CAMPAIGNS_UNSUBSCRIBE_SECRET / _BASE_URL), when the template is not marked ready, or when the audience is empty or at the MEMQL_CAMPAIGNS_MAX_AUDIENCE ceiling. Requires a readable campaign and update permission on data in its organization. Returns the recipient count the send will work through.")
@sdk
@executor("integration.campaigns.startSend")
builtin campaignStartSend {
  campaignId  string!  @description("The campaign to send. The caller needs update permission in its organization.")
}

@description("Commit a campaign to a time and enqueue the send job that will fire at it (memql#3459). Runs the SAME preflight as campaignStartSend -- sender registered, one-click unsubscribe configured, template marked ready, audience non-empty and inside the ceiling -- because the whole value of scheduling is finding out now rather than at 3am. The job it writes is inert: it sits in the 'scheduled' status until the drain worker sees that the campaign's scheduledAt has passed, and the campaign row is the authority on that time, so moving the date with updateCampaign moves the send. A time in the past is refused; use campaignStartSend to send now. Requires the same organization update permission as starting one by hand.")
@sdk
@executor("integration.campaigns.scheduleSend")
builtin campaignScheduleSend {
  campaignId   string!  @description("The campaign to schedule. The caller needs update permission in its organization.")
  scheduledAt  string!  @description("When the send should begin, RFC 3339 (e.g. 2026-08-14T09:00:00Z). Interpreted as an instant, not a local wall clock -- a value with no offset is read as UTC.")
}

@description("Pause a running campaign send. The delivery ledger is untouched, so resuming continues exactly where it stopped -- 'where it stopped' is the set of recipients with no delivery row, not a cursor that could go stale.")
@sdk
@executor("integration.campaigns.pauseSend")
builtin campaignPauseSend {
  campaignId  string!  @description("The campaign to pause. The caller needs update permission in its organization.")
}

@description("Resume a paused campaign send. Does not re-stamp startedAt: the gap between startedAt and completedAt is how long the run took, and resetting it on resume would erase the pause it exists to reveal.")
@sdk
@executor("integration.campaigns.resumeSend")
builtin campaignResumeSend {
  campaignId  string!  @description("The campaign to resume. The caller needs update permission in its organization.")
}

@description("Add an address to the CLUSTER-WIDE do-not-mail list, which outranks every audience and is consulted at the point of send. Admin or cluster owner only: the list spans every operator in the deployment, so adding to it is deployment policy rather than an owner-scoped action. The address is digested server-side and never stored -- the row keeps the digest and the domain, so 'which domains are bouncing' stays answerable while 'who unsubscribed' does not.")
@executor("integration.campaigns.suppress")
builtin campaignSuppress {
  email   string!  @description("The address to suppress. Normalized (trimmed, lowercased) and SHA-256 digested before it reaches the graph.")
  reason  string  @description("unsubscribed | hard_bounce | complaint | manual. Defaults to manual.")
  note    string  @description("Free-text provenance. Never put the address here -- it is stored verbatim.")
}

@description("Record a bounce or complaint the mail provider reported. Admin or cluster owner only. A hard_bounce or complaint suppresses the address cluster-wide and the next send converges the operator's own recipient row onto that verdict; audience membership is NOT deleted, because deleting it destroys the audit trail and lets the next import resurrect a dead address. A soft_bounce is transient and does NOT suppress -- the per-recipient retry budget is what bounds those. This is the MANUAL door -- an operator entering a report by hand, or a bespoke automation presenting an admin service-account credential. The automated path is campaignIngestFeedback, which parses a real provider payload instead of being handed a verdict.")
@executor("integration.campaigns.recordFeedback")
builtin campaignRecordFeedback {
  email       string!  @description("The address the provider reported.")
  kind        string!  @description("hard_bounce | soft_bounce | complaint.")
  campaignId  string  @description("The campaign the report came from, when the provider named one. Recorded on the suppression row so a deliverability review can attribute complaints to a send.")
  note        string  @description("The provider's own classification string. Never the address.")
}

@description("Read a mail provider's bounce or complaint webhook off a staged v1:platform:inboundRequest row and apply it to the cluster-wide suppression list (memql#3461). Understands RFC 3464 delivery status notifications -- the standard format every SMTP-era relay including Microsoft Graph produces -- and Amazon SES feedback over SNS, which additionally carries the complaint feedback loop a DSN structurally cannot. Hard vs soft comes from the provider's own classification (the DSN's Status class or Action, SES's bounceType), never from the diagnostic text. Only the shipped automation reaches it: a call without internal origin is refused before the row is read. Beyond that it is GATED BY CONFIGURATION rather than by role: the row's source must be listed in MEMQL_CAMPAIGNS_FEEDBACK_SOURCES and the delivery must carry signatureVerified=true, and every address and verdict is read from the row's signed body, never from an argument. A payload that cannot be read stamps the inbound row 'failed' with the reason AND errors, so it is queryable rather than dropped; a payload that reads fine and carries no bounce (a delivery receipt, an SNS subscription confirmation) stamps 'processed' and says which it was.")
@executor("integration.campaigns.ingestFeedback")
builtin campaignIngestFeedback {
  inboundRequestId  string!  @description("The staged v1:platform:inboundRequest row to read. In the shipped automation this is args.id, the staged row's id. Its source, body and signature verdict are read from the row; no argument can supply them.")
}

@description("Import recipients into an audience from a CSV file already uploaded to the Library (memql#4822). The file is read SERVER-SIDE under the caller's own actor, so a file the caller cannot read is a file this cannot import -- the artifact id is not a capability. The header row must carry an `email` column (case-insensitive; `displayName` and `name` are also recognized) and EVERY OTHER COLUMN lands verbatim in the recipient's `fields` map, reachable from a template as {{fields.<key>}}. Per row: the address is normalized and shape-validated, deduplicated against the audience's existing recipients AND against earlier rows of the same file (first occurrence wins). The import refuses WHOLE when the resulting roster would exceed MEMQL_CAMPAIGNS_MAX_AUDIENCE -- it never silently truncates, because a partially-imported list is one nobody knows is partial. Returns {added, duplicates, invalid, total} plus up to 20 sample invalid lines with their line numbers, so the operator's next action is fixing the file rather than guessing at it. Each added recipient also gets a consent grant event with source 'import'.")
@sdk
@executor("integration.campaigns.importRecipients")
builtin campaignImportRecipients {
  audienceId  string!  @description("The audience to import into. The caller must be able to read it.")
  artifactId  string!  @description("v1:library:artifact.id of the uploaded CSV. Read under the caller's actor -- an artifact the caller cannot read is not found.")
  hasHeader   bool  @description("Whether the first row is a header. Defaults true. A file with no header cannot be imported: the column mapping IS the header, and guessing which column holds addresses is how an import mails the wrong list.")
}

@description("Add one person to an audience. An address (compared without regard to case or surrounding spaces) that is already in the audience is refused with 'This address is already in this audience.', whatever state that membership is in. An address that unsubscribed or is suppressed is never added as subscribed. In an audience that asks people to confirm, the person is added as pending and receives the confirmation; subscriptionStatus 'subscribed' is accepted there only with alreadyConfirmed true, which records the confirmation and a consent event so automations triggered on confirmation enroll them. A recipientId that already names someone else (in another audience, at another address or in another organization) is refused, and nothing is written over them; repeating a call with the same recipientId, audience and address returns that person as they are now. Needs the same organization write permission as sending.")
@sdk
@executor("integration.campaigns.addRecipient")
builtin campaignAddRecipient {
  recipientId         string!  @description("The id for the new membership, chosen by the caller so a retry is the same add.")
  audienceId          string!  @description("The audience to add to. The caller must be able to read it.")
  email               string!  @description("The address. Shape-validated; stored as typed after trimming.")
  displayName         string
  fields              object   @description("Per-person merge data, reachable from a template as {{fields.<key>}}.")
  source              string   @description("Where the person came from. Defaults to 'manual'.")
  subscriptionStatus  string   @description("'subscribed' or 'pending'. Defaults to 'subscribed', or to 'pending' in an audience that asks people to confirm.")
  alreadyConfirmed    bool     @description("True when the person has already confirmed outside this system. Only meaningful, and required for 'subscribed', in an audience that asks people to confirm.")
  accountId           string   @description("Ignored: the organization is the audience's.")
}

@description("Change one person's subscription state to subscribed, pending or unsubscribed: honour an unsubscribe by hand, or mark a pending person confirmed. A person who unsubscribed, bounced or complained is never moved to another state: only they can subscribe again, from the link in their emails. In an audience that asks people to confirm, every change to subscribed needs alreadyConfirmed and goes through confirmation: it records confirmedAt and a consent event, and wakes an automation waiting on the confirmation. An address that is suppressed is never made subscribed. Every other change is written as given.")
@sdk
@executor("integration.campaigns.setRecipientSubscription")
builtin campaignSetRecipientSubscription {
  recipientId         string!
  subscriptionStatus  string!   @description("'subscribed', 'pending' or 'unsubscribed'. Bounced and complained are the provider's to record, not an operator's.")
  unsubscribedAt      datetime  @description("When the person left, if that happened earlier than now.")
  alreadyConfirmed    bool      @description("Required to make someone subscribed in an audience that asks people to confirm: true says they confirmed, and records it. A person who unsubscribed or whose address is suppressed is refused; only they can subscribe again.")
}

@description("Send one test copy of a campaign to a named address (memql#4822). Renders the campaign's template against a synthetic recipient -- display name 'Test Recipient', the address you name, and the `fields` of the audience's first real recipient when one exists, so {{fields.*}} show the shape they will actually have. The subject is prefixed '[Test] ', the message goes through the campaign's resolved sending identity, and the unsubscribe footer and the four link tags ({{unsubscribeUrl}}, {{preferencesUrl}}, {{viewUrl}}, {{confirmUrl}}) carry an obviously-inert token, so every link renders and none of them does anything. A transactional template is tested as the row lane sends it: no footer, no List-Unsubscribe header and none of the four link tags; one that still carries any of them is refused with the lane's sentence and nothing is sent. It writes NO delivery row and touches NO counter, so a test send can never make a campaign look partly sent; it does consume the ordinary send-rate token bucket, because a test is a real message to a real mailbox. Returns the list of merge tags it could not resolve -- the check that catches a typo'd {{fields.compnay}} before the whole audience gets it. `to` is REQUIRED and never defaults to the caller's own address: a builtin that mails somewhere you did not name is one you have to remember the default of.")
@sdk
@executor("integration.campaigns.testSend")
builtin campaignTestSend {
  campaignId  string!  @description("The campaign to render. The caller must be able to read it.")
  to          string!  @description("Where to send the test. Required and validated -- there is deliberately no default.")
}

@description("The outcome breakdown for one campaign (memql#4823): recipients, pending, sent, failed, the skipped bucket split into suppressed / unsubscribed / other, hard bounces, complaints, one-click unsubscribes, and opens and clicks as both total and unique. Computed SERVER-SIDE from the delivery ledger, the campaign's consent events and its engagement events -- every bucket that can be an exact COUNT is one, at any audience size. This replaces counting a capped page of rows in the browser, which under-reported every campaign past the page bound and did so silently. Two figures are honest about their limits rather than rounded into a number: a unique open/click count is folded from a bounded read and is reported as UNMEASURED rather than as a wrong number when that bound is reached, and soft bounces are absent entirely because nothing measures them per campaign -- an absent figure and a zero are different answers.")
@sdk
@executor("integration.campaigns.stats")
builtin campaignStats {
  campaignId  string!  @description("The campaign to report on. The caller must be able to read it.")
}

@description("Send ONE message to ONE recipient through the campaign machinery -- the marketing lane's primitive for event-triggered email (memql#4829, program P5). Suppression is checked at the point of send, the RFC 8058 unsubscribe pair is attached, the resolved sending identity is applied, and the outcome is ledgered exactly as a campaign send is. It exists because the two event-email lanes are the only sanctioned shapes for automated mail: operational recipients ride the transactional outbox (allowlist enforced, no unsubscribe, no suppression) and marketing recipients ride this. There is deliberately NO free-form sendEmail builtin, and this is not one: it takes a template and an audience recipient, not a subject and a body.")
@executor("integration.campaigns.sendToRecipient")
builtin campaignSendToRecipient {
  requestId         string   @description("Stable identifier for one intended event email. Replays never submit it twice; an uncertain provider outcome remains uncertain and is not automatically resent.")
  templateId        string!  @description("v1:campaigns:template.id supplying the subject and bodies.")
  recipientId       string!  @description("v1:campaigns:recipient.id to send to. Its subscription state and the cluster suppression list are both consulted before anything leaves.")
  senderIdentityId  string   @description("v1:campaigns:senderIdentity.id belonging to the recipient's organization. Omit to resolve that organization's configured sender; client sends never fall back to the operator identity.")
  emailRuleId       string   @description("Optional v1:campaigns:emailRule.id this send came from, stamped on the ledger row so 'which rule mailed this person' is answerable.")
}

@description("Send ONE message an ORDER entitles to that order's buyer -- the third shape of automated mail, beside the transactional outbox (this cluster's own people) and the marketing lane (people on a list). It takes an order, never an address: the buyer's address is read off the mirrored order, so nothing can point it at a stranger. The organization's suppression list is consulted at the point of send, the RFC 8058 one-click pair is attached (its unsubscribe suppresses the address for the organization), the organization's sender is resolved, the reviewed template's {{fields.<key>}} tags are filled from fields, and the outcome is ledgered, once per requestId. No subscription is asked: the order is the reason for the message. TRUSTED JOBS ONLY: a call without internal origin is refused, because a client that could call it could mail the buyer of any order. An order message that meets the send-rate limit is NOT queued: the reply says limited (sent false, skipped false, limited true) and the caller sends it again, because its fields and its sender are the caller's and are kept nowhere a replay could read them.")
@executor("integration.campaigns.sendOrderMessage")
builtin campaignSendOrderMessage {
  storeId           string!  @description("The store the order was placed on.")
  orderGid          string!  @description("The mirrored v1:shopify:order whose buyer is mailed.")
  accountId         string   @description("The store's organization; the template and the sender must belong to it.")
  templateId        string!  @description("The reviewed v1:campaigns:template supplying the subject and bodies.")
  requestId         string!  @description("Stable identifier for this one message. A retry returns its durable receipt; it is never sent twice.")
  fields            object   @description("Text values for the template's {{fields.<key>}} tags -- the product, the link, its expiry.")
  senderIdentityId  string   @description("An identity in the organization. Omit to resolve its configured sender.")
}

@description("Send ONE message about one person's own request to the person a pack's row names: the transactional row lane. It takes a row, never an address: the pack that owns the concept registered, in Go, the resolver that answers the row's address, organization and {{fields.<key>}} values, and the lane asks it only when the message is about to be handed to the provider. The template must be a published transactional template of accountId. The message carries no unsubscribe: no List-Unsubscribe pair and no footer, and a template that still carries the unsubscribe or preferences tag is held. A hard bounce, a complaint or an operator's block of the address skips it; an unsubscribe from a list does not. A skipped send answers its reason -- the suppression's code, or the row's own sentence when its resolver withdrew the message -- and, beside it, skipSentence: that reason as a person reads it, never the code. Once per requestId: a repeat returns the receipt and asks no resolver. A send that meets the rate limit is queued and replayed, and the replay asks the resolver again. A SEND THAT IS REFUSED OR THAT FAILS ANSWERS A CODE AND A SENTENCE, AND NOTHING OF THE LANE'S OWN ERROR: the answer's whole text is a sentence a person reads -- what happened, and what can be done next or who can do it -- and it carries a code that does not change, for a trusted job to decide on: no_authority (the person the send is made as holds no write permission in the organization), template_unreadable, template_other_organization, template_invalid, sender_none_chosen, sender_other_organization, sender_unread, row_unanswered (the row's resolver did not answer), row_other_organization, no_address, suppression_unread, no_provider, provider_refused, provider_busy, not_now (something the send needed failed before anything was attempted) and failed (anything else). The lane's own error -- the function that refused, the engine's message, a provider's message, which may quote the address -- is not answered: it stays in the lane's log and, for a message the provider did not take, on the delivery's ledger row. A template that is not published and a sender that is turned off or gone are HELD instead, answered with the sentence that names what to fix; a hand-over with no answer is UNCERTAIN, answered with the lane's sentence. TRUSTED JOBS ONLY: a call without internal origin is refused before anything is read.")
@executor("integration.campaigns.sendRowMessage")
builtin campaignSendRowMessage {
  rowConcept        string!  @description("A concept a pack registered for the lane.")
  rowId             string!  @description("The row whose person is mailed.")
  accountId         string!  @description("The row's organization. The template and the sender must be its, and the resolver must answer it.")
  kind              string!  @description("Which message about the row; handed to the row's resolver.")
  templateId        string!  @description("A published transactional v1:campaigns:template of the organization.")
  requestId         string!  @description("Stable identifier for this one message. A retry returns its receipt; it is never sent twice.")
  senderIdentityId  string   @description("An identity in the organization. Omit to resolve its configured sender.")
}

@description("The sender a row lane message for one organization would go out as, resolved exactly as the send resolves it: {accountId, ready, fromName, address, reason, code, readFailed, noneChosen}. ready answers the chosen identity's name and address; otherwise fromName and address are empty and reason is a sentence for a person: the send's own hold sentence (one turned off, one that does not exist), \"The chosen sender belongs to another organization.\", \"No sender is chosen for this organization.\" (none named, for an organization that is not the installation's) or \"The sender could not be read just now.\". A CALLER DECIDES ON A FIELD, NEVER ON THE SENTENCE: code says which answer it is -- empty when ready, and otherwise the code a send refused for the same thing carries (no_authority, sender_none_chosen, sender_other_organization, sender_unread), or sender_held for a sender the send would be held for (turned off, or gone); readFailed is true when the sender could not be read just now (nothing is known of it; the same read made again may answer), noneChosen when the organization has no sender because none is chosen; every other answer carries both false. It sends nothing and checks no transport. TRUSTED JOBS ONLY: a call without internal origin is refused before anything is read. THE SEND'S OWN AUTHORITY: the caller must hold what a row send requires of it (update data in the organization); a caller without it is answered exactly as for an organization that does not exist (ready false, \"No sender can be read for this organization.\", code no_authority, readFailed and noneChosen false).")
@executor("integration.campaigns.rowSender")
builtin campaignRowSender {
  accountId         string!  @description("The organization the messages are sent for.")
  senderIdentityId  string   @description("The sending identity chosen; empty is resolved as a send that names none.")
}

@description("The outcome of the row lane's messages, one row per request id: {requestId, status, skipReason, skipSentence, providerStatus, sentAt}, read under the system actor for the one organization named, and nothing else of the delivery. skipReason is a skipped message's reason as the ledger keeps it (the suppression's code -- hard_bounce, complaint or manual -- or the row's own sentence when its resolver withdrew the message), and skipSentence that reason as a person reads it: the lane's words for a code, the withdrawal's own sentence, never the code, and empty for a message that was not skipped. TRUSTED JOBS ONLY: a call without internal origin is refused before anything is read.")
@executor("integration.campaigns.rowMessageStatus")
builtin campaignRowMessageStatus {
  requestIds  list!    @description("The request ids the trusted job sent its messages under.")
  accountId   string!  @description("The organization the messages were sent for. A request id of another organization answers nothing, as an unknown one does.")
}

@description("Generate an event-email rule's automation construct and arm it (memql#4829). The generator is a DETERMINISTIC template over the rule's form -- the LLM authoring path stays off, because a rule that mails strangers is not a place for a model to improvise and a deterministic generator is one a person can read the output of. The generated .memql goes through the ordinary authoring pipeline: bundle, validate, activate. Activation takes effect IMMEDIATELY rather than at next boot. The rule row records the bundle and construct it produced; on refusal it records the engine's own sentence on lastError and the rule goes to 'failed' rather than silently staying draft.")
@sdk
@executor("integration.emailrules.activate")
builtin campaignActivateEmailRule {
  emailRuleId  string!  @description("The rule to generate and arm. The caller must own it: the generated construct runs under the AUTHOR's envelope, so who armed it decides what it can read.")
}

@description("Retire an event-email rule's generated construct (memql#4829). The automation stops firing and the bundle is retired; the RULE row survives with its history, because a rule somebody turned off is a different thing from one that never existed. Used by delete and by edit-and-regenerate, which retires the old bundle before arming the new one -- so a rule is never armed twice.")
@sdk
@executor("integration.emailrules.retire")
builtin campaignRetireEmailRule {
  emailRuleId  string!  @description("The rule whose construct should be retired.")
}

@description("Fire one event-email rule for one triggering row. THE GENERATED AUTOMATION'S ONLY STATEMENT, and it is deliberately the only thing that automation does (memql#4829). The alternative -- generating lane-specific DSL with recipient loops and conditionals per rule -- would put the interesting logic in text a template assembles, where every bug is a bug in a string. Here the generated construct carries exactly what only it can carry (the @trigger binding a concept at load time, which is the whole reason a construct is generated at all) and the decisions live in Go, where they are read, tested and fixed once for every rule. Not @sdk and not client-callable: its caller is an authored automation running under the rule author's own envelope, and it resolves recipients, evaluates the lane and sends. Reached only through the construct the generator wrote.")
@executor("integration.emailrules.fire")
builtin emailRuleFire {
  emailRuleId  string!  @description("v1:campaigns:emailRule.id whose form decides what happens. Baked into the generated construct as a literal, so a rule can only ever fire itself.")
  nodeId       string   @description("The triggering row's id, bound from the event payload by the automation's args block.")
  event        object   @description("The whole triggering event envelope, forwarded by the generated statement. Carries the row payload, which is where a row_address rule reads its recipient from -- reading the field off the EVENT rather than re-reading the row is what keeps the rule working on a concept whose rows the author's own envelope could not read back.")
}

@description("Save an organization email template with an exact revision precondition. content is the email document (a *.email.json file): a layout document made of blocks, or custom HTML with its plain-text body. The server renders it and stores the subject, the text and HTML parts and the document, and answers {templateId, revision, status, saved, issues}. issues are what keeps the email from being sent as it is: a missing picture or link, a picture the caller cannot read, a missing unsubscribe link, an email that is too large. Saving works with issues and returns the template to draft. Publishing requires the exact saved revision and the exact saved content, and is refused while any issue remains. Archive and restore require only the exact revision; the content in the call is ignored, and restore returns a template to draft. Empty expectedRevision creates a draft. With sourceArtifactId (the Library file the email is written in) there is one template per organization and file: the template already published from that file is updated whatever templateId says, and the first save creates it, so templateId may be left empty. This never sends mail.")
@sdk
@executor("integration.campaigns.saveTemplate")
builtin campaignSaveTemplate {
  templateId string @description("Stable caller-generated template ID; reuse on an uncertain creation response. May be empty only when sourceArtifactId is given.")
  accountId string! @description("Owning organization; immutable after creation.")
  name string! @description("Template name.")
  content object! @description("The email document: a layout document {subject, preheader, layout, theme, blocks} or custom HTML {subject, preheader, textBody, htmlBody}. Ignored when archiving or restoring.")
  sourceArtifactId string @description("The Library file the email is written in. Keeps one template per organization and file; see above.")
  expectedRevision string! @description("Exact createdAt from templateById or templateForSource; empty only when creating.")
  action string @description("save (default), publish, archive, restore or classify. Publishing is an explicit human action. classify changes the template's purpose and nothing else: it needs the exact revision and the purpose, ignores the content, returns a published template to draft and answers the issues the template has under its new purpose.")
  purpose string @description("marketing or transactional. For a save or a publish, empty keeps the template's purpose (none is marketing); classify needs one. A transactional template is about one person's own request and has no unsubscribe: no campaign, journey step or event email rule may send it, a layout needs no unsubscribe link, and {{unsubscribeUrl}} or {{preferencesUrl}} (unsubscribe_present), {{viewUrl}} (view_link_present) or {{confirmUrl}} (confirm_link_present) anywhere in it is an issue that keeps it from being published. Archive and restore ignore it. Anything else is refused.")
}

@description("Save an organization email layout with an exact revision precondition, or archive or restore it. Saving validates a layout-mode email document; custom HTML cannot be a layout. Empty expectedRevision creates the layout under the caller-generated layoutId. Archive and restore need only the exact revision.")
@sdk
@executor("integration.campaigns.saveLayout")
builtin campaignSaveLayout {
  layoutId          string!  @description("Stable caller-generated layout id; reuse it on an uncertain creation response.")
  accountId         string!  @description("Owning organization; immutable after creation.")
  name              string   @description("Required when saving.")
  description       string
  document          object   @description("The layout-mode email document. Required when saving.")
  sourceArtifactId  string   @description("The Library file the layout comes from.")
  expectedRevision  string!  @description("Exact createdAt from emailLayoutById; empty only when creating.")
  action            string   @description("save (default), archive or restore.")
}

@description("The built-in email layouts, for an assistant choosing one: rows are {id, name, category, description, outline}. The outline is one line of the layout's blocks in order as id:type, containers listing children in brackets, brand blocks marked (brand), blocks a person may leave out marked opt and repeatable ones rep min..max. The rows carry no drawing; emailLayouts gives a person each layout's wireframe. Needs no organization. The id is opaque: pass it as layoutId to campaignComposeEmail or campaignCreateTemplateFromLayout.")
@sdk
@executor("integration.campaigns.layoutCatalogue")
builtin campaignLayoutCatalogue {
}

@description("The email layouts an organization can start from: the built-in layouts, then its own active layouts (all of them with includeArchived). Rows are {id, kind, name, description, category, wireframe, document, status} plus layoutId, revision and sourceArtifactId for organization layouts. Documents are included up to an 8 MiB answer budget; later rows carry documentOmitted: true instead of document. Read emailLayoutById with the row layoutId when its document is needed. The id is opaque: for a built-in layout, pass it to campaignCreateTemplateFromLayout or campaignComposeEmail as layoutId.")
@sdk
@executor("integration.campaigns.emailLayouts")
builtin emailLayouts {
  accountId        string!
  includeArchived  bool
}

@description("Render an email document for preview: pictures you can read are embedded, sample merge values are applied, and {subject, html, text, issues} comes back. Never saves or sends anything.")
@sdk
@executor("integration.campaigns.renderEmail")
builtin emailRender {
  document   object!  @description("The *.email.json document, in layout or custom mode.")
  accountId  string!  @description("The organization the email is for. You need read access to its data.")
  sample     object   @description("Sample values: displayName, email, accountName, campaignName, and fields (an object of column values).")
  purpose    string   @description("marketing (the default) or transactional: the issues are the ones a save of the email with this purpose would answer.")
}

@description("Save an organization's brand kit with an exact revision precondition. The kit is the look a layout takes when an email is made from it: {theme, logo, signature, follow, social, footer, reply}. A picture in it is a data: PNG, JPEG or GIF, or artifact:<id> for a Library picture you uploaded, which is read as you read it and stored in the kit as a data: picture, so every member can use it. The footer must link {{unsubscribeUrl}}. A kit that is not valid is refused with a sentence that names the field. Contrast never refuses: each text and background colour the built-in layouts draw below WCAG AA comes back as a warning, and so do pictures over 512 KiB together. Answers {revision, warnings: [{code, message}]}. Empty expectedRevision creates the organization's kit. Needs the same organization write permission as campaignSaveTemplate. Templates already made with the kit do not change.")
@sdk
@executor("integration.campaigns.saveBrandKit")
builtin campaignSaveBrandKit {
  accountId         string!  @description("The organization the kit is for; an organization has one kit.")
  kit               object!  @description("The brand kit: {theme, logo, signature, follow, social, footer, reply}.")
  expectedRevision  string   @description("Exact createdAt from brandKitForAccount; empty only when creating.")
}

@description("Preview a brand kit before it is saved: a built-in layout with the kit applied, rendered as emailRender renders it, and the kit's warnings as campaignSaveBrandKit gives them. Answers {html, warnings: [{code, message}]}. Library pictures (artifact:<id>) are read as you read them. Never saves anything.")
@sdk
@executor("integration.campaigns.brandPreview")
builtin campaignBrandPreview {
  accountId  string!  @description("The organization the kit is for. You need read access to its data.")
  kit        object!  @description("The brand kit, as campaignSaveBrandKit takes it.")
  layoutId   string   @description("A built-in layout id, as campaignLayoutCatalogue lists them. Defaults to builtin:article.")
}

@description("Create a draft email template from a built-in layout at once: the layout in its smallest form (a Steps email starts with two steps), with the organization's brand kit applied when it has one, its example subject, and the name given. Answers {templateId, revision, status, saved, issues}. The layout must be one campaignLayoutCatalogue lists, or the answer is \"choose one of the built-in layouts\". Needs the same organization write permission as campaignSaveTemplate.")
@sdk
@executor("integration.campaigns.createTemplateFromLayout")
builtin campaignCreateTemplateFromLayout {
  accountId  string!  @description("The organization the template is for.")
  name       string!  @description("The template's name, up to 200 characters.")
  layoutId   string!  @description("A built-in layout id, as campaignLayoutCatalogue lists them.")
}

// ---- Starting, cancelling and retrying an email composition ----
//
// @sdk: the New email page's Write it, Ask's assistant once the person has
// chosen a layout, and the editor's and the OS's Cancel and Retry. A
// composition's goal runs on route:apps at level strong, whatever route the
// caller's conversation uses, and only on a signed-in app of the caller's own
// machines; it never falls back to a local model and never publishes.

@description("Start MemQL writing an email, and answer at once: a draft template is made from a built-in layout with the organization's brand kit applied, marked as being written, and a goal on the Apps route writes the email into it in Claude Code on your own machine, from the description and the attached files. The template opens at once; templateById shows its composition as writing, then done or failed with the reason. Refused, with nothing created, when the organization has no brand kit (the answer says to set it up first in Email, Settings, Brand) and when none of your machines has an app signed in (the answer says to open Cockpit with Claude Code signed in). Needs the same organization write permission as campaignSaveTemplate. Never publishes. Answers {templateId, goalId, revision, state}. When the goal cannot start, the draft is kept with its composition failed and the answer is {templateId, revision, state, error}: open that draft and retry it there rather than starting another.")
@sdk
@executor("integration.campaigns.composeEmail")
builtin campaignComposeEmail {
  accountId        string!    @description("The organization the email is for.")
  name             string!    @description("The template's name, up to 200 characters.")
  layoutId         string!    @description("A built-in layout id, as campaignLayoutCatalogue lists them.")
  description      string!    @description("What the email should say and do, in 1 to 8000 characters. Words in the attached files are used as they are; the description fills in the rest.")
  fileIds          []string!  @description("The attached Library files: pictures, ZIPs and text files, at most 64. May be empty.")
  referenceFileId  string     @description("A Library picture of how the finished email should look: guidance for the content and its order, put in the email only when the description asks for it.")
}

@description("Cancel an email MemQL is writing: its goal is asked to stop, and the template's composition fails as Cancelled. The draft stays as it was. Refused unless the composition is writing. A cancel acts only on the composition run it read: one its run finished, or one started again, meanwhile is left as it is. Needs the same organization write permission as campaignSaveTemplate. Answers {templateId, revision, state}.")
@sdk
@executor("integration.campaigns.cancelComposition")
builtin campaignCancelComposition {
  templateId  string!  @description("The template MemQL is writing.")
}

@description("Start an email composition that failed again, with the layout, description and files it recorded, under a new goal on the Apps route; the template is written over in place. Refused unless the composition failed, and, as when starting, when the organization has no brand kit or none of your machines has an app signed in. Needs the same organization write permission as campaignSaveTemplate. Never publishes. Answers as campaignComposeEmail does: {templateId, goalId, revision, state}, or {templateId, revision, state, error} when the new goal cannot start.")
@sdk
@executor("integration.campaigns.retryComposition")
builtin campaignRetryComposition {
  templateId  string!  @description("The template whose composition failed.")
}

// ---- The tools of an email composition run (dsl/campaigns/tools.memql) ----
//
// NOT @sdk: a composition run calls them through its three emailCompose* tools,
// which stamp templateId and goalId from the run. A call reaches the template
// only with template write permission in its organization, only while its
// composition is writing, and only when goalId is that composition's goal.

@description("The context of a running email composition: the template's built-in layout with the organization's brand kit applied (each block's id, type, role, sizes and example words; the optional ids; the repeat ranges; the content slots at their minimum), the brand slots the kit fills, the attached files by their names in the composer's workspace with each picture's handle, type, bytes, width and height, the picture of the finished email, the files left out and why, the picture budget the brand leaves, the request's description and the organization's name. Holds no picture's bytes. Saves nothing. Answers only while the composition is writing, for its own goal.")
@executor("integration.campaigns.composeContext")
builtin campaignComposeContext {
  templateId  string!  @description("The template being composed.")
  goalId      string!  @description("The goal of the composition run the call belongs to.")
}

@description("Render a composition of a running email composition: the raw built-in layout with the organization's current brand kit applied and the composition written in, its pictures resolved from their handles, rendered as a preview. Answers {subject, html, text, issues: [{code, block, message}], slots}; the HTML shows each picture as its handle. A composition the layout refuses is answered with the sentence that says why. Saves nothing. Answers only while the composition is writing, for its own goal.")
@executor("integration.campaigns.composeRender")
builtin campaignComposeRender {
  templateId   string!  @description("The template being composed.")
  goalId       string!  @description("The goal of the composition run the call belongs to.")
  composition  object!  @description("{subject, preheader, content: [{id, text, label, href, alt, image}], drop: [id], repeat: {id: copies}}; image is a picture's handle.")
}

@description("Submit a running email composition: the composition is written into the raw built-in layout with the organization's current brand kit and saved as the template's draft, and the composition is done, with each file left out named in its notes, in one revision. When the template changed since the composition began, the email is saved as a new draft beside it, \"<name> (MemQL's version)\", and the original's composition fails with where it went. Refused unless the composition is writing and goalId is its goal. Never publishes. Answers {templateId, revision, issues}.")
@executor("integration.campaigns.composeSubmit")
builtin campaignComposeSubmit {
  templateId   string!  @description("The template being composed.")
  goalId       string!  @description("The goal of the composition run the call belongs to.")
  composition  object!  @description("The composition last rendered, as campaignComposeRender takes it.")
}

// ---- The run of an email composition (the composeEmailRun template) ----
//
// NOT @sdk: it is the one step of composeEmailRun, which a composition's goal
// runs. Called outside that goal's run on the Apps route, it refuses.

@description("Run an email composition, the one step of the composeEmailRun template: claims the template's writing composition for this run's goal, files the attached material in the owner's Library (folder Email material) and hands it, with the composition and the three emailCompose tools, to the per-user email composer, whole in Claude Code on the Apps route. The material it filed is archived when the composer finishes, and a composition the composer did not save is failed with the reason. Refused outside a goal's run on route:apps. Never publishes. Answers {templateId, goalId, state}.")
@executor("integration.campaigns.runComposition")
builtin campaignRunComposition {
  templateId  string!  @description("The template whose writing composition this run writes.")
}

@description("Save, pause or resume a recurring campaign. Each occurrence has a separate campaign and delivery ledger. Requires current organization write authority and an exact revision when changing a saved series.")
@sdk
@executor("integration.campaigns.configureSeries")
builtin campaignConfigureSeries {
  campaignId string!
  action enum("save", "pause", "resume")!
  intervalWeeks int
  firstSendAt datetime
  timeZone string
  expectedRevision string
}


@sdk
@description("Configure this deployable's organization newsletter. Enabling also enables its existing shopper-form carrier; disabling affects only this newsletter.")
@executor("integration.campaigns.configureNewsletter")
builtin campaignConfigureNewsletter {
  siteId string!
  audienceId string!
  templateId string
  senderIdentityId string
  consentText string!
  enabled bool!
  expectedRevision string
}

@description("Accept an affirmative opt-in through the declared storefront form. Site, store, owner and submission provenance come from the existing public-form carrier; audience and sender come only from the saved site binding.")
@executor("integration.campaigns.subscribe")
builtin campaignSubscribe {
  siteId string!
  storeId string!
  submissionId string!
  email string!
  displayName string
  consent string!
  consentRevision string!
}

@sdk
@description("Recheck a blocked welcome under its original owner's current authority. A saved delivery attempt prevents resubmission even when its outcome is uncertain.")
@executor("integration.campaigns.retryNewsletterWelcome")
builtin campaignRetryNewsletterWelcome {
  signupId string!
  expectedRevision string!
}

@description("Save the organization's shared testing audience. Must name an active audience in that organization; an empty audienceId disconnects it. Changes require the current revision.")
@sdk
@executor("integration.campaigns.configureTestAudience")
builtin campaignConfigureTestAudience {
  accountId string!
  audienceId string!
  expectedRevision string
}

@description("Queue a separate test run through the ordinary campaign worker, using this organization's configured testing audience. Works in every source lifecycle, including an active series, whose saved instruction is used without advancing its schedule. Requires the same published template and sending readiness as a live run. Replaying requestId returns the original run without resending.")
@sdk
@executor("integration.campaigns.testAudienceSend")
builtin campaignTestAudienceSend {
  campaignId string!
  requestId string!
  audienceId string! @description("The testing audience reviewed by the caller. Must still match the organization's saved setting; never replaces the saved setting.")
}

/// Bounded campaign operation within an authorized delivery scope.
@executor("integration.campaigns.campaignPromoteSeries")
builtin campaignPromoteSeries {  }

/// Bounded campaign operation within an authorized delivery scope.
@executor("integration.campaigns.campaignDrainWelcomes")
builtin campaignDrainWelcomes {  }

/// Bounded campaign operation within an authorized delivery scope.
@executor("integration.campaigns.campaignPromoteSchedules")
builtin campaignPromoteSchedules {  }

