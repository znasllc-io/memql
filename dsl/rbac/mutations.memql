// rbac domain -- capability catalog writes.
//
// Authz tier: PRIVILEGED catalog write (not per-user-owned). Writing the
// RBAC grant catalog is a cluster-administration action; the capability
// rows are global (_system slot) reference data exactly like the
// v1:agents:agentRole / v1:agents:skill catalogs. In E1.1 the only writer
// is the SeedMaterializer (running as the `system:seedMaterializer`
// actor), which walks the `seed capability ...` declarations under
// dsl/rbac/*.memql and stamps each body's `id` (the seed name) into
// `capabilityId`. The RANK-BOUNDED custom-role authoring path (a creator
// may only mint grants at or below their own rank) lands in E1.4
// (memql#2074) as logic that wraps this mutation; the base-role grants
// this mutation seeds are marked predefined=true and frozen at runtime by
// E1.2 (memql#2070). The args surface mirrors the v1:rbac:capability
// concept field-for-field, matching the materializer's
// mutationCreate<Concept> convention.

/// Insert a v1:rbac:role catalog row -- a named, ranked capability bundle. Called by the
/// SeedMaterializer when it walks the base-role seed declarations under dsl/rbac/seeds.memql (the
/// materializer stamps the seed body's `id` into `roleId`). Also the write surface the E1.4
/// (memql#2072) rank-bounded custom-role authoring path layers on top of -- predefined defaults
/// false there so the role stays editable within the creator's rank bound, and the creator's own
/// rank caps the `rank` arg. Base-role seeds pass predefined=true to mark the row IMMUTABLE at
/// runtime: the validateRbacRoleImmutable Go guard (E1.2) rejects any non-system-actor write to a
/// predefined role, so a base role can never be redefined / re-ranked as data to escalate
/// privilege. Partition-agnostic: the engine stamps every v1:rbac:role insert into the _system slot
/// regardless of the envelope, exactly like createAgentRole / createCapability.
mutate role createRole {
  args {
    roleId       string
    slug         string!
    name         string!
    rank         integer!
    description  string
    predefined   bool
    active       bool
  }
  insert {
    accept { slug, name, rank, description }
    stamp {
      id: coalesce(args.roleId, args.slug)
      predefined: coalesce(args.predefined, false)
      active: coalesce(args.active, true)
    }
  }
}

/// Insert a v1:rbac:capability catalog row -- one (verb x resourceType) grant for a role. Called by
/// the SeedMaterializer when it walks the capability seed declarations under dsl/rbac/*.memql (the
/// materializer stamps the seed body's `id` into `capabilityId`). Also the write surface the E1.4
/// (memql#2074) rank-bounded custom-role authoring path layers on top of -- predefined defaults
/// false there so the grant stays editable within the creator's rank bound; base-role seeds pass
/// predefined=true to mark the row immutable at runtime (enforced by E1.2). Partition-agnostic: the
/// engine stamps every v1:rbac:capability insert into the _system slot regardless of the envelope,
/// exactly like createAgentRole / createSkill.
mutate capability createCapability {
  args {
    capabilityId  string
    roleSlug      string!
    verb          enum("read", "create", "update", "delete", "execute")!
    resourceType  string!
    effect        enum("allow", "deny")
    description   string
    predefined    bool
    active        bool
  }
  insert {
    accept { roleSlug, verb, resourceType, description }
    stamp {
      id: args.capabilityId
      effect: coalesce(args.effect, "allow")
      predefined: coalesce(args.predefined, false)
      active: coalesce(args.active, true)
    }
  }
}
