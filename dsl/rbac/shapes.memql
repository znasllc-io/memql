// rbac domain -- row projections for the role + capability catalog.

/// Full projection of a role row: its stable slug, display name, numeric rank, its account scope,
/// and provenance/lifecycle flags. The canonical shape every role query returns. Higher rank ==
/// more privileged.
///
/// `row.createdBy` is the AUTHOR (epic memql#5166), and it is the row intrinsic rather than a
/// payload field: the engine stamps it from the acting caller, so it answers "who made this role"
/// with no second copy to drift. Predefined roles carry the seed materializer's system actor,
/// which is the honest answer for a row nobody authored.
@row
shape role roleFull {
  row.id
  slug
  name
  rank
  description
  predefined
  active
  aliases
  accountId
  row.createdBy
  row.createdAt
}

/// Full projection of a capability row: the role it belongs to, the (verb, resourceType) grant it
/// expresses, its allow/deny effect, and provenance/lifecycle flags. The canonical shape every
/// capability query returns.
@row
shape capability capabilityFull {
  row.id
  roleSlug
  verb
  resourceType
  effect
  description
  predefined
  active
  row.createdAt
}

/// One grant as the Access administration screen reads it: who it is for (kind + bare id), what
/// it says (verb, resourceType, effect), who wrote it and whether it still counts. `row.createdAt`
/// is when THIS version was written -- a revoked grant's latest version is the revocation.
@row
shape grant grantCard {
  row.id
  subjectKind
  subjectId
  verb
  resourceType
  effect
  grantedBy
  active
  row.createdAt
}
