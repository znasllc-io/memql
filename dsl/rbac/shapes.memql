// rbac domain -- row projections for the role + capability catalog.

@description("Full projection of a role row: its stable slug, display name, numeric rank, and provenance/lifecycle flags. The canonical shape every role query returns. Higher rank == more privileged.")
@row
shape role roleFull {
  row.id
  slug
  name
  rank
  description
  predefined
  active
  row.createdAt
}

@description("Full projection of a capability row: the role it belongs to, the (verb, resourceType) grant it expresses, its allow/deny effect, and provenance/lifecycle flags. The canonical shape every capability query returns.")
@row
shape capability capabilityFull {
  row.id
  roleSlug
  verb
  resourceType
  effect
  description
  predefined
  active
  row.createdAt
}
