// rbac/seeds.memql -- the base ROLE catalog + the base-role capability
// grant catalog.
//
// E1.1 (memql#2069) landed the primitive verbs + capability MODEL and the
// grant set. E1.2 (memql#2070) adds the four base ROLES they attach to,
// authored as immutable seed rows: owner (400) > developer (300) >
// admin (200) > user (100). Each `seed role ...` materializes one
// v1:rbac:role row and each `seed capability ...` one v1:rbac:capability
// row into _system. predefined=true on every base row marks it IMMUTABLE
// at runtime -- the validateRbacRoleImmutable Go guard rejects any
// non-system-actor write to a predefined role, blocking
// escalation-by-redefinition. The SeedMaterializer (a system:* actor)
// still re-materializes these rows on every boot.
//
// THE GRANT MATRIX preserves the behavior currently hardcoded in
// component/auth/rbac.go (the source of truth E1.5 migrates away from):
//
//   owner     -- full authority over every resource, including the
//                principal resource (user management). Mirrors IsOwner /
//                the owner branch of every Can* helper.
//   developer -- ENGINEERING power: authors constructs (create/update/
//                delete on `construct`) + runs inline DSL (execute on
//                `construct`) + the full data plane + forward deploy
//                (execute on `deployment`). Critically it has NO
//                create/update/delete on `principal` -- a developer
//                cannot manage users. Mirrors CanAuthor/CanRunInline/
//                AtLeastDeveloper minus user management.
//   admin     -- USER-MANAGEMENT power: full verbs on `principal`
//                (read/create/update/delete) + agent/group creation +
//                the data plane + forward deploy. It does NOT author
//                constructs (no create/update/delete on `construct`;
//                read only). Mirrors AtLeastAdmin + CanManageUser minus
//                authoring.
//   user      -- the member tier the locked 4-rank model collapses
//                writer into: the read/write data plane (CanWrite) plus
//                read on the catalogs. No principal management, no
//                authoring, no deploy. (E1.5 reconciles the legacy
//                reader/writer split onto this rank + a viewer profile.)
//
// The create != update split is deliberately visible on `principal`:
// admin holds BOTH create and update; a future custom role can hold
// `create` on `principal` WITHOUT `update` -- "mint users but don't edit
// existing ones" -- which is exactly what E1.3's governance predicates
// key on. The same split on `role` (admin/owner create/update/delete vs
// read-only for others) is what bounds custom-role authoring in E1.4.

use rbac.concepts.{ capability, role }

// =============================================================================
//   Base roles -- the four ranked, immutable role rows. Higher rank ==
//   more privileged. Spaced by 100 so E1.4 custom roles slot between.
// =============================================================================

@description("owner: the cluster owner -- full authority over every resource including principals (owner-only-by-owner self-management). Self-managed only; highest rank.")
seed role owner {
  slug:        "owner"
  name:        "Owner"
  rank:        400
  description: "Full authority over every resource, including user management. Owner-principals are editable only by an owner."
  predefined:  true
}

@description("developer: ENGINEERING power -- authors constructs, runs inline DSL, drives the data plane, forward-deploys. OUTRANKS admin (different power axis); does NOT manage principals.")
seed role developer {
  slug:        "developer"
  name:        "Developer"
  rank:        300
  description: "Engineering authority: author DSL constructs, run inline DSL, full data plane, forward deploy. Cannot manage users."
  predefined:  true
}

@description("admin: USER-MANAGEMENT power -- creates/edits/removes lower-ranked principals, creates agents/groups, drives the data plane, forward-deploys. Does NOT author constructs.")
seed role admin {
  slug:        "admin"
  name:        "Admin"
  rank:        200
  description: "User-management authority: manage lower-ranked users, create agents/groups, data plane, forward deploy. Cannot author constructs."
  predefined:  true
}

@description("user: the member tier -- read/write data plane plus read on the catalogs. No user management, authoring, or deploy. The locked base model collapses the legacy writer rank here; E1.5 maps a viewer profile on top.")
seed role user {
  slug:        "user"
  name:        "Member"
  rank:        100
  description: "Member tier: read/write the data plane, read the catalogs. No user management, authoring, or deploy."
  predefined:  true
}

// =============================================================================
//   owner -- full authority over every resource type, every verb.
// =============================================================================

@description("owner: read principals (users/identities).")
seed capability cap-owner-read-principal { roleSlug: "owner"  verb: "read"    resourceType: "principal"  predefined: true }
@description("owner: create principals -- add users.")
seed capability cap-owner-create-principal { roleSlug: "owner"  verb: "create"  resourceType: "principal"  predefined: true }
@description("owner: update principals -- edit any user, including owners (owner-only-by-owner is the E1.3 rank+self predicate, not a separate grant).")
seed capability cap-owner-update-principal { roleSlug: "owner"  verb: "update"  resourceType: "principal"  predefined: true }
@description("owner: delete principals -- remove users.")
seed capability cap-owner-delete-principal { roleSlug: "owner"  verb: "delete"  resourceType: "principal"  predefined: true }
@description("owner: author constructs (define DSL).")
seed capability cap-owner-create-construct { roleSlug: "owner"  verb: "create"  resourceType: "construct"  predefined: true }
@description("owner: edit constructs.")
seed capability cap-owner-update-construct { roleSlug: "owner"  verb: "update"  resourceType: "construct"  predefined: true }
@description("owner: delete constructs.")
seed capability cap-owner-delete-construct { roleSlug: "owner"  verb: "delete"  resourceType: "construct"  predefined: true }
@description("owner: run inline DSL (execute construct).")
seed capability cap-owner-execute-construct { roleSlug: "owner"  verb: "execute"  resourceType: "construct"  predefined: true }
@description("owner: read the data plane.")
seed capability cap-owner-read-data { roleSlug: "owner"  verb: "read"    resourceType: "data"  predefined: true }
@description("owner: create data.")
seed capability cap-owner-create-data { roleSlug: "owner"  verb: "create"  resourceType: "data"  predefined: true }
@description("owner: update data.")
seed capability cap-owner-update-data { roleSlug: "owner"  verb: "update"  resourceType: "data"  predefined: true }
@description("owner: delete data.")
seed capability cap-owner-delete-data { roleSlug: "owner"  verb: "delete"  resourceType: "data"  predefined: true }
@description("owner: execute deploy actions -- cut/deploy/rollback (rollback is owner-only via the E1.3 predicate).")
seed capability cap-owner-execute-deployment { roleSlug: "owner"  verb: "execute"  resourceType: "deployment"  predefined: true }
@description("owner: create agents.")
seed capability cap-owner-create-agent { roleSlug: "owner"  verb: "create"  resourceType: "agent"  predefined: true }
@description("owner: manage groups (create).")
seed capability cap-owner-create-group { roleSlug: "owner"  verb: "create"  resourceType: "group"  predefined: true }
@description("owner: read the RBAC role catalog.")
seed capability cap-owner-read-role { roleSlug: "owner"  verb: "read"    resourceType: "role"  predefined: true }
@description("owner: create custom roles.")
seed capability cap-owner-create-role { roleSlug: "owner"  verb: "create"  resourceType: "role"  predefined: true }
@description("owner: edit custom roles.")
seed capability cap-owner-update-role { roleSlug: "owner"  verb: "update"  resourceType: "role"  predefined: true }
@description("owner: delete custom roles.")
seed capability cap-owner-delete-role { roleSlug: "owner"  verb: "delete"  resourceType: "role"  predefined: true }

// =============================================================================
//   developer -- engineering power: authoring + inline + data + deploy.
//   NO principal management (cannot create/update/delete users).
// =============================================================================

@description("developer: read principals (see the user list; no management).")
seed capability cap-developer-read-principal { roleSlug: "developer"  verb: "read"    resourceType: "principal"  predefined: true }
@description("developer: author constructs (CanAuthor).")
seed capability cap-developer-create-construct { roleSlug: "developer"  verb: "create"  resourceType: "construct"  predefined: true }
@description("developer: edit constructs.")
seed capability cap-developer-update-construct { roleSlug: "developer"  verb: "update"  resourceType: "construct"  predefined: true }
@description("developer: delete constructs.")
seed capability cap-developer-delete-construct { roleSlug: "developer"  verb: "delete"  resourceType: "construct"  predefined: true }
@description("developer: run inline DSL (CanRunInline).")
seed capability cap-developer-execute-construct { roleSlug: "developer"  verb: "execute"  resourceType: "construct"  predefined: true }
@description("developer: read the data plane.")
seed capability cap-developer-read-data { roleSlug: "developer"  verb: "read"    resourceType: "data"  predefined: true }
@description("developer: create data.")
seed capability cap-developer-create-data { roleSlug: "developer"  verb: "create"  resourceType: "data"  predefined: true }
@description("developer: update data.")
seed capability cap-developer-update-data { roleSlug: "developer"  verb: "update"  resourceType: "data"  predefined: true }
@description("developer: delete data.")
seed capability cap-developer-delete-data { roleSlug: "developer"  verb: "delete"  resourceType: "data"  predefined: true }
@description("developer: forward-deploy (execute deployment -- AtLeastDeveloper; rollback stays owner-only via the E1.3 predicate, not a developer grant).")
seed capability cap-developer-execute-deployment { roleSlug: "developer"  verb: "execute"  resourceType: "deployment"  predefined: true }
@description("developer: read agents.")
seed capability cap-developer-read-agent { roleSlug: "developer"  verb: "read"    resourceType: "agent"  predefined: true }
@description("developer: read the RBAC role catalog.")
seed capability cap-developer-read-role { roleSlug: "developer"  verb: "read"    resourceType: "role"  predefined: true }

// =============================================================================
//   admin -- user-management power: full principal verbs + agent/group
//   creation + data plane + deploy. Does NOT author constructs (read only).
// =============================================================================

@description("admin: read principals.")
seed capability cap-admin-read-principal { roleSlug: "admin"  verb: "read"    resourceType: "principal"  predefined: true }
@description("admin: create principals -- add users (CanManageUser create half).")
seed capability cap-admin-create-principal { roleSlug: "admin"  verb: "create"  resourceType: "principal"  predefined: true }
@description("admin: update principals -- edit lower-ranked users (the E1.3 rank predicate bounds which; admin cannot edit owners).")
seed capability cap-admin-update-principal { roleSlug: "admin"  verb: "update"  resourceType: "principal"  predefined: true }
@description("admin: delete principals -- remove lower-ranked users.")
seed capability cap-admin-delete-principal { roleSlug: "admin"  verb: "delete"  resourceType: "principal"  predefined: true }
@description("admin: read constructs (NOT author -- admin gains no authoring per CanAuthor).")
seed capability cap-admin-read-construct { roleSlug: "admin"  verb: "read"    resourceType: "construct"  predefined: true }
@description("admin: read the data plane.")
seed capability cap-admin-read-data { roleSlug: "admin"  verb: "read"    resourceType: "data"  predefined: true }
@description("admin: create data.")
seed capability cap-admin-create-data { roleSlug: "admin"  verb: "create"  resourceType: "data"  predefined: true }
@description("admin: update data.")
seed capability cap-admin-update-data { roleSlug: "admin"  verb: "update"  resourceType: "data"  predefined: true }
@description("admin: delete data.")
seed capability cap-admin-delete-data { roleSlug: "admin"  verb: "delete"  resourceType: "data"  predefined: true }
@description("admin: forward-deploy (execute deployment -- AtLeastAdmin gates the legacy console actions).")
seed capability cap-admin-execute-deployment { roleSlug: "admin"  verb: "execute"  resourceType: "deployment"  predefined: true }
@description("admin: create agents (CanCreateAgent).")
seed capability cap-admin-create-agent { roleSlug: "admin"  verb: "create"  resourceType: "agent"  predefined: true }
@description("admin: manage groups (CanManageGroup -- create).")
seed capability cap-admin-create-group { roleSlug: "admin"  verb: "create"  resourceType: "group"  predefined: true }
@description("admin: read the RBAC role catalog.")
seed capability cap-admin-read-role { roleSlug: "admin"  verb: "read"    resourceType: "role"  predefined: true }
@description("admin: create custom roles (bounded to <= admin rank by E1.4).")
seed capability cap-admin-create-role { roleSlug: "admin"  verb: "create"  resourceType: "role"  predefined: true }
@description("admin: edit custom roles within rank bound.")
seed capability cap-admin-update-role { roleSlug: "admin"  verb: "update"  resourceType: "role"  predefined: true }

// =============================================================================
//   user -- the member tier (writer collapses here). Read/write data plane
//   + read on the catalogs. No principal management, no authoring, no deploy.
// =============================================================================

@description("user: read the data plane.")
seed capability cap-user-read-data { roleSlug: "user"  verb: "read"    resourceType: "data"  predefined: true }
@description("user: create data (CanWrite).")
seed capability cap-user-create-data { roleSlug: "user"  verb: "create"  resourceType: "data"  predefined: true }
@description("user: update data (CanWrite).")
seed capability cap-user-update-data { roleSlug: "user"  verb: "update"  resourceType: "data"  predefined: true }
@description("user: delete own data (CanWrite; per-row ownership still gates which rows).")
seed capability cap-user-delete-data { roleSlug: "user"  verb: "delete"  resourceType: "data"  predefined: true }
@description("user: read agents (pick from the catalog; no creation).")
seed capability cap-user-read-agent { roleSlug: "user"  verb: "read"    resourceType: "agent"  predefined: true }
@description("user: read groups.")
seed capability cap-user-read-group { roleSlug: "user"  verb: "read"    resourceType: "group"  predefined: true }
