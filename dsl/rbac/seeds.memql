// The Logs app's Stream is its own logs section (registry.tsx: `logsSection:
// "stream"`), and the OS logs-section contract asks every app to name its
// logs section as a resource of its own (epic memql#5289) -- the floor was
// carried by the app's door before, and the contract now reads one shape
// for every app rather than one for fourteen and another for this one.
@description("owner: open the stream section of the logs app -- the Logs app's own logs section, at the log store's admin floor (memql#5304).")
seed capability cap-owner-read-app-logs-stream { roleSlug: "owner"  verb: "read"  resourceType: "app:logs/stream"  predefined: true }
@description("developer: open the stream section of the logs app -- the Logs app's own logs section, at the log store's admin floor (memql#5304).")
