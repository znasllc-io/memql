//   user -- the member tier (writer collapses here). Read/write data plane
//   + read on the catalogs. No principal management, no authoring, no deploy.
// =============================================================================

@description("user: read the data plane.")
seed capability cap-user-read-data { roleSlug: "user"  verb: "read"    resourceType: "data"  predefined: true }
@description("user: create data (CanWrite).")
seed capability cap-user-create-data { roleSlug: "user"  verb: "create"  resourceType: "data"  predefined: true }
@description("user: update data (CanWrite).")
seed capability cap-user-update-data { roleSlug: "user"  verb: "update"  resourceType: "data"  predefined: true }
@description("user: delete own data (CanWrite; per-row ownership still gates which rows).")
seed capability cap-user-delete-data { roleSlug: "user"  verb: "delete"  resourceType: "data"  predefined: true }
@description("user: read agents (pick from the catalog; no creation).")
seed capability cap-user-read-agent { roleSlug: "user"  verb: "read"    resourceType: "agent"  predefined: true }
@description("user: read groups.")
seed capability cap-user-read-group { roleSlug: "user"  verb: "read"    resourceType: "group"  predefined: true }

// =============================================================================
//   viewer -- read-only tier (the reader-slug reconciliation target, E1.5).
//   Reads the data plane + catalogs; writes nothing.
// =============================================================================

@description("viewer: read the data plane (read-only tier).")
seed capability cap-viewer-read-data { roleSlug: "viewer"  verb: "read"  resourceType: "data"  predefined: true }
@description("viewer: read agents.")
seed capability cap-viewer-read-agent { roleSlug: "viewer"  verb: "read"  resourceType: "agent"  predefined: true }
@description("viewer: read groups.")
seed capability cap-viewer-read-group { roleSlug: "viewer"  verb: "read"  resourceType: "group"  predefined: true }

// =============================================================================
//   Apps as resources (epic memql#5288; app access grants design, D7).
//
//   An OS app is the capability resource `app:<appId>` and a part of an app
//   is `app:<appId>/<part>`, in the OPEN resourceType field above. Opening an
//   app is `read` on `app:<id>`; a part is `execute` on the part. A part
//   EXISTS by being seeded on at least one role -- `knownResources` in
//   component/memql/requires_capability.go builds the @requiresCapability
//   vocabulary from these rows, so a construct naming a part no seed declares
//   refuses boot with the known parts in the message.
//
//   THE `read app:<id>` ROWS REPRODUCE TODAY'S FLOORS EXACTLY (design section
//   5). Each is one (role, app) pair the MemQL OS registry
//   (clients/os/src/apps/registry.tsx) admits under its hand-written
//   `roles: { min }` / `roles: { any }` floor, and a floored SECTION inside an
//   app is `read app:<id>/<section>` on the roles ITS floor admits. The
//   ladder is the catalog's: developer (300) outranks admin (200), `writer`
//   is the alias of `user` and `reader` of `viewer`, so `min: "admin"` is
//   owner + developer + admin, `min: "writer"` is user and above, no floor is
//   every role, viewer included. Widgets are apps for this purpose (the Set
//   up widget carries a floor; Ask does not).
//
//   TWO GATES HOLD THIS BLOCK TO WHAT IT MIRRORS. TestSeedMatchesCompiledMirror
//   (component/auth) pins these rows to the compiled mirror in
//   rbac_model.go; TestOsRegistryFloorsMatchTheAppSeeds
//   (component/memql/app_resource_os_parity_test.go) reads the registry
//   source and fails the build when it names a resource no row here seeds,
//   or a row here names a resource no manifest asks for. The registry
//   switched from `roles:` to `requires: "app:<id>"` in epic memql#5289;
//   these rows are what its floors became, and the day of the switch
//   changed nobody's desktop because they reproduced the floors exactly.
//
//   The rows are ordered app by app, in registry order, role by rank. The
//   naming is mechanical: cap-<role>-read-app-<appId>[-<section>] and, for a
//   part, cap-<role>-execute-app-deployables-<part>.
// =============================================================================

// ---- app:accounts (registry floor: min admin) ----
@description("owner: open the accounts app -- reproduces the OS registry floor min admin (memql#5300).")
seed capability cap-owner-read-app-accounts { roleSlug: "owner"  verb: "read"  resourceType: "app:accounts"  predefined: true }
@description("developer: open the accounts app -- reproduces the OS registry floor min admin (memql#5300).")
seed capability cap-developer-read-app-accounts { roleSlug: "developer"  verb: "read"  resourceType: "app:accounts"  predefined: true }
@description("admin: open the accounts app -- reproduces the OS registry floor min admin (memql#5300).")
seed capability cap-admin-read-app-accounts { roleSlug: "admin"  verb: "read"  resourceType: "app:accounts"  predefined: true }
@description("owner: open the logs section of the accounts app -- reproduces the OS registry floor min admin (memql#5300).")
seed capability cap-owner-read-app-accounts-logs { roleSlug: "owner"  verb: "read"  resourceType: "app:accounts/logs"  predefined: true }
@description("developer: open the logs section of the accounts app -- reproduces the OS registry floor min admin (memql#5300).")
seed capability cap-developer-read-app-accounts-logs { roleSlug: "developer"  verb: "read"  resourceType: "app:accounts/logs"  predefined: true }
@description("admin: open the logs section of the accounts app -- reproduces the OS registry floor min admin (memql#5300).")
seed capability cap-admin-read-app-accounts-logs { roleSlug: "admin"  verb: "read"  resourceType: "app:accounts/logs"  predefined: true }

