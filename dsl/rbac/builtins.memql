// rbac domain -- governance builtins (E1.3, memql#2071).
//
// These bridge the DSL governance logic (dsl/rbac/logic.memql) to the Go
// governance core (component/auth/rbac_governance.go) via the `rbac`
// integration (integrations/rbac/). The rank comparison the locked rules need
// is not expressible in the DSL spec/logic grammar, so it lives in Go; these
// builtins are the typed call surface. Each returns a single synthetic node
// whose payload carries `{allowed: bool}` (the integration handler builds it).

@executor("integration.rbac.governPrincipal")
@args(profile="object")
@description("Relational governance decision over (actor, target, verb) for the PRINCIPAL resource. Applies actor.rank > target.rank OR actor==target for update/delete, the owner-only carve-out (owner manages everyone; a non-owner can never edit an owner; an owner cannot self-delete), and read-always-passes. Backed by component/auth/rbac_governance.go:GovernPrincipal. Returns {allowed: bool}.")
builtin rbacGovernPrincipal {
  actorUserId     string
  actorRank       int!
  actorIsOwner    bool
  targetUserId    string
  targetRank      int!
  targetRoleSlug  string
  verb            string!
}

@executor("integration.rbac.canCreatePrincipal")
@args(profile="object")
@description("The create != edit split: may an actor at actorRank CREATE a principal at newRank? Permits minting STRICTLY BELOW the actor's own rank (an owner at any sub-owner rank). Independent of the update grant -- a role can hold create-on-principal without update-on-principal. Backed by component/auth/rbac_governance.go:CanCreatePrincipal. Returns {allowed: bool}.")
builtin rbacCanCreatePrincipal {
  actorRank     int!
  actorIsOwner  bool
  newRank       int!
}

// ---------------------------------------------------------------------------
//   Role authoring (epic memql#5166, section D).
// ---------------------------------------------------------------------------
//
// The three builtins that make a custom role real: create it with its grants,
// edit it, retire it. They are the CLIENT-REACHABLE path -- `createRole` and
// `createCapability` in mutations.memql are @serverOnly precisely so this one
// is the only way in -- and they exist as Go rather than as mutations because
// every guard they apply is relational or set-valued, and a mutation body can
// express neither: rank strictly below the CALLER'S, a rank no rung already
// holds, a slug no role or alias already claims, and every grant one the
// CALLER holds.
//
// Each returns one synthetic node whose payload carries { ok, slug, code }.
// `code` is empty on success and otherwise one of the record's names --
// role_slug_taken, role_rank_not_below_caller, role_rank_taken,
// role_grant_not_held, role_predefined_immutable, role_held_above_caller,
// role_held -- so a client renders the refusal it got rather than parsing a
// sentence. A builtin carries no @requiresRank (its annotation set is closed),
// so the capability floor is repeated in the handler.

@description("Create a custom role with its grants, in one internal-origin write. Guards, in order: the caller holds `create` on `role`; the slug matches ^[a-z][a-z0-9-]{1,39}$ and is claimed by no role and no alias (role_slug_taken); the rank is strictly below the caller's (role_rank_not_below_caller) and equal to no existing rung (role_rank_taken); every grant is a pair the caller themselves holds (role_grant_not_held, naming the pair); accountId, if given, scopes the role to that account (D10) and only members of it may then hold the role. Writes the role row (predefined false, active true) and one active capability row per grant. Returns {ok, slug, code}.")
@sdk
@args(profile="object")
@executor("integration.rbac.roleCreate")
builtin roleCreate {
  slug         string!   @description("Stable kebab-case identifier, ^[a-z][a-z0-9-]{1,39}$. Never renamed; a rename is a new role. Refused when any role's slug OR alias already claims it, deactivated roles included -- a retired role stays as history and keeps its name.")
  name         string!   @description("Display name, as a person would say it. This is what MyAccess reports and what every role picker draws.")
  rank         int!      @description("Numeric privilege rank, HIGHER is more privileged. Strictly below the caller's own, and equal to no rung the cluster already has -- two roles at one rank are peers with nothing to say which is which.")
  description  string    @description("One or two lines on what this role is for. Shown wherever the role is offered.")
  accountId    string    @description("Scope the role to one account (D10). Members of that account's groups may hold it; nobody else may be given it. Empty for a global role, which is the common case.")
  grants       []object! @description("The permissions the role holds: a list of { verb, resource }. Every pair must be one the caller holds themselves -- you cannot hand out what you do not have -- and the vocabulary a client should offer is the distinct set of pairs the seeded roles hold (activeCapabilities), because a pair no role holds is not a permission this cluster has.")
}

@description("Edit a custom role: its name, description, rank, scope or grants. Guards: the caller holds `update` on `role`; the role is not predefined (role_predefined_immutable); the rank and grant rules of roleCreate; and a RANK CHANGE additionally requires the caller to outrank every current holder (role_held_above_caller), because re-ranking a role re-ranks the people on it. Writes a new role version; grants removed from the list are written active:false rather than deleted, so the history of what a role could do survives. Returns {ok, slug, code}.")
@sdk
@args(profile="object")
@executor("integration.rbac.roleUpdate")
builtin roleUpdate {
  slug         string!   @description("The role to edit. Not editable itself: a slug is an identity, and renaming one silently re-points every user row carrying it.")
  name         string    @description("New display name. Absent leaves it unchanged.")
  description  string    @description("New description. Absent leaves it unchanged.")
  rank         int       @description("New rank. Absent leaves it unchanged. Present, it must clear the same bounds a create does AND leave every current holder below the caller.")
  accountId    string    @description("New account scope. Absent leaves it unchanged; the empty string clears it, making the role global.")
  grants       []object  @description("The role's grants AS A WHOLE, not a delta: pairs present are kept or added, pairs missing are retired. Absent leaves the grant set unchanged, which is what an edit that only renames should send.")
}

@description("Retire a custom role. Guards: the caller holds `update` on `role`; the role is not predefined (role_predefined_immutable); and it is held by no active user and named by no pending invitation (role_held, with the count). Deactivate, never delete (D8): the row stays as history, its slug and its rung stay taken, and its holders -- if a cluster owner forces one through the write escape -- resolve to nothing, everywhere, until re-roled. Returns {ok, slug, code}.")
@sdk
@args(profile="object")
@executor("integration.rbac.roleDeactivate")
builtin roleDeactivate {
  slug  string!  @description("The role to retire.")
}

// ---------------------------------------------------------------------------
//   Grants to people and groups (app access grants record, section 3;
//   epics memql#5297 and memql#5298).
// ---------------------------------------------------------------------------
//
// Two builtins write a v1:rbac:grant and one reads the caller's resolved set
// back. They are the CLIENT-REACHABLE path -- `writeGrant` and
// `deactivateGrant` in mutations.memql are @serverOnly precisely so this is
// the only way in -- and they are Go because every guard is relational or
// set-valued: the caller holds `update` on `principal`; the caller holds the
// capability being granted, resolved for THEMSELVES through the same rule
// every gate uses; the subject ranks no higher than the caller (a group ranks
// as its highest-ranked active member, an empty group ranks zero); never
// yourself. An unresolvable rank denies.
//
// The write builtins return { ok, grantId, code, message }; `code` is empty on
// success and otherwise one of grant_caller_not_permitted,
// grant_capability_not_held, grant_subject_outranks_caller, grant_self,
// grant_unknown_subject, grant_invalid, grant_not_found -- so a client renders
// the refusal it got rather than parsing a sentence. Every write lands on
// v1:identity:auditEvent with targetType `grant`.

@description("Write one grant: a person's or a group's allow or deny over one (verb, resourceType), as a new version at the derived row id -- re-granting the same subject the same pair never mints a second row. Guards, in order: the caller holds `update` on `principal` (grant_caller_not_permitted); the caller holds the capability being granted, resolved for themselves (grant_capability_not_held); the subject ranks no higher than the caller -- a user as their role, a group as its highest-ranked active member, an empty group as zero, and an unresolvable rank refuses (grant_subject_outranks_caller); the subject is not the caller (grant_self). A subject that is not an active user or group is grant_unknown_subject. Audited as grant_set. Returns {ok, grantId, code, message}.")
@sdk
@args(profile="object")
@executor("integration.rbac.grantSet")
builtin grantSet {
  subjectKind   string!  @description("`user` or `group`. A role is never a subject: a role's abilities are edited on the role.")
  subjectId     string!  @description("The v1:identity:user or v1:identity:group the grant is for, in either spelling; stored bare.")
  verb          string!  @description("One of the five verbs. Opening an app is `read` on `app:<id>`; a named part is `execute` on `app:<id>/<part>`.")
  resourceType  string!  @description("The resource, in the catalog's open vocabulary -- `app:deployables`, `app:deployables/publish`, or any kind a role can hold.")
  effect        string!  @description("`allow` widens what the subject's role answers; `deny` narrows it. Both are legal at every level.")
}

@description("Revoke one grant by its id: writes active:false as a new version of the same row, so the decision and its reversal are both history. The same four rules a set applies, because lifting a deny is handing somebody the app and lifting an allow is barring them from it. An id naming no active grant is grant_not_found. Audited as grant_revoked. Returns {ok, grantId, code, message}.")
@sdk
@args(profile="object")
@executor("integration.rbac.grantRevoke")
builtin grantRevoke {
  grantId  string!  @description("The grant's derived row id, as grantsForSubject / grantsForResource / grantSet report it.")
}

@description("The CALLER's resolved capability set, with provenance: one entry per (verb, resource) the cluster knows -- every pair any role holds, plus every pair a grant naming the caller adds -- each `allow` or `deny` and `source` naming the level that answered: `role` (inherited), `group` (a group the caller is in) or `user` (a grant on the caller). Takes no subject, so nobody can name anybody else; every signed-in person reads their own, which is why it carries no admin floor. This is the one read MemQL OS decides its desktop from. Returns {ok, role, userId, entries: [{verb, resource, effect, source}]}.")
@sdk
@args(profile="object")
@executor("integration.rbac.effectiveCapabilities")
builtin effectiveCapabilitiesForActor {
}
