// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@useConcept(accessRequest)
@description("Full projection of v1:identity:accessRequest including review state and risk signals.")
shape accessRequestFull {
  row.id
  accessRequest.email
  accessRequest.name
  accessRequest.additionalContext
  accessRequest.status
  accessRequest.riskScore
  accessRequest.riskSignals
  accessRequest.sourceIP
  accessRequest.userAgent
  accessRequest.reviewedBy
  accessRequest.reviewedAt
  accessRequest.reviewerNote
  accessRequest.invitationId
  row.createdAt
}

@row
@useConcept(auditEvent)
@description("Full projection of v1:identity:auditEvent including actor, target, and source attribution.")
shape auditEventFull {
  row.id
  auditEvent.occurredAt
  auditEvent.category
  auditEvent.action
  auditEvent.actorUserId
  auditEvent.actorEmail
  auditEvent.actorRole
  auditEvent.actorIdentityId
  auditEvent.targetType
  auditEvent.targetId
  auditEvent.targetEmail
  auditEvent.detail
  auditEvent.sourceIP
  auditEvent.userAgent
  auditEvent.correlationId
  auditEvent.outcome
  auditEvent.failureReason
  auditEvent.prevEventHash
  row.createdAt
}

@row
@useConcept(authCode)
@description("Full projection of v1:identity:authCode. Excludes the plaintext code field; only the SHA-256 hash is exposed to query consumers so a query result can never be replayed at the token endpoint.")
shape authCodeFull {
  row.id
  authCode.codeHash
  authCode.clientId
  authCode.redirectURI
  authCode.state
  authCode.userId
  authCode.identityId
  authCode.magicLinkRequestId
  authCode.expiresAt
  authCode.consumedAt
  authCode.consumedFromIP
  row.createdAt
}

@row
@useConcept(authSession)
@description("Full projection of v1:identity:authSession including revocation state.")
shape authSessionFull {
  row.id
  authSession.userId
  authSession.identityId
  authSession.subject
  authSession.tokenHash
  authSession.refreshTokenHash
  authSession.previousRefreshTokenHash
  authSession.previousRotatedAt
  authSession.source
  authSession.clientLabel
  authSession.expiresAt
  authSession.lastRefreshedAt
  authSession.firstAuthenticatedAt
  authSession.lastActivityAt
  authSession.revokedAt
  authSession.revokedReason
  row.createdAt
}

@row
@useConcept(clusterSettings)
@description("Full projection of v1:identity:clusterSettings -- the singleton runtime-editable cluster configuration row.")
shape clusterSettingsFull {
  row.id
  clusterSettings.registrationMode
  clusterSettings.registrationDomains
  clusterSettings.internalDomains
  clusterSettings.internalDefaultRole
  clusterSettings.brandName
  clusterSettings.brandPrimaryColor
  clusterSettings.brandLogoDataURI
  clusterSettings.registeredClientsJSON
  clusterSettings.accessRequestNotifyEmails
  clusterSettings.accessRequestNotifyThrottleMins
  clusterSettings.bootstrapEmail
  clusterSettings.bootstrappedAt
  row.createdAt
}

@row
@useConcept(delegation)
@description("Comprehensive delegation projection with all fields")
shape delegationFull {
  row.id
  delegation.identityId
  delegation.identitySubject
  delegation.identityType
  delegation.agentId
  delegation.agentSubject
  delegation.roleCeiling
  delegation.scopes
  delegation.expiresAt
  delegation.note
  delegation.active
  delegation.revokedAt
  delegation.revokedBySubject
  row.createdAt
}

@row
@useConcept(identity)
@description("Comprehensive identity projection for the post-restructure identity concept: a credential set owned by a user. Use userFull for the person, delegationFull for delegations, partitionAccessFull for grants.")
shape identityFull {
  row.id
  identity.userId
  identity.identityType
  identity.credentials
  identity.label
  identity.usableByAgents
  identity.active
  identity.lastUsedAt
  row.createdAt
}

@row
@useConcept(identity)
@description("Compact identity projection with the identifying fields only. The full credentials object lives on identityFull.")
shape identitySummary {
  row.id
  identity.userId
  identity.identityType
  identity.label
  identity.usableByAgents
  identity.active
}

@row
@useConcept(invitation)
@description("Comprehensive invitation projection (user + guest kinds)")
shape invitationFull {
  row.id
  invitation.kind
  invitation.spaceId
  invitation.spaceName
  invitation.inviterId
  invitation.inviterName
  invitation.inviteeId
  invitation.inviteeEmail
  invitation.inviteeName
  invitation.token
  invitation.tokenHash
  invitation.expiresAt
  invitation.status
  invitation.respondedAt
  row.createdAt
}

@row
@useConcept(magicLinkRequest)
@description("Full projection of v1:identity:magicLinkRequest including consume state.")
shape magicLinkRequestFull {
  row.id
  magicLinkRequest.email
  magicLinkRequest.tokenHash
  magicLinkRequest.expiresAt
  magicLinkRequest.consumedAt
  magicLinkRequest.consumedFromIP
