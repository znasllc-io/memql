@row
@useConcept(identity)
@description("Comprehensive identity projection for the post-restructure identity concept: a credential set owned by a payload. Use userFull for the person, delegationFull for delegations, partitionAccessFull for grants.")
shape identityFull {
  row.id
  payload.userId
  payload.identityType
  payload.credentials
  payload.label
  payload.usableByAgents
  payload.active
  payload.lastUsedAt
  row.createdAt
}

@row
@useConcept(identity)
@description("Compact identity projection with the identifying fields only. The full credentials object lives on identityFull.")
shape identitySummary {
