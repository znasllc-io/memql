// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Full projection of v1:identity:account -- an operator-managed customer record. Carries the two
/// @pii contact fields, so every query binding this shape must constrain its caller; both account
/// reads do, via the ownerUserId==actor.userId conjunct that the concept's owned tier also injects.
/// ownerUserId is projected deliberately: an operator surface renders "managed by" and the field is
/// the row's authz key, so hiding it would make the tier invisible to the UI that depends on it.
@row
shape account accountFull {
  row.id
  ownerUserId
  name
  status
  description
  primaryContactName
  primaryContactEmail
  externalRef
  archivedAt
  updatedAt
  row.createdAt
}

/// Full projection of v1:identity:accountEntitlement -- the per-account concurrency cap (epic
/// memql#902 / #903) read by the admission controller (#904) and the Tasks UX (#909). createdAt is
/// carried so a reader that gets more than one time-series version can pick the latest.
@row
shape accountEntitlement accountEntitlementFull {
  row.id
  accountId
  accountKind
  tier
  maxConcurrentTasks
  note
  row.createdAt
  row.createdBy
}

/// Full projection of v1:identity:accessRequest including review state and risk signals.
@row
shape accessRequest accessRequestFull {
  row.id
  email
  name
  additionalContext
  status
  riskScore
  riskSignals
  sourceIP
  userAgent
  reviewedBy
  reviewedAt
  reviewerNote
  invitationId
  row.createdAt
}

/// Full projection of v1:identity:auditEvent including actor, target, and source attribution.
@row
shape auditEvent auditEventFull {
  row.id
  occurredAt
  category
  action
  actorUserId
  actorEmail
  actorRole
  actorIdentityId
  targetType
  targetId
  targetEmail
  detail
  sourceIP
  userAgent
  correlationId
  outcome
  failureReason
  prevEventHash
  row.createdAt
}

/// Full projection of v1:identity:authActivity -- the routine authentication mechanics log
/// (memql#4328). retiredTokenHash IS projected: it is the digest of a token that can no longer be
/// used, so it discloses nothing a live credential would, and an operator investigating a replay
/// needs to see which rotation retired the hash the security signal names.
@row
shape authActivity authActivityFull {
  row.id
  occurredAt
  action
  sessionId
  actorUserId
  actorEmail
  actorRole
  actorIdentityId
  sourceIP
  userAgent
  clientLabel
  outcome
  failureReason
  retiredTokenHash
  detail
  row.createdAt
}

/// Full projection of v1:identity:authCode. Only the SHA-256 hash exists to project -- the
/// plaintext code field was removed under issue #3187 -- so a query result can never be replayed
/// at the token endpoint.
@row
shape authCode authCodeFull {
  row.id
  codeHash
  clientId
  redirectURI
  state
  userId
  identityId
  magicLinkRequestId
  expiresAt
  consumedAt
  consumedFromIP
  row.createdAt
}

/// Full projection of v1:identity:oauthClient -- a dynamically-registered (RFC 7591) public OAuth
/// client. No secret column; public clients only.
@row
shape oauthClient oauthClientFull {
  row.id
  clientId
  clientName
  redirectURIsJSON
  grantTypes
  responseTypes
  tokenEndpointAuthMethod
  registeredAt
  corsOriginsJSON
  row.createdAt
}

/// The credentialed-CORS allowance alone (memql#3716) -- the client id and the granted origins,
/// nothing else. Narrower than oauthClientFull on purpose: the origin decision is made on an
/// unauthenticated preflight, and a projection that also carried redirectURIsJSON would put the
/// registration metadata of every granted client on a code path that needs neither.
@row
shape oauthClient oauthClientCORSGrant {
  row.id
  clientId
  corsOriginsJSON
}

/// Full projection of v1:identity:authSession including revocation state.
@row
shape authSession authSessionFull {
  row.id
  userId
  identityId
  subject
  tokenHash
  refreshTokenHash
  previousRefreshTokenHash
  previousRotatedAt
  source
  clientLabel
  expiresAt
  lastRefreshedAt
  firstAuthenticatedAt
  lastActivityAt
  revokedAt
  revokedReason
  row.createdAt
}

/// Self-service projection of v1:identity:authSession -- what a person may see about their own
/// sessions (memql#4306).
///
/// NO TOKEN HASHES, and that is the whole reason this shape exists rather than reusing
/// authSessionFull. A session list is a page a signed-in person loads; authSessionFull carries
/// tokenHash, refreshTokenHash and previousRefreshTokenHash, and a projection that reaches a
/// browser must not carry the digests the auth hot path looks rows up BY. They are not the plaintext
/// -- but they are the lookup key, and there is no reason for a device list to know them.
@row
shape authSession authSessionSelf {
  row.id
  source
  clientLabel
  firstAuthenticatedAt
  lastActivityAt
  lastRefreshedAt
  expiresAt
  row.createdAt
}

/// Another person's sessions, as an owner/admin sees them on a people surface (memql#4736).
///
/// NO TOKEN HASHES, for the reason authSessionSelf states and one more. authSessionSelf omits them
/// because a device list a person loads about THEMSELVES has no use for the digests the auth hot
/// path looks rows up by; this shape omits them because it is read ACROSS accounts, so a projection
/// that carried them would put every session digest in the cluster in front of any admin's browser
/// to render a count.
///
/// It carries what authSessionSelf deliberately does not -- `userId`, `subject`, `revokedAt` and
/// `revokedReason` -- because the reader is looking at somebody else: a row has to name whose it is,
/// and a session list that cannot show revoked state cannot tell "signed in on three devices" from
/// "signed in once and revoked twice".
@row
shape authSession authSessionAdminSummary {
  row.id
  userId
  subject
  source
  clientLabel
  firstAuthenticatedAt
  lastActivityAt
  lastRefreshedAt
  expiresAt
  revokedAt
  revokedReason
  row.createdAt
}

