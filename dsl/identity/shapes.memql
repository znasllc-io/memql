/// Lightweight PAT (api_key identity) projection for UI listings. Excludes credentials entirely so
/// neither the keyHash nor any future per-variant secret material lands in user-facing payloads.
@row
shape identity patSummary {
  row.id
  userId
  label
  usableByAgents
  active
  lastUsedAt
  row.createdAt
}

/// Account-token (account_token identity) projection for the operator's per-account token list.
/// Projects the credential's non-secret leaves BY PATH rather than projecting `credentials`
/// wholesale, which is the whole difference between this shape and identityFull: a shape keys each
/// projected path by its terminal segment, so credentials.accountId arrives as accountId and
/// keyHash is simply never named. That is load-bearing rather than tidy -- memql#3064 recorded
/// that workerTokensForUser leaked keyHash to any caller PRECISELY because identityFull projects
/// the whole object, and the reads over this shape are wire-reachable by design (the operator's
/// own portal calls them), so the projection is the boundary rather than the call origin.
@row
shape identity accountTokenSummary {
  row.id
  userId
  label
  active
  credentials.accountId
  credentials.mintedBy
  credentials.expiresAt
  lastUsedAt
  row.createdAt
}

/// Credential-free projection of a node_token identity, for the portal's Tokens surface
/// (memql#3324). The node fields an operator needs -- which node, which type, who minted it, when
/// it last connected -- and nothing else.
///
/// The PROJECTION is the boundary, exactly as accountTokenSummary's note argues: a shape keys each
/// path by its terminal segment, so credentials.nodeId arrives as nodeId and `keyHash` is simply
/// never named. That is what makes a wire-reachable read of this concept safe, and it is why this
/// exists rather than the portal reusing identityFull (which projects the credentials object
/// wholesale and is the reason nodeTokenIdentities had to become @serverOnly, memql#2987).
@row
shape identity nodeTokenSummary {
  row.id
  userId
  active
  credentials.nodeId
  credentials.nodeType
  credentials.mintedBy
  credentials.expiresAt
  credentials.lastConnectAt
  credentials.bootstrappedAt
  row.createdAt
}

/// Management projection of a passkey identity (memql#3406): the fields a user needs to recognise
/// one of their own authenticators in a list, plus the two flags that decide whether losing the
/// device loses the account.
///
/// Omits publicKey and signCount deliberately. Not because they are secret -- a passkey's stored
/// material is public by construction, which is what separates this variant from every keyHash one
/// -- but because they are VERIFIER state: the assertion path reads them through identityFull, and
/// nothing a client renders is improved by carrying a COSE blob and a counter it cannot interpret.
/// Same reasoning as accountTokenSummary, one step weaker: there the projection is a boundary,
/// here it is a contract about what the management surface is for.
@row
shape identity passkeySummary {
  row.id
  userId
  label
  active
  credentials.credentialId
  credentials.aaguid
  credentials.transports
  credentials.backupEligible
  credentials.backupState
  credentials.registeredBy
  credentials.lastUsedAt
  row.createdAt
}

/// Lightweight projection: just the user's id and activePartitionId pointer. Phase 4 of the
/// chat-architecture plan.
@row
shape user userActiveSpaceProjection {
  row.id
  activePartitionId
}

/// Comprehensive user projection: the person behind one or more identities.
@row
shape user userFull {
  row.id
  displayName
  firstName
  lastName
  primaryEmail
  phone
  primaryRole
  gender
  birthdate
  role
  groupIds
  preferences
  active
  suspendedAt
  suspendedReason
  lastSeenAt
  activePartitionId
  revocationEpoch
  row.createdAt
}

/// Minimal, PII-free projection of a v1:identity:user row: enough to render
/// someone's name next to their id, and nothing else.
///
/// This shape is the client-callable half of the memql#2800 split. userFull
/// above carries primaryEmail / phone / birthdate / gender / role /
/// preferences -- directory-grade PII -- and was reachable by any
/// authenticated caller passing any user id, because the filter keys on a
/// CALLER-SUPPLIED id rather than on the actor.
///
/// EVERY FIELD ADDED HERE IS A PII LEAK on a query clients can call for
/// arbitrary users. TestUserDisplayCardStaysMinimal pins the field set for
/// exactly that reason; if you are here to add a field, add it to userFull and
/// gate the read instead.
@row
shape user userDisplayCard {
  row.id
  displayName
}

/// Row id and nothing else. Backs usersForSeedSweep -- the startup per-user seed sweep
/// (component/memql/seed_materializer.go listUserIds) needs one id per active user to key
/// materialization by, and needs no other field.
///
/// The point of a dedicated shape is what it does NOT carry. The sweep reads EVERY active user
/// under the system actor with no caller scope; projecting userFull there would pull every user's
/// primaryEmail / phone / birthdate into a process-wide Go slice at boot in order to use one field
/// of it. If you are here to add a field, ask what the sweep would do with it first. memql#3217.
@row
shape user userIdRef {
  row.id
}

/// Full projection of a v1:identity:deviceCode row (RFC 8628, memql#3410). Backs BOTH lookups: the
/// polling path (by deviceCodeHash) and the verification page (by userCodeHash). The two hashes ARE
/// projected -- they are the lookup keys, they are already digests rather than credentials, and the
/// caller compares nothing against them; what never exists server-side, and so cannot be projected,
/// is either plaintext.
@row
shape deviceCode deviceCodeFull {
  row.id
  clientId
  deviceCodeHash
  userCodeHash
  status
  scope
  codeChallenge
  codeChallengeMethod
  expiresAt
  intervalSeconds
  lastPolledAt
  approvedByUserId
  approvedAt
  deniedAt
  redeemedAt
  sourceIP
  userAgent
  row.createdAt
}

/// Full projection of a v1:identity:workerPairingCode row. Backs the Pair-aware gRPC interceptor's
/// lookup path + the redeem handler's validation path.
@row
shape workerPairingCode workerPairingCodeFull {
  row.id
  ownerUserId
  codeHash
  clusterURL
  expiresAt
  redeemedAt
  redeemedBy
  redeemedFromIP
  sourceIP
  row.createdAt
}
