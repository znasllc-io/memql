// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use identity.concepts.{ accessRequest, accountEntitlement, auditEvent, authCode, authSession, clusterSettings, delegation, identity, invitation, magicLinkRequest, user, workerPairingCode }

@row
@description("Full projection of v1:identity:accountEntitlement -- the per-account concurrency cap (epic memql#902 / #903) read by the admission controller (#904) and the Tasks UX (#909). createdAt is carried so a reader that gets more than one time-series version can pick the latest.")
shape accountEntitlement accountEntitlementFull {
  row.id
  payload.accountId
  payload.accountKind
  payload.tier
  payload.maxConcurrentTasks
  payload.note
  row.createdAt
  row.createdBy
}

@row
@description("Full projection of v1:identity:accessRequest including review state and risk signals.")
shape accessRequest accessRequestFull {
  row.id
  payload.email
  payload.name
  payload.additionalContext
  payload.status
  payload.riskScore
  payload.riskSignals
  payload.sourceIP
  payload.userAgent
  payload.reviewedBy
  payload.reviewedAt
  payload.reviewerNote
  payload.invitationId
  row.createdAt
}

@row
@description("Full projection of v1:identity:auditEvent including actor, target, and source attribution.")
shape auditEvent auditEventFull {
  row.id
  payload.occurredAt
  payload.category
  payload.action
  payload.actorUserId
  payload.actorEmail
  payload.actorRole
  payload.actorIdentityId
  payload.targetType
  payload.targetId
  payload.targetEmail
  payload.detail
  payload.sourceIP
  payload.userAgent
  payload.correlationId
  payload.outcome
  payload.failureReason
  payload.prevEventHash
  row.createdAt
}

@row
@description("Full projection of v1:identity:authCode. Excludes the plaintext code field; only the SHA-256 hash is exposed to query consumers so a query result can never be replayed at the token endpoint.")
shape authCode authCodeFull {
  row.id
  payload.codeHash
  payload.clientId
  payload.redirectURI
  payload.state
  payload.userId
  payload.identityId
  payload.magicLinkRequestId
  payload.expiresAt
  payload.consumedAt
  payload.consumedFromIP
  row.createdAt
}

@row
@description("Full projection of v1:identity:authSession including revocation state.")
shape authSession authSessionFull {
  row.id
  payload.userId
  payload.identityId
  payload.subject
  payload.tokenHash
  payload.refreshTokenHash
  payload.previousRefreshTokenHash
  payload.previousRotatedAt
  payload.source
  payload.clientLabel
  payload.expiresAt
  payload.lastRefreshedAt
  payload.firstAuthenticatedAt
  payload.lastActivityAt
  payload.revokedAt
  payload.revokedReason
  row.createdAt
}

@row
@description("Full projection of v1:identity:clusterSettings -- the singleton runtime-editable cluster configuration row.")
shape clusterSettings clusterSettingsFull {
  row.id
  payload.registrationMode
  payload.registrationDomains
  payload.internalDomains
  payload.internalDefaultRole
  payload.brandName
  payload.brandPrimaryColor
  payload.brandLogoDataURI
  payload.registeredClientsJSON
  payload.accessRequestNotifyEmails
  payload.accessRequestNotifyThrottleMins
  payload.bootstrapEmail
  payload.bootstrappedAt
  row.createdAt
}

@row
@description("Comprehensive delegation projection with all fields")
shape delegation delegationFull {
  row.id
  payload.identityId
  payload.identitySubject
  payload.identityType
  payload.agentId
  payload.agentSubject
  payload.roleCeiling
  payload.scopes
  payload.expiresAt
  payload.note
  payload.active
  payload.revokedAt
  payload.revokedBySubject
  row.createdAt
}

@row
@description("Comprehensive identity projection for the post-restructure identity concept: a credential set owned by a user. Use userFull for the person and delegationFull for delegations.")
shape identity identityFull {
  row.id
  payload.userId
  payload.identityType
  payload.credentials
  payload.label
  payload.usableByAgents
  payload.active
  payload.lastUsedAt
  row.createdAt
}

@row
@description("Compact identity projection with the identifying fields only. The full credentials object lives on identityFull.")
shape identity identitySummary {
  row.id
  payload.userId
  payload.identityType
  payload.label
  payload.usableByAgents
  payload.active
}

@row
@description("Comprehensive invitation projection (user + guest kinds)")
shape invitation invitationFull {
