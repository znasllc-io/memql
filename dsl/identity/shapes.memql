@row
@description("Lightweight PAT (api_key identity) projection for UI listings. Excludes credentials entirely so neither the keyHash nor any future per-variant secret material lands in user-facing payloads.")
shape identity patSummary {
  row.id
  userId
  label
  usableByAgents
  active
  lastUsedAt
  row.createdAt
}

@row
@description("Lightweight projection: just the user's id and activePartitionId pointer. Phase 4 of the chat-architecture plan.")
shape user userActiveSpaceProjection {
  row.id
  activePartitionId
}

@row
