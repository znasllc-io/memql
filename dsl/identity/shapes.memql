// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Full projection of v1:identity:account -- an operator-managed customer record. Carries the two
/// @pii contact fields, so every query binding this shape must constrain its caller; both account
/// reads do, via the ownerUserId==actor.userId conjunct that the concept's owned tier also injects.
/// ownerUserId is projected deliberately: an operator surface renders "managed by" and the field is
/// the row's authz key, so hiding it would make the tier invisible to the UI that depends on it.
@row
shape account accountFull {
  row.id
  ownerUserId
  name
  status
  description
  primaryContactName
  primaryContactEmail
  externalRef
  archivedAt
  updatedAt
  row.createdAt
}

/// Full projection of v1:identity:accountEntitlement -- the per-account concurrency cap (epic
/// memql#902 / #903) read by the admission controller (#904) and the Tasks UX (#909). createdAt is
/// carried so a reader that gets more than one time-series version can pick the latest.
@row
shape accountEntitlement accountEntitlementFull {
  row.id
  accountId
  accountKind
  tier
  maxConcurrentTasks
  note
  row.createdAt
  row.createdBy
}

/// Full projection of v1:identity:accessRequest including review state and risk signals.
@row
shape accessRequest accessRequestFull {
  row.id
  email
  name
  additionalContext
  status
  riskScore
  riskSignals
  sourceIP
  userAgent
  reviewedBy
  reviewedAt
  reviewerNote
  invitationId
  row.createdAt
}

/// Full projection of v1:identity:auditEvent including actor, target, and source attribution.
@row
shape auditEvent auditEventFull {
