@row
@useConcept(partitionAccess)
@description("Comprehensive partition-access projection: a single grant authorizing a user to operate in a partition with a given role.")
shape partitionAccessFull {
  row.id
  partitionAccess.userId
  partitionAccess.partitionName
  partitionAccess.role
  partitionAccess.grantedBy
  partitionAccess.grantedAt
  partitionAccess.expiresAt
  partitionAccess.active
  partitionAccess.source
  partitionAccess.sourceRef
  partitionAccess.revokedAt
  partitionAccess.revokedBy
  row.createdAt
}

@row
@useConcept(identity)
@description("Lightweight PAT (api_key identity) projection for UI listings. Excludes credentials entirely so neither the keyHash nor any future per-variant secret material lands in user-facing payloads.")
shape patSummary {
  row.id
  identity.userId
  identity.label
  identity.usableByAgents
  identity.active
  identity.lastUsedAt
  row.createdAt
}

@row
@useConcept(user)
@description("Lightweight projection: just the user's id and activeSpaceId pointer. Phase 4 of the chat-architecture plan.")
shape userActiveSpaceProjection {
  row.id
  user.activeSpaceId
}

@row
@useConcept(user)
@description("Comprehensive user projection: the person behind one or more identities.")
shape userFull {
  row.id
  user.displayName
  user.firstName
  user.lastName
  user.primaryEmail
  user.phone
  user.primaryRole
  user.gender
  user.birthdate
  user.role
  user.groupIds
  user.preferences
  user.active
  user.suspendedAt
  user.suspendedReason
  user.lastSeenAt
  user.activeSpaceId
  row.createdAt
}

@row
@useConcept(workerPairingCode)
@description("Full projection of a v1:identity:workerPairingCode row. Backs the Pair-aware gRPC interceptor's lookup path + the redeem handler's validation path.")
shape workerPairingCodeFull {
  row.id
  workerPairingCode.ownerUserId
  workerPairingCode.codeHash
  workerPairingCode.clusterURL
  workerPairingCode.expiresAt
  workerPairingCode.redeemedAt
  workerPairingCode.redeemedBy
  workerPairingCode.redeemedFromIP
  workerPairingCode.sourceIP
  row.createdAt
}
