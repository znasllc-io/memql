}

@row
@description("Full projection of v1:identity:magicLinkRequest including consume state.")
shape magicLinkRequest magicLinkRequestFull {
  row.id
  payload.email
  payload.tokenHash
  payload.expiresAt
  payload.consumedAt
  payload.consumedFromIP
  payload.oauthCtxJSON
