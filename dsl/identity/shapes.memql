  payload.action
  payload.actorUserId
  payload.actorEmail
  payload.actorRole
  payload.actorIdentityId
  payload.targetType
  payload.targetId
  payload.targetEmail
  payload.detail
  payload.sourceIP
  payload.userAgent
  payload.correlationId
  payload.outcome
  payload.failureReason
  payload.prevEventHash
  row.createdAt
}

@row
@useConcept(authCode)
@description("Full projection of v1:identity:payload. Excludes the plaintext code field; only the SHA-256 hash is exposed to query consumers so a query result can never be replayed at the token endpoint.")
shape authCodeFull {
  row.id
  payload.codeHash
  payload.clientId
  payload.redirectURI
  payload.state
  payload.userId
  payload.identityId
  payload.magicLinkRequestId
  payload.expiresAt
  payload.consumedAt
  payload.consumedFromIP
  row.createdAt
}

