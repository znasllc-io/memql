  payload.groupIds
  payload.preferences
  payload.active
  payload.suspendedAt
  payload.suspendedReason
  payload.lastSeenAt
  payload.activeSpaceId
  payload.revocationEpoch
  row.createdAt
}

@row
@description("Full projection of a v1:identity:workerPairingCode row. Backs the Pair-aware gRPC interceptor's lookup path + the redeem handler's validation path.")
shape workerPairingCode workerPairingCodeFull {
  row.id
  payload.ownerUserId
  payload.codeHash
  payload.clusterURL
  payload.expiresAt
  payload.redeemedAt
  payload.redeemedBy
  payload.redeemedFromIP
  payload.sourceIP
