// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use identity.concepts.{ accessRequest, accountEntitlement, auditEvent, authCode, authSession, clusterSettings, delegation, identity, invitation, magicLinkRequest, oauthClient, user, workerPairingCode }

@row
@description("Full projection of v1:identity:accountEntitlement -- the per-account concurrency cap (epic memql#902 / #903) read by the admission controller (#904) and the Tasks UX (#909). createdAt is carried so a reader that gets more than one time-series version can pick the latest.")
shape accountEntitlement accountEntitlementFull {
  row.id
  accountId
  accountKind
  tier
  maxConcurrentTasks
  note
  row.createdAt
  row.createdBy
}

@row
@description("Full projection of v1:identity:accessRequest including review state and risk signals.")
shape accessRequest accessRequestFull {
  row.id
  email
  name
  additionalContext
  status
  riskScore
  riskSignals
  sourceIP
  userAgent
  reviewedBy
  reviewedAt
  reviewerNote
  invitationId
  row.createdAt
}

@row
@description("Full projection of v1:identity:auditEvent including actor, target, and source attribution.")
shape auditEvent auditEventFull {
  row.id
  occurredAt
  category
  action
  actorUserId
  actorEmail
  actorRole
  actorIdentityId
  targetType
  targetId
  targetEmail
  detail
  sourceIP
  userAgent
  correlationId
  outcome
  failureReason
  prevEventHash
  row.createdAt
}

@row
@description("Full projection of v1:identity:authCode. Excludes the plaintext code field; only the SHA-256 hash is exposed to query consumers so a query result can never be replayed at the token endpoint.")
shape authCode authCodeFull {
  row.id
  codeHash
  clientId
  redirectURI
  state
  userId
  identityId
  magicLinkRequestId
  expiresAt
  consumedAt
  consumedFromIP
  row.createdAt
}

@row
@description("Full projection of v1:identity:oauthClient -- a dynamically-registered (RFC 7591) public OAuth client. No secret column; public clients only.")
shape oauthClient oauthClientFull {
  row.id
  clientId
  clientName
  redirectURIsJSON
  grantTypes
  responseTypes
  tokenEndpointAuthMethod
  registeredAt
  row.createdAt
}

@row
@description("Full projection of v1:identity:authSession including revocation state.")
shape authSession authSessionFull {
  row.id
  userId
  identityId
  subject
  tokenHash
  refreshTokenHash
  previousRefreshTokenHash
  previousRotatedAt
  source
  clientLabel
  expiresAt
  lastRefreshedAt
  firstAuthenticatedAt
  lastActivityAt
  revokedAt
  revokedReason
  row.createdAt
}

@row
@description("Full projection of v1:identity:clusterSettings -- the singleton runtime-editable cluster configuration row.")
shape clusterSettings clusterSettingsFull {
  row.id
  registrationMode
  registrationDomains
  internalDomains
  internalDefaultRole
  brandName
  brandPrimaryColor
  brandLogoDataURI
  registeredClientsJSON
  accessRequestNotifyEmails
  accessRequestNotifyThrottleMins
  bootstrapEmail
  bootstrappedAt
  authoredAutomationsEnabled
  row.createdAt
}

@row
@description("Comprehensive delegation projection with all fields")
shape delegation delegationFull {
  row.id
  identityId
  identitySubject
  identityType
  agentId
  agentSubject
  roleCeiling
  scopes
  expiresAt
  note
  active
  revokedAt
  revokedBySubject
  row.createdAt
}

@row
@description("Comprehensive identity projection for the post-restructure identity concept: a credential set owned by a user. Use userFull for the person and delegationFull for delegations.")
shape identity identityFull {
  row.id
  userId
  identityType
  credentials
  label
  usableByAgents
  active
  lastUsedAt
  row.createdAt
}

@row
@description("Compact identity projection with the identifying fields only. The full credentials object lives on identityFull.")
shape identity identitySummary {
  row.id
  userId
  identityType
  label
  usableByAgents
  active
}

