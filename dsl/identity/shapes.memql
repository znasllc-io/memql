@row
shape authSession authSessionFull {
  row.id
  userId
  identityId
  subject
  tokenHash
  refreshTokenHash
  previousRefreshTokenHash
  previousRotatedAt
  source
  clientLabel
  expiresAt
  lastRefreshedAt
  firstAuthenticatedAt
  lastActivityAt
  revokedAt
  revokedReason
  row.createdAt
}

