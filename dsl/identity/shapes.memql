/// Comprehensive identity projection for the post-restructure identity concept: a credential set
/// owned by a user. Use userFull for the person and delegationFull for delegations.
@row
shape identity identityFull {
  row.id
  userId
  identityType
  credentials
  label
  usableByAgents
  active
  lastUsedAt
  row.createdAt
}

/// Compact identity projection with the identifying fields only. The full credentials object lives
/// on identityFull.
@row
shape identity identitySummary {
  row.id
  userId
  identityType
  label
  usableByAgents
  active
}

/// Comprehensive invitation projection (user + guest kinds)
@row
shape invitation invitationFull {
  row.id
  kind
  active
  partitionId
  spaceName
  inviterId
  inviterName
  inviteeId
  inviteeEmail
  inviteeName
  inviteeRole
  tokenHash
  previousTokenHash
  bindingHash
  expiresAt
  status
  respondedAt
  accountId
  row.createdAt
}

/// An invitation as an operator surface shows it: who was invited, at what role, by whom, whether
/// the mail went out, and when it expires (memql#4735).
///
/// NO TOKEN HASHES -- not `tokenHash`, not `previousTokenHash`, not `bindingHash` -- and that is the
/// whole reason this exists beside invitationFull. `pendingUserInvitations` declared no shape at
/// all, so it projected the concept's every field and handed all three digests to the browser of
/// every owner and admin who opened a people list. They are not the plaintext token, but they are
/// the key the resolve path looks an invitation up BY, and a pending-invitations table has no use
/// for them. Same rule authSessionSelf records for sessions.
///
/// It ADDS the three delivery fields invitationFull has never carried (memql#4587). Whether the
/// invitation email was attempted, sent or failed is the first thing an operator needs from this
/// row -- an invitation that looks issued and was never delivered is the failure this list exists to
/// make visible -- and `deliveryState` alone cannot say it: `not_attempted` means no mail is wired
/// on this cluster, which is a configuration statement, while `failed` plus `deliveryError` is an
/// incident.
@row
shape invitation invitationAdminSummary {
  row.id
  kind
  active
  inviterId
  inviterName
  inviteeId
  inviteeEmail
  inviteeName
  inviteeRole
  expiresAt
  status
  respondedAt
  deliveryState
  deliveryError
  deliveryAttemptedAt
  accountId
  row.createdAt
}

