// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use platform.queries.{ globalVariable }

/// Daily 04:00 UTC sweep: expire pending access requests older than
/// IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS. `decide` (pure) returns the pending requests past the
/// window; the `for` loop over them calls expireAccessRequest, which stamps status=expired.
@trigger(schedule="0 0 4 * * *")
automation accessRequestExpirySweep {
  decide := logic accessRequestExpirySweep(event: event)
  for item in decide {
    mutation expireAccessRequest(requestId: item.id)
  }
}

// accountDeletionReminder25Days
// ==============================
//
// Daily 09:05 UTC sweep that emits a more-urgent reminder event for
// each user ~25 days into their deletion cooldown -- typically the
// last reminder before the 30-day cooldown elapses and
// accountDeletionSweep performs the hard delete.
//
// Same shape as accountDeletionReminder7Days; only the windowing
// (P25D / P26D) and the event subject string differ. Two
// automations rather than one so each fires at a slightly different
// time and they don't contend for the same scheduler slot.
//
// Windowing + email-delivery delegation: see header of
// accountDeletionReminder7Days.
/// Daily 09:05 UTC: emit identity.deletion.reminder events (urgent) for users at the 25-day mark of
/// their deletion cooldown.
@trigger(schedule="0 5 9 * * *")
automation accountDeletionReminder25Days {
  // Daily 09:05 UTC sweep that emits an 'identity.deletion.reminder' event for each user 25-26 days
  // into their deletion cooldown -- final notice before accountDeletionSweep performs the hard
  // delete at 30 days. The one-day window fired daily means each user gets exactly one reminder at
  // this milestone. Which users are due is logic usersDueDeletionReminder's decision (P4); the
  // publishing is here because a logic may not publish (D14).
  due := logic usersDueDeletionReminder(from: "P25D", to: "P26D")
  for item in due {
    publish "identity.deletion.reminder" {
      userId: item.id,
      email: item.primaryEmail,
      deletionScheduledAt: item.deletionScheduledAt,
      milestoneDays: 25,
      subject: "Final notice: your <BRAND_NAME> account will be deleted in 5 days",
      timestamp: now
    }
  }
  return due.count()
}

// accountDeletionReminder7Days
// =============================
//
// Daily 09:00 UTC sweep that emits a reminder event for each user
// roughly 7 days into their deletion cooldown so the user has a
// clear chance to cancel before the cooldown elapses (typically a
// 30-day window, configurable via MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS).
//
// The 7-day window is bracketed [P7D, P8D) on deletionScheduledAt:
// a row whose deletionScheduledAt was approximately 7 days ago lands
// in this run. The 25-day reminder uses [P25D, P26D). One-day
// brackets, fired daily, mean each user gets exactly one reminder
// at each milestone (no duplicates, no gaps).
//
// Email delivery: there is no `integration.email.sendEmail` builtin
// exposed in the DSL today (the Go integration registers the
// capability but no `builtin` declaration surfaces it). This
// automation publishes an `identity.deletion.reminder` event with
// the user's email + remaining-cooldown details; the
// component/server / app/integrations_identity wiring is expected
// to subscribe and call the email integration's Sender directly.
// When a builtin email send lands in DSL, swap the `publish` for a
// direct call.
//
// Brand-name interpolation TODO: the subject string is literal
// "<BRAND_NAME>" today; the consumer of the published event
// should substitute the actual brand at delivery time.
//
// Windowing: usersDueDeletionReminder brackets each user in memory,
// in a `where` over the rows usersInDeletionCooldown returns.
/// Daily 09:00 UTC: emit identity.deletion.reminder events for users at the 7-day mark of their
/// deletion cooldown.
@trigger(schedule="0 0 9 * * *")
automation accountDeletionReminder7Days {
  // Daily 09:00 UTC sweep that emits an 'identity.deletion.reminder' event for each user 7-8 days
  // into their deletion cooldown so they can cancel before the cooldown elapses. The one-day window
  // fired daily means exactly one reminder per user at this milestone. Email delivery is consumed
  // by the component/server subscriber. Which users are due is logic usersDueDeletionReminder's
  // decision (P4); the publishing is here because a logic may not publish (D14).
  due := logic usersDueDeletionReminder(from: "P7D", to: "P8D")
  for item in due {
    publish "identity.deletion.reminder" {
      userId: item.id,
      email: item.primaryEmail,
      deletionScheduledAt: item.deletionScheduledAt,
      milestoneDays: 7,
      subject: "Your <BRAND_NAME> account will be permanently deleted soon",
      timestamp: now
    }
  }
  return due.count()
}

// accountDeletionSweep
// =====================
//
// Daily 03:00 UTC sweep. For each active user with deletionScheduledAt
// set whose cooldown (MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS, default 30) has
// elapsed:
//
//   1. Soft-delete the user row + scrub PII (deleteUserHard).
//   2. Revoke every active auth session for the user's JWT subject so
//      any in-flight tokens stop authorizing -- NOT done yet: see the
//      revocation gap in the accountDeletionSweep logic.
//
// What this cron does NOT touch (intentional gaps):
//
//   - v1:identity:auditEvent rows: kept for the trail. The
//     audit-event rows already capture point-in-time email/role on
//     each entry, so they remain readable post-deletion. (User-id
//     foreign keys on audit rows still resolve to the tombstoned
//     user row.)
//   - v1:identity:invitation rows the user issued: kept for the
//     same reason -- audit trail.
//   - v1:identity:accessRequest rows the user originated as an
//     admin reviewer: kept for the trail.
//   - v1:identity:identity rows (the credential records): NOT
//     scrubbed today. A future enhancement should iterate the
//     user's identities and call a `mutationScrubIdentity` to
//     blank credentials (oauth tokens, key hashes, etc.); no
//     such mutation exists yet, and inventing one without a
//     concept-side @scrub annotation would risk leaving stale
//     credential data on disk. Tracked as a follow-up.
//
// The cooldown cutoff (now minus the cooldown, addDuration with a
// negative ISO-8601 duration) is computed in the accountDeletionSweep
// logic and passed to usersScheduledForDeletion as `scheduledBefore`,
// so the comparison runs in the query's filter. There's no
// batch-update path; the `for` loop deletes one user at a time.
/// Daily 03:00 UTC sweep: hard-delete users past MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS. `decide`
/// (pure) returns the users whose cooldown has elapsed; the `for` loop over them hard-deletes each
/// via deleteUserHard. Auth-session revocation is the documented gap noted in the decide logic.
@trigger(schedule="0 0 3 * * *")
automation accountDeletionSweep {
  decide := logic accountDeletionSweep(event: event)
  for item in decide {
    mutation deleteUserHard(userId: item.id)
  }
}

// auditEventRetentionSweep
// =========================
//
// Daily 02:00 UTC sweep meant to retire audit-event rows older than
// MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS. The intent is rotation-grade
// retention (typically 90-365 days for compliance).
//
// Note (intentional gap): MemQL has no row-removal mutation today
// (the AST defines only Insert and Update). Soft-deleting an audit
// event by `update(active=false)` is also a non-starter -- the
// AuditEvent concept doesn't carry an `active` field, and adding
// one would weaken the "append-only" guarantee that's the whole
// point of an audit log.
//
// So this cron is wired but currently publishes a "would-expire N rows"
// event for observability only; no row state changes. When
// either:
//
//   (a) the engine grows a `delete()` mutation kind, or
//   (b) a deliberate `tombstoned: true` field lands on AuditEvent
//       (with the audit semantics it implies),
//
// flip this cron to call the corresponding mutation in a `for` loop
// over the rows. The query side
// (expiredAuditEvents) is stable either way.
//
// No retention window is applied yet: the count is of every row
// expiredAuditEvents returns, and the configured retention is only
// echoed in the event.
/// Daily 02:00 UTC sweep over audit events, for MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS retention.
/// Currently observation-only; deletion lands when MemQL gains row-removal support.
@trigger(schedule="0 0 2 * * *")
automation auditEventRetentionSweep {
  // Daily 02:00 UTC sweep over v1:identity:auditEvent rows, for retention past
  // MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS. Observation-only today: emits an
  // 'identity.audit.retention.observed' event with the candidate count -- MemQL has no delete()
  // mutation and AuditEvent's append-only semantics forbid soft-delete via active=false. Per-row
  // delete lands when one of those gaps closes.
  allEvents := query expiredAuditEvents()
  retentionDays := query globalVariable(name: "MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS")

  // Count the rows expiredAuditEvents returns. The `publish` emits one
  // observation per cron tick so the operator can see the candidate-row
  // count over time. No per-row state change today -- see header note.
  publish "identity.audit.retention.observed" {
    candidateCount: allEvents.count(),
    retentionDays: retentionDays.first().value ?? "365",
    timestamp: now
  }

  return allEvents.count()
}

// ---- automations/v1/identity/expireDelegations/automation.memql ----

// expireDelegations
// =================
//
// Scheduled automation: every 5 minutes, soft-revoke every delegation
// whose expiresAt is past.
//
// TWO statements, and the split matters. `decide` calls
// `revokeExpiredDelegations`, which is a PURE READ -- it returns the
// expired rows and revokes nothing. The `for` loop over those rows
// calls `revokeDelegation`, which is the write.
//
// An earlier version of this comment said "the query + iteration +
// revoke loop lives in revokeExpiredDelegations; the automation is just
// the trigger + one step that calls it". Both halves were false, and
// memql#2869 inherited the error -- it cited the pure read as "a sweep
// that revokes rows" and built a step-caching decision on it. Corrected
// in that issue's review.

/// Soft-revoke expired delegations every 5 minutes. `decide` reads the expired rows (pure);
/// the `for` loop over them calls revokeDelegation, which is the write.
@trigger(schedule="0 */5 * * * *")
automation expireDelegations {
  decide := logic revokeExpiredDelegations(asOf: now)
  for item in decide.nodes() {
    mutation revokeDelegation(
      delegationId: item.id,
      revokedBySubject: "system:expiry",
      revokedAt: now
    )
  }
}

// magicLinkExpirySweep
// =====================
//
// Hourly sweep that finds magic-link requests whose expiresAt is in
// the past and marks them consumed-as-expired so the row is
// idempotent against any subsequent click and the storage stays
// compact.
//
// Path detail. There is no row-removal mutation in MemQL today
// (Insert and Update only), so "tombstoning" the row uses the
// existing consumeMagicLinkRequest. The handler that
// processes /auth/magic-link/consume already rejects rows with
// non-empty consumedAt; stamping consumedAt on already-expired rows
// here is a belt-and-suspenders guard:
//
//   - A user click after expiry would have rejected on the
//     `expiresAt < now` check anyway -- consumedAt isn't gating it.
//   - But marking the row consumed turns the row into an
//     uninteresting "spent" entry in any future audit query, which
//     is the right semantic.
//
// The cron runs hourly (vs. expireGuestInvitations's 30s) because
// magic-link TTLs are minutes-to-an-hour and the consume path's
// own expiresAt check makes the sweep's tightness irrelevant. If
// the operator wants tighter cleanup, bump the cadence here.
//
// The `now` cutoff is passed to expiredMagicLinkRequests as its
// `asOf` argument rather than read inside the query's filter.
/// Hourly sweep: mark expired magic-link requests as consumed-from-system so the row is canonically
/// spent.
@trigger(schedule="0 0 * * * *")
automation magicLinkExpirySweep {
  decide := logic magicLinkExpirySweep(event: event)
  for item in decide.nodes() {
    mutation consumeMagicLinkRequest(
      requestId: item.id,
      consumedFromIP: "system:expiry"
    )
  }
}

// onDelegationCreated
// ===================
//
// Emits a delegation.created event when a new delegation is created.
// Used for audit logging and downstream event processing.
/// Emit delegation.created event with full context for audit logging
@trigger(event="node.created", concept="v1:identity:delegation")
automation onDelegationCreated {
  args {
    agentId any
    createdBySubject any
    id any
    identityId any
    identitySubject any
    identityType any
    roleCeiling any
    scopes any
  }
  // Emits a 'delegation.created' event when a new v1:identity:delegation row lands. Carries the
  // delegation id + identity / agent / role / scope fields for audit logging and downstream event
  // processing.
  publish "delegation.created" {
    delegationId: args.id,
    identityId: args.identityId,
    identitySubject: args.identitySubject,
    identityType: args.identityType,
    agentId: args.agentId,
    roleCeiling: args.roleCeiling,
    scopes: args.scopes,
    createdBySubject: args.createdBySubject,
    timestamp: now
  }
}
/// Global operators work for the cluster's own organization. Role changes and
/// new users reach the same idempotent membership writer as the boot sweep.
@trigger(event="node.created", concept="v1:identity:user")
automation ensureNewOperatorOrganization {
  args { id any }
  ensure := builtin groupEnsureOperatorMembership(userId: args.id)
}

@trigger(event="node.updated", concept="v1:identity:user")
automation ensureUpdatedOperatorOrganization {
  args { id any }
  ensure := builtin groupEnsureOperatorMembership(userId: args.id)
}

