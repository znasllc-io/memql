// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.traits.{ identityIsApiKey, identityIsBadge, identityIsNodeToken, identityIsWorkerToken, isActiveRecord, isDeletionScheduled, statusIsPending }
use common.specs.{ requiresOwnerOrAdmin }

// ---- queries/v1/identity/accountEntitlement.memql ----

// accountEntitlement - the account's task-concurrency cap
// ============================================================
//
// Returns the v1:identity:accountEntitlement row for an account
// (zero or one current row). Read by the admission controller (#904)
// to resolve the per-account concurrent-running-task cap, and by the
// Tasks UX (#909) for tier / upgrade messaging.
//
// Filters on accountId only -- a system / admin read (the planner
// dispatch calls it under the system actor). It references no
// caller-scope field (accountId is an arg, not actor.userId), so the
// per-row-authz audit classifies it as 'other'. The default-unlimited
// semantics (no row => uncapped) live in the Go resolver, not here.
//
// Arguments:
//   accountId (string, required) - the paying account (v1: a
//     v1:identity:user.id).
//
// Returns:
//   Zero or one accountEntitlement row in accountEntitlementFull shape.

/// The account's task-concurrency entitlement row (zero or one current row). Backs the admission
/// controller (#904) and Tasks UX (#909). Filters on accountId only; classifies as 'other' in the
/// per-row-authz audit. No-row => unlimited is enforced in the Go resolver.
@unbounded("entitlements for an account -- a small bounded set per account consumed whole")
query accountEntitlement accountEntitlement {
  args {
    accountId  string!
  }
  filter  accountId==args.accountId
  shape   accountEntitlementFull
}

// ---- queries/v1/identity/accessRequestById.memql ----

// accessRequestById - Look up an access request by id
// ====================================================
//
// Returns the v1:identity:accessRequest row with the given id. Used
// by the admin approve / reject handlers to read the current row
// before stamping the decision via approveAccessRequest /
// rejectAccessRequest.
//
// Arguments:
//   requestId (string, required) - access-request node id
//
// Returns:
//   Zero or one access-request row in accessRequestFull shape.
//

/// Returns the access request with the given id. Zero or one result.
@unbounded("access request by id (guarded) -- bounded to a single row")
query accessRequest accessRequestById {
  args {
    requestId  string!
  }
  filter  when(args.requestId) { row.id==args.requestId }
  shape   accessRequestFull
}

// ---- queries/v1/identity/activeDelegationsForAgent.memql ----

// activeDelegationsForAgent - Get Active Delegations for Agent
// =================================================================
//
// Returns all active delegations for a given agent ID.
// Active delegations are those where active=true and not expired.
//
// Arguments:
//   agentId (string, required) - The agent identifier
//
// Returns:
//   Array of delegation records in delegationFull shape
//
// Usage:
//   activeDelegationsForAgent({agentId: "agent-sofia"})
//

/// Get all active delegations for a given agent ID
@unbounded("active delegations for an agent -- a small bounded set consumed whole for authz")
query delegation activeDelegationsForAgent {
  args {
    agentId  string!
  }
  filter  agentId==args.agentId && isActiveRecord
  shape   delegationFull
}

// ---- queries/v1/identity/activeDelegationsByIdentitySubject.memql ----

// activeDelegationsByIdentitySubject - Get Active Delegations by Identity Subject
// =====================================================================================
//
// Returns active (non-revoked) delegations whose identitySubject matches the
// caller-supplied authenticated subject id. Used by the per-request
// DelegationResolver on the gRPC auth hot path: post-JWT-verify the verifier
// hands the verified subject here, and the resolver applies role-ceiling +
// lifetime + scope narrowing on top of whatever rows come back.
//
// Lifetime + role-ceiling + scope checks all live in Go (resolver-side); this
// query is the raw subject -> active rows lookup. Returning everything (and
// letting Go pick) means a future "prefer the most-recently-created" tiebreak
// doesn't need a schema change.
//
// Reference: memql#112.
//
// Arguments:
//   identitySubject (string, required) - authenticated subject id of the delegating identity
//
// Returns:
//   Zero or more delegation rows in delegationFull shape.

/// Get all active delegations whose identitySubject matches the argument. Used by the per-request
/// DelegationResolver on the auth hot path. See memql#112.
@unbounded("active delegations for an identity subject -- a small bounded set consumed whole for authz")
query delegation activeDelegationsByIdentitySubject {
  args {
    identitySubject  string!
  }
  filter  identitySubject==args.identitySubject && isActiveRecord
  shape   delegationFull
}

/// Active users in the cluster, optionally filtered by role or group membership. Both args are
/// optional -- omit them to list all active users (the identity admin portal's user-list view).
///
/// @serverOnly (memql#2883). Both args are optional, so `activeUsers()` returned every active user
/// in userFull -- every @pii field plus the cluster-wide auth role -- to any authenticated caller.
///
/// Scoping it to actor.userId is NOT the fix, and would be actively wrong: this query's whole
/// purpose is to enumerate OTHER users. A user row IS a person rather than something a person owns,
/// so there is no ownership column for actor.userId to match; such a filter would reduce every
/// caller to their own row and delete the construct's reason to exist.
///
/// The weaker caller-scoping -- requiresOwnerOrAdmin, the gate searchUsers takes -- is also wrong
/// here, for the same circularity that kept userByIdSystem server-only rather than
/// actor.userId-scoped (#2800): two callers run BEFORE an actor exists. `CountActiveUsers` and
/// `HasOwnerUser` (component/identity/store.go) answer "has this cluster been bootstrapped / does it
/// have an owner yet" during first-run setup, so a role predicate would evaluate against an empty
/// role, return zero rows, and wedge the cluster as permanently un-bootstrapped.
///
/// Every caller is server-side Go -- the identity store, the identity admin app, the PAT store, the
/// seed materializer -- and each now stamps auth.ContextWithInternalOrigin.
@serverOnly
query user activeUsers {
  args {
    role     string
    groupId  string
  }
  filter  isActiveRecord && when(args.role) { role==args.role } && when(args.groupId) { args.groupId in groupIds }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   userFull
}

// searchUsers backs the searchUsers MCP tool (#1682). The tool
// declares an optional `active` filter; before this query the handler
// was a bare `concept==v1:identity:user` scan that silently ignored
// `active` (and `limit`) and returned every user. The `active` predicate
// is arg-conditional: omit it to list all users, pass true/false to gate
// on liveness.
//
// Pagination (epic #1964 / memql#1975): this query declares ONLY `sort`
// (deterministic, keyset-eligible createdAt-desc order) and NO inner
// `paginate`. The dynamic page window is applied by the searchUsers tool
// handler's OUTER paginate($args.limit) wrapper (dsl/memql/tools.memql). The
// inner query must NOT also declare `paginate` -- two nested paginate()
// directives are rejected by the engine ("multiple paginate() directives are
// not supported"), which broke the searchUsers tool for every call after the
// 5.3 backfill added an inner `paginate 50` while the wrapper was still there.
// `sort` (with no inner paginate) keeps this a bounded-list for the pagination
// audit while leaving the single window to the caller. A second paginated
// reader of this query would wrap its own paginate(); none exists today.
/// Search users, optionally gated by active status. Omit `active` to list active and deactivated
/// users alike; pass true to return only active users or false for only deactivated ones.
/// Owner-or-admin only. Backs the searchUsers tool.
///
/// memql#2883: `when(args.active)` is DROPPED when the arg is absent (authoring rules), so before
/// this gate `searchUsers()` with no arguments applied no predicate at all and returned every user
/// in the cluster in userFull -- every @pii field plus the cluster-wide auth role. It is also on the
/// agent tool surface (dsl/memql/tools.memql), so a prompt-injected or over-eager agent could pull
/// the whole user table.
///
/// requiresOwnerOrAdmin rather than @serverOnly, because unlike its three siblings this one has a
/// genuine client caller: the MCP tool. Gating by origin would delete the tool; gating by role keeps
/// it working for the administrators it was built for. This is the same gate #2860 put on userById.
query user searchUsers {
  args {
    active  boolean
  }
  filter  requiresOwnerOrAdmin && when(args.active) { active==args.active }
  sort    "row.createdAt", "desc"
  shape   userFull
}

// ---- queries/v1/identity/auditEventsByActor.memql ----

// auditEventsByActor - Audit events where the user was the actor
// ================================================================
//
// Returns audit-event rows whose actorUserId equals the supplied
// userId. Used by the user-history admin view ("show me everything
// Alice did").
//
// MemQL has no OR operator in its filter grammar (verified against
// the engine's expression parser as of 2026-05). To answer the
// general "audit events for a user" question -- which logically
// means actorUserId==X OR targetId==X -- callers run BOTH this
// query and auditEventsByTarget and merge the results on the
// client. The frontend dedupes on auditEvent.id when the same
// row would be returned by both (e.g. self-action events).
//
// Returns events regardless of category / action / outcome -- the
// admin view filters by those facets on the client.
//
// Arguments:
//   userId (string, required) - v1:identity:user.id of the actor
//
// Returns:
//   Zero or more audit-event rows in auditEventFull shape.
//

// AUDIT 2026-08-04 (memql#2987): was @public, now admin-gated. This does what
// the comment that used to sit here said should be done.
//
// The debt was real and worse than "not caller-scoped": auditEventFull
// projects actorEmail, targetEmail, sourceIP and userAgent, and the filter was
// a caller-supplied userId with no check that the caller IS that user. Any
// authenticated client could walk another user's audit history, PII included,
// by passing their id. @public enforced nothing -- it only suppressed the
// classifier.
//
// requiresOwnerOrAdmin as a top-level conjunct is the searchUsers precedent
// (memql#2883 / #2860), and it is the right shape here rather than
// @serverOnly: the admin UI consumes this over the wire, and admins hold the
// role, so the surface keeps working while everyone else is refused. It is a
// live actorEnvelope context-spec, evaluated in-process against the auth
// envelope -- not the `requiresClusterOwner` placeholder the old comment
// warned about, which is declared nowhere (memql#2983).
/// Audit events where actorUserId equals the supplied userId, restricted to the owner or an admin.
/// Pair with auditEventsByTarget for full per-user history (no OR operator in the filter grammar
/// yet).
query auditEvent auditEventsByActor {
  args {
    userId  string!
  }
  filter  actorUserId==args.userId && requiresOwnerOrAdmin
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   auditEventFull
}

// ---- queries/v1/identity/auditEventsByTarget.memql ----

// auditEventsByTarget - Audit events where the user was the target
// ==================================================================
//
// Returns audit-event rows whose targetId equals the supplied
// userId. Used by the user-history admin view ("show me everything
// done TO Alice"); covers events like role_changed, session_revoked,
// partition_grant_created where the actor was an admin acting on
// the user.
//
// Companion of auditEventsByActor: MemQL's filter grammar has
// no OR operator, so the general "audit history for a user" query
// runs both and merges on the client (dedupe on auditEvent.id).
// See auditEventsByActor for the full rationale.
//
// Arguments:
//   targetId (string, required) - v1:identity:user.id of the target
//
// Returns:
//   Zero or more audit-event rows in auditEventFull shape.
//

// AUDIT 2026-08-04 (memql#2987): was @public, now admin-gated. Companion of
// auditEventsByActor and identical in every way that matters -- same
// auditEventFull shape (actorEmail / targetEmail / sourceIP / userAgent), same
// caller-supplied id with no check, same fix. See that query for the full
// rationale.
/// Audit events where targetId equals the supplied targetId, restricted to the owner or an admin.
/// Pair with auditEventsByActor for full per-user history (no OR operator in the filter grammar
/// yet).
query auditEvent auditEventsByTarget {
  args {
    targetId  string!
  }
  filter  targetId==args.targetId && requiresOwnerOrAdmin
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   auditEventFull
}

// ---- queries/v1/identity/authCodeByCodeHash.memql ----

// authCodeByCodeHash - Look up an OAuth auth code by code hash
// =============================================================
//
// Hot path on the /oauth/token redemption endpoint: the handler
// hashes the inbound code and runs this query to find the matching
// row. Single-use (consumedAt), expiry (expiresAt), client_id and
// redirect_uri equality are all checked by the handler -- the query
// returns the row regardless of state so the handler can emit the
// correct OAuth error (invalid_grant, etc.).
//
// Soft-deleted rows are excluded by @skipDeleted. No isActiveRecord
// filter -- the authCode schema has no `active` field; liveness is
// governed by consumedAt + expiresAt.
//
// Arguments:
//   codeHash (string) - SHA-256 hex digest (lowercase) of the plain auth code
//
// Returns:
//   Zero or one auth-code row in authCodeFull shape.
//

/// Returns the auth code whose codeHash matches the argument. Zero or one result.
@unbounded("auth code by unique codeHash -- a credential lookup bounded to a single row")
query authCode authCodeByCodeHash {
  args {
    codeHash  string!
  }
  filter  codeHash==args.codeHash
  shape   authCodeFull
}

// ---- queries/v1/identity/oauthClientByClientId.memql ----

// oauthClientByClientId - Look up a dynamically-registered OAuth client
// ======================================================================
//
// Hot path on the /authorize + /oauth/token endpoints: when a client_id
// is not present in the static MEMQL_IDENTITY_REGISTERED_CLIENTS slice, the
// resolver falls back to this query to find the DB-backed row minted at
// POST /register (RFC 7591 dynamic client registration). Returns the row
// regardless of state so the handler can apply the redirect-URI matcher.
//
// Filters on the row id: createOAuthClient stamps `id: args.clientId`, so
// the row intrinsic IS the clientId and it is the leading column of the
// primary key -- PRIMARY KEY (id, "createdAt") -- rather than a JSON
// payload probe. The caller still passes the bare clientId -- resolveFullId
// expands a colon-free id against the query's bound concept (#2784).
//
// One behaviour change: a client_id containing a colon is now REJECTED by
// resolveFullId (non-canonical id) where the payload probe silently matched
// nothing. client_id is caller-supplied and unauthenticated here, but
// ResolveClient swallows the error and returns nil, so the handler still
// emits a clean invalid_client -- the only difference is one WARN log.
//
// The payload field stays: oauthClientFull projects it and the discovery /
// client-resolver paths read it off the payload.
//
// No caller scope -- registration + token redemption are unauthenticated,
// so there is nothing to bind to (classifies as 'other' in the per-row-authz
// audit, same as authCodeByCodeHash).
//
// Arguments:
//   clientId (string, required) - the public client_id issued at registration
//
// Returns:
//   Zero or one oauthClient row in oauthClientFull shape.
//

/// Returns the dynamically-registered OAuth client whose clientId matches the argument. Zero or one
/// result.
@unbounded("oauth client by unique clientId -- bounded to a single row")
query oauthClient oAuthClientByClientId {
  args {
    clientId  string!
  }
  filter  row.id==args.clientId
  shape   oauthClientFull
}

// ---- queries/v1/identity/authSessionByPreviousRefreshTokenHash.memql ----

// authSessionByPreviousRefreshTokenHash - Look up a session by the
// IMMEDIATELY-PREVIOUS refresh-token hash
// =========================================================================
//
// Companion to authSessionByRefreshTokenHash. Used by the
// rotator's grace-window fallback path: when a client presents a
// refresh token whose hash isn't the current refreshTokenHash, the
// rotator falls back to this query to find a session whose
// previousRefreshTokenHash matches. If a row comes back AND its
// previousRotatedAt is within the rotator's grace window, the
// rotator treats this as the "client aborted mid-response and is
// retrying" case and rotates again, re-issuing a fresh token pair.
//
// Why a separate query rather than a single OR-style filter: the
// MemQL query parser doesn't yet support OR over different fields
// in a single filter. Two queries + Go-side fallthrough is the
// idiomatic pattern (see also activeSpaces / privateCanvasStates).
//
// Arguments:
//   previousRefreshTokenHash (string) - SHA-256 hex digest (lowercase)
//
// Returns:
//   Zero or one session row in authSessionFull shape.
//

/// Returns the auth session whose previousRefreshTokenHash matches the argument. Used by the
/// rotator's grace-window fallback. Zero or one result.
@unbounded("auth session by unique previousRefreshTokenHash -- a credential lookup bounded to a single row")
query authSession authSessionByPreviousRefreshTokenHash {
  args {
    previousRefreshTokenHash  string!
  }
  filter  previousRefreshTokenHash==args.previousRefreshTokenHash
  shape   authSessionFull
}

// ---- queries/v1/identity/authSessionByRefreshTokenHash.memql ----

// authSessionByRefreshTokenHash - Look up a session by refresh token hash
// =========================================================================
//
// Hot path on the /auth/refresh endpoint: the rotator hashes the
// inbound refresh token and runs this query to find the matching
// session row, then runs idle / max-age / theft-detection checks.
//
// This is distinct from authSessionByTokenHash (which keys off
// the access-token hash for revocation middleware) because the
// access-token hash and refresh-token hash live in different fields:
//   tokenHash         -- access (bearer) token hash, set at session
//                        creation, never rotates.
//   refreshTokenHash  -- refresh token hash, rotates on every
//                        successful /auth/refresh call.
//
// Soft-deleted rows are excluded by @skipDeleted; revoked rows are
// returned regardless of revokedAt so the rotator can refuse them
// with the correct diagnostic.
//
// Arguments:
//   refreshTokenHash (string) - SHA-256 hex digest (lowercase) of the refresh token
//
// Returns:
//   Zero or one session row in authSessionFull shape.
//

/// Returns the auth session whose refreshTokenHash matches the argument. Zero or one result.
@unbounded("auth session by unique refreshTokenHash -- a credential lookup bounded to a single row")
query authSession authSessionByRefreshTokenHash {
  args {
    refreshTokenHash  string!
  }
  filter  refreshTokenHash==args.refreshTokenHash
  shape   authSessionFull
}

// ---- queries/v1/identity/authSessionByTokenHash.memql ----

// authSessionByTokenHash - Look up a bearer-token session by token hash
// ======================================================================
//
// Hot path: the auth middleware hashes the inbound bearer token and
// runs this query to decide whether the row has been revoked. Returns
// the latest version of the row (append-only semantics) including
// revokedAt; the caller branches on the timestamp.
//
// Intentionally does NOT filter on isActiveRecord -- a revoked row
// is still the row we need to find so the middleware can refuse the
// token. Soft-deleted (tombstoned) rows are excluded by the concept's
// @skipDeleted annotation.
//
// Arguments:
//   tokenHash (string) - SHA-256 hex digest (lowercase) of the bearer token
//
// Returns:
//   Zero or one session row, in authSessionFull shape.
//

/// Returns the auth session whose tokenHash matches the argument. Zero or one result.
@unbounded("auth session by unique tokenHash -- a credential lookup bounded to a single row")
query authSession authSessionByTokenHash {
  args {
    tokenHash  string!
  }
  filter  tokenHash==args.tokenHash
  shape   authSessionFull
}

// ---- queries/v1/identity/authSessionsForSubject.memql ----

// authSessionsForSubject - List bearer-token sessions for a JWT subject
// ======================================================================
//
// Backs the all-sessions revoke fan-out: the gRPC handler reads the
// caller's JWT `sub` from the AccessContext, then runs this query to
// list every row to revoke. Subject is the canonical key because
// session rows are written at token-issuance time -- which can race
// ahead of the magic-link verifier's user-row insert on first-time
// logins, leaving userId transiently empty.
//
// Intentionally does NOT filter on isActiveRecord -- callers want
// to see revoked rows too (to skip them, not to revoke them again).
// Soft-deleted (tombstoned) rows are excluded by @skipDeleted on the
// concept.
//
// Arguments:
//   subject (string) - JWT sub claim (canonical v1:identity:user.id)
//
// Returns:
//   Zero or more session rows in authSessionFull shape.
//

/// Returns every auth-session row owned by the given JWT subject. Latest version per row, including
/// revoked rows.
query authSession authSessionsForSubject {
  args {
    subject  string!
  }
  filter  subject==args.subject
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   authSessionFull
}

// ---- queries/v1/identity/clusterSettingsCurrent.memql ----

// clusterSettingsCurrent - Read the active cluster-settings row
// =============================================================
//
// Returns the singleton v1:identity:clusterSettings row keyed by
// id="cluster". Time-series semantics keep the latest insert
// effective; the engine returns the most recent version automatically.
//
// Backs the admin UI's settings page (Phase 6) and the
// LiveSettings reader the web layer uses to override env defaults
// without redeploying.
//
// Returns:
//   Array with 0 or 1 cluster-settings record in clusterSettingsFull shape.
//   Empty when the first-run wizard hasn't completed yet -- callers
//   fall back to env-derived defaults.
//
// Filter: pin to id=="cluster" (the canonical singleton key). Without
// the id filter the query scans ALL v1:identity:clusterSettings rows
// and returns one per distinct id; if a stale or miskeyed row exists
// alongside the canonical one, Nodes[0] can be either row depending
// on scan order -- non-deterministic across replicas (#1807).
//
// id=="cluster" is a short-slug filter. The engine's resolveFullId
// expands it to the full storage id "v1:identity:clusterSettings:cluster"
// before the SQL WHERE clause is built, so it correctly matches the
// row the writer inserted via createClusterSettings({id:"cluster",...}).
// The comment that led to this filter being removed previously mentioned
// `_system:v1:identity:clusterSettings:cluster` -- that prefix was
// retired when partition-scoping was removed; the current canonical form
// is plain `v1:identity:clusterSettings:cluster`.

/// Latest singleton cluster-settings row, pinned to id=cluster.
query clusterSettings clusterSettingsCurrent {
  filter  row.id=="cluster"
  shape   clusterSettingsFull
}

// ---- queries/v1/identity/delegationsByIdentity.memql ----

// delegationsByIdentity - Get Delegations by Identity
// =========================================================
//
// Returns all delegations (active and revoked) for a given identity ID.
// Used to audit delegation history for an identity.
//
// Arguments:
//   identityId (string, required) - The identity identifier
//
// Returns:
//   Array of delegation records in delegationFull shape
//
// Usage:
//   delegationsByIdentity({identityId: "id-user-alice"})
//

/// Get all delegations (active and revoked) for a given identity ID
@unbounded("delegations for an identity -- a small bounded set consumed whole for authz")
query delegation delegationsByIdentity {
  args {
    identityId  string!
  }
  filter  identityId==args.identityId
  shape   delegationFull
}

// ---- queries/v1/identity/expiredActiveDelegations.memql ----

// expiredActiveDelegations - Get Expired Active Delegations
// ==============================================================
//
// Returns all delegations that are active but have passed their expiry
// time. Used by the expireDelegations automation to find delegations
// to deactivate.
//
// The cutoff is passed in as the `now` arg (rather than referencing the
// clock inline) because the memQL query planner rejects the timestamp
// call-form AST node in filter comparisons ("unsupported literal type
// *ast.TimestampExprFunc"). The automation supplies the arg from the bare
// reserved `now` identifier at the call site so the resulting value is a
// plain datetime. Matches the expireGuestInvitations /
// expiredPendingGuestInvitations pattern.
//
// Returns:
//   Array of expired delegation records in delegationFull shape
//
// Usage:
//   expiredActiveDelegations({ now: now })
//

/// Active delegations whose expiresAt is before the supplied cutoff.
@unbounded("expired-delegation reaper sweep -- an internal sweep that must see all")
query delegation expiredActiveDelegations {
  args {
    asOf  string!
  }
  filter  isActiveRecord && expiresAt<args.asOf
  shape   delegationFull
}

// ---- queries/v1/identity/expiredAuditEvents.memql ----

// expiredAuditEvents - All audit events (the retention sweep iterates)
// =====================================================================
//
// Returns every audit-event row. The auditEventRetentionSweep cron
// iterates the result and per-row tests
// `addDuration(item.auditEvent.occurredAt, "P{N}D") < now` to
// decide whether the row is past
// MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS. NOTE (#2369): the old claim
// that "per-row windowing in the automation is the only path" is
// FALSE -- the filter restriction is on function calls, not arg-cutoff
// comparisons, and addDuration takes negative ISO durations (the
// cluster stale-node prune has shipped that shape since #1642). The
// clean pattern is cutoff-in-logic + a when(args.cutoff) filter here,
// as expiredPendingAccessRequests now does.
//
// Note: as of writing, MemQL has no row-removal mutation -- the AST
// defines only Insert and Update. The retention sweep can soft-mark
// rows (a future updateAuditEventTombstone mutation would set
// `tombstoned: true`) or just log "would expire N rows" until a
// hard-delete path lands. The query side is stable either way.
//
// Returns:
//   Zero or more audit-event rows in auditEventFull shape.
//

/// All audit events; the retention sweep iterates and per-row checks occurredAt + retention-days <
/// now.
@unbounded("expired audit-event retention purge sweep -- an internal sweep that must see all")
query auditEvent expiredAuditEvents {
  filter  action!=""
  shape   auditEventFull
}

// ---- queries/v1/identity/expiredConsumedAuthCodes.memql ----

// expiredConsumedAuthCodes - Auth codes past their expiry
// =========================================================
//
// Returns CONSUMED auth-code rows whose expiresAt is before the
// supplied `now` cutoff. RFC 6749 mandates a ~60s TTL for auth codes,
// so rows churn quickly; a sweep keeps the table compact.
//
// memql#1714: the filter gates on consumedAt!="" so behaviour matches
// the name. An unspent-but-expired code is intentionally NOT returned
// here -- the consume handler may still be racing to redeem it, and a
// sweep keyed only on expiry could delete a row out from under an
// in-flight token exchange. Expiry-only cleanup of unspent codes is a
// separate concern; this query is the spent-code reaper.
//
// The `now` cutoff is passed in as an arg (rather than referencing the
// clock inline) per the pattern in expiredActiveDelegations.
//
// Arguments:
//   now (string) - cutoff timestamp (ISO 8601)
//
// Returns:
//   Zero or more auth-code rows in authCodeFull shape.
//

/// CONSUMED auth codes whose expiresAt is before the supplied cutoff. Both predicates are
/// load-bearing: the name says `Consumed`, so the consumedAt gate (memql#1714) keeps the result set
/// to spent-then-expired codes and never sweeps an unspent-but-expired code that a redemption is
/// still racing against.
@unbounded("expired consumed auth-code GC sweep -- an internal sweep that must see all")
query authCode expiredConsumedAuthCodes {
  args {
    asOf  string!
  }
  filter  expiresAt<args.asOf && consumedAt!=""
  shape   authCodeFull
}

// ---- queries/v1/identity/expiredMagicLinkRequests.memql ----

// expiredMagicLinkRequests - Magic-link requests past their expiry
// =================================================================
//
// Returns magic-link request rows whose expiresAt is before the
// supplied `now` cutoff. Used by the magicLinkExpirySweep cron to
// retire stale rows. Returns rows regardless of consumedAt -- the
// cron decides what to do with them (a consumed-then-expired row
// is identical to an expired row from the consume handler's POV).
//
// The `now` cutoff is passed in as an arg (rather than referencing the
// clock inline) for the same reason as expiredActiveDelegations: the memQL
// query planner rejects the timestamp call-form AST node in filter
// comparisons. The automation supplies it from the bare reserved `now`
// identifier at the call site.
//
// Arguments:
//   now (string) - cutoff timestamp (ISO 8601 / RFC 3339)
//
// Returns:
//   Zero or more magic-link request rows in magicLinkRequestFull shape.
//

/// Magic-link requests whose expiresAt is before the supplied cutoff.
@unbounded("expired magic-link GC sweep -- an internal sweep that must see all")
query magicLinkRequest expiredMagicLinkRequests {
  args {
    asOf  string!
  }
  filter  expiresAt<args.asOf
  shape   magicLinkRequestFull
}

// ---- queries/v1/identity/expiredPendingAccessRequests.memql ----

// expiredPendingAccessRequests - Pending access requests
// ========================================================
//
// Returns every access-request row whose status is "pending". Used
// by the accessRequestExpirySweep cron (daily 04:00 UTC): the cron
// iterates the result and per-row tests whether the row is older
// than IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS by comparing
// `addDuration(item.createdAt, "P{N}D") < now` before
// calling expireAccessRequest.
//
// MemQL parser limitation: filter expressions don't accept inline
// addDuration() calls, and addDuration accepts only positive
// ISO-8601 durations. Pushing "createdAt < now - N days" into the
// query is therefore impossible today -- the math has to live on
// the per-row side ("createdAt + N days < now"). The query stays
// simple and the automation does the windowing.
//
// The pending-status table is small (admin queue is typically <100
// rows even in busy clusters), so iterating all of it once a day
// is cheap.
//
// Returns:
//   Zero or more access-request rows in accessRequestFull shape.
//

/// Pending access requests; the expiry sweep iterates these and per-row checks createdAt +
/// expiry-days < now.
@unbounded("expired pending access-request sweep -- an internal sweep that must see all")
query accessRequest expiredPendingAccessRequests {
  args {
    createdBefore  string
  }
  filter  statusIsPending && when(args.createdBefore) { row.createdAt<args.createdBefore }
  shape   accessRequestFull
}

// ---- queries/v1/identity/invitationById.memql ----

// invitationById - Look Up an Invitation by ID
// ============================================
//
// Returns a single invitation record by its full node ID. Zero or one
// result. Used by handlers that already hold an invitation ID (e.g. the
// resend/cancel flow) to read the current version before writing an
// update.
//
// Arguments:
//   invitationId (string) - Full node ID, e.g. v1:identity:invitation:<uuid>
//                           (the partition prefix is re-added by memQL).
//

/// Returns the invitation with the given id. Zero or one result.
@unbounded("invitation by id (guarded) -- bounded to a single row")
query invitation invitationById {
  args {
    invitationId  string!
  }
  filter  when(args.invitationId) { row.id==args.invitationId }
  shape   invitationFull
}

// ---- queries/v1/identity/invitationByTokenHash.memql ----

// invitationByTokenHash - Look Up a Guest Invitation by Token Hash
// =================================================================
//
// Takes the SHA-256 hash of a guest invite token and returns the
// matching invitation record. Used by:
//   1. The guest-auth stream interceptor -- to resolve
//      `Authorization: Guest <token>` on every inbound request.
//   2. The ResolveGuestInvite gRPC handler -- to render the
//      /join/<token> landing page (inviter name + invitee email + any
//      product scope context).
//
// Returns the latest version of the invitation (append-only semantics)
// with any status. Callers are responsible for checking `status` and
// `expiresAt`.
//
// Arguments:
//   tokenHash (string) - SHA-256 hex digest (lowercase) of the plain token
//
// Returns:
//   Zero or one invitation record.
//

/// Returns the invitation whose tokenHash matches the argument. Zero or one result.
@unbounded("invitation by unique tokenHash -- a credential lookup bounded to a single row")
query invitation invitationByTokenHash {
  args {
    tokenHash  string!
  }
  filter  kind=="guest" && tokenHash==args.tokenHash
  shape   invitationFull
}

// ---- queries/v1/identity/invitationByPreviousTokenHash.memql ----

// invitationByPreviousTokenHash - Look Up a Guest Invitation by an Older Token Hash
// ==================================================================================
//
// Companion to invitationByTokenHash. After
// mutationRotateGuestInvitationToken runs (the resend path), the
// row's tokenHash is the FRESH hash and previousTokenHash is the
// one the row carried immediately before. A recipient who clicks
// the older /join/<token> link presents a token whose hash matches
// previousTokenHash but NOT tokenHash. This query catches that
// case so the resolve handler can return a UX-friendly
// `superseded` status instead of a generic `invalid`.
//
// Only matches the one-generation-back history -- two rotations
// back drops off and the link becomes plain-invalid. Guest auth
// (Authorization: Guest <token>) still only admits the CURRENT
// hash via invitationByTokenHash; this query never grants
// auth, it only feeds the friendlier 404 message.
//
// Reference: memql#108.
//
// Arguments:
//   tokenHash (string) - SHA-256 hex digest of the plain token the caller presented
//
// Returns:
//   Zero or one invitation record (latest version, append-only semantics).

/// Returns the invitation whose previousTokenHash matches the argument. Used by the resolve handler
/// to label rotated-out links as `superseded` rather than `invalid`. See memql#108.
@unbounded("invitation by unique previousTokenHash -- a credential lookup bounded to a single row")
query invitation invitationByPreviousTokenHash {
  args {
    tokenHash  string!
  }
  filter  kind=="guest" && previousTokenHash==args.tokenHash
  shape   invitationFull
}

// ---- queries/v1/identity/magicLinkRequestByTokenHash.memql ----

// magicLinkRequestByTokenHash - Look up a magic-link request by token hash
// =========================================================================
//
// Hot path on the unauthenticated /auth/magic-link/consume endpoint:
// the handler hashes the inbound plaintext token and runs this query
// to find the matching row. Single-use enforcement (consumedAt) and
// expiry (expiresAt) are checked by the handler, not here -- the
// query returns the row regardless of state so the handler can emit
// the right "expired" / "already_consumed" / "invalid" diagnostic.
//
// Soft-deleted (tombstoned) rows are excluded by the concept's
// @skipDeleted annotation. Intentionally does NOT filter on
// isActiveRecord -- the magicLinkRequest schema has no `active`
// field; row liveness is governed by consumedAt + expiresAt.
//
// Arguments:
//   tokenHash (string) - SHA-256 hex digest (lowercase) of the plain magic-link token
//
// Returns:
//   Zero or one magic-link request row in magicLinkRequestFull shape.
//

/// Returns the magic-link request whose tokenHash matches the argument. Zero or one result.
@unbounded("magic-link request by unique tokenHash -- a credential lookup bounded to a single row")
query magicLinkRequest magicLinkRequestByTokenHash {
  args {
    tokenHash  string!
  }
  filter  tokenHash==args.tokenHash
  shape   magicLinkRequestFull
}

// ---- queries/v1/identity/patIdentitiesForUser.memql ----

// patIdentitiesForUser - List PATs for a user
// ================================================
//
// Returns every v1:identity:identity row of identityType="api_key"
// owned by the given user, in patSummary shape (no credentials
// projected; the keyHash never escapes the engine on this path).
//
// Includes inactive (revoked) rows so the UI can show a "revoked"
// row in the listing for a few minutes after revocation if the user
// wants to confirm the action took effect. The Go caller filters /
// styles them.
//
// Arguments:
//   userId (string, required) - the v1:identity:user id
//
// Returns:
//   Array of PAT identity rows in patSummary shape (active + inactive).
//

// `@public` marks this query as intentionally not caller-scoped.
// Backs the user-facing /me/pats page; the caller has already
// been authenticated by the web layer and the userId arg is
// the authenticated subject. Tightening to `args.userId ==
// actor.userId` is a #54 follow-up; it requires the web
// handler to stop accepting an explicit userId and let the
// query derive it from the actor instead.
/// List PAT (api_key) identities owned by a user, in patSummary shape (no credentials).
// AUDIT 2026-08-04 (memql#2987): re-audited, KEPT @public for now, and the
// reason is recorded rather than left implicit -- this is the one group of the
// ten where the audit did NOT reach a conclusion it could ship.
//
// The debt is real: the filter keys on a caller-supplied userId with no check
// that the caller IS that user, so any authenticated client can enumerate
// another user's PAT metadata (patSummary -- no credential material, but names,
// creation and last-used times).
//
// The other two in the group are NOT the same shape, and saying so was wrong
// (corrected in the memql#3064 review, where the claim was checked rather than
// carried forward):
//
//   - badgesForUser projects identitySummary, which omits credentials. Same
//     shape as this one in the sense that matters.
//   - workerTokensForUser projects **identityFull**, which DOES project
//     `credentials` -- and for the worker_token variant that object carries
//     keyHash, registeredBy, lastSeenAt and lastConnectedFromIP. So that query
//     is materially identical to nodeTokenIdentityById, which this same audit
//     GATED: caller-supplied id, no actor check, credentials on the wire. It is
//     the worst item in this deferred group rather than a peer of the other
//     two, and memql#3063 is ranked accordingly.
//
// The obviously-right filter is `userId==actor.userId` ("your own
// credentials"). It is not a one-line change: the Go caller
// (component/identity/pat/store.go ListForUser) passes a userId argument, and
// whether every call site is the owner acting on themselves -- as /me/tokens
// is -- or an admin listing somebody else's, decides whether that filter
// breaks an admin surface. @serverOnly is the other candidate and is worse
// here: /me/tokens is a wire consumer, so removing it from the wire would
// break the settings UI.
//
// Deliberately NOT guessed. The node-token trio and the two audit-event
// queries in this same change were unambiguous and shipped; this group needs
// its call sites walked, and getting it wrong either leaves the hole open or
// breaks a live surface. Filed as memql#3063 with this analysis attached.
@public
query identity patIdentitiesForUser {
  args {
    userId  string!
  }
  filter  userId==args.userId && identityIsApiKey
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   patSummary
}

// ---- queries/v1/identity/patIdentityById.memql ----

// patIdentityById - Lookup PAT row by id (full shape, includes keyHash)
// ==========================================================================
//
// Returns the PAT identity row in identityFull shape -- includes the
// credentials.keyHash field. Used by the revoke / bump-lastUsedAt
// paths which need to re-stamp the keyHash on the new version row
// (memQL is append-only; updates write a new version that must
// preserve every variant-discriminator field).
//
// NEVER project this into UI surfaces -- it carries the SHA-256 hash
// of the token, which while not the plaintext should still stay
// server-side.
//
// Arguments:
//   identityId (string, required) - the v1:identity:identity id
//
// Returns:
//   Zero or one identity row in identityFull shape.
//

/// Lookup a PAT identity by id (full shape, includes keyHash). Server-side only -- never feed to
/// UI.
query identity patIdentityById {
  args {
    identityId  string!
  }
  filter  identityIsApiKey && row.id==args.identityId
  shape   identityFull
}

// ---- queries/v1/identity/patIdentityByKeyHash.memql ----

// patIdentityByKeyHash - Hot-path PAT lookup
// ===============================================
//
// Hot-path query for the gRPC interceptor: hash the inbound bearer
// token, look up the matching PAT identity row. Returns the row in
// identityFull shape (which includes credentials.keyHash, but the
// caller never re-emits that field -- it's the lookup key, not data
// to surface).
//
// The caller is responsible for following up with userById
// (using identity.userId) to materialize the owning user's claims.
//
// Returns the row even when active=false so the interceptor can
// stamp a precise audit reason ("token revoked") rather than a
// generic "not found".
//
// Arguments:
//   keyHash (string, required) - SHA-256 hex digest of the PAT plaintext
//
// Returns:
//   Zero or one identity row in identityFull shape.
//

/// Hot-path PAT lookup by keyHash for the gRPC interceptor. Returns active + inactive rows.
@unbounded("PAT identity by unique credential keyHash -- bounded to a single row")
query identity patIdentityByKeyHash {
  args {
    keyHash  string!
  }
  filter  identityIsApiKey && credentials.keyHash==args.keyHash
  shape   identityFull
}

// ---- queries/v1/identity/pendingAccessRequests.memql ----

// pendingAccessRequests - List access requests awaiting admin review
// ====================================================================
//
// Returns every access-request row whose status is "pending". Backs
// the admin console queue view: requests sorted on the client by
// createdAt descending (newest first) or by riskScore descending
// (most suspicious first), per the admin's preference.
//
// Returns:
//   Zero or more access-request rows in accessRequestFull shape.
//

/// Access requests with status=pending; backs the admin review queue.
query accessRequest pendingAccessRequests {
  filter  statusIsPending
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   accessRequestFull
}

/// Recent audit events, optionally filtered by category. Powers the admin audit-log view.
query auditEvent recentAuditEvents {
  args {
    category  string
  }
  filter  when(args.category) { category==args.category }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   auditEventFull
}

// ---- queries/v1/identity/userActiveSpace.memql ----

// userActiveSpace
// ===============
//
// Returns a single user's current activePartitionId. Frontend uses this to
// derive the per-participant isActive flag (a participant is active iff
// User.activePartitionId == participant.partitionId for that participant's
// userId).
//
// Phase 4 of the chat-architecture plan. Read-only counterpart of
// setUserActiveSpace.
//
// Subscribing to graph.node.created.v1:identity:user is the
// canonical way to react to a switch -- the user concept is global,
// so the partition slot is _system; the rewriter handles that.

/// Returns a user's current activePartitionId. Empty when the user is not focused on any space.
/// memql#2800: deliberately cross-user, and acknowledged as such.
///
/// The frontend derives per-participant `isActive` from it (a participant is
/// active iff User.activePartitionId == participant.partitionId), so resolving
/// OTHER users is the entire purpose -- caller-scoping would break presence in
/// every space. It is safe to leave open because the projection carries no
/// PII: userActiveSpaceProjection is id + activePartitionId and nothing else.
///
/// The `when(args.userId)` guard was removed. userId is declared required, so
/// the guard should be unreachable -- but it made "no argument" mean "no
/// filter" rather than "no rows", i.e. an unfiltered dump of every user, on a
/// query whose only predicate it was. That is the wrong failure direction to
/// leave standing on the strength of a required-arg check elsewhere.
///
/// AUDIT 2026-08-04 (memql#2987): re-audited and KEPT @public. Re-verified
/// that userActiveSpaceProjection still projects id + activePartitionId and
/// nothing else -- the "shapes drift" risk that moved userByEmail to
/// @serverOnly in memql#2881 has not materialised here. Cross-user resolution
/// is load-bearing for presence, so this is the second kind of @public in this
/// repo (documenting intent) rather than the first (acknowledging a flag).
@public
@unbounded("the user's active-space projection by id -- bounded to a single row")
query user userActiveSpace {
  args {
    userId  string!
  }
  filter  row.id==args.userId && isActiveRecord
  shape   userActiveSpaceProjection
}

// ---- queries/v1/identity/userByEmail.memql ----

// userByEmail - Look up user by primary email
// =================================================
//
// Email-keyed user lookup. Used by:
//   - the identity-service magic-link verifier to dedup against
//     existing rows before inserting on a first-login
//   - the /login email-first flow to decide whether to issue a
//     magic-link to an existing user vs route a new email through
//     the registration-mode-appropriate stage.
//
// Arguments:
//   primaryEmail (string, required) - email to match against user.primaryEmail
//
// Returns:
//   Array with 0 or 1 user record in userFull shape.

/// Look up a user by primary email (the dedup key during bootstrap).
///
/// @serverOnly, and caller-scoping is not the alternative: every caller runs
/// during LOGIN, before an actor exists. The magic-link verifier calls this to
/// decide whether an address already belongs to a user, and the /login
/// email-first flow calls it to branch between magic-link and registration --
/// the lookup is part of working out WHO the caller is, so
/// `primaryEmail==actor.primaryEmail` is circular in exactly the way
/// `id==actor.userId` was on userById (memql#2800).
///
/// Left open it projected userFull -- every @pii field, plus the cluster-wide
/// auth role -- keyed on the one identifier an attacker is most likely to
/// already have, so no id enumeration was needed. userByIdSystem returns the
/// identical shape and was gated by #2860; this one was missed (memql#2881).
///
/// It is NOT the worst reader of this shape, and saying so here because the
/// next person to gate one should start from the right end: searchUsers,
/// activeUsers, usersScheduledForDeletion and usersInDeletionCooldown all
/// return userFull and are all reachable from the wire today. searchUsers is
/// the extreme -- its only predicate is `when(args.active) { ... }`, which is
/// DROPPED when the arg is absent, so calling it with no arguments returns
/// every user in the cluster, and it is exposed to agents as an MCP tool.
/// Tracked in memql#2883.
@serverOnly
@unbounded("user by unique primaryEmail -- bounded to a single row")
query user userByEmail {
  args {
    primaryEmail  string!
  }
  filter  primaryEmail==args.primaryEmail && isActiveRecord
  shape   userFull
}

// ---- queries/v1/identity/userById.memql ----

// userById - Get user by id
// ==============================
//
// Returns a v1:identity:user record by its id.
//
// NOT the auth hot path. This comment used to say the access middleware
// reads `sub -> userById` to build the actor; it does not, and has not
// since #2800 (memql#2984). The bootstrap read is `userByIdSystem`,
// which is @serverOnly for exactly that circularity --
// component/auth/identity_resolver.go:79.
//
// This query is the caller-facing one and is gated by
// requiresOwnerOrAdmin: its filter keys on a caller-supplied id, so
// reading someone else's full row requires being them or holding
// admin/owner.
//
// Arguments:
//   userId (string, required) - the v1:identity:user id
//
// Returns:
//   Array with 0 or 1 user record in userFull shape.

/// Get a user by id -- FULL row, owner-or-admin only.
///
/// memql#2800: the filter keys on a caller-supplied id, so it is not a caller
/// check. Reading someone else's full row now requires being them or holding
/// admin/owner.
query user userById {
  args {
    userId  string!
  }
  filter  row.id==args.userId && isActiveRecord && requiresOwnerOrAdmin
  shape   userFull
}

/// Get a user by id -- SERVER-SIDE ONLY, full row, no caller scoping.
///
/// memql#2800. This is the construct the authentication path itself calls:
/// component/auth/identity_resolver.go resolves the JWT `sub` claim to a user
/// row in order to BUILD the actor. Scoping it to actor.userId would be
/// circular and would fail auth for everyone, which is why the exposure could
/// not simply be closed by copying currentUser's filter.
///
/// @serverOnly is enforced at execution against auth.CallOrigin -- unlike the
/// retired @internal (#2620 / #2708), which only hid a construct from
/// discovery surfaces while leaving it callable. A client-originated call
/// reaching this name is refused by name.
///
/// Callers must stamp auth.ContextWithInternalOrigin. Present ones: the
/// identity resolver, the identity store, the identity admin app, the
/// computer-use kill-switch reads, and the agent worker store.
@serverOnly
query user userByIdSystem {
  args {
    userId  string!
  }
  filter  row.id==args.userId && isActiveRecord
  shape   userFull
}

/// Resolve a user id to a display name. Client-callable for any user.
///
/// memql#2800: the cross-user read that rosters, mentions and participant
/// lists actually need. Deliberately projects userDisplayCard (id +
/// displayName) and nothing else, so a cross-user lookup cannot return PII.
///
/// AUDIT 2026-08-04 (memql#2987): re-audited and KEPT @public. Re-verified
/// that userDisplayCard is still id + displayName -- this is the narrow
/// counterpart deliberately carved out of userByIdSystem above, and its whole
/// value is that a caller can resolve a name WITHOUT reaching userFull. The
/// pairing is the point: the wide read is @serverOnly, the narrow one is open.
@public
query user userDisplayById {
  args {
    userId  string!
  }
  filter  row.id==args.userId && isActiveRecord
  shape   userDisplayCard
}

// ---- queries/v1/identity/currentUser.memql ----

// currentUser - the caller's own user record
// ==========================================
//
// Returns the authenticated caller's v1:identity:user row. The
// authorizerId -> userId resolution happens at auth time, so the
// caller never passes an id -- the filter binds to actor.userId
// server-side. Backs the SPA boot path (useCurrentUser): the
// browser holds the OIDC subject but the user payload doesn't carry
// authorizerId (it lives on the associated v1:identity:identity row),
// so a self-scoped query is the correct lookup rather than an
// authorizerId filter.
//
// Returns:
//   Array with 0 or 1 user record in userFull shape.

/// Get the authenticated caller's own user record. Self-scoped via actor.userId (no args) -- the
/// caller cannot read another user's row.
@mcp
@actor
query user currentUser {
  filter  row.id==actor.userId && isActiveRecord
  shape   userFull
}

// ---- queries/v1/identity/userCount.memql ----

// userCount - Count of active users
// =================================
//
// Returns the cardinality of the active-user set as a self-describing
// {count: N} aggregate, computed server-side via the `count` query
// directive. Mirrors activeUsers' filter without the optional
// role / groupId filters; the admin dashboard only needs the count.
//
// Returns:
//   {count: N} -- N is the number of active v1:identity:user rows.
//

/// Count of active v1:identity:user rows. Returns a {count: N} aggregate.
query user userCount {
  filter  isActiveRecord
  count
}

// ---- queries/v1/identity/usersActiveInSpace.memql ----

// usersActiveInSpace
// ==================
//
// Returns the set of users whose activePartitionId pointer matches the
// supplied partitionId -- i.e., humans CURRENTLY focused on the given
// space (camera, mic, voice transport bound here per the activity
// model).
//
// Phase 7 of the chat-architecture plan -- backs the voice-migration
// trigger automation. Read by voiceMigrationOnSecondHuman to count
// active humans in a space when a user's activePartitionId changes; the
// 1-to-2 transition fires the migration canvas cards.
//
// Note: a user with an empty activePartitionId is "in the app but not on
// any space" -- they don't appear here. The query result count IS the
// active-human count for the space.

/// Returns users whose activePartitionId == arg(partitionId). Active-human roster per the activity
/// model (Phase 4).
@unbounded("users whose activePartitionId matches a space -- bounded by space membership, presence resolution consumed whole")
query user usersActiveInSpace {
  args {
    partitionId  string!
  }
  filter  when(args.partitionId) { activePartitionId==args.partitionId }
  shape   userActiveSpaceProjection
}

// ---- queries/v1/identity/usersInDeletionCooldown.memql ----

// usersInDeletionCooldown - Users currently inside the deletion cooldown window
// ===============================================================================
//
// Returns active users whose deletionScheduledAt is non-empty. Used by:
//
//   1. The accountDeletionReminder7Days / accountDeletionReminder25Days
//      crons -- they iterate the result and per-row check whether
//      (now - deletionScheduledAt) is roughly 7 or 25 days,
//      sending one reminder email per match. Per-row math uses
//      `addDuration(item.user.deletionScheduledAt, "P7D")` /
//      `"P8D"` to bracket a 24-hour window.
//   2. A future settings-page handler -- "do I have a pending deletion?".
//      The handler will branch on whether the matched row's
//      deletionScheduledAt + cooldown is still in the future.
//
// Same filter shape as usersScheduledForDeletion (active +
// deletionScheduledAt set); the two queries exist so future call
// sites can discover the right one by name. If no further
// disambiguation lands, they may be merged into one canonical name.
//
// Returns:
//   Zero or more user rows in userFull shape.
//

/// Active users with a pending deletionScheduledAt; consumers per-row check cooldown windows via
/// addDuration.
///
/// @serverOnly (memql#2883). It takes NO arguments and projects userFull, so a client-originated
/// call returned every cooling-off user's full row -- every @pii field plus the cluster-wide auth
/// role -- with no predicate to constrain it.
///
/// Scoping it to actor.userId is NOT the fix. This is a scheduled sweep, not a self-service read:
/// there is no actor at all when it runs, and its purpose is precisely to see every OTHER user in
/// the cooldown window -- which is what its `@unbounded` reason already records. An actor.userId
/// filter would return at most the sweeping actor's own row and silently stop the reminder emails.
/// Its only callers are the accountDeletionReminder7Days / accountDeletionReminder25Days logics,
/// which run as automation steps and therefore reach it with OriginInternal stamped by executeStep.
@serverOnly
@unbounded("deletion-cooldown sweep -- an internal sweep that must see all")
query user usersInDeletionCooldown {
  filter  isActiveRecord && isDeletionScheduled
  shape   userFull
}

// ---- queries/v1/identity/usersScheduledForDeletion.memql ----

// usersScheduledForDeletion - Users whose deletionScheduledAt is set
// ====================================================================
//
// Returns active users whose deletionScheduledAt is non-empty. The
// accountDeletionSweep cron iterates the result and per-row checks
// whether the cooldown has elapsed
// (deletionScheduledAt + MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS < now)
// before calling deleteUserHard.
//
// Active-only: a user already hard-deleted (active=false, PII
// scrubbed) is filtered out so a re-run of the sweep doesn't churn
// audit log entries against tombstoned rows.
//
// MemQL parser limitation: filter expressions don't accept inline
// addDuration() calls (the planner rejects function-call literals
// in filter comparisons), so we cannot push the cooldown math down
// to the query. The automation does it per-row via
// `if addDuration(item.user.deletionScheduledAt, "P{N}D") < now`.
// `addDuration` only accepts positive ISO-8601 durations -- there
// is no negative-duration literal -- so the math has to live on the
// "deadline-vs-now" side of the comparison, not "now-minus-cooldown".
//
// Returns:
//   Zero or more user rows in userFull shape.
//

/// Active users whose deletionScheduledAt is set. When scheduledBefore is supplied, restricts to
/// rows whose deletionScheduledAt is strictly before it -- the deletion sweep's logic computes the
/// cutoff (now - MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS) and pushes it down (#2369).
///
/// @serverOnly (memql#2883). Same reasoning as usersInDeletionCooldown: `scheduledBefore` is
/// optional, so with no arguments the filter reduces to "active and scheduled" and the query
/// returns every such user in userFull.
///
/// Scoping it to actor.userId is NOT the fix, for the same reason: this is the deletion sweep's
/// candidate list, it runs on a cron with no actor, and it must see every OTHER user whose cooldown
/// has elapsed. An actor.userId filter would empty the candidate set and silently stop account
/// deletion -- a data-retention obligation failing closed-looking-but-broken. Its only caller is the
/// accountDeletionSweep logic, which runs as an automation step and reaches it with OriginInternal.
@serverOnly
@unbounded("scheduled-deletion sweep -- an internal sweep that must see all")
query user usersScheduledForDeletion {
  args {
    scheduledBefore  string
  }
  filter  isActiveRecord && isDeletionScheduled && when(args.scheduledBefore) { deletionScheduledAt<args.scheduledBefore }
  shape   userFull
}

// ---- queries/v1/identity/workerPairingCodeByHash.memql ----

// workerPairingCodeByHash
// =============================
//
// Hot-path lookup for the gRPC Pair-aware stream interceptor.
// Hash the inbound XXXX-XXXX code from the Authorization: Pair
// header, look up the matching pairing-code row.
//
// Returns rows even when redeemedAt is non-empty so the
// interceptor / handler can stamp a precise audit reason
// ("already_redeemed") rather than a generic "not found".
//
// Arguments:
//   codeHash (string, required) - SHA-256 hex digest of the plain code.

/// Hot-path pairing-code lookup by codeHash for the Pair-aware gRPC interceptor.
@unbounded("worker pairing code by unique codeHash -- a credential lookup bounded to a single row")
query workerPairingCode workerPairingCodeByHash {
  args {
    codeHash  string!
  }
  filter  codeHash==args.codeHash
  shape   workerPairingCodeFull
}

// ---- queries/v1/identity/workerTokenByKeyHash.memql ----

// workerTokenByKeyHash - Hot-path worker-token lookup
// ==========================================================
//
// Hot-path query for the WorkerService gRPC interceptor: hash the
// inbound mql_wkr_<token>, look up the matching worker_token
// identity row.
//
// Returns rows even when active=false so the interceptor can stamp
// a precise audit reason ("token revoked") rather than a generic
// "not found".
//
// Arguments:
//   keyHash (string, required) - SHA-256 hex digest of the plain token
//
// Returns:
//   Zero or one identity row in identityFull shape.

/// Hot-path worker-token lookup by keyHash. Returns active + inactive rows.
@unbounded("worker token identity by unique credential keyHash -- bounded to a single row")
query identity workerTokenByKeyHash {
  args {
    keyHash  string!
  }
  filter  identityIsWorkerToken && credentials.keyHash==args.keyHash
  shape   identityFull
}

// ---- queries/v1/identity/workerTokensForUser.memql ----

// workerTokensForUser
// =========================
//
// Lists every worker_token identity owned by the user. Backs the
// admin / per-user device list used to surface "who minted what
// token, when, with which scope".
//
// CORRECTION (memql#3064 review): this block used to end "without exposing the
// keyHash". That was false and had been for as long as the shape was
// identityFull -- identityFull projects `credentials`, and the worker_token
// variant of that object carries keyHash, registeredBy, lastSeenAt and
// lastConnectedFromIP. The keyHash is a SHA-256 digest rather than the token
// itself, but it is credential material and lastConnectedFromIP is exactly the
// class of signal the audit queries in this same file were gated to protect.
// Recorded here rather than only in the tracker because the sentence that was
// wrong lived here, and someone reading the query is the person it misled.
//
// Arguments:
//   userId (string, required) - v1:identity:user.id

// AUDIT 2026-08-04 (memql#2987, closed by memql#3063): was @public, now
// @serverOnly. This was the worst item in that audit's deferred group; it is
// no longer deferred -- operator ruling during the memql#3064 landing.
//
// What was exposed: the filter keys on a CALLER-SUPPLIED userId with no check
// that the caller is that user, and identityFull projects `credentials`, which
// for the worker_token variant carries keyHash, registeredBy, lastSeenAt and
// lastConnectedFromIP. So any authenticated caller could read another user's
// worker-token digest and last-connect IP by passing their id. The keyHash is
// a SHA-256 rather than the token, so not directly replayable -- but
// lastConnectedFromIP is exactly the signal the audit queries in this same
// file were gated to protect. That made it materially identical to
// nodeTokenIdentityById, which memql#2987 GATED; it was deferred instead on a
// shape claim that had not been checked.
//
// The note that used to sit here said @serverOnly "would additionally require
// an allowlist entry and the argument for it, which is a second decision on
// top of the first". The entry is added, and the argument is the one already
// accepted for component/identity/pat: a credential store whose reads are
// server-initiated by construction. component/identity/workertoken is the same
// kind of package doing the same kind of work.
/// List worker-token identities owned by a user. memql#3063.
///
/// Why actor.userId scoping is not the fix: the one caller that matters is the
/// revoke ownership check in component/grpc/worker_token_handlers.go, and it
/// runs under contextWithSystemActor -- so `userId==actor.userId` would compare
/// against the SYSTEM actor and return zero rows for every real request. It
/// already passes the caller's own id as the argument; the problem was never
/// that the Go path was unscoped, it was that the query was reachable from the
/// wire with any id at all.
///
/// Narrowing the projection instead is not available either: the shape is
/// identityFull because the Go parser reads the nested `credentials` struct
/// (name, keyHash, registeredBy, expiresAt, capabilities, labels), and a shape
/// keys each projected path by its terminal segment -- so `credentials.keyHash`
/// would flatten to `keyHash` and the reader would stop finding the struct.
/// Dropping credentials outright removes registeredBy and expiresAt, which the
/// same parser needs.
///
/// So the boundary is origin, as it is for the node_token trio this mirrors.
@serverOnly
query identity workerTokensForUser {
  args {
    userId  string!
  }
  filter  identityIsWorkerToken && userId==args.userId
  // Pagination (5.2 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table token pull. The engine emits a
  // nextCursor on a full page; an inbound cursor (ExecuteQueryMsg.cursor)
  // continues the keyset scan. Literal page size -- the struct-query paginate
  // directive only accepts an integer literal, not an arg expression.
  sort     "row.createdAt", "desc"
  paginate 50
  shape    identityFull
}

// ---- queries/v1/identity/badgeByKeyHash.memql ----

// badgeByKeyHash - Hot-path badge lookup for the grant exchange
// =============================================================
//
// Hot-path query for POST /auth/badge/grant (memql#2513): hash the
// presented badge/device id, look up the matching badge identity
// row, mint a short-lived class="badge" grant token for its owner.
//
// Returns rows even when active=false so the grant handler can
// stamp a precise audit reason ("badge revoked") rather than a
// generic "not found".
//
// Arguments:
//   keyHash (string, required) - SHA-256 hex digest of the badge id
//
// Returns:
//   Zero or one identity row in identityFull shape.

/// Hot-path badge lookup by keyHash for the operator grant exchange. Returns active + inactive
/// rows.
@unbounded("badge identity by unique credential keyHash -- bounded to a single row")
query identity badgeByKeyHash {
  args {
    keyHash  string!
  }
  filter  identityIsBadge && credentials.keyHash==args.keyHash
  shape   identityFull
}

// ---- queries/v1/identity/badgesForUser.memql ----

// badgesForUser
// =============
//
// Lists every badge identity owned by the user. Backs the badge
// management surface (who registered what badge, when) without
// exposing the keyHash as a credential.
//
// Arguments:
//   userId (string, required) - v1:identity:user.id

// `@public` marks this query as intentionally not caller-scoped.
// Same auth shape as workerTokensForUser above (web-layer
// authentication; userId is the authenticated subject). Tightening
// tracked under #54.
/// List badge identities owned by a user. Projects identitySummary (id / userId / label / active)
/// -- NEVER credentials, so the badge keyHash (a low-entropy physical id's hash) is never exposed
/// on this public surface.
///
/// AUDIT 2026-08-04 (memql#2987): re-audited, KEPT @public for now. Same group
/// and same unresolved decision as patIdentitiesForUser -- see the note there.
/// component/identity/badge is likewise absent from the internal-origin
/// allowlist. Re-verified that the shape is still identitySummary and still
/// omits credentials, which is what keeps this the least urgent of the three.
@public
query identity badgesForUser {
  args {
    userId  string!
  }
  filter  identityIsBadge && userId==args.userId
  sort     "row.createdAt", "desc"
  paginate 50
  shape    identitySummary
}

// ---- queries/v1/identity/nodeTokenIdentityByBinding.memql ----

// nodeTokenIdentityByBinding
// ===============================
//
// Lookup helper for the bootstrap-minted identity-row persistence
// path (memql#343). Finds the v1:identity:identity row keyed on the
// (nodeType, nodeId) pair the bootstrap handler is processing, so
// the handler can stamp audit fields onto an existing row rather
// than insert a fresh one on every node restart.
//
// Returns rows even when active=false so the handler can detect
// "the operator revoked this token" and refuse to re-mint (rather
// than silently revive a revoked row by inserting a new one with
// the same (nodeType, nodeId)).
//
// Arguments:
//   nodeType (string, required) - bff / voice / cognition / agent / planner / workbench
//   nodeId   (string, required) - v1:cluster:node.id the credential authenticates
//
// Returns:
//   Zero or one identity row in identityFull shape.

// AUDIT 2026-08-04 (memql#2987): was @public, now @serverOnly.
//
// identityFull projects `credentials`, and the filter keys on a
// caller-supplied (nodeType, nodeId) pair with no caller check -- so any
// authenticated client could read a node's bootstrap credential row by
// guessing a binding that is not secret (the node types are published in
// CLAUDE.md and the ids are pod names). @public enforced nothing; the
// annotation only suppressed the classifier.
//
// @serverOnly IS runtime-enforced, against auth.CallOrigin
// (component/memql/engine.go). Every caller is component/identity/store.go,
// which is allowlisted in call_origin_conformance_test.go as "identity store
// internals, server-initiated", so the origin stamp is legitimate here rather
// than the request-derived stamp that was refuted on memql#2989.
//
// This is the userByEmail precedent from memql#2881: keep the server path
// working, remove the query from the wire.
/// Lookup a node_token identity by its (nodeType, nodeId) binding. memql#343.
///
/// Why actor.userId scoping is not the fix: a node_token row belongs to a
/// cluster NODE, not to a person. Its `userId` is the synthetic bootstrap user
/// the mint ran as (component/identity/http/node_bootstrap.go), never the id of
/// anyone who reads it -- so `userId==actor.userId` would match zero rows for
/// every real caller: the admin listing tokens is a human, and the bootstrap
/// handler resolving a binding has no resolved actor at all, since this runs
/// BEFORE the node has an identity. There is no caller to scope to, which is
/// what makes origin the only boundary that exists here.
@serverOnly
@unbounded("node-token identity by unique (nodeType,nodeId) binding -- bounded to a single row")
query identity nodeTokenIdentityByBinding {
  args {
    nodeType  string!
    nodeId    string!
  }
  filter  identityIsNodeToken && credentials.nodeType==args.nodeType && credentials.nodeId==args.nodeId
  shape   identityFull
}

// ---- queries/v1/identity/nodeTokenIdentities.memql ----

// nodeTokenIdentities
// ========================
//
// Lists every v1:identity:identity row of identityType="node_token"
// across the cluster. Backs the future /admin/tokens extension that
// surfaces bootstrap-minted credentials alongside PATs + worker
// tokens (see #343's follow-up admin UI work).
//
// Returns rows even when active=false so the admin UI can show
// revoked tokens explicitly (rather than ghosting them).

// AUDIT 2026-08-04 (memql#2987): was @public, now @serverOnly. The sharpest
// of the ten.
//
// It has NO filter at all -- `identityIsNodeToken` and nothing else -- and
// projects identityFull, which includes `credentials`. As a @public query
// that made every node credential in the cluster readable by any
// authenticated caller, in one unparameterised call.
//
// Same reasoning as nodeTokenIdentityByBinding above: the only caller is
// ListNodeTokenIdentities in component/identity/store.go (the /admin/tokens
// section), the package is allowlisted as server-initiated, and @serverOnly
// is enforced at runtime where @public was not.
/// List every node_token identity across the cluster (active + inactive). memql#343.
///
/// Why actor.userId scoping is not the fix: same as nodeTokenIdentityByBinding
/// above -- a node_token row's `userId` is the synthetic bootstrap user, not
/// any reader, so `userId==actor.userId` returns nothing for the admin who
/// consumes this. It is also a deliberate cluster-wide SWEEP: the /admin/tokens
/// section exists precisely to show every node's credential row, so a
/// per-caller filter would empty the surface it backs.
@serverOnly
@unbounded("all node-token identities -- a bounded cluster-node credential set consumed whole for verification")
query identity nodeTokenIdentities {
  filter  identityIsNodeToken
  shape   identityFull
}

// ---- queries/v1/identity/nodeTokenIdentityById.memql ----

// nodeTokenIdentityById
// ==========================
//
// Lookup a single node_token identity row by id. The filter is an
// id-intrinsic comparison on the signature-bound concept, so a BARE
// shortId resolves server-side (resolveFullId); canonical also accepted
// from internal callers.
// Backs the /admin/tokens revoke flow (memql#350) -- the handler
// resolves the form-submitted id to the live row, then issues the
// whole-replace revokeNodeTokenIdentity restating every
// credentials field.

// AUDIT 2026-08-04 (memql#2987): was @public, now @serverOnly. Third of the
// node-token trio, same reasoning -- identityFull projects `credentials` and
// the filter keys on a caller-supplied id. Its only caller is
// LookupNodeTokenIdentityById in component/identity/store.go (the /admin/tokens
// revoke flow), which now runs under an internal origin.
/// Lookup a single node_token identity row by id (bare shortId; the signature-bound filter resolves
/// it server-side). Drives the admin revoke path. memql#350.
///
/// Why actor.userId scoping is not the fix: same as its two siblings -- a
/// node_token row's `userId` is the synthetic bootstrap user rather than any
/// reader, so `userId==actor.userId` matches nothing for the admin driving the
/// revoke flow. The authorization that does apply is the admin gate on the
/// route (component/identity/admin/route_gate_test.go, memql#2934); origin
/// gating puts the DSL-side boundary where that authorization already lives.
@serverOnly
query identity nodeTokenIdentityById {
  args {
    identityId  string!
  }
  filter  identityIsNodeToken && row.id==args.identityId
  shape   identityFull
}
