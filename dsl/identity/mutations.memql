// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// account -- the operator's customer records
// ==========================================
//
// Every write stamps ownerUserId from actor.userId and never accepts
// it from caller args; the field is @serverSet, so an accept{} naming
// it would fail to LOAD rather than merely be wrong. Ownership is
// therefore immutable across the row's whole version history and a
// caller can neither create an account owned by someone else nor
// reassign an existing one.
//
// The two update-kind mutations below land on an EXISTING row, which
// is exactly the surface the row-authz write guard covers
// (component/memql/rowauthz_write_guard.go, memql#3174): the engine
// resolves the target row and refuses when its declared owner is not
// the actor, so the caller-supplied accountId cannot be pointed at
// another operator's customer. That guard is why these do not need
// @serverOnly -- see docs/internal/design/account-isolation-model.md.
//
// There is no restoreAccount and no hard delete. Un-archiving is
// deliberately out of this pass's scope (memql#3321 enumerates create /
// update / archive) and is a two-line sibling of archiveAccount when a
// surface needs it; hard delete does not exist in MemQL at all -- a
// write is an append onto the same id.

/// Create an account (an operator-managed customer record). Owned: ownerUserId is stamped from
/// actor.userId, so an operator can only ever create their own customer records. Opens at
/// status=active; the descriptive fields are all optional so a record can be created from a name
/// alone and filled in later.
@actor
mutate account createAccount {
  args {
    accountId            string!
    name                 string!
    description          string
    primaryContactName   string
    primaryContactEmail  string
    externalRef          string
  }
  insert {
    accept { name, description, primaryContactName, primaryContactEmail, externalRef }
    stamp {
      id: args.accountId
      ownerUserId: actor.userId
      status: "active"
      updatedAt: now
    }
  }
}

/// Update an account's descriptive fields. Partial read-merge: an omitted field keeps its current
/// value. Owned: ownerUserId is re-stamped from actor.userId so the write cannot transfer the row,
/// and the row-authz write guard refuses the call outright when the target row belongs to another
/// operator. status is NOT accepted here -- lifecycle transitions go through archiveAccount so the
/// transition timestamp is stamped with the status rather than beside it.
@actor
mutate account updateAccount {
  args {
    accountId            string!
    name                 string
    description          string
    primaryContactName   string
    primaryContactEmail  string
    externalRef          string
  }
  update {
    accept { name, description, primaryContactName, primaryContactEmail, externalRef }
    stamp {
      id: args.accountId
      ownerUserId: actor.userId
      updatedAt: now
    }
  }
}

/// Archive an account: flip status to archived and stamp archivedAt. The row is retained in full --
/// MemQL has no hard delete, and the operator's history of a closed customer is the point. Owned:
/// ownerUserId is re-stamped from actor.userId and the write guard refuses a target row the actor
/// does not own.
@actor
mutate account archiveAccount {
  args {
    accountId  string!
  }
  update {
    stamp {
      id: args.accountId
      ownerUserId: actor.userId
      status: "archived"
      archivedAt: now
      updatedAt: now
    }
  }
}

// account tokens -- the credential rows behind the two mutations below
// ====================================================================
//
// An account_token identity is a credential issued TO A USER ON BEHALF
// OF an account. userId is the SUBJECT; credentials.accountId is a
// binding. Nothing authenticates as an account
// (docs/internal/design/account-isolation-model.md 3.3, 3.4).
//
// Neither mutation is @serverOnly, and that is a decision rather than
// an omission: component/grpc is on call_origin_conformance_test.go's
// wire-path DENY list, so the one package that calls these CANNOT
// stamp internal origin, and marking them @serverOnly would make them
// permanently unreachable. The exposure is bounded differently instead:
//
//   create -- userId and mintedBy are stamped from actor.userId and
//     are NOT args, so a wire caller can only ever mint a credential
//     row subject to themselves. The accountId is caller-supplied and
//     unchecked HERE (the handler checks it by reading accountById as
//     the caller, where @rowAuthz decides); a raw call naming someone
//     else's account produces an inert row in the CALLER's own list,
//     because both reads gate on userId==actor.userId.
//
//   revoke -- a caller-supplied identityId with no actor check, which
//     is exactly the shape revokePATIdentity and
//     revokeWorkerTokenIdentity already have. Ownership is checked in
//     the handler via accountTokenById. The residual is that a raw
//     wire call can deactivate another operator's account_token row --
//     a nuisance against a credential that authorizes nothing, not a
//     disclosure. The real fix is a @rowAuthz(owner="userId")
//     declaration on v1:identity:identity, which would put all three
//     revokes behind the engine's write guard at once; that belongs to
//     memql#3173 (declaring tiers on the remaining concepts) rather
//     than to one credential family.
//
// keyHash is the SHA-256 of the plaintext. The plaintext never reaches
// the engine -- there is no arg for it -- so it cannot be persisted
// here even by mistake.

/// Create an account_token identity: a credential issued to the CALLING user on behalf of
/// args.accountId. The subject is the user; the account is a binding, never a second kind of
/// subject. userId and mintedBy are stamped from actor.userId and are deliberately not args, so the
/// mutation cannot mint a credential attributed to anyone but its caller. Stores only the SHA-256
/// hex digest -- plaintext lives at the caller for one-time display.
@actor
mutate identity createAccountTokenIdentity {
  args {
    identityId  string!
    accountId   string!
    label       string!
    keyHash     string!
    expiresAt   string
  }
  insert {
    id: args.identityId
    userId: actor.userId
    identityType: "account_token"
    credentials: {
        accountId: args.accountId,
        keyHash: args.keyHash,
        mintedBy: actor.userId,
        expiresAt: args.expiresAt ?? ""
      }
    label: args.label
    usableByAgents: false
    active: true
  }
}

/// Revoke (deactivate) an account_token identity row. Only `active` changes; identityType,
/// credentials and label inherit from the persisted row. Ownership is checked by the caller
/// (component/grpc/account_token_handlers.go reads accountTokenById as the CALLER first) -- see the
/// block comment above for why the check cannot live here yet.
mutate identity revokeAccountTokenIdentity {
  args {
    identityId  string!
  }
  update {
    id: args.identityId
    active: false
  }
}

/// Approve an access request (status=approved, stamps reviewer + invitation).
mutate accessRequest approveAccessRequest {
  args {
    requestId     string!
    reviewedBy    string!
    invitationId  string!
    reviewerNote  string
  }
  update {
    accept { reviewedBy, invitationId }
    stamp {
      id: args.requestId
      status: "approved"
      reviewedAt: now
      reviewerNote: args.reviewerNote ?? ""
    }
  }
}

// ---- mutations/v1/identity/bumpPATLastUsedAt.memql ----

// bumpPATLastUsedAt
// =================
//
// Updates the lastUsedAt stamp on a PAT identity row. Called by the
// gRPC interceptor on every accepted PAT request (best-effort; a
// failure here MUST NOT fail the request -- callers are expected to
// log the error and proceed).
//
// Re-stamps the other fields so the new version preserves the row's
// shape (identityType discriminator, credentials, active flag).

/// Bump the lastUsedAt stamp on a PAT identity. Best-effort; callers must not fail the request on
/// error. Read-merges the existing row so only lastUsedAt changes;
/// identityType/credentials/label/active/usableByAgents inherit from the persisted row instead of
/// being re-supplied (memql#1628).
mutate identity bumpPATLastUsedAt {
  args {
    identityId      string!
    lastUsedAt      string!
  }
  update {
    id: args.identityId
    args.lastUsedAt
  }
}

// ---- mutations/v1/identity/bumpUserDataExport.memql ----

// bumpUserDataExport
// ==================
//
// Stamps dataExportLastAt = now on a v1:identity:user row at the
// moment a /me/export download succeeds. Drives the rate-limiter
// per MEMQL_IDENTITY_DATA_EXPORT_RATE_LIMIT_HOURS so a single user can't
// generate exports faster than the configured cadence.
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field on the user. Only dataExportLastAt
// changes.
//
// Arguments:
//   userId  (string)  - User node ID
//

/// Stamp dataExportLastAt = now after a successful /me/export download.
mutate user bumpUserDataExport {
  args {
    userId  string!
  }
  update {
    id: args.userId
    dataExportLastAt: now
  }
}

// ---- mutations/v1/identity/bumpUserRevocationEpoch.memql ----

// bumpUserRevocationEpoch
// =======================
//
// Sets revocationEpoch on a v1:identity:user row. Callers compute
// the new value (current + 1) in Go because the MemQL grammar
// doesn't have an arithmetic operator on payload fields yet; we
// pass the next value through.
//
// This is the bulk-revoke admin path: bumping the row invalidates
// every JWT this user holds whose revocation_epoch claim is below
// the new value. The verifier rejects them on the next stream-open
// (immediate) and the per-stream re-check loop closes long-lived
// open streams within ~5 minutes (see memql#106 +
// component/identity/verifier/interceptor.go).
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field on the user. Only revocationEpoch changes.
//
// Arguments:
//   userId    (string, required)  - v1:identity:user.id
//   newEpoch  (int, required)     - the new monotonic value to stamp.
//                                   Must be strictly greater than the
//                                   current value; the caller is
//                                   responsible for the read-then-+1
//                                   round-trip.

/// Stamp revocationEpoch on the user row. Bulk-revoke admin path for memql#106. Caller computes the
/// +1 in Go.
mutate user bumpUserRevocationEpoch {
  args {
    userId    string!
    newEpoch  int!
  }
  update {
    id: args.userId
    revocationEpoch: args.newEpoch
  }
}

// ---- mutations/v1/identity/cancelScheduledDeletion.memql ----

// cancelScheduledDeletion
// =======================
//
// Reverses an in-flight account-deletion request by clearing
// deletionScheduledAt on a v1:identity:user row. The
// accountDeletionSweep cron only matches rows whose
// deletionScheduledAt is non-empty AND past the cooldown, so
// stamping an empty string is the canonical "not scheduled"
// encoding -- mirrors how the create paths leave optional
// datetime fields absent at insertion time.
//
// Sets to "" rather than null because the concept declares
// deletionScheduledAt as `datetime` (=> JSON-Schema string with
// format=date-time). Under Draft 2019 the format keyword is
// annotative by default, so an empty string passes payload
// validation; null would be rejected because type=string.
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field on the user.
//
// Arguments:
//   userId  (string)  - User node ID
//

/// Cancel a scheduled account deletion (clears deletionScheduledAt).
mutate user cancelScheduledDeletion {
  args {
    userId  string!
  }
  update {
    id: args.userId
    deletionScheduledAt: ""
  }
}

// ---- mutations/v1/identity/consumeAuthCode.memql ----

// consumeAuthCode
// ===============
//
// Stamps a v1:identity:authCode row as consumed at /oauth/token
// redemption. After this lands the token-exchange handler (and any
// future replay attempt) finds a non-nil consumedAt and rejects the
// code, auditing the second attempt as code_replay. Single-use
// enforcement is the load-bearing security property of OAuth auth
// codes. The application-level handler must check consumedAt before
// redemption to detect the replay condition.
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field (code, codeHash, clientId, redirectURI,
// userId, identityId, magicLinkRequestId, expiresAt). Only
// consumedAt and consumedFromIP change; everything else inherits.
//
// Arguments:
//   codeId          (string)            - Auth-code node ID
//   consumedFromIP  (string, optional)  - IP the redemption request came from
//

/// Mark an auth code consumed (stamps consumedAt = now).
mutate authCode consumeAuthCode {
  args {
    codeId          string!
    consumedFromIP  string
  }
  update {
    id: args.codeId
    consumedAt: now
    consumedFromIP: args.consumedFromIP ?? ""
  }
}

// ---- mutations/v1/identity/consumeMagicLinkRequest.memql ----

// consumeMagicLinkRequest
// =======================
//
// Stamps a v1:identity:magicLinkRequest row as consumed. After this
// lands the consume handler (and any future replay attempt) finds a
// non-nil consumedAt and rejects the token. Single-use enforcement
// is the load-bearing security property of magic links.
//
// Partial-update via update() (read-merge-validate-write) so the
// caller doesn't have to re-pass every @required field on the
// concept (email, tokenHash, expiresAt). Only consumedAt and
// consumedFromIP change; everything else inherits from the prior
// row.
//
// Arguments:
//   requestId       (string)            - Magic-link request node ID
//   consumedFromIP  (string, optional)  - IP the consume request came from
//

/// Mark a magic-link request consumed (stamps consumedAt = now).
mutate magicLinkRequest consumeMagicLinkRequest {
  args {
    requestId       string!
    consumedFromIP  string
  }
  update {
    id: args.requestId
    consumedAt: now
    consumedFromIP: args.consumedFromIP ?? ""
  }
}

// ---- mutations/v1/identity/approveMagicLinkRequest.memql ----

// approveMagicLinkRequest
// =======================
//
// Records that a human holding the emailed token clicked Continue in a
// browser that does NOT hold the binding cookie -- the cross-device
// case (design D2 / D4). This is an APPROVAL, not a sign-in: it mints
// nothing, sets no cookie, and hands the approving browser no
// credential at all. The requesting tab is polling
// GET /auth/magic-link/status; it sees `approved` and completes the
// sign-in itself, on the device that asked.
//
// The conditional half of "set these only if approvedAt and consumedAt
// are both empty" is enforced by the caller, Store.ApproveMagicLinkRequest,
// under the same advisory lock the consume takes. A DSL update{} is a
// read-merge-write with no predicate, so a guard written here would be
// decoration; the store re-reads the row inside the critical section
// and skips this mutation entirely when the row is already approved or
// already consumed. That is why the mutation itself is unconditional --
// by the time it runs the decision has been made.
//
// Arguments:
//   requestId          (string)            - Magic-link request node ID
//   approvedFromIP     (string, optional)  - IP of the approving device
//   approvedUserAgent  (string, optional)  - User-Agent of the approving device
//

/// Mark a magic-link request approved from another device (stamps approvedAt = now).
///
/// @serverOnly because the only thing that legitimately triggers this is a human clicking Continue
/// on the landing page while holding the emailed token, and the token is checked in Go before the
/// call. A wire-reachable version would let anyone who can name a request id approve it without
/// holding the token at all -- which is precisely the human confirmation the approve-on-click design
/// exists to require. Its sibling consumeMagicLinkRequest carries the same hazard and predates the
/// gate; it sits in callerArgSelectionExemptions as recorded debt rather than as a blessing, and a
/// new construct should not add to it.
///
/// actor.userId scoping is not the fix, and cannot be: an approval happens BEFORE anyone is
/// authenticated -- it is one step of signing in, and the whole point of the cross-device branch is
/// that the approving browser holds no session and gets none. actor.userId is empty for every
/// legitimate caller, so a self-scoped filter would match zero rows and refuse the only callers that
/// exist. The row also carries no user pointer to scope BY: a magic-link request names an email
/// address, which may not correspond to a user row at all until the link is consumed (first-time
/// registration mints the user at that moment).
@serverOnly
mutate magicLinkRequest approveMagicLinkRequest {
  args {
    requestId          string!
    approvedFromIP     string
    approvedUserAgent  string
  }
  update {
    id: args.requestId
    approvedAt: now
    approvedFromIP: args.approvedFromIP ?? ""
    approvedUserAgent: args.approvedUserAgent ?? ""
  }
}

// ---- mutations/v1/identity/createAccessRequest.memql ----

// createAccessRequest
// ===================
//
// Creates a v1:identity:accessRequest row when an unknown email
// submits the registration form while
// MEMQL_IDENTITY_REGISTRATION_MODE=approval. The row lands in the admin
// queue with status="pending" and surfaces the supplied risk
// context (riskScore + riskSignals) so admins can triage cleanly.
//
// reviewedBy / reviewedAt / reviewerNote / invitationId are
// intentionally omitted; they get populated by
// approveAccessRequest or rejectAccessRequest.
//
// Arguments:
//   requestId          (string)            - Access-request node ID (UUID-derived)
//   email              (string)            - Email the requester wants to register
//   name               (string, optional)  - Display name supplied at submission
//   additionalContext  (string, optional)  - Free-text rationale from the requester
//   riskScore          (int, optional)     - Composite risk score (0-100)
//   riskSignals        (string, optional)  - Comma-separated risk signal tags
//   sourceIP           (string, optional)  - IP the submission came from
//   userAgent          (string, optional)  - User-Agent header at submission
//

/// Create a self-service access request (waitlist row, status=pending).
mutate accessRequest createAccessRequest {
  args {
    requestId          string!
    email              string!
    name               string
    additionalContext  string
    riskScore          int
    riskSignals        string
    sourceIP           string
    userAgent          string
  }
  insert {
    id: args.requestId
    args.email
    name: args.name ?? ""
    additionalContext: args.additionalContext ?? ""
    status: "pending"
    riskScore: args.riskScore ?? 0
    riskSignals: args.riskSignals ?? ""
    sourceIP: args.sourceIP ?? ""
    userAgent: args.userAgent ?? ""
  }
}

// ---- mutations/v1/identity/createAuditEvent.memql ----

// createAuditEvent
// ================
//
// Append-only insertion into the security audit log. One row per
// security-relevant event with full actor + target + source
// attribution. The row is written after the underlying event
// completes (so occurredAt may lag createdAt by milliseconds), and
// every field is captured at point-in-time so a later edit to the
// user / role / etc. doesn't rewrite history.
//
// prevEventHash is reserved for the future hash-chain
// tamper-resistance pass; populated from day one but not validated
// in MVP.
//
// Arguments:
//   eventId          (string)            - Audit event node ID
//   occurredAt       (string)            - ISO 8601 timestamp the event happened
//   category         (string)            - Coarse grouping (auth/identity/authorization/configuration/admin/data)
//   action           (string)            - Machine-readable lower_snake_case action enum
//   actorUserId      (string, optional)  - v1:identity:user.id of the authenticated actor
//   actorEmail       (string, optional)  - Actor's email at time of event
//   actorRole        (string, optional)  - Actor's cluster role at time of event
//   actorIdentityId  (string, optional)  - v1:identity:identity used to authenticate
//   targetType       (string, optional)  - Concept type of the target row
//   targetId         (string, optional)  - Identifier of the target row
//   targetEmail      (string, optional)  - Email associated with the target
//   detail           (object, optional)  - Action-specific structured payload
//   sourceIP         (string, optional)  - Originating IP
//   userAgent        (string, optional)  - User-Agent header
//   correlationId    (string, optional)  - Groups related events from one logical interaction
//   outcome          (string, optional)  - success / failure / blocked
//   failureReason    (string, optional)  - Reason when outcome=failure or outcome=blocked
//   prevEventHash    (string, optional)  - Reserved hash-chain anchor
//

// createAuthActivity
// ==================
//
// The single write path for v1:identity:authActivity (memql#4328). Four
// Go writers reach it through identity.ActivitySink: the rotator's two
// outcomes, its grace-window acceptance, and the PAT verifier.
//
// @serverOnly. Every argument here is an assertion about an
// authentication that already happened -- which session, which user,
// which token hash was retired -- and a client-reachable version would
// let a caller manufacture activity history, including the
// retiredTokenHash that memql#4329's reuse detection keys on. The
// authorization that belongs in front of it is "the identity service
// verified this credential", which no DSL predicate can express.
//
// actorUserId IS STAMPED FROM THE ACTOR, not taken from args, and that
// is not a formality: the concept declares
// @rowAuthz(owner="actorUserId", clusterOwner), and
// TestDeclaredOwnerFieldsAreServerStamped hard-fails a declared owner
// field any mutation writes from caller args (its exemption list is
// empty and is meant to stay that way). The Go writers therefore run
// the write under auth.ContextWithUserActor for the user the SESSION
// resolved to -- the identity service knows whose session it is before
// the actor envelope does, because /auth/refresh is unauthenticated by
// construction. Where nothing resolved (session_not_found), the field
// lands empty and the row is a cluster owner's to read.
/// Record one routine authentication mechanic on the activity log. The single write path for
/// v1:identity:authActivity (memql#4328); four Go writers reach it through
/// identity.ActivitySink -- the rotator's two outcomes, its grace-window acceptance, and the
/// PAT verifier.
///
/// @serverOnly, and caller-scoping is not the alternative. Every argument is an assertion about
/// an authentication that ALREADY happened: which session, which credential, which token hash
/// the rotation retired. The check that belongs in front of it is "the identity service verified
/// this credential", which no filter over actor.userId can express. Scoping it to the caller
/// would also be wrong in substance: the row's owner is stamped from the actor the WRITER
/// borrows (the session's user), not from a requesting caller, because /auth/refresh is
/// unauthenticated by construction and the service knows whose session it is before the actor
/// envelope does. A client-reachable version would let a caller manufacture activity history --
/// including retiredTokenHash, the field memql#4329's reuse detection keys on.
@serverOnly
@actor
mutate authActivity createAuthActivity {
  args {
    activityId       string!
    occurredAt       string!
    action           enum("session_refreshed", "session_refresh_blocked", "grace_window_accept", "pat_auth_accepted")!
    outcome          enum("success", "blocked")!
    sessionId        string
    actorEmail       string
    actorRole        string
    actorIdentityId  string
    sourceIP         string
    userAgent        string
    clientLabel      string
    failureReason    string
    retiredTokenHash string
    detail           object
  }
  insert {
    id: args.activityId
    args.occurredAt
    args.action
    args.outcome
    actorUserId: actor.userId
    sessionId: args.sessionId ?? ""
    actorEmail: args.actorEmail ?? ""
    actorRole: args.actorRole ?? ""
    actorIdentityId: args.actorIdentityId ?? ""
    sourceIP: args.sourceIP ?? ""
    userAgent: args.userAgent ?? ""
    clientLabel: args.clientLabel ?? ""
    failureReason: args.failureReason ?? ""
    retiredTokenHash: args.retiredTokenHash ?? ""
    detail: args.detail ?? {}
  }
}

/// Append a row to the append-only security audit log.
mutate auditEvent createAuditEvent {
  args {
    eventId          string!
    occurredAt       string!
    category         enum("auth", "identity", "authorization", "configuration", "admin", "data")!
    action           string!
    actorUserId      string
    actorEmail       string
    actorRole        string
    actorIdentityId  string
    targetType       enum("user", "session", "identity", "invitation", "accessRequest", "config", "magicLinkRequest", "authCode", "clusterSettings", "deviceCode", "delegation", "workerPairingCode", "enrolmentToken", "passkeyIdentity", "badgeIdentity", "appSession", "shopifyStore", "releaseCut", "oauthClient", "upstreamIdentity", "rowOwnership")
    targetId         string
    targetEmail      string
    detail           object
    sourceIP         string
    userAgent        string
    correlationId    string
    outcome          enum("success", "failure", "blocked")
    failureReason    string
    prevEventHash    string
  }
  insert {
    id: args.eventId
    args.occurredAt
    args.category
    args.action
    actorUserId: args.actorUserId ?? ""
    actorEmail: args.actorEmail ?? ""
    actorRole: args.actorRole ?? ""
    actorIdentityId: args.actorIdentityId ?? ""
    targetType: args.targetType ?? ""
    targetId: args.targetId ?? ""
    targetEmail: args.targetEmail ?? ""
    detail: args.detail ?? {}
    sourceIP: args.sourceIP ?? ""
    userAgent: args.userAgent ?? ""
    correlationId: args.correlationId ?? ""
    outcome: args.outcome ?? ""
    failureReason: args.failureReason ?? ""
    prevEventHash: args.prevEventHash ?? ""
  }
}

// ---- mutations/v1/identity/createAuthCode.memql ----

// createAuthCode
// ==============
//
// Persists a v1:identity:authCode row at the moment a magic-link
// consume mints a one-time OAuth authorization code (RFC 6749
// §4.1). The code is single-use, redirect-URI bound, client-ID
// bound, and ~60s TTL; the token-exchange handler verifies all
// three at redemption time.
//
// consumedAt / consumedFromIP are intentionally omitted; they get
// stamped by consumeAuthCode at /oauth/token redemption.
//
// Arguments:
//   codeId              (string)            - Auth-code node ID (UUID-derived)
//   codeHash            (string)            - SHA-256 hex of code; primary lookup key
//   clientId            (string)            - OAuth client identifier
//   redirectURI         (string)            - Exact-matched redirect URI for clientId
//   state               (string, optional)  - PKCE-style state value echoed back
//   userId              (string)            - v1:identity:user.id the code authenticates
//   identityId          (string)            - v1:identity:identity.id of the magic_link credential
//   magicLinkRequestId  (string)            - v1:identity:magicLinkRequest.id this code was minted from
//   expiresAt           (string)            - Absolute expiration (~60s after creation)
//

/// Mint a one-time OAuth authorization code from a consumed magic link.
mutate authCode createAuthCode {
  args {
    codeId              string!
    codeHash            string!
    clientId            string!
    redirectURI         string!
    state               string
    codeChallenge       string
    codeChallengeMethod string
    userId              string!
    identityId          string!
    magicLinkRequestId  string!
    expiresAt           string!
  }
  insert {
    accept { codeHash, clientId, redirectURI, userId, identityId, magicLinkRequestId, expiresAt }
    stamp {
      id: args.codeId
      state: args.state ?? ""
      codeChallenge:       args.codeChallenge ?? ""
      codeChallengeMethod: args.codeChallengeMethod ?? ""
    }
  }
}

// ---- mutations/v1/identity/createOAuthClient.memql ----

// createOAuthClient
// =================
//
// Persists a v1:identity:oauthClient row at the moment a client
// self-registers via POST /register (RFC 7591 dynamic client
// registration). claude.ai / Claude Desktop's 'add custom connector'
// flow cannot pre-configure a client_id, so the identity service mints
// one (prefix mcp_) and stores the registration metadata here. The row
// is then resolved at /authorize + /oauth/token exactly like a static
// MEMQL_IDENTITY_REGISTERED_CLIENTS entry.
//
// Public clients only: no secret is issued, so there is no secretHash
// column. redirectURIsJSON is a JSON array string (the engine doesn't
// support nested arrays of objects in concept fields, mirroring
// clusterSettings.registeredClientsJSON). The optional grant /
// response / auth-method strings default to "" via coalesce.
//
// Arguments:
//   clientId                 (string)            - Public client_id (id of the row)
//   clientName               (string, optional)  - Human-readable client_name
//   redirectURIsJSON         (string)            - JSON array of registered redirect_uris
//   grantTypes               (string, optional)  - Space-/comma-joined grant_types
//   responseTypes            (string, optional)  - Joined response_types
//   tokenEndpointAuthMethod  (string, optional)  - Client auth method (public => none)
//   registeredAt             (string)            - RFC3339 registration time
//

/// Persist a dynamically-registered public OAuth client (RFC 7591).
mutate oauthClient createOAuthClient {
  args {
    clientId                 string!
    clientName               string
    redirectURIsJSON         string!
    grantTypes               string
    responseTypes            string
    tokenEndpointAuthMethod  string
    registeredAt             string!
  }
  insert {
    accept { clientId, redirectURIsJSON, registeredAt }
    stamp {
      id: args.clientId
      clientName: args.clientName ?? ""
      grantTypes: args.grantTypes ?? ""
      responseTypes: args.responseTypes ?? ""
      tokenEndpointAuthMethod: args.tokenEndpointAuthMethod ?? ""
    }
  }
}

// ---- mutations/v1/identity/setOAuthClientCORSOrigins.memql ----

// setOAuthClientCORSOrigins
// =========================
//
// Writes the credentialed-CORS allowance an owner/admin grants a
// registered OAuth client (memql#3716). The complete set every time:
// corsOriginsJSON is the whole allowance rather than an addition to it,
// so an empty JSON array is how a grant is REVOKED and there is no
// second verb that can fall out of step with this one.
//
// A partial update of an existing row, never an insert. The row is
// created by createOAuthClient above, at /register, with no allowance --
// which is the security property the whole issue rests on, since that
// endpoint is unauthenticated.
//
// Arguments:
//   clientId         (string) - the row id (the public client_id)
//   corsOriginsJSON  (string) - JSON array of origins; "[]" revokes
//

/// Set (or revoke) the credentialed-CORS origins an owner/admin has granted a registered OAuth
/// client. Called only by component/identity/adminops, downstream of its owner-or-admin gate.
/// It is server-origin-only because actor.userId scoping is not merely hard here, it names
/// nobody: an oauthClient row has no owning user at all -- minted by an unauthenticated stranger at
/// /register -- so there is no field for actor.userId to be compared against and a self-scoped
/// filter would match zero rows for every caller including the admin the surface is for. Meanwhile
/// the write is the shape memql#2991 found on updateUser: a caller-supplied target id plus a
/// caller-supplied value, on a field that grants credentialed cross-origin read access to
/// identity's cookie-bearing endpoints. Client-reachable, it would let any authenticated writer
/// grant their own origin and make the owner/admin gate in adminops decorative. The boundary
/// therefore sits where the authorization already lives.
@serverOnly
mutate oauthClient setOAuthClientCORSOrigins {
  args {
    clientId         string!
    corsOriginsJSON  string!
  }
  update {
    accept { corsOriginsJSON }
    stamp {
      id: args.clientId
    }
  }
}

// ---- mutations/v1/identity/createAuthSession.memql ----

// createAuthSession
// =================
//
// Persists a v1:identity:authSession row at the moment a bearer token is
// minted -- either by the BFF /auth/exchange handler (the product SPA) or
// the /auth/callback handler (browser admin UI cookie). Future requests
// that present the same token are matched against this row by tokenHash;
// a revokedAt stamp on the row makes the middleware reject the token even
// though the JWT signature is still valid.
//
// Storing only the hash mirrors the v1:identity:invitation contract: the
// plaintext token never lives in the graph. All-sessions revoke fans out
// across rows by userId.
//
// Arguments:
//   sessionId    (string)            - UUID-derived node ID
//   subject      (string)            - JWT sub claim (canonical lookup key)
//   tokenHash    (string)            - SHA-256 hex of the bearer token
//   source       (string)            - "bff_exchange" | "oidc_cookie" | "device_code"
//   userId       (string, optional)  - v1:identity:user; "" when bootstrap hasn't run
//   identityId   (string, optional)  - v1:identity:identity row authorizing the session; same caveat as userId
//   clientLabel  (string, optional)  - Human label parsed from User-Agent
//   expiresAt    (string)            - ISO 8601 expiration timestamp
//

/// Create a bearer-token session record at issuance time.
mutate authSession createAuthSession {
  args {
    sessionId    string!
    subject      string!
    tokenHash    string!
    source       enum("bff_exchange", "oidc_cookie", "device_code")!
    userId       string
    identityId   string
    clientLabel  string
    expiresAt    string!
  }
  insert {
    accept { subject, tokenHash, source, expiresAt }
    stamp {
      id: args.sessionId
      userId: args.userId ?? ""
      identityId: args.identityId ?? ""
      clientLabel: args.clientLabel ?? ""
      lastActivityAt: now
      firstAuthenticatedAt: now
      refreshTokenHash: ""
      revokedReason: ""
    }
  }
}

// ---- mutations/v1/identity/createClusterSettings.memql ----

// createClusterSettings
// =====================
//
// Persist (or refresh) the singleton v1:identity:clusterSettings row
// keyed by id="cluster". The first-run wizard (Phase 3) calls this
// once after the operator submits the form; the admin UI (Phase 6)
// calls it whenever an operator edits a setting at runtime.
//
// The MemQL parser doesn't have an upsert primitive, so this mutation
// inserts every time. The engine's time-series semantics keep the
// latest version effective — readers query the most recent row.
//
// Arguments:
//   id                          (string)            singleton key, must be "cluster"
//   brandName                   (string, optional)
//   brandPrimaryColor           (string, optional)
//   brandLogoDataURI            (string, optional)
//   brandIconDataURI            (string, optional)
//   registrationMode            (string)            open | domain_restricted | invite_only | waitlist
//   registrationDomains         (string, optional)  comma-joined
//   internalDomains             (string, optional)  comma-joined
//   internalDefaultRole         (string)            owner | admin | writer | reader
//   registeredClientsJSON       (string, optional)  JSON array
//   accessRequestNotifyEmails   (string, optional)  comma-joined
//   bootstrapEmail              (string, optional)  captured by the wizard
//   bootstrappedAt              (string, optional)  RFC3339 timestamp; "" means
//                                                   "not yet claimed". The wizard
//                                                   passes "". The magic-link
//                                                   verifier stamps it on
//                                                   bootstrap-link consumption,
//                                                   via mutationStampBootstrapped.
//

/// Persist (or refresh) the singleton cluster-settings row. `bootstrappedAt` is @noUnset: this body
/// writes `args.bootstrappedAt ?? ""`, so a caller who simply omits it puts an EXPLICIT empty string
/// in the delta -- which read-merge cannot protect against, because read-merge only inherits fields a
/// delta OMITS. That is how a re-run of this mutation un-bootstrapped a live cluster and re-opened the
/// unauthenticated /setup ownership wizard (memql#3415). @noUnset drops the empty value when the
/// stored row already carries a stamp; setting it on a still-unclaimed row is unaffected.
@noUnset("bootstrappedAt")
mutate clusterSettings createClusterSettings {
  args {
    id                         string!
    clusterDomain              string
    brandName                  string
    brandPrimaryColor          string
    brandLogoDataURI           string
    brandIconDataURI           string
    registrationMode           enum("open", "domain_restricted", "invite_only", "waitlist")!
    registrationDomains        string
    internalDomains            string
    internalDefaultRole        enum("owner", "admin", "developer", "writer", "reader")!
    registeredClientsJSON      string
    accessRequestNotifyEmails  string
    bootstrapEmail             string
    bootstrapFirstName         string
    bootstrapLastName          string
    bootstrapPhone             string
    bootstrapPrimaryRole       string
    bootstrapGender            string
    bootstrapBirthdate         string
    bootstrappedAt             string
    accessTokenTTLSeconds      int
    refreshTokenTTLSeconds     int
    magicLinkTTLSeconds        int
    invitationTTLDays          int
    refreshCookieSameSite      string
    authoredAutomationsEnabled bool
  }
  insert {
    args.id
    clusterDomain: args.clusterDomain ?? ""
    brandName: args.brandName ?? ""
    brandPrimaryColor: args.brandPrimaryColor ?? ""
    brandLogoDataURI: args.brandLogoDataURI ?? ""
    brandIconDataURI: args.brandIconDataURI ?? ""
    args.registrationMode
    registrationDomains: args.registrationDomains ?? ""
    internalDomains: args.internalDomains ?? ""
    args.internalDefaultRole
    registeredClientsJSON: args.registeredClientsJSON ?? ""
    accessRequestNotifyEmails: args.accessRequestNotifyEmails ?? ""
    accessRequestNotifyThrottleMins: 5
    bootstrapEmail: args.bootstrapEmail ?? ""
    bootstrapFirstName: args.bootstrapFirstName ?? ""
    bootstrapLastName: args.bootstrapLastName ?? ""
    bootstrapPhone: args.bootstrapPhone ?? ""
    bootstrapPrimaryRole: args.bootstrapPrimaryRole ?? ""
    bootstrapGender: args.bootstrapGender ?? ""
    bootstrapBirthdate: args.bootstrapBirthdate ?? ""
    bootstrappedAt: args.bootstrappedAt ?? ""
    accessTokenTTLSeconds: args.accessTokenTTLSeconds ?? 0
    refreshTokenTTLSeconds: args.refreshTokenTTLSeconds ?? 0
    magicLinkTTLSeconds: args.magicLinkTTLSeconds ?? 0
    invitationTTLDays: args.invitationTTLDays ?? 0
    refreshCookieSameSite: args.refreshCookieSameSite ?? ""
    authoredAutomationsEnabled: args.authoredAutomationsEnabled ?? true
  }
}

/// Flip the cluster-wide GLOBAL KILL SWITCH for planner-authored automations (epic memql#954, issue
/// #961). Partial-update of the singleton cluster-settings row (id='cluster'): sets
/// authoredAutomationsEnabled true (resume) or false (halt). false halts EVERY authored automation
/// across the whole cluster -- the governance hard stop -- independent of any bundle status or
/// per-user kill switch. Operator-only in practice (the admin settings surface calls it); the
/// authored scheduler reads the flag through clusterSettingsCurrent on its global gate.
mutate clusterSettings setAuthoredAutomationsEnabled {
  args {
    enabled  bool!
  }
  update {
    id: "cluster"
    authoredAutomationsEnabled: args.enabled
  }
}

// ---- mutations/v1/identity/createDelegation.memql ----

// createDelegation
// ================
//
// Creates a new v1:identity:delegation record granting an agent
// scoped authority to act on behalf of an identity.

/// Create a new delegation granting an agent scoped authority on behalf of an identity.
mutate delegation createDelegation {
  args {
    delegationId      string
    identityId        string!
    identitySubject   string!
    identityType      enum("human", "synthetic")!
    agentId           string!
    roleCeiling       enum("owner", "admin", "developer", "writer", "reader")!
    scopes            []string!
    createdBySubject  string!
    expiresAt         string
    note              string
  }
  insert {
    accept { identityId, identitySubject, identityType, agentId, roleCeiling, scopes, createdBySubject, expiresAt, note }
    stamp {
      id: args.delegationId
      active: true
    }
  }
}

// ---- mutations/v1/identity/createIdentity.memql ----

// createIdentity
// ==============
//
// Creates a new v1:identity:identity record: a credential set owned by
// a v1:identity:user. One user can have many identities (a magic-link
// verified email, OAuth accounts on external apps, API keys, service
// accounts, worker tokens for memql-cockpit machines).
//
// The credentials object must match the identityType variant, and as
// of memql#3623 the SCHEMA enforces that rather than the caller. This
// mutation is the one place a caller picks both halves independently,
// so it was the reachable way to persist a row whose declared family
// and credential material disagreed -- the concept now emits an
// if/then per branch keyed on identityType, and such a row is refused
// at insert. Callers (the identity service's magic-link verifier on
// first-login, future OAuth / PAT flows, the worker-token mint flow)
// still pass the shape; they now get told when it is wrong. Variants:
//   oauth           => { provider, externalUserId, scopes }
//   api_key         => { keyHash }
//   service_account => { accountId }
//   magic_link      => { verifiedAt, lastLinkSentAt }
//   worker_token    => { name, keyHash, registeredBy, ... }
//
// ID convention: <userId>:<identityType>:<credentialKey>. The caller
// passes the computed id so re-creating the same identity is idempotent
// (a new time-series version under the same id rather than a new row).

/// Create a new identity (credential set owned by a user).
mutate identity createIdentity {
  args {
    identityId      string!
    userId          string!
    identityType    enum("oauth", "api_key", "service_account", "magic_link", "worker_token")!
    credentials     object!
    label           string
    usableByAgents  bool
  }
  insert {
    accept { userId, identityType, credentials }
    stamp {
      id: args.identityId
      label: args.label ?? ""
      usableByAgents: args.usableByAgents ?? false
      active: true
    }
  }
}

// ---- mutations/v1/identity/createMagicLinkRequest.memql ----

// createMagicLinkRequest
// ======================
//
// Persists a v1:identity:magicLinkRequest row at the moment a magic
// link is issued. The plaintext token is delivered in the email and
// never stored server-side -- only its SHA-256 hash lands here, keyed
// for lookup at /auth/magic-link/consume.
//
// Single-use semantics are enforced by consumeMagicLinkRequest
// stamping consumedAt on the row. consumedAt is intentionally omitted
// here so the row is born "unspent."
//
// Arguments:
//   requestId      (string)            - Magic-link request node ID (UUID-derived)
//   email          (string)            - Email the link was sent to
//   tokenHash      (string)            - SHA-256 hex digest of the plain token
//   expiresAt      (string)            - Absolute expiration timestamp (ISO 8601)
//   sourceIP       (string, optional)  - IP the issuance request came from
//   userAgent      (string, optional)  - User-Agent at issuance
//   oauthCtxJSON   (string, optional)  - Serialized OAuth context (clientId, redirectURI, state) for third-party flows
//   invitationId   (string, optional)  - v1:identity:invitation that triggered this issuance, when applicable
//   bindingHash    (string, optional)  - SHA-256 hex of the memql_ml nonce cookie set on the requesting browser
//
// bindingHash is what makes the link device-bound (memql#4301). The
// issuer mints a 32-byte nonce, hands the plaintext to the requesting
// browser as a cookie, and stores only the digest here. Optional
// because the bootstrap-claim and API issue paths were written before
// the cookie existed; a row with an empty bindingHash completes for
// nobody and can only be APPROVED, which is the safe direction to
// degrade in.

/// Create a magic-link request row at issuance time.
mutate magicLinkRequest createMagicLinkRequest {
  args {
    requestId     string!
    email         string!
    tokenHash     string!
    expiresAt     string!
    sourceIP      string
    userAgent     string
    oauthCtxJSON  string
    invitationId  string
    bindingHash   string
  }
  insert {
    accept { email, tokenHash, expiresAt }
    stamp {
      id: args.requestId
      sourceIP: args.sourceIP ?? ""
      userAgent: args.userAgent ?? ""
      oauthCtxJSON: args.oauthCtxJSON ?? ""
      invitationId: args.invitationId ?? ""
      bindingHash: args.bindingHash ?? ""
    }
  }
}

// ---- mutations/v1/identity/createPATIdentity.memql ----

// createPATIdentity
// =================
//
// Creates a v1:identity:identity row of identityType="api_key" used
// as a Personal Access Token (PAT) for CLI clients (memql-cockpit,
// future bridge-agent CLI calls). The plaintext token is shown to
// the user ONCE at generation; only its SHA-256 hex hash lands here.
//
// PAT id convention: <userId>:pat:<random hex>. The caller passes the
// computed id so audit/log lines can reason about a stable id without
// knowing the plaintext.
//
// usableByAgents stays false by default -- a PAT identifies a human
// CLI user, not an agent acting on their behalf. Agent delegation
// happens through the v1:identity:delegation concept.

/// Create a Personal Access Token identity (api_key) owned by a user. Stores only the SHA-256 hex
/// hash; plaintext lives at the caller for one-time display.
mutate identity createPATIdentity {
  args {
    identityId      string!
    userId          string!
    label           string!
    keyHash         string!
    usableByAgents  bool
  }
  insert {
    id: args.identityId
    args.userId
    identityType: "api_key"
    credentials: {keyHash: args.keyHash}
    args.label
    usableByAgents: args.usableByAgents ?? false
    active: true
  }
}

// ---- mutations/v1/identity/createUser.memql ----

// createUser
// ==========
//
// Creates a new v1:identity:user record: a person (or synthetic
// principal). The user owns one or more v1:identity:identity records.
// What that user may reach is decided by per-row authorization -- the
// only gate -- not by a partition grant: partitions were retired in
// #56 and v1:identity:partitionAccess no longer exists.
//
// ID convention: user-<hash of primaryEmail> or user-<uuid>. The
// caller passes the id; the identity service's magic-link verifier
// derives it from the registering email at first-login time.
//
// The first user created on a fresh cluster gets role=owner, which
// the admin specs treat as cluster-wide. Subsequent users default to
// reader and reach only what a per-row predicate grants them. The
// magic-link verifier is responsible for picking the right role;
// callers of createUser set role directly.

/// Create a new user (person / synthetic principal).
mutate user createUser {
  args {
    userId        string!
    displayName   string!
    primaryEmail  string!
    role          enum("owner", "admin", "developer", "writer", "reader")
    groupIds      object
    preferences   object
  }
  insert {
    id: args.userId
    args.displayName
    args.primaryEmail
    role: args.role ?? "reader"
    groupIds: args.groupIds ?? []
    preferences: args.preferences ?? {}
    active: true
  }
}

// ---- mutations/v1/identity/createUserOnFirstLogin.memql ----

// createUserOnFirstLogin
// ======================
//
// Provisions a v1:identity:user row at the moment a previously-
// unknown email completes a magic-link consume. Distinct from
// createUser because it captures the new Phase-2 fields
// `internal` (set by the consume handler from
// MEMQL_IDENTITY_INTERNAL_DOMAINS match) and `legalAcceptance` (initialized
// to []; recordLegalAcceptance appends entries later).
//
// Suspension fields and lastSeenAt are intentionally omitted: they
// have format: "date-time" and JSON-Schema draft-07 rejects null on
// formatted strings. Absence is the correct encoding of "not set."
// The same goes for deletionScheduledAt and dataExportLastAt --
// stamped only when their respective lifecycle events fire.
//
// Arguments:
//   userId        (string)            - User node ID (typically user-<hash(primaryEmail)>)
//   displayName   (string)            - Display name shown in the UI
//   firstName     (string, optional)  - Given name; flows to JWT given_name
//   lastName      (string, optional)  - Family name; flows to JWT family_name
//   primaryEmail  (string)            - Canonical email; dedup key
//   phone         (string, optional)  - E.164 phone number
//   primaryRole   (string, optional)  - Free-form job title
//   gender        (string, optional)  - Self-identified gender
//   birthdate     (string, optional)  - ISO-8601 date (YYYY-MM-DD)
//   role          (string, optional)  - Cluster role; defaults to "reader"
//   internal      (bool)              - Whether the email matched MEMQL_IDENTITY_INTERNAL_DOMAINS at registration
//   groupIds      (object, optional)  - manual group memberships
//   preferences   (object, optional)  - User preference bag
//

/// Create a user record on first successful magic-link login.
mutate user createUserOnFirstLogin {
  args {
    userId        string!
    displayName   string!
    firstName     string
    lastName      string
    primaryEmail  string!
    phone         string
    primaryRole   string
    gender        string
    birthdate     string
    role          enum("owner", "admin", "developer", "writer", "reader")
    internal      bool!
    sharedMailbox bool
    groupIds      object
    preferences   object
  }
  insert {
    id: args.userId
    args.displayName
    firstName: args.firstName ?? ""
    lastName: args.lastName ?? ""
    args.primaryEmail
    phone: args.phone ?? ""
    primaryRole: args.primaryRole ?? ""
    gender: args.gender ?? ""
    birthdate: args.birthdate ?? ""
    role: args.role ?? "reader"
    groupIds: args.groupIds ?? []
    preferences: args.preferences ?? {}
    active: true
    args.internal
    sharedMailbox: args.sharedMailbox ?? false
    signInPolicy: "any"
    legalAcceptance: []
  }
}

// ---- mutations/v1/identity/setUserSignInPolicy.memql ----

// setUserSignInPolicy
// ===================
//
// Sets which factors may enter one account. Three callers, all of them
// checked before they get here:
//
//   - the user themselves on /me/settings, who may only choose
//     `passkey_only` while holding at least one active passkey;
//   - an owner or admin over IdentityAdminMsg, who may only RESET to
//     `any` -- the rescue path when somebody has locked themselves out;
//   - nothing else.
//
// @serverOnly. actor.userId scoping is not the fix and would be actively
// wrong for the admin half: the reset exists precisely so somebody OTHER
// than the account holder can perform it, so a self-scoped filter would
// refuse the one caller the rescue path is for. The self half is checked in
// Go, where the passkey-count precondition also lives -- a precondition a
// row filter cannot express, because the fact being checked is on a
// different concept (v1:identity:identity).
//
// Arguments:
//   userId  (string)  - target user
//   policy  (string)  - "any" | "passkey_only"
//

/// Set a user's sign-in policy (any | passkey_only).
///
/// @serverOnly. Scoping to actor.userId is not the fix and would be actively wrong for one of the
/// two callers: the admin RESET exists precisely so somebody OTHER than the account holder can turn
/// sign-in links back on for a person who turned them off and then lost their passkey. A
/// self-scoped filter would refuse the one caller the rescue path is for. The self-service caller
/// IS checked against actor.userId, in Go, alongside the precondition a row filter cannot express
/// at all -- "this user holds at least one active passkey", a fact on a different concept
/// (v1:identity:identity).
@serverOnly
mutate user setUserSignInPolicy {
  args {
    userId  string!
    policy  enum("any", "passkey_only")!
  }
  update {
    id: args.userId
    signInPolicy: args.policy
  }
}

// ---- mutations/v1/identity/setUserSharedMailbox.memql ----

// setUserSharedMailbox
// ====================
//
// Sets or clears the shared-mailbox hint. The heuristic that seeds it is a
// guess -- `info@` belongs to plenty of solo operators -- so both directions
// have to be available to the user and to an admin.
//
// @serverOnly for the same reason setUserSignInPolicy is: an admin editing
// somebody else's flag is a legitimate caller that actor.userId scoping
// would refuse, and the self case is checked in Go alongside it. The flag
// gates nothing, so the exposure of a wire-reachable version would be
// cosmetic rather than dangerous -- but a field that drives security COPY is
// still one an arbitrary caller should not be able to flip on somebody
// else's account.
//
// Arguments:
//   userId  (string)  - target user
//   shared  (bool)    - the new value
//

/// Set or clear a user's shared-mailbox hint.
///
/// @serverOnly for the reason setUserSignInPolicy gives: an admin correcting somebody else's flag is
/// a legitimate caller that actor.userId scoping would refuse, and the self-service caller is
/// checked against actor.userId in Go alongside it. The flag gates nothing, so a wire-reachable
/// version would be cosmetic rather than dangerous -- but a field that drives security COPY on
/// somebody's own account is still not one an arbitrary caller should be able to flip.
@serverOnly
mutate user setUserSharedMailbox {
  args {
    userId  string!
    shared  bool!
  }
  update {
    id: args.userId
    sharedMailbox: args.shared
  }
}

// deviceCode -- the RFC 8628 device authorization grant (memql#3410)
// ==================================================================
//
// Five writes, one per transition of a deliberately small state
// machine: create (pending), touchPoll (a clock tick, no transition),
// approve, deny, redeem. The status field is stamped by the mutation
// rather than accepted from args, so there is no call that can put a
// row into an arbitrary state -- `approveDeviceCode` is the only way to
// reach `approved` and `redeemDeviceCode` is the only way to leave it.
//
// approveDeviceCode / denyDeviceCode stamp approvedByUserId from
// actor.userId and never accept it, so the recorded approver is the
// signed-in human the verification page authenticated, not a value the
// form could carry. The handler re-checks the row's status before
// calling either, which is what keeps a second approval from silently
// overwriting the first approver's id.

/// Persist a device-authorization row at POST /device/code time, born `pending`. Both credentials
/// arrive pre-hashed; neither plaintext is ever passed to the engine.
mutate deviceCode createDeviceCode {
  args {
    deviceCodeId         string!
    clientId             string!
    deviceCodeHash       string!
    userCodeHash         string!
    expiresAt            string!
    intervalSeconds      int!
    scope                string
    codeChallenge        string
    codeChallengeMethod  string
    sourceIP             string
    userAgent            string
  }
  insert {
    accept { clientId, deviceCodeHash, userCodeHash, expiresAt, intervalSeconds, scope, codeChallenge, codeChallengeMethod }
    stamp {
      id: args.deviceCodeId
      status: "pending"
      sourceIP: args.sourceIP ?? ""
      userAgent: args.userAgent ?? ""
    }
  }
}

/// Stamp the poll clock. Called on EVERY /oauth/token device-grant poll, accepted or throttled, so
/// the next poll's slow_down decision reads a value written by whichever replica served the last
/// one. intervalSeconds is re-stamped because a too-fast poll raises it.
mutate deviceCode touchDeviceCodePoll {
  args {
    deviceCodeId     string!
    lastPolledAt     string!
    intervalSeconds  int!
  }
  update {
    accept { lastPolledAt, intervalSeconds }
    stamp {
      id: args.deviceCodeId
    }
  }
}

/// Approve a pending device authorization. The approver is stamped from actor.userId -- the form
/// cannot name someone else.
@actor
mutate deviceCode approveDeviceCode {
  args {
    deviceCodeId  string!
  }
  update {
    stamp {
      id: args.deviceCodeId
      status: "approved"
      approvedByUserId: actor.userId
      approvedAt: now
    }
  }
}

/// Deny a pending device authorization. Terminal: polling returns access_denied from here on.
@actor
mutate deviceCode denyDeviceCode {
  args {
    deviceCodeId  string!
  }
  update {
    stamp {
      id: args.deviceCodeId
      status: "denied"
      approvedByUserId: actor.userId
      deniedAt: now
    }
  }
}

/// Mark an approved device authorization redeemed. Single-use: the handler stamps this BEFORE
/// minting tokens, so a concurrent second poll finds status=redeemed and is refused.
mutate deviceCode redeemDeviceCode {
  args {
    deviceCodeId  string!
    redeemedAt    string!
  }
  update {
    accept { redeemedAt }
    stamp {
      id: args.deviceCodeId
      status: "redeemed"
    }
  }
}

// ---- mutations/v1/identity/createWorkerPairingCode.memql ----

// createWorkerPairingCode
// ========================
//
// Persists a v1:identity:workerPairingCode row at the moment the
// frontend's Settings -> Computer Use card mints a code. The plain
// XXXX-XXXX code is shown to the user ONCE and never persisted
// server-side -- only its SHA-256 hash lands here, keyed for
// lookup at gRPC stream open time (Authorization: Pair <code>).
//
// Single-use semantics are enforced by redeemWorkerPairingCode
// stamping redeemedAt on the row. redeemedAt is intentionally
// omitted here so the row is born "unspent."

/// Persist a worker-pairing-code row at creation time.
mutate workerPairingCode createWorkerPairingCode {
  args {
    pairingId    string!
    ownerUserId  string!
    codeHash     string!
    clusterURL   string!
    expiresAt    string!
    sourceIP     string
  }
  insert {
    accept { ownerUserId, codeHash, clusterURL, expiresAt }
    stamp {
      id: args.pairingId
      sourceIP: args.sourceIP ?? ""
    }
  }
}

// ---- mutations/v1/identity/createWorkerTokenIdentity.memql ----

// createWorkerTokenIdentity
// ==========================
//
// Creates a v1:identity:identity row of identityType="worker_token"
// for a Cockpit worker registration. Plaintext token is
// shown to the user ONCE at generation; only its SHA-256 hex hash
// lands here.
//
// Worker tokens are server-side-scoped: the gRPC stream
// interceptor admits them ONLY on WorkerService paths
// (/znasllc.memql.worker.v1.WorkerService/...) and rejects them
// on every other RPC. usableByAgents stays false unconditionally
// -- a worker token identifies a machine, not a delegated agent
// principal.
//
// Token id convention: <userId>:wkr:<random hex>. The caller mints
// the id alongside the plain token so audit/log lines can reason
// about a stable id without knowing the plaintext.

/// Create a worker_token identity (machine credential for a Cockpit worker machine). Stores only the
/// SHA-256 hex hash; plaintext lives at the caller for one-time display.
mutate identity createWorkerTokenIdentity {
  args {
    identityId              string!
    userId                  string!
    name                    string!
    keyHash                 string!
    registeredBy            string!
    capabilitiesAdvertised  array
    labelsAdvertised        object
    expiresAt               string
  }
  insert {
    id: args.identityId
    args.userId
    identityType: "worker_token"
    credentials: {
        name: args.name,
        keyHash: args.keyHash,
        registeredBy: args.registeredBy,
        capabilitiesAdvertised: args.capabilitiesAdvertised ?? [],
        labelsAdvertised: args.labelsAdvertised ?? {},
        expiresAt: args.expiresAt ?? ""
      }
    label: args.name
    usableByAgents: false
    active: true
  }
}

// ---- mutations/v1/identity/createNodeTokenIdentity.memql ----

// createNodeTokenIdentity
// =======================
//
// Creates a v1:identity:identity row of identityType="node_token"
// for a cluster-internal node binary (bff / voice / cognition /
// agent / planner / workbench). Two paths create rows here:
//
//   1. Operator CLI (`memql node-token mint --node-id ... --node-type ...`)
//      stamps mintedBy with the human operator's userId; keyHash is the
//      SHA-256 of an auxiliary random bearer kept only for fingerprint
//      audit (the actual auth credential handed to the node is a
//      class="node" JWT signed via JWTIssuer.IssueNodeAccessToken).
//
//   2. Self-bootstrap via POST /node/bootstrap (memql#338) stamps
//      mintedBy with `system:node-bootstrap` and additionally stamps
//      bootstrappedAt / bootstrappedFrom via the companion
//      stampNodeTokenBootstrap below. memql#343.
//
// The row is keyed by (nodeType, nodeId); the lookup pattern in
// nodeTokenIdentityByBinding lets the bootstrap handler reuse
// an existing row on the second restart of a given node rather than
// piling up stale rows.

/// Create a node_token identity (machine credential for a cluster-internal node binary). Stores
/// only the SHA-256 hex hash; the actual credential is a class=node JWT.
mutate identity createNodeTokenIdentity {
  args {
    identityId        string!
    userId            string!
    nodeId            string!
    nodeType          string!
    keyHash           string!
    mintedBy          string!
    expiresAt         string
    bootstrappedAt    string
    bootstrappedFrom  string
  }
  insert {
    id: args.identityId
    args.userId
    identityType: "node_token"
    credentials: {
        nodeId: args.nodeId,
        nodeType: args.nodeType,
        keyHash: args.keyHash,
        mintedBy: args.mintedBy,
        expiresAt: args.expiresAt ?? "",
        lastConnectAt: "",
        bootstrappedAt: args.bootstrappedAt ?? "",
        bootstrappedFrom: args.bootstrappedFrom ?? ""
      }
    label: args.nodeType
    usableByAgents: false
    active: true
  }
}

// ---- mutations/v1/identity/stampNodeTokenBootstrap.memql ----

// stampNodeTokenBootstrap
// =======================
//
// Updates the audit fields on an existing node_token identity row
// when the /node/bootstrap handler issues a fresh JWT for it
// (memql#338 / #343). Bumps bootstrappedAt + bootstrappedFrom +
// keyHash (the auxiliary bearer rotates with each bootstrap call so
// the fingerprint stays correlated). lastConnectAt is updated by the
// NodeService.Stream interceptor's hello path, not by this mutation.
// Mutations use update() (not insert) -- the row already exists from
// either an earlier bootstrap or an operator-CLI mint.

/// Update audit fields on a node_token identity row when the bootstrap handler issues a fresh JWT
/// for it. memql#343. Read-merges the existing row and deep-merges credentials (@mergeFields) so
/// only the rotating keyHash + bootstrappedAt/bootstrappedFrom change;
/// nodeId/nodeType/mintedBy/expiresAt/lastConnectAt inherit from the persisted row instead of being
/// re-supplied or wiped (memql#1628).
@mergeFields("credentials")
mutate identity stampNodeTokenBootstrap {
  args {
    identityId        string!
    keyHash           string!
    bootstrappedAt    string!
    bootstrappedFrom  string!
  }
  update {
    id: args.identityId
    credentials: {
        keyHash: args.keyHash,
        bootstrappedAt: args.bootstrappedAt,
        bootstrappedFrom: args.bootstrappedFrom
      }
    active: true
  }
}

// ---- mutations/v1/identity/revokeNodeTokenIdentity.memql ----

// revokeNodeTokenIdentity
// =======================
//
// Flips a node_token identity row's `active` flag to false. Called
// by the /admin/tokens revoke handler (memql#350) so operators can
// kill a single compromised node credential without rotating the
// cluster-wide bootstrap secret.
//
// Whole-replace semantics: the engine's update() mutation does NOT
// deep-merge nested objects, so this mutation takes every
// credentials field as an explicit arg. The Store assembles the
// full credentials block from the existing row before issuing the
// call -- callers MUST pass through the live values to avoid
// silently dropping audit fields. memql#343's
// /node/bootstrap pre-mint gate consults `active` and refuses to
// re-mint a revoked row, so flipping the flag is the load-bearing
// revocation surface.
//
// lastConnectAt is passed through (rather than reset) so the
// admin UI continues to show "when was this node last online" on
// the revoked row -- useful for incident triage.

/// Revoke a node_token identity by flipping active=false on the row. Read-merges the existing row
/// so only `active` changes; the credentials block + every other field inherit from the persisted
/// row instead of being re-supplied (memql#1628 -- replaces the old whole-replace
/// restate-every-credentials-field pattern). memql#350.
mutate identity revokeNodeTokenIdentity {
  args {
    identityId  string!
  }
  update {
    id: args.identityId
    active: false
  }
}

// ---- mutations/v1/identity/createVoiceAgentTokenIdentity.memql ----

// createVoiceAgentTokenIdentity
// =============================
//
// Creates a v1:identity:identity row of identityType="voice_agent_token"
// for the Go voice-agent process. Stores only the SHA-256 hex hash
// of the random bearer used as the credential's keyHash; the actual
// auth token handed to the voice-agent is a class="voice_agent" JWT
// signed by the identity service's Ed25519 key (see
// JWTIssuer.IssueVoiceAgentAccessToken). The hash satisfies the
// schema's @required contract and gives operators a stable
// fingerprint to correlate the identity row with audit lines.
//
// Surface-pinned by the voice-agent stream interceptor to the
// VoiceAgent* payload types; a leaked credential cannot drive other
// RPCs. usableByAgents stays false -- voice-agent tokens identify a
// process, not a delegated agent principal.
//
// Provisioned by the `voice-agent-token mint` subcommand on the
// identity binary; see docs/public/operate/auth/voice-agent-jwt.md.

/// Create a voice_agent_token identity (credential row for the Go voice-agent process). Plain JWT
/// is returned by JWTIssuer.IssueVoiceAgentAccessToken; this row stores only the SHA-256 of an
/// auxiliary random bearer for schema completeness + audit fingerprinting.
mutate identity createVoiceAgentTokenIdentity {
  args {
    identityId  string!
    userId      string!
    instanceId  string!
    keyHash     string!
    mintedBy    string!
    expiresAt   string
    label       string
  }
  insert {
    id: args.identityId
    args.userId
    identityType: "voice_agent_token"
    credentials: {
        instanceId: args.instanceId,
        keyHash:    args.keyHash,
        mintedBy:   args.mintedBy,
        expiresAt:  args.expiresAt ?? ""
      }
    label: args.label ?? args.instanceId
    usableByAgents: false
    active: true
  }
}

// ---- mutations/v1/identity/deleteUserHard.memql ----

// deleteUserHard
// ==============
//
// The accountDeletionSweep cron's terminal action after the
// MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS cooldown elapses for a row whose
// deletionScheduledAt is set.
//
// Implementation note: MemQL has no row-removal operation -- the
// AST defines only MutationKindInsert and MutationKindUpdate, so
// this is a soft-delete (active=false). Audit-event rows about the
// user remain intact (auditEvent retention is governed by its own
// sweep), so the trail is preserved even though the user record
// is tombstoned.
//
// PII is scrubbed as a data-deletion measure: the row stays around
// for foreign-key integrity (e.g. authSession.userId,
// auditEvent.actorUserId) but every personally-identifying field is
// cleared. The scrub is annotation-driven (@scrubPii, memql#1711):
// the engine enumerates every field the user concept marks with
// @pii (displayName, firstName, lastName, primaryEmail, phone,
// primaryRole, gender, birthdate) and zeroes it after the partial
// payload merges. This replaced the old hand-maintained
// `displayName: "" / primaryEmail: ""` list that left firstName,
// lastName, phone, primaryRole, and gender populated on the
// tombstoned row -- a GDPR/data-deletion gap. Adding a new PII field
// to the user concept now requires only the @pii annotation; the
// scrub covers it automatically and cannot drift out of sync.
// Captured email addresses on audit rows are point-in-time copies
// and not affected.
//
// If a future MemQL release adds delete() (true row removal), this
// mutation can flip to that path; the sweep cron's contract
// doesn't change.
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field on the user.
//
// Arguments:
//   userId  (string)  - User node ID
//

/// Hard-delete (soft-delete + generic @pii scrub) a user after the deletion-cooldown sweep.
@scrubPii
mutate user deleteUserHard {
  args {
    userId  string!
  }
  update {
    id: args.userId
    active: false
  }
}

// ---- mutations/v1/identity/expireAccessRequest.memql ----

// expireAccessRequest
// ===================
//
// Auto-aged sweep target. The accessRequestExpirySweep cron flips
// pending rows older than IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS to
// status="expired" so they fall off the active queue without an
// admin decision. No reviewer is recorded -- the cron is the actor,
// captured separately in the audit log.
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field. Only status changes.
//
// Arguments:
//   requestId  (string)  - Access-request node ID
//

/// Expire a pending access request (status=expired).
mutate accessRequest expireAccessRequest {
  args {
    requestId  string!
  }
  update {
    id: args.requestId
    status: "expired"
  }
}

// ---- mutations/v1/identity/recordLegalAcceptance.memql ----

// recordLegalAcceptance
// =====================
//
// Append a legal-document acceptance entry to a v1:identity:user row.
// Each entry records {documentType, version, acceptedAt, sourceIP}
// so compliance has an immutable per-user trail of which ToS /
// privacy versions the user has accepted.
//
// Implementation note: MemQL doesn't support array-append in update()
// natively (the engine splats the supplied fields onto the prior
// row, replacing each field whole). Caller is responsible for
// reading the user's current legalAcceptance array, appending the
// new entry, and passing the full new array as `legalAcceptance`.
// The bff handler that wires the legal-acceptance flow does the
// read-modify-write; this mutation is the write half.
//
// If a future MemQL release adds array-append, the contract here
// can flip to {documentType, version, sourceIP?} and the mutation
// can compose the entry inline -- callers don't have to change.
//
// Arguments:
//   userId           (string)  - User node ID
//   legalAcceptance  (object)  - Full new legalAcceptance array (caller pre-appended)
//

/// Replace a user's legalAcceptance array (caller must read-modify-write to append).
mutate user recordLegalAcceptance {
  args {
    userId           string!
    legalAcceptance  []object!
  }
  update {
    id: args.userId
    args.legalAcceptance
  }
}

// ---- mutations/v1/identity/redeemWorkerPairingCode.memql ----

// redeemWorkerPairingCode
// ========================
//
// Marks a pairing-code row redeemed. Stamps redeemedAt +
// redeemedBy + redeemedFromIP. Idempotent in name only:
// the gRPC handler treats a non-empty redeemedAt as
// already_redeemed and refuses to mint a fresh worker token
// against this row, so calling this mutation twice doesn't open
// a second-redeem window.
//
// The handler always pairs this with createWorkerTokenIdentity
// in the same RPC -- the redeem call returns the plain mql_wkr_<...>
// token, and we want both rows to land before the response is sent
// so the audit trail is complete.

/// Stamp a pairing-code row redeemed.
mutate workerPairingCode redeemWorkerPairingCode {
  args {
    pairingId       string!
    redeemedAt      string!
    redeemedBy      string!
    redeemedFromIP  string
  }
  update {
    accept { redeemedAt, redeemedBy }
    stamp {
      id: args.pairingId
      redeemedFromIP: args.redeemedFromIP ?? ""
    }
  }
}

// ---- mutations/v1/identity/rejectAccessRequest.memql ----

// rejectAccessRequest
// ===================
//
// Stamps a pending v1:identity:accessRequest as rejected. UX
// convention requires reviewerNote on rejections (so the requester
// gets a meaningful explanation if the rejection is surfaced) but
// the mutation tolerates empty input -- enforcement lives in the
// admin-console handler.
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field. Only the review fields and status change.
//
// Arguments:
//   requestId     (string)            - Access-request node ID
//   reviewedBy    (string)            - v1:identity:user.id of the deciding admin
//   reviewerNote  (string, optional)  - Free-text admin rationale
//

/// Reject an access request (status=rejected, stamps reviewer + note).
mutate accessRequest rejectAccessRequest {
  args {
    requestId     string!
    reviewedBy    string!
    reviewerNote  string
  }
  update {
    id: args.requestId
    status: "rejected"
    args.reviewedBy
    reviewedAt: now
    reviewerNote: args.reviewerNote ?? ""
  }
}

// ---- mutations/v1/identity/revokeAuthSession.memql ----

// revokeAuthSession
// =================
//
// Stamps a single v1:identity:authSession row as revoked (append-only
// version bump). After this lands, the auth middleware's tokenHash
// lookup returns a row with non-nil revokedAt and rejects the request.
//
// Preserves all the discriminator fields the latest-wins projection
// needs to keep the row coherent (userId, subject, tokenHash, source,
// expiresAt) -- without re-asserting them, the projection would lose
// them on the new version.
//
// Used by both per-device revoke (reason="user_action") and the
// per-row leg of the all-sessions fan-out (reason="all_sessions").
//
// Arguments:
//   sessionId      (string)            - Session node ID
//   subject        (string)            - JWT sub (preserved)
//   tokenHash      (string)            - SHA-256 hex (preserved)
//   source         (string)            - "bff_exchange" | "oidc_cookie" | "device_code" (preserved)
//   expiresAt      (string)            - ISO 8601 (preserved)
//   revokedReason  (string)            - "user_action" | "all_sessions" | "admin" | "reuse_detected"
//   userId         (string, optional)  - Owning user (preserved across the version bump)
//

/// Mark a bearer-token session revoked. Read-merges the existing row so only revokedReason +
/// revokedAt change; the discriminator fields (subject, tokenHash, source, expiresAt, userId) and
/// the rotation bookkeeping inherit from the persisted row instead of being re-supplied
/// (memql#1628).
///
/// `reuse_detected` is the one value no human chose (memql#4329): the rotator revokes the session
/// itself when a refresh token it had already RETIRED is presented again, because at that point
/// the credential is believed to be in someone else's hands and the legitimate holder's next
/// rotation would be indistinguishable from the attacker's.
mutate authSession revokeAuthSession {
  args {
    sessionId      string!
    revokedReason  enum("user_action", "all_sessions", "admin", "reuse_detected")!
  }
  update {
    id: args.sessionId
    args.revokedReason
    revokedAt: now
  }
}

// ---- mutations/v1/identity/revokeDelegation.memql ----

// revokeDelegation
// ================
//
// Revoke a delegation by AUTHORITATIVELY flipping active=false and
// stamping revocation metadata. A revoke is a state transition, not a
// field patch -- the terminal state cannot depend on caller input.
//
// Authored as an update{} (read-merge) so every other field
// (identityId / identitySubject / agentId / roleCeiling / scopes /
// note / ...) inherits from the persisted row; the engine-level
// read-merge (memql#1709) preserves the omitted siblings. The mutation
// itself forces `active: false` and guarantees `revokedAt` is set, so a
// caller cannot leave the row in an inconsistent (still-active) state by
// omitting or contradicting those fields (memql#1729). revokedBySubject
// is caller-sourced (the human subject, or `system:expiry` for the
// expiry cron) and recorded for audit.

/// Revoke a delegation: authoritatively flips active=false and stamps revokedAt/revokedBySubject
/// regardless of caller input. Read-merges the persisted row so every other field is preserved
/// (memql#1729).
mutate delegation revokeDelegation {
  args {
    delegationId      string!
    revokedBySubject  string
    revokedAt         string
  }
  update {
    id: args.delegationId
    active: false
    revokedAt: args.revokedAt ?? now
    revokedBySubject: args.revokedBySubject ?? ""
  }
}

// ---- mutations/v1/identity/revokePATIdentity.memql ----

// revokePATIdentity
// =================
//
// Soft-revokes a Personal Access Token by inserting a new version of
// the v1:identity:identity row with active=false. Subsequent token
// validations look up the row by keyHash and refuse a hit when active
// is false; the row itself stays around for audit.
//
// The mutation re-stamps every other field. Callers (the web UI's
// /me/tokens revoke handler, /admin/tokens/{id}/revoke) must pass
// the existing payload alongside the id so the new version preserves
// the discriminator (identityType=api_key) and credentials.keyHash.

/// Soft-revoke a PAT identity (api_key) by flipping active=false. Read-merges the existing row so
/// only `active` changes; identityType/credentials/label/usableByAgents inherit from the persisted
/// row instead of being re-supplied (memql#1628).
mutate identity revokePATIdentity {
  args {
    identityId  string!
  }
  update {
    id: args.identityId
    active: false
  }
}

// ---- mutations/v1/identity/revokeWorkerTokenIdentity.memql ----

// revokeWorkerTokenIdentity
// ==========================
//
// Soft-revokes a v1:identity:identity row of identityType=
// "worker_token" by flipping active=false. The gRPC stream
// interceptor consults the active flag on every connect attempt;
// the agent node's worker registry separately handles the
// v1:worker:registration revocation (revokeWorker) -- the
// two flips are independent so the operator can revoke the
// token (this row) without affecting the operational record, or
// vice versa.

/// Revoke (deactivate) a worker_token identity row.
mutate identity revokeWorkerTokenIdentity {
  args {
    identityId  string!
  }
  update {
    id: args.identityId
    active: false
  }
}

// ---- mutations/v1/identity/createBadgeIdentity.memql ----

// createBadgeIdentity
// ===================
//
// Creates a v1:identity:identity row of identityType="badge" -- a
// registered operator badge/device for shared-terminal attribution
// (memql#2513). Stores only the SHA-256 hex hash of the badge id;
// the plaintext id lives on the physical card/device.
//
// Badges are NOT bearer sessions: presenting the badge id alone
// authenticates nothing. The grant exchange additionally requires an
// already-authenticated terminal bearer, and the resulting grant
// token is short-lived and role-ceiling-clamped.

/// Register a badge identity (shared-terminal operator credential). Stores only the SHA-256 hex
/// hash of the badge/device id.
mutate identity createBadgeIdentity {
  args {
    identityId    string!
    userId        string!
    label         string!
    keyHash       string!
    registeredBy  string!
  }
  insert {
    id: args.identityId
    args.userId
    identityType: "badge"
    credentials: {
        keyHash: args.keyHash,
        registeredBy: args.registeredBy,
        lastUsedAt: ""
      }
    args.label
    usableByAgents: false
    active: true
  }
}

// ---- mutations/v1/identity/revokeBadgeIdentity.memql ----

// revokeBadgeIdentity
// ===================
//
// Soft-revokes a badge identity row by flipping active=false. The
// grant exchange consults the active flag on every attempt, so
// revocation blocks all FUTURE grants immediately; outstanding
// grant tokens (short TTL -- default 10 min, capped at 1 h) die at
// their exp -- the same revoke-by-expiry tradeoff service-account
// tokens document.

/// Revoke (deactivate) a badge identity row. Future grant exchanges are blocked immediately;
/// outstanding short-TTL grant tokens expire on their own.
mutate identity revokeBadgeIdentity {
  args {
    identityId  string!
  }
  update {
    id: args.identityId
    active: false
  }
}

// ---- mutations/v1/identity/createPasskeyIdentity.memql ----

// createPasskeyIdentity
// =====================
//
// Creates a v1:identity:identity row of identityType="passkey" -- an
// enrolled WebAuthn discoverable credential (memql#3406). What lands
// here is the PUBLIC half of a keypair whose private half never left the
// authenticator, so unlike every keyHash sibling in this file there is
// no plaintext being deliberately withheld: there is no secret to
// withhold.
//
// Uniqueness of credentials.credentialId is the invariant the login
// ceremony depends on (memql#3407 resolves a discoverable assertion
// through that field alone), and it is enforced by the CALLER: the
// register/finish handler runs passkeyByCredentialId first and refuses a
// duplicate. Stated here because a raw invocation of this mutation
// bypasses that check -- the write is gated to a system actor by the
// memql#2513 credential-actor guard, which is what keeps the only
// reachable path the one that checks.
//
// EVERY arg is @required, including the five that read like they could be
// omitted (memql#3617). `credentials` is rebuilt here as an object literal,
// and an absent optional arg omits its leaf; this is an insert whose id is
// caller-chosen, so a second write onto the same id read-merges and replaces
// the whole object -- destroying whatever leaves that call did not pass.
// @mergeFields, the remedy recordPasskeyAssertion uses, is a load-time error
// on an insert, so the destroying call is made UNSPELLABLE instead. Nothing is
// lost by it: a registration ceremony has all ten values by construction, and
// a zero signCount / false backupEligible / empty transports are all legal
// values a caller passes explicitly rather than omits.

/// Record that a user signs in through an upstream identity provider (memql#4611).
///
/// STORES NO SECRET. The credential lives at the provider; this row holds only
/// the (issuer, subject) pair the provider asserted, which is what lands a
/// returning person on their existing user row instead of a duplicate.
///
/// @serverOnly, and actor.userId scoping is NOT the fix. Caller-scoping would
/// restrict WHOSE row gains a link; the danger is the CONTENT of the link. A
/// client that could write `credentials.subject` for itself could claim any
/// upstream identity it liked, and the next federated sign-in as that subject
/// would resolve to the row that claimed it -- account takeover through a
/// write, not through a sign-in. The pair may only be written by the code that
/// VERIFIED an id token carrying it, which is the callback handler, and there
/// is no caller to scope to at that moment: the person has not yet been
/// admitted.
@serverOnly
mutate identity createOidcIdentity {
  args {
    identityId  string!
    userId      string!
    label       string!
    issuer      string!
    subject     string!
    email       string
  }
  insert {
    id: args.identityId
    args.userId
    identityType: "oidc"
    credentials: {
        issuer: args.issuer,
        subject: args.subject,
        email: args.email ?? "",
        lastUsedAt: ""
      }
    args.label
    usableByAgents: false
    active: true
    createdAt: now
  }
}

/// Register a passkey identity (WebAuthn discoverable credential). Stores the credential's PUBLIC
/// COSE key -- there is no secret half to withhold.
mutate identity createPasskeyIdentity {
  args {
    identityId      string!
    userId          string!
    label           string!
    credentialId    string!
    publicKey       string!
    signCount       int!
    aaguid          string!
    transports      []string!
    backupEligible  bool!
    backupState     bool!
    registeredBy    string!
  }
  insert {
    id: args.identityId
    args.userId
    identityType: "passkey"
    credentials: {
        credentialId: args.credentialId,
        publicKey: args.publicKey,
        signCount: args.signCount,
        aaguid: args.aaguid,
        transports: args.transports,
        backupEligible: args.backupEligible,
        backupState: args.backupState,
        registeredBy: args.registeredBy,
        lastUsedAt: ""
      }
    args.label
    usableByAgents: false
    active: true
  }
}

// ---- mutations/v1/identity/recordPasskeyAssertion.memql ----

// recordPasskeyAssertion
// ======================
//
// Re-stamps a passkey row after a verified login assertion
// (memql#3407): the new signature counter, the current backup state,
// and lastUsedAt.
//
// @mergeFields("credentials") makes the nested write MERGE-SEMANTIC
// (memql#3617). It used to rely on caller discipline instead -- "partial
// nested updates are not supported, so the caller re-passes every field" --
// and five of the ten args are optional, so a legal minimal call rendered a
// `credentials` object missing those leaves and the wholesale replace
// DESTROYED them. Dropping `backupEligible` that way reads back false, a
// synced authenticator asserts true, and WebAuthn refuses: memql#3605
// reopened by a different route, with no error at any layer. The annotation
// removes the whole class -- an un-passed leaf now keeps its stored value
// rather than vanishing -- and it does not weaken anything the caller does
// pass, which still wins the merge.
//
// The caller re-passing every field remains correct and remains what the
// login handler does; it is simply no longer the only thing standing between
// a legal call and data loss. `backupEligible` is immutable for a
// credential's lifetime by spec, and the handler passes back the value it
// READ FROM THE ROW rather than the one the assertion reported -- so the only
// value this mutation can write is the one already stored. `credentialId` and
// `publicKey` are re-passed for the same reason and are equally unchangeable
// in practice: the login ceremony resolved the row BY credentialId and
// verified the signature against that publicKey, so a different value could
// not have reached here.
//
// The three fields that actually move -- signCount, backupState,
// lastUsedAt -- are the ones the spec says move. A counter that fails to
// advance is the cloned-authenticator signal, and the ceremony refuses
// the login before reaching this mutation; a zero counter from an
// authenticator that does not implement one (iCloud Keychain, Windows
// Hello) is NOT that case and lands here as a plain zero.
//
// Best-effort by contract: the login succeeds even when this write
// fails, matching touchBadgeLastUsed.

/// Stamp the verifier state on a passkey identity after a successful assertion: signature counter,
/// current backup state, and lastUsedAt. Best-effort; the login succeeds even when this write fails.
@mergeFields("credentials")
mutate identity recordPasskeyAssertion {
  args {
    identityId      string!
    credentialId    string!
    publicKey       string!
    signCount       int
    aaguid          string
    transports      []string
    backupEligible  bool
    backupState     bool
    registeredBy    string!
    lastUsedAt      string!
  }
  update {
    id: args.identityId
    credentials: {
        credentialId: args.credentialId,
        publicKey: args.publicKey,
        signCount: args.signCount,
        aaguid: args.aaguid,
        transports: args.transports,
        backupEligible: args.backupEligible,
        backupState: args.backupState,
        registeredBy: args.registeredBy,
        lastUsedAt: args.lastUsedAt
      }
  }
}

// ---- mutations/v1/identity/touchBadgeLastUsed.memql ----

// touchBadgeLastUsed
// ==================
//
// Best-effort lastUsedAt stamp after a successful grant exchange.
// Merges the credentials object wholesale (partial nested updates
// are not supported), so the handler passes the full credentials
// map with only lastUsedAt changed.

/// Stamp credentials.lastUsedAt on a badge identity after a successful grant exchange. Best-effort;
/// the grant succeeds even when this write fails.
mutate identity touchBadgeLastUsed {
  args {
    identityId   string!
    credentials  object!
  }
  update {
    id: args.identityId
    args.credentials
  }
}

// ---- mutations/v1/identity/rotateAuthSession.memql ----

// rotateAuthSession
// =================
//
// Bumps the per-session refresh-token bookkeeping after a successful
// /auth/refresh call. The refresh handler atomically:
//   1. Verifies the presented refresh token matches the prior
//      refreshTokenHash (mismatch => token theft, revoke session).
//   2. Mints a new access + refresh token pair.
//   3. Calls this mutation with the new refresh hash + new expiry.
//
// lastRefreshedAt is stamped to now; the
// `firstAuthenticatedAt + MEMQL_IDENTITY_SESSION_MAX_DAYS` and
// `lastRefreshedAt + MEMQL_IDENTITY_SESSION_IDLE_DAYS` checks in the
// refresh handler use these two timestamps to enforce idle and
// max-age limits.
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field (subject, tokenHash, source) on every
// refresh. Only the rotation-bookkeeping fields change.
//
// Arguments:
//   sessionId                   (string)  - Session node ID
//   newRefreshTokenHash         (string)  - SHA-256 hex of the freshly minted refresh token
//   previousRefreshTokenHash    (string)  - SHA-256 hex of the OLD hash being rotated FROM (kept valid in a grace window so an aborted-mid-response client can recover)
//   newExpiresAt                (string)  - New absolute expiry for the access token (ISO 8601)
//

/// Rotate refresh-token bookkeeping on a session after a successful refresh. Stores the old hash as
/// previousRefreshTokenHash with a fresh previousRotatedAt timestamp so the rotator can accept that
/// hash inside its grace window.
mutate authSession rotateAuthSession {
  args {
    sessionId                 string!
    newRefreshTokenHash       string!
    previousRefreshTokenHash  string!
    newExpiresAt              string!
  }
  update {
    id: args.sessionId
    refreshTokenHash: args.newRefreshTokenHash
    args.previousRefreshTokenHash
    previousRotatedAt: now
    expiresAt: args.newExpiresAt
    lastRefreshedAt: now
  }
}

// ---- mutations/v1/identity/scheduleAccountDeletion.memql ----

// scheduleAccountDeletion
// =======================
//
// Stamps deletionScheduledAt on a v1:identity:user row. The
// accountDeletionSweep cron picks the row up later and hard-deletes
// it once MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS have elapsed. The user
// can reverse the request during the cooldown via
// cancelScheduledDeletion.
//
// Partial-update via update() so the caller doesn't have to re-pass
// every @required field on the user. Only deletionScheduledAt
// changes.
//
// Arguments:
//   userId  (string)  - User node ID
//

/// Schedule the user for hard-deletion after the cooldown.
mutate user scheduleAccountDeletion {
  args {
    userId  string!
  }
  update {
    id: args.userId
    deletionScheduledAt: now
  }
}

// ---- mutations/v1/identity/setUserActiveSpace.memql ----

// setUserActiveSpace
// ==================
//
// Switches the caller's activePartitionId pointer. Phase 4 of the chat-
// architecture plan -- the activity model's only mutation: each human
// is active in at most one space at a time. Camera, mic, voice
// transport, video presence are all bound to this pointer.
//
// Caller passes partitionId="" (empty) to clear the pointer (closing the
// app, leaving every space). Otherwise partitionId is the canonical id of
// the space being activated.
//
// Server-stamping: the underlying engine update() reads the existing
// user row by id and shallow-merges {activePartitionId: <new>} on top.
// The frontend computes the user id from the JWT subject and passes it
// here; abuse mitigation rests on the partition-ACL middleware
// (cluster-wide owner check) and the engine's standard write
// authorization (a user cannot mutate another user's row without
// elevated role -- the bun update path keys on v1:identity:user.id and
// access control would catch a cross-user write).
//
// Discussion mode (Phase 6) and voice migration (Phase 7) read
// activePartitionId on every iteration, so a switch fires their state
// transitions implicitly -- no separate notification needed.

/// Set or clear the caller's activePartitionId. Empty partitionId clears the pointer.
mutate user setUserActiveSpace {
  args {
    userId         string!
    partitionId        string
    activePartitionId  string
  }
  update {
    id: args.userId
    // Accept either `partitionId` (the param-style name; what the SPA and the
    // 2-Spaces QA suite pass) or `activePartitionId` (the concept-field name; what
    // the 1-Identity QA suite passed and silently lost). Both land on the
    // concept's activePartitionId field; empty/missing clears the pointer. (#1633)
    activePartitionId: args.partitionId ?? args.activePartitionId ?? ""
  }
}

// ---- mutations/v1/identity/updateClusterSettings.memql ----

// updateClusterSettings
// =====================
//
// Update the singleton v1:identity:clusterSettings row keyed by
// id="cluster". The admin UI calls this when an operator edits a
// runtime-tunable setting; the full row payload is passed every
// time (MemQL is append-only, partial updates require a read-
// modify-write cycle on the caller).
//
// Schema-equivalent to createClusterSettings but kept as a
// distinct mutation so the audit trail can distinguish first-run
// wizard writes from admin edits, and so the args schema can be
// tightened later (e.g. require non-empty registrationMode) without
// disturbing the wizard path.
//
// Arguments mirror createClusterSettings.
//

/// Update the singleton cluster-settings row from the admin UI. Read-merges the existing row
/// (update()): only the fields the caller actually passes change; every omitted field --
/// internalDomains, brand*, TTLs, bootstrap*, etc. -- inherits from the persisted row instead of
/// being wiped to its empty default (memql#1686). registrationMode + internalDefaultRole stay
/// @required because the admin form always submits them. `bootstrappedAt` is additionally @noUnset:
/// the verifier's stamp (empty -> set) still lands, but no admin edit can take a stamped cluster back
/// to un-bootstrapped by passing it explicitly empty -- un-bootstrapping is not an ordinary write
/// (memql#3415).
@noUnset("bootstrappedAt")
mutate clusterSettings updateClusterSettings {
  args {
    id                         string!
    clusterDomain              string
    brandName                  string
    brandPrimaryColor          string
    brandLogoDataURI           string
    brandIconDataURI           string
    registrationMode           enum("open", "domain_restricted", "invite_only", "waitlist")!
    registrationDomains        string
    internalDomains            string
    internalDefaultRole        enum("owner", "admin", "developer", "writer", "reader")!
    registeredClientsJSON      string
    accessRequestNotifyEmails  string
    bootstrapEmail             string
    bootstrapFirstName         string
    bootstrapLastName          string
    bootstrapPhone             string
    bootstrapPrimaryRole       string
    bootstrapGender            string
    bootstrapBirthdate         string
    bootstrappedAt             string
    accessTokenTTLSeconds      int
    refreshTokenTTLSeconds     int
    magicLinkTTLSeconds        int
    invitationTTLDays          int
    refreshCookieSameSite      string
    authoredAutomationsEnabled bool
  }
  update {
    accept { id, clusterDomain, brandName, brandPrimaryColor, brandLogoDataURI, brandIconDataURI, registrationMode, registrationDomains, internalDomains, internalDefaultRole, registeredClientsJSON, accessRequestNotifyEmails, bootstrapEmail, bootstrapFirstName, bootstrapLastName, bootstrapPhone, bootstrapPrimaryRole, bootstrapGender, bootstrapBirthdate, bootstrappedAt, accessTokenTTLSeconds, refreshTokenTTLSeconds, magicLinkTTLSeconds, invitationTTLDays, refreshCookieSameSite, authoredAutomationsEnabled }
  }
}

// ---- mutations/v1/identity/updateIdentity.memql ----

// updateIdentity
// ==============
//
// Inserts a new version of an identity record with the provided payload.
// The caller is responsible for passing the full updated payload.

/// Update an identity record. Read-merges the existing row (update()): only the fields in `payload`
/// change; every omitted field (identityType discriminator, credentials, label, active,
/// usableByAgents) inherits from the persisted row instead of being wiped (memql#1628 class). The
/// row must already exist (use createIdentity to create).
mutate identity updateIdentity {
  args {
    identityId  string!
    payload     object!
  }
  update {
    id: args.identityId
    args.payload
  }
}

// ---- mutations/v1/identity/updateUser.memql ----

// updateUser
// ==========
//
// Partial-update of a v1:identity:user record. Uses update() (which
// reads the latest existing row, splats the supplied fields on top,
// and writes the merged payload) so a caller doesn't have to re-pass
// every field on the user concept just to change ONE.
//
// Why update() and not insert(): MemQL's `insert()` is a full-replace
// -- any field the caller omits gets dropped. A partial write carrying
// only a handful of fields would silently wipe the user's directory
// fields (firstName, lastName, phone, primaryRole, gender, birthdate,
// ...) on every call.
//
// update() does a SHALLOW merge: top-level fields in the partial
// replace those in the prior; nested objects (like `preferences`) are
// replaced whole, not deep-merged. Nothing on the user concept needs
// deep merge today -- a caller changing one key of `preferences` sends
// the whole spread.
//
// CALLERS: exactly one in production, the identity admin server
// (component/identity/admin/handlers.go), which queries the user first
// and stitches the full payload. update() with a full payload behaves
// identically to insert(), so that path is unchanged. Two DB acceptance
// tests also drive it as setup scaffolding, and both stamp an internal
// origin.
//
// An earlier version of this comment named four frontend preferences-sync
// helpers as callers. They belonged to an SPA that has since been retired:
// none of those identifiers exists in any current client -- checked across
// the org when @serverOnly landed, covering both the product client and the
// Go SDK consumer. The claim is DELETED rather than softened, because it
// contradicted the annotation immediately below it, and a stale caller list
// on a security-gated mutation is the exact pattern memql#2991 was filed to
// punish ("true of the tool path, and only of the tool path").

/// Partial update of a v1:identity:user row. Only the fields you pass are changed; other fields
/// inherit from the prior row. SERVER-ONLY: the caller supplies both the target id and the payload,
/// and the payload can carry `role`, so this is an administrative write gated in Go rather than a
/// client-callable one.
///
/// memql#2991. `update { id: args.userId; args.payload }` relates the target to nothing: no
/// predicate ties args.userId to actor.userId, `role` is a plain settable enum carrying no
/// @internal / @serverSet, and a payload SPLAT names no fields at all -- so
/// validateMutationCallerArgs is structurally blind to it and would be even if `role` were
/// annotated. Row-authz covered nothing here either -- when this was written it applied nothing
/// anywhere, and now that it does (memql#3172 / #3174) `v1:identity:user` still declares no tier,
/// deliberately and permanently enough to be argued at the concept (memql#3349 / #3350). A client
/// could name any user id and any role.
///
/// @serverOnly is the right gate rather than a stop-gap, because this mutation has exactly one
/// legitimate caller: the identity admin server (component/identity/admin/handlers.go), which
/// already authorizes through admin/auth.go. The authorization genuinely lives in Go; this puts the
/// boundary where it already is. The general update-by-id class -- an owner predicate checked
/// before the write -- is memql#2803 Phase 5 and is deliberately NOT attempted here.
@serverOnly
mutate user updateUser {
  args {
    userId   string!
    payload  object!
  }
  update {
    id: args.userId
    args.payload
  }
}

// updateMyPreferences
// ===================
//
// The general self-scoped preferences write (memql#4522). Before it, the tree
// had NO client-reachable way to change v1:identity:user.preferences at all:
// updateUser above is @serverOnly (caller-supplied target, and a payload that
// can carry `role`), and the one live self-scoped preference write was the
// computer-use kill switch in dsl/worker/mutations.memql. The portal's /me
// Settings tab is the caller.
//
// # The row is the caller's, and nothing else is spellable
//
// `id: actor.userId` is the memql#2840 pattern. There is no caller-supplied
// target argument, so pointing this at another user is not a permission the
// mutation refuses -- it is a call that cannot be written. Same reasoning as
// toggleComputerUseEnabled, and the same deliberate absence of an admin
// override: the administrative path is updateUser, which says so in its name
// and is gated in Go.
//
// # @mergeFields("preferences") is what puts two keys out of reach
//
// update() replaces a top-level field WHOLESALE, and an absent optional arg
// OMITS its leaf rather than writing a null (memql#3617). Without merge
// semantics this write would therefore replace the whole preferences object
// with whatever subset the caller sent -- and an engaged kill switch
// (computerUseEnabled: false) would come back ABSENT, which downstream Go
// reads as the @default("true") that is never applied on write. A stale client
// bag would silently re-enable computer use for the user who had turned it off.
//
// @mergeFields("preferences") makes the write a recursive deep merge
// (mergePayloadFields -> deepMergeObjects), so a stored key the partial does
// not carry survives. computerUseEnabled and activeAssistantId are not keys in
// this template and no argument reaches them, so they survive EVERY call by
// construction. That is memql#4520 D3's requirement met by the mutation
// grammar rather than by a Go seam: the two keys are unreachable because they
// are UNSPELLABLE here, not because something inspects the payload for them.
//
// Delete the annotation and the guarantee leaves with it, silently and with
// every test that only checks the happy path still green. What stands in the
// way is TestUpdateMyPreferencesLeavesProtectedKeysAlone in component/memql --
// it engages the kill switch, writes an unrelated preference, and asserts the
// switch is still present and still false.
//
// # Why the two numeric bounds are annotations and the 30/60 choice is a range
//
// cursorTweenMs carries the concept's documented 250-2500 through @minimum /
// @maximum. archiveRetentionDays gets @minimum(30) @maximum(60) rather than a
// two-member set: an args @enum takes STRING literals, and opening it to
// numbers would compare a parsed member against the float64 a JSON caller
// sends under reflect.DeepEqual and refuse every value. The two documented
// choices are made the only ones a person can send by the SELECT in the
// Settings tab; what this bound guarantees is that nothing outside the
// documented window is stored. Both refuse rather than clamp -- a preference
// silently coerced to a value the user did not pick is worse than an error.

/// Update the CALLER's own v1:identity:user.preferences. Partial: an omitted field keeps its
/// stored value. The target row is stamped from actor.userId, so there is no caller-supplied
/// target and no admin override. It cannot reach preferences.computerUseEnabled (the computer-use
/// kill switch, owned by toggleComputerUseEnabled) or preferences.activeAssistantId (an
/// app-managed pointer): neither is a key this mutation writes, and @mergeFields("preferences")
/// preserves the stored value of every key a call does not carry.
@actor
@mergeFields("preferences")
mutate user updateMyPreferences {
  args {
    /// BCP 47 language tag (e.g. en-US). Empty clears it.
    language                  string  @pattern("^$|^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$")
    /// Whether to receive notifications.
    notifications             bool
    /// Server-side theme preference, which serves product SPAs. The portal's own theme is a
    /// per-browser header toggle and is deliberately not this field.
    theme                     enum("light", "dark", "system")
    /// IANA timezone name (e.g. America/Los_Angeles). Empty falls back to UTC.
    timezone                  string  @pattern("^$|^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){0,2}$")
    /// How long an archived space lives before the purge sweep hard-deletes it. 30 or 60.
    archiveRetentionDays      int     @minimum(30) @maximum(60)
    /// Whether the daily-space automation provisions a per-day space for this user.
    dailySpaceEnabled         bool
    /// What happens to yesterday's daily space when the rollover cron fires.
    dailySpaceRolloverAction  enum("archive", "save")
    /// Standard Mode cursor tween duration in milliseconds.
    cursorTweenMs             int     @minimum(250) @maximum(2500)
    /// Standard Mode visual appearance during an agent UI-control takeover.
    takeoverMode              enum("clean", "dim")
    /// Interactive Mode pace preset.
    interactivePace           enum("quick", "steady", "deliberate")
    /// Per-user mic mode preference for Polyphon rooms.
    voiceMode                 enum("toggle", "continuous")
  }
  update {
    id: actor.userId
    preferences: {
        language: args.language,
        notifications: args.notifications,
        theme: args.theme,
        timezone: args.timezone,
        archiveRetentionDays: args.archiveRetentionDays,
        dailySpaceEnabled: args.dailySpaceEnabled,
        dailySpaceRolloverAction: args.dailySpaceRolloverAction,
        cursorTweenMs: args.cursorTweenMs,
        takeoverMode: args.takeoverMode,
        interactivePace: args.interactivePace,
        voiceMode: args.voiceMode
      }
  }
}

// setAccountEntitlement
// =============================
//
// Set (upsert) an account's task-concurrency entitlement (epic
// memql#902 / foundation child #903). Mints a deterministic per-account
// id (accountEntitlement-<hash(accountId)>) so each call appends a new
// time-series version and the latest wins -- billing / admin tooling
// calls this to change a tier's cap without a code change. Set
// maxConcurrentTasks to a finite N to cap the account at N concurrent
// running Plans; a value <= 0 (or tier='enterprise') leaves the account
// unlimited. System / admin-actor mutation.

/// Set (upsert) an account's task-concurrency entitlement (epic memql#902 / #903). Deterministic
/// per-account id so each set appends a new version and the latest wins. Finite maxConcurrentTasks
/// caps the account; <=0 or tier='enterprise' leaves it unlimited.
mutate accountEntitlement setAccountEntitlement {
  args {
    accountId          string!
    tier               enum("free", "pro", "team", "enterprise")!
    maxConcurrentTasks int
    accountKind        enum("user", "org")
    note               string
  }
  insert {
    accept { accountId, tier }
    stamp {
      id: concat("accountEntitlement-", hash(args.accountId))
      accountKind: args.accountKind ?? "user"
      maxConcurrentTasks: args.maxConcurrentTasks ?? 0
      note: args.note ?? ""
    }
  }
}

/// Rename an enrolled passkey. Changes only the display label -- the credential itself is untouched.
mutate identity renamePasskeyIdentity {
  args {
    identityId  string!
    label       string!
  }
  update {
    id: args.identityId
    args.label
  }
}

/// Revoke (deactivate) a passkey identity row. Soft-delete via active=false -- the row stays for
/// audit, and its credential id stays taken so the same authenticator cannot be re-enrolled onto a
/// fresh row.
mutate identity revokePasskeyIdentity {
  args {
    identityId  string!
  }
  update {
    id: args.identityId
    active: false
  }
}

/// Persist an enrolment-token row at issue time.
///
/// `invitationId` is the invitation-accept path's attribution (memql#4880).
/// OPTIONAL, and in accept{} rather than stamp{}, so an omitted arg is dropped
/// from the payload entirely and the portal and install-wizard issuers write no
/// key at all. `issuedBy` stays a USER on every path -- the concept declares it
/// a parent edge onto v1:identity:user and the engine refuses anything else --
/// which is why the invitation gets a field of its own instead of riding there.
mutate enrolmentToken createEnrolmentToken {
  args {
    enrolmentId   string!
    userId        string!
    tokenHash     string!
    issuedBy      string!
    expiresAt     string!
    sourceIP      string
    invitationId  string
  }
  insert {
    accept { userId, tokenHash, issuedBy, expiresAt, invitationId }
    stamp {
      id: args.enrolmentId
      sourceIP: args.sourceIP ?? ""
    }
  }
}

/// Stamp an enrolment-token row consumed.
mutate enrolmentToken consumeEnrolmentToken {
  args {
    enrolmentId     string!
    consumedAt      string!
    consumedFromIP  string
  }
  update {
    accept { consumedAt }
    stamp {
      id: args.enrolmentId
      consumedFromIP: args.consumedFromIP ?? ""
    }
  }
}

/// Stamp an enrolment-token row revoked.
mutate enrolmentToken revokeEnrolmentToken {
  args {
    enrolmentId  string!
    revokedAt    string!
  }
  update {
    accept { revokedAt }
    stamp {
      id: args.enrolmentId
    }
  }
}

// ---- mutations/v1/identity/createRecoveryKeyIdentity.memql ----

// createRecoveryKeyIdentity
// =========================
//
// Persists a freshly-minted owner recovery key (memql#3964). Takes the HASH,
// never the plaintext -- the signature is the enforcement, exactly as in
// createEnrolmentToken: a caller cannot hand this mutation a plain key even by
// mistake, because there is no parameter for one.
//
// EVERY ARG IS @required, INCLUDING rotatedFrom, and that is the memql#3617
// lesson applied rather than rediscovered. `credentials` is rebuilt here as an
// object literal and an absent optional arg omits its leaf, so on an insert
// with a caller-chosen id a second write read-merges and replaces the WHOLE
// object -- destroying leaves the second call did not pass. @mergeFields is a
// load-time error on an insert, so the destroying call is made unspellable
// instead. Nothing is lost: the mint path has every value by construction, and
// an empty rotatedFrom on the first mint is a legal value passed explicitly.

/// Persist a minted owner recovery key. Stores only the SHA-256 digest; the plaintext is revealed
/// once at claim time and never persisted.
///
/// Why actor.userId scoping is not the fix: the mint invariant runs at identity boot under the
/// system actor, so actor.userId is empty and a self-scoped filter would refuse the only caller
/// there is. And scoping to the CALLER would be actively wrong here rather than merely useless --
/// it would legitimise a caller minting a recovery key for themselves, which is the escalation
/// this construct must not offer at all. @serverOnly bars it from the generated SDK; the memql#2513
/// credential-actor guard rejects a non-system actor writing the row even over a raw ExecuteQuery.
/// Both, because either alone leaves a route: the SDK is not the only way to name a mutation.
@serverOnly
mutate identity createRecoveryKeyIdentity {
  args {
    identityId        string!
    userId            string!
    label             string!
    keyHash           string!
    boundOwnerUserId  string!
    mintedBy          string!
    rotatedFrom       string!
  }
  insert {
    id: args.identityId
    args.userId
    identityType: "recovery_key"
    credentials: {
        keyHash: args.keyHash,
        boundOwnerUserId: args.boundOwnerUserId,
        mintedBy: args.mintedBy,
        claimedAt: "",
        claimedFromIP: "",
        redeemedAt: "",
        redeemedFromIP: "",
        rotatedFrom: args.rotatedFrom
      }
    args.label
    usableByAgents: false
    active: true
  }
}

// ---- mutations/v1/identity/claimRecoveryKey.memql ----

// claimRecoveryKey
// ================
//
// Stamps the moment an operator was shown the plaintext (memql#3969). The key
// stays usable afterwards -- claiming is not spending -- but it stops being
// re-mintable, because from here on somebody holds it.
//
// @mergeFields("credentials") makes this nested write MERGE-SEMANTIC. Without
// it the two stamped leaves would be the whole `credentials` object and
// keyHash itself would be destroyed, which is a bricked credential rather than
// a lost field: nothing could ever resolve the row again, and the break-glass
// route would be silently gone until somebody needed it.

/// Stamp claimedAt / claimedFromIP after revealing a recovery key's plaintext exactly once.
///
/// Why actor.userId scoping is not the fix: the sole caller is `memql recovery-key claim`, running
/// inside the identity pod under the system actor with no human actor at all -- claiming exists for
/// the operator who cannot sign in, so actor.userId is empty and a self-scoped filter would match
/// nothing. @serverOnly keeps it off the wire entirely, which is the stronger statement: no client
/// has any business touching a recovery-key row.
@serverOnly
@mergeFields("credentials")
mutate identity claimRecoveryKey {
  args {
    identityId     string!
    claimedAt      string!
    claimedFromIP  string!
  }
  update {
    id: args.identityId
    credentials: {
        claimedAt: args.claimedAt,
        claimedFromIP: args.claimedFromIP
      }
  }
}

// ---- mutations/v1/identity/redeemRecoveryKey.memql ----

// redeemRecoveryKey
// =================
//
// Spends the key (memql#3968). Stamps the redemption and DEACTIVATES the row
// in the same write.
//
// THE `active: false` IS THE SINGLE-USE GUARANTEE AND MUST NOT BE SPLIT OUT.
// Redemption and deactivation in one mutation means there is no window in
// which a redeemed key is still resolvable as live -- a second presentation of
// the same plaintext during that window would enrol a second passkey against
// an owner who by definition is not watching. Two mutations would also let a
// caller do the first and forget the second, which is a standing
// owner-equivalent password created by omission.
//
// The successor is minted by the standing invariant (memql#3965) rather than
// here, so the cluster is never left without a break-glass route.
//
// @mergeFields("credentials") for the same reason as claimRecoveryKey: the two
// stamped leaves must not become the whole object.

/// Spend a recovery key: stamp redeemedAt / redeemedFromIP and deactivate the row in one write.
///
/// Why actor.userId scoping is not the fix: redemption is PRE-ACTOR by construction -- the whole
/// point is an owner with no sign-in route, so actor.userId is empty and a self-scoped filter would
/// refuse every redemption. The row is selected by an id the ceremony resolved ITSELF, from the
/// keyHash it just verified, never from a caller argument; the caller proves possession of a
/// 256-bit secret, which is the authorization. @serverOnly bars it from the wire.
@serverOnly
@mergeFields("credentials")
mutate identity redeemRecoveryKey {
  args {
    identityId      string!
    redeemedAt      string!
    redeemedFromIP  string!
  }
  update {
    id: args.identityId
    credentials: {
        redeemedAt: args.redeemedAt,
        redeemedFromIP: args.redeemedFromIP
      }
    active: false
  }
}

// ---- mutations/v1/identity/deactivateRecoveryKey.memql ----

// deactivateRecoveryKey
// =====================
//
// The rotation path's half of "mint a replacement, retire the predecessor"
// (memql#3970). Distinct from redeemRecoveryKey because the two are different
// events with different audit meanings: a redeemed key was USED, a
// deactivated one was REPLACED without ever being used, and collapsing them
// would make the audit trail unable to tell a break-glass event from
// routine hygiene.

/// Retire a recovery key without spending it -- the predecessor half of an owner-driven rotation.
///
/// Why actor.userId scoping is not the fix: the recovery key's `userId` is the bound cluster owner,
/// and rotation is reachable by an ADMIN as well as by that owner (the adminops owner/admin gate),
/// so actor.userId==userId would refuse the admin half of the surface it exists for. The owner/admin
/// check runs in component/identity/adminops before this is ever called, and the post-redemption
/// successor path calls it under the system actor with no human actor at all.
@serverOnly
mutate identity deactivateRecoveryKey {
  args {
    identityId  string!
  }
  update {
    id: args.identityId
    active: false
  }
}

/// Mint a user-targeted invitation: the credential that lets an address register (memql#4270).
///
/// THE HALF THAT WAS MISSING. v1:identity:invitation has carried kind="user"
/// since it was written, and the identity login page has REDEEMED one the whole
/// time (stage needs_invite, form=invite). Nothing ever issued one -- the only
/// writer of invitation rows was the guest-space flow, so an owner could put a
/// cluster into invite_only mode and then have no way to let anybody in.
///
/// Only the token HASH is written. The plaintext is returned once by the
/// caller's reply and persisted nowhere, the same convention every other
/// credential row in this domain follows.
///
/// @serverOnly, and actor.userId scoping is not the fix -- it is the WRONG
/// question. This row does not belong to the caller. An invitation is a
/// credential for somebody who has no account yet, so there is no ownership
/// relation for a per-row filter to test; scoping to actor.userId would say
/// "you may invite yourself", which is not an operation anybody wants.
///
/// The real decision is "may this caller invite anyone at all", which is a
/// ROLE question, and it has a second half no row carries: the cluster's
/// registration policy. Under domain_restricted the address must match the
/// allowlist; under open the link is a courtesy rather than a gate. Neither
/// fact is on the invitation, so the check cannot be a filter over it.
/// component/identity/adminops is where the caller, their role and the
/// cluster settings are all in hand at once.
@serverOnly
mutate invitation createUserInvitation {
  args {
    invitationId  string!
    email         string!
    tokenHash     string!
    expiresAt     datetime!
    inviterId     string!
    inviterName   string
    role          string
  }
  insert {
    accept { tokenHash, expiresAt, inviterId }
    stamp {
      id: args.invitationId
      kind: "user"
      inviteeEmail: args.email
      inviteeRole: args.role ?? ""
      inviterName: args.inviterName ?? ""
      status: "pending"
      active: true
      // not_attempted until recordUserInvitationDelivery says otherwise. The
      // row exists BEFORE the send -- the link is composed from it -- so the
      // verdict is a second write rather than an argument here (memql#4587).
      deliveryState: "not_attempted"
    }
  }
}

/// Record what happened to an invitation's EMAIL, on the row (memql#4587).
///
/// The verdict already reached the audit trail and the issuing operator's own
/// response. Neither is visible to the operator who comes back a week later and
/// asks why somebody never joined: `status: pending` reads identically whether
/// the invitee got the link or the panel was closed and forgotten. That is how
/// memql#4583 went unnoticed until the owner asked the colleague in person.
///
/// A SECOND WRITE rather than an argument to createUserInvitation, because the
/// row has to exist before the link can be composed and the link has to exist
/// before anything can be sent. It is also what a resend updates.
///
/// @serverOnly, and actor.userId scoping is NOT the fix here.
///
/// Caller-scoping restricts WHOSE rows a caller may write. It cannot restrict
/// WHAT may be claimed about them, and the value this mutation carries is a
/// claim about the SERVER'S OWN I/O -- whether a mail provider accepted the
/// message. An operator scoped to their own invitations could still stamp
/// `sent` on one nobody sent, which makes this surface lie in exactly the
/// direction it exists to stop: the whole point of memql#4587 is that a list
/// reading "delivered" when nothing was delivered is how memql#4583 stayed
/// invisible for its whole life.
///
/// So the bar is not about ownership at all. There is no caller: the identity
/// node writes this under internal origin, immediately after the send it just
/// attempted, recording something only it observed.
@serverOnly
mutate invitation recordUserInvitationDelivery {
  args {
    invitationId   string!
    /// not_attempted when this node has no mail seam -- nobody asked for a
    /// send; sent when the provider accepted it; failed when it was tried and
    /// refused. What the issuing path OBSERVED, never a guess.
    deliveryState  enum("not_attempted", "sent", "failed")!
    /// The provider's own text when deliveryState is failed, so an operator can
    /// tell a refused credential from a refused sender from an unreachable
    /// host. NEVER the link: that is a bearer credential.
    deliveryError  string
  }
  update {
    id: args.invitationId
    deliveryState: args.deliveryState
    deliveryError: args.deliveryError ?? ""
    deliveryAttemptedAt: now
  }
}

/// Bind a pending user invitation to the browser that FIRST opened its link
/// (memql#4601).
///
/// The invitation arrives by email, which means that on its own its holder is
/// anybody who can read the mailbox -- a forwarded message, a shared alias, a
/// mail scanner that follows links. This stamps the SHA-256 digest of the nonce
/// handed to the opening browser as a cookie, and the accept path then completes
/// only for a browser that presents the preimage. It is magicLinkRequest's
/// device binding (design D2, memql#4302) applied one credential over.
///
/// FIRST TOUCH ONLY, AND THE NO-OVERWRITE RULE IS THE WHOLE CONTROL. A row a
/// second browser can re-bind is an unbound row: the forwardee opens the link,
/// takes the binding, and the accept then completes for THEM while the person
/// the invitation names is locked out of their own invitation. So "do not
/// overwrite" is not idempotence hygiene, it is the property the field exists
/// for, and every caller has to preserve it.
///
/// IT IS NOT ENFORCED HERE, and it cannot be. A mutation body has no predicate
/// to hang a compare-and-swap on -- `update{}` is a read-merge-write, ZERO
/// mutations in this tree carry a filter, and two concurrent writers each
/// produce a version with neither able to tell it lost. That is the same
/// finding component/identity/magic_link_gate.go records for the magic-link
/// consume, and it takes the same answer: the compare and the swap both happen
/// in Go, inside one critical section, in Store.BindUserInvitation. This
/// construct is the SWAP half, and it is unconditional by construction.
///
/// @serverOnly, and here actor.userId scoping is not merely the wrong question
/// -- it is answered "yes" by exactly the caller who must be refused. This
/// writes a caller-supplied DIGEST that decides which browser may accept, which
/// is the credential-forging shape createGuestInvitation and
/// rotateGuestInvitationToken already carry: on the wire, any authenticated
/// caller could bind an invitation they merely know the id of to a cookie they
/// hold, and then accept it. A self-scoped filter passes them, because they
/// legitimately are an authenticated user. And the legitimate caller cannot be
/// scoped at all, for markUserInvitationAccepted's reason one construct down:
/// the toucher of a /join link is unauthenticated by construction, so
/// actor.userId is empty for every honest call.
@serverOnly
mutate invitation bindUserInvitation {
  args {
    invitationId  string!
    bindingHash   string!
  }
  update {
    accept { bindingHash }
    stamp {
      id: args.invitationId
    }
  }
}

/// Stamp a user invitation accepted, at the moment its holder finishes
/// registering (memql#4606).
///
/// THE WRITE THAT MAKES THE CREDENTIAL SINGLE-USE. The resolve path refuses a
/// row whose status is not "pending" with `invitation_already_used`, and on a
/// kind="user" row nothing ever moved it off "pending". The concept has
/// declared "accepted" in its status enum and documented inviteeId as "Stamped
/// on acceptance" since it was written; only the write side was missing, so the
/// status check tested a value that could not change. One link was redeemable
/// for its whole TTL, and a forwarded email stayed live for every recipient who
/// read it.
///
/// respondedAt rather than a second timestamp, because the concept carries ONE
/// response stamp and both kinds write it. `active` is deliberately untouched:
/// it means "not soft-cancelled", which is what revokeUserInvitation writes, and
/// an accepted invitation was not cancelled. Keeping the two outcomes distinct
/// on the row is what lets the redeeming page say "somebody cancelled this"
/// rather than "you already used this" -- the distinction revokeUserInvitation
/// records just below.
///
/// `inviteeId` is required rather than optional, for markGuestInvitationAccepted's
/// reason: `??` is blank-coalescing, so an optional one would let a caller that
/// resolved no user id write the empty string and leave a row that says accepted
/// without saying by whom. The sigil buys PRESENCE rather than content, though --
/// required-arg validation admits "" -- so the refusal that actually holds the
/// line is in component/identity/store.go, which will not send either id empty.
/// The id always exists by then: the invitee's user row is created or resolved by
/// the redemption path before the invitation is stamped, never after.
///
/// @serverOnly, and actor.userId scoping is not the fix. The answer differs from
/// the guest twin's by one step rather than in kind. The caller is the INVITEE,
/// mid-registration: this runs on the redemption path, which is unauthenticated
/// by construction -- it IS the request that creates the account -- so
/// actor.userId is empty for every legitimate caller and a self-scoped filter
/// would match zero rows for the only caller that ever runs it.
///
/// The row's two user pointers are no better. `inviterId` names the wrong person
/// outright, and revokeUserInvitation records the same policy objection to
/// filtering on it. `inviteeId` is the field this mutation SETS: it is empty on
/// every kind="user" row until this write lands, so a filter over it would test
/// the value being written.
///
/// What authorizes the write is possession of the token: the caller presented a
/// plaintext whose SHA-256 matches the row's tokenHash, and the resolve path
/// checked kind, active, status, expiry and the invited ADDRESS before this
/// runs. The boundary sits where that authorization already lives, which is the
/// argument setOAuthClientCORSOrigins makes and the guest half repeats. On the
/// wire this would also be the denial-of-service primitive the write itself
/// creates: burning an invitation is what makes it single-use, so any
/// authenticated caller could name an arbitrary invitation id and burn it before
/// its holder ever clicked.
@serverOnly
mutate invitation markUserInvitationAccepted {
  args {
    invitationId  string!
    inviteeId     string!
  }
  update {
    accept { inviteeId }
    stamp {
      id: args.invitationId
      status: "accepted"
      respondedAt: now
    }
  }
}

/// Revoke an unaccepted invitation before its TTL runs out (memql#4270).
///
/// @serverOnly, and actor.userId scoping is not the fix -- it would be a
/// narrower rule than the one that is correct. Scoping to the caller means
/// only the ORIGINAL INVITER can revoke, and the case revocation exists for is
/// precisely the one where that is wrong: an admin sends a link to the wrong
/// address and an owner has to kill it. `inviterId` is on the row, so the
/// filter is expressible; it is just the wrong policy.
///
/// The right rule is the same owner/admin gate the issuing side takes, applied
/// in component/identity/adminops where the caller's role is in hand -- with
/// one audited event per call, refusals included.
///
/// A SOFT cancel: active goes false and the row stays. It is audit history, and
/// its tokenHash must remain taken -- revoking a row does not make the holder
/// forget the token they were sent, and a hash that came free could be minted
/// onto a second invitation. Same reasoning the passkey revoke path records.
///
/// Distinct from acceptance all the way down, so the redeeming page can say
/// "somebody cancelled this" rather than "you already used this" -- two
/// different next steps for the person holding the link.
@serverOnly
mutate invitation revokeUserInvitation {
  args {
    invitationId  string!
  }
  update {
    stamp {
      id: args.invitationId
      active: false
      status: "dismissed"
      respondedAt: now
    }
  }
}

// ---- mutations/v1/identity/guestInvitation.memql ----

// The GUEST half of the invitation lifecycle (memql#4258)
// =======================================================
//
// These four sat in `component/grpc/guest_handlers.go` as statement text
// naming constructs that existed in no .memql file anywhere in this
// repository. `git log -S` finds them nowhere in dsl/ in the tree's whole
// history, so this is a gap rather than a move: the engine's parser could not
// resolve them, and on a cluster running the embedded tree EVERY guest-invite
// write failed at execute. What made the gap invisible is that two of the same
// file's siblings -- createAuthSession / revokeAuthSession -- ARE engine
// constructs, so the file looked like it was calling into the engine
// throughout.
//
// WHY THE ENGINE OWNS THEM, rather than a product bundle at MEMQL_DSL_PATH.
// The `invitation` concept, the `invitationFull` shape and both lookup queries
// (invitationByTokenHash / invitationById) are already engine constructs; the
// kind="user" siblings createUserInvitation / markUserInvitationAccepted /
// revokeUserInvitation sit directly above; and the handlers are first-party
// engine gRPC. A first-party handler calling a construct the engine does not
// own -- with no declared dependency and no failure path saying so -- is the
// shape the issue rejected. The product-specific part of a guest flow is the
// SPACE, and that lives on the participant side in dsl/cognition.
//
// ALL FOUR ARE @serverOnly, and it is not a formality. Each writes a
// `tokenHash`, which is the whole credential: the guest-auth interceptor
// admits `Authorization: Guest <token>` by hashing the bearer and matching
// this column. Client-reachable, createGuestInvitation is a
// credential-FORGING primitive -- any authenticated caller could mint a row
// carrying a hash they chose and then present its preimage. The authorization
// that belongs in front of these is the inviter's relationship to the space,
// which the handlers already hold; the boundary therefore sits where the
// authorization already lives, exactly as setOAuthClientCORSOrigins argues.
//
// THE THREE UPDATES CARRY MINIMAL ARGS ON PURPOSE. Their call sites re-supply
// the whole invitation -- spaceName, inviterId, inviterName, inviteeEmail,
// tokenHash -- "so the latest-wins projection keeps the context". That was
// true before memql#1628 and has not been since: `update{}` read-merges the
// persisted row, so an omitted field inherits rather than blanking. Declaring
// the discriminators here would invite callers to keep passing a row they read
// a moment ago, which is a lost update waiting for two concurrent writers.
// (revokeAuthSession in this same file has the same stale call sites; they are
// corrected in the same change.)

/// Create a guest invitation: an external email address, a token the recipient is sent, and only
/// that token's SHA-256 hex digest on the row. The plaintext leaves the server in the email and is
/// never persisted -- the same contract every other credential row in this file keeps.
///
/// The kind="guest" twin of createUserInvitation above. The two differ in what the recipient
/// becomes: a user invitation authorizes registration as a cluster user and carries an inviteeRole,
/// while a guest joins ONE space as a participant with no account of their own, which is why this
/// one carries partitionId + spaceName and no role.
///
/// WHY actor.userId SCOPING IS NOT THE FIX. It would be satisfied by every authenticated caller,
/// because the caller legitimately IS an authenticated user -- an insert stamped with their own
/// inviterId passes any self-scoped filter while still minting a credential. What actually gates
/// this write is the inviter's relationship to the SPACE, and a space is not a field this concept
/// can be filtered on. On the wire it is a credential-FORGING primitive: the caller supplies
/// tokenHash, so they could mint a row carrying a digest they chose and then present its preimage
/// to the guest-auth interceptor. The handlers hold the real check; the boundary sits there.
///
/// `accountId` is the client tie (epic memql#4800, D5): which client's person this guest is.
/// OPTIONAL, and in accept{} rather than stamp{}, so an omitted arg is dropped from the payload
/// entirely and an inviter who never mentioned an account writes no key at all -- every existing
/// caller's behaviour is byte-identical. It GRANTS NOTHING: an account is a record, never an
/// authorization boundary (D1), so a guest invited "for" a client reaches exactly the one space
/// this invitation already named and not a byte more. The field is what lets the Users app say
/// who a guest is for, and what a future client-access feature would point at.
@serverOnly
mutate invitation createGuestInvitation {
  args {
    invitationId  string!
    partitionId   string
    spaceName     string
    inviterId     string!
    inviterName   string
    inviteeEmail  string!
    inviteeName   string
    tokenHash     string!
    expiresAt     datetime!
    accountId     string
  }
  insert {
    accept { tokenHash, expiresAt, inviterId, inviteeEmail, accountId }
    stamp {
      id: args.invitationId
      kind: "guest"
      partitionId: args.partitionId ?? ""
      spaceName: args.spaceName ?? ""
      inviterName: args.inviterName ?? ""
      inviteeName: args.inviteeName ?? ""
      status: "pending"
      active: true
    }
  }
}

/// Stamp a guest invitation accepted, at the moment the guest redeems the link and lands in the
/// space. Read-merges, so every discriminator on the row inherits.
///
/// `inviteeName` is accepted because acceptance is the first point at which the GUEST states their
/// own name -- until then the row carries whatever the inviter typed. It is required rather than
/// optional deliberately: `??` is blank-coalescing, so an optional one would let a guest who
/// submits an empty name silently overwrite the inviter's suggestion with the empty string.
///
/// WHY actor.userId SCOPING IS NOT THE FIX. There is no actor to scope to. The caller here is the
/// GUEST, who by definition has no v1:identity:user row -- that is what makes them a guest -- so
/// the accept path runs under contextWithSystemActor and a self-scoped filter would match zero
/// rows for the only caller that ever runs this. Scoping to inviterId instead would name the wrong
/// person entirely: the inviter is not the one accepting.
@serverOnly
mutate invitation markGuestInvitationAccepted {
  args {
    invitationId  string!
    inviteeName   string!
  }
  update {
    accept { inviteeName }
    stamp {
      id: args.invitationId
      status: "accepted"
      respondedAt: now
    }
  }
}

/// Kick a guest -- which is also what CANCELLING a pending guest invitation does, since both end
/// the same way: the link stops working and the row stays as audit history.
///
/// A SOFT cancel, for the reason revokeUserInvitation records: the tokenHash must remain taken,
/// because revoking a row does not make the holder forget the token they were sent, and a hash
/// that came free could be minted onto a second invitation.
///
/// Neither invitationByTokenHash nor invitationById filters on `active` today -- the resolve
/// handler decides on `status` and `expiresAt` in Go. Setting it anyway keeps the field's meaning
/// ("set false to soft-cancel") true of this row, so a future query that DOES filter on it is
/// correct rather than surprising.
///
/// WHY actor.userId SCOPING IS NOT THE FIX -- the same finding revokeUserInvitation records twenty
/// lines up, and it is a POLICY objection rather than an availability one. The only plausible
/// filter is inviterId, which is on the row and perfectly expressible; it just encodes the wrong
/// rule. It would mean only the ORIGINAL INVITER can cancel or kick, and the case cancellation
/// exists for is precisely the one where that is wrong: somebody sends a link to the wrong address
/// and an owner has to kill it. The right rule is the owner/admin gate applied where the caller's
/// role is in hand.
@serverOnly
mutate invitation markGuestInvitationKicked {
  args {
    invitationId  string!
  }
  update {
    stamp {
      id: args.invitationId
      status: "kicked"
      active: false
      respondedAt: now
    }
  }
}

/// Rotate a guest invitation's token on resend: the row takes the new hash and keeps the OLD one on
/// previousTokenHash, so /join/<oldToken> can answer `superseded` rather than a bare `invalid`
/// (memql#108).
///
/// Exactly ONE generation of history, by design -- the rotation before last drops off. Status is
/// untouched: a resend does not un-expire or re-open anything, it replaces the credential.
///
/// WHY actor.userId SCOPING IS NOT THE FIX. This writes tokenHash from a caller-supplied value,
/// which makes it the same credential-forging shape as the create above and immune to the same
/// filter: a self-scoped caller passes it while still choosing the digest that will admit a
/// bearer. inviterId is the only other candidate and carries revokeUserInvitation's policy
/// objection -- an admin resending on the original inviter's behalf is the ordinary case, not the
/// exception.
@serverOnly
mutate invitation rotateGuestInvitationToken {
  args {
    invitationId       string!
    tokenHash          string!
    previousTokenHash  string
  }
  update {
    accept { tokenHash }
    stamp {
      id: args.invitationId
      previousTokenHash: args.previousTokenHash ?? ""
    }
  }
}
