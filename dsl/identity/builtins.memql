// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@executor("integration.identity.createDelegation")
@args(profile="object")
@description("Create a delegation granting an agent scoped authority to act on behalf of an identity.")
builtin identityCreateDelegation {
  identityId       string!
  identitySubject  string!
  identityType     string!
  agentId          string!
  roleCeiling      string!
  scopes           object!
  expiresAt        string
  note             string
}

// ---- queries/v1/identity/builtin/builtinIdentityResolveDelegation.memql ----

// builtinIdentityResolveDelegation - Resolve Delegation for Agent
// ================================================================
//
// Resolve the active delegation chain for an agent subject.
// Returns the delegation record linking the agent to its delegating identity.

@executor("integration.identity.resolveDelegation")
@args(profile="object")
@description("Resolve the active delegation chain for an agent subject. Returns the delegation record.")
builtin identityResolveDelegation {
  agentSubject  string!
}

// ---- queries/v1/identity/builtin/builtinIdentityRevokeDelegation.memql ----

// builtinIdentityRevokeDelegation - Revoke Identity Delegation
// =============================================================
//
// Revoke an existing delegation by ID, deactivating all scoped
// authority it granted.

@executor("integration.identity.revokeDelegation")
@args(profile="object")
@description("Revoke an existing delegation by ID, deactivating all scoped authority it granted.")
builtin identityRevokeDelegation {
  delegationId  string!
}

// ---- queries/v1/identity/builtin/builtinIdentityValidateScope.memql ----

// builtinIdentityValidateScope - Validate Delegation Scope
// =========================================================
//
// Check whether a delegation permits a specific operation.
// Returns a boolean result.

@executor("integration.identity.validateScope")
@args(profile="object")
@description("Check whether a delegation permits a specific operation. Returns boolean result.")
builtin identityValidateScope {
  delegationId  string!
  operation     string!
}

/// Reassign every row one principal owns to another.
///
/// THE COUNTERPART TO RANK-STRICT WRITES (memql#4838, epic memql#4832 O1).
/// D3 makes peer rows read-only at every rung -- owner-to-owner included -- so
/// an owner who leaves the company leaves rows no living principal can edit.
/// This closes that, and a break-glass WRITE ESCAPE deliberately does not: an
/// escape is available to everyone who can reach it, which is the whole
/// cluster-owner tier, and it would hollow out D3 on the day it shipped. A
/// transfer names a new owner and leaves the rank rules untouched -- the row
/// simply has a different owner afterward, and every predicate keeps its
/// meaning.
///
/// Cluster-owner only. Refused when the destination principal does not exist
/// or is deactivated, because transferring into a void recreates the problem
/// silently: the rows are still there, still unwritable, now with an audit
/// trail saying they were handed over. Cluster-owned rows (empty owner) are
/// SKIPPED rather than transferred -- `v1:accounts:account:self` has no
/// meaningful second owner, and handing the deployment's own company to a
/// person is a downgrade, not a transfer.
///
/// Audited once for the whole transfer on v1:identity:auditEvent -- the
/// DECISIONS log -- not once per row moved: the decision was taken once, by
/// one person, about one pair of principals.
@description("Reassign every row one principal owns to another. Cluster-owner only; audited.")
@executor("integration.identity.transferRowOwnership")
builtin transferRowOwnership {
  /// The principal whose rows are being handed over.
  fromUserId  string!
  /// The principal receiving them. Must exist and be active.
  toUserId    string!
  /// Narrow the transfer to a single concept. Absent transfers every concept declaring an owned tier.
  concept     string
  /// Narrow the transfer to a single row. Offboarding is per-user; a single stuck row is not.
  rowId       string
}
