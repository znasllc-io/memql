// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Create a delegation granting an agent scoped authority to act on behalf of an identity.
@executor("integration.identity.createDelegation")
@args(profile="object")
builtin identityCreateDelegation {
  identityId       string!
  identitySubject  string!
  identityType     string!
  agentId          string!
  roleCeiling      string!
  scopes           object!
  expiresAt        string
  note             string
}

// ---- queries/v1/identity/builtin/builtinIdentityResolveDelegation.memql ----

// builtinIdentityResolveDelegation - Resolve Delegation for Agent
// ================================================================
//
// Resolve the active delegation chain for an agent subject.
// Returns the delegation record linking the agent to its delegating identity.

/// Resolve the active delegation chain for an agent subject. Returns the delegation record.
@executor("integration.identity.resolveDelegation")
@args(profile="object")
builtin identityResolveDelegation {
  agentSubject  string!
}

// ---- queries/v1/identity/builtin/builtinIdentityRevokeDelegation.memql ----

// builtinIdentityRevokeDelegation - Revoke Identity Delegation
// =============================================================
//
// Revoke an existing delegation by ID, deactivating all scoped
// authority it granted.

/// Revoke an existing delegation by ID, deactivating all scoped authority it granted.
@executor("integration.identity.revokeDelegation")
@args(profile="object")
builtin identityRevokeDelegation {
  delegationId  string!
}

// ---- queries/v1/identity/builtin/builtinIdentityValidateScope.memql ----

// builtinIdentityValidateScope - Validate Delegation Scope
// =========================================================
//
// Check whether a delegation permits a specific operation.
// Returns a boolean result.

/// Check whether a delegation permits a specific operation. Returns boolean result.
@executor("integration.identity.validateScope")
@args(profile="object")
builtin identityValidateScope {
  delegationId  string!
  operation     string!
}
