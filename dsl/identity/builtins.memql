@args(profile="object")
@description("Create a delegation granting an agent scoped authority to act on behalf of an identity.")
builtin identityCreateDelegation {
  identityId       string!
  identitySubject  string!
  identityType     string!
  agentId          string!
  roleCeiling      string!
  scopes           object!
  expiresAt        string
  note             string
}

