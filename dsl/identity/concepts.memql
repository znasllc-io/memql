// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use agents.concepts.{ agent }

/// Self-service access request placed on the waitlist queue. Created when an unknown email submits
/// the registration form while MEMQL_IDENTITY_REGISTRATION_MODE=approval. Admins triage rows in the
/// admin console: approval mints a v1:identity:invitation and emails a magic link; rejection stamps
/// the reason and closes the row. Also auto-aged by the accessRequestExpirySweep cron once
/// IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS has elapsed without a decision. Global scope so admins in
/// any partition (typically owners of the cluster) can review the queue.
@displayCard(primary="email", secondary="name", tertiary="reviewedBy", status="status")
concept accessRequest {
  email             string!  @description("Email address the requester wants to register with. Same value flows into the eventual v1:identity:user.primaryEmail on approval.")
  name              string  @description("Display name supplied at submission time. Optional (some flows ask, some don't).")
  additionalContext string  @description("Free-text 'what would you use this for' answer the requester can optionally supply. Helps admins triage but never gates access by itself.")
  status            enum("pending", "approved", "rejected", "expired")!  @default("pending")  @description("Lifecycle. pending = on the queue. approved = admin clicked approve and the invitation was minted. rejected = admin closed the row with reviewerNote. expired = aged out by accessRequestExpirySweep cron.")
  riskScore         int  @description("Composite risk score (0-100) computed at submission time from riskSignals. Higher = more suspicious. Surfaced to admins in the queue so they can triage cleanly. Never auto-rejects; admins always make the call.")
  riskSignals       string  @description("Comma-separated signal tags that fed riskScore. Examples: disposable_domain,velocity_per_ip,typo_squatted_domain,known_breach_email. Admin UI renders each tag as a chip with a tooltip.")
  sourceIP          string  @description("IP the submission came from. Captured for audit and to feed velocity-per-IP risk signals.")
  userAgent         string  @description("User-Agent header at submission. Captured for audit; bot-fingerprint heuristics may reference it.")
  reviewedBy        string  @description("v1:identity:user.id of the admin who acted on the row. Empty until reviewed.")
  reviewedAt        datetime  @description("Timestamp of the admin decision. Empty until reviewed.")
  reviewerNote      string  @description("Free-text rationale recorded by the admin. Required by UX convention for rejections; optional but encouraged for approvals. Stored verbatim for audit -- never edited.")
  invitationId      string  @description("Set on approval to the v1:identity:invitation row that was minted to deliver the magic link. Empty for pending / rejected / expired rows.")

  @relationship(type="parent", field="reviewedBy", target=user, direction="outgoing")
  @relationship(type="parent", field="invitationId", target=invitation, direction="outgoing")
}

/// Append-only audit log entry. Captures security-relevant events (auth, identity, authorization,
/// configuration, admin) with actor + target + source attribution. Global scope so any cluster
/// operator can read the full trail. Retention controlled by
/// MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS via the daily auditEventRetentionSweep automation. The
/// prevEventHash field is reserved for future hash-chain tamper-resistance; written but not
/// validated in MVP.
///
/// TIER: `clusterOwner`, and that is a RULING rather than a default (memql#4366, which carved this
/// decision out of memql#4313). Three things ruled out the alternatives:
///
///   - `owner="actorUserId"` cannot be declared. createAuditEvent writes actorUserId from CALLER
///     ARGS, which TestDeclaredOwnerFieldsAreServerStamped refuses for a declared owner field --
///     and re-stamping it from the actor would be WRONG rather than inconvenient: the identity
///     service writes these on a user's behalf, and actorUserId is deliberately EMPTY for an
///     anonymous event. A tier whose owner field is empty on the rows that matter most is a tier
///     that admits nobody to them.
///   - The composite `owner=..., clusterOwner` cannot deliver "an admin reads all" either.
///     `clusterOwner` is `Role == owner` ALONE (AccessContext.IsClusterOwner), so an admin would
///     be passed by a requiresOwnerOrAdmin query gate and then narrowed by the tier to nothing.
///     memql#4313 assumed the two were the same; they are not.
///   - `via="<spec>"` over a role predicate would parse, and is refused on meaning. The granted
///     tier's whole design premise is "a row in isolation cannot answer this, the filter's join
///     can" -- which is FALSE for a role check, needing no row at all. Every fail-closed edge it
///     has (graph traversal, top-level builtin results, the write guard) would then fail for a
///     reason that does not apply.
///
/// So the ruling is the one memql#4366 offers as the alternative: THE CLUSTER-WIDE SECURITY LOG IS
/// OWNER-ONLY. It is the same split memql#4328 already made for its sibling -- recentAuthActivity
/// is the operator roll-up, authActivityForSelf is where a person reads their own story. Routine
/// MECHANICS are self-readable; security DECISIONS about the whole cluster are the operator's.
/// A non-owner admin keeps authActivityForSelf and loses the cluster-wide trail.
///
/// createAuditEvent is unaffected: the write guard resolves a TARGET ROW and so covers updates and
/// deletes, never creates (rowauthz_write_guard.go), and this concept is append-only with no
/// update path at all.
@rowAuthz(clusterOwner)
@displayCard(primary="action", secondary="category", tertiary="actorEmail", status="outcome")
concept auditEvent {
  occurredAt      datetime!  @description("When the event happened. May lag createdAt by milliseconds because the row is written after the event completes.")
  category        enum("auth", "identity", "authorization", "configuration", "admin", "data")!  @description("Coarse grouping for filtering and retention policy hooks.")
  action          string!  @description("Machine-readable action enum, lower_snake_case. Examples: login_attempted, login_succeeded, magic_link_issued, magic_link_approved, magic_link_approval_denied, magic_link_completed, magic_link_finish_blocked, magic_link_consumed, magic_link_refused_policy, auth_code_redemption_blocked, session_created, sign_in_notification_sent, sign_in_policy_changed, sign_in_policy_reset_by_admin, shared_mailbox_changed, session_revoked, refresh_token_reuse_detected, role_changed, partition_grant_created, registration_mode_changed, jwks_rotated. THIS LOG RECORDS DECISIONS AND SECURITY SIGNALS; routine mechanics live on v1:identity:authActivity (memql#4328). Four actions MOVED there and no longer appear here: session_refreshed, session_refresh_blocked, grace_window_accept, pat_auth_accepted. refresh_succeeded and refresh_token_theft_detected were listed here and are not, because nothing emitted either -- an example nothing writes reads as a control that exists. Their successors are real: the rotation event is session_refreshed on the activity stream, and refresh_token_theft_detected is superseded by refresh_token_reuse_detected, which memql#4329 actually emits. Unlike authActivity.action this stays an unconstrained string: this concept has many writers across the identity service and a closed enum here would refuse a new decision at insert time.")

  actorUserId     string  @description("v1:identity:user.id of the actor when authenticated. Empty for anonymous events (login attempts where no session yet exists).")
  actorEmail      string  @description("Email of the actor at the time of the event. Captured here for audit even after the user record is deleted — auditEvent rows are tombstoned, not removed, on user deletion.")
  actorRole       string  @description("Cluster role of the actor at the time of the event (owner / admin / developer / writer / reader). Captured for point-in-time accuracy.")
  actorIdentityId string  @description("v1:identity:identity.id of the credential the actor used (magic_link, api_key, etc.). Distinguishes 'logged in via web' from 'PAT in CI'.")

  targetType      enum("user", "session", "identity", "invitation", "accessRequest", "config", "magicLinkRequest", "authCode", "clusterSettings", "deviceCode", "delegation", "workerPairingCode", "enrolmentToken", "passkeyIdentity", "badgeIdentity", "appSession", "shopifyStore", "releaseCut", "oauthClient", "")  @default("")  @description("Concept type of the target row, if any. oauthClient names the RELYING PARTY rather than a row this cluster necessarily holds -- a built-in first-party client is compiled in, not stored (memql#4515) -- and is what a role-floor refusal on the SSO fast path targets, where no credential row was created to name instead. releaseCut names a v1:cluster:releaseCut row -- the DECISION to ship a version of MemQL itself, which belongs in this log rather than only in the cluster history (epic memql#4434). passkeyIdentity and badgeIdentity name the v1:identity:identity VARIANT rather than the concept, so a credential whose lifecycle is audited on its own (passkey register / login / rename / revoke, badge grant) stays distinguishable in the trail without parsing `action`. Every value here must also be accepted by createAuditEvent, and every value a Go writer emits must be here -- test/dslconformance/identity_audit_enum_contract_test.go walks the writers (memql#4213).")
  targetId        string  @description("Identifier of the target row when targetType is set.")
  targetEmail     string  @description("Email associated with the target, if applicable. Useful for filtering audit history by user without needing a join.")

  detail          object  @description("Action-specific structured payload. Schema varies by action; consumer code reads the keys it knows. Examples: {\"reason\":\"idle_timeout\"} for refresh failures, {\"oldRole\":\"writer\",\"newRole\":\"admin\"} for role changes, {\"riskScore\":62,\"signals\":[\"disposable_domain\",\"velocity\"]} for blocked registrations.")
  sourceIP        string  @description("IP address the event originated from. Best-effort — proxy chains and X-Forwarded-For honored only when the deployment trusts the proxy.")
  userAgent       string  @description("User-Agent header at the time of the event. Empty for non-HTTP-originated events.")
  correlationId   string  @description("Groups related events from one logical interaction. Example: a single login flow's attempt + magic-link issued + magic-link consumed + session created share one correlationId.")

  outcome         enum("success", "failure", "blocked", "")  @default("")  @description("Outcome marker for events where success/failure is meaningful. blocked = denied at policy layer (rate limit, risk threshold, etc.).")
  failureReason   string  @description("Free-text or enum reason when outcome=failure or outcome=blocked. Examples: token_expired, insufficient_role, rate_limited, risk_threshold_exceeded.")

  prevEventHash   string  @description("Reserved for future hash-chain tamper-resistance. SHA-256 hex digest of the previous event's full payload. Written from day one; chain validation enabled by a follow-up iteration.")

  @relationship(type="parent", field="actorUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="actorIdentityId", target=identity, direction="outgoing")
}

/// Routine authentication MECHANICS: refresh-token rotations, the blocked ones, grace-window
/// acceptances, and PAT-authenticated requests (memql#4328). The high-volume sibling of
/// v1:identity:auditEvent, split from it so the audit trail stays a log of DECISIONS AND SIGNALS
/// and is clean by construction rather than by a filter every reader has to remember.
///
/// WHY A SECOND CONCEPT. One rotation is one row, and the designed cadence is one rotation per
/// ~10.5 minutes per open tab. Two defects (memql#4326's skew-blind timer, memql#4327's
/// per-route probe) turned that into a row every few seconds, and the operator's Audit Trail --
/// a generic concept walk over auditEvent with no filter of any kind -- became unreadable.
/// Considered and rejected: a `severity` field plus a server-side filter on the generic browse
/// walk (new engine, SDK and view-kit machinery, epic #4274), and simply not persisting
/// rotations (which throws away the one signal showing WHICH DEVICE refreshed WHEN -- exactly
/// what you need when a refresh token is stolen, and what memql#4329's reuse detection is built
/// on). Two concepts also let retention differ, and keep a session's whole story one join on
/// sessionId.
///
/// `action` IS A CLOSED ENUM, unlike auditEvent.action. This concept has exactly four writers
/// and will not grow by convention; a fifth mechanic is a deliberate change to this line and to
/// the Go constants beside it, checked against each other by
/// test/dslconformance/identity_audit_enum_contract_test.go.
///
/// RETENTION IS REAL HERE. Rows older than MEMQL_IDENTITY_AUTH_ACTIVITY_RETENTION_DAYS (default
/// 30) are HARD-DELETED daily by a Go-side job on the identity node
/// (component/identity/authactivity, memql#4330) -- not counted, as auditEvent's observe-only
/// sweep does. Reuse detection therefore reaches back exactly that far; the default exceeds both
/// the 14-day idle timeout and the 30-day refresh TTL, so a token older than the window is dead
/// on its own account.
@rowAuthz(owner="actorUserId", clusterOwner)
@displayCard(primary="action", secondary="clientLabel", tertiary="actorEmail", status="outcome")
concept authActivity {
  occurredAt      datetime!  @description("When the mechanic happened. Written by the identity service at the moment it completes, so it is within milliseconds of the row's createdAt -- the retention job leans on that (it prunes on the hypertable's partition key and confirms against this field).")
  action          enum("session_refreshed", "session_refresh_blocked", "grace_window_accept", "pat_auth_accepted")!  @description("What happened. CLOSED, and each value has exactly one writer: session_refreshed and session_refresh_blocked are refresh.Rotator's two outcomes; grace_window_accept is the Rotator accepting the immediately-previous hash inside its 30s window (a legitimate mid-rotation retry, NEVER reuse -- see memql#4329); pat_auth_accepted is the PAT verifier, once per PAT-authenticated request. Every value here must also be accepted by createAuthActivity, and every value a Go writer emits must be here.")

  sessionId       string  @description("v1:identity:authSession row this concerns. Empty when the presented credential resolved to no session at all -- which is the session_not_found case, and the one a reuse lookup then investigates.")

  actorUserId     string!  @serverSet  @description("v1:identity:user this activity belongs to. THE ROW-AUTHZ OWNER FIELD: stamped from actor.userId by createAuthActivity and never accepted from caller args, which @serverSet turns from a convention into a load-time rejection. The Go writers reach it by running the write under auth.ContextWithUserActor for the user the SESSION resolved to -- the identity service knows whose session it is before the actor envelope does, because /auth/refresh is unauthenticated by construction. Empty when nothing resolved, which leaves the row readable by a cluster owner alone; an unattributable blocked attempt is an operator's row.")
  actorEmail      string  @description("Email of that user at the time, denormalized so the Trail-equivalent view has an actor column that is not blank. Point-in-time, like auditEvent's.")
  actorRole       string  @description("Cluster role at the time (owner / admin / developer / writer / reader).")
  actorIdentityId string  @description("v1:identity:identity the credential belongs to. For pat_auth_accepted this is the PAT row itself, which is what distinguishes one CI credential's traffic from another's.")

  sourceIP        string  @description("IP the request came from. Best-effort, same proxy caveat as auditEvent.sourceIP.")
  userAgent       string  @description("User-Agent at the time. With sourceIP this is the whole of what a user can be shown about a device that refreshed their session.")
  clientLabel     string  @description("Best-effort human device label (mirrors authSession.clientLabel) so a person reading their own activity sees 'Safari on macOS' rather than a UA string.")

  outcome         enum("success", "blocked")!  @description("Only two outcomes are reachable here: the mechanic completed, or it was refused. There is no `failure` value -- an internal error on this path returns before any row is written -- and no empty value, because a mechanic with no outcome is not a mechanic.")
  failureReason   string  @description("Why, when outcome=blocked. The rotator's existing reasons, unchanged: session_not_found, previous_refresh_grace_expired, session_revoked, session_expired_absolute, session_idle_timeout, session_max_age_exceeded.")

  retiredTokenHash string  @description("SHA-256 hex of the refresh token THIS rotation retired. The lookup key memql#4329's reuse detection runs on: a presented token matching no live session but matching a retired hash is a replay, not a stale cookie. Storing it is the same posture as authSession.previousRefreshTokenHash -- a retired token can no longer be used, and a digest cannot be reversed. Indexed by a partial index on this concept (20260823000000_auth_activity_retired_token_hash_idx).")

  detail          object  @description("Action-specific structured payload. Consumers read the keys they know, exactly as with auditEvent.detail.")

  @relationship(type="parent", field="actorUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="actorIdentityId", target=identity, direction="outgoing")
  @relationship(type="references", as="concerns", field="sessionId", target=authSession, direction="outgoing")
}

/// One-time OAuth authorization code, RFC 6749 §4.1 style. Minted at /auth/magic-link/consume when
/// the originating magic link carried an oauthCtxJSON (third-party OAuth client flow) and exchanged
/// at /oauth/token for an access + refresh token pair. Single-use, redirect-URI bound, client-ID
/// bound, ~60s TTL. Bound to the specific magic-link row it was minted from so a leaked code cannot
/// be replayed across sessions. Global scope: token redemption is unauthenticated and must work
/// without partition context.
///
/// NO PLAINTEXT IS STORED (issue #3187). This concept once carried a `code`
/// field holding the cleartext one-time code -- the only stored-plaintext
/// credential in the tree. Its description claimed the plaintext was "the
/// equality check on redemption". That was false: /oauth/token hashes the
/// presented code and looks the row up BY codeHash
/// (component/identity/http/token.go), AuthCodeRow has no Code member, and
/// authCodeFull never projected it. The field was written and read by nothing.
/// Finding a row by sha256(presented) IS the verification -- it proves the
/// presenter holds the preimage -- so removing the field cost no property.
// @no-displayCard: Single-use credential row: a secret hash plus opaque foreign keys and a
//   ~60s TTL. There is no human-facing identity to promote, and giving a
//   credential a browsable-looking label in a row list is the wrong
//   affordance.
concept authCode {
  codeHash            string!  @description("SHA-256 hex digest of the plaintext code. Primary lookup key in the token-exchange path -- avoids equality lookups on the plaintext.")
  clientId            string!  @description("OAuth client identifier the code was minted for. Token-exchange MUST verify the redeeming client matches; mismatched client = reject and audit as code_misuse.")
  redirectURI         string!  @description("redirect_uri value supplied at /authorize, exact-matched against the registered URI for clientId. Token-exchange MUST verify the redeeming request's redirect_uri matches; mismatched = reject.")
  state               string  @description("PKCE-style state value supplied at /authorize and echoed back on the redirect to redirectURI. Informational only at this layer (the OAuth client validates state on its end); persisted for audit correlation.")
  codeChallenge       string  @description("PKCE code_challenge (RFC 7636) captured when the OAuth context was established. Empty for legacy non-PKCE first-party flows. /oauth/token requires a matching code_verifier when this is set.")
  codeChallengeMethod string  @description("PKCE method: S256 (required for new flows) or plain. Empty when codeChallenge is empty.")
  userId              string!  @description("v1:identity:user.id the code authenticates. Stamped onto the resulting session at redemption.")
  identityId          string!  @description("v1:identity:identity.id of the magic_link credential the code was minted from. Stamped onto the session for per-credential lastUsedAt bookkeeping.")
  magicLinkRequestId  string!  @description("v1:identity:magicLinkRequest.id of the consumed magic link this code was minted from. Provides a 1:1 audit trail (one magic-link click yields exactly one auth code) and lets revoking a magic link cascade-invalidate any outstanding code.")
  expiresAt           datetime!  @description("Absolute expiration. ~60s after creation per RFC 6749 §4.1.2 guidance. Past this point the token-exchange rejects regardless of consumedAt.")
  consumedAt          datetime  @description("Set atomically on the first successful /oauth/token redemption. Non-nil = the code is spent and any further redemption attempt is rejected and audited as code_replay. Single-use enforcement is the load-bearing security property of OAuth auth codes.")
  consumedFromIP      string  @description("IP the redemption request came from. Captured for audit and anomaly detection.")

  @relationship(type="parent", field="userId", target=user, direction="outgoing")
  @relationship(type="parent", field="identityId", target=identity, direction="outgoing")
  @relationship(type="parent", field="magicLinkRequestId", target=magicLinkRequest, direction="outgoing")
}

/// RFC 8628 device authorization grant state (memql#3410). One row per `POST /device/code` call.
/// The device (a headless box, a hardened network, an editor extension that cannot bind a loopback
/// listener) holds the plaintext `device_code` and polls `/oauth/token`; the human carries the
/// short `user_code` to `/device` on a second device, signs in normally, and approves or denies.
/// BOTH credentials are hashed at rest -- the plaintext device_code is returned exactly once in
/// the `POST /device/code` response and the plaintext user_code is shown to the operator there and
/// typed into the verification page; neither is ever persisted. Single-use: `status` is the state
/// machine (pending -> approved -> redeemed, or pending -> denied), and only a row in `approved`
/// can be redeemed, exactly once. 10-minute TTL (expiresAt), independent of status.
// @no-displayCard: Single-use credential row, same reasoning as v1:identity:authCode and
//   v1:identity:workerPairingCode: two secret hashes plus a poll clock. There is no
//   human-facing identity to promote, and clientId is identical across every row a
//   given client mints.
concept deviceCode {
  clientId            string!  @description("OAuth client_id the device authorization was requested for. The token-grant redemption MUST verify the polling client matches; a mismatch is rejected and audited.")
  deviceCodeHash      string!  @description("SHA-256 hex digest of the plaintext `mql_dvc_<...>` device_code. Primary lookup key on the polling path. The plaintext is returned once in the POST /device/code response and never persisted.")
  userCodeHash        string!  @description("SHA-256 hex digest of the CANONICALIZED user_code (uppercased, separator stripped). Lookup key for the verification page. The plaintext is displayed by the requesting device and typed by the human; never persisted.")
  status              enum("pending", "approved", "denied", "redeemed")!  @description("The state machine. `pending` = awaiting the human. `approved` = the human said yes and the device may redeem exactly once. `denied` = the human said no; polling returns access_denied forever. `redeemed` = tokens were issued; any further poll is rejected. Expiry is orthogonal and read off expiresAt.")
  scope               string  @description("Space-delimited OAuth scope requested by the device, echoed onto the issued session. Empty when the device requested none.")
  codeChallenge       string  @description("PKCE code_challenge (RFC 7636) supplied at POST /device/code. Empty when the device did not use PKCE. When set, the device_code grant REQUIRES a matching code_verifier, exactly as the authorization_code grant does.")
  codeChallengeMethod string  @description("PKCE method: S256 (required for new flows) or plain. Empty when codeChallenge is empty.")
  expiresAt           datetime!  @description("Absolute expiration, ~10 minutes after creation per RFC 8628 §3.2. Past this the poll returns expired_token and the verification page refuses the code, regardless of status.")
  intervalSeconds     int!  @description("The minimum seconds the device must wait between polls, returned as `interval` in the device-authorization response and RE-READ on every poll. A poll that arrives sooner than this after lastPolledAt gets slow_down AND this value is increased by 5 (RFC 8628 §3.5), so an impatient client is progressively throttled rather than merely warned.")
  lastPolledAt        datetime  @description("Timestamp of the most recent /oauth/token poll against this row, stamped on EVERY poll including rejected ones. Paired with intervalSeconds to enforce the poll floor across replicas -- an in-memory clock would give each replica its own budget.")
  approvedByUserId    string  @description("v1:identity:user.id of the human who approved (or denied) at /device. Stamped from actor.userId, never accepted from caller args. Empty while pending.")
  approvedAt          datetime  @description("Stamped when the human approved. Empty otherwise.")
  deniedAt            datetime  @description("Stamped when the human denied. Empty otherwise.")
  redeemedAt          datetime  @description("Stamped on the first successful token redemption. Single-use enforcement: the redeem transition also flips status to `redeemed`, so a replayed device_code is rejected.")
  sourceIP            string  @description("IP the POST /device/code request came from. Shown on the approval page so the human can tell their own request apart from someone else's, and kept as an abuse signal.")
  userAgent           string  @description("User-Agent the POST /device/code request carried. Shown on the approval page for the same reason as sourceIP: it is the only evidence the approver has about what they are authorizing.")

  @relationship(type="parent", field="approvedByUserId", target=user, direction="outgoing")
}

/// Public OAuth client minted at dynamic client registration (RFC 7591). claude.ai / Claude
/// Desktop's 'add custom connector' flow POSTs to /register and cannot pre-configure a client_id,
/// so the identity service issues one here and looks it up at /authorize + /oauth/token exactly
/// like a static MEMQL_IDENTITY_REGISTERED_CLIENTS entry. Public clients only -- no secret is
/// issued (token_endpoint_auth_method = none). Global scope: registration + token redemption are
/// unauthenticated and must work without a partition context.
/// Because registration is unauthenticated, NOTHING on a freshly-registered row may confer a
/// privilege: corsOriginsJSON is the one field here an owner/admin has to write deliberately, and
/// it is written by nothing on the /register path (memql#3716).
@displayCard(primary="clientName", secondary="clientId", tertiary="tokenEndpointAuthMethod")
concept oauthClient {
  clientId                string!  @description("Public OAuth client_id issued at dynamic registration (RFC 7591). Lookup key in /authorize + /oauth/token.")
  clientName              string  @description("Human-readable client_name from the registration request.")
  redirectURIsJSON        string!  @description("JSON array of registered redirect_uris. Exact-matched (plus RFC 8252 loopback-any-port) at /authorize + /oauth/token.")
  grantTypes              string  @description("Space- or comma-joined grant_types (default authorization_code,refresh_token).")
  responseTypes           string  @description("Joined response_types (default code).")
  tokenEndpointAuthMethod string  @description("Client auth method; public clients use none (no secret issued).")
  registeredAt            string  @description("RFC3339 registration time. Mirrors the row's createdAt intrinsic (createdAt is reserved and cannot be a payload field), kept explicit so the RFC 7591 client_id_issued_at can be re-derived without the row envelope.")
  corsOriginsJSON         string  @description("JSON array of origins an owner/admin has granted credentialed CORS access for this client -- what makes a customer's own website able to call this cluster without an env change and a restart (memql#3716). EMPTY for every dynamically-registered client: /register is unauthenticated, so the allowance is a separate admin act on this row and a self-registered client cannot confer one on itself. Set only through IdentityAdminMsg / component/identity/adminops, and NEVER derived from redirectURIsJSON -- RFC 8252 loopback redirects are normal here (config.go implements it), so deriving would silently admit http://127.0.0.1 and hand every local process on somebody's machine cookie-bearing read access to identity. Entries are scheme + host + optional port and nothing else; '*' is refused on both the write and the read, because the CORS response always carries Access-Control-Allow-Credentials.")
}

/// Bearer-token session record. One row per access token issued by the identity service's
/// magic-link / refresh flow. Looked up on every authenticated request to enforce per-session
/// revocation; rows past expiresAt are tombstoned by GC, not by user action. Global scope: lives in
/// _system so any partition's middleware can resolve a session.
@displayCard(primary="subject", secondary="clientLabel", tertiary="lastActivityAt", status="source")
concept authSession {
  userId          string  @description("Owning v1:identity:user. Optional because rows are written at token-issuance time, which can race ahead of the magic-link verifier's user-row insert on first-time logins. Subject is the canonical lookup key.")
  identityId      string  @description("v1:identity:identity the session was minted from (typically the magic_link variant). Same caveat as userId.")
  subject         string!  @description("JWT subject claim. The canonical key for revoke-all; populated unconditionally so all-sessions revoke works even when the user record hasn't been bootstrapped yet.")
  tokenHash       string!  @description("SHA-256 hex digest of the bearer token. Primary lookup key in the auth hot path; the plain token is never stored.")
  source          enum("bff_exchange", "oidc_cookie")!  @description("Which auth flow created the row. bff_exchange = SPA token path (Authorization: Bearer). oidc_cookie = browser memql_auth-cookie path. Both variants are produced by the identity service's magic-link / refresh handlers.")
  clientLabel     string  @description("Best-effort human label parsed from User-Agent at issuance. Drives the device list in future per-session UIs.")
  expiresAt       datetime!  @description("Mirror of the JWT expiry. Sessions past this are dead even if not revoked.")
  lastActivityAt  datetime  @description("Bumped opportunistically by the auth middleware. Useful for surfacing 'last seen' on each device.")
  lastRefreshedAt datetime  @description("Bumped on every successful refresh-token rotation. Powers idle-timeout enforcement (refresh fails if lastRefreshedAt + MEMQL_IDENTITY_SESSION_IDLE_DAYS < now).")
  firstAuthenticatedAt datetime  @description("Set once on first issuance and never changed. Powers max-age enforcement (refresh fails if firstAuthenticatedAt + MEMQL_IDENTITY_SESSION_MAX_DAYS < now).")
  refreshTokenHash string  @description("SHA-256 hex digest of the current refresh token bound to this session. Rotated on every refresh. Used by the refresh handler to detect token theft (presenting a stale refresh = revoke entire session).")
  previousRefreshTokenHash string  @description("SHA-256 hex digest of the IMMEDIATELY-PREVIOUS refresh token, kept valid for a short grace window after rotation. Handles the 'client hard-refreshed mid-rotation' case: the server completed the rotation and stored the new hash, but the browser aborted before receiving the Set-Cookie response, so the browser still holds the old token. Within the grace window (see previousRotatedAt) the rotator accepts presentation of this hash and re-issues a fresh pair. Outside the window the field is treated as expired bookkeeping.")
  previousRotatedAt datetime  @description("Wall-clock timestamp at which previousRefreshTokenHash was the current hash. Combined with the rotator's grace-window constant (~30s) to decide whether the previous hash is still acceptable. Past the window, presenting the previous hash returns 401 like any other stale token.")
  revokedAt       datetime  @description("Set when the user revokes the session. Non-nil = middleware rejects the bearer token.")
  revokedReason   enum("user_action", "all_sessions", "admin", "reuse_detected", "")  @default("")  @description("Why the session was revoked. user_action = the per-device sign-out. all_sessions = the cross-device revoke. admin = staff-initiated. reuse_detected = a refresh token this session had already RETIRED was presented again (memql#4329); the rotator revokes the whole session, writes refresh_token_reuse_detected to v1:identity:auditEvent and notifies the user. It is the one value no human chose -- and the one that means the credential is believed to be in someone else's hands.")

  @relationship(type="parent", field="userId", target=user, direction="outgoing")
  @relationship(type="parent", field="identityId", target=identity, direction="outgoing")
}

/// Runtime-editable cluster settings. Single-row concept (id='cluster') that holds the
/// operator-tunable knobs originally bootstrapped from IDENTITY_* env vars. The first-run wizard
/// (Phase 3) writes this row; the admin app (Phase 6) edits it. Service.LiveConfig() reads from
/// here first and falls back to env so a fresh deployment is functional without any post-bootstrap
/// edits. Global scope so the configuration is reachable from every binary that needs it (identity
/// itself plus future per-node verifier middleware).
@displayCard(primary="clusterDomain", secondary="brandName", tertiary="bootstrapEmail", status="registrationMode")
concept clusterSettings {
  clusterDomain                   string  @description("The deployment-wide hostname suffix the operator entered at /setup (or supplied via MEMQL_IDENTITY_BOOTSTRAP_DOMAIN). Examples: memql.localhost, staging.acme.com, acme.com. Every public service URL the cluster builds derives from it: app.<clusterDomain> for the SPA, identity.<clusterDomain> for sign-in, bff.<clusterDomain> for the API, agent.<clusterDomain> for worker registration. Empty before the wizard runs.")
  registrationMode                enum("open", "domain_restricted", "invite_only", "waitlist")!  @default("open")  @description("Who can self-register. Mirror of MEMQL_IDENTITY_REGISTRATION_MODE.")
  registrationDomains             string  @description("Comma-separated allowlist used when registrationMode=domain_restricted. Mirror of MEMQL_IDENTITY_REGISTRATION_DOMAINS.")
  internalDomains                 string  @description("Comma-separated email-domain allowlist that flips the per-user 'internal' flag at first login. Internal users get the cluster-wide internalDefaultRole; external users get owner of an auto-created personal partition.")
  internalDefaultRole             enum("owner", "admin", "developer", "writer", "reader")  @description("Cluster-wide role granted to internal users on first login. Always written: createClusterSettings takes this as a required arg and stamps it; the 'writer' fallback lives in MEMQL_IDENTITY_INTERNAL_DEFAULT_ROLE, which is where the operator sets it.")
  brandName                       string  @description("Display name shown in the web UI and in outbound emails. Empty falls back to 'MemQL'.")
  brandPrimaryColor               string  @description("Hex color used as --brand-primary in the web UI. Empty falls back to a neutral blue.")
  brandLogoDataURI                string  @description("Optional horizontal brand logo (name+icon mark) encoded as a data URI. Used for the wide-display contexts (header brand, login page top). CSP allows img-src data: precisely so this can render without an external host.")
  brandIconDataURI                string  @description("Optional square brand icon (icon-only mark) encoded as a data URI. Used for compact contexts (favicon, collapsed sidebar, tile previews). Operators frequently want a wordmark in the header AND a tight icon for tabs / share previews -- keeping these as separate fields lets each render at its native aspect ratio.")
  registeredClientsJSON           string  @description("JSON array of {clientId, redirectURIs} entries — the relying parties allowed to initiate the OAuth-style code flow. Stored as a string because the engine doesn't yet support nested arrays of objects in concept fields. Mirrors MEMQL_IDENTITY_REGISTERED_CLIENTS.")
  accessRequestNotifyEmails       string  @description("Comma-separated list of operator addresses that get notified when a waitlist access-request is filed. Mirror of MEMQL_IDENTITY_ACCESS_REQUEST_NOTIFY_EMAILS.")
  accessRequestNotifyThrottleMins int     @default("5")  @description("Throttle window in minutes for the access-request notify emails. High-risk requests bypass via immediate-notify. Mirror of MEMQL_IDENTITY_ACCESS_REQUEST_NOTIFY_THROTTLE_MINUTES.")
  bootstrapEmail                  string  @description("Email captured by the first-run wizard for the cluster owner. Stamped here for audit even though the actual cluster-owner role is granted by the magic-link verifier when the operator clicks the bootstrap link, not from this row.")
  bootstrapFirstName              string  @description("Owner's given name captured by the first-run wizard. Read once by the magic-link verifier when the bootstrap user row is created (UserProfileSeed) and never used again. Stored on this row because the wizard runs before any user row exists -- there is nowhere else for it to live across the magic-link round-trip.")
  bootstrapLastName               string  @description("Owner's family name. Companion to bootstrapFirstName; same lifecycle.")
  bootstrapPhone                  string  @description("Owner's phone number captured by the wizard. Same lifecycle as bootstrapFirstName / bootstrapLastName.")
  bootstrapPrimaryRole            string  @description("Owner's free-form job title captured by the wizard. Same lifecycle.")
  bootstrapGender                 string  @description("Owner's self-identified gender captured by the wizard. Same lifecycle.")
  bootstrapBirthdate              string  @description("Owner's ISO-8601 date of birth captured by the wizard. Same lifecycle.")
  bootstrappedAt                  string  @description("RFC3339 timestamp stamped by the magic-link verifier when an operator clicks the wizard-issued bootstrap link. Empty means 'wizard hasn't run' OR 'wizard ran but ownership not yet claimed' -- /setup remains accessible in either case. Stored as string (not datetime) so empty-string is a legal value the JSON-schema validator accepts; readers parse it as RFC3339 when non-empty.")
  accessTokenTTLSeconds           int     @default("0")  @description("Lifetime of issued access tokens in seconds. 0 means 'fall back to MEMQL_IDENTITY_ACCESS_TOKEN_TTL_SECONDS env, or the 900s built-in default'. Bounded at the admin form layer to [60, 86400] (1 minute to 24 hours). Read on every /oauth/token + /auth/refresh issuance so changes apply on the next access-token mint without an identity restart.")
  refreshTokenTTLSeconds          int     @default("0")  @description("Absolute lifetime of refresh tokens in seconds. 0 means 'fall back to MEMQL_IDENTITY_REFRESH_TOKEN_TTL_SECONDS env, or the 30-day built-in default'. Bounded at the admin form layer to [86400, 31536000] (1 day to 1 year). Refresh rotation uses this for both the initial mint and the rotation-time max-age check; lowering it does NOT immediately invalidate live sessions but the next rotation that crosses the new ceiling will refuse.")
  magicLinkTTLSeconds             int     @default("0")  @description("How long an issued magic-link is valid. 0 means 'fall back to MEMQL_IDENTITY_MAGIC_LINK_TTL_SECONDS env, or the 600s built-in default'. Bounded at the admin form layer to [60, 3600] (1 minute to 1 hour). Short by design -- magic-links are click-through credentials, not session tokens.")
  invitationTTLDays               int     @default("0")  @description("How long an admin-issued user invitation token stays valid, in days. 0 means 'fall back to MEMQL_IDENTITY_INVITATION_TTL_DAYS env, or the 7-day built-in default'. Bounded at the admin form layer to [1, 90].")
  refreshCookieSameSite           enum("", "lax", "none")  @default("")  @description("SameSite policy for the refresh-token cookie. Empty = inherit from MEMQL_IDENTITY_REFRESH_COOKIE_SAMESITE env (which defaults to 'lax'). 'lax' is correct for the common same-site self-hosted topology (app.acme.com + identity.acme.com share an eTLD+1) and avoids Safari ITP scrutiny. 'none' is required for true cross-site deployments where the SPA and identity service live under different eTLD+1s (app.example.com + auth.example.net); browsers treat the cookie as third-party and apply ITP rules. The cookie is always Secure when BaseURL is HTTPS regardless of this setting.")
  authoredAutomationsEnabled      bool    @default("true")  @description("Cluster-wide GLOBAL KILL SWITCH for planner-authored automations (epic memql#954, issue #961). true = activated authored bundles fire normally; false = the authored runtime is halted across the WHOLE cluster -- no authored automation fires on any node until re-enabled, regardless of any individual bundle's status or any per-user kill switch. The governance hard stop for the authored-automation surface. Single-row (id='cluster') so every node reads the same value; flipped via setAuthoredAutomationsEnabled and read by the authored scheduler's global gate.")
}

/// Grants an AI agent the right to act through a user's v1:identity:identity for a bounded role
/// ceiling, scope set, and lifetime. Global scope: lives in _system and is readable from any
/// partition so cross-partition agent work does not require per-partition delegation rows.
@displayCard(primary="identitySubject", secondary="agentId", tertiary="roleCeiling", status="active")
concept delegation {
  identityId         string!  @description("Node ID of the v1:identity:identity granting authority. Through its userId the delegation resolves back to a v1:identity:user.")
  identitySubject    string!  @description("authenticated subject id of the delegating identity (denormalized for fast lookup on the auth hot path).")
  identityType       enum("human", "synthetic")!  @description("Type of the delegating identity. Separate from v1:identity:identity.identityType (which classifies the credential family); this classifies the principal behind it.")
  agentId            string!  @description("Node ID of the v1:agents:agent receiving delegated authority.")
  roleCeiling        enum("owner", "admin", "developer", "writer", "reader")!  @description("Maximum role the agent may assume under this delegation. The engine caps the effective role at RoleAtMost(identity.role, roleCeiling).")
  scopes             []string  @description("Allowed operation scopes. Empty means all operations within the role ceiling. Examples: query:*, mutation:cognition.*.")
  expiresAt          datetime  @description("When this delegation expires. Null means persistent (no expiry).")
  active             bool  @default("true")  @description("Whether this delegation is currently in effect.")
  createdBySubject   string!  @description("authenticated subject id of whoever authorized this delegation.")
  approvedBySubject  string  @description("authenticated subject id of the guardian who approved (for synthetic identity delegations).")
  revokedAt          datetime  @description("When this delegation was revoked.")
  revokedBySubject   string  @description("authenticated subject id of whoever revoked this delegation.")
  note               string  @description("Human-readable note about why this delegation was created.")

  @relationship(type="parent", field="identityId", target=identity, direction="outgoing")
  @relationship(type="references", field="agentId", target=agent, direction="outgoing")
}

/// An account or credential set owned by a v1:identity:user. One user can have many identities: a
/// magic-link verified email, OAuth accounts on external apps, API keys (Personal Access Tokens),
/// or service accounts. Agents borrow identities to act on the user's behalf via
/// v1:identity:delegation. Cluster-wide: one row set, the same from every caller's view.
//
// NO @rowAuthz TIER, AND IT CANNOT CARRY AN `owner` ONE (memql#3349).
// This is the recorded decision the issue asked for, not a backlog entry.
// Each blocker below was MEASURED by declaring @rowAuthz(owner="userId")
// here and running the existing gates; the inventory of all eleven reads
// lives in component/memql/identity_credential_rowauthz_inventory_3349_test.go.
//
//  1. `userId` IS NOT AN OWNERSHIP CLAIM. TestDeclaredOwnerFieldsAreServerStamped
//     reports SEVEN mutations writing it from caller args and ZERO stamping
//     it from actor.userId (createBadgeIdentity, createIdentity,
//     createNodeTokenIdentity, createPATIdentity, createVoiceAgentTokenIdentity,
//     createWorkerTokenIdentity, updateIdentity). That is the field's MEANING,
//     not a bug: an admin mints a PAT / worker token / badge FOR another user,
//     and a node token's userId is a machine binding. It names the credential's
//     SUBJECT. Stamping it from the actor would break admin issuance.
//
//  2. FOUR PRE-ACTOR READS BUILD THE ACTOR -- patIdentityByKeyHash,
//     workerTokenByKeyHash, badgeByKeyHash, nodeTokenIdentityByBinding.
//     component/identity/pat/verifier.go says it outright: "This is a pre-actor
//     read, so it cannot be caller-scoped (#2800, #2984)." enforceRowAuthzOnPlan
//     takes NO context and has no escape (the write path's rowAuthzWriteEscape
//     has no read-side counterpart), so a tier ANDs userId==actor.userId into
//     credential verification itself and every PAT / worker-token / badge /
//     node-token login fails. Measured: TestRowAuthzEnforcementLandGate reports
//     NINE of the eleven reads undecidable with the tier declared.
//
//  3. THE CONCEPT IS A UNION OF EIGHT CREDENTIAL KINDS with different subjects.
//     node_token and voice_agent_token authenticate a PROCESS, not a person;
//     nodeTokenIdentities is an operator listing of every node credential in
//     the cluster and is caller-scopable by nobody.
//
// Not open reads: every construct carries its own filter predicate. But a
// per-query predicate is exactly what @rowAuthz exists to stop relying on --
// it is author-enforced, and the next query starts from zero. The inventory
// test is the interim answer: a new read over this concept must classify
// itself, so it starts from a stated position instead.
//
// What would close it, in dependency order: (a) a read-path escape mirroring
// rowAuthzWriteEscape, so the pre-actor reads survive injection -- all four
// already stamp internal origin, the read path just cannot consult it;
// (b) a SPLIT by credential kind, so person-owned credentials carry
// owner="userId" and machine credentials carry clusterOwner. (b) is a data
// migration plus a wire-contract change, not an annotation.
@displayCard(primary="label", secondary="identityType", tertiary="userId", status="active")
concept identity {
  active          bool    @default("true")  @description("Soft-delete flag. Revoked credentials stay around for audit but are inactive.")
  userId          string!  @description("Owning v1:identity:user. Every identity must belong to exactly one user; a user can own many identities.")
  identityType    enum("oauth", "api_key", "service_account", "magic_link", "worker_token", "node_token", "voice_agent_token", "badge", "account_token", "passkey", "recovery_key")!  @description("Which credential family this identity belongs to. Determines the shape of the credentials object: see the credentials field below. The 'worker_token' variant authenticates a Cockpit worker process -- a machine running `memql worker run` (one credential per registered machine); it is server-side-scoped to WorkerService.Stream + audit-emit paths and is rejected by the auth interceptor on every other RPC. The 'node_token' variant authenticates a cluster-internal node binary (bff / voice / cognition / agent / planner / workbench) on NodeService.Stream; the interceptor pins this surface to node-class JWTs and rejects every other class (#105). The 'voice_agent_token' variant authenticates the Go voice-agent process on MemqlService.Stream; surface-pinned to VoiceAgent* payload types so a leaked credential can't drive other RPCs (#109). The 'account_token' variant is a credential ISSUED TO THIS USER ON BEHALF OF a v1:identity:account -- the subject is still userId, never the account, because nothing authenticates AS an account; it is admitted by NO verifier and NO interceptor today (memql#3322), so it grants nothing until the actor envelope carries a tenancy dimension. The 'passkey' variant is the only family here whose stored material is PUBLIC (a COSE public key) rather than a digest of a secret -- possession is proved by a signature the authenticator produces and the server verifies, so a leaked passkey row authenticates nobody (memql#3406). The 'recovery_key' variant is the OWNER BREAK-GLASS credential (memql#3964): one active row per cluster, bound to one owner, redeemed exactly once to register a passkey when that owner has lost every sign-in route. It is NOT a sign-in route itself and must never be counted as one -- signInIdentitiesForUser deliberately does not match it, because a key that counted itself would refuse itself forever.")
  credentials     object!  @description("Type-specific credential material. Shape is a oneOf picked by identityType: see the @variant block below. Raw OAuth tokens and API-key plaintext never live here.")  @variant(discriminator="identityType") {
    oauth {
      provider         string!  @description("External app identifier, e.g. \"slack\" or \"github\".")
      externalUserId   string!  @description("The user's id in the external app.")
      scopes           []string @description("OAuth scopes this identity holds.")
    }
    api_key {
      keyHash  string!  @description("SHA-256 hex digest of the key. Plaintext never stored.")
    }
    service_account {
      accountId  string!  @description("External service-account id.")
    }
    magic_link {
      verifiedAt     datetime!  @description("When the magic-link click verified email ownership. The single timestamp that proves the user owns this email.")
      lastLinkSentAt datetime  @description("Most recent magic-link send timestamp; used for client-side rate limit display.")
    }
    worker_token {
      name                    string!  @description("Operator-chosen worker name (also stamped on v1:worker:registration). Surfaced in /me/workers and /admin/workers. Useful when one user owns multiple workers.")
      keyHash                 string!  @description("SHA-256 hex digest of the mql_wkr_<32> token. Plaintext is shown once at issuance and never persisted.")
      registeredBy            string!  @description("v1:identity:user.id who minted the token. Same as Identity.userId for self-issued tokens; differs for admin-issued tokens (audit attribution).")
      capabilitiesAdvertised  []string  @description("Snapshot of the capabilities the worker advertised on its most recent connect. Informational; the live capability set lives on v1:worker:registration.")
      labelsAdvertised        object    @description("Snapshot of labels advertised on most recent connect. Informational.")
      lastSeenAt              string    @description("Last successful connect timestamp (RFC3339Nano), mirrored from v1:worker:registration for token-side queries. Stored as a string -- not datetime -- because empty string is a legal 'not set' encoding the schema validator accepts; readers parse it as RFC3339Nano when non-empty.")
      lastConnectedFromIP     string    @description("Source IP of the most recent connect. Audit signal.")
      expiresAt               string    @description("When the token expires (RFC3339Nano). Tokens auto-rotate every 90 days via in-stream RotationRequest; expiresAt drives the rotation prompt window. Stored as a string -- not datetime -- so empty string is a legal 'no expiry yet' encoding (the rotation flow stamps a real timestamp on first connect).")
    }
    node_token {
      nodeId            string!  @description("v1:cluster:node.id this credential authenticates. The verifier interceptor pins NodeService.Stream to this binding -- a token with nodeId=A trying to NodeHello as nodeId=B is rejected.")
      nodeType          string!  @description("Build-tag node type ('bff', 'voice', 'cognition', 'agent', 'planner', 'workbench'). Same value the binary stamps onto NodeHello.NodeType. The interceptor cross-checks: a token minted for nodeType=voice cannot drive a stream that announces nodeType=agent.")
      keyHash           string!  @description("SHA-256 hex digest of the mql_node_<32> token. Plaintext is shown once at mint time and never persisted -- operators copy the plain bearer into the node binary's MEMQL_NODE_TOKEN env var.")
      mintedBy          string!  @description("v1:identity:user.id of the admin who minted the token. Audit attribution; a node row's deployer is the human-on-the-team accountable for the credential.")
      expiresAt         string  @description("When the token expires (RFC3339Nano). Default 30 days. Empty string = 'no expiry stamped yet' (set on first verify).")
      lastConnectAt     string  @description("Most recent successful NodeHello timestamp (RFC3339Nano). Operator visibility into 'is this node still online' independent of v1:cluster:node liveness.")
      bootstrappedAt    string  @description("Most recent timestamp (RFC3339Nano) at which the identity service issued a token for this (nodeType, nodeId) via the POST /node/bootstrap self-mint path (memql#338 / #343). Empty when the row was minted out-of-band via the operator CLI (then mintedBy carries the human attribution instead).")
      bootstrappedFrom  string  @description("Source IP of the most recent /node/bootstrap caller for this row. Audit signal -- in a healthy cluster every value should resolve to a cluster-internal address. memql#343.")
    }
    badge {
      keyHash       string!  @description("SHA-256 hex digest of the badge/device identifier (NFC card UID, QR payload, device serial). The badge id is a PHYSICAL-WORLD identifier, not a server-minted secret, so this hash is a lookup key rather than a brute-force-resistant credential store -- the grant exchange compensates by requiring an already-authenticated terminal bearer, per-IP rate limiting, and audit (memql#2513). Plaintext badge ids are never persisted.")
      registeredBy  string!  @description("v1:identity:user.id of the admin who registered the badge. Audit attribution; self-registration stamps the owner.")
      lastUsedAt    string  @description("Most recent successful grant exchange timestamp (RFC3339Nano). Stored as a string so empty string is a legal 'never used' encoding. Best-effort stamp -- the grant succeeds even when the touch write fails.")
    }
    voice_agent_token {
      instanceId    string!  @description("Voice-agent instance identifier. Operator-chosen string that identifies the running Go voice-agent process (e.g. 'voice-agent-prod-us-east-1'). Stamped into the JWT subject so audit trails can attribute traffic to a specific instance; multi-instance deployments mint one token per process.")
      keyHash       string!  @description("SHA-256 hex digest of the mql_va_<32> token. Plaintext is shown once at mint time and never persisted -- operators copy the plain bearer into the voice-agent's VOICE_AGENT_TOKEN env var (the JWT replaces the legacy VOICE_AGENT_SHARED_TOKEN shared secret on a release-deprecation cycle).")
      mintedBy      string!  @description("v1:identity:user.id of the admin who minted the token. Audit attribution.")
      expiresAt     string  @description("When the token expires (RFC3339Nano). Default 90 days. Empty string = 'no expiry stamped yet' (set on first verify). Rotation = mint fresh + restart voice-agent; no refresh path.")
      lastConnectAt string  @description("Most recent successful MemqlService.Stream ClientHello timestamp (RFC3339Nano). Operator visibility into 'is the voice-agent connected'.")
    }
    account_token {
      accountId  string!  @description("v1:identity:account.id this credential is issued ON BEHALF OF. A BINDING, NOT A SUBJECT and NOT A SCOPE: the authenticated subject of this row is the enclosing identity's userId (the operator who owns the account), because nothing authenticates AS an account (docs/internal/design/account-isolation-model.md section 3.3). It is also not an authorization narrowing -- the actor envelope carries no tenancy dimension (section 5.2), so no engine mechanism can compare a row against it. What it IS: attribution on every audit event the credential's lifecycle emits, the key the operator's token list is grouped by, and the value that would populate actor.accountIds once section 6(b) lands.")
      keyHash    string!  @description("SHA-256 hex digest of the mql_acct_<43> token. The plaintext is returned exactly ONCE in the mint reply and is never persisted, never logged and never re-derivable. NOT an authentication index: no query looks a row up by this digest, deliberately (memql#3322) -- see the account-tokens runbook for why a credential with no admitting surface is the honest state of the art while section 6(b) is outstanding.")
      mintedBy   string!  @description("v1:identity:user.id of the operator who minted the credential. Equal to the enclosing identity's userId for every token minted today (the account's owner is the only principal that can mint one); carried separately so an admin-minted variant does not have to re-derive attribution from the audit trail.")
      expiresAt  string  @description("When the credential expires (RFC3339Nano). Empty string = no expiry stamped; revocation (active=false) is the operator's control either way. Stored as a string -- not datetime -- so empty is a legal 'not set' encoding the schema validator accepts, matching worker_token and node_token.")
    }
    passkey {
      credentialId    string!  @description("Base64url (unpadded) WebAuthn credential id -- the value the authenticator minted at registration and the browser hands back on every subsequent assertion. UNIQUE ACROSS THE CLUSTER, and that is load-bearing rather than tidy: a discoverable credential arrives at login carrying no user hint at all, so this id is the ONLY thing that resolves an assertion to a row (memql#3407). Registration therefore rejects an id that already exists rather than shadowing it. Not a secret -- it travels in the clear in every allowCredentials list.")
      publicKey       string!  @description("Base64url (unpadded) COSE_Key of the credential's PUBLIC half, stored as the attestation delivered it so the assertion verifier hands the library back the same bytes it parsed. Public by construction: the private half never leaves the authenticator, which is why this variant -- alone among the credential families here -- stores material rather than a digest. A dump of this column forges nothing.")
      signCount       int      @description("Authenticator signature counter as of the most recent successful ceremony. A counter that goes BACKWARDS is the spec's cloned-authenticator signal, so the login path compares before it re-stamps. Many platform authenticators (iCloud Keychain, Windows Hello) always report 0; a zero here means 'this authenticator does not count', NOT 'never used' -- lastUsedAt is the field that answers that.")
      aaguid          string   @description("Authenticator Attestation GUID: the make/model of the authenticator, as a UUID string. Empty or all-zero for platform authenticators that deliberately withhold it. Kept for operator forensics and for a future allow/deny policy on authenticator models -- never for authorization, because under the 'none' attestation this registration accepts it is self-asserted.")
      transports      []string @description("Transports the authenticator advertised at registration ('internal', 'usb', 'nfc', 'ble', 'hybrid'). A HINT echoed back in allowCredentials so the browser can point the user at the right modality instead of offering all of them; it gates nothing server-side and a client that ignores it still authenticates.")
      backupEligible  bool     @description("The BE flag from the registration ceremony -- whether this credential MAY sync to the user's other devices. Immutable for the credential's lifetime by spec, so it is stamped once here and never re-written. The operator signal that matters for account recovery: false means losing the device loses the passkey, which is what makes a second registered credential load-bearing for that user.")
      backupState     bool     @description("The BS flag as of the most recent ceremony -- whether the credential IS currently backed up. Unlike backupEligible this legitimately changes over the credential's life, so the login path re-stamps it rather than freezing the registration-time value.")
      registeredBy    string!  @description("v1:identity:user.id who performed the enrolment. Equal to the enclosing identity's userId for every row today, because #3406 registers strictly against the caller's own authenticated session; carried separately so an admin-assisted or recovery-flow enrolment (#3408) has attribution without re-deriving it from the audit trail.")
      lastUsedAt      string   @description("Most recent successful assertion timestamp (RFC3339Nano). Stored as a string -- not datetime -- because empty string is the legal 'never used since registration' encoding the schema validator accepts, matching worker_token / badge / account_token.")
    }
    recovery_key {
      keyHash          string!  @description("SHA-256 hex digest of the mql_rec_<43> key. The plaintext is revealed exactly ONCE, at claim time, and is never persisted, never logged and never re-derivable -- the same convention as pat / worker_token / node_token / enrolmentToken. This IS an authentication index: the redeem path hashes the presented bearer and looks the row up by this digest, which is why the lookup query recoveryKeyByHash runs pre-actor and declares no @rowAuthz tier.")
      boundOwnerUserId string!  @description("The v1:identity:user this key recovers -- always a cluster owner, and always equal to the enclosing identity's userId. Carried explicitly rather than inferred because the break-glass gate reads it BEFORE any actor exists: redemption asks 'does THIS user still have a usable sign-in route', and it asks with actor.userId empty. Never taken from a caller argument on the redeem path; the owner comes from the row.")
      mintedBy         string!  @description("Who minted the row: the system actor on the first-boot invariant mint, or the v1:identity:user.id of the owner who rotated. Audit attribution for a credential whose whole purpose is to be used when nobody can sign in.")
      claimedAt        string   @description("When the plaintext was revealed to an operator (RFC3339Nano). Empty = never claimed, and while unclaimed the key stays RE-MINTABLE: nobody holds it, so replacing it costs nothing and losing the claim output is not a lockout. Stored as a string so empty is a legal 'not set' encoding, matching worker_token / node_token / badge.")
      claimedFromIP    string   @description("Source IP of the claim. Audit signal: a claim is the one moment this credential exists in plaintext outside the minting process.")
      redeemedAt       string   @description("When the key was spent registering a passkey (RFC3339Nano). Empty = unspent. REDEMPTION IS SINGLE-USE: a stamped value permanently ends this row, and the standing mint invariant then produces a fresh unclaimed successor, so the cluster is never left without a break-glass route (memql#3964). Single-use is what bounds a leaked key to exactly one use instead of leaving a standing owner-equivalent password.")
      redeemedFromIP   string   @description("Source IP of the redemption. The single highest-value line in the audit trail for this credential family.")
      rotatedFrom      string   @description("The v1:identity:identity.id of the row this one replaced, when it was produced by an owner rotation or by the post-redemption successor mint. Empty on the very first mint. Records lineage so an operator can follow the chain of custody without reconstructing it from timestamps.")
    }
  }
  label           string  @description("Human label shown in UIs, e.g. 'Work email', 'Personal Slack', 'Legacy integration key'. Optional, defaults to a generated summary of the credentials.")
  usableByAgents  bool    @default("false")  @description("Whether v1:identity:delegation can borrow this identity for agent work. Magic-link identities default false (agents shouldn't impersonate humans wholesale); OAuth identities for specific external apps default true (they exist precisely so agents can act against that app on the user's behalf).")
  lastUsedAt      datetime  @description("Per-credential last-use stamp. Useful for pruning stale OAuth tokens or unused API keys. User-level 'last seen' lives on v1:identity:user.lastSeenAt.")

  @relationship(type="parent", field="userId", target=user, direction="outgoing")
  // The recovery key's bound owner (memql#3964). A dotted path, because the
  // pointer sits inside the @variant block's recovery_key arm rather than at
  // the top level.
  //
  // type="references" and NOT "parent": the enclosing row already has a parent
  // edge on userId, and the two carry the same value for every row that exists
  // -- boundOwnerUserId is stated separately because the break-glass gate reads
  // it pre-actor. `as="recovers"` is the domain verb; the engine does nothing
  // structural with it, which is exactly the point of the open axis.
  @relationship(type="references", as="recovers", field="credentials.boundOwnerUserId", target=user, direction="outgoing")
}

/// Token-hashed invitation credential. Maps an invitee (existing user by ID, or external guest by
/// email + token) to an optional product scope hint. The identity layer owns the lifecycle
/// (pending/accepted/expired/cancelled) and the auth primitive; product layers populate
/// partitionId/spaceName and any display-name denormalizations they need. Global-scoped: an
/// unauthenticated /join/<token> resolve has no envelope partition, and even authenticated invitees
/// may live in a different partition than the inviter, so token -> invitation lookup must work
/// without a partition context. Product-side rows that REFERENCE invitations (e.g. the product
/// pack's participation concept) stay partition-scoped on the partition where the work actually
/// happens.
@displayCard(primary="inviteeEmail", secondary="kind", tertiary="inviterName", status="status")
concept invitation {
  active        bool                                                                          @description("Whether the invitation is active. Set false to soft-cancel.")
  expiresAt     datetime                                                                      @description("Absolute expiration timestamp. Set for both kinds since memql#4270: a user invitation that never expires is a standing credential nobody remembers issuing.")
  inviteeEmail  string                                                                        @description("Email address of the invitee. Set for BOTH kinds. For kind=user it is the address the invitation authorizes to register, which is the whole point: the recipient has no account yet, so there is no id to name them by.")
  inviteeId     string                                                                        @description("User ID of the invitee, when one already exists. Empty for the common kind=user case -- an invitation to a person who has not registered cannot name a row that does not exist. Stamped on acceptance.")
  inviteeRole   enum("owner", "admin", "developer", "writer", "reader")  @description("The cluster role the recipient lands with on redemption (memql#4270). Empty means the cluster default for a new user. An inviter cannot grant above their own role -- enforced in component/identity/adminops, not here, because the comparison needs the caller.")
  inviteeName   string                                                                        @description("Display name suggested by the inviter. Optional.")
  inviterId     string!                                                             @description("User ID of the person who issued the invitation.")
  inviterName   string                                                                        @description("Display name of the inviter. Denormalized for notification/email rendering.")
  kind          enum("user", "guest")!  @default("guest")                           @description("user = invite an existing user by ID. guest = invite an external email with a token.")
  respondedAt   datetime                                                                      @description("When the invitation was responded to.")
  partitionId       string                                                                        @description("Product scope hint. The product populates this with a v1:cognition:space ID so the post-accept flow can route the invitee into the right space.")
  spaceName     string                                                                        @description("Display name of the scope. Denormalized for email rendering. Optional.")
  status        enum("pending", "accepted", "ignored", "left", "kicked", "dismissed")!  @default("pending")  @description("Lifecycle status. Product layers extend with participation-style values (left/kicked/dismissed) when they bind the invitation to a product record.")
  tokenHash             string                                                                @description("SHA-256 hex digest of the current invite token. Set for BOTH kinds since memql#4270 -- the identity login page resolves a user invitation by the same hash the guest path uses (stage needs_invite, form=invite). Primary lookup key in the guest-auth interceptor and on the /join/<token> resolve path. The plaintext token is delivered in the email and never persisted server-side (see memql#108).")
  previousTokenHash     string                                                                @description("SHA-256 hex digest of the token this row carried before the most-recent resend rotation, when there was one. Used by the resolve handler to return a UX-friendly `superseded` status for an older link instead of a generic `invalid`. Carries only ONE generation of history -- the rotation before last drops off. Always empty before any resend has rotated the row.")

  @relationship(type="parent", field="inviterId", target=user, direction="outgoing")
  @relationship(type="parent", field="inviteeId", target=user, direction="outgoing")
}

/// Pending magic-link authentication request. One row per /auth/magic-link issuance. The plain
/// token is hashed (SHA-256) before persistence -- only the hash lives here so a database snapshot
/// can never be replayed into a login. Single-use semantics: consumedAt is set atomically on the
/// first successful click and any subsequent click against the same row is rejected. Past expiresAt
/// the row is also rejected. Global scope so the public unauthenticated /auth/magic-link/consume
/// endpoint can resolve the row regardless of which partition the eventual user belongs to.
@displayCard(primary="email", secondary="sourceIP", tertiary="expiresAt")
concept magicLinkRequest {
  email           string!  @description("Email address the magic link was sent to. Drives the user-lookup / first-time-registration path on consume.")
  tokenHash       string!  @description("SHA-256 hex digest of the plain magic-link token. Primary lookup key on consume; the plaintext token is delivered in the email link and never stored server-side.")
  expiresAt       datetime!  @description("Absolute expiration timestamp. Past this point the row is dead even if not consumed; the consume handler treats expired and consumed identically (both reject).")
  consumedAt      datetime  @description("Set atomically on the first successful consume. Non-nil = the row is spent and any further click against the same token is rejected. Single-use enforcement is the load-bearing security property of magic links.")
  consumedFromIP  string  @description("Best-effort IP recorded at consume time. Used by the audit log and by anomaly detection (consume from a different country than issuance, etc).")
  oauthCtxJSON    string  @description("Serialized JSON of the OAuth context the magic link was issued under: {clientId, redirectURI, state}. When present the consume handler mints an auth code instead of a session and redirects to clientId's redirectURI with the code. When absent the consume creates a session directly (first-party SPA flow).")
  sourceIP        string  @description("IP the issuance request came from. Captured for audit and for risk scoring (issuance velocity per IP).")
  userAgent       string  @description("User-Agent header at issuance time. Captured for audit only. It is NOT a binding check and never was -- the description used to claim a \"consume-time UA-mismatch check\" that no code performs (memql#4301). What binds a link to the device that asked for it is bindingHash below.")
  invitationId    string  @description("Set when the magic link was issued in response to an admin-approved access-request invitation. Empty for self-service login attempts. Lets the consume handler stamp the inviting context on the new user record.")
  bindingHash     string  @description("SHA-256 hex digest of the 32-byte CSPRNG nonce handed to the REQUESTING browser as the `memql_ml` cookie at issue time. The plaintext nonce is never stored. A magic link only COMPLETES in a browser that presents a cookie hashing to this value, which is what makes a session land on the device that asked for it rather than on whichever mailbox reader clicked first (design D2). Written once by the issuer; read by the landing, status and finish handlers. Empty on rows predating the device-bound flow -- those behave as a no-cookie click, i.e. approve-only.")
  approvedAt      datetime  @description("Set by POST /auth/landing when the link was opened in a browser that does NOT hold the binding cookie. It means \"a human holding the emailed token said yes\"; it does not itself sign anybody in. The requesting tab polls GET /auth/magic-link/status, sees `approved`, and completes the sign-in itself. Written only when both approvedAt and consumedAt are empty, so a second click is idempotent.")
  approvedFromIP  string  @description("IP of the device that approved the request. This is the field that names B when B clicked A's link -- kept precisely so the cross-device case leaves a trace an operator can read. Written with approvedAt, never alone.")
  approvedUserAgent  string  @description("User-Agent of the approving device. Companion to approvedFromIP; audit and incident-review only, never compared against anything.")

  @relationship(type="parent", field="invitationId", target=invitation, direction="outgoing")
}

/// A person (or synthetic principal). Owns identities. Same record cluster-wide.
//
// SELF-OWNED, and NOT YET DECLARED (memql#3029). The `owner="id"` form now
// exists for exactly this concept -- a user's owner is the row itself, there
// is no ownerUserId to name -- but declaring it here today would be a FALSE
// declaration, which is the one thing memql#2982's gate exists to catch.
//
// Measured: nine CLIENT-CALLABLE mutations take the row id from caller args
// (bumpUserDataExport, bumpUserRevocationEpoch, cancelScheduledDeletion,
// createUser, createUserOnFirstLogin, deleteUserHard, recordLegalAcceptance,
// scheduleAccountDeletion, setUserActiveSpace). Only toggleComputerUseEnabled
// stamps it. updateUser counts too, and #3029 assumed it was the ONLY caller
// path -- @serverOnly bars a client CALL, but the admin handler still reads
// the target id off an HTTP form, so the provenance gate keeps counting it.
// Either way the verdict is the same: the nine decide it on their own.
//
// So the tier is declarable and still not TRUE here. Making it true is a
// wire-contract decision over nine client-called mutations, not a bug fix.
//
// STILL UNDECLARED, AND NOW FOR A SECOND, INDEPENDENT REASON (memql#3350).
// The note above is about the WRITE side. The read side rules a tier out
// on its own, and this is the recorded decision memql#3350 asked for --
// role-gating for this concept lives at the PROJECTION, not at the row.
//
// Measured over the seventeen constructs binding this concept:
//
//   - CROSS-USER READS FOR ORDINARY CALLERS. userDisplayById is @public
//     and usersActiveInSpace is ungated: they are how one participant's
//     name renders in another's chat. A tier ANDs its predicate into
//     BOTH of them unconditionally, so any self-scoped tier breaks the
//     product for every user, not only for readers.
//   - PRE-ACTOR READS. userByEmail is the magic-link lookup and
//     userByIdSystem resolves sub -> user in order to BUILD the actor
//     (component/auth/identity_resolver.go), so actor.userId is circular
//     there. enforceRowAuthzOnPlan takes NO context and has no escape --
//     the write path's rowAuthzWriteEscape has no read-side counterpart
//     -- so no tier can spare them.
//   - THE ADMIN READS ARE A ROLL-UP. searchUsers / userById are
//     "the users of this cluster", gated requiresOwnerOrAdmin. `owned`
//     ANDs its predicate with no cluster-owner escape, so declaring it
//     would narrow an admin's user list to the admin's own row and
//     return a confidently wrong answer.
//
// So users may legitimately SEE each other; what they may not see is
// each other's @pii. That is a field boundary, and the named queries
// already draw it with their shapes -- which is why the leak was on the
// one read that projects no shape, the generic concept browse. It is
// closed at row admission for unbound reads, keyed off the @pii
// annotations below rather than off this concept's name:
// component/memql/rowauthz_pii_unbound.go.
//
// What would let a tier be declared here, in dependency order: (a) a
// read-path escape mirroring rowAuthzWriteEscape, so the pre-actor and
// system reads survive injection; (b) a tier that composes self-access
// with an admin roll-up, since `owned` cannot express one. Neither is a
// prerequisite for closing the browse hole, which is why #3350 shipped
// without them.
@displayCard(primary="displayName", secondary="role", tertiary="primaryEmail", status="active")
concept user {
  active          bool    @default("true")  @description("Whether the user account is active.")
  displayName     string!  @pii  @description("Display name shown in the UI. By convention this is firstName + ' ' + lastName when both are populated; the admin / setup wizard maintain that invariant. Standalone field (rather than a derived computed view) because legacy rows pre-date the firstName/lastName split and we want a stable display value to fall back on.")
  firstName       string  @pii  @description("Given name. Set by the admin via /admin/users/detail (or by the cluster owner via /setup); flows through to the JWT as the OIDC-style `given_name` claim and into the product's profile UI.")
  lastName        string  @pii  @description("Family name. Mirror of firstName -- admin-curated, stamped onto the JWT as `family_name`.")
  primaryEmail    string!  @pii  @description("Canonical email. Verified by the magic-link flow at registration; the dedup key for 'is this Alice already known?'.")
  phone           string  @pii  @description("E.164 phone number, optional. Set by an admin via /admin/users/detail; required for full app access via the ProfileCompletenessGuard.")
  primaryRole     string  @pii  @description("Free-form job title / role at the org (e.g. 'CEO', 'Engineer'). Distinct from the cluster-wide auth `role` field above; admin-curated, not auth-related.")
  gender          string  @pii  @description("Optional self-identified gender. Free-form string -- the frontend offers a curated list but the backend doesn't enforce one.")
  birthdate       string  @pii  @description("ISO-8601 date (YYYY-MM-DD), optional. Stored as a string rather than datetime because we never compute against it -- it's reference data the admin sets and the profile UI surfaces.")
  role            enum("owner", "admin", "developer", "writer", "reader")  @default("reader")  @description("Cluster-wide role. owner is the sole cluster-owner tier (actor.isClusterOwner==true is what an admin-tier row's @rowAuthz gates on -- e.g. the audit log); admin/developer/writer/reader are RBAC roles for the identity admin console + engineering surfaces (component/auth/rbac.go) but carry no automatic per-row data access of their own -- reaching an owned/granted row still requires being its owner or holding a relationship grant, not just this role. developer additionally gets authoring + inline DSL + deploy/cut-version; admin/writer/reader do not.")
  groupIds        []string  @description("Group memberships. Reserved for future cluster-side group-based access derivation.")
  // Every nested block rejects undeclared keys (memql#3641), and this is the
  // block that made the case for it: `computerUseEnbaled` used to store
  // happily beside `computerUseEnabled`, leaving the computer-use kill switch
  // on its old value with nothing reporting anything (memql#3623). No
  // annotation needed -- closed is the default; @open would be the opt-out and
  // this block is the opposite of free-form.
  preferences {
    language             string  @description("Preferred language as a BCP 47 tag (e.g., en-US, es-MX).")
    notifications        bool    @default("true")  @description("Whether to receive notifications.")
    theme                enum("light", "dark", "system")  @default("system")  @description("UI theme preference.")
    timezone             string  @description("User's local timezone as an IANA name (e.g., America/Los_Angeles). Used by the rolloverDailySpace cron to decide when 'today' begins for this user. Empty falls back to UTC.")
    archiveRetentionDays int     @default("30")  @description("How long an archived space lives before the cron purge sweep hard-deletes it. UI exposes 30 (default) and 60. The cron reads the user's CURRENT value at run-time, so a 30->60 bump rescues currently-archived spaces.")
    dailySpaceEnabled    bool    @default("true")  @description("Whether the daily-space automation provisions and rolls over a per-day singleton space for this user. Defaults on; users who don't want a daily space can disable it in Settings.")
    dailySpaceRolloverAction enum("archive", "save")  @default("archive")  @description("What happens to yesterday's daily space when the rollover cron fires. 'archive' is the default (it ages out per archiveRetentionDays); 'save' preserves it indefinitely under the user's Saved tab.")
    cursorTweenMs        int     @default("1000")  @description("Standard Mode cursor tween duration in milliseconds (250-2500). Drives how long the agent's cursor takes to travel between targets in transactional / minimal-interactivity sessions. The frontend slider clamps to the supported range; the value here is the canonical cross-device preference.")
    takeoverMode         enum("clean", "dim")  @default("clean")  @description("Standard Mode visual appearance during an agent UI-control takeover. 'clean' (default) leaves the app visible with the agent cursor + highlight as the only takeover cues; 'dim' tints the viewport dark with a cursor-following spotlight. Clicks are blocked across the whole viewport in both modes -- this only changes the visual cue.")
    interactivePace      enum("quick", "steady", "deliberate")  @default("steady")  @description("Interactive Mode pace preset. Maps to a fixed cursor speed used during conversational sessions (walkthroughs / demos / teaching flows): quick=500ms per move, steady=1000ms (default), deliberate=1500ms. Independent from cursorTweenMs -- the two settings target different session shapes.")
    computerUseEnabled   bool    @default("true")  @description("Per-user kill switch for the worker / computer_use feature. Sticky -- survives sessions, devices, restarts. When false, every worker dispatch is rejected with kill_switch_engaged and the killSwitchSuspendsRunningPlans automation transitions the user's running plans (with computerUseScope set) to awaitingFeedback. The user must consciously re-enable. Only the user themselves can flip it: toggleComputerUseEnabled stamps the target row from actor.userId, so there is no caller-supplied target and no admin override (memql#2840). An administrative override, if ever wanted, belongs in a separately-named mutation rather than a second meaning for that one.")
    voiceMode            enum("toggle", "continuous")  @default("toggle")  @description("Per-user mic mode preference for Polyphon rooms. 'toggle' (default) = click on / click off; 'continuous' = mic stays open while VAD gates speech detection. Phase 7 of the voice/audio plan. Hold-to-talk is preserved for voice-first creation modals (different context); the room's chat mic only branches between toggle and continuous.")
    activeAssistantId    string  @description("Canonical v1:agents:agent.id of the user's currently-selected assistant. Optional; the SPA stamps it lazily when the user creates their first assistant (or on next mount for existing single-assistant users) and rewrites it whenever the user picks a different assistant as active via the AgentsListPanel or SettingsListPanel active-pill. Empty means 'fall back to whichever assistant the user owns' (single-assistant case). Switching active does NOT rebind existing spaces -- only spaces created after the switch use the new active assistant. memql#406 / frontend#125.")
  }
  suspendedAt     datetime  @description("Set when the user is suspended by an admin. Nil means active.")
  suspendedReason string    @description("Human-readable reason for suspension.")
  lastSeenAt      datetime  @description("Updated by the identity service on each successful refresh. Answers 'when was this person last around'. Per-credential last-use lives on v1:identity:identity.lastUsedAt.")
  activePartitionId   string    @description("v1:cognition:space.id this user is currently active in (Phase 4 of the chat-architecture plan). Hard rule: each human is active in at most one space at a time -- camera, mic, voice transport, video presence are all bound to this pointer. Empty / unset means the user is in the app but not focused on any space (or has the app closed). Set by setUserActiveSpace from the SPA's set-active-on-enter wiring; the participant guard derives `isActive` for downstream consumers by comparing this against the participant's partitionId. Discussion mode (Phase 6) and voice migration (Phase 7) both key on this field.")
  sharedMailbox   bool      @description("True when this account's address looks like a mailbox several people read -- a role alias (support@, billing@) or a team name (team@, hello@). A HINT, set at registration and at invitation by a local-part heuristic in component/identity/registration and editable afterwards by the user and by an admin. It blocks nothing and gates nothing. What it does is make a fact visible that is otherwise invisible: anyone who can read the mailbox can request a sign-in link and enter the account, so the sign-in surface of the account is the mailbox's reader list. The remedy it points at is signInPolicy below.")
  signInPolicy    enum("any", "passkey_only")  @default("any")  @description("Which factors may enter this account. `any` is the default and means the ordinary set (magic link, passkey). `passkey_only` disables sign-in LINKS: a request for one writes no row, sends no link, and mails a notice instead -- informative to the account holder, useless to anyone else reading the same mailbox. Settable by the user only while they hold at least one active passkey, and the server enforces that regardless of the UI, because a policy that can lock its owner out is not a security control. Owners and admins can reset it to `any` over IdentityAdminMsg, audited; that is the rescue path, and it is no more power than the enrolment-token issuance admins already hold. Enrolment tokens and the owner recovery key are the lost-passkey routes and are deliberately unaffected.")
  internal        bool      @description("True when the registering email matched MEMQL_IDENTITY_INTERNAL_DOMAINS at first login. Always written on the registration path: createUserOnFirstLogin takes `internal bool!` as a required arg. createUser (admin-created) omits it, and an absent value reads as false. Internal users get the cluster-wide MEMQL_IDENTITY_INTERNAL_DEFAULT_ROLE; external users instead get owner of an auto-created personal partition. Captured at registration so policy decisions remain stable even if the configuration drifts.")
  legalAcceptance []object  @description("Append-only history of legal-document acceptances. Each entry: {documentType: 'tos'|'privacy', version: string, acceptedAt: datetime, sourceIP: string}. Audit trail for compliance -- never edited, only appended.")
  deletionScheduledAt datetime  @description("Set when the user requested account deletion. The accountDeletionSweep cron hard-deletes the row MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS later. Cleared by cancelScheduledDeletion if the user reverses the request during the cooldown.")
  dataExportLastAt datetime  @description("Timestamp of the most recent /me/export download. Drives rate-limiting per MEMQL_IDENTITY_DATA_EXPORT_RATE_LIMIT_HOURS.")
  revocationEpoch  int       @description("Monotonically-increasing per-user counter, starting at 0. Not stamped on create and it does not need to be: the identity store reads it through int64Field, which yields 0 for an absent key (component/identity/store.go). Stamped into every JWT this user is issued; the verifier rejects any JWT whose revocation_epoch claim is below the user's current value. Bumping this field invalidates every token issued before the bump, on the next stream-open or periodic in-stream re-check (default ~5 minutes). Bulk-revoke / role-change / security-event tooling is the intended writer. See memql#106.")

  @relationship(type="references", field="preferences.activeAssistantId", target=agent, direction="outgoing")
}

/// Short-lived pairing credential for the computer-use enrollment flow. The frontend's Settings ->
/// Computer Use 'Connect this computer' card mints a row + plain code (XXXX-XXXX, 8 alphanumeric
/// chars from Crockford's Base32 alphabet). The cockpit wizard on the user's machine redeems the
/// code on the cluster's gRPC stream via Authorization: Pair <code>, the redeem handler stamps
/// redeemedAt + redeemedBy, mints a v1:identity:identity worker_token row owned by the same user,
/// and returns the plain mql_wkr_<...> token + cluster URL to the cockpit. Single-use: a row with
/// non-empty redeemedAt is dead. TTL ~10 minutes (IDENTITY_PAIRING_CODE_TTL_MIN, default 10).
// @no-displayCard: Single-use credential row, same reasoning as v1:identity:authCode: a
//   secret hash plus foreign keys. `clusterURL` is identical on every row in a
//   cluster, so promoting it would distinguish nothing.
concept workerPairingCode {
  ownerUserId  string!  @description("v1:identity:user.id who minted the code (and who will own the resulting worker_token + v1:worker:registration). The redeem handler reads this and uses it as the registeredBy for the new worker_token credential.")
  codeHash     string!  @description("SHA-256 hex digest of the plain XXXX-XXXX code. Plaintext is shown to the user ONCE on the frontend's Settings card and never persisted.")
  clusterURL   string!  @description("Canonical cluster URL the cockpit should dial for the WorkerService.Stream. Stamped at create time so the redeem handler can echo it back -- letting the frontend and the BFF be reachable at different DNS names without leaking that detail to the cockpit operator.")
  expiresAt    datetime!  @description("Absolute expiration timestamp. Redeem rejects rows past this even when redeemedAt is empty.")
  redeemedAt   datetime  @description("Stamped on first successful redeem. Single-use semantics: any subsequent redeem against the same row fails with already_redeemed.")
  redeemedBy   string  @description("v1:identity:identity.id of the worker_token row the redeem minted, for audit trail. Empty until redeemed.")
  redeemedFromIP  string  @description("Source IP the redeem call came from. Audit signal -- helps detect 'someone else redeemed my code' fraud.")
  sourceIP     string  @description("IP the create-pairing-code request came from. Audit + abuse signal.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="redeemedBy", target=identity, direction="outgoing")
}

/// Single-use enrolment credential: authorizes exactly one action -- register a passkey as the
/// named user -- which is what makes a FIRST credential obtainable with no mailbox (memql#3408).
/// The plain token is mql_enr_<43 base64url chars> (32 CSPRNG bytes); only its SHA-256 hex digest
/// lands here, so a database snapshot cannot be replayed into an enrolment. Single-use via
/// consumedAt, stamped when the passkey registration succeeds; revokedAt is the issuer's kill
/// switch before that. Default TTL 15 minutes.
//
// MIRRORS v1:identity:workerPairingCode RATHER THAN EXTENDING v1:identity:invitation. An
// invitation's kind enum is ("user", "guest") -- "invite an existing user by ID" and "invite an
// external email with a token" -- and its status enum runs through accepted / ignored / left /
// kicked / dismissed, which is participation vocabulary. An enrolment token is neither an invitee
// nor a participant: it has no invitee email, no inviter display name to render into a message, no
// product scope, and it can never be "left" or "kicked". Adding an "enrolment" kind would leave
// most of that concept's fields permanently empty and would put single-use on respondedAt+status
// instead of the consumedAt stamp this credential actually needs. workerPairingCode is the row
// this IS: a hashed, TTL'd, single-use bearer that authorizes one exchange. The HASHING
// CONVENTION is unchanged and shared with every other credential row -- SHA-256 hex of the
// plaintext (pat, workertoken, workerpairing, invitation, magicLinkRequest).
//
// NO @rowAuthz TIER, for the same structural reason magicLinkRequest and workerPairingCode carry
// none: the redeem read is PRE-ACTOR. The token IS the credential, so at lookup time there is no
// authenticated caller whose userId a tier could compare against, and any owner tier would resolve
// actor.userId to "" and return nothing -- turning every redeem into a silent "invalid". The
// lookup is bounded to a single row by a 256-bit hash, and enrolmentTokenByHash is registered in
// component/memql/rowauthz_undeclared_gate_test.go naming this issue as its reason.
// @no-displayCard: single-use credential row -- a secret hash plus foreign keys, same reasoning as
//   v1:identity:workerPairingCode and v1:identity:authCode.
concept enrolmentToken {
  userId          string!    @description("v1:identity:user.id this token enrols. The redeem path resolves the passkey owner from THIS field and never from a caller-supplied argument, so a leaked token can only ever add a credential to the account it was minted for.")
  tokenHash       string!    @description("SHA-256 hex digest of the plain mql_enr_<...> token. The plaintext is returned to the issuer ONCE, embedded in the enrolment link, and is never persisted or logged.")
  issuedBy        string!    @description("v1:identity:user.id of the principal that minted the token -- the owner/admin on the portal path, the cluster owner on the install-wizard path. Equal to userId when someone mints their own link; carried separately so an admin-assisted enrolment has attribution without re-deriving it from the audit trail.")
  expiresAt       datetime!  @description("Absolute expiration timestamp. Redeem rejects rows past this even when consumedAt is empty. Default 15 minutes from issue, overridable per-issue up to a capped maximum (component/identity/enrolment.MaxTTL).")
  consumedAt      datetime   @description("Stamped when the authorized passkey registration completes. Single-use semantics: a row with non-empty consumedAt is dead and any replay is refused with the already-used rejection state.")
  consumedFromIP  string     @description("Source IP the redeem came from. Audit signal -- helps detect 'someone else used my enrolment link'.")
  revokedAt       datetime   @description("Stamped when the issuer kills the token before it was used. Distinct from consumedAt so the /enroll page can say 'this link was revoked' rather than the misleading 'already used'.")
  sourceIP        string     @description("IP the issue request came from. Audit + abuse signal.")

  @relationship(type="parent", field="userId", target=user, direction="outgoing")
  @relationship(type="parent", field="issuedBy", target=user, direction="outgoing")
}

/// Organization group. Users belong to groups; agents are assigned to groups for scoped access
/// control. Created and managed in-app; the externalId field is preserved for any legacy rows that
/// came from a previous external sync source.
@displayCard(primary="name", secondary="description", tertiary="externalId", status="active")
concept group {
  name         string! @description("Display name of the group.")
  description  string! @description("Short description of the group's purpose. Required so group pickers (CreateSpaceModal, admin lists) always have a useful subtitle.")
  externalId   string! @description("External group id for legacy sync correlation. Empty for in-app-created groups.")
  memberIds    []string  @description("User IDs that belong to this group.")
  agentIds     []string  @description("Agent IDs assigned to this group.")
  maxHumans    int     @description("Maximum human members this group can hold. Convention: 5 -- NOT applied on insert, and no mutation is bound to this concept, so a writer must supply it; an absent value reads as 0 (no capacity). Matches v1:cognition:space.maxHumans so a group can seed a space without silent truncation.")
  maxAgents    int     @description("Maximum agent members this group can hold (convention: 3 -- NOT applied on insert; no mutation is bound to this concept, so a writer must supply it, and an absent value reads as 0), inclusive of any user's auto-joined assistant. Matches v1:cognition:space.maxAgents.")
  active       bool    @description("Whether the group is active. Convention: true -- NOT applied on insert, and no mutation is bound to this concept, so a writer must supply it.")
}

/// A CUSTOMER THE OPERATOR MANAGES -- the record MemQL keeps ABOUT a downstream business, as
/// opposed to v1:identity:user (a principal that logs in) or v1:identity:accountEntitlement (a
/// billing cap keyed on a paying account id). An account is operator-side bookkeeping: it holds no
/// credential, mints no session and is never a subject -- nothing authenticates AS an account, and
/// no v1:identity:identity row points at one. Accounts are also FLAT: there is deliberately no
/// parentAccountId, because a nesting edge makes the isolation predicate transitive and a
/// transitive predicate cannot be pushed down as a single filter conjunct. An agency with
/// sub-clients is N sibling accounts sharing an operator, not a tree. Per-row authz: OWNED, and
/// engine-enforced rather than author-enforced -- ownerUserId is @serverSet and stamped from
/// actor.userId on every write, and the @rowAuthz declaration makes the engine AND
/// ownerUserId==actor.userId into every read (component/memql/rowauthz_enforce.go, memql#3172) and
/// refuse any update whose target row the actor does not own
/// (component/memql/rowauthz_write_guard.go, memql#3174). The model, and the three places it is
/// NOT sufficient, are recorded in docs/internal/design/account-isolation-model.md.
@displayCard(primary="name", secondary="description", tertiary="primaryContactEmail", status="status")
@rowAuthz(owner="ownerUserId")
concept account {
  ownerUserId          string!  @serverSet  @description("v1:identity:user.id of the operator principal that manages this customer. THE ROW-AUTHZ OWNER FIELD: stamped from actor.userId on create and re-stamped on every update so ownership can never be reassigned by a caller, and @serverSet turns 'never accepted from caller args' into a LOAD-TIME rejection rather than a convention. Because the concept declares @rowAuthz(owner=\"ownerUserId\"), this field is also what the engine compares against on the read path and in the write guard -- it is not merely documentation of an intent each query has to restate.")
  name                 string!  @description("Display name of the customer, as the operator refers to them. The primary display field. Not unique -- the engine enforces no uniqueness constraint on any payload field, so two accounts may share a name and the row id is the only identity.")
  status               enum("active", "suspended", "archived")!  @description("Lifecycle. active = a live customer. suspended = temporarily stopped (non-payment, pause) but still visible in the operator's list. archived = closed; retained for history and excluded from working lists by the caller's filter. Stamped 'active' by createAccount and flipped to 'archived' by archiveAccount; there is no hard delete -- a write is an append onto the same id.")
  description          string  @description("Free-text operator note about who this customer is and what MemQL does for them. Rendered as the display card's secondary line.")
  primaryContactName   string  @pii  @description("Name of the human the operator deals with at this customer. Personal data about a third party rather than about a MemQL principal, hence @pii: any query projecting it must constrain its caller (test/dslconformance/pii_projection_test.go).")
  primaryContactEmail  string  @pii  @description("Email of the primary contact. @pii for the same reason as primaryContactName. NOT a credential and NOT a login: an account has no authentication path, so this address is never matched against a magic-link or session lookup.")
  externalRef          string  @description("The operator's own identifier for this customer in whatever system is upstream of MemQL -- a CRM record id, a billing customer id, an internal account number. Opaque to the engine: never parsed, never resolved, and deliberately NOT an @relationship, because it names a row in a system MemQL does not host.")
  archivedAt           datetime  @description("RFC3339 timestamp stamped by archiveAccount. Empty while status is active or suspended. Kept alongside status so a retention sweep can age archived customers without re-deriving the transition time from the row's version history.")
  updatedAt            datetime  @description("RFC3339 watermark of the most recent edit, stamped to now on every write so an operator list can sort by recency. The authoritative version order is still the row's createdAt history; this is a denormalized convenience for the latest version.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
}

/// Per-account entitlement that caps the number of CONCURRENTLY-RUNNING tasks (Plans) a paying
/// account may have across all of its spaces, sourced from the billing tier (epic memql#902 /
/// foundation child #903). The cap is per paying account -- v1 keys on v1:identity:user.id
/// (accountKind='user'); accountKind='org' is reserved for a future per-organization rollup where
/// many users share one paying account's slots. DEFAULT = UNLIMITED (enterprise behavior): an
/// account with no row here, an enterprise tier, or a non-positive maxConcurrentTasks is uncapped
/// -- the admission controller (#904) is a no-op until a finite cap is written, so existing /
/// unconfigured accounts behave exactly as today (no regression). The NUMBER (maxConcurrentTasks)
/// is the source of truth so billing can change a tier's cap without a code change; tier is carried
/// alongside purely for the Tasks-UX upgrade / limit messaging (#909) and the enterprise=unlimited
/// shortcut. Global scope (lives in _system) so the planner node's admission controller and the
/// billing / admin writer can both reach it from any partition. One logical row per account:
/// setAccountEntitlement mints a deterministic id (accountEntitlement-<hash(accountId)>) so each
/// set appends a new time-series version and the latest wins.
@displayCard(primary="accountId", secondary="accountKind", tertiary="note", status="tier")
concept accountEntitlement {
  accountId          string! @description("The paying account this entitlement applies to. v1: a v1:identity:user.id (accountKind='user'). The admission controller (#904) resolves a Plan's account via Plan.requestedBy and reads the effective cap from the matching row here.")
  accountKind        enum("user", "org")! @default("user") @description("Whether accountId names a user or an org. v1 is always 'user' (per-user account); 'org' is reserved for the future per-organization concurrency rollup where many users share one paying account's pool of slots.")
  tier               enum("free", "pro", "team", "enterprise")! @default("enterprise") @description("Billing tier label. Drives the Tasks-UX upgrade / limit messaging (#909) and the enterprise=unlimited shortcut. NOT the source of truth for the cap number -- maxConcurrentTasks is. Defaults to 'enterprise' so a default / unconfigured row stays uncapped.")
  maxConcurrentTasks int     @default("0") @description("The cap: the maximum number of Plans this account may have running concurrently across all of its spaces. SOURCE OF TRUTH for the number (billing writes it), so a tier's cap changes without a code change. A value <= 0 means UNLIMITED (the default). Ignored when tier='enterprise' (always unlimited). E.g. set to 5 to cap a pro account at five concurrent running tasks; the 6th and beyond wait for a freed slot (#905).")
  note               string  @description("Free-text operator / billing note about why this entitlement was set (e.g. 'pro plan', 'temporary bump during migration'). Audit aid only; the resolver ignores it.")

  @relationship(type="parent", field="accountId", target=user, direction="outgoing")
}
