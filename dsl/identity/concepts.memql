// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("Self-service access request placed on the waitlist queue. Created when an unknown email submits the registration form while IDENTITY_REGISTRATION_MODE=approval. Admins triage rows in the admin console: approval mints a v1:identity:invitation and emails a magic link; rejection stamps the reason and closes the row. Also auto-aged by the accessRequestExpirySweep cron once IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS has elapsed without a decision. Global scope so admins in any partition (typically owners of the cluster) can review the queue.")
concept accessRequest {
  email             string  @required  @description("Email address the requester wants to register with. Same value flows into the eventual v1:identity:user.primaryEmail on approval.")
  name              string  @description("Display name supplied at submission time. Optional (some flows ask, some don't).")
  additionalContext string  @description("Free-text 'what would you use this for' answer the requester can optionally supply. Helps admins triage but never gates access by itself.")
  status            enum("pending", "approved", "rejected", "expired")  @required  @default("pending")  @description("Lifecycle. pending = on the queue. approved = admin clicked approve and the invitation was minted. rejected = admin closed the row with reviewerNote. expired = aged out by accessRequestExpirySweep cron.")
  riskScore         int  @description("Composite risk score (0-100) computed at submission time from riskSignals. Higher = more suspicious. Surfaced to admins in the queue so they can triage cleanly. Never auto-rejects; admins always make the call.")
  riskSignals       string  @description("Comma-separated signal tags that fed riskScore. Examples: disposable_domain,velocity_per_ip,typo_squatted_domain,known_breach_email. Admin UI renders each tag as a chip with a tooltip.")
  sourceIP          string  @description("IP the submission came from. Captured for audit and to feed velocity-per-IP risk signals.")
  userAgent         string  @description("User-Agent header at submission. Captured for audit; bot-fingerprint heuristics may reference it.")
  reviewedBy        string  @description("v1:identity:user.id of the admin who acted on the row. Empty until reviewed.")
  reviewedAt        datetime  @description("Timestamp of the admin decision. Empty until reviewed.")
  reviewerNote      string  @description("Free-text rationale recorded by the admin. Required by UX convention for rejections; optional but encouraged for approvals. Stored verbatim for audit -- never edited.")
  invitationId      string  @description("Set on approval to the v1:identity:invitation row that was minted to deliver the magic link. Empty for pending / rejected / expired rows.")

  @relationship(type="parent", field="reviewedBy", target="v1:identity:user", direction="outgoing")
  @relationship(type="parent", field="invitationId", target="v1:identity:invitation", direction="outgoing")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("Append-only audit log entry. Captures security-relevant events (auth, identity, authorization, configuration, admin) with actor + target + source attribution. Global scope so any cluster operator can read the full trail. Retention controlled by IDENTITY_AUDIT_LOG_RETENTION_DAYS via the daily auditEventRetentionSweep automation. The prevEventHash field is reserved for future hash-chain tamper-resistance; written but not validated in MVP.")
concept auditEvent {
  occurredAt      datetime  @required  @description("When the event happened. May lag createdAt by milliseconds because the row is written after the event completes.")
  category        enum("auth", "identity", "authorization", "configuration", "admin", "data")  @required  @description("Coarse grouping for filtering and retention policy hooks.")
  action          string  @required  @description("Machine-readable action enum, lower_snake_case. Examples: login_attempted, login_succeeded, magic_link_issued, magic_link_consumed, refresh_succeeded, refresh_token_theft_detected, session_revoked, role_changed, partition_grant_created, registration_mode_changed, jwks_rotated.")

  actorUserId     string  @description("v1:identity:user.id of the actor when authenticated. Empty for anonymous events (login attempts where no session yet exists).")
  actorEmail      string  @description("Email of the actor at the time of the event. Captured here for audit even after the user record is deleted — auditEvent rows are tombstoned, not removed, on user deletion.")
  actorRole       string  @description("Cluster role of the actor at the time of the event (owner / admin / writer / reader). Captured for point-in-time accuracy.")
  actorIdentityId string  @description("v1:identity:identity.id of the credential the actor used (magic_link, api_key, etc.). Distinguishes 'logged in via web' from 'PAT in CI'.")

  targetType      enum("user", "session", "identity", "partitionAccess", "invitation", "accessRequest", "config", "magicLinkRequest", "authCode", "clusterSettings", "")  @default("")  @description("Concept type of the target row, if any.")
  targetId        string  @description("Identifier of the target row when targetType is set.")
  targetEmail     string  @description("Email associated with the target, if applicable. Useful for filtering audit history by user without needing a join.")

  detail          object  @description("Action-specific structured payload. Schema varies by action; consumer code reads the keys it knows. Examples: {\"reason\":\"idle_timeout\"} for refresh failures, {\"oldRole\":\"writer\",\"newRole\":\"admin\"} for role changes, {\"riskScore\":62,\"signals\":[\"disposable_domain\",\"velocity\"]} for blocked registrations.")
  sourceIP        string  @description("IP address the event originated from. Best-effort — proxy chains and X-Forwarded-For honored only when the deployment trusts the proxy.")
  userAgent       string  @description("User-Agent header at the time of the event. Empty for non-HTTP-originated events.")
  correlationId   string  @description("Groups related events from one logical interaction. Example: a single login flow's attempt + magic-link issued + magic-link consumed + session created share one correlationId.")

  outcome         enum("success", "failure", "blocked", "")  @default("")  @description("Outcome marker for events where success/failure is meaningful. blocked = denied at policy layer (rate limit, risk threshold, etc.).")
  failureReason   string  @description("Free-text or enum reason when outcome=failure or outcome=blocked. Examples: token_expired, insufficient_role, rate_limited, risk_threshold_exceeded.")

  prevEventHash   string  @description("Reserved for future hash-chain tamper-resistance. SHA-256 hex digest of the previous event's full payload. Written from day one; chain validation enabled by a follow-up iteration.")

  @relationship(type="parent", field="actorUserId", target="v1:identity:user", direction="outgoing")
  @relationship(type="parent", field="actorIdentityId", target="v1:identity:identity", direction="outgoing")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("One-time OAuth authorization code, RFC 6749 §4.1 style. Minted at /auth/magic-link/consume when the originating magic link carried an oauthCtxJSON (third-party OAuth client flow) and exchanged at /oauth/token for an access + refresh token pair. Single-use, redirect-URI bound, client-ID bound, ~60s TTL. Bound to the specific magic-link row it was minted from so a leaked code cannot be replayed across sessions. Global scope: token redemption is unauthenticated and must work without partition context.")
concept authCode {
  code                string  @required  @description("Plaintext one-time auth code returned to the OAuth client via redirectURI. Held server-side so the token-exchange handler can verify the presented code value matches; never logged, never surfaced in audit detail. Hash is the lookup key, plaintext is the equality check on redemption.")
  codeHash            string  @required  @description("SHA-256 hex digest of the plaintext code. Primary lookup key in the token-exchange path -- avoids equality lookups on the plaintext.")
  clientId            string  @required  @description("OAuth client identifier the code was minted for. Token-exchange MUST verify the redeeming client matches; mismatched client = reject and audit as code_misuse.")
  redirectURI         string  @required  @description("redirect_uri value supplied at /authorize, exact-matched against the registered URI for clientId. Token-exchange MUST verify the redeeming request's redirect_uri matches; mismatched = reject.")
  state               string  @description("PKCE-style state value supplied at /authorize and echoed back on the redirect to redirectURI. Informational only at this layer (the OAuth client validates state on its end); persisted for audit correlation.")
  userId              string  @required  @description("v1:identity:user.id the code authenticates. Stamped onto the resulting session at redemption.")
  identityId          string  @required  @description("v1:identity:identity.id of the magic_link credential the code was minted from. Stamped onto the session for per-credential lastUsedAt bookkeeping.")
  magicLinkRequestId  string  @required  @description("v1:identity:magicLinkRequest.id of the consumed magic link this code was minted from. Provides a 1:1 audit trail (one magic-link click yields exactly one auth code) and lets revoking a magic link cascade-invalidate any outstanding code.")
  expiresAt           datetime  @required  @description("Absolute expiration. ~60s after creation per RFC 6749 §4.1.2 guidance. Past this point the token-exchange rejects regardless of consumedAt.")
  consumedAt          datetime  @description("Set atomically on the first successful /oauth/token redemption. Non-nil = the code is spent and any further redemption attempt is rejected and audited as code_replay. Single-use enforcement is the load-bearing security property of OAuth auth codes.")
  consumedFromIP      string  @description("IP the redemption request came from. Captured for audit and anomaly detection.")

  @relationship(type="parent", field="userId", target="v1:identity:user", direction="outgoing")
  @relationship(type="parent", field="identityId", target="v1:identity:identity", direction="outgoing")
  @relationship(type="parent", field="magicLinkRequestId", target="v1:identity:magicLinkRequest", direction="outgoing")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("Bearer-token session record. One row per access token issued by the identity service's magic-link / refresh flow. Looked up on every authenticated request to enforce per-session revocation; rows past expiresAt are tombstoned by GC, not by user action. Global scope: lives in _system so any partition's middleware can resolve a session.")
concept authSession {
  userId          string  @description("Owning v1:identity:user. Optional because rows are written at token-issuance time, which can race ahead of the magic-link verifier's user-row insert on first-time logins. Subject is the canonical lookup key.")
  identityId      string  @description("v1:identity:identity the session was minted from (typically the magic_link variant). Same caveat as userId.")
  subject         string  @required  @description("JWT subject claim. The canonical key for revoke-all; populated unconditionally so all-sessions revoke works even when the user record hasn't been bootstrapped yet.")
  tokenHash       string  @required  @description("SHA-256 hex digest of the bearer token. Primary lookup key in the auth hot path; the plain token is never stored.")
  source          enum("bff_exchange", "oidc_cookie")  @required  @description("Which auth flow created the row. bff_exchange = SPA token path (Authorization: Bearer). oidc_cookie = browser memql_auth-cookie path. Both variants are produced by the identity service's magic-link / refresh handlers.")
  clientLabel     string  @description("Best-effort human label parsed from User-Agent at issuance. Drives the device list in future per-session UIs.")
  expiresAt       datetime  @required  @description("Mirror of the JWT expiry. Sessions past this are dead even if not revoked.")
  lastActivityAt  datetime  @description("Bumped opportunistically by the auth middleware. Useful for surfacing 'last seen' on each device.")
  lastRefreshedAt datetime  @description("Bumped on every successful refresh-token rotation. Powers idle-timeout enforcement (refresh fails if lastRefreshedAt + IDENTITY_SESSION_IDLE_DAYS < now).")
  firstAuthenticatedAt datetime  @description("Set once on first issuance and never changed. Powers max-age enforcement (refresh fails if firstAuthenticatedAt + IDENTITY_SESSION_MAX_DAYS < now).")
  refreshTokenHash string  @description("SHA-256 hex digest of the current refresh token bound to this session. Rotated on every refresh. Used by the refresh handler to detect token theft (presenting a stale refresh = revoke entire session).")
  previousRefreshTokenHash string  @description("SHA-256 hex digest of the IMMEDIATELY-PREVIOUS refresh token, kept valid for a short grace window after rotation. Handles the 'client hard-refreshed mid-rotation' case: the server completed the rotation and stored the new hash, but the browser aborted before receiving the Set-Cookie response, so the browser still holds the old token. Within the grace window (see previousRotatedAt) the rotator accepts presentation of this hash and re-issues a fresh pair. Outside the window the field is treated as expired bookkeeping.")
  previousRotatedAt datetime  @description("Wall-clock timestamp at which previousRefreshTokenHash was the current hash. Combined with the rotator's grace-window constant (~30s) to decide whether the previous hash is still acceptable. Past the window, presenting the previous hash returns 401 like any other stale token.")
  revokedAt       datetime  @description("Set when the user revokes the session. Non-nil = middleware rejects the bearer token.")
  revokedReason   enum("user_action", "all_sessions", "admin", "")  @default("")  @description("Why the session was revoked. user_action = the per-device sign-out. all_sessions = the cross-device revoke. admin = staff-initiated.")

  @relationship(type="parent", field="userId", target="v1:identity:user", direction="outgoing")
  @relationship(type="parent", field="identityId", target="v1:identity:identity", direction="outgoing")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("Runtime-editable cluster settings. Single-row concept (id='cluster') that holds the operator-tunable knobs originally bootstrapped from IDENTITY_* env vars. The first-run wizard (Phase 3) writes this row; the admin app (Phase 6) edits it. Service.LiveConfig() reads from here first and falls back to env so a fresh deployment is functional without any post-bootstrap edits. Global scope so the configuration is reachable from every binary that needs it (identity itself plus future per-node verifier middleware).")
concept clusterSettings {
  clusterDomain                   string  @description("The deployment-wide hostname suffix the operator entered at /setup (or supplied via IDENTITY_BOOTSTRAP_DOMAIN). Examples: local.znas.io, staging.acme.com, acme.com. Every public service URL the cluster builds derives from it: app.<clusterDomain> for the SPA, identity.<clusterDomain> for sign-in, bff.<clusterDomain> for the API, agent.<clusterDomain> for worker registration. Empty before the wizard runs.")
  registrationMode                enum("open", "domain_restricted", "invite_only", "waitlist")  @required  @default("open")  @description("Who can self-register. Mirror of IDENTITY_REGISTRATION_MODE.")
  registrationDomains             string  @description("Comma-separated allowlist used when registrationMode=domain_restricted. Mirror of IDENTITY_REGISTRATION_DOMAINS.")
  internalDomains                 string  @description("Comma-separated email-domain allowlist that flips the per-user 'internal' flag at first login. Internal users get the cluster-wide internalDefaultRole; external users get owner of an auto-created personal partition.")
  internalDefaultRole             enum("owner", "admin", "writer", "reader")  @default("writer")  @description("Cluster-wide role granted to internal users on first login.")
  brandName                       string  @description("Display name shown in the web UI and in outbound emails. Empty falls back to 'memQL'.")
  brandPrimaryColor               string  @description("Hex color used as --brand-primary in the web UI. Empty falls back to a neutral blue.")
  brandLogoDataURI                string  @description("Optional horizontal brand logo (name+icon mark) encoded as a data URI. Used for the wide-display contexts (header brand, login page top). CSP allows img-src data: precisely so this can render without an external host.")
  brandIconDataURI                string  @description("Optional square brand icon (icon-only mark) encoded as a data URI. Used for compact contexts (favicon, collapsed sidebar, tile previews). Operators frequently want a wordmark in the header AND a tight icon for tabs / share previews -- keeping these as separate fields lets each render at its native aspect ratio.")
  registeredClientsJSON           string  @description("JSON array of {clientId, redirectURIs} entries — the relying parties allowed to initiate the OAuth-style code flow. Stored as a string because the engine doesn't yet support nested arrays of objects in concept fields. Mirrors IDENTITY_REGISTERED_CLIENTS.")
  accessRequestNotifyEmails       string  @description("Comma-separated list of operator addresses that get notified when a waitlist access-request is filed. Mirror of IDENTITY_ACCESS_REQUEST_NOTIFY_EMAILS.")
  accessRequestNotifyThrottleMins int     @default("5")  @description("Throttle window in minutes for the access-request notify emails. High-risk requests bypass via immediate-notify. Mirror of IDENTITY_ACCESS_REQUEST_NOTIFY_THROTTLE_MINUTES.")
  bootstrapEmail                  string  @description("Email captured by the first-run wizard for the cluster owner. Stamped here for audit even though the actual cluster-owner role is granted by the magic-link verifier when the operator clicks the bootstrap link, not from this row.")
  bootstrapFirstName              string  @description("Owner's given name captured by the first-run wizard. Read once by the magic-link verifier when the bootstrap user row is created (UserProfileSeed) and never used again. Stored on this row because the wizard runs before any user row exists -- there is nowhere else for it to live across the magic-link round-trip.")
  bootstrapLastName               string  @description("Owner's family name. Companion to bootstrapFirstName; same lifecycle.")
  bootstrapPhone                  string  @description("Owner's phone number captured by the wizard. Same lifecycle as bootstrapFirstName / bootstrapLastName.")
  bootstrapPrimaryRole            string  @description("Owner's free-form job title captured by the wizard. Same lifecycle.")
  bootstrapGender                 string  @description("Owner's self-identified gender captured by the wizard. Same lifecycle.")
  bootstrapBirthdate              string  @description("Owner's ISO-8601 date of birth captured by the wizard. Same lifecycle.")
  bootstrappedAt                  string  @description("RFC3339 timestamp stamped by the magic-link verifier when an operator clicks the wizard-issued bootstrap link. Empty means 'wizard hasn't run' OR 'wizard ran but ownership not yet claimed' -- /setup remains accessible in either case. Stored as string (not datetime) so empty-string is a legal value the JSON-schema validator accepts; readers parse it as RFC3339 when non-empty.")
  accessTokenTTLSeconds           int     @default("0")  @description("Lifetime of issued access tokens in seconds. 0 means 'fall back to IDENTITY_ACCESS_TOKEN_TTL_SECONDS env, or the 900s built-in default'. Bounded at the admin form layer to [60, 86400] (1 minute to 24 hours). Read on every /oauth/token + /auth/refresh issuance so changes apply on the next access-token mint without an identity restart.")
  refreshTokenTTLSeconds          int     @default("0")  @description("Absolute lifetime of refresh tokens in seconds. 0 means 'fall back to IDENTITY_REFRESH_TOKEN_TTL_SECONDS env, or the 30-day built-in default'. Bounded at the admin form layer to [86400, 31536000] (1 day to 1 year). Refresh rotation uses this for both the initial mint and the rotation-time max-age check; lowering it does NOT immediately invalidate live sessions but the next rotation that crosses the new ceiling will refuse.")
  magicLinkTTLSeconds             int     @default("0")  @description("How long an issued magic-link is valid. 0 means 'fall back to IDENTITY_MAGIC_LINK_TTL_SECONDS env, or the 600s built-in default'. Bounded at the admin form layer to [60, 3600] (1 minute to 1 hour). Short by design -- magic-links are click-through credentials, not session tokens.")
  invitationTTLDays               int     @default("0")  @description("How long an admin-issued user invitation token stays valid, in days. 0 means 'fall back to IDENTITY_INVITATION_TTL_DAYS env, or the 7-day built-in default'. Bounded at the admin form layer to [1, 90].")
  refreshCookieSameSite           enum("", "lax", "none")  @default("")  @description("SameSite policy for the refresh-token cookie. Empty = inherit from IDENTITY_REFRESH_COOKIE_SAMESITE env (which defaults to 'lax'). 'lax' is correct for the common same-site self-hosted topology (app.acme.com + identity.acme.com share an eTLD+1) and avoids Safari ITP scrutiny. 'none' is required for true cross-site deployments where the SPA and identity service live under different eTLD+1s (app.copresent.ai + auth.visionarys.io); browsers treat the cookie as third-party and apply ITP rules. The cookie is always Secure when BaseURL is HTTPS regardless of this setting.")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("Grants an AI agent the right to act through a user's v1:identity:identity for a bounded role ceiling, scope set, and lifetime. Global scope: lives in _system and is readable from any partition so cross-partition agent work does not require per-partition delegation rows.")
concept delegation {
  identityId         string  @required  @description("Node ID of the v1:identity:identity granting authority. Through its userId the delegation resolves back to a v1:identity:user.")
  identitySubject    string  @required  @description("authenticated subject id of the delegating identity (denormalized for fast lookup on the auth hot path).")
  identityType       enum("human", "synthetic")  @required  @description("Type of the delegating identity. Separate from v1:identity:identity.identityType (which classifies the credential family); this classifies the principal behind it.")
  agentId            string  @required  @description("Node ID of the v1:copresent:agent receiving delegated authority.")
  roleCeiling        enum("owner", "admin", "writer", "reader")  @required  @description("Maximum role the agent may assume under this delegation. The engine caps the effective role at RoleAtMost(identity.role, roleCeiling).")
  scopes             []string  @description("Allowed operation scopes. Empty means all operations within the role ceiling. Examples: query:*, mutation:cognition.*.")
  expiresAt          datetime  @description("When this delegation expires. Null means persistent (no expiry).")
  active             bool  @default("true")  @description("Whether this delegation is currently in effect.")
  createdBySubject   string  @required  @description("authenticated subject id of whoever authorized this delegation.")
  approvedBySubject  string  @description("authenticated subject id of the guardian who approved (for synthetic identity delegations).")
  revokedAt          datetime  @description("When this delegation was revoked.")
  revokedBySubject   string  @description("authenticated subject id of whoever revoked this delegation.")
  note               string  @description("Human-readable note about why this delegation was created.")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("An account or credential set owned by a v1:identity:user. One user can have many identities: a magic-link verified email, OAuth accounts on external apps, API keys (Personal Access Tokens), or service accounts. Agents borrow identities to act on the user's behalf via v1:identity:delegation. Global scope: lives in _system and is readable from any partition.")
concept identity {
  active          bool    @default("true")  @description("Soft-delete flag. Revoked credentials stay around for audit but are inactive.")
  userId          string  @required  @description("Owning v1:identity:user. Every identity must belong to exactly one user; a user can own many identities.")
  identityType    enum("oauth", "api_key", "service_account", "magic_link", "worker_token")  @required  @description("Which credential family this identity belongs to. Determines the shape of the credentials object: see the credentials field below. The 'worker_token' variant authenticates a memql-cockpit-worker process (one credential per registered machine); it is server-side-scoped to WorkerService.Stream + audit-emit paths and is rejected by the auth interceptor on every other RPC.")
  credentials     object  @required  @description("Type-specific credential material. Shape is a oneOf picked by identityType: see the @variant block below. Raw OAuth tokens and API-key plaintext never live here.")  @variant(discriminator="identityType") {
    oauth {
      provider         string        @required  @description("External app identifier, e.g. \"slack\" or \"github\".")
      externalUserId   string        @required  @description("The user's id in the external app.")
      scopes           []string @description("OAuth scopes this identity holds.")
    }
    api_key {
      keyHash  string  @required  @description("SHA-256 hex digest of the key. Plaintext never stored.")
    }
    service_account {
      accountId  string  @required  @description("External service-account id.")
    }
    magic_link {
      verifiedAt     datetime  @required  @description("When the magic-link click verified email ownership. The single timestamp that proves the user owns this email.")
      lastLinkSentAt datetime  @description("Most recent magic-link send timestamp; used for client-side rate limit display.")
    }
    worker_token {
      name                    string    @required  @description("Operator-chosen worker name (also stamped on v1:worker:registration). Surfaced in /me/workers and /admin/workers. Useful when one user owns multiple workers.")
      keyHash                 string    @required  @description("SHA-256 hex digest of the mql_wkr_<32> token. Plaintext is shown once at issuance and never persisted.")
      registeredBy            string    @required  @description("v1:identity:user.id who minted the token. Same as Identity.userId for self-issued tokens; differs for admin-issued tokens (audit attribution).")
      capabilitiesAdvertised  []string  @description("Snapshot of the capabilities the worker advertised on its most recent connect. Informational; the live capability set lives on v1:worker:registration.")
      labelsAdvertised        object    @description("Snapshot of labels advertised on most recent connect. Informational.")
      lastSeenAt              string    @description("Last successful connect timestamp (RFC3339Nano), mirrored from v1:worker:registration for token-side queries. Stored as a string -- not datetime -- because empty string is a legal 'not set' encoding the schema validator accepts; readers parse it as RFC3339Nano when non-empty.")
      lastConnectedFromIP     string    @description("Source IP of the most recent connect. Audit signal.")
      expiresAt               string    @description("When the token expires (RFC3339Nano). Tokens auto-rotate every 90 days via in-stream RotationRequest; expiresAt drives the rotation prompt window. Stored as a string -- not datetime -- so empty string is a legal 'no expiry yet' encoding (the rotation flow stamps a real timestamp on first connect).")
    }
  }
  label           string  @description("Human label shown in UIs, e.g. 'Work email', 'Personal Slack', 'Legacy integration key'. Optional, defaults to a generated summary of the credentials.")
  usableByAgents  bool    @default("false")  @description("Whether v1:identity:delegation can borrow this identity for agent work. Magic-link identities default false (agents shouldn't impersonate humans wholesale); OAuth identities for specific external apps default true (they exist precisely so agents can act against that app on the user's behalf).")
  lastUsedAt      datetime  @description("Per-credential last-use stamp. Useful for pruning stale OAuth tokens or unused API keys. User-level 'last seen' lives on v1:identity:user.lastSeenAt.")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("Token-hashed invitation credential. Maps an invitee (existing user by ID, or external guest by email + token) to an optional product scope hint. The identity layer owns the lifecycle (pending/accepted/expired/cancelled) and the auth primitive; product layers populate spaceId/spaceName and any display-name denormalizations they need. Global-scoped: an unauthenticated /join/<token> resolve has no envelope partition, and even authenticated invitees may live in a different partition than the inviter, so token -> invitation lookup must work without a partition context. Product-side rows that REFERENCE invitations (e.g. v1:copresent:participation) stay partition-scoped on the partition where the work actually happens.")
concept invitation {
  active        bool                                                                          @description("Whether the invitation is active. Set false to soft-cancel.")
  expiresAt     datetime                                                                      @description("Absolute expiration timestamp (guest kind only; null for user kind).")
  inviteeEmail  string                                                                        @description("Email address of the invitee (guest kind).")
  inviteeId     string                                                                        @description("User ID of the invitee (user kind).")
  inviteeName   string                                                                        @description("Display name suggested by the inviter. Optional.")
  inviterId     string  @required                                                             @description("User ID of the person who issued the invitation.")
  inviterName   string                                                                        @description("Display name of the inviter. Denormalized for notification/email rendering.")
  kind          enum("user", "guest")  @required  @default("guest")                           @description("user = invite an existing user by ID. guest = invite an external email with a token.")
  respondedAt   datetime                                                                      @description("When the invitation was responded to.")
  spaceId       string                                                                        @description("Product scope hint. CoPresent populates this with a v1:cognition:space ID so the post-accept flow can route the invitee into the right space.")
  spaceName     string                                                                        @description("Display name of the scope. Denormalized for email rendering. Optional.")
  status        enum("pending", "accepted", "ignored", "left", "kicked", "dismissed")  @required  @default("pending")  @description("Lifecycle status. Product layers extend with participation-style values (left/kicked/dismissed) when they bind the invitation to a product record.")
  token         string                                                                        @description("Plain guest-invite token (guest kind only). Persisted so `resend email` sends the same /join/<token> URL without minting a new invitation. Acceptable because invites are short-lived and scope-limited.")
  tokenHash     string                                                                        @description("SHA-256 hex digest of the guest invite token (guest kind only). Primary lookup key in the guest-auth interceptor.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="parent", field="inviterId", target="v1:identity:user", direction="outgoing")
  @relationship(type="parent", field="inviteeId", target="v1:identity:user", direction="outgoing")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("Pending magic-link authentication request. One row per /auth/magic-link issuance. The plain token is hashed (SHA-256) before persistence -- only the hash lives here so a database snapshot can never be replayed into a login. Single-use semantics: consumedAt is set atomically on the first successful click and any subsequent click against the same row is rejected. Past expiresAt the row is also rejected. Global scope so the public unauthenticated /auth/magic-link/consume endpoint can resolve the row regardless of which partition the eventual user belongs to.")
concept magicLinkRequest {
  email           string  @required  @description("Email address the magic link was sent to. Drives the user-lookup / first-time-registration path on consume.")
  tokenHash       string  @required  @description("SHA-256 hex digest of the plain magic-link token. Primary lookup key on consume; the plaintext token is delivered in the email link and never stored server-side.")
  expiresAt       datetime  @required  @description("Absolute expiration timestamp. Past this point the row is dead even if not consumed; the consume handler treats expired and consumed identically (both reject).")
  consumedAt      datetime  @description("Set atomically on the first successful consume. Non-nil = the row is spent and any further click against the same token is rejected. Single-use enforcement is the load-bearing security property of magic links.")
  consumedFromIP  string  @description("Best-effort IP recorded at consume time. Used by the audit log and by anomaly detection (consume from a different country than issuance, etc).")
  oauthCtxJSON    string  @description("Serialized JSON of the OAuth context the magic link was issued under: {clientId, redirectURI, state}. When present the consume handler mints an auth code instead of a session and redirects to clientId's redirectURI with the code. When absent the consume creates a session directly (first-party SPA flow).")
  sourceIP        string  @description("IP the issuance request came from. Captured for audit and for risk scoring (issuance velocity per IP).")
  userAgent       string  @description("User-Agent header at issuance time. Captured for audit and for the consume-time UA-mismatch check (loose; a different browser is allowed).")
  invitationId    string  @description("Set when the magic link was issued in response to an admin-approved access-request invitation. Empty for self-service login attempts. Lets the consume handler stamp the inviting context on the new user record.")

  @relationship(type="parent", field="invitationId", target="v1:identity:invitation", direction="outgoing")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("A grant authorizing a v1:identity:user to operate in a specific partition with a given role. The gRPC middleware enforces this on every request (envelope.partition must be in the caller's allowed set, role must be sufficient for the operation). Grants are time-series records keyed by (userId, partition); re-granting the same pair appends a new version so history is preserved. Global scope: lives in _system and is readable from any partition.")
concept partitionAccess {
  active        bool    @default("true")  @description("Soft-revoke flag. active=false means the grant is ineffective; same pattern as partition draining. Hard-deletion never happens so the audit trail survives.")
  userId        string  @required  @description("Recipient of the grant (v1:identity:user.id).")
  partitionName string  @required  @description("Partition NAME, matching v1:platform:partition.name. Stored as `partitionName` (not `partition`) because `partition` is a reserved payload-level field name in the engine. Partition renames are forbidden precisely because these grants reference the name.")
  role          enum("owner", "admin", "writer", "reader")  @required  @description("Role held by the user within this partition. partition-owner/partition-admin are the partition's admins; writer can mutate data; reader can only read. Cluster-wide roles on v1:identity:user are a separate axis.")
  grantedBy     string  @required  @description("User (v1:identity:user.id) who issued this grant. For self-grants by the bootstrap automation, this equals userId.")
  grantedAt     datetime  @required  @description("When the grant was issued.")
  expiresAt     datetime  @description("Optional auto-expiry. After this timestamp the middleware treats the grant as inactive even if active=true.")
  source        enum("manual")  @default("manual")  @description("How this grant was created. manual = someone called grantPartitionAccess explicitly. Reserved as an enum for future provenance variants (e.g. SCIM-driven, SSO-group-driven) without re-shaping the column.")
  sourceRef     string  @description("Free-form back-reference to whatever produced the grant. Empty for manual grants; non-manual provenance variants stamp an external id here so audit can answer 'where did this come from?'.")
  revokedAt     datetime  @description("Set when active flipped to false. Together with revokedBy it answers 'who yanked Alice out of acme and when?'.")
  revokedBy     string  @description("User (v1:identity:user.id) who revoked the grant.")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("A person (or synthetic principal). Owns identities and partition-access grants. Same record across every partition the user can touch. Global scope: lives in _system and is readable from any partition.")
concept user {
  active          bool    @default("true")  @description("Whether the user account is active.")
  displayName     string  @required  @description("Display name shown in the UI. By convention this is firstName + ' ' + lastName when both are populated; the admin / setup wizard maintain that invariant. Standalone field (rather than a derived computed view) because legacy rows pre-date the firstName/lastName split and we want a stable display value to fall back on.")
  firstName       string  @description("Given name. Set by the admin via /admin/users/detail (or by the cluster owner via /setup); flows through to the JWT as the OIDC-style `given_name` claim and into CoPresent's profile UI.")
  lastName        string  @description("Family name. Mirror of firstName -- admin-curated, stamped onto the JWT as `family_name`.")
  primaryEmail    string  @required  @description("Canonical email. Verified by the magic-link flow at registration; the dedup key for 'is this Alice already known?'.")
  phone           string  @description("E.164 phone number, optional. Set by an admin via /admin/users/detail; required for full app access via the ProfileCompletenessGuard.")
  primaryRole     string  @description("Free-form job title / role at the org (e.g. 'CEO', 'Engineer'). Distinct from the cluster-wide auth `role` field above; admin-curated, not auth-related.")
  gender          string  @description("Optional self-identified gender. Free-form string -- the frontend offers a curated list but the backend doesn't enforce one.")
  birthdate       string  @description("ISO-8601 date (YYYY-MM-DD), optional. Stored as a string rather than datetime because we never compute against it -- it's reference data the admin sets and the profile UI surfaces.")
  role            enum("owner", "admin", "writer", "reader")  @default("reader")  @description("Cluster-wide role. owner bypasses the partition ACL; admin sees all partitions but still needs a per-partition grant to mutate data; writer and reader need an explicit grant for every partition they operate in.")
  groupIds        []string  @description("Group memberships. Reserved for future cluster-side group-based partition-access derivation.")
  preferences {
    language             string  @description("Preferred language as a BCP 47 tag (e.g., en-US, es-MX).")
    notifications        bool    @default("true")  @description("Whether to receive notifications.")
    theme                enum("light", "dark", "system")  @default("system")  @description("UI theme preference.")
    timezone             string  @description("User's local timezone as an IANA name (e.g., America/Los_Angeles). Used by the rolloverDailySpace cron to decide when 'today' begins for this user. Empty falls back to UTC.")
    archiveRetentionDays int     @default("30")  @description("How long an archived space lives before the cron purge sweep hard-deletes it. UI exposes 30 (default) and 60. The cron reads the user's CURRENT value at run-time, so a 30->60 bump rescues currently-archived spaces.")
    dailySpaceEnabled    bool    @default("true")  @description("Whether the daily-space automation provisions and rolls over a per-day singleton space for this user. Defaults on; users who don't want a daily space can disable it in Settings.")
    dailySpaceRolloverAction enum("archive", "save")  @default("archive")  @description("What happens to yesterday's daily space when the rollover cron fires. 'archive' is the default (it ages out per archiveRetentionDays); 'save' preserves it indefinitely under the user's Saved tab.")
    cursorTweenMs        int     @default("1000")  @description("Standard Mode cursor tween duration in milliseconds (250-2500). Drives how long the agent's cursor takes to travel between targets in transactional / minimal-interactivity sessions. The frontend slider clamps to the supported range; the value here is the canonical cross-device preference.")
    takeoverMode         enum("clean", "dim")  @default("clean")  @description("Standard Mode visual appearance during a CoPresent Control takeover. 'clean' (default) leaves the app visible with the agent cursor + highlight as the only takeover cues; 'dim' tints the viewport dark with a cursor-following spotlight. Clicks are blocked across the whole viewport in both modes -- this only changes the visual cue.")
    interactivePace      enum("quick", "steady", "deliberate")  @default("steady")  @description("Interactive Mode pace preset. Maps to a fixed cursor speed used during conversational sessions (walkthroughs / demos / teaching flows): quick=500ms per move, steady=1000ms (default), deliberate=1500ms. Independent from cursorTweenMs -- the two settings target different session shapes.")
    computerUseEnabled   bool    @default("true")  @description("Per-user kill switch for the worker / computer_use feature. Sticky -- survives sessions, devices, restarts. When false, every worker dispatch is rejected with kill_switch_engaged and the killSwitchSuspendsRunningPlans automation transitions the user's running plans (with computerUseScope set) to awaitingFeedback. The user must consciously re-enable. Admin override possible (audit-logged with admin as actor).")
    voiceMode            enum("toggle", "continuous")  @default("toggle")  @description("Per-user mic mode preference for Polyphon rooms. 'toggle' (default) = click on / click off; 'continuous' = mic stays open while VAD gates speech detection. Phase 7 of the voice/audio plan. Hold-to-talk is preserved for voice-first creation modals (different context); the room's chat mic only branches between toggle and continuous.")
    discussionModeActivityLevel  enum("off", "low", "medium", "high")  @default("medium")  @description("How chatty the user's agents are in their private Team-tab thread (Phase 6 of the chat-architecture plan). off = never chime in; low = mentions-only with 60s windows + 1 LLM call/min cap; medium = mentions + direct questions with 30s windows + 2 LLM calls/min cap; high = mentions + questions + distress with 15s windows + 4 LLM calls/min cap. Default medium tracks the General Assistant default; per-agent overrides live elsewhere if needed. Discussion mode runs ONLY while the user is active in the space; pauses on inactive.")
    misrouteSafetyEnabled        bool                                 @default("true")  @description("Whether the server-side misroute classifier (Phase 8 of the chat-architecture plan) gates outgoing messages. When true, the classifier checks every send for wrong-tab confidence; >= 0.85 triggers a hard pre-send modal, 0.6-0.85 triggers a soft post-send Move prompt, <0.6 is silent. When false, the classifier is bypassed entirely. Defaults on; users who find the prompts noisy can opt out in Settings.")
  }
  suspendedAt     datetime  @description("Set when the user is suspended by an admin. Nil means active.")
  suspendedReason string    @description("Human-readable reason for suspension.")
  lastSeenAt      datetime  @description("Updated by the identity service on each successful refresh. Answers 'when was this person last around'. Per-credential last-use lives on v1:identity:identity.lastUsedAt.")
  activeSpaceId   string    @description("v1:cognition:space.id this user is currently active in (Phase 4 of the chat-architecture plan). Hard rule: each human is active in at most one space at a time -- camera, mic, voice transport, video presence are all bound to this pointer. Empty / unset means the user is in the app but not focused on any space (or has the app closed). Set by mutationSetUserActiveSpace from the SPA's set-active-on-enter wiring; the participant guard derives `isActive` for downstream consumers by comparing this against the participant's spaceId. Discussion mode (Phase 6) and voice migration (Phase 7) both key on this field.")
  internal        bool      @default("false")  @description("True when the registering email matched IDENTITY_INTERNAL_DOMAINS at first login. Internal users get the cluster-wide IDENTITY_INTERNAL_DEFAULT_ROLE; external users instead get owner of an auto-created personal partition. Captured at registration so policy decisions remain stable even if the configuration drifts.")
  legalAcceptance []object  @description("Append-only history of legal-document acceptances. Each entry: {documentType: 'tos'|'privacy', version: string, acceptedAt: datetime, sourceIP: string}. Audit trail for compliance -- never edited, only appended.")
  deletionScheduledAt datetime  @description("Set when the user requested account deletion. The accountDeletionSweep cron hard-deletes the row IDENTITY_DELETION_COOLDOWN_DAYS later. Cleared by mutationCancelScheduledDeletion if the user reverses the request during the cooldown.")
  dataExportLastAt datetime  @description("Timestamp of the most recent /me/export download. Drives rate-limiting per IDENTITY_DATA_EXPORT_RATE_LIMIT_HOURS.")
}

@version("1.0.0")
@namespace("identity")
@scope("global")
@visibility("*")
@description("Short-lived pairing credential for the computer-use enrollment flow. CoPresent's Settings -> Computer Use 'Connect this computer' card mints a row + plain code (XXXX-XXXX, 8 alphanumeric chars from Crockford's Base32 alphabet). The cockpit wizard on the user's machine redeems the code on the cluster's gRPC stream via Authorization: Pair <code>, the redeem handler stamps redeemedAt + redeemedBy, mints a v1:identity:identity worker_token row owned by the same user, and returns the plain mql_wkr_<...> token + cluster URL to the cockpit. Single-use: a row with non-empty redeemedAt is dead. TTL ~10 minutes (IDENTITY_PAIRING_CODE_TTL_MIN, default 10).")
concept workerPairingCode {
  ownerUserId  string  @required  @description("v1:identity:user.id who minted the code (and who will own the resulting worker_token + v1:worker:registration). The redeem handler reads this and uses it as the registeredBy for the new worker_token credential.")
  codeHash     string  @required  @description("SHA-256 hex digest of the plain XXXX-XXXX code. Plaintext is shown to the user ONCE on the CoPresent Settings card and never persisted.")
  clusterURL   string  @required  @description("Canonical cluster URL the cockpit should dial for the WorkerService.Stream. Stamped at create time so the redeem handler can echo it back -- letting CoPresent and the BFF be reachable at different DNS names without leaking that detail to the cockpit operator.")
  expiresAt    datetime  @required  @description("Absolute expiration timestamp. Redeem rejects rows past this even when redeemedAt is empty.")
  redeemedAt   datetime  @description("Stamped on first successful redeem. Single-use semantics: any subsequent redeem against the same row fails with already_redeemed.")
  redeemedBy   string  @description("v1:identity:identity.id of the worker_token row the redeem minted, for audit trail. Empty until redeemed.")
  redeemedFromIP  string  @description("Source IP the redeem call came from. Audit signal -- helps detect 'someone else redeemed my code' fraud.")
  sourceIP     string  @description("IP the create-pairing-code request came from. Audit + abuse signal.")

  @relationship(type="parent", field="ownerUserId", target="v1:identity:user", direction="outgoing")
  @relationship(type="parent", field="redeemedBy", target="v1:identity:identity", direction="outgoing")
}

@version("1.0.0")
@namespace("identity")
@visibility("bff", "cognition")
@description("Organization group. Users belong to groups; agents are assigned to groups for scoped access control. Created and managed in-app; the externalId field is preserved for any legacy rows that came from a previous external sync source.")
concept group {
  name         string  @required @description("Display name of the group.")
  description  string  @required @description("Short description of the group's purpose. Required so group pickers (CreateSpaceModal, admin lists) always have a useful subtitle.")
  externalId   string  @required @description("External group id for legacy sync correlation. Empty for in-app-created groups.")
  memberIds    []string  @description("User IDs that belong to this group.")
  agentIds     []string  @description("Agent IDs assigned to this group.")
  maxHumans    int     @default("5") @description("Maximum human members this group can hold. Matches v1:cognition:space.maxHumans so a group can seed a space without silent truncation.")
  maxAgents    int     @default("3") @description("Maximum agent members this group can hold, inclusive of any user's auto-joined general assistant. Matches v1:cognition:space.maxAgents.")
  active       bool    @default("true") @description("Whether the group is active.")
}
