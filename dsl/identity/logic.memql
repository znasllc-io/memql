// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// accessRequestExpirySweep
// =========================
//
// Daily sweep at 04:00 UTC that ages out pending access requests
// older than IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS by flipping
// status="expired". Same shape as expireGuestInvitations:
//
//   1. Query every pending access request.
//   2. For each, compute (createdAt + N days) and check whether
//      it's in the past relative to now -- if so, expire it.
//
// MemQL parser limitation: filter expressions don't accept inline
// addDuration() calls (the planner rejects function-call literals
// in filter comparisons), and addDuration accepts only positive
// ISO-8601 durations. So the windowing math has to live on the
// per-row side ("createdAt + N days < now"), which is what the
// `if` guard inside the loop does.
//
// IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS is read from the global
// variable registry. The default of 30 days is materialised at
// engine startup; bumping the variable takes effect on the next
// cron tick.
//
// The pending-access-request table is small (admin queue), so
// iterating all of it daily is cheap.
use platform.queries.{ globalVariable }

/// Pure decide for the access-request expiry sweep (#2369, cluster pruneStaleClusterNodes pattern):
/// reads IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS (default 30), computes cutoff = now - window via
/// addDuration with a negative ISO duration, and returns
/// expiredPendingAccessRequests({createdBefore: cutoff}).nodes() -- the pending rows past the
/// window, filtered by QUERY PUSHDOWN. The retention policy lives entirely here; the calling
/// automation's forEach is unconditional.
logic accessRequestExpirySweep {
  args {
    event object!
  }
  body {
  windowDays := query globalVariable( name: "IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS" )
  pending := query expiredPendingAccessRequests( createdBefore: addDuration(now, concat("P-", coalesce(windowDays.first().payload.value, "30"), "D")) )
  return pending.nodes()
  }
}

/// Daily 09:05 UTC sweep that emits an 'identity.deletion.reminder' event for each user 25-26 days
/// into their deletion cooldown -- final notice before accountDeletionSweep performs the hard
/// delete at 30 days. Bracket [P25D, P26D) on deletionScheduledAt fired daily means each user gets
/// exactly one reminder at this milestone.
logic accountDeletionReminder25Days {
  args {
    event object!
  }
  body {
  candidates := query usersInDeletionCooldown()

  for item := range candidates.nodes() {
    emitReminder := if addDuration(item.payload.deletionScheduledAt, "P25D") < now && addDuration(item.payload.deletionScheduledAt, "P26D") >= now {
      publishEvent(
        topic: "identity.deletion.reminder",
        payload: {
          userId: item.id,
          email: item.payload.primaryEmail,
          deletionScheduledAt: item.payload.deletionScheduledAt,
          milestoneDays: 25,
          subject: "Final notice: your <BRAND_NAME> account will be deleted in 5 days",
          timestamp: now
        }
      )
    }
  }

  return candidates.count()
  }
}

/// Daily 09:00 UTC sweep that emits an 'identity.deletion.reminder' event for each user 7-8 days
/// into their deletion cooldown so they can cancel before the cooldown elapses. Bracket [P7D, P8D)
/// on deletionScheduledAt fired daily means exactly one reminder per user at this milestone. Email
/// delivery is consumed by the component/server subscriber.
logic accountDeletionReminder7Days {
  args {
    event object!
  }
  body {
  candidates := query usersInDeletionCooldown()

  for item := range candidates.nodes() {
    // Window: deletionScheduledAt is between 7 and 8 days ago.
    // Equivalent: scheduledAt + P7D < now AND scheduledAt + P8D >= now.
    emitReminder := if addDuration(item.payload.deletionScheduledAt, "P7D") < now && addDuration(item.payload.deletionScheduledAt, "P8D") >= now {
      publishEvent(
        topic: "identity.deletion.reminder",
        payload: {
          userId: item.id,
          email: item.payload.primaryEmail,
          deletionScheduledAt: item.payload.deletionScheduledAt,
          milestoneDays: 7,
          subject: "Your <BRAND_NAME> account will be permanently deleted soon",
          timestamp: now
        }
      )
    }
  }

  return candidates.count()
  }
}

// accountDeletionSweep
// =====================
//
// Daily 03:00 UTC sweep. For each active user with deletionScheduledAt
// set whose cooldown (MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS, default 30) has
// elapsed:
//
//   1. Soft-delete the user row + scrub PII (deleteUserHard).
//   2. Revoke every active auth session for the user's JWT subject so
//      any in-flight tokens stop authorizing.
//
// What this cron does NOT touch (intentional gaps):
//
//   - v1:identity:auditEvent rows: kept for the trail. The
//     audit-event rows already capture point-in-time email/role on
//     each entry, so they remain readable post-deletion. (User-id
//     foreign keys on audit rows still resolve to the tombstoned
//     user row.)
//   - v1:identity:invitation rows the user issued: kept for the
//     same reason -- audit trail.
//   - v1:identity:accessRequest rows the user originated as an
//     admin reviewer: kept for the trail.
//   - v1:identity:identity rows (the credential records): NOT
//     scrubbed today. A future enhancement should iterate the
//     user's identities and call a `mutationScrubIdentity` to
//     blank credentials (oauth tokens, key hashes, etc.); no
//     such mutation exists yet, and inventing one without a
//     concept-side @scrub annotation would risk leaving stale
//     credential data on disk. Tracked as a follow-up.
//
// MemQL parser limitations:
//
//   - The filter side of usersScheduledForDeletion can't push
//     the cooldown math into the query (see that file's header).
//     Per-row gating uses
//       addDuration(item.payload.deletionScheduledAt, "P{cooldown}D") < now
//   - There's no batch-update path; we revoke sessions one row at a
//     time inside the loop.
/// Pure decide for the account-deletion sweep (#2369, cluster pattern): reads
/// MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS (default 30), computes cutoff = now - cooldown via
/// addDuration with a negative ISO duration, and returns
/// usersScheduledForDeletion({scheduledBefore: cutoff}).nodes() -- users whose cooldown has
/// elapsed, filtered by QUERY PUSHDOWN; the automation's forEach hard-deletes each unconditionally.
/// Audit-event rows, invitations the user issued, and access-request rows are intentionally
/// retained for the trail.
logic accountDeletionSweep {
  args {
    event object!
  }
  body {
  cooldownDays := query globalVariable( name: "MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS" )
  candidates := query usersScheduledForDeletion( scheduledBefore: addDuration(now, concat("P-", coalesce(cooldownDays.first().payload.value, "30"), "D")) )

  // Auth-session revocation gap (intentional): the user concept holds
  // user.id, but authSessionsForSubject is keyed on the JWT
  // `sub` claim (the canonical v1:identity:user.id our identity
  // service issues). There is no query today that returns sessions
  // by userId expansion, and no helper to enumerate all sub claims
  // for a user. Session expiry on its own retires the row
  // eventually, so the worst case is a deleted user's bearer token
  // continues to authenticate until its JWT expires.
  //
  // When a queryAuthSessionsForUser (or an "expand identities for
  // user" helper) lands, add a second forEach apply step in the
  // accountDeletionSweep automation that revokes each session via
  // revokeAuthSession.
  return candidates.nodes()
  }
}

/// Daily 02:00 UTC sweep over v1:identity:auditEvent rows older than
/// MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS. Observation-only today: emits an
/// 'identity.audit.retention.observed' event with the candidate count -- MemQL has no delete()
/// mutation and AuditEvent's append-only semantics forbid soft-delete via active=false. Per-row
/// delete lands when one of those gaps closes.
logic auditEventRetentionSweep {
  args {
    event object!
  }
  body {
  allEvents := query expiredAuditEvents()
  retentionDays := query globalVariable( name: "MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS" )

  // Count how many rows would be deleted under the configured
  // retention. The publishEvent emits one observation per cron
  // tick so the operator can see the candidate-row count over time.
  // No per-row state change today -- see header note.
  emitObservation := publishEvent(
    topic: "identity.audit.retention.observed",
    payload: {
      candidateCount: allEvents.count(),
      retentionDays: coalesce(retentionDays.first().payload.value, "365"),
      timestamp: now
    }
  )

  return allEvents.count()
  }
}

/// Hourly sweep that stamps consumedAt + consumedFromIP='system:expiry' on v1:identity:magiclink
/// rows whose expiresAt is in the past, so the row reads as 'spent' in audit queries and any
/// subsequent click is idempotently rejected by the consume handler's own expiresAt guard.
logic magicLinkExpirySweep {
  args {
    event object!
  }
  body {
  return query expiredMagicLinkRequests( asOf: now )
  }
}

/// Emits a 'delegation.created' event when a new v1:identity:delegation row lands. Carries the
/// delegation id + identity / agent / role / scope fields for audit logging and downstream event
/// processing.
logic onDelegationCreated {
  args {
    event object!
  }
  body {
  emitEvent := publishEvent(
    topic: "delegation.created",
    payload: {
      delegationId: args.event.node.id,
      args.event.node.payload.identityId,
      args.event.node.payload.identitySubject,
      args.event.node.payload.identityType,
      args.event.node.payload.agentId,
      args.event.node.payload.roleCeiling,
      args.event.node.payload.scopes,
      args.event.node.payload.createdBySubject,
      timestamp: now
    }
  )
  return emitEvent
  }
}

// ---- logic/v1/identity/revokeExpiredDelegations.memql ----

// revokeExpiredDelegations
// =============================
//
// Queries every active delegation whose expiresAt is in the past, then
// soft-revokes each one with `system:expiry` as the revoker. Returns the
// number of rows processed so the caller can surface a count.
//
// `now` is passed by the caller (the automation step computes
// `now` so the query receives a plain RFC3339 string) because
// the memQL query planner doesn't accept function-call literals in
// comparison expressions yet.

/// Find every expired active delegation and soft-revoke it with `system:expiry` as the revoker.
/// Returns the count processed.
logic revokeExpiredDelegations {
  args {
    asOf string!
  }
  body {
    return query expiredActiveDelegations( asOf: args.asOf )
  }
}

