// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// accessRequestExpirySweep
// =========================
//
// Daily sweep at 04:00 UTC that ages out pending access requests
// older than IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS by flipping
// status="expired". Same shape as expireGuestInvitations:
//
//   1. Query every pending access request.
//   2. For each, compute (createdAt + N days) and check whether
//      it's in the past relative to now -- if so, expire it.
//
// MemQL parser limitation: filter expressions don't accept inline
// addDuration() calls (the planner rejects function-call literals
// in filter comparisons), and addDuration accepts only positive
// ISO-8601 durations. So the windowing math has to live on the
// per-row side ("createdAt + N days < now"), which is what the
// `if` guard inside the loop does.
//
// IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS is read from the global
// variable registry. The default of 30 days is materialised at
// engine startup; bumping the variable takes effect on the next
// cron tick.
//
// The pending-access-request table is small (admin queue), so
// iterating all of it daily is cheap.
use identity.queries.{ expiredActiveDelegations, expiredAuditEvents, expiredMagicLinkRequests, expiredPendingAccessRequests, usersInDeletionCooldown, usersScheduledForDeletion }
use platform.queries.{ globalVariable }

@description("Pure decide for the access-request expiry sweep: returns every pending access request candidate. The expiry-var read, the per-row window gate (createdAt + P{N}D < now), and the expire write live in the accessRequestExpirySweep automation's window + forEach steps (#2235; date-window gate evaluated correctly since #2256/#2254).")
logic accessRequestExpirySweep {
  args {
    event object @required
  }
  body {
  pending := expiredPendingAccessRequests({})
  return pending.nodes()
  }
}

// accountDeletionReminder25Days
// ==============================
//
// Daily 09:05 UTC sweep that emits a more-urgent reminder event for
// each user ~25 days into their deletion cooldown -- typically the
// last reminder before the 30-day cooldown elapses and
// accountDeletionSweep performs the hard delete.
//
// Same shape as accountDeletionReminder7Days; only the windowing
// (P25D / P26D) and the event subject string differ. Two
// automations rather than one because:
//
//   1. Each fires at a slightly different time so they don't
//      contend for the same scheduler slot.
//   2. The bracket is materialised in the if-condition; refactoring
//      to a single automation would need an array of windows + a
//      nested loop, which the MemQL automation grammar doesn't
//      cleanly express today.
//
// MemQL parser limitation + email-delivery delegation: see header
// of accountDeletionReminder7Days.
@description("Daily 09:05 UTC sweep that emits an 'identity.deletion.reminder' event for each user 25-26 days into their deletion cooldown -- final notice before accountDeletionSweep performs the hard delete at 30 days. Bracket [P25D, P26D) on deletionScheduledAt fired daily means each user gets exactly one reminder at this milestone.")
logic accountDeletionReminder25Days {
  args {
    event object @required
  }
  body {
  candidates := usersInDeletionCooldown({})

  for item := range candidates.nodes() {
    emitReminder := if addDuration(item.payload.deletionScheduledAt, "P25D") < now && addDuration(item.payload.deletionScheduledAt, "P26D") >= now {
      publishEvent({
        topic: "identity.deletion.reminder",
        payload: {
          userId: item.id,
          email: item.payload.primaryEmail,
          deletionScheduledAt: item.payload.deletionScheduledAt,
          milestoneDays: 25,
          subject: "Final notice: your <BRAND_NAME> account will be deleted in 5 days",
          timestamp: now
        }
      })
    }
  }

  return candidates.count()
  }
}

// accountDeletionReminder7Days
// =============================
//
// Daily 09:00 UTC sweep that emits a reminder event for each user
// roughly 7 days into their deletion cooldown so the user has a
// clear chance to cancel before the cooldown elapses (typically a
// 30-day window, configurable via MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS).
//
// The 7-day window is bracketed [P7D, P8D) on deletionScheduledAt:
// a row whose deletionScheduledAt was approximately 7 days ago lands
// in this run. The 25-day reminder uses [P25D, P26D). One-day
// brackets, fired daily, mean each user gets exactly one reminder
// at each milestone (no duplicates, no gaps).
//
// Email delivery: there is no `integration.email.sendEmail` builtin
// exposed in the DSL today (the Go integration registers the
// capability but no `(Builtin)` definition surfaces it). This
// automation publishes an `identity.deletion.reminder` event with
// the user's email + remaining-cooldown details; the
// component/server / app/integrations_identity wiring is expected
// to subscribe and call the email integration's Sender directly.
// When a builtin email send lands in DSL, swap publishEvent for a
// direct call.
//
// Brand-name interpolation TODO: the subject string is literal
// "<BRAND_NAME>" today; the consumer of the published event
// should substitute the actual brand at delivery time.
//
// MemQL parser limitation: filter expressions can't push the
// addDuration windowing down (the planner rejects function-call
// literals in filter comparisons), so windowing happens per-row
// inside the loop.
@description("Daily 09:00 UTC sweep that emits an 'identity.deletion.reminder' event for each user 7-8 days into their deletion cooldown so they can cancel before the cooldown elapses. Bracket [P7D, P8D) on deletionScheduledAt fired daily means exactly one reminder per user at this milestone. Email delivery is consumed by the component/server subscriber.")
logic accountDeletionReminder7Days {
  args {
    event object @required
  }
  body {
  candidates := usersInDeletionCooldown({})

  for item := range candidates.nodes() {
    // Window: deletionScheduledAt is between 7 and 8 days ago.
    // Equivalent: scheduledAt + P7D < now AND scheduledAt + P8D >= now.
    emitReminder := if addDuration(item.payload.deletionScheduledAt, "P7D") < now && addDuration(item.payload.deletionScheduledAt, "P8D") >= now {
      publishEvent({
        topic: "identity.deletion.reminder",
        payload: {
          userId: item.id,
          email: item.payload.primaryEmail,
          deletionScheduledAt: item.payload.deletionScheduledAt,
          milestoneDays: 7,
          subject: "Your <BRAND_NAME> account will be permanently deleted soon",
          timestamp: now
        }
      })
    }
  }

  return candidates.count()
  }
}

// accountDeletionSweep
// =====================
//
// Daily 03:00 UTC sweep. For each active user with deletionScheduledAt
// set whose cooldown (MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS, default 30) has
// elapsed:
//
//   1. Soft-delete the user row + scrub PII (deleteUserHard).
//   2. Revoke every active auth session for the user's JWT subject so
//      any in-flight tokens stop authorizing.
//
// What this cron does NOT touch (intentional gaps):
//
//   - v1:identity:auditEvent rows: kept for the trail. The
//     audit-event rows already capture point-in-time email/role on
//     each entry, so they remain readable post-deletion. (User-id
//     foreign keys on audit rows still resolve to the tombstoned
//     user row.)
//   - v1:identity:invitation rows the user issued: kept for the
//     same reason -- audit trail.
//   - v1:identity:accessRequest rows the user originated as an
//     admin reviewer: kept for the trail.
//   - v1:identity:identity rows (the credential records): NOT
//     scrubbed today. A future enhancement should iterate the
//     user's identities and call a `mutationScrubIdentity` to
//     blank credentials (oauth tokens, key hashes, etc.); no
//     such mutation exists yet, and inventing one without a
//     concept-side @scrub annotation would risk leaving stale
//     credential data on disk. Tracked as a follow-up.
//
// MemQL parser limitations:
//
//   - The filter side of usersScheduledForDeletion can't push
//     the cooldown math into the query (see that file's header).
//     Per-row gating uses
//       addDuration(item.payload.deletionScheduledAt, "P{cooldown}D") < now
//   - There's no batch-update path; we revoke sessions one row at a
//     time inside the loop.
@description("Pure decide for the account-deletion sweep: returns every user scheduled for deletion. The cooldown-var read, the per-row window gate (deletionScheduledAt + P{N}D < now), and the deleteUserHard write live in the accountDeletionSweep automation's window + forEach steps (#2235; date-window gate evaluated correctly since #2256/#2254). Audit-event rows, invitations the user issued, and access-request rows are intentionally retained for the trail.")
logic accountDeletionSweep {
  args {
    event object @required
  }
  body {
  candidates := usersScheduledForDeletion({})

  // Auth-session revocation gap (intentional): the user concept holds
  // user.id, but authSessionsForSubject is keyed on the JWT
  // `sub` claim (the canonical v1:identity:user.id our identity
  // service issues). There is no query today that returns sessions
  // by userId expansion, and no helper to enumerate all sub claims
  // for a user. Session expiry on its own retires the row
  // eventually, so the worst case is a deleted user's bearer token
  // continues to authenticate until its JWT expires.
  //
  // When a queryAuthSessionsForUser (or an "expand identities for
  // user" helper) lands, add a second forEach apply step in the
  // accountDeletionSweep automation that revokes each session via
  // revokeAuthSession.
  return candidates.nodes()
  }
}

// auditEventRetentionSweep
// =========================
//
// Daily 02:00 UTC sweep that walks audit-event rows older than
// MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS. The intent is rotation-grade
// retention (typically 90-365 days for compliance).
//
// Note (intentional gap): MemQL has no row-removal mutation today
// (the AST defines only Insert and Update). Soft-deleting an audit
// event by `update(active=false)` is also a non-starter -- the
// AuditEvent concept doesn't carry an `active` field, and adding
// one would weaken the "append-only" guarantee that's the whole
// point of an audit log.
//
// So this cron is wired but currently emits a "would-expire N rows"
// publishEvent for observability only; no row state changes. When
// either:
//
//   (a) the engine grows a `delete()` mutation kind, or
//   (b) a deliberate `tombstoned: true` field lands on AuditEvent
//       (with the audit semantics it implies),
//
// flip this cron to call the corresponding mutation per row inside
// the for-loop. The query side
// (expiredAuditEvents) is stable either way.
//
// Per-row windowing uses addDuration on item.payload.occurredAt
// against `now`, same as accessRequestExpirySweep -- MemQL
// can't push that into the filter today.
@description("Daily 02:00 UTC sweep over v1:identity:auditEvent rows older than MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS. Observation-only today: emits an 'identity.audit.retention.observed' event with the candidate count -- MemQL has no delete() mutation and AuditEvent's append-only semantics forbid soft-delete via active=false. Per-row delete lands when one of those gaps closes.")
logic auditEventRetentionSweep {
  args {
    event object @required
  }
  body {
  allEvents := expiredAuditEvents({})
  retentionDays := globalVariable({ name: "MEMQL_IDENTITY_AUDIT_LOG_RETENTION_DAYS" })

  // Count how many rows would be deleted under the configured
  // retention. The publishEvent emits one observation per cron
  // tick so the operator can see the candidate-row count over time.
  // No per-row state change today -- see header note.
  emitObservation := publishEvent({
    topic: "identity.audit.retention.observed",
    payload: {
      candidateCount: allEvents.count(),
      retentionDays: coalesce(retentionDays.first().payload.value, "365"),
      timestamp: now
    }
  })

  return allEvents.count()
  }
}

// magicLinkExpirySweep
// =====================
//
// Hourly sweep that finds magic-link requests whose expiresAt is in
// the past and marks them consumed-as-expired so the row is
// idempotent against any subsequent click and the storage stays
// compact.
//
// Path detail. There is no row-removal mutation in MemQL today
// (Insert and Update only), so "tombstoning" the row uses the
// existing consumeMagicLinkRequest. The handler that
// processes /auth/magic-link/consume already rejects rows with
// non-empty consumedAt; stamping consumedAt on already-expired rows
// here is a belt-and-suspenders guard:
//
//   - A user click after expiry would have rejected on the
//     `expiresAt < now` check anyway -- consumedAt isn't gating it.
//   - But marking the row consumed turns the row into an
//     uninteresting "spent" entry in any future audit query, which
//     is the right semantic.
//
// The cron runs hourly (vs. expireGuestInvitations's 30s) because
// magic-link TTLs are minutes-to-an-hour and the consume path's
// own expiresAt check makes the sweep's tightness irrelevant. If
// the operator wants tighter cleanup, bump the cadence here.
//
// The `now` cutoff is passed in as an arg (rather than referencing the clock inline)
// because the memQL query planner rejects function-call literals
// in filter comparisons.
@description("Hourly sweep that stamps consumedAt + consumedFromIP='system:expiry' on v1:identity:magiclink rows whose expiresAt is in the past, so the row reads as 'spent' in audit queries and any subsequent click is idempotently rejected by the consume handler's own expiresAt guard.")
logic magicLinkExpirySweep {
  args {
    event object @required
  }
  body {
  return expiredMagicLinkRequests({ now: now })
  }
}

// onDelegationCreated
// ===================
//
// Emits a delegation.created event when a new delegation is created.
// Used for audit logging and downstream event processing.
@description("Emits a 'delegation.created' event when a new v1:identity:delegation row lands. Carries the delegation id + identity / agent / role / scope fields for audit logging and downstream event processing.")
logic onDelegationCreated {
  args {
    event object @required
  }
  body {
  emitEvent := publishEvent({
    topic: "delegation.created",
    payload: {
      delegationId: args.event.node.id,
      args.event.node.payload.identityId,
      args.event.node.payload.identitySubject,
      args.event.node.payload.identityType,
      args.event.node.payload.agentId,
      args.event.node.payload.roleCeiling,
      args.event.node.payload.scopes,
      args.event.node.payload.createdBySubject,
      timestamp: now
    }
  })
  return emitEvent
  }
}

// ---- logic/v1/identity/revokeExpiredDelegations.memql ----

// revokeExpiredDelegations
// =============================
//
// Queries every active delegation whose expiresAt is in the past, then
// soft-revokes each one with `system:expiry` as the revoker. Returns the
// number of rows processed so the caller can surface a count.
//
// `now` is passed by the caller (the automation step computes
// `now` so the query receives a plain RFC3339 string) because
// the memQL query planner doesn't accept function-call literals in
// comparison expressions yet.

@enabled
@description("Find every expired active delegation and soft-revoke it with `system:expiry` as the revoker. Returns the count processed.")
logic revokeExpiredDelegations {
  args {
    now string @required
  }
  body {
    return expiredActiveDelegations({ now: args.now })
  }
}

// accessRequestExpiryWindow -- pure read of the access-request expiry window
// global variable for the accessRequestExpirySweep automation's per-row date
// gate (#2235). Returns the v1:platform:globalVariable row.
@enabled
@description("Pure read: returns the IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS global variable row for the accessRequestExpirySweep automation's per-row window gate (#2235).")
logic accessRequestExpiryWindow {
  args {
    event object @required
  }
  body {
  return globalVariable({ name: "IDENTITY_ACCESS_REQUEST_EXPIRY_DAYS" })
  }
}

// accountDeletionWindow -- pure read of the deletion-cooldown window global
// variable for the accountDeletionSweep automation's per-row date gate
// (#2235). Returns the v1:platform:globalVariable row.
@enabled
@description("Pure read: returns the MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS global variable row for the accountDeletionSweep automation's per-row window gate (#2235).")
logic accountDeletionWindow {
  args {
    event object @required
  }
  body {
  return globalVariable({ name: "MEMQL_IDENTITY_DELETION_COOLDOWN_DAYS" })
  }
}
