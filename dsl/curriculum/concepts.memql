// concepts.memql
//
// Concepts in the curriculum namespace.

@version("1.0.0")
@namespace("curriculum")
@visibility("bff")
@description("A guided lesson plan that an agent with the app-control tool set can run. Consumed by the CoPresent Operator on the client and executed segment by segment. The first consumer is the first-login demo (`copresent.welcome.v1`); future consumers are education agents running lessons against CoPresent or other apps.")
concept curriculum {
  slug  string  @required  @description("Stable machine-readable identifier (e.g., 'copresent.welcome.v1'). Used by the client to subscribe to a specific curriculum irrespective of the node ID.")

  name  string  @required  @description("Human-readable title shown to the user.")

  description  string  @description("Short summary shown to the user and used when presenting curriculum options in an authoring UI.")

  version  int  @required  @default("1")  @description("Monotonically increasing version. Onboarding records pin the version at start so an edit does not disrupt an in-flight session.")

  entrySegmentId  string  @required  @description("ID of the segment this curriculum starts with.")

  requiredScopes  []string  @required  @description("Tool scopes this curriculum's segments may use (e.g. 'read', 'navigate', 'highlight', 'create', 'update', 'identity'). The Operator rejects any tool call whose scopes are not in this set. Scopes are the inner defense-in-depth layer on top of the global tool deny-list.")

  locales  []string  @description("Locale codes this curriculum's content is available in (e.g. 'en-US', 'es-MX'). Used by the client to pick the right variant.")

  purpose  enum("onboarding", "help", "education", "other")  @default("onboarding")  @description("What kind of experience this is. Drives where / when the curriculum is surfaced.")

  active  bool  @default("true")  @description("Whether this curriculum is available to be run.")
}

@version("1.0.0")
@namespace("curriculum")
@visibility("bff")
@description("One step in a v1:curriculum:curriculum. Carries the GA's narration, the tool calls the GA should consider making, and the options the user can pick to advance the graph. Authoring model is hybrid: a segment has a `goal` and a set of `recommendedSteps` the GA follows by default but may deviate from based on runtime context (e.g., user already created a space, user asked a side question, user is confused). Options carry an explicit `nextSegmentId` when the author knows the route, or a `roleTag` the GA resolves to a concrete target at runtime.")
concept segment {
  curriculumId  string  @required  @description("ID of the v1:curriculum:curriculum this segment belongs to.")

  slug  string  @required  @description("Stable identifier within the curriculum (e.g., 'greeting', 'tour-spaces'). The entry / option edges reference segments by slug, not node ID, so authoring can move things around without rebinding edges.")

  goal  string  @required  @description("What the GA should accomplish in this segment, expressed for the LLM. Drives deviation decisions when the recommendedSteps don't fit the moment.")

  narration  string  @required  @description("The base narration text. In text mode it is rendered in the presenter card; in voice/avatar modes it is synthesized by TTS. The GA may paraphrase or expand as long as it stays on-goal.")

  recommendedSteps  string  @description("JSON array of {name, arguments} tool calls the GA should consider running when the segment is entered. Example: [{\"name\":\"ui.highlight\",\"arguments\":{\"target\":\"nav.spaces\",\"hint\":\"Spaces\"}}]. Ordered. The GA is expected to run these by default and skip / reorder / augment only with clear reason.")

  options  string  @required  @description("JSON array of {id, label, shortcutKey?, nextSegmentSlug?, roleTag?} option descriptors. Rendered as A/B/C buttons in text mode; spoken / listened-for in voice mode. At least one option must exist (even if it's just 'Continue') so the flow can advance. roleTag values: 'advance' | 'deeper' | 'skip' | 'back' | 'end'.")

  acceptsFreeForm  bool  @default("true")  @description("Whether the user can type / speak a free-form question on this segment. If true, the GA handles it in-place (answers, then returns to options). If false, the segment is strictly option-driven.")

  successCondition  string  @description("Natural-language description of when this segment is 'done'. Used by the GA's judgment when it decides to force-advance or hold. Example: 'User has provided a preferred name or chosen to skip.'")

  orderHint  int  @description("Optional ordering hint for authoring UIs and progress indicators. Not used at runtime for routing (that's the option graph).")

  @relationship(type="parent", field="curriculumId", target="v1:curriculum:curriculum", direction="outgoing")
}
