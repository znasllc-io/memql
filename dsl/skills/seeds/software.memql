/// Reviewed software-development baseline. Technology-specific details live in
/// specialty skills and Training lessons, never in the goal harness.
seed skill software-development {
  slug: "software-development"
  name: "Software development"
  description: "Investigate, implement, verify and deliver changes while preserving unrelated work."
  category: "engineering"
  tags: ["software", "baseline"]
  domainIds: ["software-development", "research-methodology"]
  toolSlugs: ["inspectRepositoryAuthority", "requestRepositoryChange", "repositoryChangeRequestStatus", "listRepositoryChangeRequests"]
  liveSourceIds: []
  tier: "A"
  predefined: true
  active: true
  status: "active"
  version: 4
  instructions {
    selectionTerms: ["software", "code", "fix", "bug", "implement", "refactor", "repository", "regression", "PR", "merge"]
    summary: "Discover the affected sources, reproduce the problem, make the smallest complete change and verify the delivered tree."
    body: "Resolve the application and affected sources before editing. Use the caller-visible connected source records, repository connections and native pipeline metadata first; follow verified package, application, repository and dependency links across repositories when the change requires it. A pipeline is useful context, not a requirement. An empty workspace is not evidence that source is unavailable. If connected records do not resolve the source, inspect authorized application or release provenance, official documentation, existing task receipts and permitted repository discovery. Verify the repository identity and relevant files; never guess a remote or search personal directories without permission. Make a bounded attempt before asking the person, and ask only for the unresolved application or source choice in ordinary language. Record the mapping and uncertainty for later sections. For a connected repository with a configured authority route, inspectRepositoryAuthority and requestRepositoryChange establish the bound execution and any maintainer approval. A pending upstream request never permits edits through another tool; preserve its request and goal links and continue independent authorized work. Local roles and source visibility do not confer upstream write access. Read repository instructions and inspect existing work before editing. Record the goal, constraints, decisions, completed actions and approvals in durable task context. Preserve unrelated edits. Before integration, retain an explicitly identified recovery point covering all intended work; include relevant untracked or binary files when a text patch is insufficient. Avoid relying on an unnamed shared stash entry when other sessions can change it. Tie further exploration to a named uncertainty and the next missing deliverable, then produce the smallest useful draft that can be verified. Choose focused reads when exact files or symbols are known; listings, full reads and bounded archive searches are reasonable when they resolve an actual knowledge gap. User authorization and worker capability or policy are separate gates; check supported contracts when available and preserve both gates. For a defect, demonstrate a behavioral regression that fails before the fix and passes after it. Run the checks appropriate to the changed boundary; a skipped check is not a pass. Check upstream at meaningful boundaries, particularly before integration and publication. Resolve conflicts by retaining both intended changes, then test the combined tree. Respond to review feedback against the current commit. Publish and merge only within explicit authority and passing required checks. For UI work, load the repository design guidance, use the harness computer or browser capabilities to capture and inspect the actual UI before and after, and exercise the changed interactions, keyboard access and relevant layouts. Source inspection alone is not visual verification. Follow declared dependency pins and delivery order across affected repositories. Use configured native CI, verify its exact commit and preserve each merge receipt before claiming delivery. Keep repository checkouts, worktrees, dependencies and caches as bounded reusable workspace resources, not blob artifacts. Retain relevant changed files or patches, useful scripts, reports, screenshots and command or CI receipts in the goal journal and artifact store with provenance; record size limits, omissions and failed transfers. Verify retained evidence is readable before cleaning up only resources created for this task. If a prerequisite remains unavailable, use the required-feedback tool to pause instead of returning a question as a successful section or continuing dependent work. A successful task may suggest a lesson; it does not prove that lesson applies generally."
    references: []
  }
}

/// A specialty in the existing capability graph, not a separate skill type.
seed skill distributed-systems {
  slug: "distributed-systems"
  name: "Distributed systems"
  description: "Reason about replica-local state, concurrency, retries and recovery across hosts."
  category: "engineering"
  tags: ["software", "distributed-systems"]
  domainIds: ["software-development", "eng-software-architecture"]
  toolSlugs: []
  liveSourceIds: []
  tier: "A"
  predefined: true
  active: true
  status: "active"
  version: 1
  instructions {
    selectionTerms: ["distributed", "replica", "concurrent", "concurrency", "checkpoint", "retry", "recovery", "lock"]
    summary: "Locate state and authority at every hop; verify behavior on another host."
    body: "For each operation, identify which node owns the state and which node needs it. Carry required context through explicit protocol fields or durable records. Use shared coordination for concurrent updates and content-bound approvals for exact effects. Make retries idempotent or reconcile uncertain outcomes before repeating an effect. Test a receiver without the originating process memory. Exercise interruption and restoration with completed effects preserved. A single-process test cannot establish cross-replica correctness."
    references: []
  }
}

seed skill regression-testing {
  slug: "regression-testing"
  name: "Testing"
  description: "Build independent behavioral evidence before and after a change."
  category: "engineering"
  tags: ["software", "testing"]
  domainIds: ["software-development"]
  toolSlugs: []
  liveSourceIds: []
  tier: "A"
  predefined: true
  active: true
  status: "active"
  version: 1
  instructions {
    selectionTerms: ["test", "tests", "testing", "regression", "bug", "defect", "verify", "check", "checks"]
    summary: "A regression must fail for the defect, then pass with the fix."
    body: "Derive the expected behavior from the user contract and an independent oracle. Run the new regression against the original implementation and retain the failure evidence. Compilation errors, unavailable infrastructure and skipped cases do not establish the defect. Verify the fixed tree with the same case and relevant neighboring checks. Exercise real boundaries such as persistence, authorization and replica hops when they affect the change. Keep actual measurements distinct from estimates and missing data. Never alter a test to conceal an unresolved behavioral failure."
    references: []
  }
}

