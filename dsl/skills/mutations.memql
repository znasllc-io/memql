// mutations.memql
//
// Writes over the skill catalog and its edges, moved out of the agents
// namespace in epic A1. mintSkill and createSkill keep their names and
// their gates; the two edge mutations are new.

/// Mint a new v1:skills:skill catalog row from a Planner Agent mintSkill action (Phase 3 /
/// memql#159). The caller is the planner integration; it has already run the authority gate
/// (action='mintSkill' on the planner's agentAuthorization + tier in skillTierAllowlist) and the
/// catalog-search heuristic (no existing skill covers >60% of the requested bundle) before invoking
/// this. predefined is hard-stamped false -- the runtime mint surface is for user-/planner-created
/// rows only; the predefined catalog stays in dsl/agents/skills/*.memql. originatingPlanId +
/// mintedByAgentId carry the Phase 3 provenance triad. Server-side enforcement: the tier-validation
/// rule from Phase 1 still applies (skill.tier >= max(domain tier)) -- a mint that violates it
/// rejects with the same error path as the load-time check.
mutate skill mintSkill {
  args {
    skillId            string
    slug               string!
    name               string!
    description        string
    category           string
    tags               array
    domainIds          array
    toolSlugs          array
    liveSourceIds      array
    tier               string!
    instructions       object
    scripts            array
    resources          array
    constructRefs      array
    effects            object
    originatingGoalId  string
    mintedByRunId      string
  }
  insert {
    id: args.skillId ?? args.slug
    args.slug
    args.name
    args.description
    category: args.category ?? "specialized"
    tags: args.tags ?? []
    domainIds: args.domainIds ?? []
    toolSlugs: args.toolSlugs ?? []
    liveSourceIds: args.liveSourceIds ?? []
    args.tier
    predefined: false
    active: true
    instructions: args.instructions ?? {}
    scripts: args.scripts ?? []
    resources: args.resources ?? []
    constructRefs: args.constructRefs ?? []
    effects: args.effects ?? {}
    version: 1
    // CANDIDATE, hard-stamped, for the same reason predefined is hard-stamped
    // false: a freshly minted skill has proved nothing, and letting the mint
    // caller declare itself `active` would let the ladder be skipped by the
    // one path that most needs it.
    status: "candidate"
    args.originatingGoalId
    args.mintedByRunId
  }
}

/// Materialize a v1:skills:skill catalog row from a `seed skill ...` declaration under
/// dsl/agents/skills/*.memql. Matches the SeedMaterializer's `mutationCreate<Concept>` naming
/// convention -- the materializer stamps the seed body's id into `skillId` and forwards every other
/// seed body field as a same-named arg, so this mutation's arg surface mirrors the on-disk seed
/// body 1:1. Sibling to `mintSkill`: same row shape, but the seed path is for the predefined
/// catalog (predefined defaults true) and carries no originatingPlanId / mintedByAgentId provenance
/// triad. Was missing pre-#344, which made every skill seed in the bundled catalog fail to
/// materialize with `function "createSkill" not found`. The materializer convention itself lives in
/// component/memql/seed_materializer.go.
mutate skill createSkill {
  args {
    skillId        string
    slug           string!
    name           string!
    description    string
    category       string
    tags           array
    domainIds      array
    toolSlugs      array
    liveSourceIds  array
    tier           string!
    predefined     bool
    active         bool
    instructions   object
    scripts        array
    resources      array
    constructRefs  array
    effects        object
    version        int
    status         string
  }
  insert {
    id: args.skillId ?? args.slug
    args.slug
    args.name
    args.description
    category: args.category ?? "specialized"
    tags: args.tags ?? []
    domainIds: args.domainIds ?? []
    toolSlugs: args.toolSlugs ?? []
    liveSourceIds: args.liveSourceIds ?? []
    args.tier
    predefined: args.predefined ?? true
    active: args.active ?? true
    instructions: args.instructions ?? {}
    scripts: args.scripts ?? []
    resources: args.resources ?? []
    constructRefs: args.constructRefs ?? []
    effects: args.effects ?? {}
    version: args.version ?? 1
    // ACTIVE by default, which is the one place the seed path and the mint
    // path differ on the ladder: a row somebody shipped in the tree is the
    // catalog, and making an operator promote the thing they just installed
    // would be a ceremony with one right answer.
    status: args.status ?? "active"
  }
}

/// Propose an edge. @serverOnly: an edge is EVIDENCE that two skills relate, gathered from runs the
/// engine executed, so a caller-written one is a claim about executions the caller did not observe.
/// actor.userId scoping does not help -- the concept is public-tier by design, so there is no owner
/// conjunct to narrow by, and narrowing it would hide the catalog it exists to describe.
@serverOnly
@actor
mutate skillEdge createSkillEdge {
  args {
    edgeId       string!
    fromSkillId  string!
    toSkillId    string!
    edgeType     string!
    evidence     []object
    proposedBy   string!
  }
  insert {
    accept { fromSkillId, toSkillId, edgeType, evidence, proposedBy }
    stamp {
      id: args.edgeId
      ownerUserId: actor.userId
      status: "proposed"
    }
  }
}

/// Commit a proposed edge after a successful run. @serverOnly for createSkillEdge's reason: only the
/// run knows it succeeded, and a public-tier concept has no actor.userId conjunct to scope by.
@serverOnly
mutate skillEdge commitSkillEdge {
  args {
    edgeId    string!
    evidence  []object
  }
  update {
    accept { evidence }
    stamp {
      id: args.edgeId
      status: "committed"
    }
  }
}

/// Rewrite a skill's `scripts[]`. @serverOnly: the list names the EXECUTABLES a skill may ship to a
/// workbench or to somebody's own machine, so a client-reachable write is a primitive for pointing
/// any skill at any artifact and having the platform run it under the caller's fleet scope. Scoping
/// by actor.userId does not help and would make it worse -- the concept is public-tier by design so
/// there is no owner conjunct to narrow by, and the predefined catalog every person's agents read
/// has a present-and-empty owner, which no caller matches. The one writer is capture
/// (integrations/skills/capture.go), which reads the bytes off a surface the caller already reached
/// and files them in the Library first.
///
/// TAKES THE FULL LIST, like appendLibraryFileTrainedDomain and for the same reason: MemQL has no
/// array append, so a caller sending one entry would clobber whatever another run captured
/// concurrently. Capture reads, merges by platform and writes back.
@serverOnly
mutate skill setSkillScripts {
  args {
    skillId  string!
    scripts  array
  }
  update {
    id: args.skillId
    scripts: args.scripts ?? []
  }
}

/// Move a skill along the trust ladder. @serverOnly: reliability is EVIDENCE gathered from runs the
/// engine executed, so a caller-written value is a claim about executions the caller did not
/// observe -- the same reasoning createSkillEdge carries, and the same non-answer applies, because
/// scoping by actor.userId cannot narrow a public-tier catalog whose rows are the deployment's.
///
/// The caller computes the new value rather than sending a delta. Reliability decays on disuse as
/// well as climbing on success, so "add 0.05" is not expressible as one write, and a read-modify-
/// write in the caller is what lets the ladder's rule live in one readable place instead of being
/// split between a mutation and its callers.
@serverOnly
mutate skill reinforceSkill {
  args {
    skillId         string!
    reliability     float!
    reinforceCount  int!
    lastReinforced  string
    status          string
  }
  update {
    id: args.skillId
    args.reliability
    args.reinforceCount
    args.lastReinforced
    args.status
  }
}
