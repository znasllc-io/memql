// shapes.memql
//
// Projections over the skill catalog and its edges, moved out of the
// agents namespace in epic A1 (work spine sub-project A). Same-domain
// constructs are ambient, so there is no `use skills.*` line (#2617).

/// Lightweight skill projection: slug + display + tier + tags. Backs catalog list / picker surfaces
/// where the caller doesn't yet need the domain / tool composition. Faster + smaller than skillFull
/// so the cockpit's Skills admin list and the role-edit picker don't pay for the bundle payload
/// until the user expands a row.
@row
shape skill skillSummary {
  row.id
  slug
  name
  description
  tier
  tags
  category
  predefined
  active
  status
  reliability
}

/// Full skill projection: the catalog row, its bundle composition, everything epic A3 grew it with,
/// and its mint provenance. Backs the Skills admin detail view, the mint candidate read, the agent
/// factory's attach path, structural retrieval's candidate load and runScript's script resolution.
///
/// KEEPS EVERYTHING INLINE, deliberately: a single read fully describes what binding this skill
/// will do -- which domains and tools it grants, which scripts it can run, which constructs it
/// contributes, what it declares it touches, and how far it has earned trust. `skillSummary` is
/// the projection for a list; this is the one for a decision, and a decision made from half the
/// row is what a second read would be for.
///
/// `instructions` is projected WHOLE rather than tier by tier. The three-tier disclosure is a
/// rule about what a PROMPT carries, not about what a read returns -- splitting it here would put
/// the tiering in two places, and the one that mattered would be the one nobody updated.
@row
shape skill skillFull {
  row.id
  slug
  name
  description
  category
  tags
  domainIds
  toolSlugs
  liveSourceIds
  tier
  predefined
  active
  instructions
  scripts
  resources
  constructRefs
  effects
  version
  reliability
  reinforceCount
  lastReinforced
  status
  originatingGoalId
  mintedByRunId
  row.createdAt
  row.createdBy
}

/// Every edge field. The edges are how selection reads the capability graph structurally rather
/// than by vector match alone (spec section C).
@row
shape skillEdge skillEdgeFull {
  row.id
  row.createdAt
  ownerUserId
  fromSkillId
  toSkillId
  edgeType
  evidence
  proposedBy
  status
}
