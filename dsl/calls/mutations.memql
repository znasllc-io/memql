    stamp {
      id: args.policyId
      ownerUserId: actor.userId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Update a policy row (read-merge-validate-write). @serverOnly for createCallsPolicy's reason. Only the fields that change over a policy's life are accepted: its site, owner and digests never move. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
