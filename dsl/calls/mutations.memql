/// First passkey claim of an unclaimed guest key, under the shared account gate. The browser session authorizes this, never key text; actor.userId alone is not the gate.
@serverOnly
mutation key claimCallsKey {
  args {
    keyId string!
    versionTime datetime
    digest string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
    userHandle string!
    keySuffix string!
  }
  update {
    accept { digest, userHandle, keySuffix }
    stamp { id: args.keyId, createdAt: args.versionTime ?? now }
  }
}

/// Atomic local-simulation state and immutable receipt. actor.userId scoping is not the fix: only internal-origin calls reach this construct.
