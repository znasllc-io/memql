/// Create a room row. @serverOnly: only the calls integration, having checked what the caller proved, writes it. `ownerUserId` is STAMPED from the actor (the site's owner) and is not an argument. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@actor
@serverOnly
mutation room createCallsRoom {
  args {
    messageProtocol string @maxLength(64)
    usageConfig string
    usageOperation string
    usageDigest string
    usageReservedCents int
    usageMeter string
    usageCostCents int
    fundingMode enum("usage_preview", "usage_metered_preview")
    fundingPassId string
    fundingStartedAt datetime
    fundingDeadline datetime
    fundingMaxPeople int
    historyPending bool
    title  string @maxLength(2048)
    roomId  string!
    versionTime  datetime
    siteId  string!
    deployable  string
    keyId  string
    mediaServerId  string
    mediaRoom  string
    status  string
    locked  bool
    hostSeatId  string
    scheduledCallId  string
    guestDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")
    hostDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")
    openedAt  datetime
    joinWindowStartedAt  datetime
    joinWindowCount  int
  }
  insert {
    accept { messageProtocol, usageConfig, usageOperation, usageDigest, usageReservedCents, usageMeter, usageCostCents, fundingMode, fundingPassId, fundingStartedAt, fundingDeadline, fundingMaxPeople, historyPending, title, siteId, deployable, keyId, mediaServerId, mediaRoom, locked, hostSeatId, scheduledCallId, guestDigest, hostDigest, openedAt, joinWindowStartedAt, joinWindowCount }
    stamp {
      id: args.roomId
      ownerUserId: actor.userId
      status: args.status ?? "open"
      createdAt: args.versionTime ?? now
    }
  }
}

