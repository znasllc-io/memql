/// Create a scheduledCall row. @serverOnly: only the calls integration, having checked what the caller proved, writes it. `ownerUserId` is STAMPED from the actor (the site's owner) and is not an argument. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@actor
@serverOnly
mutation scheduledCall createCallsScheduledCall {
  args {
    scheduledCallId  string!
    versionTime  datetime
    siteId  string!
    keyId  string
    start  datetime
    end  datetime
    title  string
    status  string
    guestDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")
    hostDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")
    calendarUid  string @maxLength(320)
  }
  insert {
    accept { siteId, keyId, start, end, title, guestDigest, hostDigest, calendarUid }
    stamp {
      id: args.scheduledCallId
      ownerUserId: actor.userId
      status: args.status ?? "scheduled"
      createdAt: args.versionTime ?? now
    }
  }
}

/// Update a scheduledCall row (read-merge-validate-write). @serverOnly for createCallsScheduledCall's reason. Only the fields that change over a scheduledCall's life are accepted: its site, owner and calendar UID never move, and its two digests move only when a reschedule mints new links, which is what makes the old links open nothing. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
mutation scheduledCall updateCallsScheduledCall {
  args {
    scheduledCallId  string!
    versionTime  datetime
    start  datetime
    end  datetime
    title  string
    status  string
    roomId  string
    guestDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")
    hostDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")
  }
  update {
    accept { start, end, title, status, roomId, guestDigest, hostDigest }
    stamp {
      id: args.scheduledCallId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Create a mediaServer row. @serverOnly: only the calls integration, having checked what the caller proved, writes it. The row is the cluster's, so no owner is stamped. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
mutation mediaServer createCallsMediaServer {
  args {
    mediaServerId  string!
    versionTime  datetime
    provider  string
    apiUrl  string
    publicUrl  string
    region  string
    seats  int
    state  string
    credentialSecret  string
  }
  insert {
    accept { provider, apiUrl, publicUrl, region, seats, credentialSecret }
    stamp {
      id: args.mediaServerId
      state: args.state ?? "active"
      createdAt: args.versionTime ?? now
    }
  }
}

/// Update a mediaServer row (read-merge-validate-write). @serverOnly for createCallsMediaServer's reason. Only the fields that change over a mediaServer's life are accepted: its site, owner and digests never move. `provider` is among them because the bootstrap server is whatever the environment names, and an operator may move it to another provider. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
mutation mediaServer updateCallsMediaServer {
  args {
    mediaServerId  string!
    versionTime  datetime
    provider  string
    apiUrl  string
    publicUrl  string
    region  string
    seats  int
    state  string
    credentialSecret  string
  }
  update {
    accept { provider, apiUrl, publicUrl, region, seats, state, credentialSecret }
    stamp {
      id: args.mediaServerId
      createdAt: args.versionTime ?? now
    }
  }
}

