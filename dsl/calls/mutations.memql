/// Update a seat row (read-merge-validate-write). @serverOnly for createCallsSeat's reason. Only the fields that change over a seat's life are accepted: its site, owner, digests and the key its holder unlocked never move. Account-authorized recovery can rebind credentialId to that same key's currently authenticated credential. The three confirmations are among them because every join confirms again, a rejoin included, and the seat records what its latest join confirmed (a newer terms version above all); so are reconciliation's lastSeenAt and absentSince, and a host's letInAt. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
mutation seat updateCallsSeat {
  args {
    messageIdentity string @maxLength(128)
		 identity string
		 agentData string
    historyPending bool
    seatId  string!
    credentialId string
    versionTime  datetime
    displayName  string
    host  bool
    status  string
    confirmAdult  bool
    participation string
    authorityAccepted bool
    confirmNoMinors  bool
    termsVersion  string
    joinedAt  datetime
    departureReceipt string
    departureKeepRunning bool
    departureWrapUpAt datetime
    leftAt  datetime
    lastSeenAt  datetime
    absentSince  datetime
    letInAt  datetime
    waitingSince  datetime
  }
  update {
    accept { messageIdentity, identity, agentData, departureReceipt, departureKeepRunning, departureWrapUpAt, historyPending, credentialId, displayName, host, status, confirmAdult, confirmNoMinors, participation, authorityAccepted, termsVersion, joinedAt, leftAt, lastSeenAt, absentSince, letInAt, waitingSince }
    stamp {
      id: args.seatId
      createdAt: args.versionTime ?? now
    }
  }
}

