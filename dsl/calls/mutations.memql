@serverOnly
mutation simulatedWalletEntry createCallsSimulatedWalletEntry {
  args {
    entryId string!
    versionTime datetime!
    siteId string!
    keyId string!
    kind string!
    requestDigest string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
    balanceCents int!
    usageRemainderUnits int
    creditedCents int!
    debitedCents int!
    plan string
    passId string
    passPlan string
    passActivatedAt datetime
    passExpiresAt datetime
    passTotalSeconds int
    passDailySeconds int
    passMaxPeople int
  }
  insert {
    accept { siteId, keyId, kind, requestDigest, balanceCents, usageRemainderUnits, creditedCents, debitedCents, plan, passId, passPlan, passActivatedAt, passExpiresAt, passTotalSeconds, passDailySeconds, passMaxPeople }
    stamp { id: args.entryId, ownerUserId: actor.userId, createdAt: args.versionTime }
  }
}

