/// Create a seat row. @serverOnly: only the calls integration, having checked what the caller proved, writes it. `ownerUserId` is STAMPED from the actor (the site's owner) and is not an argument. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@actor
@serverOnly
mutation seat createCallsSeat {
  args {
    seatId  string!
    versionTime  datetime
    siteId  string!
    roomId  string!
    identity  string
    kind  string
    displayName  string
    host  bool
    status  string
    confirmAdult  bool
    confirmNoMinors  bool
    termsVersion  string
    joinedAt  datetime
    keyId  string
    waitingSince  datetime
  }
  insert {
    accept { siteId, roomId, identity, kind, displayName, host, status, confirmAdult, confirmNoMinors, termsVersion, joinedAt, keyId, waitingSince }
    stamp {
      id: args.seatId
      ownerUserId: actor.userId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Update a seat row (read-merge-validate-write). @serverOnly for createCallsSeat's reason. Only the fields that change over a seat's life are accepted: its site, owner, digests and the key its holder unlocked never move. The three confirmations are among them because every join confirms again, a rejoin included, and the seat records what its latest join confirmed (a newer terms version above all); so are reconciliation's lastSeenAt and absentSince, and a host's letInAt. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
mutation seat updateCallsSeat {
  args {
    seatId  string!
    versionTime  datetime
    displayName  string
    host  bool
    status  string
    confirmAdult  bool
    confirmNoMinors  bool
    termsVersion  string
    joinedAt  datetime
    leftAt  datetime
    lastSeenAt  datetime
    absentSince  datetime
    letInAt  datetime
    waitingSince  datetime
  }
  update {
    accept { displayName, host, status, confirmAdult, confirmNoMinors, termsVersion, joinedAt, leftAt, lastSeenAt, absentSince, letInAt, waitingSince }
    stamp {
      id: args.seatId
      createdAt: args.versionTime ?? now
    }
  }
}

