  insert {
    accept { siteId, deployable, keyId, mediaServerId, mediaRoom, locked, hostSeatId, scheduledCallId, guestDigest, hostDigest, openedAt, joinWindowStartedAt, joinWindowCount }
    stamp {
      id: args.roomId
      ownerUserId: actor.userId
      status: args.status ?? "open"
      createdAt: args.versionTime ?? now
    }
  }
}

