    usageRequests string
    usageConfig string
    usageOperation string
    usageDigest string
    historyPending bool
    scheduledCallId  string!
    versionTime  datetime
    start  datetime
    end  datetime
    title  string
    status  string
    roomId  string
    guestDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")
    hostDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")
  }
  update {
    accept { delegationId, usageRequests, usageConfig, usageOperation, usageDigest, historyPending, start, end, title, status, roomId, guestDigest, hostDigest }
    stamp {
      id: args.scheduledCallId
      createdAt: args.versionTime ?? now
    }
  }
}

