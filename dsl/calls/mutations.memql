// mutations.memql
//
// One create and one update per calls concept, all @serverOnly: the calls integration is the only writer,
// as the site's owner (borrowed authority), and a client that could write a row could mint its own key,
// pass or seat. Each takes `versionTime` and writes `createdAt: args.versionTime ?? now`, as
// dsl/work/mutations.memql does, so a caller replaying a journal keeps the version order it observed.
// There are no deletes: an end is a status or a timestamp, and retention removes the rows that expire.

/// Create a key row. @serverOnly: only the calls integration, having checked what the caller proved, writes it. `ownerUserId` is STAMPED from the actor (the site's owner) and is not an argument. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@actor
@serverOnly
mutation key createCallsKey {
  args {
    keyId  string!
    versionTime  datetime
    siteId  string!
    digest  string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
    userHandle string
    keySuffix string
    issuedAt datetime
    label  string
    kind  string
    status  string
  }
  insert {
    accept { siteId, digest, label, userHandle, keySuffix, issuedAt }
    stamp {
      id: args.keyId
      ownerUserId: actor.userId
      kind: args.kind ?? "test"
      status: args.status ?? "active"
      createdAt: args.versionTime ?? now
    }
  }
}

/// Update a key row (read-merge-validate-write). @serverOnly for createCallsKey's reason. Only the fields that change over a key's life are accepted: its site, owner and digests never move. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
mutation key updateCallsKey {
  args {
    keyId  string!
    versionTime  datetime
    label  string
    kind  string
    status  string
  }
  update {
    accept { label, kind, status }
    stamp {
      id: args.keyId
      createdAt: args.versionTime ?? now
    }
  }
}

