/// The native host gate reserves one effect before submitting to the mail provider.
/// actor.userId scoping is not the fix: @serverOnly retains the reservation authority.
@actor
@serverOnly
mutation invitationReceipt createCallsInvitation {
  args {
    invitationId string!
    siteId string!
    roomId string!
    status string!
    fingerprint string!
    attemptedAt datetime!
    retryAt datetime
    versionTime datetime
  }
  insert {
    accept { siteId, roomId, status, fingerprint, attemptedAt, retryAt }
    stamp {
      id: args.invitationId
      ownerUserId: actor.userId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Only the native sender may settle or safely retry its effect receipt.
/// actor.userId scoping is not the fix: @serverOnly keeps forged delivery states out.
@serverOnly
mutation invitationReceipt updateCallsInvitation {
  args {
    invitationId string!
    status string!
    fingerprint string!
    attemptedAt datetime!
    retryAt datetime
    versionTime datetime
  }
  update {
    accept { status, fingerprint, attemptedAt, retryAt }
    stamp {
      id: args.invitationId
      createdAt: args.versionTime ?? now
    }
  }
}

/// A native reservation creates the per-site rate budget under the site gate.
/// actor.userId scoping is not the fix: @serverOnly bars client-authored counters.
@actor
@serverOnly
mutation invitationBudget createCallsInvitationBudget {
  args {
    budgetId string!
    siteId string!
    minuteStartedAt datetime!
    minuteCount int!
    dayStartedAt datetime!
    dayCount int!
    versionTime datetime
  }
  insert {
    accept { siteId, minuteStartedAt, minuteCount, dayStartedAt, dayCount }
    stamp {
      id: args.budgetId
      ownerUserId: actor.userId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Native reservations update the budget under the same site gate on every replica.
/// actor.userId scoping is not the fix: @serverOnly bars resetting it from a client.
@serverOnly
mutation invitationBudget updateCallsInvitationBudget {
  args {
    budgetId string!
    minuteStartedAt datetime!
    minuteCount int!
    dayStartedAt datetime!
    dayCount int!
    versionTime datetime
  }
  update {
    accept { minuteStartedAt, minuteCount, dayStartedAt, dayCount }
    stamp {
      id: args.budgetId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Only the native active-host gate creates a room's guest alias, once, under its
/// room gate and an absent-row version fence. actor.userId scoping is not the fix:
/// @serverOnly withholds this capability minting authority from authored calls.
@actor
@serverOnly
mutation invitationLink createCallsInvitationLink {
  args {
    linkId string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
    siteId string!
    roomId string!
    versionTime datetime
  }
  insert {
    accept { siteId, roomId }
    stamp {
      id: args.linkId
      ownerUserId: actor.userId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Create verified public credential material. actor.userId alone is not the wire gate: serverOnly is.
@actor
@serverOnly
mutation credential createCallsCredential {
  args {
    credentialRowId string!
    versionTime datetime
    siteId string!
    keyId string!
    credentialDigest string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
    credentialData string!
    label string!
    addedAt datetime!
  }
  insert {
    accept { siteId, keyId, credentialDigest, credentialData, label, addedAt }
    stamp { id: args.credentialRowId, ownerUserId: actor.userId, createdAt: args.versionTime ?? now }
  }
}

/// Update counter or revocation under the credential and account gates. actor.userId alone is not the wire gate: serverOnly is.
@serverOnly
mutation credential updateCallsCredential {
  args {
    credentialRowId string!
    versionTime datetime
    credentialData string
    lastUsedAt datetime
    revokedAt datetime
  }
  update {
    accept { credentialData, lastUsedAt, revokedAt }
    stamp { id: args.credentialRowId, createdAt: args.versionTime ?? now }
  }
}

