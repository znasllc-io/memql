@cache(0)
query seat callsSeatById {
  args {
    id  string!
  }
  filter  row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsSeatFull
}

/// The seat rows of one parent, for the calls integration: seats of one room -- bounded by the room-size limits of the calls policy. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("seats of one room -- bounded by the room-size limits of the calls policy")
@actor
@cache(0)
query seat callsSeatsForRoom {
  args {
    roomId  string!
  }
  filter  row => row.roomId == args.roomId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsSeatFull
}

/// The seat rows of a set of rooms, for the calls integration: the seats of the open rooms on one media server, in one read rather than one per room. A reference field is stored canonical and a bare id compared with it matches nothing, so the ids are made canonical here. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("seats of the open rooms of one media server -- bounded by the room-size limits of the calls policy")
@actor
@cache(0)
query seat callsSeatsForRooms {
  args {
    roomIds  []string!
  }
  filter  row => row.roomId in args.roomIds.select(candidate => canonicalId(candidate, room)) && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsSeatFull
}

