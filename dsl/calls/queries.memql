  }
  filter  row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsScheduledCallFull
}

/// Resolve a scheduledCall by the SHA-256 digest of the secret presented, within ONE SITE: a secret minted for one of an owner's deployables resolves nothing at another, as siteAccessCodeByHash does. THE DIGEST IS THE ARGUMENT, never the secret: the plain secret exists in the caller's hand and nowhere else. An ended or expired row still answers; the calls integration decides the reply from the row and the clock. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("scheduledCall by digest -- a digest names one row and no two rows share one")
@actor
@cache(0)
query scheduledCall callsScheduledCallByGuestDigest {
  args {
    siteId  string!
    guestDigest  string!  @maxLength(64) @pattern("^[0-9a-f]{64}$")
  }
  filter  row => row.siteId == args.siteId && row.guestDigest == args.guestDigest && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsScheduledCallFull
}

/// Resolve a scheduledCall by the SHA-256 digest of the secret presented, within ONE SITE: a secret minted for one of an owner's deployables resolves nothing at another, as siteAccessCodeByHash does. THE DIGEST IS THE ARGUMENT, never the secret: the plain secret exists in the caller's hand and nowhere else. An ended or expired row still answers; the calls integration decides the reply from the row and the clock. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("scheduledCall by digest -- a digest names one row and no two rows share one")
@actor
@cache(0)
query scheduledCall callsScheduledCallByHostDigest {
  args {
    siteId  string!
    hostDigest  string!  @maxLength(64) @pattern("^[0-9a-f]{64}$")
  }
  filter  row => row.siteId == args.siteId && row.hostDigest == args.hostDigest && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsScheduledCallFull
}

/// One scheduledCall's two link digests, by its own id: the only read that returns a digest. The first join of a booked call copies them onto the room it opens, so both links find that room as they find an ad hoc call's, and the join holds only the link it presented (integrations/calls schedule.go). actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("scheduledCall digests by id -- bounded to a single row (id is the row's own primary key)")
@actor
@cache(0)
query scheduledCall callsScheduledCallDigestsById {
  args {
    id  string!
  }
  filter  row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsScheduledCallDigests
}

/// The bookings of one key that may still hold a slot of its time: not cancelled, not ended, and ending after now or started. What a new booking or a move is checked against, under the key's lock, and what counts toward the policy's maximum of upcoming bookings. A key's past, cancelled and ended bookings are never read, however many it made. A STARTED booking is read whatever its booked end, because a call running past its end still holds its slot until its room ends; the calls integration reads that room and decides (integrations/calls schedule.go upcoming). EVERY WAY A ROOM ENDS MARKS ITS BOOKING ENDED, in the same gated write that ends the room (its host ending it, the host-left countdown, the room emptying, reconciliation: integrations/calls host.go endRows), so a started booking leaves this read when its call ends and the read stays the key's open calls and its upcoming bookings. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("bookings of one key that may still hold a slot -- the upcoming ones the policy caps, plus the key's calls still open; ending a call marks its booking ended")
@actor
@cache(0)
query scheduledCall callsScheduledCallsForKey {
  args {
    keyId  string!
  }
  filter  row => row.keyId == args.keyId
              && row.status != "cancelled"
              && row.status != "ended"
              && (row.end > now || row.status == "started")
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsScheduledCallFull
}

/// One mediaServer row by its own id. The calls integration reads it before it writes, and to answer a request that names it. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("mediaServer by id -- bounded to a single row (id is the row's own primary key)")
@actor
@cache(0)
query mediaServer callsMediaServerById {
  args {
    id  string!
  }
  filter  row => row.id == args.id && actor.isClusterOwner == true
  shape   callsMediaServerFull
}

/// One policy row by its own id. The calls integration reads it before it writes, and to answer a request that names it. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("policy by id -- bounded to a single row (id is the row's own primary key)")
@actor
@cache(0)
query policy callsPolicyById {
  args {
    id  string!
  }
  filter  row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsPolicyFull
}

/// The media servers rooms may be placed on: every server whose state is active. Cluster-owned rows, read by the
/// calls integration as the cluster acting; actor.userId scoping is not the fix, as the rows have no owner.
@serverOnly
@actor
@unbounded("active media servers -- the fleet an operator runs, a handful of rows")
@cache(0)
query mediaServer callsActiveMediaServers {
  filter  row => row.state == "active" && actor.isClusterOwner == true
  shape   callsMediaServerFull
}

/// The media servers that may still carry calls: every server not removed. A draining server takes no new
/// call but carries the ones already on it, so reconciliation walks it as it walks an active one
/// (integrations/calls reconcile.go). Cluster-owned rows, read as the cluster acting; actor.userId scoping is
/// not the fix, as the rows have no owner.
@serverOnly
@actor
@unbounded("media servers not removed -- the fleet an operator runs, a handful of rows")
@cache(0)
query mediaServer callsMediaServersNotRemoved {
  filter  row => row.state != "removed" && actor.isClusterOwner == true
  shape   callsMediaServerFull
}

/// The limits of one site, within that site: a policy is per SITE, because a package deployable's name is unique only together with its package. Absent fields mean the shipped defaults (calls.DefaultPolicy). actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@actor
@unbounded("calls policy by site -- one row per site")
@cache(0)
query policy callsPolicyForSite {
  args {
    siteId  string!
  }
  filter  row => row.siteId == args.siteId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsPolicyFull
}

/// Internal effect receipt. actor.userId scoping is not the fix: the host session is
/// checked natively; @serverOnly keeps this service's borrowed authority off the wire.
@serverOnly
@unbounded("invitation by id -- one keyed digest identifies one receipt")
@actor
@cache(0)
query invitationReceipt callsInvitationById {
  args { id string! }
  filter row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape callsInvitationFull
}

/// At most twenty recipients may be invited per call. Twenty-one proves the cap is
/// exhausted. actor.userId scoping is not the fix: only the native host gate calls this.
@serverOnly
@actor
@cache(0)
query invitationReceipt callsInvitationsForRoom {
  args { roomId string! }
  filter row => row.roomId == args.roomId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  paginate 21
  shape callsInvitationFull
}

/// Internal per-site rate counters. actor.userId scoping is not the fix: only the
/// native host gate may read this row under borrowed authority.
@serverOnly
@unbounded("invitation budget by site id -- one row per site")
@actor
@cache(0)
query invitationBudget callsInvitationBudget {
  args { id string! }
  filter row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape callsInvitationBudgetFull
}

/// The token digest is the primary id, so a guessed invitation never scans rooms.
/// actor.userId scoping is not the fix: @serverOnly keeps this capability lookup off
/// the wire, and the native caller checks the alias's site and room bindings again.
@serverOnly
@unbounded("guest invitation by digest id -- one immutable alias per room")
@actor
@cache(0)
query invitationLink callsInvitationLinkById {
  args {
    id string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
    siteId string!
  }
  filter row => row.id == args.id && row.siteId == args.siteId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape callsInvitationLinkFull
}

/// Resolve one credential id for protocol verification. Only the cluster reads across sites; the service binds its site before use. actor.userId alone is not the wire gate: serverOnly is.
@serverOnly
@unbounded("credential digest is unique under the shared credential gate")
@actor
@cache(0)
query credential callsCredentialByDigest {
  args { credentialDigest string! @maxLength(64) @pattern("^[0-9a-f]{64}$") }
  filter row => row.credentialDigest == args.credentialDigest && actor.isClusterOwner == true
  shape callsCredentialFull
}

/// Resolve one credential row. actor.userId alone is not the wire gate: serverOnly is.
@serverOnly
@unbounded("credential primary id resolves at most one row")
@actor
@cache(0)
query credential callsCredentialById {
  args { id string! }
  filter row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape callsCredentialFull
}

/// Read a key's bounded active credential set. Revoked ids remain in the unique digest lookup. actor.userId alone is not the wire gate: serverOnly is.
@serverOnly
@unbounded("a key has at most 20 active credentials")
@actor
@cache(0)
query credential callsCredentialsForKey {
  args { keyId string! }
  filter row => row.keyId == args.keyId && row.revokedAt == "" && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape callsCredentialFull
}

/// Internal exact-id read. actor.userId scoping is not the fix: only internal-origin calls reach this construct.
@serverOnly
@actor
@cache(0)
query history callsHistoryById {
  args { id string! }
  filter row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  paginate 1
  shape callsHistoryFull
}

/// Internal exact-id read. actor.userId scoping is not the fix: only internal-origin calls reach this construct.
@serverOnly
@actor
@cache(0)
query historyReceipt callsHistoryReceiptById {
  args { id string! }
  filter row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  paginate 1
  shape callsHistoryReceiptFull
}

/// Internal exact-id read. actor.userId scoping is not the fix: only internal-origin calls reach this construct.
@serverOnly
@actor
@cache(0)
query historySync callsHistorySyncById {
  args { id string! }
  filter row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  paginate 1
  shape callsHistorySyncFull
