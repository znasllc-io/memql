    siteId  string!
    hostDigest  string!  @maxLength(64) @pattern("^[0-9a-f]{64}$")
  }
  filter  row => row.siteId == args.siteId && row.hostDigest == args.hostDigest && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsScheduledCallFull
}

/// One scheduledCall's two link digests, by its own id: the only read that returns a digest. The first join of a booked call copies them onto the room it opens, so both links find that room as they find an ad hoc call's, and the join holds only the link it presented (integrations/calls schedule.go). actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("scheduledCall digests by id -- bounded to a single row (id is the row's own primary key)")
@actor
@cache(0)
query scheduledCall callsScheduledCallDigestsById {
  args {
    id  string!
  }
  filter  row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsScheduledCallDigests
}

/// The bookings of one key that may still hold a slot of its time: not cancelled, not ended, and ending after now or started. What a new booking or a move is checked against, under the key's lock, and what counts toward the policy's maximum of upcoming bookings. A key's past, cancelled and ended bookings are never read, however many it made. A STARTED booking is read whatever its booked end, because a call running past its end still holds its slot until its room ends; the calls integration reads that room and decides (integrations/calls schedule.go upcoming). EVERY WAY A ROOM ENDS MARKS ITS BOOKING ENDED, in the same gated write that ends the room (its host ending it, the host-left countdown, the room emptying, reconciliation: integrations/calls host.go endRows), so a started booking leaves this read when its call ends and the read stays the key's open calls and its upcoming bookings. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("bookings of one key that may still hold a slot -- the upcoming ones the policy caps, plus the key's calls still open; ending a call marks its booking ended")
@actor
@cache(0)
query scheduledCall callsScheduledCallsForKey {
  args {
    keyId  string!
  }
  filter  row => row.keyId == args.keyId
              && row.status != "cancelled"
              && row.status != "ended"
              && (row.end > now || row.status == "started")
              && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsScheduledCallFull
}

/// One mediaServer row by its own id. The calls integration reads it before it writes, and to answer a request that names it. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("mediaServer by id -- bounded to a single row (id is the row's own primary key)")
@actor
@cache(0)
query mediaServer callsMediaServerById {
  args {
    id  string!
  }
  filter  row => row.id == args.id && actor.isClusterOwner == true
  shape   callsMediaServerFull
}

/// One policy row by its own id. The calls integration reads it before it writes, and to answer a request that names it. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("policy by id -- bounded to a single row (id is the row's own primary key)")
@actor
@cache(0)
query policy callsPolicyById {
