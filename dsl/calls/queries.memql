// queries.memql
//
// Every query here is @serverOnly: only the calls integration reads these rows, as the site's owner
// (borrowed authority) or as the cluster acting. The owned concepts state the owner tier as a top-level
// conjunct, as siteAccessSessionByToken does; actor.userId scoping alone is not the fix for a digest lookup,
// because a client-callable lookup by digest is an oracle for guessed secrets.

use common.traits.{ isOpen, isActiveRecord, statusIsActive }

/// actor.userId scoping is not the fix: only native portrait authorization may read this row.
@serverOnly
@actor
@cache(0)
query agentPortrait callsPortraitById {
 args { id string! }
 filter row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
 paginate 1
 shape callsPortraitFull
}

/// actor.userId scoping is not the fix: this bounded private inventory enforces upload limits.
@serverOnly
@actor
@cache(0)
query agentPortrait callsPortraitsForKey {
 args { siteId string! keyId string! }
 filter row => row.siteId == args.siteId && row.keyId == args.keyId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
 paginate 33
 shape callsPortraitFull
}

/// The newest complete simulated state, not an aggregate. actor.userId scoping is not the fix: only internal-origin calls reach this construct.
@serverOnly
@actor
@cache(0)
query simulatedWalletEntry callsSimulatedWalletLatest {
  args {
    siteId string!
    keyId string!
  }
  filter row => row.siteId == args.siteId && row.keyId == args.keyId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  sort "row.createdAt", "desc"
  paginate 1
  shape callsSimulatedWalletEntryFull
}

/// One immutable idempotency receipt. actor.userId scoping is not the fix: only internal-origin calls reach this construct.
@serverOnly
@actor
@cache(0)
query simulatedWalletEntry callsSimulatedWalletEntryById {
  args { id string! }
  filter row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  paginate 1
  shape callsSimulatedWalletEntryFull
}

/// Authoritative room-time sources for one pass. Native aggregation refuses an incomplete page rather than undercounting. actor.userId scoping is not the fix: only internal-origin calls reach this construct.
@serverOnly
@actor
@cache(0)
query room callsRoomsForFundingPass {
  args {
    siteId string!
    keyId string!
    passId string!
  }
  filter row => row.siteId == args.siteId && row.keyId == args.keyId && row.fundingPassId == args.passId && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  sort "row.id", "asc"
  paginate 1000
  shape callsRoomFull
}

/// One key row by its own id. The calls integration reads it before it writes, and to answer a request that names it. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("key by id -- bounded to a single row (id is the row's own primary key)")
@actor
@cache(0)
query key callsKeyById {
  args {
    id  string!
  }
  filter  row => row.id == args.id && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsKeyFull
}

/// Resolve a key by the SHA-256 digest of the secret presented, within ONE SITE: a secret minted for one of an owner's deployables resolves nothing at another, as siteAccessCodeByHash does. THE DIGEST IS THE ARGUMENT, never the secret: the plain secret exists in the caller's hand and nowhere else. An ended or expired row still answers; the calls integration decides the reply from the row and the clock. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("key by digest -- a digest names one row and no two rows share one")
@actor
@cache(0)
query key callsKeyByDigest {
  args {
    siteId  string!
    digest  string!  @maxLength(64) @pattern("^[0-9a-f]{64}$")
  }
  filter  row => row.siteId == args.siteId && row.digest == args.digest && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsKeyFull
}

