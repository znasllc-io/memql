/// One bounded, stable private-history page. actor.userId scoping is not the fix: only internal-origin calls reach this construct.
@serverOnly
@actor
@cache(0)
query history callsHistoryForKey {
  args {
    siteId string!
    keyId string!
    afterKey string
    archived bool!
  }
  filter row => row.siteId == args.siteId && row.keyId == args.keyId
    && (args.afterKey == nil || args.afterKey == "" || row.orderKey < args.afterKey)
    && ((args.archived == true && row.archivedAt != nil && row.archivedAt != "") || (args.archived == false && (row.archivedAt == nil || row.archivedAt == "")))
    && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  sort "orderKey", "desc"
  paginate 51
  shape callsHistoryFull
}

