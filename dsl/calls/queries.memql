/// The room rows of one parent, for the calls integration: open rooms of one key -- a key opens few rooms at a time, capped by the policy. actor.userId scoping is not the fix: the calls integration runs as the site owner or the cluster, so a caller term would decide nothing, and what @serverOnly withholds is the WIRE.
@serverOnly
@unbounded("open rooms of one key -- a key opens few rooms at a time, capped by the policy")
@actor
@cache(0)
query room callsOpenRoomsForKey {
  args {
    keyId  string!
  }
  filter  row => row.keyId == args.keyId && isOpen(row) && (row.ownerUserId == actor.userId || actor.isClusterOwner == true)
  shape   callsRoomFull
}

