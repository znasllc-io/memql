// shapes.memql
//
// One projection per calls concept. A digest is FILTERED on and never read back, so no shape carries one,
// with ONE exception, callsScheduledCallDigests: the room a booked call opens carries the booking's two
// digests, and the join that opens it holds only the link it presented.

/// The key row as the calls integration reads it. No digest is projected.
@row
shape key callsKeyFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  label
  userHandle
  keySuffix
  issuedAt
  kind
  status
  accountId
}

/// The session row as the calls integration reads it. No digest is projected.
@row
shape session callsSessionFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  kind
  keyId
  seatId
  roomId
  expiresAt
  endedAt
  credentialId
  verifiedAt
  accountId
}

/// The immutable simulated balance/receipt state. Its request digest contains no credentials.
@row
shape simulatedWalletEntry callsSimulatedWalletEntryFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  kind
  requestDigest
  balanceCents
  usageRemainderUnits
  creditedCents
  debitedCents
  plan
  passId
  passPlan
  passActivatedAt
  passExpiresAt
  passTotalSeconds
  passDailySeconds
  passMaxPeople
  accountId
}

/// The room row as the calls integration reads it. No digest is projected.
@row
shape room callsRoomFull {
  messageProtocol
  spotlightData
  usageConfig
  usageOperation
  usageDigest
  usageReservedCents
  usageMeter
  usageCostCents
  fundingMode
  fundingPassId
  fundingStartedAt
  fundingDeadline
  fundingMaxPeople
  historyPending
  row.id
  row.createdAt
  siteId
  ownerUserId
  deployable
  keyId
  mediaServerId
  mediaRoom
  status
  locked
  hostSeatId
  hostLeftAt
  scheduledCallId
  openedAt
  endedAt
  endReason
  joinWindowStartedAt
  joinWindowCount
  shareSeatId
  shareStartedAt
  accountId
  title
}

/// The seat row as the calls integration reads it. No digest is projected.
@row
shape seat callsSeatFull {
  messageIdentity
  agentData
  departureReceipt
  departureKeepRunning
  departureWrapUpAt
  historyPending
  row.id
  row.createdAt
  siteId
  ownerUserId
  roomId
  identity
  credentialId
  kind
  displayName
  host
  status
  confirmAdult
  confirmNoMinors
  participation
  authorityAccepted
  termsVersion
  joinedAt
  leftAt
  keyId
  lastSeenAt
  absentSince
  letInAt
  waitingSince
  accountId
}

/// The queueEntry row as the calls integration reads it. No digest is projected.
@row
shape queueEntry callsQueueEntryFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  roomId
  seatId
  keyId
  class
  enqueuedAt
  lastPollAt
  status
  accountId
}

/// The scheduledCall row as the calls integration reads it. No digest is projected.
@row
shape scheduledCall callsScheduledCallFull {
 delegationId
  usageRequests
  usageConfig
  usageOperation
  usageDigest
  historyPending
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  start
  end
  title
  status
  roomId
  calendarUid
  accountId
}

/// A scheduledCall's two link digests and nothing else: THE ONE SHAPE THAT PROJECTS A DIGEST. The first join
/// of a booked call opens its room, and the room carries both digests so either link finds it as an ad hoc
/// call's links find theirs; that join presented one link and can derive only its digest. Read only by
/// callsScheduledCallDigestsById, under the gate that opens the room (integrations/calls schedule.go).
@row
shape scheduledCall callsScheduledCallDigests {
  row.id
  guestDigest
  hostDigest
}

/// The mediaServer row as the calls integration reads it. No digest is projected.
@row
shape mediaServer callsMediaServerFull {
  row.id
  row.createdAt
  provider
  apiUrl
  publicUrl
  region
  seats
  state
  credentialSecret
}

/// The policy row as the calls integration reads it. No digest is projected.
@row
shape policy callsPolicyFull {
  reportsEnabled
  reportMetadataDays
  processingEnabled
  callConfiguration
  usagePreview
  simulatedFunding
  row.id
  row.createdAt
  siteId
  ownerUserId
  requirePasskeys
  maxPeople
  maxAgents
  roomJoinsPerMinute
  maxUpcomingScheduled
  guestInactiveDays
  maxScheduledMinutes
  hostLeftGrace
  passTtl
  scheduleHorizon
  queueEntryTtl
  queuePoll
  accountId
}

@row
shape invitationReceipt callsInvitationFull {
  row.id
  row.createdAt
  siteId
  roomId
  status
  fingerprint
  attemptedAt
  retryAt
}

@row
shape invitationBudget callsInvitationBudgetFull {
  row.id
  row.createdAt
  siteId
  minuteStartedAt
  minuteCount
  dayStartedAt
  dayCount
}

@row
shape invitationLink callsInvitationLinkFull {
  row.id
  siteId
  ownerUserId
  roomId
}

/// Internal public-credential projection; no browser has direct row access.
@row
shape credential callsCredentialFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  credentialData
  label
  addedAt
  lastUsedAt
  revokedAt
  accountId
}

/// Private history service projection; never client-readable.
@row
shape history callsHistoryFull {
  costCents
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  sourceKind
  sourceId
  title
  role
  status
  orderKey
  startedAt
  endedAt
  archivedAt
  purgeAt
  accountId
}

/// Private history service projection; never client-readable.
@row
shape historyReceipt callsHistoryReceiptFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  purgeAt
  accountId
}

/// Private history service projection; never client-readable.
@row
shape historySync callsHistorySyncFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  phase
  afterCursor
  complete
  accountId
}

/// Private protocol and accounting state; only the native service projects it.
@row
shape commerceState callsCommerceStateFull {
 row.id
 row.createdAt
 siteId
 ownerUserId
 keyId
 stateData
}

/// Native-only journal; never returned directly to a visitor or agent.
@row
shape delegationState callsDelegationFull {
  row.id
  row.createdAt
  siteId
  keyId
  tokenDigest
  stateData
}

/// Native-only journal projection.
@row
shape workflowState callsWorkflowStateFull {
 kind
 active
 ownerUserId
 row.id
 row.createdAt
 siteId
 keyId
 stateData
}

/// Native-only journal projection.
@row
shape resourceState callsResourceStateFull {
 active
 ownerUserId
 row.id
 row.createdAt
 siteId
 keyId
 stateData
}

/// Native-only family authorization journal, never directly exposed.
@row
shape familyState callsFamilyFull {
 row.id
 row.createdAt
 siteId
 keyId
 roomId
 kind
 tokenDigest
 sessionId
 stateData
}

/// Native-only agent review journal; never exposed directly.
@row
shape agentAdmissionState callsAgentAdmissionFull {
 row.id
 row.createdAt
 siteId
 roomId
 stateData
}

/// Native-only canonical portrait metadata. Blob references never leave the service.
@row
shape agentPortrait callsPortraitFull {
 row.id
 row.createdAt
 siteId
 keyId
 digest
 mimeType
 width
 height
 blobRef
 issuedAt
}

/// Private consent and processing lease metadata only.
@row
shape processingState callsProcessingFull {
 row.id
 row.createdAt
 siteId
 roomId
 stateData
}

/// Private compact processing metadata.
@row
shape processingReceipt callsProcessingReceiptFull {
 row.id
 row.createdAt
 siteId
 roomId
 trackId
 epoch
 receiptData
}

/// Private compact processing metadata.
@row
shape processingRate callsProcessingRateFull {
 row.id
 row.createdAt
 siteId
 roomId
 rateSecond
 rateCount
}

@row
shape reportCase callsReportFull {
 row.id
 row.createdAt
 siteId
 reporterKeyId
 reporterActor
 subjectKeyId
 roomId
 issuedAt
 expiresAt
 revision
 stateData
}
@row
shape reportCase callsReportBudget {
 row.id
 reporterKeyId
 roomId
}
@row
shape reportAccessAudit callsReportAudit {
 row.id
 actorId
 action
 recordedAt
 revision
}

@row
shape messageReceipt callsMessageReceiptFull { row.id, row.createdAt, siteId, ownerUserId, roomId, seatId, identity, joinedAt, expiresAt, receiptData }
@row
shape messageRate callsMessageRateFull { row.id, row.createdAt, ownerUserId, scope, targetId, rateData }
