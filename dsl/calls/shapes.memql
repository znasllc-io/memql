// shapes.memql
//
// One projection per calls concept. A digest is FILTERED on and never read back, so no shape carries one,
// with ONE exception, callsScheduledCallDigests: the room a booked call opens carries the booking's two
// digests, and the join that opens it holds only the link it presented.

/// The key row as the calls integration reads it. No digest is projected.
@row
shape key callsKeyFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  label
  userHandle
  keySuffix
  issuedAt
  kind
  status
  accountId
}

/// The session row as the calls integration reads it. No digest is projected.
@row
shape session callsSessionFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  kind
  keyId
  seatId
  roomId
  expiresAt
  endedAt
  credentialId
  verifiedAt
  accountId
}

/// The immutable simulated balance/receipt state. Its request digest contains no credentials.
@row
shape simulatedWalletEntry callsSimulatedWalletEntryFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  kind
  requestDigest
  balanceCents
  creditedCents
  debitedCents
  plan
  passId
  passPlan
  passActivatedAt
  passExpiresAt
  passTotalSeconds
  passDailySeconds
  passMaxPeople
  accountId
}

/// The room row as the calls integration reads it. No digest is projected.
@row
shape room callsRoomFull {
  usageConfig
  usageOperation
  usageDigest
  usageReservedCents
  usageMeter
  usageCostCents
  fundingMode
  fundingPassId
  fundingStartedAt
  fundingDeadline
  fundingMaxPeople
  historyPending
  row.id
  row.createdAt
  siteId
  ownerUserId
  deployable
  keyId
  mediaServerId
  mediaRoom
  status
  locked
  hostSeatId
  hostLeftAt
  scheduledCallId
  openedAt
  endedAt
  endReason
  joinWindowStartedAt
  joinWindowCount
  shareSeatId
  shareStartedAt
  accountId
  title
}

/// The seat row as the calls integration reads it. No digest is projected.
@row
shape seat callsSeatFull {
  historyPending
  row.id
  row.createdAt
  siteId
  ownerUserId
  roomId
  identity
  credentialId
  kind
  displayName
  host
  status
  confirmAdult
  confirmNoMinors
  termsVersion
  joinedAt
  leftAt
  keyId
  lastSeenAt
  absentSince
  letInAt
  waitingSince
  accountId
}

/// The queueEntry row as the calls integration reads it. No digest is projected.
@row
shape queueEntry callsQueueEntryFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  roomId
  seatId
  keyId
  class
  enqueuedAt
  lastPollAt
  status
  accountId
}

/// The scheduledCall row as the calls integration reads it. No digest is projected.
@row
shape scheduledCall callsScheduledCallFull {
  usageRequests
  usageConfig
  usageOperation
  usageDigest
  historyPending
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  start
  end
  title
  status
  roomId
  calendarUid
  accountId
}

/// A scheduledCall's two link digests and nothing else: THE ONE SHAPE THAT PROJECTS A DIGEST. The first join
/// of a booked call opens its room, and the room carries both digests so either link finds it as an ad hoc
/// call's links find theirs; that join presented one link and can derive only its digest. Read only by
/// callsScheduledCallDigestsById, under the gate that opens the room (integrations/calls schedule.go).
@row
shape scheduledCall callsScheduledCallDigests {
  row.id
  guestDigest
  hostDigest
}

/// The mediaServer row as the calls integration reads it. No digest is projected.
@row
shape mediaServer callsMediaServerFull {
  row.id
  row.createdAt
  provider
  apiUrl
  publicUrl
  region
  seats
  state
  credentialSecret
}

/// The policy row as the calls integration reads it. No digest is projected.
@row
shape policy callsPolicyFull {
  callConfiguration
  usagePreview
  simulatedFunding
  row.id
  row.createdAt
  siteId
  ownerUserId
  requirePasskeys
  maxPeople
  maxAgents
  roomJoinsPerMinute
  maxUpcomingScheduled
  maxScheduledMinutes
  hostLeftGrace
  passTtl
  scheduleHorizon
  queueEntryTtl
  queuePoll
  accountId
}

@row
shape invitationReceipt callsInvitationFull {
  row.id
  row.createdAt
  siteId
  roomId
  status
  fingerprint
  attemptedAt
  retryAt
}

@row
shape invitationBudget callsInvitationBudgetFull {
  row.id
  row.createdAt
  siteId
  minuteStartedAt
  minuteCount
  dayStartedAt
  dayCount
}

@row
shape invitationLink callsInvitationLinkFull {
  row.id
  siteId
  ownerUserId
  roomId
}

/// Internal public-credential projection; no browser has direct row access.
@row
shape credential callsCredentialFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  credentialData
  label
  addedAt
  lastUsedAt
  revokedAt
  accountId
}

/// Private history service projection; never client-readable.
@row
shape history callsHistoryFull {
  costCents
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  sourceKind
  sourceId
  title
  role
  status
  orderKey
  startedAt
  endedAt
  archivedAt
  purgeAt
  accountId
}

/// Private history service projection; never client-readable.
@row
shape historyReceipt callsHistoryReceiptFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  purgeAt
  accountId
}

/// Private history service projection; never client-readable.
@row
shape historySync callsHistorySyncFull {
  row.id
  row.createdAt
  siteId
  ownerUserId
  keyId
  phase
  afterCursor
  complete
  accountId
}
