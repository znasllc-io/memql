// concepts.memql
//
// The generic CALLS capability: video-call rooms, seats, passes for a media server, scheduled calls and an
// admission queue. Product-neutral. Every concept is server-written and client-unreadable
// (component/memql/site_access_guards.go clientUnreadableConcepts): the calls integration reads and writes
// these rows as the site's owner (borrowed authority) and the browser never reads a v1:calls row directly.
// Only digests of bearer secrets are stored. The `site.calls` switch (dsl/platform) turns the capability on.

use identity.concepts.{ user }
use platform.concepts.{ site }

/// A CALLS KEY: the bearer credential that meters a deployable's calls. Only the SHA-256 digest of the
/// plain key is stored (`digest`); the plain key is shown once when it is minted and never again, so a
/// leaked ROW is not a leaked key. `status` is the operator's switch: frozen keys open no new rooms and
/// banned keys are refused outright. Server-written and client-unreadable (clientUnreadableConcepts):
/// the calls integration is the only reader and writer, as the site's owner.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="kind", secondary="siteId", status="status")
@belongsTo(account, via="siteId", stays="signin")
concept key {
  siteId  string!  @description("The v1:platform:site (deployable) this row belongs to.")
  ownerUserId  string!  @description("The v1:identity:user who owns the site -- the row-authz key. STAMPED from the actor the write runs as and never an argument: the calls integration writes as the site's owner (borrowed authority), so this is the site's owner and never a visitor.")
  digest  string! @maxLength(64) @pattern("^[0-9a-f]{64}$")  @description("SHA-256, lowercase hex, of the plain key. THE PLAIN KEY IS NEVER STORED. Looked up by callsKeyByDigest.")
  label  string  @description("The operator's name for the key. Never sent to a caller.")
  userHandle string @maxLength(128) @description("Random WebAuthn user handle, separate from the calls key id. Present only on passkey-bound keys.")
  keySuffix string @maxLength(4) @description("Last four symbols for a masked account label, never the key.")
  issuedAt datetime @description("Original account creation time, unchanged by later key versions.")
  kind  enum("test", "paid", "guest")  @description("Whether the key spends real balance. Absent reads as test.")
  status  enum("active", "frozen", "banned", "retired")  @description("Absent reads as active. Retired revokes an inactive unfunded unclaimed guest without deleting financial or evidence records.")
  accountId  string  @description("The account this row belongs to (see @belongsTo). The engine fills it in at insert and carries it forward on every update.")

  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// One immutable LOCAL SIMULATION effect and the complete wallet state after it.
/// Not real money: no payment provider, production ledger, or cash-out consumes these rows.
/// The key gate serializes writes; one insert atomically commits state and receipt.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="kind", secondary="keyId")
@belongsTo(account, via="siteId", stays="signin")
concept simulatedWalletEntry {
  siteId string! @description("The v1:platform:site whose operator explicitly enables this local simulation.")
  ownerUserId string! @description("The owning v1:identity:user, stamped from the internal actor; never caller-supplied.")
  keyId string! @description("The authenticated v1:calls:key that owns this simulated balance.")
  kind enum("topup", "activation", "settlement")!
  requestDigest string! @maxLength(64) @pattern("^[0-9a-f]{64}$") @description("Canonical non-secret request digest. The row id separately binds site, key and idempotency nonce, independent of session-secret rotation.")
  usageRemainderUnits int @description("Unbilled measured usage: microdollars times milliseconds, 0..599999999. One cent is 600000000 units. Carried by every wallet receipt; absent on old receipts means zero.")
  balanceCents int! @description("Complete resulting simulated USD balance, bounded by the native invariant to 0..50000 cents.")
  creditedCents int! @description("Simulated cents credited by this immutable receipt; zero for activation.")
  debitedCents int! @description("Simulated cents debited by this immutable receipt; zero for top-up.")
  plan enum("day", "month") @description("The activated catalog plan on an activation receipt, absent on top-ups.")
  passId string @description("The v1:calls:simulatedWalletEntry activation that created the current pass, retained unchanged by top-ups.")
  passPlan enum("day", "month")
  passActivatedAt datetime
  passExpiresAt datetime
  passTotalSeconds int
  passDailySeconds int
  passMaxPeople int
  accountId string @description("Organization account assignment, filled by @belongsTo and never visitor authority.")
  @relationship(type="references", as="walletKey", field="keyId", target=key, direction="outgoing")
  @relationship(type="references", as="activeSimulationPass", field="passId", target=simulatedWalletEntry, direction="outgoing")
  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// A CALLS SESSION: one short-lived pass a host or a guest holds to join one room. Only the digest of
/// the plain token is stored (`tokenDigest`). THE ROW EXPIRES: @retention(ttl="30d", keepLatest=false,
/// archive="none") deletes the whole row thirty days after it was written, with no copy in object
/// storage; a digest has no value once the pass has ended and no pass outlives its `expiresAt`.
/// Server-written and client-unreadable, for siteAccessSession's reason.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@retention(ttl="30d", keepLatest=false, archive="none")
@displayCard(primary="kind", secondary="siteId", tertiary="expiresAt")
@belongsTo(account, via="siteId", stays="signin")
concept session {
  siteId  string!  @description("The v1:platform:site (deployable) this row belongs to.")
  ownerUserId  string!  @description("The v1:identity:user who owns the site -- the row-authz key. STAMPED from the actor the write runs as and never an argument: the calls integration writes as the site's owner (borrowed authority), so this is the site's owner and never a visitor.")
  tokenDigest  string! @maxLength(64) @pattern("^[0-9a-f]{64}$")  @description("SHA-256, lowercase hex, of the plain pass token. THE PLAIN TOKEN IS NEVER STORED.")
  kind  enum("host", "guest")  @description("Which side of the call the pass is for.")
  keyId  string  @description("The v1:calls:key this pass was drawn against.")
  seatId  string  @description("The v1:calls:seat the pass occupies, once it has one.")
  roomId  string  @description("The v1:calls:room of that seat, written with it, so a session says which call it is in without a read of its seat.")
  expiresAt  datetime  @description("When the pass stops opening anything. Compared against the engine's clock at request time.")
  endedAt  datetime  @description("When the pass was ended early, or empty. A SOFT end: the row stays.")
  credentialId string @description("The calls credential that authenticated this session; revocation invalidates it.")
  verifiedAt datetime @description("Last successful user-verified assertion on this session.")
  accountId  string  @description("The account this row belongs to (see @belongsTo). The engine fills it in at insert and carries it forward on every update.")

  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="drawnOn", field="keyId", target=key, direction="outgoing")
  @relationship(type="references", as="heldFor", field="seatId", target=seat, direction="outgoing")
  @relationship(type="references", as="seatedIn", field="roomId", target=room, direction="outgoing")
}

/// A CALLS ROOM: one call on one media server. `guestDigest` and `hostDigest` are the SHA-256 digests of
/// the guest and host links; the plain links are shown once. A room ends when a host ends it, when the last
/// person in it leaves with nobody waiting (for a booked call, only after its booked end), or when nobody
/// hosting it has been in it for the policy's hostLeftGrace (`hostLeftAt`; for a booked call, counted from
/// its booked start at the earliest, and from its booked end when its host never came) and no key holder in
/// it took over; `endReason` says which.
/// `shareSeatId` and `shareStartedAt` record the newest screen share the media server reported, so a share
/// event delivered late cannot take over from a newer one. Server-written and client-unreadable.
///
/// ONLY THE NEWEST VERSION OF A ROOM OUTLIVES A DAY: @retention(ttl="1d", keepLatest=true, archive="none").
/// Every join attempt, lock and host change writes the room again, and the capacity count every join, start
/// and poll makes reads the open rooms of its media server through a lookup index that holds only the
/// versions written while a room was open (memory_nodes_calls_open_room_lookup_idx): an ended room leaves
/// that index once its superseded versions expire, so the read costs the server's open rooms and the rooms
/// open on it within the last day, never every room it ever carried. The newest version,
/// which holds when the call opened, how it ended and when, stays for good, and a quiet call still open
/// keeps its newest version however old. A superseded version is nobody's evidence: every read takes the
/// newest version of a room, and the row-version fences compare only the newest. Seats keep every version
/// until part 2 settles what records minutes.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@retention(ttl="1d", keepLatest=true, archive="none")
@displayCard(primary="mediaRoom", secondary="siteId", status="status")
@belongsTo(account, via="siteId")
concept room {
  @relationship(type="references", as="simulationPass", field="fundingPassId", target=simulatedWalletEntry, direction="outgoing")
  fundingMode enum("usage_preview", "usage_metered_preview") @description("Explicit bounded local usage preview; absent keeps the original pass or legacy room behavior. Immutable at room creation.")
  usageConfig string
  usageOperation string
  usageDigest string
  usageReservedCents int
  usageMeter string
  usageCostCents int
  fundingPassId string @description("The v1:calls:simulatedWalletEntry activation whose simulated allowance pays for this room; fixed at creation.")
  fundingStartedAt datetime @description("First actual media admission for this funded room. Waiting without an admitted participant consumes no room time.")
  fundingDeadline datetime @description("Server-enforced latest end: fixed at first admission for legacy passes or room creation for usage preview; never extended by top-up or handover.")
  fundingMaxPeople int @description("Total participant ceiling including the host and invited AI callers, snapshotted from the simulated pass or bounded usage preview.")
  historyPending bool @description("Atomically marks source changes not yet durably projected into private history; only a version-fenced successful projection clears it.")
  siteId  string!  @description("The v1:platform:site (deployable) this row belongs to.")
  ownerUserId  string!  @description("The v1:identity:user who owns the site -- the row-authz key. STAMPED from the actor the write runs as and never an argument: the calls integration writes as the site's owner (borrowed authority), so this is the site's owner and never a visitor.")
  deployable  string  @description("The deployable's name, for the calls policy lookup.")
  title  string @maxLength(2048) @description("The current plain-text call title. Operational metadata; per-key history deletion does not remove this room record.")
  keyId  string  @description("The v1:calls:key that opened the room.")
  mediaServerId  string  @description("The v1:calls:mediaServer carrying the room.")
  mediaRoom  string  @description("The room's name on the media server.")
  status  enum("open", "ended")  @description("Absent reads as open.")
  locked  bool  @description("A locked room admits nobody new.")
  hostSeatId  string  @description("The v1:calls:seat that hosts the room.")
  hostLeftAt  datetime  @description("When the last host seat in the call left, or empty: the host-left countdown runs from it -- for a booked call, from its booked start when that is later, so a booked call is never counted out before it begins. A booked call whose host never came has none, and counts from its booked end. Cleared when a host is back in the call, or when a key holder takes over.")
  scheduledCallId  string  @description("The v1:calls:scheduledCall this room was opened for, if any.")
  guestDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")  @description("SHA-256, lowercase hex, of the guest link secret.")
  hostDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")  @description("SHA-256, lowercase hex, of the host link secret.")
  openedAt  datetime  @description("When the room opened.")
  endedAt  datetime  @description("When the room ended, or empty.")
  endReason  string  @description("Why the room ended, as a stable code: ended (a host ended it), host_left (the host-left countdown ran out), wrap_up (an explicit firm host departure deadline) or empty (the last person left with nobody waiting).")
  joinWindowStartedAt  datetime  @description("When the room's current one-minute window of join attempts opened (calls.CountJoinAttempt). Counted on the room so every replica counts the same attempts.")
  joinWindowCount  int  @description("How many join attempts the current window has taken, refused ones included; the policy's roomJoinsPerMinute caps it.")
  shareSeatId  string  @description("The v1:calls:seat whose screen share took over most recently, as the media server's track_published webhook reported it, or empty. A share event not newer than shareStartedAt changes nothing, so a late one cannot stop the share that replaced it. It records the takeover and is not cleared when the share stops.")
  shareStartedAt  datetime  @description("When that share was published, by the media server's clock, to the second: the time a later share event is compared with.")
  accountId  string  @description("The account this row belongs to (see @belongsTo). The engine fills it in at insert and carries it forward on every update.")

  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="openedWith", field="keyId", target=key, direction="outgoing")
  @relationship(type="references", as="carriedBy", field="mediaServerId", target=mediaServer, direction="outgoing")
  @relationship(type="references", as="hostedBy", field="hostSeatId", target=seat, direction="outgoing")
  @relationship(type="references", as="sharedBy", field="shareSeatId", target=seat, direction="outgoing")
  @relationship(type="references", as="openedFor", field="scheduledCallId", target=scheduledCall, direction="outgoing")
}

/// A CALLS SEAT: one participant's place in one room. `kind` is the rules module's SeatKind (person, agent,
/// avatar, sampler). The three confirmations are what the participant confirmed at the seat's latest join
/// (every join confirms again): 18 or older, no one under 18 on their camera or screen, and the terms
/// version. `keyId` is the key the seat's holder unlocked, when a key opened their session: a key holder in
/// the call, who takes over as host when the host leaves. `lastSeenAt` is the seat's last sign of life on
/// the media server, `absentSince` when a reconciliation pass first found it missing there, and `letInAt`
/// a host's admission past the call's lock. Server-written and client-unreadable.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="displayName", secondary="roomId", status="status")
@belongsTo(account, via="siteId")
concept seat {
	agentData string @description("Server-written public agent purpose, approved policy version and approval revision for this admission. No credentials or private spending limits.")
  historyPending bool @description("Atomically marks source changes not yet durably projected into private history; only a version-fenced successful projection clears it.")
  siteId  string!  @description("The v1:platform:site (deployable) this row belongs to.")
  ownerUserId  string!  @description("The v1:identity:user who owns the site -- the row-authz key. STAMPED from the actor the write runs as and never an argument: the calls integration writes as the site's owner (borrowed authority), so this is the site's owner and never a visitor.")
  roomId  string!  @description("The v1:calls:room this seat is in.")
  identity  string  @description("The participant's identity on the media server.")
  credentialId string @description("Authenticating calls credential. Revocation ends this seat on reconciliation, even while media stays connected.")
  kind  enum("person", "agent", "avatar", "sampler")  @description("What occupies the seat (calls.SeatKind): people count against maxPeople and agents against maxAgents, and the kind decides the grant its pass carries.")
  displayName  string  @description("The name other participants see.")
  host  bool  @description("True for the room's host seat.")
  status  enum("waiting", "admitted", "in_call", "left", "removed")  @description("Where the seat is on its walk.")
  confirmAdult  bool  @description("The participant confirmed, at the seat's latest join, that they are 18 or older.")
  participation string @description("Declared adults_only or children_present; does not prove legal consent or parenthood.")
  authorityAccepted bool @description("Adult supervisor acknowledgement, distinct from independently required child consent.")
  confirmNoMinors  bool  @description("The participant confirmed, at the seat's latest join, that no one under 18 will appear on their camera or screen.")
  termsVersion  string  @description("The version of the terms the participant accepted at the seat's latest join.")
  joinedAt  datetime  @description("When the seat was taken.")
  leftAt  datetime  @description("When the participant left, or empty.")
  departureReceipt string @description("Server-only receipt for the last explicit bound leave. Written atomically with the seat leaving; retries cannot leave a later admission.")
  departureKeepRunning bool @description("A host explicitly authorized this bounded room to continue without a host, never beyond its existing funding deadline. Preserved on rejoin; a firm wrap-up takes precedence.")
  departureWrapUpAt datetime @description("Earliest firm wrap-up deadline selected by this host seat. Written atomically with leaving and never cleared or extended, including on rejoin.")
  keyId  string  @description("The v1:calls:key the seat's holder unlocked, when a key opened the session that took the seat, or empty. Written from the session when the seat is taken, never from a request. A seat in the call that names one is a key holder who can take over as host when the host leaves (design 8).")
  lastSeenAt  datetime  @description("The seat's last sign of life: when reconciliation last saw the media server show this seat's identity in its room (refreshed only once it is two minutes old, so the writes it costs stay bounded), or the time of the media server's participant_joined or participant_left webhook for it, when that is newer. A seat whose identity is gone is closed at this time, or at joinedAt when it was never seen since it was let in.")
  absentSince  datetime  @description("When a reconciliation pass first found this seat's identity missing from its media room while the seat held a seat there, or empty: cleared when the media server shows it again. The seat is closed once it has been missing for the pass lifetime (passTtl) from then, or from a later lastSeenAt, so one pass that misses a seat, as after a media server restart, closes nothing (calls.SeatAbsent). One written before the seat's latest joinedAt belongs to the stint before and counts for nothing.")
  letInAt  datetime  @description("When a host admitted this seat past the call's lock (the admit host control), or empty. A seat let in passes the lock for the rest of the call, as a host does, and is still decided against the room's size and the media server's seats like any new ask.")
  waitingSince  datetime  @description("When the seat last began waiting to come into its call: written by the join that seats it waiting, behind the lock or in the media server's line, and by one that brings a seat that left back to wait. It is what a host's roster says a waiter has waited since. Read it only while status is waiting: a seat let in or gone keeps its last value.")
  accountId  string  @description("The account this row belongs to (see @belongsTo). The engine fills it in at insert and carries it forward on every update.")

  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="roomId", target=room, direction="outgoing")
  @relationship(type="references", as="takenWith", field="keyId", target=key, direction="outgoing")
}

/// A CALLS QUEUE ENTRY: one request waiting to be admitted, ordered by the rules module's class and
/// `enqueuedAt`. `lastPollAt` is how the waiter proves it is still there. THE ROW EXPIRES after 30 days
/// (keepLatest=false, archive="none"): an admission wait has no value as a record once it is over.
/// Server-written and client-unreadable.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@retention(ttl="30d", keepLatest=false, archive="none")
@displayCard(primary="class", secondary="roomId", status="status")
@belongsTo(account, via="siteId", stays="transit")
concept queueEntry {
  siteId  string!  @description("The v1:platform:site (deployable) this row belongs to.")
  ownerUserId  string!  @description("The v1:identity:user who owns the site -- the row-authz key. STAMPED from the actor the write runs as and never an argument: the calls integration writes as the site's owner (borrowed authority), so this is the site's owner and never a visitor.")
  roomId  string!  @description("The v1:calls:room the entry waits to join.")
  seatId  string  @description("The v1:calls:seat the entry would take.")
  keyId  string  @description("The v1:calls:key the entry is drawn against.")
  class  enum("running", "scheduled", "new")  @description("Admission class: a running call outranks a scheduled one, which outranks a new one.")
  enqueuedAt  datetime  @description("When the entry joined the queue.")
  lastPollAt  datetime  @description("When the waiter last confirmed it was still waiting.")
  status  enum("waiting", "admitted", "expired")  @description("Absent reads as waiting.")
  accountId  string  @description("The account this row belongs to (see @belongsTo). The engine fills it in at insert and carries it forward on every update.")

  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="roomId", target=room, direction="outgoing")
  @relationship(type="references", as="forSeat", field="seatId", target=seat, direction="outgoing")
  @relationship(type="references", as="drawnOn", field="keyId", target=key, direction="outgoing")
}

/// A SCHEDULED CALL: a call booked for a later time against one key. `guestDigest` and `hostDigest` are
/// the SHA-256 digests of the call's two links; the plain links are shown once, and a reschedule replaces
/// both, so the old links open nothing. `roomId` is set when the first join opens the call's room, which
/// carries the same two digests so the links find it as they find an ad hoc call's. Server-written and
/// client-unreadable.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="title", secondary="start", status="status")
@belongsTo(account, via="siteId")
concept scheduledCall {
 delegationId string @description("Standing agent grant that authorized this booking, checked again before guests can open it.")
  usageRequests string
  usageConfig string
  usageOperation string
  usageDigest string
  historyPending bool @description("Atomically marks source changes not yet durably projected into private history; only a version-fenced successful projection clears it.")
  siteId  string!  @description("The v1:platform:site (deployable) this row belongs to.")
  ownerUserId  string!  @description("The v1:identity:user who owns the site -- the row-authz key. STAMPED from the actor the write runs as and never an argument: the calls integration writes as the site's owner (borrowed authority), so this is the site's owner and never a visitor.")
  keyId  string  @description("The v1:calls:key the call is booked against.")
  start  datetime  @description("When the call starts.")
  end  datetime  @description("When the call is booked to end.")
  title  string  @description("The call's title in the calendar file.")
  status  enum("scheduled", "cancelled", "started", "ended")  @description("Absent reads as scheduled.")
  roomId  string  @description("The v1:calls:room once the call has started. The room names the call back (its scheduledCallId), so this side declares no relationship: a relationship here, as the reverse of the room's, is refused as a direction conflict (the gate idBearingFieldExemptions records the exemption).")
  guestDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")  @description("SHA-256, lowercase hex, of the guest link secret.")
  hostDigest  string @maxLength(64) @pattern("^[0-9a-f]{64}$")  @description("SHA-256, lowercase hex, of the host link secret.")
  calendarUid  string @maxLength(320)  @description("The UID of the call's calendar file, `<id>@<host>` with the deployable's public host at booking. FIXED WHEN THE CALL IS BOOKED and never written again, so the file a reschedule hands out updates the calendar entry the first one made even if the deployable's public host changed in between (a custom domain went live).")
  accountId  string  @description("The account this row belongs to (see @belongsTo). The engine fills it in at insert and carries it forward on every update.")

  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="bookedWith", field="keyId", target=key, direction="outgoing")
}

/// A MEDIA SERVER: one LiveKit-compatible server rooms are placed on. CLUSTER-OWNED: the cluster owner
/// manages the fleet, and no site owns one. `credentialSecret` NAMES a secret (it is not the secret): the
/// value is read through the secret store at use. Server-written and client-unreadable.
@serverWritten
@rowAuthz(clusterOwner)
@displayCard(primary="publicUrl", secondary="region", status="state")
@belongsTo(cluster)
concept mediaServer {
  provider  string  @description("The media server software, for instance livekit.")
  apiUrl  string  @description("The server's control API address, used only by the engine.")
  publicUrl  string  @description("The address participants' browsers connect to.")
  region  string  @description("Where the server runs, for placement.")
  seats  int  @description("How many seats the server can carry.")
  state  enum("active", "draining", "removed")  @description("A draining server takes no new rooms; a removed one is gone. Absent reads as active.")
  credentialSecret  string  @description("The NAME of the globalSecret holding the server's API credentials.")
}

/// A CALLS POLICY: the limits the rules module consults for one deployable, one field per calls.Policy
/// value (durations in whole seconds). PER SITE: a package deployable's name is unique only together
/// with its package, so a policy keyed by the name would apply one package's limits to every other
/// package's deployable of that name. Owned by the site's owner, as the other site-scoped calls rows
/// are. A field left absent means the shipped default (calls.DefaultPolicy); only a value the
/// operator set overrides it, and callsPolicySet holds every value inside the cluster's bounds.
/// Server-written and client-unreadable.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="siteId")
@belongsTo(account, via="siteId")
concept policy {
  guestInactiveDays int @description("Unfunded unclaimed guest inactivity before access retirement, in days. Default 30; operator may lengthen to 365. Never retires funded or Passkey-secured accounts.")
  siteId  string!  @description("The v1:platform:site (deployable) these limits apply to. One policy per site.")
  ownerUserId  string!  @description("The v1:identity:user who owns the site -- the row-authz key. STAMPED from the actor the write runs as and never an argument: the calls integration writes as the site's owner (borrowed authority), so this is the site's owner and never the operator who set the limits.")
  requirePasskeys int @description("0 preserves optional guest access; 1 requires a currently credential-backed session at join.")
  reportsEnabled int @description("Explicit operator opt-in for private participant report metadata; disabled by default.")
  reportMetadataDays int @description("Required explicit report metadata expiry in whole days, from 1 to 365; not a legal retention policy.")
  processingEnabled int @description("Operator opt-in for trusted processing in consented, configured Insights calls; no family processing.")
  callConfiguration int @description("Operator opt-in for configured local simulated prepaid rooms. Requires simulatedFunding; never real payment authority.")
  usagePreview int @description("Operator-only opt-in for bounded local usage preview. Requires simulatedFunding. Never charges usage or enables real payments.")
  simulatedFunding int @description("Operator-only opt-in for local simulated wallet funding and hosting passes. 0/absent disables it. Never enables real payments.")
  maxPeople  int  @description("calls.Policy.MaxPeople: people allowed in one room.")
  maxAgents  int  @description("calls.Policy.MaxAgents: agents allowed in one room.")
  roomJoinsPerMinute  int  @description("calls.Policy.RoomJoinsPerMinute: join attempts allowed per room per minute.")
  maxUpcomingScheduled  int  @description("calls.Policy.MaxUpcomingScheduled: upcoming scheduled calls allowed per key.")
  maxScheduledMinutes  int  @description("calls.Policy.MaxScheduledMinutes: the longest a scheduled call may be, in minutes.")
  hostLeftGrace  int  @description("calls.Policy.HostLeftGrace, in SECONDS: how long a room outlives its host.")
  passTtl  int  @description("calls.Policy.PassTTL, in SECONDS: how long a pass lives.")
  scheduleHorizon  int  @description("calls.Policy.ScheduleHorizon, in SECONDS: how far ahead a call may be booked.")
  queueEntryTtl  int  @description("calls.Policy.QueueEntryTTL, in SECONDS: how long a queue entry may go unpolled.")
  queuePoll  int  @description("calls.Policy.QueuePoll, in SECONDS: how often a waiter polls.")
  accountId  string  @description("The account this row belongs to (see @belongsTo). The engine fills it in at insert and carries it forward on every update.")

  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// One invitation effect, identified by a keyed digest of site, room and canonical recipient.
/// No address or guest token is stored. The newest receipt lasts as long as its room so retries
/// after any replica restart cannot send it twice; superseded versions expire after one day.
// @no-displayCard: Private effect receipt; its public send outcome is returned by the checked host action.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@retention(ttl="1d", keepLatest=true, archive="none")
@belongsTo(account, via="siteId", stays="signin")
concept invitationReceipt {
  siteId string!
  ownerUserId string!
  roomId string!
  status enum("attempting", "sent", "captured", "unknown", "retryable")!
  fingerprint string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
  attemptedAt datetime!
  retryAt datetime
  accountId string
  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="forRoom", field="roomId", target=room, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// Mandatory per-site invitation counters. Every provider attempt, safe retries included,
/// consumes this shared budget before the effect begins. No addresses or link capabilities.
// @no-displayCard: Private abuse counters have no user-facing identity; the host action returns the remaining wait.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@retention(ttl="1d", keepLatest=true, archive="none")
@belongsTo(account, via="siteId", stays="signin")
concept invitationBudget {
  siteId string!
  ownerUserId string!
  minuteStartedAt datetime!
  minuteCount int!
  dayStartedAt datetime!
  dayCount int!
  accountId string
  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// One immutable guest-only recovery alias per call. Its id is the keyed digest of a
/// deterministically derived guest token; no plaintext capability is retained. The
/// original room links remain unchanged. A join still checks the room's current state.
// @no-displayCard: Private capability lookup, returned only by the checked active-host action.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@retention(ttl="1d", keepLatest=true, archive="none")
@belongsTo(account, via="siteId", stays="signin")
concept invitationLink {
  siteId string!
  ownerUserId string!
  roomId string!
  accountId string
  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="forRoom", field="roomId", target=room, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// A discoverable passkey for a calls key. Its public verification material is never a MemQL identity.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="label", secondary="keyId")
@belongsTo(account, via="siteId", stays="signin")
concept credential {
  siteId string!
  ownerUserId string!
  keyId string!
  credentialDigest string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
  credentialData string! @maxLength(16384) @description("JSON of the verified WebAuthn public credential, counter and backup flags; contains no private key.")
  label string! @maxLength(64)
  addedAt datetime!
  lastUsedAt datetime
  revokedAt datetime
  accountId string
  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="forKey", field="keyId", target=key, direction="outgoing")
}

/// Private per-key call history. These rows are metadata, not billing or safety records.
/// Archive expires this projection only. The retention worker removes every physical
/// version after purgeAt, retaining only historyReceipt's keyed suppression id.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId")
@displayCard(primary="title", secondary="startedAt", status="status")
concept history {
  costCents int @description("Final local simulated settlement snapshot for the payer only. Never billing authority; absent means unknown or uncharged legacy mode.")
  siteId string! @description("Deployable v1:platform:site that owns this private projection.")
  ownerUserId string! @description("Platform v1:identity:user owner used for internal row admission, not the participant account.")
  keyId string! @description("Authenticated v1:calls:key whose private history this is.")
  sourceKind enum("room", "booking")! @description("Selects which operational source sourceId identifies.")
  sourceId string! @description("Polymorphic v1:calls:room or v1:calls:scheduledCall id; sourceKind selects the concept and the service verifies site and key authority.")
  title string @maxLength(2048) @description("Plain title snapshot; the service additionally limits UTF-8 bytes and grapheme clusters.")
  role enum("host", "guest")! @description("Host means this key created or booked the call; receiving host controls later does not change this role.")
  status enum("active", "ended", "scheduled", "cancelled")! @description("Most recently observed operational lifecycle; archived snapshots remain fixed until restored.")
  orderKey string! @description("Immutable UTC source timestamp plus opaque digest tie-breaker for keyset pagination.")
  startedAt datetime @description("Persisted room opening time or scheduled start; not the participant join time.")
  endedAt datetime @description("Persisted room ending time, or the terminal unopened booking observation.")
  archivedAt datetime @description("Time the participant explicitly acknowledged archiving this private projection.")
  purgeAt datetime @description("Exact server-confirmed deletion deadline; reads and restores refuse at this instant.")
  accountId string
  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="forKey", field="keyId", target=key, direction="outgoing")
}

/// Minimal suppression receipt. Its id is a keyed digest of key and source, not
/// their ids; it contains no title, participant, call time or source relationship.
/// It stops a bounded repair/backfill from resurrecting purged private history.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId")
// @no-displayCard: Opaque suppression receipt with no human-facing identity or content; the generic administrative fallback is sufficient.
concept historyReceipt {
  siteId string! @description("Deployable v1:platform:site scope retained for internal admission.")
  ownerUserId string! @description("Platform v1:identity:user owner retained for internal row admission.")
  purgeAt datetime @description("Latest confirmed purge deadline. An absent metadata row is not reconstructed after this time.")
  accountId string
  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// Bounded private history repair cursor; no participant or content metadata.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId")
// @no-displayCard: Private bounded-repair cursor with no human-facing identity; it is internal coordination rather than browsable call content.
concept historySync {
  siteId string! @description("Deployable v1:platform:site scope for source repair.")
  ownerUserId string! @description("Platform v1:identity:user owner used for internal row admission.")
  keyId string! @description("Authenticated v1:calls:key whose sources are scanned.")
  phase enum("rooms", "bookings", "seats")! @description("Current bounded source-query phase.")
  afterCursor string @description("Engine-issued opaque source continuation; never a browser cursor or authority.")
  complete bool @description("Whether the first full source cycle completed; partial overview totals stay unavailable until then.")
  accountId string
  @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
  @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", as="forKey", field="keyId", target=key, direction="outgoing")
}

/// A private account commerce journal. One fenced state retains age evidence,
/// provider operation identities and verification costs across key replacement.
/// No card number, ID image, selfie, birth date or legal name is stored here.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@displayCard(primary="keyId", secondary="siteId")
@belongsTo(account, via="siteId", stays="signin")
concept commerceState {
 siteId string!
 ownerUserId string!
 keyId string!
 stateData string! @maxLength(524288)
 accountId string
 @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="forKey", field="keyId", target=key, direction="outgoing")
 @relationship(type="references", as="siteOwner", field="ownerUserId", target=user, direction="outgoing")
}

/// A standing delegated authority and its bounded reservation journal. No bearer
/// secret or provider identity data is retained; native gates validate the payload.
// @no-displayCard: opaque credential digests and policy journal are not a human-facing identity.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
concept delegationState {
  siteId string!
  ownerUserId string!
  keyId string!
  tokenDigest string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
  stateData string! @maxLength(1048576)
  accountId string
  @relationship(type="references", as="delegationKey", field="keyId", target=key, direction="outgoing")
  @relationship(type="references", as="delegationSite", field="siteId", target=site, direction="outgoing")
}

/// Bounded private skill library or authoritative session-run journal.
// @no-displayCard: private native authorization, run instructions and publisher lease state are projected only through the authenticated Calls surface.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
concept workflowState {
 kind enum("library", "run", "booking") @description("Native journal kind; optional for additive compatibility.")
 active bool @description("Native projection: only running, paused or blocked runs need reconciliation.")
 siteId string!
 ownerUserId string!
 keyId string!
 stateData string! @maxLength(1048576)
 accountId string
 @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="forKey", field="keyId", target=key, direction="outgoing")
}

/// Bounded private resource bindings and publication leases; never device credentials.
// @no-displayCard: private native authorization, run instructions and publisher lease state are projected only through the authenticated Calls surface.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
concept resourceState {
 active bool @description("Native projection: an account has an active or uncertain publication lease; absent on pre-release rows.")
 siteId string!
 ownerUserId string!
 keyId string!
 stateData string! @maxLength(1048576)
 accountId string
 @relationship(type="references", as="forSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="forKey", field="keyId", target=key, direction="outgoing")
}

/// Local family supervision/consent journal; never a real parental-consent claim.
// @no-displayCard: private child session bindings and consent receipts are not public identities.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
@retention(ttl="30d", keepLatest=false, archive="none")
concept familyState {
 siteId string!
 ownerUserId string!
 keyId string!
 roomId string!
 kind enum("room", "invitation")!
 tokenDigest string
 sessionId string
 stateData string! @maxLength(65536)
 accountId string
 @relationship(type="references", as="familySite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="familyKey", field="keyId", target=key, direction="outgoing")
 @relationship(type="references", as="familyRoom", field="roomId", target=room, direction="outgoing")
}

/// Native room-scoped agent review journal. No bearer secrets or media stored.
// @no-displayCard: private host approval digests and one-admission authority are protocol state, not human-facing records.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
@retention(ttl="30d", keepLatest=false, archive="none")
concept agentAdmissionState {
 siteId string!
 ownerUserId string!
 roomId string!
 stateData string! @maxLength(262144)
 accountId string
 @relationship(type="references", as="agentAdmissionSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="agentAdmissionRoom", field="roomId", target=room, direction="outgoing")
}

/// Canonical raster portrait metadata. Bytes stay in the private quota-metered
/// blob lane; a bounded native key inventory prevents unbounded abandoned assets.
// @no-displayCard: private agent appearance; access is through the Calls surface.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
concept agentPortrait {
 siteId string!
 ownerUserId string!
 keyId string!
 digest string! @maxLength(64) @pattern("^[0-9a-f]{64}$")
 mimeType enum("image/png", "image/jpeg")!
 width int!
 height int!
 blobRef string @maxLength(2048)
 issuedAt datetime!
 accountId string
 @relationship(type="references", as="portraitSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="portraitKey", field="keyId", target=key, direction="outgoing")
}

/// Native processing authority only. No media, transcription text or model observations persist here.
// @no-displayCard: private consent revisions and trusted sampler leases are authority metadata with no client-visible primary slot.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
@retention(ttl="1d", keepLatest=false, archive="none")
concept processingState {
 siteId string!
 ownerUserId string!
 roomId string!
 stateData string! @maxLength(524288)
 accountId string
 @relationship(type="references", as="processingSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="processingRoom", field="roomId", target=room, direction="outgoing")
}

/// Compact replay protection for one publication track and lease generation. No message text or observations.
// @no-displayCard: private replay hashes and rate counters have no client-visible content or meaningful human-facing primary slot.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
@retention(ttl="1d", keepLatest=false, archive="none")
concept processingReceipt {
 siteId string!
 ownerUserId string!
 roomId string!
 trackId string!
 epoch int!
 receiptData string! @maxLength(4096)
 accountId string
 @relationship(type="references", as="processingReceiptSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="processingReceiptRoom", field="roomId", target=room, direction="outgoing")
}

/// Compact room-wide publication rate counter, serialized by the native room gate.
// @no-displayCard: private replay hashes and rate counters have no client-visible content or meaningful human-facing primary slot.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
@retention(ttl="1d", keepLatest=false, archive="none")
concept processingRate {
 siteId string!
 ownerUserId string!
 roomId string!
 rateSecond int!
 rateCount int!
 accountId string
 @relationship(type="references", as="processingRateSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="processingRateRoom", field="roomId", target=room, direction="outgoing")
}

/// Private participant allegations; immutable explicit expiry is purged by the native report retention sweep.
// @no-displayCard: private allegations and review metadata are never exposed by generic display cards or account exports.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
concept reportCase {
 siteId string!
 ownerUserId string!
 reporterKeyId string!
 reporterActor string! @maxLength(160)
 subjectKeyId string
 roomId string!
 issuedAt datetime!
 expiresAt datetime!
 revision int!
 stateData string! @maxLength(16384)
 accountId string
 @relationship(type="references", as="reportSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="reportRoom", field="roomId", target=room, direction="outgoing")
 @relationship(type="references", as="reporterKey", field="reporterKeyId", target=key, direction="outgoing")
}

/// Immutable private access audit, removed with every case version at its original expiry.
// @no-displayCard: private report access audit is available only to authorized operators, never participant-facing cards.
@serverWritten
@rowAuthz(owner="ownerUserId", clusterOwner)
@belongsTo(account, via="siteId", stays="signin")
concept reportAccessAudit {
 siteId string!
 ownerUserId string!
 caseId string!
 actorId string! @maxLength(256)
 action enum("read", "review")!
 recordedAt datetime!
 expiresAt datetime!
 revision int!
 accountId string
 @relationship(type="references", as="reportAuditSite", field="siteId", target=site, direction="outgoing")
 @relationship(type="references", as="reportAuditCase", field="caseId", target=reportCase, direction="outgoing")
}
