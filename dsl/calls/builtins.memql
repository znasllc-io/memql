// builtins.memql
//
// The calls capability's operator acts, backed by integrations/calls (operator.go). Every
// client-callable act on the calls rows is one of these four: the concepts are @serverWritten and
// client-unreadable, and every query and mutation beneath them is @serverOnly.
//
// WHO MAY CALL. Each declares execute on app:deployables/calls, seeded on owner and developer
// (dsl/rbac/seeds.memql), and the engine refuses every other caller before the executor runs. The two
// that name a deployable (a test key, the site switch) are also judged against THAT deployable's
// organization (organizationCapabilityTarget, component/memql), so the part held in one organization
// acts on no other's deployable, and the handler reads the deployable under the caller, so a person
// who cannot see it is refused by name before anything is written. A policy is keyed by a
// deployable's NAME and media servers are the cluster's: rows no organization owns, judged by the
// capability alone.
//
// A PERSON'S ACTS. Minting a key, switching calls and changing limits refuse a caller who is not a
// person (the operator credential, the cluster acting) and any call inside a run: a run's journal
// would keep a key, and what a deployable allows is an operator's decision. The list is a read.
//
// @sdk, so the OS and tooling call a typed method rather than hand-building a call string.

/// Mint a TEST key for a deployable's calls (calls, plan Task 4).
///
/// THE KEY COMES BACK ONCE. It is in this reply and, if the operator copies it, wherever they put it;
/// the row holds only the HMAC-SHA256 digest of the key's sixteen raw bytes under the cluster's key
/// pepper, so nothing can read it back. A lost key is replaced, never recovered. The key belongs to
/// the deployable's owner, whoever asked, and is a test key: it spends no balance.
///
/// Refused for a deployable the caller cannot read, one with no owner, the cluster's own surfaces, a
/// name over 80 characters, a cluster with no media server (no pepper exists until one is
/// configured), a caller who is not a person, and any call inside a run. Returns {keyId, key}.
@sdk
@executor("integration.calls.testKeyCreate")
@requiresCapability("execute", "app:deployables/calls")
@description("Mint a test calls key for a deployable. Stores only the digest of the key and returns the key once, here and nowhere else; the key belongs to the deployable's owner and spends no balance. Refused for a deployable the caller cannot read, one with no owner, a name over 80 characters, a cluster with no media server, a caller who is not a person and any call inside a run. Returns {keyId, key}.")
builtin callsTestKeyCreate {
  siteId  string!  @description("The deployable the key is for.")
  label   string   @description("The operator's name for the key, at most 80 characters. Never sent to a caller.")
}

/// Turn the calls capability on or off for a deployable (calls, plan Task 4).
///
/// A WRITE OF THE SITE'S `calls` FIELD AS THE PERSON ASKING, through updateSiteCalls, so the engine
/// judges it as any write of theirs: the part, the deployable's organization (whose calls part the
/// change asks, validateOrganizationSensitiveChanges) and the site's own row tier. Turning calls on
/// needs a deployable with an owner, because every call's rows belong to the owner; turning them off
/// does not. Returns {siteId, calls}.
@sdk
@executor("integration.calls.siteEnable")
@requiresCapability("execute", "app:deployables/calls")
@description("Turn the calls capability on or off for a deployable, as the person asking: the write is judged like any write of theirs, the part, the deployable's organization and the site's row tier. Turning calls on needs a deployable with an owner. Refused for a caller who is not a person and any call inside a run. Returns {siteId, calls}.")
builtin callsSiteEnable {
  siteId  string!   @description("The deployable to switch calls on or off for.")
  on      boolean!  @description("True to turn calls on, false to turn them off.")
}

/// Set any of a deployable's calls limits (v1:calls:policy, calls, plan Task 4).
///
/// ONLY WHAT IS NAMED CHANGES. A limit left out keeps the value it had, and one nobody ever set is the
/// shipped default (calls.DefaultPolicy). Counts are whole numbers and DURATIONS ARE WHOLE SECONDS.
/// Each value is held to a range that keeps it meaningful (a room admits at least one person, a pass
/// lives 10 to 900 seconds, a waiter polls at least once a minute and its place outlives a poll);
/// what a deployable allows inside those ranges is the operator's to choose. Returns the effective
/// limits: {policyId, deployable} and one field per limit.
@sdk
@executor("integration.calls.policySet")
@requiresCapability("execute", "app:deployables/calls")
@description("Set any of a deployable's calls limits; a limit not named keeps its value and one never set is the shipped default. Counts are whole numbers and durations are whole seconds, each held to a range that keeps it meaningful. Refused for a caller who is not a person and any call inside a run. Returns the effective limits: {policyId, deployable, maxPeople, maxAgents, roomJoinsPerMinute, maxUpcomingScheduled, maxScheduledMinutes, hostLeftGrace, passTtl, scheduleHorizon, queueEntryTtl, queuePoll}.")
builtin callsPolicySet {
  deployable            string!  @description("The deployable's name the limits apply to, as its package names it.")
  maxPeople             int      @description("People allowed in one room, 1 to 1000.")
  maxAgents             int      @description("Agents allowed in one room, 0 to 100.")
  roomJoinsPerMinute    int      @description("Join attempts allowed per room per minute, 1 to 10000.")
  maxUpcomingScheduled  int      @description("Upcoming scheduled calls allowed per key, 0 to 1000.")
  maxScheduledMinutes   int      @description("The longest a scheduled call may be, in minutes, 1 to 1440.")
  hostLeftGrace         int      @description("How long a room outlives its host, in seconds, 0 to 86400.")
  passTtl               int      @description("How long a pass lives, in seconds, 10 to 900.")
  scheduleHorizon       int      @description("How far ahead a call may be booked, in seconds, 0 to 31622400.")
  queueEntryTtl         int      @description("How long a queue entry may go unpolled, in seconds, 10 to 86400, and longer than queuePoll.")
  queuePoll             int      @description("How often a waiter polls, in seconds, 1 to 60.")
}

/// The media servers rooms are placed on (calls, plan Task 4).
///
/// EVERY ACTIVE SERVER, one row each: {id, provider, apiUrl, publicUrl, region, seats, state,
/// createdAt}. NEVER A CREDENTIAL, and never the name of the secret holding one. `provider` is the
/// value the environment recorded (docker-local or hetzner); nothing decides by it.
@sdk
@executor("integration.calls.mediaServers")
@requiresCapability("execute", "app:deployables/calls")
@description("List the active media servers rooms are placed on, one row each: {id, provider, apiUrl, publicUrl, region, seats, state, createdAt}. Never a credential or the name of the secret holding one.")
builtin callsMediaServers { }
