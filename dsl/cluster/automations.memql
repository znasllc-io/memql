// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@enabled
@trigger(event="system.startup")
@description("Bootstrap cluster, database, and identity provider records on first startup")
@useLogic(logicBootstrapCluster)
automation bootstrapCluster {
  step run {
    logic bootstrapCluster { event: event }
  }
}

// ---- automations/v1/cluster/deregisterNode/automation.memql ----

// Record node shutdown in the database.
// Creates a spawn event with action="stopped".
@enabled
@trigger(event="system.shutdown")
@description("Record node shutdown in the database")
@useLogic(logicDeregisterNode)
automation deregisterNode {
  step run {
    logic deregisterNode { event: event }
  }
}

// ---- automations/v1/cluster/registerNode/automation.memql ----

// Register this node in the database when it starts up.
// Creates a v1:cluster:node record and a spawn event.
// Runs on ALL node types. Safe to run on every restart.
//
// Passes the peer's NodeId as the explicit concept id so later rows
// written by NodeStatusWriter (via updateNodeHealth) share the same
// time-series timeline -- one concept row per real node.
@enabled
@trigger(event="system.startup")
@description("Register this node in the database on startup")
@useLogic(logicRegisterNode)
automation registerNode {
  step run {
    logic registerNode { event: event }
  }
}
