// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.
//
// All four cluster automations are now longhand multi-step blocks: the inline
// graph writes that used to live in their pass-through `logic` (ADR S2.1 logic-
// purity violations, baselined under #2217) now live here as the automation's
// own steps, so no impure `logic` survives (#2235). The four logic-purity
// baseline entries were removed across the migrating PRs (deregisterNode +
// registerNode under PR #2239; bootstrapCluster + pruneStaleClusterNodes here):
//   - deregisterNode / registerNode -- the inline createSpawnEvent / createNode
//     writes became bare `<mutation>{ ... }` mutation steps.
//   - bootstrapCluster -- the pure `bootstrapCluster` logic decides
//     { create, withIdentityProvider }; the three conditional creates moved
//     onto `if`-gated mutation steps (gated on `steps.decide.result.<field> ==
//     true` -- a step-result field resolves in a COMPARISON, not bare-truthy).
//   - pruneStaleClusterNodes -- the pure `pruneStaleClusterNodes` logic returns
//     the rows past the stale window (window math pushed into the query via
//     olderThan); the per-row terminal write moved onto a `forEach` step.
//
// Authoring note (#2235): inside a step, use the bare `<mutation>{ ... }` call
// form -- the `mutate <name>{` keyword form collides with the struct-form
// mutation-DEFINITION rewriter (NormaliseMutationSource matches the header
// anywhere in the file).

use cluster.logic.{ bootstrapCluster, pruneStaleClusterNodes }
use cluster.mutations.{ createCluster, createDatabase, createIdentityProvider, createNode, createSpawnEvent, updateNodeHealth }

// Bootstrap cluster, database, and identity provider records on first startup.
// The pure bootstrapCluster logic decides { create, withIdentityProvider }
// (create == existingCluster() empty AND node.type=="bff"); the three creates
// are `if`-gated mutation steps so nothing is written once a cluster exists or
// off the bff node, and the identityProvider row lands only when the startup
// envelope carries one. Every create field binds an explicit key + coalesce (a
// multi-segment path like event.payload.database.host is nil when absent, and a
// nil @required arg trips validation), mirroring registerNode/deregisterNode.
@trigger(event="system.startup")
@description("Bootstrap cluster, database, and identity provider records on first startup")
automation bootstrapCluster {
  args {
    database any
    identityProvider any
    node any
    provider any
  }

  step decide {
    logic bootstrapCluster (
      event
    )
  }
  // Steps renamed (was database / identityProvider): G2 shadowing rule vs the
  // synthesized args fields of the same names (#2364/#2367).
  step databaseRecord {
    if steps.decide.result == true {
      mutation createDatabase (
        host:    coalesce(database.host, "localhost"),
        dbName:  coalesce(database.dbName, "memql"),
        sslMode: coalesce(database.sslMode, "disable")
      )
    }
  }
  step idpRecord {
    if steps.decide.result == true && exists(payload.identityProvider) {
      mutation createIdentityProvider (
        name:           coalesce(identityProvider.name, "memql-identity"),
        issuerUrl:      coalesce(identityProvider.issuerUrl, ""),
        clientIdPrefix: coalesce(identityProvider.clientIdPrefix, ""),
        redirectUrl:    coalesce(identityProvider.redirectUrl, "")
      )
    }
  }
  step cluster {
    if steps.decide.result == true {
      mutation createCluster (
        name:        "development",
        environment: "development",
        region:      "local",
        provider:    coalesce(provider, ""),
        version:     coalesce(node.version, "")
      )
    }
  }
}

// Record node shutdown in the database: append a v1:cluster:spawnEvent with
// action="stopped", reason="system.shutdown". The former deregisterNode logic
// was a single inline write (ADR S2.1 logic-purity violation); the write now
// lives here as a mutation step and the logic is gone (#2235). Every field is
// bound with an explicit key + coalesce: a multi-segment path like
// event.payload.node.id evaluates to nil when absent, and passing nil for a
// @required mutation arg (nodeId / nodeType / action) trips "required argument
// missing" at validation; coalesce(..., "") guarantees a non-nil string.
@trigger(event="system.shutdown")
@description("Record node shutdown in the database")
automation deregisterNode {
  args {
    node any
  }

  step persist {
    mutation createSpawnEvent (
      nodeId:   coalesce(node.id, ""),
      nodeType: coalesce(node.type, ""),
      action:   "stopped",
      reason:   "system.shutdown"
    )
  }
}

// Register this node in the database when it starts up: a v1:cluster:node record
// + a spawn event. Runs on ALL node types; safe to run on every restart. The
// peer's NodeId is passed as the explicit concept id (createNode.id) so later
// NodeStatusWriter rows (via updateNodeHealth) share the same time-series
// timeline -- one concept row per real node. The former registerNode logic did
// both inline writes (ADR S2.1 logic-purity violation); each write is now its
// own mutation step and the logic is gone (#2235). Every field is bound with an
// explicit key + coalesce for the same reason as deregisterNode above: a
// multi-segment path is nil when absent and would trip the @required check.
// version/address are not createSpawnEvent args (they already live on the node
// record from createNode), so the spawn step carries only the flat event fields.
@trigger(event="system.startup")
@description("Register this node in the database on startup")
automation registerNode {
  args {
    deploymentId any
    environment any
    node any
    provider any
    region any
  }

  // Step renamed record (was node): the G2 shadowing rule (#2364) forbids a
  // step id colliding with the args field of the same name.
  step record {
    mutation createNode (
      id:           coalesce(node.id, ""),
      nodeType:     coalesce(node.type, ""),
      address:      coalesce(node.address, ""),
      deploymentId: coalesce(deploymentId, ""),
      provider:     coalesce(provider, ""),
      environment:  coalesce(environment, ""),
      region:       coalesce(region, "")
    )
  }
  step spawn {
    mutation createSpawnEvent (
      nodeId:   coalesce(node.id, ""),
      nodeType: coalesce(node.type, ""),
      action:   "spawned",
      reason:   "system.startup"
    )
  }
}

// Heartbeat-based prune of departed cluster nodes (#1061). Every 10 minutes,
// mark v1:cluster:node rows whose latest lastSeen is older than
// MEMQL_NODE_STALE_PRUNE_MINUTES (default 30) as health="stopped" so topology /
// CLI / WorkerDialer stop treating dead pods as live. BACKSTOP to the fast
// reconciler (#1874); both append the same idempotent terminal health="stopped".
// Six-field cron (sec min hour dom mon dow): minute 0,10,20,30,40,50.
//
// The pure pruneStaleClusterNodes logic decides WHICH rows to retire (cutoff =
// now - window, pushed into staleClusterNodes via olderThan) and returns that
// node list (#2235). The `prune` forEach step appends the terminal
// health="stopped" row per returned node -- the per-row write that used to live
// inline in the logic. updateNodeHealth takes only id / health / lastSeen.
@trigger(schedule="0 */10 * * * *")
@description("Every 10 min: mark departed cluster nodes (lastSeen older than MEMQL_NODE_STALE_PRUNE_MINUTES, default 30) as health='stopped'.")
automation pruneStaleClusterNodes {
  step decide {
    logic pruneStaleClusterNodes (
      event: event
    )
  }
  step prune {
    forEach node in decide.result {
      updateNodeHealth {
        id:       node.id,
        health:   "stopped",
        lastSeen: now
      }
    }
  }
}
