// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.
//
// All four cluster automations are single-step pass-throughs, so they use the
// terse form `automation NAME @trigger(...) => logic L` (memql#2215 / ADR S2.4),
// which lowers to the canonical `step run { logic L { event: event } }` and
// removes the wrapper ceremony without hiding the reactive surface.

use cluster.logic.{ bootstrapCluster, deregisterNode, pruneStaleClusterNodes, registerNode }

// Bootstrap cluster, database, and identity provider records on first startup.
@enabled
@description("Bootstrap cluster, database, and identity provider records on first startup")
automation bootstrapCluster @trigger(event="system.startup") => logic bootstrapCluster

// Record node shutdown in the database (a spawn event with action="stopped").
@enabled
@description("Record node shutdown in the database")
automation deregisterNode @trigger(event="system.shutdown") => logic deregisterNode

// Register this node in the database when it starts up: a v1:cluster:node record
// + a spawn event. Runs on ALL node types; safe to run on every restart. The
// peer's NodeId is passed as the explicit concept id so later NodeStatusWriter
// rows (via updateNodeHealth) share the same time-series timeline.
@enabled
@description("Register this node in the database on startup")
automation registerNode @trigger(event="system.startup") => logic registerNode

// Heartbeat-based prune of departed cluster nodes (#1061). Every 10 minutes,
// mark v1:cluster:node rows whose latest lastSeen is older than
// MEMQL_NODE_STALE_PRUNE_MINUTES (default 30) as health="stopped" so topology /
// CLI / WorkerDialer stop treating dead pods as live. BACKSTOP to the fast
// reconciler (#1874); both append the same idempotent terminal health="stopped".
// Six-field cron (sec min hour dom mon dow): minute 0,10,20,30,40,50.
@enabled
@description("Every 10 min: mark departed cluster nodes (lastSeen older than MEMQL_NODE_STALE_PRUNE_MINUTES, default 30) as health='stopped'.")
automation pruneStaleClusterNodes @trigger(schedule="0 */10 * * * *") => logic pruneStaleClusterNodes
