// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.
//
// The inline graph writes that used to live in the cluster automations'
// pass-through `logic` (ADR S2.1 logic-purity violations, baselined under
// #2217) are the automations' own statements, so no impure `logic` survives
// (#2235):
//   - deregisterNode / registerNode -- the createSpawnEvent / createNode writes
//     are `mutation` statements.
//   - bootstrapCluster -- the pure `bootstrapCluster` logic decides whether to
//     create the cluster row; the conditional creates are `if`-gated
//     `mutation` statements.
//   - pruneStaleClusterNodes -- the pure `pruneStaleClusterNodes` logic returns
//     the rows past the stale window (window math pushed into the query via
//     olderThan); the per-row terminal write is a `for` statement.

// Bootstrap cluster, database, and identity provider records on startup.
// The pure bootstrapCluster logic decides whether to create (existingCluster()
// empty AND the startup node's type is "bff"), and `decide` gates the cluster
// create, so that row is written once; clusterInfraRefresh gates the database
// and identity-provider creates on every bff start (memql#4766), and the
// identityProvider row lands only when the startup envelope carries one. Every
// create field binds an explicit key + a `??` fallback (a multi-segment path
// like args.database.host is nil when absent, and a nil @required arg trips
// validation), mirroring registerNode/deregisterNode.
/// Bootstrap cluster, database, and identity provider records on first startup
@trigger(event="system.startup")
automation bootstrapCluster {
  args {
    database any
    identityProvider any
    node any
    provider any
  }

  decide := logic bootstrapCluster(event: event)
  // The infrastructure rows answer a DIFFERENT question from the cluster row,
  // so they get a different gate (memql#4766). `decide` is "create the cluster",
  // once per lifetime; this is "what is true about the infrastructure now",
  // every time a bff starts. Sharing one gate is what made these rows
  // uncompletable.
  refreshInfra := logic clusterInfraRefresh(event: event)
  // ===========================================================================
  // THE THREE IDS ARE LITERALS, AND THAT IS WHAT MAKES THE LINKS POSSIBLE
  // ===========================================================================
  // Each of these rows is a SINGLETON -- one cluster, one database, one
  // identity provider -- so a deterministic id is not a shortcut, it is the
  // accurate statement.
  //
  // It is also the only way the cross-links can be written here at all. Before
  // memql#4766 `cluster.databaseId`, `cluster.identityProviderId` and both
  // children's `clusterId` were empty, leaving NO path from the cluster
  // singleton to either row in any direction. Filling them from generated ids
  // would need each write to hand its inserted id to the next; with literals
  // every write already knows all three.
  //
  // The ids are spelled out at each call. A statement could bind each once
  // (`clusterId := "v1:cluster:cluster:self"`); a constant that appears three
  // times is still one decision, and each write stays readable alone.
  if refreshInfra == true {
    databaseRecord := mutation createDatabase(
      databaseId:        "v1:cluster:database:primary",
      clusterId:         "v1:cluster:cluster:self",
      host:              args.database.host ?? "localhost",
      dbName:            args.database.dbName ?? "memql",
      sslMode:           args.database.sslMode ?? "disable",
      // Forwarded rather than stamped: createDatabase used to hardcode 5432
      // while the DSN parse had the real value in this very payload.
      port:              args.database.port ?? 5432,
      // Probed from the live connection at startup (app/cluster.go). Absent
      // when the probe could not run, which is why each has a fallback
      // rather than making the write conditional -- a database row with no
      // version is still worth having.
      engineVersion:     args.database.engineVersion ?? "",
      extensions:        args.database.extensions ?? [],
      extensionVersions: args.database.extensionVersions ?? {}
    )
  }
  if refreshInfra == true && args.identityProvider != nil {
    idpRecord := mutation createIdentityProvider(
      identityProviderId: "v1:cluster:identityProvider:primary",
      clusterId:          "v1:cluster:cluster:self",
      name:               args.identityProvider.name ?? "memql-identity",
      issuerUrl:          args.identityProvider.issuerUrl ?? "",
      clientIdPrefix:     args.identityProvider.clientIdPrefix ?? "",
      redirectUrl:        args.identityProvider.redirectUrl ?? "",
      // These two were COMPUTED by parseIdentityProviderInfo and dropped
      // here -- the call forwarded four fields out of six (memql#4766).
      acceptedAudiences:  args.identityProvider.acceptedAudiences ?? [],
      jwksUrl:            args.identityProvider.jwksUrl ?? ""
    )
  }
  if decide == true {
    cluster := mutation createCluster(
      clusterId:          "v1:cluster:cluster:self",
      name:               "memql",
      region:             "local",
      provider:           args.provider ?? "",
      version:            args.node.version ?? "",
      // createCluster has always ACCEPTED these and the automation never
      // passed them, which is half of why the links were dead.
      databaseId:         "v1:cluster:database:primary",
      identityProviderId: "v1:cluster:identityProvider:primary"
    )
  }
}

// Record node shutdown in the database: append a v1:cluster:spawnEvent with
// action="stopped", reason="system.shutdown". The former deregisterNode logic
// was a single inline write (ADR S2.1 logic-purity violation); the write is
// now this automation's `mutation` statement and the logic is gone (#2235). Every field is
// bound with an explicit key + a `??` fallback: a multi-segment path like
// args.node.id evaluates to nil when absent, and passing nil for a @required
// mutation arg (nodeId / nodeType / action) trips "required argument missing"
// at validation; `?? ""` guarantees a non-nil string.
/// Record node shutdown in the database
@trigger(event="system.shutdown")
automation deregisterNode {
  args {
    node any
  }

  persist := mutation createSpawnEvent(
    nodeId:   args.node.id ?? "",
    nodeType: args.node.type ?? "",
    action:   "stopped",
    reason:   "system.shutdown"
  )
}

// Register this node in the database when it starts up: a v1:cluster:node record
// + a spawn event. Runs on ALL node types; safe to run on every restart. The
// peer's NodeId is passed as the explicit concept id (createNode.id) so later
// NodeStatusWriter rows (via updateNodeHealth) share the same time-series
// timeline -- one concept row per real node. The former registerNode logic did
// both inline writes (ADR S2.1 logic-purity violation); each write is now its
// own `mutation` statement and the logic is gone (#2235). Every field is bound with an
// explicit key + a `??` fallback for the same reason as deregisterNode above: a
// multi-segment path is nil when absent and would trip the @required check.
// version/address are not createSpawnEvent args (they already live on the node
// record from createNode), so the `spawn` statement carries only the flat event fields.
/// Register this node in the database on startup
@trigger(event="system.startup")
automation registerNode {
  args {
    deploymentId any
    node any
    provider any
    region any
  }

  record := mutation createNode(
    id:           args.node.id ?? "",
    nodeType:     args.node.type ?? "",
    address:      args.node.address ?? "",
    deploymentId: args.deploymentId ?? "",
    provider:     args.provider ?? "",
    region:       args.region ?? ""
  )
  spawn := mutation createSpawnEvent(
    nodeId:   args.node.id ?? "",
    nodeType: args.node.type ?? "",
    action:   "spawned",
    reason:   "system.startup"
  )
}

// Heartbeat-based prune of departed cluster nodes (#1061). Every 10 minutes,
// mark v1:cluster:node rows whose latest lastSeen is older than
// MEMQL_NODE_STALE_PRUNE_MINUTES (default 30) as health="stopped" so topology /
// CLI / WorkerDialer stop treating dead pods as live. BACKSTOP to the fast
// reconciler (#1874); both append the same idempotent terminal health="stopped".
// Six-field cron (sec min hour dom mon dow): minute 0,10,20,30,40,50.
//
// The pure pruneStaleClusterNodes logic decides WHICH rows to retire (cutoff =
// now - window, pushed into staleClusterNodes via olderThan) and returns that
// node list (#2235). A `for` over the returned nodes appends the terminal
// health="stopped" row per node -- the per-row write that used to live inline
// in the logic. updateNodeHealth takes only id / health / lastSeen.
/// Every 10 min: mark departed cluster nodes (lastSeen older than MEMQL_NODE_STALE_PRUNE_MINUTES,
/// default 30) as health='stopped'.
@trigger(schedule="0 */10 * * * *")
automation pruneStaleClusterNodes {
  decide := logic pruneStaleClusterNodes(event: event)
  for node in decide {
    mutation updateNodeHealth(
      id:       node.id,
      health:   "stopped",
      lastSeen: now
    )
  }
}

// Manual entry only. This core template is embedded with the engine; an
// instance configures release credentials and repository, never a replacement
// definition. The builtin enforces the owner role before reading credentials.

/// Publish the exact repository, commit and version an owner reviewed with releaseCut(dryRun: true).
/// No trigger or schedule publishes releases. Changed candidates refuse before a tag is created.
@template
automation publishEngineRelease {
  args {
    bump enum("major", "minor", "patch")!
    expectedRepository string!
    expectedSha string!
    expectedVersion string!
    notes string
  }

  published := builtin releaseCut(
    bump: args.bump,
    expectedRepository: args.expectedRepository,
    expectedSha: args.expectedSha,
    expectedVersion: args.expectedVersion,
    notes: args.notes,
    dryRun: false
  )
}

/// Compose a release cut under the adapter's owner-authorized, exact-candidate scope.
/// The public releaseCut builtin enters this workflow after resolving the actor.
@template
automation releaseCutWorkflow {
  args {
    dryRun bool!
    bumpExtensionPin bool!
  }
  snapshot := builtin releaseReadSnapshot()
  if snapshot.tagsAtHead.count() > 0 { builtin releaseRejectCandidate(code: "already_released_at_head") }
  if snapshot.versions.count() == 0 { builtin releaseRejectCandidate(code: "no_release_tags") }
  builtin releaseSelectCandidate(previousTag: snapshot.versions.first())
  builtin releaseCheckVersion()
  if args.dryRun {
    builtin releaseMarkDryRun()
    return
  }
  builtin releaseCreateTag()
  builtin releasePublishTag()
  if args.bumpExtensionPin {
    builtin releaseOpenExtensionPin()
  }
  builtin releaseRecordCut()
}

/// Prepare immutable release evidence for a separate owner approval.
/// Publication is not available in this scope. A failed preparation retains
/// its durable record and pins so another replica can resume or retire it.
@template
automation releasePrepareCandidateWorkflow {
  facts := builtin releaseCandidateEvidence()
  if facts.modes.count() == 0 || facts.modes.any(mode => mode != "full") {
    builtin releaseCandidateRefuse()
  }
  // Empty package selections are explicitly planned skips, not executed tests.
  // A carried earlier attempt requires its original receipt chain and is not
  // accepted by this recipe. Blocked or undeclared skips fail natively.
  if facts.skipped.any(item => item.code != "pipeline_not_affected") {
    builtin releaseCandidateRefuse()
  }
  builtin releaseCandidateCheckVersions()
  builtin releaseCandidateCheckTargets()
  builtin releaseCandidateRecordPreparing()
  builtin releaseCandidatePinArtifacts()
  builtin releaseCandidateVerifyArtifacts()
  builtin releaseCandidateMarkReady()
}

/// Publish one artifact from a separately approved immutable candidate.
/// The native scope binds the owner, approval, target and durable effect ID.
@template
automation releasePublishCandidateWorkflow {
  builtin releasePublicationCheckCandidate()
  effect := builtin releasePublicationBegin()
  if effect.complete { return }
  builtin releasePublicationVerifyImage()
  builtin releasePublicationWriteImage()
  builtin releasePublicationRecordReceipt()
}
