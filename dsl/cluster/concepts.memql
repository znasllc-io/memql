// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// A MemQL cluster -- the top-level deployment unit consisting of a shared database and seed nodes
/// (bff, cognition, planner). Partitions exist within a cluster for data isolation.
@displayCard(primary="name", secondary="provider", tertiary="region", status="status")
concept cluster {
  name              string! @description("Cluster name (e.g., 'development', 'staging-us-central1').")
  region            string  @description("Cloud region (e.g., 'us-central1') or 'local' for development.")
  seedNodeTypes     []string  @description("Required node types for this cluster (e.g., ['bff', 'cognition', 'planner']).")
  status            enum("bootstrapping", "healthy", "degraded", "shutting_down")  @default("bootstrapping") @description("Current cluster health status.")
  databaseId        string  @description("Node ID of the v1:cluster:database record for this cluster's database.")
  identityProviderId  string  @description("Node ID of the v1:cluster:identityProvider record.")
  version           string  @description("MemQL version running on this cluster.")
  provider          string  @description("Cloud provider / deploy target backing this cluster: 'docker-local' (local Docker) or 'azure' (AKS). Empty until stamped by the deploy driver (#1872).")

  @relationship(type="owns", field="databaseId", target=database, direction="outgoing")
  @relationship(type="owns", field="identityProviderId", target=identityProvider, direction="outgoing")
}

// ---- concepts/v1/cluster/database/concept.memql ----

/// A PostgreSQL database instance backing a MemQL cluster. Tracks connection info, engine version,
/// and installed extensions.
@displayCard(primary="dbName", secondary="engine", tertiary="host", status="status")
concept database {
  host              string! @description("Database hostname (e.g., 'postgres', 'tiger-cloud-abc.timescaledb.io').")
  port              int     @default("5432") @description("Database port.")
  dbName            string! @description("Database name (e.g., 'memql').")
  engine            string! @description("Database engine identifier (e.g., 'postgresql').")
  engineVersion     string  @description("Engine version (e.g., '16.4').")
  extensions        []string  @description("Installed extensions (e.g., ['timescaledb', 'vector', 'uuid-ossp', 'pgcrypto']).")
  extensionVersions object  @description("Extension version map (e.g., {'timescaledb': '2.25.2', 'vector': '0.8.2'}).")
  status            enum("healthy", "degraded", "unreachable")  @default("healthy") @description("Current database health status.")
  sslMode           string  @description("SSL mode: 'disable', 'require', 'verify-full'.")
  clusterId         string  @description("Node ID of the parent v1:cluster:cluster record.")

  @relationship(type="parent", field="clusterId", target=cluster, direction="outgoing")
}

// ---- concepts/v1/cluster/identityProvider/concept.memql ----

/// An identity provider used for authentication and user management in a MemQL cluster. Typically
/// the in-house identity service (component/identity), surfaced for cluster-topology dashboards.
@displayCard(primary="name", secondary="providerType", tertiary="issuerUrl", status="status")
concept identityProvider {
  name              string! @description("Provider name (e.g., 'MemQL Identity').")
  providerType      enum("oidc", "saml", "ldap")! @default("oidc") @description("Authentication protocol.")
  issuerUrl         string! @description("Token issuer URL (e.g., 'https://auth.example.com/').")
  clientIdPrefix    string  @description("First 8 characters of the OAuth client ID (non-secret, for identification). Empty for the in-house identity service.")
  acceptedAudiences []string  @description("List of accepted token audiences.")
  redirectUrl       string  @description("OAuth callback URL configured for this provider.")
  jwksUrl           string  @description("URL of the public-key JWKS document used for token verification.")
  status            enum("connected", "degraded", "disconnected")  @default("connected") @description("Current connectivity status.")
  lastVerifiedAt    datetime  @description("Timestamp of last successful JWKS/metadata refresh.")
  clusterId         string  @description("Node ID of the parent v1:cluster:cluster record.")

  @relationship(type="parent", field="clusterId", target=cluster, direction="outgoing")
}

/// A registered node in the MemQL cluster. The record is written on registration and updated on
/// every liveness transition (connecting, healthy, degraded, draining, offline, stopped). States
/// mirror the NodeHealthStatus enum defined in component/node/node.proto -- that proto is the
/// source of truth.
@displayCard(primary="id", secondary="nodeType", tertiary="address", status="health")
concept node {
  nodeType      string! @description("Node role: bff, voice, cognition, agent, planner.")
  flavor        string  @description("Domain flavor within the node type. Empty for single-flavor types like cognition.")
  address       string! @description("Advertised NodeService gRPC address for peer connections.")
  parentId      string  @description("Node ID of the peer this node discovered via DB-based topology. Empty for the first node in a cluster.")
  health        enum("connecting", "healthy", "degraded", "draining", "offline", "stopped")  @default("connecting") @description("Last known health status. Mirrors NodeHealthStatus enum in node.proto.")
  lastSeen      datetime  @description("ISO 8601 timestamp of the most recent heartbeat (or registration if none received yet).")
  capabilities  []string  @description("Fully qualified capability names this node offers (e.g. integration.cognition.scoreUtterance).")
  labels        object  @description("Arbitrary metadata key-value pairs.")
  deploymentId  string  @description("Stable id of the deployment that created this node (#1873). Injected at registration from the rollout (MEMQL_DEPLOYMENT_ID; downward-API pod/rollout template hash in k8s, 'local' in dev). Plain string FK to v1:cluster:deployment.deploymentId -- a deployment's topology is every node with the same deploymentId, and a node whose deploymentId != the cluster's current deployment is an orphan from a previous deploy (feeds the reaper #1874 + cockpit orphan highlight).")
  provider      string  @description("Cloud provider / deploy target backing this node: 'docker-local' (local Docker) or 'azure' (AKS). Stamped at registration from the system.startup payload (#1873).")
  region        string  @description("Cloud region (e.g. 'us-central1') or 'local'. Stamped at registration from MEMQL_REGION (#1873).")
}

/// Definition of a node type and its expected capabilities.
@displayCard(primary="name", secondary="description", tertiary="image")
concept nodeType {
  name          string! @description("Node type identifier: bff, voice, cognition, agent, planner.")
  description   string  @description("Human-readable description of this node type's purpose.")
  image         string  @description("Container image reference for this node type (e.g. gcr.io/project/memql-cognition:latest).")
  capabilities  []string  @description("Expected capability FQNs that nodes of this type should expose.")
  defaultLabels object  @description("Default labels applied to spawned instances of this type.")
  codeReference string  @description("Optional architecture-model node id (model.Node.ID, e.g. 'service:memql') linking this node type to its code-side identity. Cockpit's Topology view uses this to bridge the live cluster grid and the architecture-model drill-down: selecting a live node finds the matching code-side service and jumps the navigator to that drill point.")
}

/// Lifecycle event recording node state transitions (started, stopped, failed). Used for audit
/// trail and cluster state recovery. Legacy name retained for data compatibility.
@displayCard(primary="action", secondary="nodeId", tertiary="reason", status="action")
concept spawnEvent {
  nodeId        string! @description("ID of the node this event pertains to.")
  nodeType      string! @description("Type of the node: bff, cognition, agent, planner.")
  action        enum("spawned", "stopped", "failed")! @description("What happened to the node.")
  initiatorId   string  @description("ID of the node that triggered this event.")
  reason        string  @description("Human-readable reason for the event (e.g. shutdown signal, health check failure).")
  metadata      object  @description("Additional context about the event.")
}

// The trainingResult concept -- the ephemeral per-run summary node returned by
// the trainAgent + trainAgentRetryStep capability handlers -- MOVED to the
// product pack (the carrier repo's pack concepts file)
// alongside the training integration it belongs to (P2 engine/product
// decouple). The concept id is UNCHANGED (v1:cluster:trainingResult -- it
// retains @namespace("cluster"), since the id is assembled from the
// annotations, not the file location), so every stored row + wire reference
// stays byte-identical. The pure engine no longer loads it.

// The deploy DATA model -- the `deployment` + `deploymentNodeSpec` concepts --
// was CENTRALIZED into the cohesive deployment pack by I11 (#2225): see
// dsl/deployment/concepts.memql. The concept ids are unchanged
// (v1:cluster:deployment / v1:cluster:deploymentNodeSpec -- still @namespace
// "cluster", since the id is assembled from the annotations, not the directory),
// so every consumer (the deployEngineCluster trigger, the createDeployment /
// updateDeploymentStatus mutations, component/deploycontrol, the cockpit deploy
// command, the SDK) is unaffected. The cluster topology queries that read a
// node's payload.deploymentId (nodesForDeployment / nodesNotInDeployment) stay
// here with the v1:cluster:node concept they project.

/// One release cut of MemQL itself: the tag and published GitHub Release that make the CI cascade
/// (dispatch-engine-images-on-release.yml, #2519) build every node image at that version. Written
/// only by integrations/release, and append-only -- the row id is the VERSION, so every status
/// transition appends to that version's own timeline and a cut is never edited into a different one.
///
/// WHY THE ROW IS HISTORY AND NOT THE ANSWER TO "WHAT IS NEWEST". GitHub's tags are. A human who
/// cuts a release by hand -- which release.sh's break-glass path still allows -- creates a tag this
/// concept never hears about, so a reader that trusted the newest row would name a version that is
/// no longer the latest and be confidently wrong. The portal card reads TAGS for "newest existing"
/// and these rows only for "what did this cluster do", which is a division the card states in words.
///
/// STATUS IS WHAT WE VERIFIED, NOT WHAT WE EXPECT. `dispatched` means the Release published and the
/// cascade was handed the version; it does NOT claim the images exist. Only an actual GHCR manifest
/// check moves a row to `images_available` (releaseCutStatus, D5), and a check that ERRORED leaves
/// the row where it was rather than guessing -- the workflow can fail after the Release publishes,
/// and the registry is the only thing that knows.
@displayCard(primary="version", secondary="bump", tertiary="requestedByEmail", status="status")
@rowAuthz(clusterOwner)
concept releaseCut {
  version        string!  @description("The version cut, in git-tag form (vX.Y.Z). ALSO the row id: one timeline per cut, so the append-only status transitions of one version stay one row's history. The image tags carry the BARE form without the leading v (memql#4061's two-conventions rule) -- this field is the tag, never the image tag.")
  bump           enum("major", "minor", "patch")!  @description("Which part of the previous version was incremented to reach this one. Recorded because it is the operator's INTENT, and intent is not recoverable from the two versions alone once a hand-cut tag lands between them.")
  baseSha        string!  @description("The main-branch commit sha the tag was created at, read from GitHub at cut time. This is what makes a cut reproducible: the version alone does not say what shipped, and the tag can be deleted.")
  requestedBy    string!  @description("v1:identity:user.id of the owner who cut this release. Server-derived from the authenticated actor -- never an argument, because a caller-supplied value here would let one owner write another's name into the release history.")
  requestedByEmail  string  @description("Email of the requester at cut time, denormalized so the history stays readable after the user row changes or is deleted. The same reasoning as v1:identity:auditEvent.actorEmail.")
  status         enum("dispatched", "tag_created_release_failed", "images_available", "failed")!  @description("dispatched = tag created and Release published, cascade handed the version, images NOT yet verified. tag_created_release_failed = the HALF-DONE state: the tag exists and the Release does not, so nothing fired and a human must finish or delete the tag. images_available = a GHCR manifest check found every image at this version. failed = nothing was created.")
  releaseUrl     string  @description("html_url of the published GitHub Release. Empty when the cut did not get that far.")
  tagName        string  @description("The git tag that exists even when the Release did not publish -- the one fact a human needs to finish or delete a half-done cut. Duplicates `version` on the happy path and is deliberately NOT derived from it: on tag_created_release_failed it is the only evidence that something was created.")
  error          string  @description("The typed refusal code plus its message, when the cut failed or a status check errored. Never a credential: refusals name the VARIABLE to seed, never its value.")
  pinBumpPrUrl   string  @description("html_url of the follow-on PR bumping the VS Code extension's DEFAULT_STACK_TAG, when bumpExtensionPin was asked for and the PR opened. Empty when it was not asked for.")
  pinBumpNote    string  @description("Why the pin-bump PR did not open, when it was asked for and could not. A PR that cannot be opened degrades to this note and NEVER fails the cut -- the release is already published by then, and failing the call would report a cut that happened as a cut that did not.")
  dispatchedAt   datetime  @description("When the Release published.")
  checkedAt      datetime  @description("When a GHCR manifest check last ran for this version. Empty until someone asks -- the check is on demand, with no poller.")
}
