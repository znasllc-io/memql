// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@version("1.0.0")
@namespace("cluster")
@description("A memQL cluster -- the top-level deployment unit consisting of a shared database and seed nodes (bff, cognition, planner). Partitions exist within a cluster for data isolation.")
concept cluster {
  name              string  @required @description("Cluster name (e.g., 'development', 'staging-us-central1').")
  region            string  @description("Cloud region (e.g., 'us-central1') or 'local' for development.")
  environment       enum("development", "staging", "production")  @required @description("Deployment environment.")
  seedNodeTypes     []string  @description("Required node types for this cluster (e.g., ['bff', 'cognition', 'planner']).")
  status            enum("bootstrapping", "healthy", "degraded", "shutting_down")  @default("bootstrapping") @description("Current cluster health status.")
  databaseId        string  @description("Node ID of the v1:cluster:database record for this cluster's database.")
  identityProviderId  string  @description("Node ID of the v1:cluster:identityProvider record.")
  version           string  @description("memQL version running on this cluster.")
  provider          string  @description("Cloud provider / deploy target backing this cluster: 'docker-local' (local Docker) or 'azure' (AKS). Empty until stamped by the deploy driver (#1872).")
}

// ---- concepts/v1/cluster/database/concept.memql ----

@version("1.0.0")
@namespace("cluster")
@description("A PostgreSQL database instance backing a memQL cluster. Tracks connection info, engine version, and installed extensions.")
concept database {
  host              string  @required @description("Database hostname (e.g., 'postgres', 'tiger-cloud-abc.timescaledb.io').")
  port              int     @default("5432") @description("Database port.")
  dbName            string  @required @description("Database name (e.g., 'memql').")
  engine            string  @required @description("Database engine identifier (e.g., 'postgresql').")
  engineVersion     string  @description("Engine version (e.g., '16.4').")
  extensions        []string  @description("Installed extensions (e.g., ['timescaledb', 'vector', 'uuid-ossp', 'pgcrypto']).")
  extensionVersions object  @description("Extension version map (e.g., {'timescaledb': '2.25.2', 'vector': '0.8.2'}).")
  status            enum("healthy", "degraded", "unreachable")  @default("healthy") @description("Current database health status.")
  sslMode           string  @description("SSL mode: 'disable', 'require', 'verify-full'.")
  clusterId         string  @description("Node ID of the parent v1:cluster:cluster record.")
}

// ---- concepts/v1/cluster/identityProvider/concept.memql ----

@version("1.0.0")
@namespace("cluster")
@description("An identity provider used for authentication and user management in a memQL cluster. Typically the in-house identity service (component/identity), surfaced for cluster-topology dashboards.")
concept identityProvider {
  name              string  @required @description("Provider name (e.g., 'memQL Identity').")
  providerType      enum("oidc", "saml", "ldap")  @required @default("oidc") @description("Authentication protocol.")
  issuerUrl         string  @required @description("Token issuer URL (e.g., 'https://auth.example.com/').")
  clientIdPrefix    string  @description("First 8 characters of the OAuth client ID (non-secret, for identification). Empty for the in-house identity service.")
  acceptedAudiences []string  @description("List of accepted token audiences.")
  redirectUrl       string  @description("OAuth callback URL configured for this provider.")
  jwksUrl           string  @description("URL of the public-key JWKS document used for token verification.")
  status            enum("connected", "degraded", "disconnected")  @default("connected") @description("Current connectivity status.")
  lastVerifiedAt    datetime  @description("Timestamp of last successful JWKS/metadata refresh.")
  clusterId         string  @description("Node ID of the parent v1:cluster:cluster record.")
}

@version("1.0.0")
@namespace("cluster")
@description("A registered node in the memQL cluster. The record is written on registration and updated on every liveness transition (connecting, healthy, degraded, draining, offline, stopped). States mirror the NodeHealthStatus enum defined in component/node/node.proto -- that proto is the source of truth.")
concept node {
  nodeType      string  @required @description("Node role: bff, voice, cognition, agent, planner.")
  flavor        string  @description("Domain flavor within the node type. Empty for single-flavor types like cognition.")
  address       string  @required @description("Advertised NodeService gRPC address for peer connections.")
  parentId      string  @description("Node ID of the peer this node discovered via DB-based topology. Empty for the first node in a cluster.")
  health        enum("connecting", "healthy", "degraded", "draining", "offline", "stopped")  @default("connecting") @description("Last known health status. Mirrors NodeHealthStatus enum in node.proto.")
  lastSeen      datetime  @description("ISO 8601 timestamp of the most recent heartbeat (or registration if none received yet).")
  capabilities  []string  @description("Fully qualified capability names this node offers (e.g. integration.cognition.scoreUtterance).")
  labels        object  @description("Arbitrary metadata key-value pairs.")
}

@version("1.0.0")
@namespace("cluster")
@description("Definition of a node type and its expected capabilities.")
concept nodeType {
  name          string  @required @description("Node type identifier: bff, voice, cognition, agent, planner.")
  description   string  @description("Human-readable description of this node type's purpose.")
  image         string  @description("Container image reference for this node type (e.g. gcr.io/project/memql-cognition:latest).")
  capabilities  []string  @description("Expected capability FQNs that nodes of this type should expose.")
  defaultLabels object  @description("Default labels applied to spawned instances of this type.")
  codeReference string  @description("Optional architecture-model node id (model.Node.ID, e.g. 'service:memql') linking this node type to its code-side identity. Cockpit's Topology view uses this to bridge the live cluster grid and the architecture-model drill-down: selecting a live node finds the matching code-side service and jumps the navigator to that drill point.")
}

@version("1.0.0")
@namespace("cluster")
@description("Lifecycle event recording node state transitions (started, stopped, failed). Used for audit trail and cluster state recovery. Legacy name retained for data compatibility.")
concept spawnEvent {
  nodeId        string  @required @description("ID of the node this event pertains to.")
  nodeType      string  @required @description("Type of the node: bff, cognition, agent, planner.")
  action        enum("spawned", "stopped", "failed")  @required @description("What happened to the node.")
  initiatorId   string  @description("ID of the node that triggered this event.")
  reason        string  @description("Human-readable reason for the event (e.g. shutdown signal, health check failure).")
  metadata      object  @description("Additional context about the event.")
}

@version("1.0.0")
@namespace("cluster")
@description("Ephemeral result node returned by trainAgent + trainAgentRetryStep capability handlers. Carries the per-run summary (counts of chunks indexed, identity-vector + system-prompt write status, retry-plan ids when the in-handler retry exhausted, elapsed wall-clock). The frontend reads this off the bundle to render the in-card success toast; the same fields also land on the training.completed canvas card for the historical record. Not intended to be queried -- it's a transit container, not a persisted entity. Cache TTL 0 + skipDeleted matches the other Plan/Task lifecycle concepts.")
concept trainingResult {
  agentId             string  @required @description("v1:agents:agent.id this result describes.")
  agentName           string  @description("Display name of the agent at the time of training. Surfaced in toasts + cards so the UI doesn't have to re-fetch.")
  domainsAdded        int     @description("Domains in the new set that weren't on the agent before.")
  domainsRemoved      int     @description("Domains in the old set that aren't in the new set.")
  chunksEmbedded      int     @description("Chunks the embedding loop pre-warmed during this run.")
  chunksAlready       int     @description("Chunks that were already in node_vectors and didn't need re-embedding.")
  identityVectorWrote bool    @description("Step B (per-agent identity embedding) succeeded.")
  systemPromptWrote   bool    @description("Step C (distilled system prompt) succeeded.")
  elapsedMs           int     @description("Wall-clock duration of the trainAgent handler.")
  identityRetryPlanId string  @description("trainAgentRetryStep Plan id queued by the backend when Step B failed after the in-handler retry. Empty when Step B succeeded.")
  distillRetryPlanId  string  @description("trainAgentRetryStep Plan id queued by the backend when Step C failed after the in-handler retry. Empty when Step C succeeded.")
  identityError       string  @description("Step B's error message when identityVectorWrote is false. Empty when Step B succeeded.")
  distillError        string  @description("Step C's error message when systemPromptWrote is false. Empty when Step C succeeded.")
  step                string  @description("For trainAgentRetryStep results: which step was retried ('identityVector' or 'distillPrompt'). Empty for the main trainAgent capability.")
}

@version("1.0.0")
@namespace("cluster")
@description("A persisted deployment record (foundation of epic #1871, issue #1872). Append-only + time-series like the other cluster concepts: the row is written at deploy start (pending/in_progress) and every status transition appends a new payload version under the SAME concept id (the deploymentId, which is also the rollout hash) -- so the full lifecycle is reconstructable asOf any time, and `asOf latest` collapses to the deployment's current status. The CDC path emits graph.node.created/updated.<partition>.v1:cluster:deployment on every write, which the cockpit Deployments view subscribes to (same mechanism v1:cluster:node uses for live topology). The image digest -- previously only in releases/*.yaml on disk -- now lands in the data layer so history, node<->deploy linkage, next-version suggestion, and rollback can all be served from a query.")
concept deployment {
  deploymentId         string  @required @description("Stable deployment id; also the Argo rollout hash. Used as the concept row id so status transitions append to one timeline.")
  status               enum("pending", "in_progress", "succeeded", "failed", "superseded", "rolled_back")  @default("pending") @description("Deployment lifecycle status. pending -> in_progress -> succeeded | failed; succeeded -> superseded when a newer deploy promotes; any -> rolled_back on an explicit rollback.")
  version              string  @description("memQL semver being deployed (e.g. '2026.6.21').")
  imageDigest          string  @description("Resolved container image digest for this deploy (sha256:...). Empty until the build/lockfile resolves it.")
  provider             string  @description("Deploy target / cloud provider: 'docker-local' (local Docker) or 'azure' (AKS).")
  environment          enum("development", "staging", "production")  @description("Target environment for this deployment.")
  region               string  @description("Cloud region (e.g. 'us-central1') or 'local'.")
  clusterId            string  @description("Node id of the v1:cluster:cluster this deployment targets. Plain string FK (not a @relationship -- cross-concept references use FK fields).")
  triggeredBy          string  @description("v1:identity:user.id of the operator who initiated the deploy.")
  updatedAt            datetime  @description("Timestamp of the most recent status transition. The row intrinsic createdAt carries the deploy-start time.")
  notes                string  @description("Optional free-form operator notes.")
  changelog            string  @description("Optional changelog / release-notes summary for this version.")
  previousDeploymentId string  @description("Optional deploymentId of the deploy this one supersedes. Plain string FK (not a @relationship).")
}
