// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// ---- logic/v1/cluster/bootstrapCluster.memql ----

// Bootstrap the cluster's self-representation in the database on first startup.
// Creates records for the cluster, its database, and its identity provider.
// Only BFF nodes run this. Idempotent: skips if cluster already exists.
use cluster.mutations.{ mutationCreateCluster, mutationCreateDatabase, mutationCreateIdentityProvider, mutationCreateNode, mutationCreateSpawnEvent, mutationUpdateNodeHealth }
use cluster.queries.{ queryExistingCluster, queryStaleClusterNodes }
use platform.queries.{ queryGlobalVariable }

@description("Bootstraps the cluster's self-representation on first startup. Creates v1:cluster:cluster + v1:cluster:database + v1:cluster:identityProvider rows when no cluster row exists. Only BFF nodes run the create path. Idempotent: skips entirely if a cluster row already exists.")
logic logicBootstrapCluster {
  args {
    event object @required
  }
  body {
  // Check if cluster already exists.
  existing := queryExistingCluster()

  // Create the database record (only if cluster doesn't exist and this is the BFF node).
  dbRecord := if existing.Empty() && args.event.payload.node.type == "bff" {
    mutationCreateDatabase({
      host:    coalesce(args.event.payload.database.host, "localhost"),
      dbName:  coalesce(args.event.payload.database.dbName, "memql"),
      sslMode: coalesce(args.event.payload.database.sslMode, "disable")
    })
  }

  // Create the identity provider record (only if cluster doesn't exist and provider configured).
  idpRecord := if existing.Empty() && args.event.payload.node.type == "bff" && args.event.payload.identityProvider != nil {
    mutationCreateIdentityProvider({
      name:           coalesce(args.event.payload.identityProvider.name, "memql-identity"),
      issuerUrl:      coalesce(args.event.payload.identityProvider.issuerUrl, ""),
      clientIdPrefix: coalesce(args.event.payload.identityProvider.clientIdPrefix, ""),
      redirectUrl:    coalesce(args.event.payload.identityProvider.redirectUrl, "")
    })
  }

  // Create the cluster record.
  clusterRecord := if existing.Empty() && args.event.payload.node.type == "bff" {
    mutationCreateCluster({
      name:               "development",
      environment:        "development",
      region:             "local",
      args.event.payload.node.version
    })
  }

  return coalesce(clusterRecord, existing.First())
  }
}

// ---- logic/v1/cluster/deregisterNode.memql ----

// Record node shutdown in the database.
// Creates a spawn event with action="stopped".
@description("Records node shutdown by creating a v1:cluster:spawnEvent with action='stopped' and reason='system.shutdown'. Fires when the node is going down.")
logic logicDeregisterNode {
  args {
    event object @required
  }
  body {
  spawnEvent := mutationCreateSpawnEvent({
    nodeId:   coalesce(args.event.payload.node.id, ""),
    nodeType: coalesce(args.event.payload.node.type, ""),
    action:   "stopped",
    reason:   "system.shutdown"
  })

  return spawnEvent
  }
}

// ---- logic/v1/cluster/registerNode.memql ----

// Register this node in the database when it starts up.
// Creates a v1:cluster:node record and a spawn event.
// Runs on ALL node types. Safe to run on every restart.
//
// Passes the peer's NodeId as the explicit concept id so later rows
// written by NodeStatusWriter (via updateNodeHealth) share the same
// time-series timeline -- one concept row per real node.
@description("Registers this node on startup. Creates a v1:cluster:node record (using the peer's NodeId as the explicit concept id so later NodeStatusWriter rows share the same time-series timeline) and a v1:cluster:spawnEvent with action='spawned' and reason='system.startup'. Runs on every node type; safe to re-run on every restart.")
logic logicRegisterNode {
  args {
    event object @required
  }
  body {
  // Create the node record. Pass the peer's NodeId as the explicit
  // concept id so later rows from NodeStatusWriter share the same
  // time-series timeline (EmitSystemStartup always populates
  // node.id -- a generated UUID when MEMQL_NODE_ID is unset).
  //
  // Every field is bound with an EXPLICIT key + coalesce, mirroring
  // logicDeregisterNode (#1643): a multi-segment path like
  // `args.event.payload.node.id` is NOT eligible for the bare `args.X`
  // object-literal shorthand (only simple identifiers are), so the old
  // shorthand form corrupted the arg map -- nodeType never reached
  // mutationCreateNode ("required argument nodeType is missing"). `flavor`
  // was also dropped: it is not a mutationCreateNode arg (the insert body
  // never reads it).
  nodeRecord := mutationCreateNode({
    id:       coalesce(args.event.payload.node.id, ""),
    nodeType: coalesce(args.event.payload.node.type, ""),
    address:  coalesce(args.event.payload.node.address, "")
  })

  // Record the spawn event. The mutation schema only accepts the flat
  // fields below; version/address aren't persisted on the event (they
  // already live on the node record from mutationCreateNode above).
  // Every field is bound with an EXPLICIT key + coalesce, mirroring
  // the nodeRecord step above (#1671): a multi-segment path like
  // args.event.payload.node.type evaluates to nil when the field is
  // absent; passing nil for a @required arg triggers "required
  // argument missing" at validation time. coalesce(...,"") ensures a
  // non-nil string reaches mutationCreateSpawnEvent.
  spawnEvent := mutationCreateSpawnEvent({
    nodeId:   coalesce(args.event.payload.node.id, ""),
    nodeType: coalesce(args.event.payload.node.type, ""),
    action:   "spawned",
    reason:   "system.startup"
  })

  return nodeRecord
  }
}

// ---- logic/v1/cluster/pruneStaleClusterNodes.memql ----

// pruneStaleClusterNodes
// ======================
//
// Heartbeat-based prune of departed cluster nodes (#1061). The
// v1:cluster:node store is append-only: NodeStatusWriter appends a row
// on every liveness transition, and across K8s rollouts (nodes keyed by
// pod name, #1042) rows for long-gone pods accumulate forever. This cron
// marks those rows terminal so topology / CLI / WorkerDialer stop
// treating dead pods as live.
//
// Mechanism (mirrors logicPurgeExpiredArchivedSpaces /
// logicAccessRequestExpirySweep):
//   1. queryStaleClusterNodes returns the LATEST row per id whose health
//      is not already "stopped" (asOf latest -> idempotent + reflects
//      current state).
//   2. The stale window is read from the global variable registry
//      (MEMQL_NODE_STALE_PRUNE_MINUTES), so only CONFIG differs per env
//      -- the code/architecture is identical local-cluster and staging.
//      Default 30 minutes via coalesce: comfortably longer than the
//      in-memory peer windows (offline=25s, stale-gossip=60s) so a node
//      that is merely mid-restart is not pruned, but short enough that a
//      genuinely-departed pod clears within an hour. Set
//      `make variable-set NAME=MEMQL_NODE_STALE_PRUNE_MINUTES VALUE=...
//      SCOPE=global` (or the process env) to override per environment.
//   3. Per-row windowing: skip rows whose lastSeen + window is still in
//      the future. addDuration only accepts positive ISO-8601 durations
//      and the planner rejects function-call literals in filters, so the
//      "lastSeen + N minutes < now" math lives in the `if` guard here.
//   4. Prune == write a terminal health="stopped" row (append-only; we
//      don't hard-delete). cluster:node has no `deleted`/`active` field
//      and no soft-delete trait, and consumers already treat "stopped"
//      as gone: WorkerDialer skips offline/stopped rows, and the CLI /
//      topology dedupe to latest-per-id so the stopped marker hides the
//      node from the live set.
//
// Runs every 10 minutes. The cluster node table is small (one row-stream
// per pod ever seen), so a frequent walk is cheap and keeps topology
// fresh shortly after a rollover.
@description("Every 10 min: mark departed cluster nodes terminal. Reads the LATEST non-stopped row per id (queryStaleClusterNodes, asOf latest -> idempotent), and for each whose lastSeen + MEMQL_NODE_STALE_PRUNE_MINUTES (default 30) has passed, appends a health='stopped' row via mutationUpdateNodeHealth. Append-only prune (cluster:node has no deleted field); consumers treat stopped as gone (WorkerDialer skips it, CLI/topology dedupe latest-per-id). Per-row windowing in the if guard since MemQL filters can't push the duration math down.")
logic logicPruneStaleClusterNodes {
  args {
    event object @required
  }
  body {
  stale := queryStaleClusterNodes({})
  windowMinutes := queryGlobalVariable({ name: "MEMQL_NODE_STALE_PRUNE_MINUTES" })

  for item := range stale.Nodes() {
    pruneStep := if addDuration(item.payload.lastSeen, concat("PT", coalesce(windowMinutes.First().payload.value, "30"), "M")) < timestamp() {
      mutationUpdateNodeHealth({
        id:       item.id,
        nodeType: item.payload.nodeType,
        address:  coalesce(item.payload.address, ""),
        health:   "stopped",
        lastSeen: timestamp()
      })
    }
  }

  return stale.Len()
  }
}

