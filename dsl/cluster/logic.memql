// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// ---- logic/v1/cluster/bootstrapCluster.memql ----

// Bootstrap the cluster's self-representation in the database on first startup.
// Decides whether the cluster / database / identity-provider rows need
// creating; the calling automation owns the conditional writes. Only BFF
// nodes create. Idempotent: decides "create nothing" once a cluster exists.
use platform.queries.{ globalVariable }

/// Decides whether to run the cluster bootstrap writes on first startup (ADR S2.1 pure logic,
/// #2235). Reads existingCluster() and returns the boolean `create` -- true only when no cluster
/// row exists yet AND this node is the bff (both idempotency guards). The calling automation gates
/// the three conditional creates (v1:cluster:database / :identityProvider / :cluster) on
/// `steps.decide.result == true`, with the idp create additionally requiring an identityProvider
/// block in the startup envelope.
logic bootstrapCluster {
  args {
    event object!
  }
  body {
  existing := query existingCluster()
  return existing.empty() && args.event.payload.node.type == "bff"
  }
}

// ---- logic/v1/cluster/pruneStaleClusterNodes.memql ----

/// Decides which departed cluster nodes to retire (ADR S2.1 pure logic, #2235). Reads
/// MEMQL_NODE_STALE_PRUNE_MINUTES (default 30), computes cutoff = now - window via addDuration with
/// a negative ISO duration, and returns staleClusterNodes({olderThan: cutoff}).nodes() -- the
/// LATEST non-stopped rows whose lastSeen is past the window (the olderThan arg pushes a
/// payload.lastSeen<cutoff predicate onto the query, #1642). The calling automation appends the
/// terminal health='stopped' row per returned node via a forEach updateNodeHealth step.
logic pruneStaleClusterNodes {
  args {
    event object!
  }
  body {
  windowMinutes := query globalVariable( name: "MEMQL_NODE_STALE_PRUNE_MINUTES" )
  stale := query staleClusterNodes( olderThan: addDuration(now, concat("PT-", coalesce(windowMinutes.first().payload.value, "30"), "M")) )
  return stale.nodes()
  }
}
