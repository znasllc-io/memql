// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Create the cluster record
mutate cluster createCluster {
  args {
    name                string!
    region              string
    environment         string!
    status              enum("bootstrapping", "healthy", "degraded", "shutting_down")
    databaseId          string
    identityProviderId  string
    version             string
    provider            string
  }
  insert {
    args.name
    args.region
    args.environment
    seedNodeTypes: ["bff", "cognition", "planner"]
    status: args.status ?? "healthy"
    args.databaseId
    args.identityProviderId
    args.version
    provider: args.provider ?? ""
  }
}

// ---- mutations/v1/cluster/createDatabase.memql ----

// Register the cluster's database in the graph.

/// Register the cluster's database in the graph
mutate database createDatabase {
  args {
    host     string!
    dbName   string!
    sslMode  string
  }
  insert {
    accept { host, dbName, sslMode }
    stamp {
      port: 5432
      engine: "postgresql"
      status: "healthy"
    }
  }
}

// ---- mutations/v1/cluster/createIdentityProvider.memql ----

// Register the cluster's identity provider in the graph.

/// Register the cluster's identity provider in the graph
mutate identityProvider createIdentityProvider {
  args {
    name            string!
    issuerUrl       string!
    clientIdPrefix  string
    redirectUrl     string
  }
  insert {
    accept { name, issuerUrl, clientIdPrefix, redirectUrl }
    stamp {
      providerType: "oidc"
      status: "connected"
    }
  }
}

// ---- mutations/v1/cluster/createNode.memql ----

// Register a node in the cluster graph. The `id` arg is the node's
// NodeId (Identity.ID) so subsequent rows written by NodeStatusWriter
// (via updateNodeHealth) share the same time-series timeline -- one
// concept row per real node, not one per observer.

/// Register a node in the cluster
mutate node createNode {
  args {
    id            string
    nodeType      string!
    address       string
    health        string
    lastSeen      string
    capabilities  []string
    labels        object
    deploymentId  string
    provider      string
    environment   string
    region        string
  }
  insert {
    // Per-part hashing, no separator (memql#3009). The old form was
    // `hash(concat(args.nodeType, ":", now))`: a caller-supplied leading part
    // with no constraint, and an RFC3339 `now` trailing part that ALWAYS
    // carries colons -- so ("bff", "2026-01-01T00:00:00Z") and
    // ("bff:2026-01-01T00", "00:00Z") derived one node id. Fixed-width sha256
    // digests concatenate unambiguously, so there is nothing to alias on.
    id: args.id ?? concat("node-", hash(concat(hash(args.nodeType), hash(now))))
    args.nodeType
    address: args.address ?? ""
    parentId: ""
    health: args.health ?? "healthy"
    lastSeen: args.lastSeen ?? now
    capabilities: args.capabilities ?? []
    labels: args.labels ?? {}
    deploymentId: args.deploymentId ?? ""
    provider: args.provider ?? ""
    environment: args.environment ?? ""
    region: args.region ?? ""
  }
}

// ---- mutations/v1/cluster/createSpawnEvent.memql ----

// Record a node lifecycle event (spawned, stopped, failed).

/// Record a node lifecycle event
mutate spawnEvent createSpawnEvent {
  args {
    nodeId       string!
    nodeType     string!
    action       string!
    initiatorId  string
    reason       string
    metadata     object
  }
  insert {
    accept { nodeId, nodeType, action, initiatorId, reason, metadata }
  }
}

// ---- mutations/v1/cluster/updateNodeHealth.memql ----

// Record a health transition for an existing cluster node. Called by
// the PeerManager's NodeStatusWriter whenever a peer crosses a
// heartbeat threshold (healthy -> degraded -> offline) or recovers.
//
// The `id` argument is the peer's NodeId (Identity.ID) so that all
// transitions for the same node form a time-series under the same
// record. Subsequent inserts with the same id append new payload
// versions, and the engine's CDC path emits
// graph.node.created.<partition>.v1:cluster:node, which the CLI
// subscribes to for live topology updates.

/// Record a node health transition. Read-merges the existing v1:cluster:node row (created on
/// startup by registerNode under the same NodeId) so only health + lastSeen change;
/// nodeType/address/parentId/capabilities/labels inherit from the persisted row instead of being
/// wiped when a caller omits them (memql#1628 -- previously the insert form re-stamped address to
/// "" and reset capabilities/labels on every transition).
mutate node updateNodeHealth {
  args {
    id        string!
    health    string!
    lastSeen  string!
  }
  update {
    accept { id, health, lastSeen }
  }
}

// The deploy PERSISTENCE -- createDeployment / updateDeploymentStatus /
// createDeploymentNodeSpec / updateDeploymentNodeSpec -- was CENTRALIZED into
// the cohesive deployment pack by I11 (#2225): see dsl/deployment/mutations.memql.
// The mutation NAMES + the records they write (v1:cluster:deployment /
// v1:cluster:deploymentNodeSpec, ids unchanged) are identical; only the
// authoring location moved. Consumers reach them via
// `use deployment.mutations.{ ... }` (DSL) or by name through the engine (Go).
