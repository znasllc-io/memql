// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use cluster.concepts.{ cluster, database, deployment, identityProvider, node, spawnEvent }

@enabled
@description("Create the cluster record")
mutation cluster mutationCreateCluster {
  args {
    name                string  @required
    region              string
    environment         string  @required
    status              string  @enum("bootstrapping", "healthy", "degraded", "shutting_down")
    databaseId          string
    identityProviderId  string
    version             string
    provider            string
  }
  insert {
    args.name
    args.region
    args.environment
    seedNodeTypes: ["bff", "cognition", "planner"]
    status: coalesce(args.status, "healthy")
    args.databaseId
    args.identityProviderId
    args.version
    provider: coalesce(args.provider, "")
  }
}

// ---- mutations/v1/cluster/createDatabase.memql ----

// Register the cluster's database in the graph.

@enabled
@description("Register the cluster's database in the graph")
mutation database mutationCreateDatabase {
  args {
    host     string  @required
    dbName   string  @required
    sslMode  string
  }
  insert {
    args.host
    port: 5432
    args.dbName
    engine: "postgresql"
    args.sslMode
    status: "healthy"
  }
}

// ---- mutations/v1/cluster/createIdentityProvider.memql ----

// Register the cluster's identity provider in the graph.

@enabled
@description("Register the cluster's identity provider in the graph")
mutation identityProvider mutationCreateIdentityProvider {
  args {
    name            string  @required
    issuerUrl       string  @required
    clientIdPrefix  string
    redirectUrl     string
  }
  insert {
    args.name
    providerType: "oidc"
    args.issuerUrl
    args.clientIdPrefix
    args.redirectUrl
    status: "connected"
  }
}

// ---- mutations/v1/cluster/createNode.memql ----

// Register a node in the cluster graph. The `id` arg is the node's
// NodeId (Identity.ID) so subsequent rows written by NodeStatusWriter
// (via updateNodeHealth) share the same time-series timeline -- one
// concept row per real node, not one per observer.

@enabled
@description("Register a node in the cluster")
mutation node mutationCreateNode {
  args {
    id            string
    nodeType      string    @required
    address       string
    health        string
    lastSeen      string
    capabilities  []string
    labels        object
    deploymentId  string
    provider      string
    environment   string
    region        string
  }
  insert {
    id: coalesce(args.id, concat("node-", hash(concat(args.nodeType, ":", timestamp()))))
    args.nodeType
    address: coalesce(args.address, "")
    parentId: ""
    health: coalesce(args.health, "healthy")
    lastSeen: coalesce(args.lastSeen, timestamp())
    capabilities: coalesce(args.capabilities, [])
    labels: coalesce(args.labels, {})
    deploymentId: coalesce(args.deploymentId, "")
    provider: coalesce(args.provider, "")
    environment: coalesce(args.environment, "")
    region: coalesce(args.region, "")
  }
}

// ---- mutations/v1/cluster/createSpawnEvent.memql ----

// Record a node lifecycle event (spawned, stopped, failed).

@enabled
@description("Record a node lifecycle event")
mutation spawnEvent mutationCreateSpawnEvent {
  args {
    nodeId       string  @required
    nodeType     string  @required
    action       string  @required
    initiatorId  string
    reason       string
    metadata     object
  }
  insert {
    args.nodeId
    args.nodeType
    args.action
    args.initiatorId
    args.reason
    args.metadata
  }
}

// ---- mutations/v1/cluster/updateNodeHealth.memql ----

// Record a health transition for an existing cluster node. Called by
// the PeerManager's NodeStatusWriter whenever a peer crosses a
// heartbeat threshold (healthy -> degraded -> offline) or recovers.
//
// The `id` argument is the peer's NodeId (Identity.ID) so that all
// transitions for the same node form a time-series under the same
// record. Subsequent inserts with the same id append new payload
// versions, and the engine's CDC path emits
// graph.node.created.<partition>.v1:cluster:node, which the CLI
// subscribes to for live topology updates.

@enabled
@description("Record a node health transition. Read-merges the existing v1:cluster:node row (created on startup by logicRegisterNode under the same NodeId) so only health + lastSeen change; nodeType/address/parentId/capabilities/labels inherit from the persisted row instead of being wiped when a caller omits them (memql#1628 -- previously the insert form re-stamped address to \"\" and reset capabilities/labels on every transition).")
mutation node mutationUpdateNodeHealth {
  args {
    id        string  @required
    health    string  @required
    lastSeen  string  @required
  }
  update {
    id: args.id
    args.health
    args.lastSeen
  }
}

// ---- mutations/v1/cluster/createDeployment.memql ----

// Write a new deployment record at deploy start (#1872). The
// deploymentId is used as the explicit concept id so every later
// status transition (mutationUpdateDeploymentStatus) appends a new
// payload version under the SAME time-series timeline -- one record per
// deployment, reconstructable asOf any time. deploymentId is ALSO
// stamped as a payload field so queryDeploymentById can filter on the
// bare id without canonical-id prefixing.
//
// Admin action: the Deployment Console gates this path to owner/admin
// in Go (deploycontrol.authorize -> auth.AtLeastAdmin); the DSL mirror
// is spec("requiresOwnerOrAdmin") in dsl/deployment/specs.memql.
//
// Every field is bound with an explicit key + coalesce to a valid value
// (mirroring mutationCreateNode #1643/#1671): status defaults to
// "pending" and environment to "development" so the enum columns always
// receive a member of their value set; the plain string fields coalesce
// to "" when the caller omits them.
@enabled
@description("Create a v1:cluster:deployment record at deploy start (status defaults to pending). Uses deploymentId as the concept id so status transitions append to one timeline. #1872.")
mutation deployment mutationCreateDeployment {
  args {
    deploymentId         string  @required
    status               string  @enum("pending", "in_progress", "succeeded", "failed", "superseded", "rolled_back")
    version              string
    imageDigest          string
    provider             string
    environment          string  @enum("development", "staging", "production")
    region               string
    clusterId            string
    triggeredBy          string
    notes                string
    changelog            string
    previousDeploymentId string
  }
  insert {
    id: args.deploymentId
    deploymentId: args.deploymentId
    status: coalesce(args.status, "pending")
    version: coalesce(args.version, "")
    imageDigest: coalesce(args.imageDigest, "")
    provider: coalesce(args.provider, "")
    environment: coalesce(args.environment, "development")
    region: coalesce(args.region, "")
    clusterId: coalesce(args.clusterId, "")
    triggeredBy: coalesce(args.triggeredBy, "")
    notes: coalesce(args.notes, "")
    changelog: coalesce(args.changelog, "")
    previousDeploymentId: coalesce(args.previousDeploymentId, "")
    updatedAt: now
  }
}

// ---- mutations/v1/cluster/updateDeploymentStatus.memql ----

// Transition a deployment's status (#1872). Read-merge update form
// (mirrors mutationUpdateNodeHealth): only status + updatedAt change;
// every other field (version/imageDigest/provider/environment/region/
// clusterId/triggeredBy/notes/changelog/previousDeploymentId) inherits
// from the persisted row, so a status-only transition never wipes the
// deploy metadata stamped at create time. The append writes a new row
// under the same concept id, and the CDC path emits
// graph.node.updated.<partition>.v1:cluster:deployment, which the
// cockpit Deployments view subscribes to.
//
// Admin action: gated to owner/admin in Go (deploycontrol.authorize);
// DSL mirror spec("requiresOwnerOrAdmin").
@enabled
@description("Transition a v1:cluster:deployment's status (pending -> in_progress -> succeeded|failed; succeeded -> superseded; any -> rolled_back). Read-merge update: only status + updatedAt change, deploy metadata inherits. #1872.")
mutation deployment mutationUpdateDeploymentStatus {
  args {
    deploymentId  string  @required
    status        string  @required @enum("pending", "in_progress", "succeeded", "failed", "superseded", "rolled_back")
  }
  update {
    id: args.deploymentId
    args.status
    updatedAt: now
  }
}
