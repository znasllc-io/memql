// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use cluster.concepts.{ cluster, deployment, deploymentNodeSpec, node, nodeType, spawnEvent }
use cluster.shapes.{ deploymentFull, deploymentNodeSpecFull }

@enabled
@description("Returns all registered cluster node types (bff, voice, cognition, agent, planner, ...)")
@unbounded("node-type registry -- a tiny bounded topology set consumed whole")
query nodeType clusterNodeTypes {
}

// ---- queries/v1/cluster/clusterNodes.memql ----

// Returns all registered cluster nodes.
//
// Note: this returns EVERY row in the time-series, not just the latest
// per node. The CLI collapses them to "latest-per-id" in Go. We can't
// use `asOf(..., latest)` here because it's a query-level directive and
// the function-loader validator treats it as an unknown function call.

@enabled
@description("Returns all cluster node rows (CLI dedupes to latest per id)")
@unbounded("registered cluster nodes -- a bounded topology set consumed whole")
query node clusterNodes {
}

// ---- queries/v1/cluster/nodesForDeployment.memql ----

// All cluster nodes belonging to a given deployment (#1873). A
// deployment's topology = every node stamped with its deploymentId at
// registration (registerNode). `asOf latest` collapses the
// append-only v1:cluster:node stream to one row per node id (its current
// state), mirroring staleClusterNodes -- so this returns the live
// membership of the deployment, not every historical liveness row.
//
// Authz: no user-scope field is referenced (filters on payload.deploymentId,
// infrastructure topology), so this lands in the conformance "other" bucket
// alongside clusterNodes / staleClusterNodes -- no caller-check
// needed (per-row-authz-audit.md).

@enabled
@description("Latest-per-id cluster node rows for one deploymentId -- the live topology of that deployment (#1873). asOf latest collapses the append-only node stream to current state per node.")
@unbounded("nodes in one deployment -- a bounded topology set consumed whole")
query node nodesForDeployment {
  args {
    deploymentId  string  @required
  }
  filter  payload.deploymentId == args.deploymentId
  asOf    latest
}

// ---- queries/v1/cluster/nodesNotInDeployment.memql ----

// Orphan-node detector (#1873): latest-per-id cluster nodes whose
// deploymentId differs from the caller-supplied current deployment id.
// These are still-running pods left over from a PREVIOUS deploy -- the
// stale-node clutter the cockpit Topology view highlights and the reaper
// (#1874) reconciles. The caller passes the cluster's CURRENT deploymentId
// (MemQL has no subquery, so "the active deployment" is resolved by the
// consumer and passed in). `asOf latest` -> current state per node so a
// node that has since re-registered under the current deployment drops out.
//
// Authz: filters on payload.deploymentId only (infrastructure topology, no
// user-scope field) -> conformance "other" bucket, same as clusterNodes.

@enabled
@description("Latest-per-id cluster nodes whose deploymentId != the supplied current deployment -- orphans from a previous deploy (feeds the reaper #1874 + cockpit orphan highlight). #1873.")
@unbounded("nodes outside a deployment -- a bounded topology set for drain/cutover, consumed whole")
query node nodesNotInDeployment {
  args {
    deploymentId  string  @required
  }
  filter  payload.deploymentId != args.deploymentId
  asOf    latest
}

// ---- queries/v1/cluster/clusterSpawnEvents.memql ----

// Returns all cluster spawn events (node lifecycle: spawned, stopped, failed).
// Used by the CLI topology view to discover nodes via their spawn history.

@enabled
@description("Returns all cluster spawn events")
query spawnEvent clusterSpawnEvents {
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
}

// ---- queries/v1/cluster/existingCluster.memql ----

// Returns the existing cluster record, if any.
// Used by bootstrapCluster to check if cluster is already initialized.

@enabled
@description("Returns the existing cluster record, if any")
@unbounded("the cluster singleton row -- bounded to a single row")
query cluster existingCluster {
}

// ---- queries/v1/cluster/staleClusterNodes.memql ----

// staleClusterNodes
// ======================
//
// Returns the LATEST row per node id whose health is not already a
// terminal "stopped" marker. Used by the pruneStaleClusterNodes cron
// (#1061) to find departed pods whose v1:cluster:node rows are still
// hanging around after a K8s rollover.
//
// Why `asOf latest`: the v1:cluster:node store is append-only -- every
// liveness transition (updateNodeHealth) appends a new row under
// the same id, so a plain scan would return every historical row. The
// struct-form `asOf latest` directive collapses to one row per id (the
// most recent), which is exactly what the prune needs:
//   - it makes the cron idempotent -- once a node's latest row is
//     "stopped" it's excluded, so we never re-stop the same id and never
//     grow the table unbounded; and
//   - it reflects the node's CURRENT state, so a node that recovered
//     (latest row healthy again) is re-evaluated on its fresh lastSeen.
//
// The staleness comparison (lastSeen + window < now) is NOT done here:
// the MemQL query planner rejects function-call literals (addDuration /
// timestamp) inside filter comparisons, and addDuration accepts only
// positive ISO-8601 durations. So the windowing math lives on the
// per-row side in pruneStaleClusterNodes, mirroring
// accessRequestExpirySweep / logicPurgeExpiredArchivedSpaces.

@enabled
@description("Latest-per-id cluster node rows whose health is not already 'stopped'. When olderThan is supplied, restricts to rows whose lastSeen is strictly before it (RFC3339 cutoff). Drives the stale-node prune cron.")
@unbounded("stale-node reaper sweep -- an internal sweep that must see all stale nodes")
query node staleClusterNodes {
  args {
    olderThan  string  @description("Optional RFC3339 cutoff; when set, only rows whose lastSeen is strictly before it are returned.")
  }
  filter  payload.health!="stopped" && when(args.olderThan) { payload.lastSeen<args.olderThan }
  asOf    latest
}

// ---- queries/v1/cluster/deploymentsForCluster.memql ----

// Deployment history for a cluster (#1872). Returns ONE row per
// deployment -- the LATEST payload version per deploymentId via
// `asOf latest`, so each entry reflects the deployment's CURRENT
// status (pending/in_progress/succeeded/failed/superseded/rolled_back).
// The deployment store is append-only (one row appended per status
// transition under the same concept id = deploymentId), so a plain scan
// would return every transition; asOf latest collapses to the current
// state. Ordering newest-first by createdAt is applied by the consumer
// (cockpit Deployments view), mirroring clusterNodes' "CLI dedupes
// + sorts" note -- the MemQL query planner has no order/limit clause.

@enabled
@description("Deployment history for a cluster: latest-per-deploymentId rows (asOf latest -> current status per deployment) filtered to a clusterId. Backs the cockpit Deployments history list (consumer sorts newest-first by createdAt). #1872.")
@unbounded("deployments for a cluster -- a bounded topology set consumed whole")
query deployment deploymentsForCluster {
  args {
    clusterId  string  @required
  }
  filter  payload.clusterId == args.clusterId
  shape   deploymentFull
  asOf    latest
}

// ---- queries/v1/cluster/deploymentById.memql ----

// Full status-transition history for a single deployment (#1872).
// Filters on payload.deploymentId (NOT the canonical row id, which would
// need partition+concept prefixing) so the caller passes the bare
// deploymentId. Returns EVERY appended row for that deployment -- the
// complete lifecycle timeline -- so a deployment's status is
// reconstructable asOf any point in time (acceptance criterion). No asOf
// directive: the consumer wants all versions, not the latest.

@enabled
@description("All status-transition rows for one deployment, by deploymentId, oldest-to-newest (full lifecycle history; reconstructable asOf any time). #1872.")
@unbounded("deployment by unique deploymentId -- bounded to a single row")
query deployment deploymentById {
  args {
    deploymentId  string  @required
  }
  filter  payload.deploymentId == args.deploymentId
  shape   deploymentFull
}

// ---- queries/v1/cluster/supersededDeployments.memql ----

// Deployment-aware reaper input (#1874). Returns ONE row per deployment
// (latest-per-deploymentId via `asOf latest`) whose CURRENT status is a
// terminal-not-active one -- superseded (a newer deploy promoted past it),
// failed, or rolled_back. These are exactly the deployments whose nodes are
// orphans: still-registered pods from a deploy that is no longer the active
// or in-flight one. The active-topology reconciler (TopologyReconciler,
// component/node/reconciler.go) reads this set every tick and immediately
// retires (health="stopped") any non-stopped v1:cluster:node whose
// deploymentId lands in it -- so a superseded deployment's nodes clear from
// topology within seconds of promotion completing, instead of waiting on the
// liveness lapse or the 30-min prune.
//
// Why status-driven (not "deploymentId != currentId"): keying off the
// deployment's recorded status avoids cutting an OLD deployment's pods while
// they are still in-flight during a rollover overlap -- a node is only an
// orphan once its deployment is explicitly marked superseded/failed/
// rolled_back by the deploy driver. A node whose deploymentId has NO
// deployment row (e.g. the dev "local" id) never matches, so local/dev
// clusters are untouched by the orphan path.
//
// Authz: filters on payload.status only (infrastructure topology, no
// user-scope field) -> conformance "other" bucket, same as
// nodesNotInDeployment / deploymentsForCluster.

@enabled
@description("Latest-per-deploymentId deployment rows whose status is terminal-not-active (superseded / failed / rolled_back) -- the deployments whose still-registered nodes are orphans. Feeds the active-topology reaper (#1874). asOf latest -> current status per deployment.")
@unbounded("superseded/failed/rolled-back deployments GC sweep -- an internal sweep that must see all")
query deployment supersededDeployments {
  filter  payload.status in ["superseded", "failed", "rolled_back"]
  shape   deploymentFull
  asOf    latest
}

// ---- queries/v1/cluster/nodeSpecsForDeployment.memql ----

// A deployment's full per-node-type spec set (Epic 2 / #2094). Returns
// ONE row per node type -- the LATEST payload version per
// (deploymentId, nodeType) via `asOf latest`, so each entry reflects
// the node type's CURRENT spec (version / replicas / imageDigest). The
// deploymentNodeSpec store is append-only (one row appended per re-pin
// under the same composite concept id), so a plain scan would return
// every transition; asOf latest collapses to the current spec per node
// type. The caller passes the bare deploymentId (filter is on
// payload.deploymentId, NOT the canonical row id).
//
// Engine-as-spine resolution (empty version -> the deployment's engine
// version) is the CONSUMER's job: this query returns the raw per-node
// pins; the deploy pack resolves "" against the lockfile engineVersion.
//
// Authz: filters on payload.deploymentId only (infrastructure topology,
// no user-scope field) -> conformance "other" bucket, same as
// nodesForDeployment / deploymentsForCluster.

@enabled
@description("Latest-per-(deploymentId, nodeType) deploymentNodeSpec rows for one deploymentId -- the deployment's current per-node-type spec set (version / replicas / imageDigest). asOf latest collapses the append-only spec stream to current state per node type. Engine-as-spine resolution of an empty version is the consumer's job. Epic 2 / #2094.")
@unbounded("per-node specs for one deployment -- a bounded topology set consumed whole")
query deploymentNodeSpec nodeSpecsForDeployment {
  args {
    deploymentId  string  @required
  }
  filter  payload.deploymentId == args.deploymentId
  shape   deploymentNodeSpecFull
  asOf    latest
}
