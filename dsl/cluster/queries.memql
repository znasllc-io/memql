// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use deployment.specs.{ requiresOwner }

/// Returns all registered cluster node types (bff, voice, cognition, agent, planner, ...)
@unbounded("node-type registry -- a tiny bounded topology set consumed whole")
query nodeType clusterNodeTypes {
}

// ---- queries/v1/cluster/clusterNodes.memql ----

// Returns all registered cluster nodes.
//
// Note: this returns EVERY row in the time-series, not just the latest
// per node. The CLI collapses them to "latest-per-id" in Go. We can't
// use `asOf(..., latest)` here because it's a query-level directive and
// the function-loader validator treats it as an unknown function call.

/// Returns all cluster node rows (CLI dedupes to latest per id)
@unbounded("registered cluster nodes -- a bounded topology set consumed whole")
query node clusterNodes {
}

// ---- queries/v1/cluster/nodesForDeployment.memql ----

// All cluster nodes belonging to a given deployment (#1873). A
// deployment's topology = every node stamped with its deploymentId at
// registration (registerNode). `asOf latest` collapses the
// append-only v1:cluster:node stream to one row per node id (its current
// state), mirroring staleClusterNodes -- so this returns the live
// membership of the deployment, not every historical liveness row.
//
// Authz: no user-scope field is referenced (filters on payload.deploymentId,
// infrastructure topology), so this lands in the conformance "other" bucket
// alongside clusterNodes / staleClusterNodes -- no caller-check
// needed (per-row-authz-audit.md).

/// Latest-per-id cluster node rows for one deploymentId -- the live topology of that deployment
/// (#1873). asOf latest collapses the append-only node stream to current state per node.
@unbounded("nodes in one deployment -- a bounded topology set consumed whole")
query node nodesForDeployment {
  args {
    deploymentId  string!
  }
  filter  deploymentId == args.deploymentId
  asOf    latest
}

// ---- queries/v1/cluster/nodesNotInDeployment.memql ----

// Orphan-node detector (#1873): latest-per-id cluster nodes whose
// deploymentId differs from the caller-supplied current deployment id.
// These are still-running pods left over from a PREVIOUS deploy -- the
// stale-node clutter the cockpit Topology view highlights and the reaper
// (#1874) reconciles. The caller passes the cluster's CURRENT deploymentId
// (MemQL has no subquery, so "the active deployment" is resolved by the
// consumer and passed in). `asOf latest` -> current state per node so a
// node that has since re-registered under the current deployment drops out.
//
// Authz: filters on payload.deploymentId only (infrastructure topology, no
// user-scope field) -> conformance "other" bucket, same as clusterNodes.

/// Latest-per-id cluster nodes whose deploymentId != the supplied current deployment -- orphans
/// from a previous deploy (feeds the reaper #1874 + cockpit orphan highlight). #1873.
@unbounded("nodes outside a deployment -- a bounded topology set for drain/cutover, consumed whole")
query node nodesNotInDeployment {
  args {
    deploymentId  string!
  }
  filter  deploymentId != args.deploymentId
  asOf    latest
}

// ---- queries/v1/cluster/clusterSpawnEvents.memql ----

// Returns all cluster spawn events (node lifecycle: spawned, stopped, failed).
// Used by the CLI topology view to discover nodes via their spawn history.

/// Returns all cluster spawn events
query spawnEvent clusterSpawnEvents {
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
}

// ---- queries/v1/cluster/existingCluster.memql ----

// Returns the existing cluster record, if any.
// Used by bootstrapCluster to check if cluster is already initialized.

/// Returns the existing cluster record, if any
@unbounded("the cluster singleton row -- bounded to a single row")
query cluster existingCluster {
}

// ---- queries/v1/cluster/staleClusterNodes.memql ----

// staleClusterNodes
// ======================
//
// Returns the LATEST row per node id whose health is not already a
// terminal "stopped" marker. Used by the pruneStaleClusterNodes cron
// (#1061) to find departed pods whose v1:cluster:node rows are still
// hanging around after a K8s rollover.
//
// Why `asOf latest`: the v1:cluster:node store is append-only -- every
// liveness transition (updateNodeHealth) appends a new row under
// the same id, so a plain scan would return every historical row. The
// struct-form `asOf latest` directive collapses to one row per id (the
// most recent), which is exactly what the prune needs:
//   - it makes the cron idempotent -- once a node's latest row is
//     "stopped" it's excluded, so we never re-stop the same id and never
//     grow the table unbounded; and
//   - it reflects the node's CURRENT state, so a node that recovered
//     (latest row healthy again) is re-evaluated on its fresh lastSeen.
//
// The staleness comparison (lastSeen + window < now) is NOT done here:
// the MemQL query planner rejects function-call literals (addDuration /
// timestamp) inside filter comparisons, and addDuration accepts only
// positive ISO-8601 durations. So the windowing math lives on the
// per-row side in pruneStaleClusterNodes, mirroring
// accessRequestExpirySweep / logicPurgeExpiredArchivedSpaces.

/// Latest-per-id cluster node rows whose health is not already 'stopped'. When olderThan is
/// supplied, restricts to rows whose lastSeen is strictly before it (RFC3339 cutoff). Drives the
/// stale-node prune cron.
@unbounded("stale-node reaper sweep -- an internal sweep that must see all stale nodes")
query node staleClusterNodes {
  args {
    olderThan  string
  }
  filter  health!="stopped" && when(args.olderThan) { lastSeen<args.olderThan }
  asOf    latest
}

// The deployment-RECORD reads -- deploymentsForCluster / deploymentById /
// supersededDeployments / nodeSpecsForDeployment -- were CENTRALIZED into the
// cohesive deployment pack by I11 (#2225): see dsl/deployment/queries.memql
// (with the deploymentFull / deploymentNodeSpecFull shapes in
// dsl/deployment/shapes.memql). The query NAMES are unchanged, so
// component/deploycontrol, component/node/reconciler.go, the cockpit
// Deployments view, and the SDK keep resolving them by name. The `query node`
// topology lookups above (nodesForDeployment / nodesNotInDeployment) stay here
// because they read the v1:cluster:node concept, not the deployment record.

// ---- The release-cut history (epic memql#4434) ----

/// Every release this cluster cut, newest first. Backs the Releases card on the portal's
/// Deployments page.
///
/// TWO TERMS FOR ONE PREDICATE, and both earn their place -- deleting either is the mistake this
/// note exists to prevent.
///
/// `requiresOwner` is the DECISION, named. The owner ask was "only the owners (role) may cut a new
/// version", and this spec (`role == "owner"`) is the same predicate the builtin's Go wall applies
/// as `AccessContext.IsClusterOwner`. Naming it here is what makes the double wall legible: the
/// read and the write visibly agree about who may do this.
///
/// `actor.isClusterOwner==true` is what the CONCEPT'S TIER already ANDs into every read of it,
/// written out so the enforcement land gate (memql#3172) can decide implication. That gate cannot
/// expand a spec, so with `requiresOwner` alone it reports the read as UNDECIDABLE -- it cannot
/// prove the filter already implies the conjunct, and an undecidable read is one whose result set
/// might silently change when enforcement lands. Spelling the conjunct out settles it, and it
/// narrows nothing: the two terms are the same predicate, since `IsClusterOwner()` IS
/// `Role == RoleOwner`.
///
/// This is HISTORY, not the answer to "what is the newest version" -- see the concept's own note. A
/// release cut by hand appears here not at all.
/// One release cut, by version. The version IS the row id (createReleaseCut stamps `id:
/// args.version`), so this is a single-row read on the primary key's leading column rather than a
/// payload probe -- the distinction row_id_mirror_test.go enforces across the tree, and the reason
/// the filter names `row.id` even though a `version` payload field exists beside it.
///
/// SEPARATE FROM releaseCuts, and not a convenience. releaseCuts paginates 50, which is the right
/// bound for a portal list and the wrong one for a lookup: an installation past its fiftieth
/// release would have releaseCutStatus miss every older version and answer `version_not_cut` --
/// whose meaning is "cut by hand, or on another installation". A confident wrong answer, arrived at
/// by a page boundary nobody could see from the message.
///
/// Same gate as its sibling, for the same reason; see that note for why both terms are present.
@actor
query releaseCut releaseCutByVersion {
  args {
    version  string!
  }
  filter  row.id==args.version && requiresOwner && actor.isClusterOwner==true
}

@actor
query releaseCut releaseCuts {
  filter   requiresOwner && actor.isClusterOwner==true
  sort     "row.createdAt", "desc"
  paginate 50
}

// ---- the cluster's own infrastructure rows (memql#4766) ----

// THE FIRST READERS THESE TWO CONCEPTS HAVE EVER HAD.
//
// v1:cluster:database and v1:cluster:identityProvider were written at bootstrap
// and then looked at by nothing -- which is exactly why half their fields could
// sit unwritten for so long without anyone noticing. No query bound either
// concept, so neither appeared in rowauthz_undeclared_gate_test.go's seed list
// (that list is derived from queries over undeclared concepts), and no surface
// could contradict the rows.
//
// Adding a reader is what makes the tier necessary. Both concepts now declare
// @rowAuthz(clusterOwner) -- plain, like releaseCut, because neither has a
// per-user owner field to point at. Declaring it was free: a tier narrows
// existing reads, and there were none.
//
// BOTH TERMS ARE PRESENT ON PURPOSE, the same pairing releaseCuts records.
// `requiresOwner` is the query's own gate and `actor.isClusterOwner==true` is
// what the declared tier compares; spelling out only the spec leaves the
// enforcement gate reporting the construct UNDECIDABLE.
//
// NO SHAPE, deliberately. A shapeless query projects every field of its bound
// concept, and here that is the intent rather than an oversight: these rows are
// a topology record an operator reads whole, and neither carries a credential
// -- `clientIdPrefix` is the first eight characters of a client id and
// documents itself as non-secret. (Contrast pendingUserInvitations, which was
// shapeless over a concept holding three token digests.)

/// The database backing this cluster: where it is, what engine and version, and which extensions
/// are installed. CLUSTER OWNER ONLY.
@unbounded("the cluster's one database row -- a singleton at a fixed id, read whole")
@actor
query database clusterDatabase {
  // PINNED TO THE LITERAL ID, and that is not decoration. A cluster that
  // predates memql#4766 still holds a database row at a GENERATED id, written
  // by the old bootstrap and never completed. Without this term the read
  // returns that orphan alongside the current row and a panel shows two
  // databases, one of them wrong. Pinning makes the read what its @unbounded
  // reason already claims it is: a singleton at a fixed id.
  filter  row.id=="v1:cluster:database:primary" && requiresOwner && actor.isClusterOwner==true
}

/// The identity provider this cluster authenticates against: issuer, JWKS URL and accepted
/// audiences. CLUSTER OWNER ONLY. No secrets -- clientIdPrefix is the non-secret prefix.
@unbounded("the cluster's one identity-provider row -- a singleton at a fixed id, read whole")
@actor
query identityProvider clusterIdentityProvider {
  // Pinned for the reason clusterDatabase records: a pre-memql#4766 cluster
  // holds an orphan at a generated id.
  filter  row.id=="v1:cluster:identityProvider:primary" && requiresOwner && actor.isClusterOwner==true
}
