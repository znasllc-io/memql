// todos domain -- the `todos` skill catalog row.
//
// Bundles the four todos tools into a named capability the agent
// factory + Planner Agent can attach to an agent so it can manage
// the user's to-dos. Materialized by the SeedMaterializer at engine
// startup; idempotent. predefined=true locks the row in the cockpit
// Skills admin view.

use agents.concepts.{ skill }

@description("To-do management: list, create, complete, and update the user's app-native to-dos. Every operation is per-row-authz owned -- the agent acts only on the calling user's to-dos. Attach this skill to an agent that helps the user track and reconcile tasks.")
seed skill todos {
  slug:          "todos"
  name:          "To-dos"
  description:   "List, create, complete, and update the user's to-dos. The standalone to-do notebook surface; ownership is server-stamped so the agent only ever touches the user's own items."
  category:      "foundational"
  tags:          ["productivity", "tasks"]
  domainIds:     []
  toolSlugs:     ["todosList", "todosCreate", "todosComplete", "todosUpdate"]
  liveSourceIds: []
  tier:          "A"
  predefined:    true
}
