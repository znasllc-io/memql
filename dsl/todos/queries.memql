// todos domain -- caller-scoped reads.
//
// Authz tier: owned. Every filter gates on
// payload.ownerUserId==actor.userId so a caller can only ever read
// their own to-dos; there is no arg that lets a caller widen the
// row set beyond their own ownership.

use todos.concepts.{ todo }

@enabled
@description("List the caller's to-dos. Owned: the row set is gated by ownerUserId==actor.userId server-side, so cross-user reads are impossible. Optional done filter narrows to open (done=false) or completed (done=true) items; omit it to return everything.")
query todo todos {
  args {
    done  bool
  }
  filter  payload.ownerUserId==actor.userId && when(args.done) { payload.done==args.done }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   todoFull
}

@enabled
@unbounded("todo by id (guarded), gated to the owner -- bounded to a single row")
@description("Fetch a single to-do by id, gated to the caller. Owned: ownerUserId==actor.userId is the load-bearing guard, so a caller can never read another user's to-do even with its id. Used by the complete / update tools to confirm the row exists before re-inserting a new version.")
@mcp
query todo todoById {
  args {
    todoId  string  @required
  }
  filter  when(args.todoId) { id==args.todoId } && payload.ownerUserId==actor.userId
  shape   todoFull
}
