// todos domain -- caller-scoped reads.
//
// Authz tier: owned. Every filter gates on
// payload.ownerUserId==actor.userId so a caller can only ever read
// their own to-dos; there is no arg that lets a caller widen the
// row set beyond their own ownership.

/// List the caller's to-dos. Owned: the row set is gated by ownerUserId==actor.userId server-side,
/// so cross-user reads are impossible. Optional done filter narrows to open (done=false) or
/// completed (done=true) items; omit it to return everything.
@actor
query todo todos {
  args {
    done  bool
  }
  filter  ownerUserId==actor.userId && when(args.done) { done==args.done }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   todoFull
}

/// Fetch a single to-do by id, gated to the caller. Owned: ownerUserId==actor.userId is the
/// load-bearing guard, so a caller can never read another user's to-do even with its id. Used by
/// the complete / update tools to confirm the row exists before re-inserting a new version.
@unbounded("todo by id (guarded), gated to the owner -- bounded to a single row")
@mcp
@actor
query todo todoById {
  args {
    todoId  string!
  }
  filter  when(args.todoId) { row.id==args.todoId } && ownerUserId==actor.userId
  shape   todoFull
}
