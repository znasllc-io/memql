// todos domain -- row projections.

use todos.concepts.{ todo }

@row
@description("Comprehensive to-do projection: every payload field plus row id and timestamps. The default shape for list / create / update reads.")
shape todo todoFull {
  row.id
  ownerUserId
  title
  done
  dueAt
  priority
  sourceResponsibilityId
  row.createdAt
}
