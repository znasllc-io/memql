use common.traits.{ statusIsActive }

// portalviews domain -- caller-scoped reads.
//
// Authz tier: owned. Every filter gates on ownerUserId==actor.userId,
// so a caller only ever reads views they composed. The conjunct is
// written out rather than left to the engine's @rowAuthz injection on
// purpose: the injection is the enforcement, and the visible conjunct
// is what makes the tier legible to a reader of this file and to the
// classification gate in test/dslconformance.

/// List the caller's composed views, newest first. Owned: the row set is gated by
/// ownerUserId==actor.userId server-side, so cross-user reads are impossible and no argument can
/// widen it. Optional status narrows to the active list or to the archived one; omit it for both.
/// Optional conceptId answers "which of my views cover this concept", which is what the composer
/// offers when somebody opens a concept that already has a saved view.
@actor
query view composedViews {
  args {
    status     enum("active", "archived")
    conceptId  string
  }
  // `kind!="override"` and NOT `kind=="composed"`, and the difference is the
  // whole compatibility story. Every row written before epic memql#4661 has no
  // `kind` field at all, and MemQL's `!=` is null-safe against a non-empty
  // string (memql#1685, pinned by absent_field_comparison_test.go): an ABSENT
  // field MATCHES, so those rows stay in this list. `kind=="composed"` would
  // not match an absent field and would empty every existing person's saved
  // views on the release that added the field.
  filter   ownerUserId==actor.userId && kind!="override" && when(args.status) { status==args.status } && when(args.conceptId) { args.conceptId in conceptIds }
  sort     "row.createdAt", "desc"
  paginate 50
  shape    composedViewFull
}

/// Read the caller's own override of one page (epic memql#4661). Owned: the filter gates on
/// ownerUserId==actor.userId, so a person only ever resolves their OWN regenerations and one
/// person's regeneration can never repaint another's console -- the per-user scope of D4 is this
/// conjunct and nothing else.
///
/// A page nobody has regenerated returns nothing, which is not an empty state: it is the answer,
/// and the caller renders the page's seed.
///
/// THE VERSION STRIP IS THIS QUERY WRAPPED IN `asOf`, the deployables pattern (D10 / memql#2880).
/// A write in MemQL is an append onto one id, so a plain read returns the NEWEST version and
/// re-issuing it under successive `asOf` timestamps -- each set just before the previous result's
/// createdAt -- walks back one version at a time. There is deliberately no `asOf latest` clause
/// here: a query that declares one refuses to be wrapped by a caller's own, which is exactly the
/// capability the walk needs. Original is the seed and needs no row at all.
@unbounded("one page's override for one caller -- bounded to a single row by construction: a person has at most one override per page, and the append-only history behind it collapses to its newest version on a plain read")
@actor
query view pageOverride {
  args {
    targetPageId  string!
  }
  filter  ownerUserId==actor.userId && kind=="override" && targetPageId==args.targetPageId && statusIsActive
  shape   composedViewFull
}

/// Fetch one composed view by id, gated to its owner. Owned: ownerUserId==actor.userId is the
/// load-bearing guard, so a caller cannot open another person's view even holding its id. This is
/// the read behind opening a saved view and behind re-opening it in the composer to edit.
@unbounded("composed view by id (guarded), gated to the owner -- bounded to a single row")
@actor
query view composedViewById {
  args {
    viewId  string!
  }
  filter  when(args.viewId) { row.id==args.viewId } && ownerUserId==actor.userId
  shape   composedViewFull
}
