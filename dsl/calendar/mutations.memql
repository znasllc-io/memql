// mutations.memql
//
// Write surface for the app-native calendar (#642). The calendar tool's
// create/update/delete actions and the frontend call these. Native is
// the only writer in v1: create stamps source="native" and stamps
// ownerUserId from actor.userId so every row is caller-owned (the
// per-row authz guard). Update + delete are partial updates by id;
// the calendar tool reads the row through the owner-scoped
// calendarEventById first, so a caller can only mutate their own
// events. Exposed as typed SDK methods on `conn.query`.

/// Create a native calendar event owned by the authenticated caller. ownerUserId is stamped from
/// actor.userId (caller-scoped write); createdAt + createdBy are engine-stamped row intrinsics (NOT
/// payload fields -- declaring them is rejected as reserved, memql#1673); source defaults to
/// 'native'. The reactive harness's reminder triggers pick the row up via upcomingEvents. Pass
/// `eventId` to control the id (idempotent re-create), else the engine assigns one.
@actor
mutate calendarEvent createCalendarEvent {
  args {
    eventId      string
    title        string!
    startsAt     datetime!
    endsAt       datetime
    allDay       bool
    location     string
    notes        string
    recurrence   string
  }
  insert {
    accept { title, startsAt, endsAt, location, notes, recurrence }
    stamp {
      id:          args.eventId
      ownerUserId: actor.userId
      allDay: args.allDay ?? false
      source:    "native"
      deleted:   false
    }
  }
}

// `ownerUserId: actor.userId` is NOT redundant with the create-time
// stamp, and removing it reopens memql#2988.
//
// `args.payload` is splatted whole, so without an explicit re-stamp a
// caller passing `payload: {ownerUserId: "<someone-else>"}` reassigns
// the row -- the field this concept declares as its @rowAuthz owner and
// whose own doc calls it "the load-bearing per-row authz guard".
//
// The engine's protection against exactly this (memql#401, overlay-wins)
// is populated ONLY from explicit block fields. With just `id` (hoisted
// to IDTemplate) and the splat, the overlay map was EMPTY and nothing
// engaged. Naming the field here puts it in the overlay, where it wins
// over the caller's payload. `updateNote` has always done this; the two
// mutations were otherwise near-identical, which is why the gap was
// invisible on inspection.
//
/// Partial update of a calendarEvent. Only the fields passed in `payload` change; everything else
/// inherits from the prior row. Backs editing an event (reschedule, rename, change location / notes
/// / recurrence). The owner is re-stamped from the actor on every write, so a caller cannot
/// reassign an event by passing `ownerUserId` in the payload.
@actor
mutate calendarEvent updateCalendarEvent {
  args {
    eventId  string!
    payload  object!
  }
  update {
    id: args.eventId
    ownerUserId: actor.userId
    args.payload
  }
}

/// Soft-delete a calendarEvent by stamping deleted=true. The time-series row survives for history +
/// so a future external-sync reconciler can propagate the deletion upstream; queries hide it via
/// isNotDeleted. The calendar tool reads the row via the owner-scoped calendarEventById before
/// calling this, so a caller can only delete their own events.
mutate calendarEvent deleteCalendarEvent {
  args {
    eventId  string!
  }
  update {
    id: args.eventId
    deleted: true
  }
}
