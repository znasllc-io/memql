// shapes.memql
//
// Row projection for the calendar namespace, consumed by the queries
// below + the calendar tool's listing surface and the generated SDK.

/// Full calendarEvent projection: every field an agent or the frontend needs to render / reason
/// about an event. source + externalRef are included so a client can visually distinguish native
/// rows from externally-synced ones.
@row
shape calendarEvent calendarEventFull {
  row.id
  ownerUserId
  title
  startsAt
  endsAt
  allDay
  location
  notes
  recurrence
  source
  externalRef
  row.createdAt
}

/// Full bookingHours projection. Backs the host's availability editor.
@row
shape bookingHours bookingHoursFull {
  row.id
  ownerUserId
  weekday
  startLocal
  endLocal
  timezone
  slotMinutes
  published
  label
  row.createdAt
}

/// Full booking projection. Carries @pii bookerEmail, so every query
/// binding it gates on the caller.
@row
shape booking bookingFull {
  row.id
  ownerUserId
  hoursId
  startsAt
  endsAt
  bookerName
  bookerEmail
  status
  notes
  rescheduledToId
  row.createdAt
}
