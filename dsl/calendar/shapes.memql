// shapes.memql
//
// Row projection for the calendar namespace, consumed by the queries
// below + the calendar tool's listing surface and the generated SDK.

@row
@description("Full calendarEvent projection: every field an agent or the frontend needs to render / reason about an event. source + externalRef are included so a client can visually distinguish native rows from externally-synced ones.")
shape calendarEvent calendarEventFull {
  row.id
  payload.ownerUserId
  payload.title
  payload.startsAt
  payload.endsAt
  payload.allDay
  payload.location
  payload.notes
  payload.recurrence
  payload.source
  payload.externalRef
  row.createdAt
}
