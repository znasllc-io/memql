// concepts.memql
//
// App-native calendar -- the first-party source of truth for a user's
// events (#642, Epic #633 / Program #629). Distinct from external
// Google Calendar: native events are canonical here; an external sync
// (Google etc.) lands LATER through the existing knowledge:liveSource /
// liveConnector mechanism and writes rows carrying source="externalSync"
// + externalRef. This domain owns only the native side.
//
// Per-user authz: every calendarEvent carries ownerUserId; queries
// self-scope on actor.userId, mutations stamp ownerUserId from
// actor.userId. A caller can never read or write another user's events.

use identity.concepts.{ user }

/// A single calendar event owned by one user. The app-native source of truth for that user's
/// schedule (#642): the reactive harness's reminder triggers read upcomingEvents over these rows
/// ('remind me the day before X'), and the calendar tool/skill lets agents create + list + edit
/// them. source discriminates native (first-party, the only writer in v1) from externalSync (a
/// future Google/CalDAV sync via knowledge:liveConnector, which stamps externalRef back to the
/// upstream event id). recurrence is an optional RFC-5545 RRULE string carried verbatim for v1 --
/// expansion into concrete occurrences is a downstream concern, not stored here.
@displayCard(primary="title", secondary="startsAt", tertiary="location", status="source")
@rowAuthz(owner="ownerUserId")
concept calendarEvent {
  ownerUserId  string! @description("v1:identity:user.id who owns this event. Stamped from actor.userId at create time. Every read self-scopes on this field; it is the load-bearing per-row authz guard.")
  title        string! @description("Human-readable event title, e.g. 'Karate class' or 'Dentist'. Shown as the primary line on the event card and in agent-facing listings.")
  startsAt     datetime! @description("Event start instant (RFC3339). For allDay events this is midnight at the start of the day in the user's timezone. upcomingEvents + eventsByDay range over this field.")
  endsAt       datetime @description("Event end instant (RFC3339). Optional: a point-in-time reminder ('Call mom') may omit it. For allDay events this is the end-of-day (or the day after's midnight) boundary.")
  allDay       bool    @default("false") @description("True = a date-scoped event with no meaningful clock time (birthdays, holidays, 'out of office'). The frontend renders these in the all-day band; reminder logic uses the date rather than the instant.")
  location     string  @description("Free-form location text ('Dojo on 5th', 'Zoom', a street address). Not geocoded in v1.")
  notes        string  @description("Free-form notes / agenda / description body for the event.")
  recurrence   string  @description("Optional RFC-5545 RRULE recurrence rule carried verbatim (e.g. 'FREQ=WEEKLY;BYDAY=TU,TH'). Empty = a one-off event. v1 stores the rule but does not expand occurrences server-side; the reminder + listing surfaces treat the row as its next/seed instance.")
  source       enum("native", "externalSync")! @default("native") @description("Provenance discriminator. native = created in-app (the only writer in v1; the calendar tool + frontend stamp this). externalSync = mirrored from an external calendar (Google / CalDAV) via the knowledge:liveConnector sync path shipping later; those rows carry externalRef and are owned by the sync, not hand-edited.")
  externalRef  string  @description("When source=externalSync: the upstream event id (e.g. the Google Calendar event id) this row mirrors. Used by the future sync reconciler for idempotent upsert + deletion-propagation. Empty for native events.")
  deleted      bool    @default("false") @description("Soft-delete flag. The calendar delete action stamps this true rather than hard-deleting so the time-series history survives and a future external-sync reconciler can propagate the deletion upstream. Queries filter it out via isNotDeleted.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
}

/// Weekly booking hours a client owner publishes (memql#4142). Calendly-style
/// availability without a Calendly bill or a new SPA. Config is data -- flipping
/// `published` does not require a rebuild. Per-row authz: owned by the host.
@displayCard(primary="weekday", secondary="startLocal", tertiary="timezone", status="published")
@rowAuthz(owner="ownerUserId")
concept bookingHours {
  ownerUserId   string!  @description("v1:identity:user.id of the host who publishes these hours. Stamped from actor.userId.")
  weekday       enum("sun", "mon", "tue", "wed", "thu", "fri", "sat")!  @description("Day of week these hours apply, in the host's timezone.")
  startLocal    string!  @description("Local start time as HH:MM (24h) in timezone, e.g. \"09:00\".")
  endLocal      string!  @description("Local end time as HH:MM (24h) in timezone, e.g. \"17:00\". Must be after startLocal.")
  timezone      string!  @description("IANA timezone the local times are expressed in, e.g. America/Phoenix.")
  slotMinutes   int      @default("30")  @description("Booking slot length in minutes. Data, not source.")
  published     bool!    @description("When true, these hours are offered for booking. Flipped at runtime.")
  label         string   @description("Optional host-facing label, e.g. \"Office hours\".")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
}

/// A booking taken against published hours (memql#4142). Owned by the host so
/// the portal's host calendar is the operations surface. Booker identity is
/// payload (name + email), not a second owner. Cancel and reschedule append a
/// new version of this id -- there is no silent overwrite of history.
@displayCard(primary="bookerName", secondary="startsAt", tertiary="status", status="status")
@rowAuthz(owner="ownerUserId")
concept booking {
  ownerUserId      string!  @description("v1:identity:user.id of the host. Stamped from actor.userId. The per-row authz key.")
  hoursId          string   @description("Optional v1:calendar:bookingHours.id this slot was taken from.")
  startsAt         datetime!  @description("Booking start instant (RFC3339).")
  endsAt           datetime!  @description("Booking end instant (RFC3339).")
  bookerName       string!  @description("Who the slot is for. Displayed on the host's booking list.")
  bookerEmail      string   @pii  @description("Booker contact. Marked @pii: queries projecting it must constrain the caller.")
  status           enum("booked", "cancelled", "rescheduled")!  @description("Lifecycle. booked is the active hold; cancelled and rescheduled are terminal for this version. A reschedule writes a new booked row and stamps this one rescheduled.")
  notes            string   @description("Optional host or booker note.")
  rescheduledToId  string   @description("When status=rescheduled, the v1:calendar:booking.id of the replacement.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="references", field="hoursId", target=bookingHours, direction="outgoing")
  @relationship(type="references", field="rescheduledToId", target=booking, direction="outgoing")
}
