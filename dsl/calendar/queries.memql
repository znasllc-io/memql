// queries.memql
//
// Read surface for the app-native calendar (#642). Every query
// self-scopes on actor.userId -- a caller can NEVER read another
// user's events. The reactive harness's reminder triggers read
// upcomingEvents ("remind me the day before X"); the calendar
// tool's `list` / `find` actions and the frontend read the rest.
// Exposed as typed SDK methods on `conn.query`.

use common.traits.{ isNotDeleted }

/// Get a single calendar event by node id. Self-scoped: the ownerUserId==actor.userId predicate
/// guarantees a caller can only fetch their own events. Backs the calendar tool's update/delete
/// pre-read and the event detail view.
@mcp
@actor
query calendarEvent calendarEventById {
  args {
    eventId  string!
  }
  filter  row.id==args.eventId && ownerUserId==actor.userId && isNotDeleted
  shape   calendarEventFull
}

/// List the authenticated caller's events whose start falls within a [windowStart, windowEnd]
/// instant range, in start order. The reactive harness's reminder responsibilities read this for
/// the 'remind me the day before X' condition (pass windowStart=now, windowEnd=now+lookahead).
/// Self-scoped via actor.userId -- another user's events are never returned.
@mcp
@actor
query calendarEvent upcomingEvents {
  args {
    windowStart  datetime!
    windowEnd    datetime!
  }
  filter  ownerUserId==actor.userId && startsAt>=args.windowStart && startsAt<=args.windowEnd && isNotDeleted
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   calendarEventFull
}

/// List the authenticated caller's events that start on a given day, bounded by the caller-supplied
/// [dayStart, dayEnd] instants (computed in the user's timezone client-side). Self-scoped via
/// actor.userId. Backs the calendar tool's day view and 'what's on my schedule today' agent
/// queries.
@actor
query calendarEvent eventsByDay {
  args {
    dayStart  datetime!
    dayEnd    datetime!
  }
  filter  ownerUserId==actor.userId && startsAt>=args.dayStart && startsAt<args.dayEnd && isNotDeleted
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   calendarEventFull
}

/// Find the caller's own events by exact title. Self-scoped via actor.userId. Backs the calendar
/// tool's `find` action ('find my dentist appointment'); the agent passes the title it captured.
/// Exact match keeps the predicate SQL-pushdownable -- substring / semantic search is a downstream
/// concern (the agent can list a window via upcomingEvents and filter conversationally).
@actor
query calendarEvent findEvents {
  args {
    title  string!
  }
  filter  ownerUserId==actor.userId && title==args.title && isNotDeleted
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   calendarEventFull
}
