// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// automations/v1/data/conflictDetection/automation.memql
//
// PURPOSE:
// Automatically detects conflicts when new data records are created.
// When a record with a naturalKeyValue is inserted, this automation
// checks for existing confirmed records with the same natural key and
// record type. If conflicts are found, it notifies the space via an event
// so the UI can display the ConflictResolutionPanel.
//
// TRIGGER: New v1:data:record node created with a naturalKeyValue
//
// BEHAVIOR:
// 1. Extract the record's natural key and record type from event payload
// 2. Query confirmed records for matching naturalKeyValue + recordType
// 3. If matches found, emit a conflict detection event
// 4. Never auto-resolve -- always requires human approval
//
// SIDE EFFECTS:
// - Emits "data.conflicts.detected" event with conflict details
// - Does NOT modify any records

@description("Triggered on new v1:data:record creation with a non-empty naturalKeyValue. Queries confirmed records for matching natural key + record type; if any exist, emits 'data.conflicts.detected' event for the UI's ConflictResolutionPanel. Never auto-resolves -- always requires human approval.")
@eventField("id", "naturalKeyField", "naturalKeyValue", "recordType", "partitionId")
logic conflictDetection {
  args {
    event object!
  }
  body {
  // Query confirmed records with matching natural key + record type
  matchingConfirmed := query detectConflicts( partitionId: args.event.payload.partitionId, recordType: args.event.payload.recordType, naturalKeyValue: args.event.payload.naturalKeyValue )

  // If conflicts exist, emit detection event for the UI
  emitConflicts := if !matchingConfirmed.empty() { publishEvent( topic: "data.conflicts.detected", payload: { partitionId: args.event.payload.partitionId, recordId: args.event.payload.id, recordType: args.event.payload.recordType, naturalKeyField: args.event.payload.naturalKeyField, naturalKeyValue: args.event.payload.naturalKeyValue, matchCount: matchingConfirmed.count(), matches: matchingConfirmed.nodes(), requiresHumanApproval: true, timestamp: now } ) }

  return emitConflicts
  }
}
