// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@useConcept(log)
@description("Validation log entry projection with full audit trail fields")
shape logFull {
  row.id
  log.recordId
  log.action
  log.fromState
  log.toState
  log.identityId
  log.identityType
  log.spaceId
  log.note
  log.active
  row.createdAt
}

@row
@useConcept(policy)
@description("Validation policy projection with all configuration fields")
shape policyFull {
  row.id
  policy.targetRecordType
  policy.spaceId
  policy.requiredChecks
  policy.requiredConfirmations
  policy.checkedDataUsable
  policy.revertMinRole
  policy.active
  row.createdAt
}

@row
@useConcept(record)
@description("Comprehensive data record projection with validation lifecycle fields")
shape recordFull {
  row.id
  record.spaceId
  record.validationState
  record.recordType
  record.label
  record.naturalKeyField
  record.naturalKeyValue
  record.data
  record.importSource
  record.importedBy
  record.sourceAttachmentId
  record.confidence
  record.checkCount
  record.confirmCount
  record.lastCheckedBy
  record.lastCheckedAt
  record.lastConfirmedBy
  record.lastConfirmedAt
  record.active
  row.createdAt
}
