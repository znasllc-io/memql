// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Validation log entry projection with full audit trail fields
@row
shape log logFull {
  row.id
  recordId
  action
  fromState
  toState
  identityId
  identityType
  partitionId
  note
  active
  row.createdAt
}

/// Validation policy projection with all configuration fields
@row
shape policy policyFull {
  row.id
  targetRecordType
  partitionId
  requiredChecks
  requiredConfirmations
  checkedDataUsable
  revertMinRole
  active
  row.createdAt
}

/// Comprehensive data record projection with validation lifecycle fields
@row
shape record recordFull {
  row.id
  partitionId
  validationState
  recordType
  label
  naturalKeyField
  naturalKeyValue
  data
  importSource
  importedBy
  sourceAttachmentId
  confidence
  checkCount
  confirmCount
  lastCheckedBy
  lastCheckedAt
  lastConfirmedBy
  lastConfirmedAt
  active
  row.createdAt
}
