// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Detects conflicts between new data records and existing confirmed records. Emits events for UI
/// conflict resolution -- never auto-resolves.
@filter(row => row.naturalKeyValue != nil)
@trigger(event="node.created", concept="v1:data:record")
automation conflictDetection {
  args {
    id any
    naturalKeyField any
    naturalKeyValue any
    partitionId any
    recordType any
  }
  // Triggered on new v1:data:record creation with a non-empty naturalKeyValue. Queries confirmed
  // records for matching natural key + record type; if any exist, emits 'data.conflicts.detected'
  // event for the UI's ConflictResolutionPanel. Never auto-resolves -- always requires human
  // approval. The publishing is here because a logic may not publish (D14).
  // Query confirmed records with matching natural key + record type
  matchingConfirmed := query detectConflicts(partitionId: args.partitionId, recordType: args.recordType, naturalKeyValue: args.naturalKeyValue)

  // If conflicts exist, emit detection event for the UI
  if !matchingConfirmed.empty() {
    publish "data.conflicts.detected" { partitionId: args.partitionId, recordId: args.id, recordType: args.recordType, naturalKeyField: args.naturalKeyField, naturalKeyValue: args.naturalKeyValue, matchCount: matchingConfirmed.count(), matches: matchingConfirmed.nodes(), requiresHumanApproval: true, timestamp: now }
  }
}
