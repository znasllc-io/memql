// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.traits.{ isActiveRecord, isConfirmed, isUsable }

/// Find confirmed records that may conflict with a new record by natural key + record type
@unbounded("conflict probe by natural key -- a dedupe set the caller must see whole to detect conflicts")
query record detectConflicts {
  args {
    partitionId  string!
    naturalKeyValue  string!
    recordType  string!
  }
  filter  isConfirmed && partitionId==args.partitionId && recordType==args.recordType && naturalKeyValue==args.naturalKeyValue
  shape   recordFull
}

// ---- queries/v1/data/policy.memql ----

// policy - Query Validation Policy for a Record Type
// ====================================================
//
// Returns the active validation policy for a given record type.
// If a space-specific policy exists, it takes precedence over the
// global policy (where partitionId is null).
//
// Arguments:
//   targetRecordType (string, required) - Record type to look up policy for
//   partitionId (string, optional)          - Space to check for space-specific policy
//
// Returns:
//   Array of matching policies (space-specific first, then global)
//
// Usage:
//   policy({ targetRecordType: "vehicle" })                          // Global policy
//   policy({ targetRecordType: "vehicle", partitionId: "space-123" })    // Space-specific or global
//

/// Returns the validation policy for a record type. Space-specific policies take precedence over
/// global.
@unbounded("the active policy for a record type -- bounded to a single row")
query policy policy {
  args {
    targetRecordType  string!
    partitionId  string
  }
  filter  isActiveRecord && targetRecordType==args.targetRecordType && when(args.partitionId) { partitionId==args.partitionId }
  shape   policyFull
}

// ---- queries/v1/data/recordsByState.memql ----

// recordsByState - Query Data Records by Validation State
// ========================================================
//
// Returns active data records, optionally filtered by validation state,
// space, record type, and import source.
//
// Arguments:
//   partitionId (string, optional)         - Filter by space ID
//   recordType (string, optional)      - Filter by record type (e.g., 'vehicle', 'bird')
//   validationState (string, optional) - Filter by state: 'draft', 'checked', 'confirmed'
//   importSource (string, optional)    - Filter by import source
//
// Returns:
//   Array of data records with all fields
//
// Usage:
//   recordsByState()                                              // All active records
//   recordsByState({ validationState: "draft" })                  // All draft records
//   recordsByState({ partitionId: "space-123", validationState: "confirmed" })  // Confirmed in a space
//   recordsByState({ partitionId: "space-123", recordType: "vehicle" })         // By type in a space
//

/// Returns active data records. Optional filters: partitionId, recordType, validationState,
/// importSource
query record recordsByState {
  args {
    partitionId  string
    recordType  string
    validationState  string
    importSource  string
  }
  filter  isActiveRecord && when(args.partitionId) { partitionId==args.partitionId } && when(args.recordType) { recordType==args.recordType } && when(args.validationState) { validationState==args.validationState } && when(args.importSource) { importSource==args.importSource }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   recordFull
}

// ---- queries/v1/data/usableRecords.memql ----

// usableRecords - Query Usable Data Records
// ===========================================
//
// Returns data records that are considered usable. Confirmed records are
// always usable. Checked records are usable only if the concept's policy
// has checkedDataUsable=true.
//
// The caller should query the policy first to determine usability, then
// pass the appropriate includeChecked flag.
//
// Arguments:
//   partitionId (string, optional)         - Filter by space ID
//   recordType (string, optional)      - Filter by record type
//   includeChecked (bool, optional)    - Whether to include checked records (based on policy)
//
// Returns:
//   Array of usable data records
//
// Usage:
//   usableRecords({ partitionId: "space-123" })                       // Confirmed only (default)
//   usableRecords({ partitionId: "space-123", includeChecked: true })  // Checked + confirmed
//
// Implementation note: Because the MemQL parser does not yet support
// if-expression assignment (:=), this function always queries using
// isUsable (which matches both checked and confirmed). When
// includeChecked is false, the caller should use isConfirmed
// directly in their query instead.
//

/// Returns usable data records (confirmed, or checked if policy allows)
query record usableRecords {
  args {
    partitionId  string
    recordType  string
  }
  filter  isUsable && when(args.partitionId) { partitionId==args.partitionId } && when(args.recordType) { recordType==args.recordType }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   recordFull
}

// ---- queries/v1/data/validationLog.memql ----

// validationLog - Query Validation State Change History
// ======================================================
//
// Returns the audit trail of validation state transitions (check, confirm,
// revert) for records. Replaces the old promotionHistory query.
//
// Arguments:
//   recordId (string, optional) - Filter by specific record
//   partitionId (string, optional)  - Filter by space
//   action (string, optional)   - Filter by action type: 'check', 'confirm', 'revert'
//
// Returns:
//   Array of log entries with full audit trail fields
//
// Usage:
//   validationLog({ recordId: "record-uuid" })                      // All actions for a record
//   validationLog({ partitionId: "space-123" })                         // All actions in a space
//   validationLog({ partitionId: "space-123", action: "confirm" })      // Confirmations in a space
//

/// Returns validation state change history. Optional filters: recordId, partitionId, action
query log validationLog {
  args {
    recordId  string
    partitionId  string
    action  string
  }
  filter  isActiveRecord && when(args.recordId) { recordId==args.recordId } && when(args.partitionId) { partitionId==args.partitionId } && when(args.action) { action==args.action }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   logFull
}
