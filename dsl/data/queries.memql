// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@enabled
@useConcept(record)
@description("Find confirmed records that may conflict with a new record by natural key + record type")
query queryDetectConflicts {
  args {
    spaceId  string  @required
    naturalKeyValue  string  @required
    recordType  string  @required
  }
  filter  traitIsConfirmed; payload.spaceId==args.spaceId; payload.recordType==args.recordType; payload.naturalKeyValue==args.naturalKeyValue
  shape   recordFull
}

// ---- queries/v1/data/policy.memql ----

// policy - Query Validation Policy for a Record Type
// ====================================================
//
// Returns the active validation policy for a given record type.
// If a space-specific policy exists, it takes precedence over the
// global policy (where spaceId is null).
//
// Arguments:
//   targetRecordType (string, required) - Record type to look up policy for
//   spaceId (string, optional)          - Space to check for space-specific policy
//
// Returns:
//   Array of matching policies (space-specific first, then global)
//
// Usage:
//   policy({ targetRecordType: "vehicle" })                          // Global policy
//   policy({ targetRecordType: "vehicle", spaceId: "space-123" })    // Space-specific or global
//

@enabled
@useConcept(policy)
@description("Returns the validation policy for a record type. Space-specific policies take precedence over global.")
query queryPolicy {
  args {
    targetRecordType  string  @required
    spaceId  string
  }
  filter  traitIsActiveRecord; payload.targetRecordType==args.targetRecordType; ?.payload.spaceId==args.spaceId
  shape   policyFull
}

// ---- queries/v1/data/recordsByState.memql ----

// recordsByState - Query Data Records by Validation State
// ========================================================
//
// Returns active data records, optionally filtered by validation state,
// space, record type, and import source.
//
// Arguments:
//   spaceId (string, optional)         - Filter by space ID
//   recordType (string, optional)      - Filter by record type (e.g., 'vehicle', 'bird')
//   validationState (string, optional) - Filter by state: 'draft', 'checked', 'confirmed'
//   importSource (string, optional)    - Filter by import source
//
// Returns:
//   Array of data records with all fields
//
// Usage:
//   recordsByState()                                              // All active records
//   recordsByState({ validationState: "draft" })                  // All draft records
//   recordsByState({ spaceId: "space-123", validationState: "confirmed" })  // Confirmed in a space
//   recordsByState({ spaceId: "space-123", recordType: "vehicle" })         // By type in a space
//

@enabled
@useConcept(record)
@description("Returns active data records. Optional filters: spaceId, recordType, validationState, importSource")
query queryRecordsByState {
  args {
    spaceId  string
    recordType  string
    validationState  string
    importSource  string
  }
  filter  traitIsActiveRecord; ?.payload.spaceId==args.spaceId; ?.payload.recordType==args.recordType; ?.payload.validationState==args.validationState; ?.payload.importSource==args.importSource
  shape   recordFull
}

// ---- queries/v1/data/usableRecords.memql ----

// usableRecords - Query Usable Data Records
// ===========================================
//
// Returns data records that are considered usable. Confirmed records are
// always usable. Checked records are usable only if the concept's policy
// has checkedDataUsable=true.
//
// The caller should query the policy first to determine usability, then
// pass the appropriate includeChecked flag.
//
// Arguments:
//   spaceId (string, optional)         - Filter by space ID
//   recordType (string, optional)      - Filter by record type
//   includeChecked (bool, optional)    - Whether to include checked records (based on policy)
//
// Returns:
//   Array of usable data records
//
// Usage:
//   usableRecords({ spaceId: "space-123" })                       // Confirmed only (default)
//   usableRecords({ spaceId: "space-123", includeChecked: true })  // Checked + confirmed
//
// Implementation note: Because the MemQL parser does not yet support
// if-expression assignment (:=), this function always queries using
// traitIsUsable (which matches both checked and confirmed). When
// includeChecked is false, the caller should use traitIsConfirmed
// directly in their query instead.
//

@enabled
@useConcept(record)
@description("Returns usable data records (confirmed, or checked if policy allows)")
query queryUsableRecords {
  args {
    spaceId  string
    recordType  string
  }
  filter  traitIsUsable; ?.payload.spaceId==args.spaceId; ?.payload.recordType==args.recordType
  shape   recordFull
}

// ---- queries/v1/data/validationLog.memql ----

// validationLog - Query Validation State Change History
// ======================================================
//
// Returns the audit trail of validation state transitions (check, confirm,
// revert) for records. Replaces the old promotionHistory query.
//
// Arguments:
//   recordId (string, optional) - Filter by specific record
//   spaceId (string, optional)  - Filter by space
//   action (string, optional)   - Filter by action type: 'check', 'confirm', 'revert'
//
// Returns:
//   Array of log entries with full audit trail fields
//
// Usage:
//   validationLog({ recordId: "record-uuid" })                      // All actions for a record
//   validationLog({ spaceId: "space-123" })                         // All actions in a space
//   validationLog({ spaceId: "space-123", action: "confirm" })      // Confirmations in a space
//

@enabled
@useConcept(log)
@description("Returns validation state change history. Optional filters: recordId, spaceId, action")
query queryValidationLog {
  args {
    recordId  string
    spaceId  string
    action  string
  }
  filter  traitIsActiveRecord; ?.payload.recordId==args.recordId; ?.payload.spaceId==args.spaceId; ?.payload.action==args.action
  shape   logFull
}
