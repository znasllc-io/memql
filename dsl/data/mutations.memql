// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use data.concepts.{ policy, record }

@enabled
@description("Synthetically check a data record, updating check count and validation state")
mutate record checkRecord {
  args {
    recordId       string  @required
    identityId     string  @required
    newCheckCount  number  @required
    newState       string  @required
  }
  update {
    id: args.recordId
    checkCount: args.newCheckCount
    lastCheckedBy: args.identityId
    lastCheckedAt: now
    validationState: args.newState
  }
}

// ---- mutations/v1/data/confirmRecord.memql ----

// confirmRecord - Human Validate a Data Record
// ===============================================
//
// Performs a human confirmation on a data record. Only human identities
// should call this. Updates the confirm count and validation state.
// Audit logging is handled by the conflictDetection automation.
//
// Arguments:
//   recordId (string, required)        - ID of the record to confirm
//   identityId (string, required)      - Human identity performing the confirmation
//   newConfirmCount (number, required)  - New confirm count (caller increments before calling)
//   newState (string, required)         - New validation state (caller determines based on policy)
//
// Usage:
//   confirmRecord({
//     recordId: "record-uuid",
//     identityId: "human-identity-uuid",
//     newConfirmCount: 1,
//     newState: "confirmed"
//   })
//

@enabled
@description("Human confirm a data record, updating confirm count and validation state")
mutate record confirmRecord {
  args {
    recordId         string  @required
    identityId       string  @required
    newConfirmCount  number  @required
    newState         string  @required
  }
  update {
    id: args.recordId
    confirmCount: args.newConfirmCount
    lastConfirmedBy: args.identityId
    lastConfirmedAt: now
    validationState: args.newState
  }
}

// ---- mutations/v1/data/createRecord.memql ----

// createRecord - Create a Data Record
// =====================================
//
// Creates a new data record in draft validation state.
// Draft records are work-in-progress data awaiting synthetic checks
// and human confirmation before becoming usable.
//
// Arguments:
//   recordId (string, required)           - Unique record ID (UUID)
//   partitionId (string, required)            - Space this record belongs to
//   recordType (string, required)         - Domain-specific type (e.g., 'vehicle', 'bird')
//   label (string, required)              - Display label
//   data (object, required)               - The actual data payload
//   importSource (string, required)       - How imported: chat-ai-research, chat-file-upload, manual
//   importedBy (string, required)         - Identity ID of the importer
//   naturalKeyField (string, optional)    - Natural key field name for conflict detection
//   naturalKeyValue (string, optional)    - Natural key value for conflict matching
//   sourceAttachmentId (string, optional) - Reference to source attachment
//   confidence (number, optional)         - AI confidence score (0-1)
//
// Usage:
//   createRecord({
//     recordId: "uuid-123",
//     partitionId: "space-456",
//     recordType: "vehicle",
//     label: "2024 Toyota Camry",
//     data: { make: "Toyota", model: "Camry", year: 2024, vin: "1HGBH41JXMN109186" },
//     importSource: "chat-ai-research",
//     importedBy: "identity-789",
//     naturalKeyField: "vin",
//     naturalKeyValue: "1HGBH41JXMN109186"
//   })
//

@enabled
@description("Create a data record in draft validation state awaiting check and confirmation")
mutate record createRecord {
  args {
    recordId            string  @required
    partitionId             string  @required
    recordType          string  @required
    label               string  @required
    data                object  @required
    importSource        string  @required
    importedBy          string  @required
    naturalKeyField     string
    naturalKeyValue     string
    sourceAttachmentId  string
    confidence          number
    createdAt           string
  }
  insert {
    id: args.recordId
    createdAt: coalesce(args.createdAt, now)
    args.partitionId
    args.recordType
    args.label
    args.data
    args.importSource
    args.importedBy
    args.naturalKeyField
    args.naturalKeyValue
    args.sourceAttachmentId
    args.confidence
    validationState: "draft"
    checkCount: 0
    confirmCount: 0
    active: true
  }
}

// ---- mutations/v1/data/createRecordBatch.memql ----

// createRecordBatch - Create a Single Record from a Batch Import
// ===============================================================
//
// Creates a single data record in draft state as part of a batch import.
// The frontend calls this once per record in the batch.
//
// Note: MemQL mutations support exactly one insert per call.
// For batch imports, the frontend iterates over records and calls
// this mutation for each one.
//
// Arguments:
//   recordId (string, required)           - Unique ID for this record
//   partitionId (string, required)            - Space this record belongs to
//   recordType (string, required)         - Domain-specific type
//   label (string, required)              - Display label
//   data (object, required)               - The data payload
//   importSource (string, required)       - How imported: chat-file-upload, chat-ai-research, manual
//   importedBy (string, required)         - Identity ID of the importer
//   sourceAttachmentId (string, optional) - Reference to source attachment
//   naturalKeyField (string, optional)    - Natural key field name
//   naturalKeyValue (string, optional)    - Natural key value
//   confidence (number, optional)         - AI confidence score
//
// Usage:
//   createRecordBatch({
//     recordId: "uuid-1",
//     partitionId: "space-456",
//     recordType: "vehicle",
//     label: "2024 Camry",
//     data: { make: "Toyota", model: "Camry" },
//     importSource: "chat-file-upload",
//     importedBy: "identity-789"
//   })
//

@enabled
@description("Create a single data record from a batch import in draft validation state (called once per record)")
mutate record createRecordBatch {
  args {
    recordId            string  @required
    partitionId             string  @required
    recordType          string  @required
    label               string  @required
    data                object  @required
    importSource        string  @required
    importedBy          string  @required
    sourceAttachmentId  string
    naturalKeyField     string
    naturalKeyValue     string
    confidence          number
  }
  insert {
    id: args.recordId
    args.partitionId
    args.recordType
    args.label
    args.data
    args.importSource
    args.importedBy
    args.sourceAttachmentId
    args.naturalKeyField
    args.naturalKeyValue
    args.confidence
    validationState: "draft"
    checkCount: 0
    confirmCount: 0
    active: true
  }
}

// ---- mutations/v1/data/deleteRecord.memql ----

// deleteRecord - Soft-Delete a Data Record
// ==========================================
//
// Soft-deletes a data record by inserting a new version with active=false.
// Uses append-only semantics (the record is not physically removed).
// Works regardless of validation state.
//
// Arguments:
//   recordId (string, required) - ID of the record to delete
//   partitionId (string, required)  - Space ID for validation
//
// Usage:
//   deleteRecord({ recordId: "record-uuid", partitionId: "space-456" })
//

@enabled
@description("Soft-delete a data record (sets active=false)")
mutate record deleteRecord {
  args {
    recordId  string  @required
  }
  update {
    id: args.recordId
    active: false
  }
}

// ---- mutations/v1/data/revertRecord.memql ----

// revertRecord - Revert a Data Record to a Previous Validation State
// ====================================================================
//
// Reverts a data record to a previous validation state. Resets the
// appropriate counters:
//   - Revert to draft: resets both checkCount and confirmCount
//   - Revert to checked: resets only confirmCount
//
// Only identities with sufficient role (per policy's revertMinRole) should
// call this. The caller is responsible for verifying authority.
// Audit logging is handled by the conflictDetection automation.
//
// Arguments:
//   recordId (string, required)     - ID of the record to revert
//   toState (string, required)      - Target state ("draft" or "checked")
//   checkCount (number, required)   - New check count after revert
//   confirmCount (number, required) - New confirm count after revert
//
// Usage:
//   revertRecord({
//     recordId: "record-uuid",
//     toState: "draft",
//     checkCount: 0,
//     confirmCount: 0
//   })
//

@enabled
@description("Revert a data record to a previous validation state with counter reset")
mutate record revertRecord {
  args {
    recordId      string  @required
    toState       string  @required
    checkCount    number  @required
    confirmCount  number  @required
  }
  update {
    id: args.recordId
    validationState: args.toState
    args.checkCount
    args.confirmCount
  }
}

// ---- mutations/v1/data/setPolicy.memql ----

// setPolicy - Create or Update a Validation Policy
// ==================================================
//
// Creates or updates a validation policy for a record type.
// Policies control how many synthetic checks and human confirmations
// are required, and whether checked data is usable before confirmation.
//
// Arguments:
//   policyId (string, required)              - Unique policy ID
//   targetRecordType (string, required)      - Record type this policy applies to
//   partitionId (string, optional)               - Space scope (null = global for this record type)
//   requiredChecks (number, optional)        - Synthetic checks needed (default: 1)
//   requiredConfirmations (number, optional) - Human confirmations needed (default: 1)
//   checkedDataUsable (bool, optional)       - Whether checked data is usable live (default: false)
//   revertMinRole (string, optional)         - Minimum role to revert (default: "admin")
//
// Usage:
//   setPolicy({
//     policyId: "policy-uuid",
//     targetRecordType: "vehicle",
//     requiredChecks: 2,
//     requiredConfirmations: 1,
//     checkedDataUsable: true
//   })
//

@enabled
@description("Create or update a validation policy for a record type")
mutate policy setPolicy {
  args {
    policyId               string  @required
    targetRecordType       string  @required
    partitionId                string
    requiredChecks         number
    requiredConfirmations  number
    checkedDataUsable      bool
    revertMinRole          string
  }
  insert {
    id: args.policyId
    args.targetRecordType
    args.partitionId
    requiredChecks: coalesce(args.requiredChecks, 1)
    requiredConfirmations: coalesce(args.requiredConfirmations, 1)
    checkedDataUsable: coalesce(args.checkedDataUsable, false)
    revertMinRole: coalesce(args.revertMinRole, "admin")
    active: true
  }
}

// ---- mutations/v1/data/updateRecord.memql ----

// updateRecord - Update a Data Record
// =====================================
//
// Updates a data record with new data. Resets validation state to draft
// and zeroes check/confirm counts because the data has changed and prior
// validations are no longer valid.
//
// Uses append-only semantics (new version with same ID).
//
// Arguments:
//   recordId (string, required)        - ID of the record to update
//   data (object, optional)            - Updated data payload
//   label (string, optional)           - Updated display label
//   naturalKeyField (string, optional) - Updated natural key field name
//   naturalKeyValue (string, optional) - Updated natural key value
//   confidence (number, optional)      - Updated confidence score
//
// Usage:
//   updateRecord({
//     recordId: "record-uuid",
//     data: { make: "Toyota", model: "Camry", year: 2025 },
//     label: "2025 Toyota Camry"
//   })
//

@enabled
@description("Update a data record (resets validation state to draft)")
mutate record updateRecord {
  args {
    recordId         string  @required
    data             object
    label            string
    naturalKeyField  string
    naturalKeyValue  string
    confidence       number
  }
  update {
    id: args.recordId
    args.data
    args.label
    args.naturalKeyField
    args.naturalKeyValue
    args.confidence
    validationState: "draft"
    checkCount: 0
    confirmCount: 0
  }
}
