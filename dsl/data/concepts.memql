// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.


@namespace("data")
@description("Audit log entry for validation state transitions. Tracks who performed each check, confirm, or revert action, when, and why.")
concept log {
  active        bool    @default("true")  @description("Soft-delete flag (append-only semantics)")
  recordId      string!  @description("The v1:data:record node ID this log entry refers to")
  action        enum("check", "confirm", "revert")!  @description("Action performed")
  fromState     enum("draft", "checked", "confirmed")!  @description("Validation state before the action")
  toState       enum("draft", "checked", "confirmed")!  @description("Validation state after the action")
  identityId    string!  @description("Identity who performed the action")
  identityType  enum("human", "synthetic")!  @description("Type of identity (denormalized for fast filtering)")
  partitionId       string!  @description("Space ID for scoped log queries")
  note          string  @description("Optional reason, especially useful for reverts")

  @relationship(type="parent", field="recordId", target=record, direction="outgoing")
}

@namespace("data")
@description("Validation policy defining check/confirm requirements for a record type. Controls how many synthetic checks and human confirmations are needed, and whether checked data is usable before full confirmation.")
concept policy {
  active                bool    @default("true")  @description("Soft-delete flag (append-only semantics)")
  targetRecordType      string!  @description("Record type this policy applies to (e.g., 'vehicle', 'bird')")
  partitionId               string  @description("Optional space scope. Null means global for this record type.")
  requiredChecks        int     @default("1")  @description("Number of synthetic checks needed for draft -> checked")
  requiredConfirmations int     @default("1")  @description("Number of human confirmations needed for checked -> confirmed")
  checkedDataUsable     bool    @default("false")  @description("Whether checked (not yet confirmed) records are usable live")
  revertMinRole         enum("owner", "admin", "writer", "reader")  @default("admin")  @description("Minimum role required to revert records")

}

@namespace("data")
@description("Data record with validation lifecycle: draft -> checked -> confirmed. Replaces the staging/production split with a unified concept where data visibility is governed by validation state and policy.")
concept record {
  active              bool      @default("true")  @description("Soft-delete flag (append-only semantics)")
  validationState     enum("draft", "checked", "confirmed")  @default("draft")  @description("Current lifecycle state")
  data                object!  @description("The actual data payload")
  label               string!  @description("Human-readable display label")
  recordType          string!  @description("Domain-specific record type (e.g., 'vehicle', 'bird', 'employee')")
  partitionId             string!  @description("Space this record belongs to")
  importSource        enum("chat-ai-research", "chat-file-upload", "manual")!  @description("How this data was imported")
  importedBy          string!  @description("Identity ID of the importer")
  naturalKeyField     string    @description("Name of the natural key field for conflict detection (e.g., 'vin', 'name')")
  naturalKeyValue     string    @description("Value of the natural key for conflict matching")
  sourceAttachmentId  string    @description("Reference to source attachment if file-based import")
  confidence          float     @description("AI confidence score (0-1)")
  checkCount          int       @default("0")  @description("Number of synthetic checks received")
  confirmCount        int       @default("0")  @description("Number of human confirmations received")
  lastCheckedBy       string    @description("Identity ID of last synthetic checker")
  lastCheckedAt       datetime  @description("When last checked by a synthetic identity")
  lastConfirmedBy     string    @description("Identity ID of last human confirmer")
  lastConfirmedAt     datetime  @description("When last confirmed by a human identity")

}
