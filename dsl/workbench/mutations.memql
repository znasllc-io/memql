// mutations.memql -- workbench namespace
//
// Lifecycle mutations for v1:workbench:workspace rows. Called by
// the workbench integration on the agent node; not user-facing.
//
// Idempotency: provisionWorkspace is the only path that creates a
// row. The integration calls it once per Plan lazily on first
// dispatch; if a row already exists, the call is a no-op at the
// Go level (the integration short-circuits before invoking the
// mutation). The release path is similarly single-write.

/// Create the v1:workbench:workspace row for a Plan on first workbenchHost call. Storage root is
/// supplied by the workbench integration which has already created the directory on disk.
///
/// ownerUserId is STAMPED FROM THE ACTOR (memql#4354). The concept declares
/// @rowAuthz(owner="ownerUserId", clusterOwner), and a declared owner field written from caller
/// args fails TestDeclaredOwnerFieldsAreServerStamped. The workbench integration therefore runs
/// this write under auth.ContextWithUserActor for the parent plan's requestedBy, which it has
/// already resolved in order to know whose plan it is executing.
///
/// nodeId is the serving replica's own MEMQL_NODE_ID, supplied by the node that just made the
/// directory. It is an arg rather than a stamp because only that node knows it, and it is not
/// forgeable to any useful end: naming another replica would send the picker somewhere the
/// directory is not, which reads as a node loss and re-provisions.
@actor
mutate workspace provisionWorkspace {
  args {
    workspaceId  string!
    planId       string!
    storageRoot  string!
    nodeId       string
  }
  insert {
    accept { planId, storageRoot }
    stamp {
      id: args.workspaceId
      ownerUserId: actor.userId
      nodeId: args.nodeId ?? ""
      status: "provisioned"
      createdAt: now
      lastUsedAt: now
      releasedAt: ""
      releasedReason: ""
    }
  }
}

/// Bump lastUsedAt on a workbench workspace after a successful dispatch. Cheap; called per
/// successful workbenchHost call.
mutate workspace touchWorkspace {
  args {
    workspaceId  string!
  }
  update {
    id: args.workspaceId
    lastUsedAt: now
  }
}

/// Mark a workbench workspace as released. Called from releaseWorkspaceOnPlanTerminal when the
/// parent Plan reaches a terminal status. The actual on-disk teardown is the workbench
/// integration's responsibility -- this mutation only flips the lifecycle bit.
mutate workspace releaseWorkspace {
  args {
    workspaceId  string!
    reason       enum("plan_terminal", "explicit", "ttl_expired", "node_lost")!
  }
  update {
    id: args.workspaceId
    status: "released"
    releasedAt: now
    releasedReason: args.reason
  }
}
