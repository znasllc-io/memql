// mutations.memql -- workbench namespace
//
// Lifecycle mutations for v1:workbench:workspace rows. Called by
// the workbench integration on the agent node; not user-facing.
//
// Idempotency: provisionWorkspace is the only path that creates a
// row. The integration calls it once per Plan lazily on first
// dispatch; if a row already exists, the call is a no-op at the
// Go level (the integration short-circuits before invoking the
// mutation). The release path is similarly single-write.

/// Create the v1:workbench:workspace row for a run on first workbenchHost call. Storage root is
/// supplied by the workbench integration which has already created the directory on disk.
///
/// ownerUserId is STAMPED FROM THE ACTOR (memql#4354). The concept declares
/// @rowAuthz(owner="ownerUserId", clusterOwner), and a declared owner field written from caller
/// args fails TestDeclaredOwnerFieldsAreServerStamped. The workbench integration therefore runs
/// this write under auth.ContextWithUserActor for the parent plan's requestedBy, which it has
/// already resolved in order to know whose plan it is executing.
///
/// nodeId is the serving replica's own MEMQL_NODE_ID, supplied by the node that just made the
/// directory. It is an arg rather than a stamp because only that node knows it, and it is not
/// forgeable to any useful end: naming another replica would send the picker somewhere the
/// directory is not, which reads as a node loss and re-provisions.
@actor
mutation workspace provisionWorkspace {
  args {
    workspaceId  string!
    runId        string!
    storageRoot  string!
    nodeId       string
  }
  insert {
    accept { runId, storageRoot }
    stamp {
      id: args.workspaceId
      ownerUserId: actor.userId
      nodeId: args.nodeId ?? ""
      status: "provisioned"
      createdAt: now
      lastUsedAt: now
      releasedAt: ""
      releasedReason: ""
    }
  }
}

/// Bump lastUsedAt on a workbench workspace after a successful dispatch. Cheap; called per
/// successful workbenchHost call.
mutation workspace touchWorkspace {
  args {
    workspaceId  string!
  }
  update {
    id: args.workspaceId
    lastUsedAt: now
  }
}

/// Mark a workbench workspace as released. Called from releaseWorkspaceOnRunTerminal when the
/// parent run reaches a terminal status. The actual on-disk teardown is the workbench
/// integration's responsibility -- this mutation only flips the lifecycle bit.
mutation workspace releaseWorkspace {
  args {
    workspaceId  string!
    reason       enum("plan_terminal", "run_terminal", "explicit", "ttl_expired", "node_lost")!
  }
  update {
    id: args.workspaceId
    status: "released"
    releasedAt: now
    releasedReason: args.reason
  }
}


/// Native dispatch creates this once with an absence fence across replicas.
/// The concept also refuses raw/inline writes without internal origin.
/// actor.userId scoping proves ownership, but cannot let the caller choose an
/// unconsenting machine or replace a goal’s existing workspace. The native
/// dispatcher reads consent and takes an absence fence before this write.
@serverOnly
@actor
mutation executionBinding bindWorkbenchExecution {
  args {
    bindingId string!
    runId string!
    resource enum("cloud", "fleet")!
    registrationId string!
    machineId string!
    machineOwnerUserId string!
    expiresAt datetime!
  }
  insert {
    accept { runId, resource, registrationId, machineId, machineOwnerUserId, expiresAt }
    stamp { id: args.bindingId, ownerUserId: actor.userId, generation: 0, stateLost: false }
  }
}

/// Native lifecycle only, with a row-version fence and fresh run/machine authority.
/// Placement and owner cannot change; recovery never executes the prior operation.
/// actor.userId scoping proves row ownership, but cannot authorize renewal after
/// machine consent is revoked or prove that the expected filesystem generation
/// was lost. The native lifecycle rechecks run authority and, for renewal or
/// recovery, machine consent; it validates the transition and fences the exact
/// row version before advancing the binding.
@serverOnly
@actor
mutation executionBinding advanceWorkbenchExecution {
  args {
    bindingId string!
    expiresAt datetime!
    generation int!
    stateLost bool!
    versionTime datetime!
  }
  update {
    accept { expiresAt, generation, stateLost }
    stamp {
      id: args.bindingId
      createdAt: args.versionTime
    }
  }
}
