// queries.memql -- workbench namespace
//
// Read paths for v1:workbench:workspace rows. The integration uses
// workspaceForPlan as the existence-check before the lazy
// provision path.

/// Look up the workbench workspace row for a Plan. Returns empty when no workspace has been
/// provisioned yet -- the integration uses this to decide whether to call provisionWorkspace on the
/// first workbenchHost dispatch.
@unbounded("the workspace for a plan -- a per-plan singleton bounded to a single row")
query workspace workspaceForPlan {
  args {
    planId  string!
  }
  filter  planId==args.planId
  shape   workspaceFull
}

/// List provisioned workspaces for inventory / debugging. Filtered to status=provisioned so
/// released rows don't clutter the view.
@unbounded("provisioned workspaces -- an internal lifecycle sweep that must see all")
query workspace provisionedWorkspaces {
  filter  status=="provisioned"
  shape   workspaceFull
}

// ---- The Fleet: /fleet/workbenches (epic memql#4349, memql#4356) ----
//
// v1:workbench:workspace declares @rowAuthz(owner="ownerUserId", clusterOwner),
// so the engine decides the rows; what these two add is the CALLER SCOPE the
// classifier reads, and the status axis the page toggles.
//
// provisionedWorkspaces above stays as it is -- an inventory read filtered to
// live rows -- and is now row-gated like everything else.

/// The caller's own workbench workspaces, live and released, newest first. Backs the workspaces
/// list on /fleet/workbenches for a person who is not a cluster owner.
@actor
query workspace myWorkspaces {
  filter   ownerUserId==actor.userId
  sort     "row.createdAt", "desc"
  paginate 100
  shape    workspaceFull
}

/// Every workbench workspace in the cluster, for a cluster owner; optionally narrowed to one
/// status. Backs the operator view of /fleet/workbenches, which answers "why is this workbench
/// node full".
@actor
query workspace allWorkspaces {
  args {
    status  string  @enum("provisioned", "released")
  }
  filter   actor.isClusterOwner==true && when(args.status) { status==args.status }
  sort     "row.createdAt", "desc"
  paginate 200
  shape    workspaceFull
}
