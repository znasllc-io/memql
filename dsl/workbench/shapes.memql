// shapes.memql -- workbench namespace

@row
@description("Full projection of a v1:workbench:workspace row. Used by workspaceForPlan (the integration's existence-check) and provisionedWorkspaces (inventory).")
shape workspace workspaceFull {
  row.id
  planId
  status
  storageRoot
  createdAt
  lastUsedAt
  releasedAt
  releasedReason
}
