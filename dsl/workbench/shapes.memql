// shapes.memql -- workbench namespace

/// Full projection of a v1:workbench:workspace row. Used by workspaceForPlan (the integration's
/// existence-check) and provisionedWorkspaces (inventory).
@row
shape workspace workspaceFull {
  row.id
  planId
  status
  storageRoot
  createdAt
  lastUsedAt
  releasedAt
  releasedReason
}
