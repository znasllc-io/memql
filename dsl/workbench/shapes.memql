// shapes.memql -- workbench namespace

/// Full projection of a v1:workbench:workspace row. Used by workspaceForRun (the integration's
/// existence-check) and provisionedWorkspaces (inventory).
@row
shape workspace workspaceFull {
  row.id
  runId
  ownerUserId
  nodeId
  status
  storageRoot
  row.createdAt
  lastUsedAt
  releasedAt
  releasedReason
}


@row
shape executionBinding executionBindingFull {
  row.id
  row.createdAt
  runId
  ownerUserId
  resource
  registrationId
  machineId
  machineOwnerUserId
  expiresAt
  generation
  stateLost
}
