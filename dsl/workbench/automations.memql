// automations.memql -- workbench namespace
//
// Workspace lifecycle is driven by the parent Plan's terminal
// status. When a Plan reaches succeeded / failed / cancelled, the
// workbench workspace is released and its filesystem state is
// torn down. The Go integration owns the on-disk teardown; this
// automation flips the concept's lifecycle bit and emits the
// event the integration listens for.

use workbench.logic.{ planIsTerminal, releaseWorkspaceOnPlanTerminal }
use workbench.mutations.{ releaseWorkspace }
use workbench.builtins.{ workbenchTeardownDirectory }

@enabled
@trigger(event="graph.node.updated.v1:planner:plan")
@description("When a Plan transitions to a terminal status (succeeded / failed / cancelled), release the associated workbench workspace if one exists and tear down its on-disk directory. terminal (pure logic planIsTerminal) owns the terminal-status vocabulary ONCE (#2370); decide (pure) returns the plan's workspaces; apply releases each still-provisioned one and teardown removes the directory tree (even when no concept row exists -- the MVP integration provisions without writing the row), both gated on the terminal scalar.")
automation releaseWorkspaceOnPlanTerminal {
  step terminal {
    logic planIsTerminal ( status: event.node.payload.status )
  }
  step decide {
    logic releaseWorkspaceOnPlanTerminal ( event: event )
  }
  step apply {
    forEach item in decide.nodes() {
      if steps.terminal.result == true && item.payload.status == "provisioned" {
        releaseWorkspace {
          workspaceId: item.id,
          reason: "plan_terminal"
        }
      }
    }
  }
  step teardown {
    if steps.terminal.result == true && exists(event.node.id) {
      builtin workbenchTeardownDirectory (
        planId: event.node.id
      )
    }
  }
}
