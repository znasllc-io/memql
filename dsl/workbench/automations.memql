// automations.memql -- workbench namespace
//
// Workspace lifecycle is driven by the parent Plan's terminal
// status. When a Plan reaches succeeded / failed / cancelled, the
// workbench workspace is released and its filesystem state is
// torn down. The Go integration owns the on-disk teardown; this
// automation flips the concept's lifecycle bit and emits the
// event the integration listens for.

use workbench.logic.{ releaseWorkspaceOnPlanTerminal }
use workbench.mutations.{ releaseWorkspace }
use workbench.builtins.{ workbenchTeardownDirectory }

@enabled
@trigger(event="graph.node.updated.v1:planner:plan")
@description("When a Plan transitions to a terminal status (succeeded / failed / cancelled), release the associated workbench workspace if one exists and tear down its on-disk directory. decide (pure) returns the plan's workspaces; apply releases each still-provisioned one (gated on terminal status); teardown removes the directory tree on terminal status even when no concept row exists (the MVP integration provisions in-memory + on-disk without writing the row).")
automation releaseWorkspaceOnPlanTerminal {
  step decide {
    logic releaseWorkspaceOnPlanTerminal { event: event }
  }
  step apply {
    forEach item in decide.Nodes() {
      if item.payload.status == "provisioned" && (event.node.payload.status == "succeeded" || event.node.payload.status == "failed" || event.node.payload.status == "cancelled") {
        releaseWorkspace {
          workspaceId: item.id,
          reason: "plan_terminal"
        }
      }
    }
  }
  step teardown {
    if exists(event.node.id) && (event.node.payload.status == "succeeded" || event.node.payload.status == "failed" || event.node.payload.status == "cancelled") {
      workbenchTeardownDirectory {
        planId: event.node.id
      }
    }
  }
}
