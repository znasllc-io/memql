// healing domain -- row projections.

@row
@description("Comprehensive healed-override projection: every payload field plus row id and timestamps. The default shape for resolution + list + create reads of the two-tier base/overlay store (E4.2 / memql#2140).")
shape healedOverride healedOverrideFull {
  row.id
  ownerUserId
  baseConstructId
  tier
  overrideData
  valid
  version
  active
  reason
  sourcePreconditionId
  blastRadius
  validationStatus
  validatedBy
  validatedAt
  rejectionReason
  row.createdAt
}
