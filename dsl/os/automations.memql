/// Discussion and independent review share the same native read-only boundary.
@actor
@template
automation askApprovalAnalysis {
 args { approvalId string! conversationId string! requestId string! prompt string! advisor bool! }
 reply := builtin askRunApprovalMessage(templateId: args.advisor ? "askApprovalSecondOpinion" : "askApprovalReply")
 return reply
}

