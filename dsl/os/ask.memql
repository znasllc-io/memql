use identity.concepts.{ user }

/// Read this person's conversation with current progress and completed results
/// projected from its durable work runs. Reconnects never execute work again.
@sdk
@executor("askConversationSnapshot")
@args(profile="object")
builtin askConversationSnapshot { conversationId string! }

/// Open this owner's existing work in its Ask conversation, creating a private
/// conversation for Nexus-originated work without starting another run.
@sdk
@executor("askWorkConversation")
@args(profile="object")
builtin askWorkConversation { runId string! }

/// Discuss an owned request in its original conversation. Opening this view
/// neither calls a model nor approves, retries or resumes the blocked work.
@sdk
@executor("askApprovalDiscussion")
@args(profile="object")
builtin askApprovalDiscussion { approvalId string! }

/// Record a human message and return its read-only child analysis immediately.
/// advisor selects an independent second opinion only on an explicit request.
@sdk
@executor("askApprovalMessage")
@args(profile="object")
builtin askApprovalMessage {
 approvalId string!
 conversationId string!
 requestId string!
 prompt string!
 advisor bool
}

/// Answer the stop question Ask asked on one of this person's goals ("Stop this
/// work? It can't be resumed."). stop closes the goal and asks its runs to stop,
/// then records stopped; keep records kept and changes nothing else. Sending the
/// same answer again returns the saved one; the other answer is refused once one
/// is saved. A running job cannot answer: this is a person's decision.
@sdk
@executor("askStopDecision")
@args(profile="object")
builtin askStopDecision {
 conversationId string!
 turnId string!
 runId string!
 decision enum("stop", "keep")!
}

/// This model capability requires the exact child run and durable human turn.
/// It admits only the read-only approval prompts and one guarded model call.
@executor("askRunApprovalMessage")
@args(profile="optionalObject")
builtin askRunApprovalMessage {}

/// Read the current child run's owner-bound request and selected journal receipt.
@executor("askApprovalEvidence")
@args(profile="object")
builtin askApprovalEvidence {}

/// Count the active goals of the conversation a message is being routed in,
/// as {count}. Available only inside Ask's routing call, which supplies them.
@executor("askRouteGoals")
builtin askRouteGoals { }

/// Make one routing decision for the message being routed: one structured call
/// to prompt, told previousError on the retry, validated before it counts.
/// timeoutSeconds is how long the call may take, waiting for a model included
/// (held to 1 to 600; 600 when absent); a call that runs past it is a routing
/// failure, so the message goes to intake. Returns {valid, error}. Available
/// only inside Ask's routing call.
@executor("askRouteDecide")
@args(profile="object")
builtin askRouteDecide { prompt string! previousError string timeoutSeconds int }

/// A private conversation with MemQL. The transcript is written by the agent
/// service; ownership is always taken from the authenticated caller.
// @no-displayCard: contains a private transcript object; Ask renders named message rows and a separate conversation list, not a generic concept card.
@rowAuthz(owner="ownerUserId")
concept askConversation {
  ownerUserId string! @serverSet
  title string!
  transcript object!
  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
}

@row
shape askConversation askConversationSummary {
  row.id
  title
  row.createdAt
}

@row
shape askConversation askConversationDetail {
  row.id
  title
  transcript
  row.createdAt
}

/// Recent conversations belonging to the signed-in person.
@actor
query askConversation myAskConversations {
  filter row => row.ownerUserId == actor.userId
  sort "row.createdAt", "desc"
  paginate 50
  shape askConversationSummary
}

/// Timing evidence from this person's recent conversations, across replicas.
/// The same owner-scoped history is available to the person and their assistant.
@actor
query askConversation askRecentTimingHistory {
  filter row => row.ownerUserId == actor.userId
  sort "row.createdAt", "desc"
  paginate 20
  shape askConversationDetail
}

/// Private conversation evidence for the work harness. Page before folding
/// transcripts; the owner's predicate applies on every replica and page.
@actor
query askConversation askMemoryConversations {
  filter row => row.ownerUserId == actor.userId
  sort "row.createdAt", "desc"
  paginate 20
  shape askConversationDetail
}

/// Read one private transcript. A guessed id never widens the caller's access.
@actor
@unbounded("one conversation selected by its id and authenticated owner")
query askConversation askConversationById {
  args { conversationId string! }
  filter row => row.id == args.conversationId && row.ownerUserId == actor.userId
  shape askConversationDetail
}

/// Start an empty conversation for a unique client request. Retrying the same
/// request preserves its transcript; a new request always gets its own record.
/// Clients cannot supply an owner, record id or transcript.
@actor
@createOnly("title", "transcript")
mutation askConversation createAskConversation {
  args {
    requestId string! @maxLength(120)
    title string! @maxLength(120)
  }
  insert {
    accept { title }
    stamp {
      id: "ask-" + hash(actor.userId + ":" + args.requestId)
      ownerUserId: actor.userId
      transcript: { turns: [] }
    }
  }
}

/// Agent-only transcript append, after ownership and the cluster-wide turn
/// lock have been checked. The original user context supplies the owner stamp.
/// Scoping to actor.userId cannot prevent a client forging assistant replies
/// or completed-action evidence inside its own transcript; only the agent writes it.
@actor
@serverOnly
mutation askConversation saveAskConversation {
  args {
    id string!
    title string! @maxLength(120)
    transcript object!
    versionTime datetime!
  }
  insert {
    accept { id, title, transcript }
    stamp {
      ownerUserId: actor.userId
      createdAt: args.versionTime
    }
  }
}
