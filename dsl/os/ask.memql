use identity.concepts.{ user }

/// A private conversation with MemQL. The transcript is written by the agent
/// service; ownership is always taken from the authenticated caller.
// @no-displayCard: contains a private transcript object; Ask renders named message rows and a separate conversation list, not a generic concept card.
@rowAuthz(owner="ownerUserId")
concept askConversation {
  ownerUserId string! @serverSet
  title string!
  transcript object!
  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
}

@row
shape askConversation askConversationSummary {
  row.id
  title
  row.createdAt
}

@row
shape askConversation askConversationDetail {
  row.id
  title
  transcript
  row.createdAt
}

/// Recent conversations belonging to the signed-in person.
@actor
query askConversation myAskConversations {
  filter row => row.ownerUserId == actor.userId
  sort "row.createdAt", "desc"
  paginate 50
  shape askConversationSummary
}

/// Timing evidence from this person's recent conversations, across replicas.
/// The same owner-scoped history is available to the person and their assistant.
@actor
query askConversation askRecentTimingHistory {
  filter row => row.ownerUserId == actor.userId
  sort "row.createdAt", "desc"
  paginate 20
  shape askConversationDetail
}

/// Read one private transcript. A guessed id never widens the caller's access.
@actor
@unbounded("one conversation selected by its id and authenticated owner")
query askConversation askConversationById {
  args { conversationId string! }
  filter row => row.id == args.conversationId && row.ownerUserId == actor.userId
  shape askConversationDetail
}

/// Start an empty conversation for a unique client request. Retrying the same
/// request preserves its transcript; a new request always gets its own record.
/// Clients cannot supply an owner, record id or transcript.
@actor
@createOnly("title", "transcript")
mutation askConversation createAskConversation {
  args {
    requestId string! @maxLength(120)
    title string! @maxLength(120)
  }
  insert {
    accept { title }
    stamp {
      id: "ask-" + hash(actor.userId + ":" + args.requestId)
      ownerUserId: actor.userId
      transcript: { turns: [] }
    }
  }
}

/// Agent-only transcript append, after ownership and the cluster-wide turn
/// lock have been checked. The original user context supplies the owner stamp.
/// Scoping to actor.userId cannot prevent a client forging assistant replies
/// or completed-action evidence inside its own transcript; only the agent writes it.
@actor
@serverOnly
mutation askConversation saveAskConversation {
  args {
    id string!
    title string! @maxLength(120)
    transcript object!
  }
  insert {
    accept { id, title, transcript }
    stamp { ownerUserId: actor.userId }
  }
}
