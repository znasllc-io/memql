// mutations.memql
//
// Writes over the work namespace. Same-domain constructs are ambient, so
// there is no `use work.*` line here (#2617).
//
// WHY EVERY WRITE HERE IS @serverOnly. These rows are the engine's own
// record of what it executed -- the journal is an audit log, and a
// client-reachable insert is a forged execution: a caller could claim a
// run that never happened, or a `done` step for work never done, and
// resume would then serve that forgery back as fact. Scoping to
// actor.userId does not address that; it would make the forgery
// correctly attributed and no less a forgery. The second half of the
// same answer is that the real writer has no actor.userId to scope BY:
// component/automations/journal.go writes under a synthetic cluster
// actor whose stamped owner is blanked to present-and-empty by
// rowauthz_nonprincipal_owner.go, so an owner conjunct would refuse the
// engine its own rows. Epic A2 adds the client-reachable createGoal /
// cancelGoal / decideApproval, which are person-owned and therefore
// caller-scoped rather than server-only.
//
// The insert blocks use accept/stamp: accept names the caller-provided
// args copied verbatim, stamp names what the engine decides. Every
// optional field carrying a @default is STAMPED with that default here,
// because @default is documentation and `??` is the only mechanism that
// writes a value (memql#3038) -- and for approval.decision it is
// load-bearing, since workApprovalsForOwner filters decision=="".

/// Open a run. status is an argument rather than a stamp so epic A2 can open a run in `compiling`.
/// @serverOnly: a caller who can open a run can fabricate an execution record, and the writer is a
/// synthetic cluster actor with no actor.userId to scope to.
@serverOnly
@actor
mutate run createWorkRun {
  args {
    runId                  string!
    goalId                 string
    automationName         string!
    templateFingerprint    string!
    input                  object
    inputFingerprint       string
    triggeredBy            string
    triggerEvent           object
    callerSuppliedPayload  bool
    mode                   string
    replayPolicy           string
    variables              object
    forkedFromRunId        string
    forkAtStepKey          string
    status                 string!
    nodeId                 string
    initialChainHead       string
    startedAt              string!
  }
  insert {
    accept { goalId, automationName, templateFingerprint, input, inputFingerprint, triggeredBy, triggerEvent, variables, forkedFromRunId, forkAtStepKey, status, nodeId, initialChainHead, startedAt }
    stamp {
      id: args.runId
      ownerUserId: actor.userId
      mode: args.mode ?? "live"
      callerSuppliedPayload: args.callerSuppliedPayload ?? false
      replayPolicy: args.replayPolicy ?? "strict"
      cancelRequested: false
    }
  }
}

/// Advance a run: a heartbeat, the chain head, or the terminal status. Read-merge, so every field
/// not named keeps its prior value. @serverOnly: only the executor knows a run's true status, and
/// actor.userId scoping would let a caller close somebody's run as succeeded so long as it was
/// their own.
@serverOnly
mutate run updateWorkRun {
  args {
    runId            string!
    status           string
    automationName   string
    templateConstructId  string
    templateVersion  string
    variables        object
    heartbeatAt      string
    chainHead        string
    stepOrder        []string
    waitingOn        object
    spent            object
    outcome          object
    errorCode        string
    errorMessage     string
    finishedAt       string
    cancelRequested  bool
    cancelledBy      string
    actualFootprint  object
    summary          object
  }
  update {
    accept { status, automationName, templateConstructId, templateVersion, variables, heartbeatAt, chainHead, stepOrder, waitingOn, spent, outcome, errorCode, errorMessage, finishedAt, cancelRequested, cancelledBy, actualFootprint, summary }
    stamp {
      id: args.runId
    }
  }
}

/// Write a step's intent: the `running` version before the body executes. A retry writes this
/// again for the same stepId with attempt incremented. @serverOnly for createWorkRun's reason: a
/// step row is a claim about what the engine ran, which no caller may make about itself, so
/// actor.userId scoping narrows the wrong axis.
@serverOnly
@actor
mutate step createWorkStep {
  args {
    stepId          string!
    runId           string!
    key             string!
    seq             int!
    stepType        string!
    kind            string
    call            object
    dependsOn       []string
    status          string!
    attempt         int!
    idempotencyKey  string
    startedAt       string
  }
  insert {
    accept { runId, key, seq, stepType, call, dependsOn, status, attempt, idempotencyKey, startedAt }
    stamp {
      id: args.stepId
      ownerUserId: actor.userId
      kind: args.kind ?? ""
      symptom: ""
    }
  }
}

/// Write a step's receipt: the done / failed / skipped version after the body. Read-merge.
/// @serverOnly: the receipt is the engine's testimony about its own execution; a caller scoped to
/// actor.userId could still mark their own failed step done, which is the whole failure mode.
@serverOnly
mutate step updateWorkStep {
  args {
    stepId             string!
    status             string
    result             object
    resultFingerprint  string
    binding            object
    actualFootprint    object
    postcondition      object
    symptom            string
    attempt            int
    errorCode          string
    errorMessage       string
    finishedAt         string
    durationMs         int
    tokens             int
    cost               float
    childRunId         string
    approvalId         string
    resumeAt           string
    externalKey        string
  }
  update {
    accept { status, result, resultFingerprint, binding, actualFootprint, postcondition, symptom, attempt, errorCode, errorMessage, finishedAt, durationMs, tokens, cost, childRunId, approvalId, resumeAt, externalKey }
    stamp {
      id: args.stepId
    }
  }
}

/// Create a goal. @serverOnly in A1 because nothing client-reachable exists to call it yet and a
/// half-built create is worse than none: epic A2 adds the caller-facing createGoal, and THAT one is
/// scoped to actor.userId, which is exactly why this one does not have to pretend to be.
@serverOnly
@actor
mutate goal createWorkGoal {
  args {
    goalId            string!
    statement         string!
    origin            string!
    responsibilityId  string
    accountIds        []string
    input             object
    ceilings          object
    requestedVia      string
  }
  insert {
    accept { statement, origin, responsibilityId, accountIds, input, ceilings }
    stamp {
      id: args.goalId
      ownerUserId: actor.userId
      status: "open"
      requestedVia: args.requestedVia ?? ""
    }
  }
}

/// Advance a goal: the lifecycle, and how it closed. Read-merge, so every field not named keeps
/// its prior value.
///
/// THE COUNTERPART OF updateWorkRun, and it exists for one reason a reader should not have to
/// infer: `createWorkGoal` stamps `open` and nothing else could ever move it. A goal whose only
/// run has finished reads as work still in progress on every surface that shows one, and the
/// Library's analysis pass produces one of these per file -- so without this every file anybody
/// ever uploaded would sit in a person's goal list, permanently open.
///
/// @serverOnly, and scoping to actor.userId is not the alternative. A goal's lifecycle is the
/// ENGINE's account of work it is doing: the run opens the goal when it starts and closes it when
/// it finishes, and both edges are facts about an execution rather than a person's intent. An
/// actor.userId conjunct would narrow this to the goal's owner and change nothing that matters --
/// the owner still could not honestly say a run had finished, and the system-origin goals the
/// Library pass writes carry a present-and-empty owner that no caller matches at all, so the one
/// population this construct exists for would be the population it could never reach. The
/// client-reachable lifecycle act is cancelGoal, which epic A2 adds with its own gate.
@serverOnly
mutate goal updateWorkGoal {
  args {
    goalId       string!
    status       string
    closedAt     string
    closeReason  string
    accountIds   []string
    ceilings     object
  }
  update {
    accept { status, closedAt, closeReason, accountIds, ceilings }
    stamp {
      id: args.goalId
    }
  }
}

/// Journal one model call. @serverOnly: the row records what a PROVIDER was asked and answered, and
/// replay serves later calls from it -- a caller-written row is a poisoned cache. There is also no
/// actor.userId at the call site: the router runs inside the engine.
@serverOnly
@actor
mutate modelCall createWorkModelCall {
  args {
    modelCallId    string!
    runId          string!
    stepKey        string
    requestHash    string!
    provider       string!
    model          string!
    settings       object
    promptRef      string
    promptVersion  string
    inputTokens    int
    outputTokens   int
    cost           float
    latencyMs      int
    served         string!
    response       object
    error          string
  }
  insert {
    accept { runId, stepKey, requestHash, provider, model, settings, promptRef, promptVersion, inputTokens, outputTokens, cost, latencyMs, served, response, error }
    stamp {
      id: args.modelCallId
      ownerUserId: actor.userId
    }
  }
}

/// Journal one observation. @serverOnly: observations are the embedding source recall reads back as
/// episodic memory, so a client-reachable write is memory injection -- and scoping to actor.userId
/// would only mean the caller poisons their own recall, which is still the defect.
@serverOnly
@actor
mutate observation createWorkObservation {
  args {
    observationId  string!
    runId          string!
    stepKey        string
    kind           string!
    content        string!
    data           object
  }
  insert {
    accept { runId, stepKey, kind, content, data }
    stamp {
      id: args.observationId
      ownerUserId: actor.userId
    }
  }
}

/// Raise a human gate. @serverOnly: only the run knows it needs approval and what artifact hash it
/// parked on, and a caller-raised approval scoped to actor.userId would let somebody manufacture a
/// gate against their own run and then answer it.
@serverOnly
@actor
mutate approval createWorkApproval {
  args {
    approvalId    string!
    runId         string!
    stepKey       string
    kind          string!
    subject       object
    artifactHash  string!
    question      string
    options       []object
    evidence      object
    requestedAt   string!
    expiresAt     string
  }
  insert {
    accept { runId, stepKey, kind, subject, artifactHash, question, options, evidence, requestedAt, expiresAt }
    stamp {
      id: args.approvalId
      ownerUserId: actor.userId
      decision: ""
    }
  }
}

/// Record a decision. @serverOnly in A1: decidedBy is the authority the row carries, and a mutation
/// argument is whatever the caller typed, so a client-reachable version lets anyone write a
/// colleague's name into an approval. Scoping to actor.userId asserts the row is the caller's,
/// which is true and beside the point -- what must hold is that decidedBy IS the verified actor,
/// and epic A2's caller-facing form stamps it from the envelope rather than accepting it.
@serverOnly
mutate approval decideWorkApproval {
  args {
    approvalId  string!
    decision    string!
    decidedBy   string!
    decidedAt   string!
    answer      object
  }
  update {
    accept { decision, decidedBy, decidedAt, answer }
    stamp {
      id: args.approvalId
    }
  }
}

/// Close a goal, or move it to active when its first run starts. Server-only for the same reason
/// the run writers are: the goal's lifecycle is the ENGINE's account of what happened to the work,
/// and a caller who could write `status` directly could mark a goal closed while its runs are still
/// in flight, or re-open one the system finished. Scoping to actor.userId is not the missing piece
/// -- the row is already owner-stamped and a caller reaches only their own goals -- but a person
/// closing a goal does it through the cancelGoal builtin, which requests cancellation of the live
/// runs FIRST and only then closes the row. That ordering is the whole guarantee, and a
/// client-reachable status write is exactly what would bypass it.
@serverOnly
mutate goal closeWorkGoal {
  args {
    goalId       string!
    status       string!
    closedAt     string
    closeReason  string
  }
  update {
    accept { status, closedAt, closeReason }
    stamp {
      id: args.goalId
    }
  }
}
