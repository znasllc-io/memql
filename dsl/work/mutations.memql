// mutations.memql
//
// Writes over the work namespace. Same-domain constructs are ambient, so
// there is no `use work.*` line here (#2617).
//
// WHY EVERY WRITE HERE IS @serverOnly. These rows are the engine's own
// record of what it executed -- the journal is an audit log, and a
// client-reachable insert is a forged execution: a caller could claim a
// run that never happened, or a `done` step for work never done, and
// resume would then serve that forgery back as fact. Scoping to
// actor.userId does not address that; it would make the forgery
// correctly attributed and no less a forgery. The second half of the
// same answer is that the real writer has no actor.userId to scope BY:
// component/automations/journal.go writes under a synthetic cluster
// actor whose stamped owner is blanked to present-and-empty by
// rowauthz_nonprincipal_owner.go, so an owner conjunct would refuse the
// engine its own rows. Epic A2 adds the client-reachable createGoal /
// cancelGoal / decideApproval, which are person-owned and therefore
// caller-scoped rather than server-only.
//
// The insert blocks use accept/stamp: accept names the caller-provided
// args copied verbatim, stamp names what the engine decides. Every
// optional field carrying a @default is STAMPED with that default here,
// because @default is documentation and `??` is the only mechanism that
// writes a value (memql#3038) -- and for approval.decision it is
// load-bearing, since workApprovalsForOwner filters `row.decision == ""`.

/// Open a run. status is an argument rather than a stamp so epic A2 can open a run in `compiling`.
/// @serverOnly: a caller who can open a run can fabricate an execution record, and the writer is a
/// synthetic cluster actor with no actor.userId to scope to. goalSignature and parentRunId (epic
/// memql#5408) are accepted so a run can be opened already carrying the goal it serves and the run
/// that delegated it -- a delegated app session's recording run and a procedure's replay run both
/// are -- and both are bound with no default, so a writer that has neither writes neither. routing
/// is the owner's routing choice the run is opened with (v1:work:run.routing), bound with no default
/// for the same reason: a run nobody chose for writes none. heartbeatAt is accepted for a run that
/// opens LATE -- a scheduled firing's or a directly called logic's, held until its first write
/// (component/automations/journal.go) -- so the first version of the row is already live: the work
/// sweep judges a running run by heartbeatAt, else startedAt, and a late run's startedAt may be
/// minutes old. Bound with no default for the same reason: a writer that names none writes none, and
/// every other writer names none, so its rows are unchanged.
@serverOnly
@actor
mutation run createWorkRun {
  args {
    spine object
    executionAuthority object
    runId                  string!
    goalId                 string
    goalSignature          string
    automationName         string!
    templateFingerprint    string!
    templateConstructId    string
    templateVersion        string
    input                  object
    inputFingerprint       string
    triggeredBy            string
    triggerEvent           object
    callerSuppliedPayload  bool
    mode                   string
    replayPolicy           string
    variables              object
    forkedFromRunId        string
    forkAtStepKey          string
    status                 string!
    nodeId                 string
    initialChainHead       string
    waitingOn              object
    startedAt              string!
    heartbeatAt            string
    parentRunId            string
    head                   object
    rerun                  object
    routing                object
  }
  insert {
    accept { spine, executionAuthority, goalId, goalSignature, automationName, templateFingerprint, templateConstructId, templateVersion, input, inputFingerprint, triggeredBy, triggerEvent, variables, forkedFromRunId, forkAtStepKey, status, nodeId, initialChainHead, waitingOn, startedAt, heartbeatAt, parentRunId, head, rerun, routing }
    stamp {
      id: args.runId
      ownerUserId: actor.userId
      mode: args.mode ?? "live"
      callerSuppliedPayload: args.callerSuppliedPayload ?? false
      replayPolicy: args.replayPolicy ?? "strict"
      cancelRequested: false
    }
  }
}

/// Advance a run: a heartbeat, the chain head, or the terminal status. Read-merge, so every field
/// not named keeps its prior value. @serverOnly: only the executor knows a run's true status, and
/// actor.userId scoping would let a caller close somebody's run as succeeded so long as it was
/// their own. goalSignature and parentRunId (epic memql#5408) are accepted for the run compile opens
/// before it knows the goal's signature, and for a child run opened by a writer that learns its
/// parent afterwards; like every argument here they are written only when named.
///
/// head, staleSteps, rerun and validation (epic memql#5414) carry NO default for the same reason:
/// the journal names head at every receipt and nothing else, a person's act names rerun and
/// staleSteps, and the validator names validation -- four writers of one row, and a `??` default on
/// any of them would erase the others' value at the moment it was written. The merge is SHALLOW, so
/// the journal always sends the WHOLE head map; `{}` and `[]` are how a writer clears one.
///
/// title is the run's title after a person's later message (work.workRetitleRun is its one writer).
/// It is a field of its own rather than a key of classification, because compile writes that object
/// whole when it finishes ({workload, workTitle, acknowledgement}) and a retitle made before then
/// would be gone. Like the rest, it has no default: a write that names none leaves the title as it
/// was.
@serverOnly
mutation run updateWorkRun {
  args {
    runId            string!
    versionTime      datetime
    goalSignature    string
    status           string
    automationName   string
    templateConstructId  string
    templateVersion  string
    templateFingerprint string
    variables        object
    nodeId           string
    callerSuppliedPayload bool
    heartbeatAt      string
    chainHead        string
    stepOrder        []string
    waitingOn        object
    continuation     object
    humanResumeId    string
    humanWaitMs      int
    spent            object
    classification   object
    title            string
    outcome          object
    errorCode        string
    errorMessage     string
    finishedAt       string
    cancelRequested  bool
    cancelledBy      string
    actualFootprint  object
    summary          object
    parentRunId      string
    head             object
    staleSteps       []string
    rerun            object
    validation       object
  }
  update {
    accept { status, goalSignature, automationName, templateConstructId, templateVersion, templateFingerprint, variables, nodeId, callerSuppliedPayload, heartbeatAt, chainHead, stepOrder, waitingOn, continuation, humanResumeId, humanWaitMs, spent, classification, title, outcome, errorCode, errorMessage, finishedAt, cancelRequested, cancelledBy, actualFootprint, summary, parentRunId, head, staleSteps, rerun, validation }
    stamp {
      id: args.runId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Write a step's intent: the `running` version before the body executes. A retry writes this
/// again for the same stepId with attempt incremented. @serverOnly for createWorkRun's reason: a
/// step row is a claim about what the engine ran, which no caller may make about itself, so
/// actor.userId scoping narrows the wrong axis.
///
/// version, basis, override and authoredBy (epic memql#5414) describe the version this intent
/// opens. result, resultFingerprint, binding, errorCode, errorMessage and childRunId are the
/// RESET fields: an insert on an existing id is a shallow read-merge, so a version 2 intent that
/// did not name them would carry version 1's answer until its own receipt landed -- and forever, if
/// it never did. The journal names them (with empty values) on every version after the first; on a
/// first version it names none, so an ordinary run writes nothing more than before.
@serverOnly
@actor
mutation step createWorkStep {
  args {
    stepId             string!
    runId              string!
    key                string!
    seq                int!
    stepType           string!
    kind               string
    call               object
    dependsOn          []string
    status             string!
    attempt            int!
    idempotencyKey     string
    startedAt          string
    version            int
    basis              object
    override           object
    authoredBy         string
    result             object
    resultFingerprint  string
    binding            object
    errorCode          string
    errorMessage       string
    childRunId         string
  }
  insert {
    accept { runId, key, seq, stepType, call, dependsOn, status, attempt, idempotencyKey, startedAt, version, basis, override, authoredBy, result, resultFingerprint, binding, errorCode, errorMessage, childRunId }
    stamp {
      id: args.stepId
      ownerUserId: actor.userId
      kind: args.kind ?? ""
      symptom: ""
    }
  }
}

/// Write a step's receipt: the done / failed / skipped version after the body. Read-merge.
/// @serverOnly: the receipt is the engine's testimony about its own execution; a caller scoped to
/// actor.userId could still mark their own failed step done, which is the whole failure mode.
/// fingerprint (epic memql#5408, gap G4) is the environment a delegated session's FIRST step ran
/// against. The session writer has sent it on that receipt since epic memql#5396, and until this
/// argument existed it was dropped without a word -- an internal caller's unknown argument is not
/// refused -- so every recording's fingerprint was lost and no precondition could be learned.
/// logFileId and artifactFileIds (epic memql#5477) are the Library files a runner's receipt names --
/// a pipeline step's full log and its artifacts -- carried for the same reason: an argument this
/// mutation does not declare is dropped in silence.
@serverOnly
mutation step updateWorkStep {
  args {
    stepId             string!
    status             string
    result             object
    resultFingerprint  string
    binding            object
    actualFootprint    object
    postcondition      object
    symptom            string
    attempt            int
    errorCode          string
    errorMessage       string
    finishedAt         string
    durationMs         int
    tokens             int
    cost               float
    childRunId         string
    approvalId         string
    resumeAt           string
    externalKey        string
    fingerprint        object
    version            int
    basis              object
    override           object
    authoredBy         string
    logFileId          string
    artifactFileIds    []string
  }
  update {
    accept { status, result, resultFingerprint, binding, actualFootprint, postcondition, symptom, attempt, errorCode, errorMessage, finishedAt, durationMs, tokens, cost, childRunId, approvalId, resumeAt, externalKey, fingerprint, version, basis, override, authoredBy, logFileId, artifactFileIds }
    stamp {
      id: args.stepId
    }
  }
}

/// Make an EARLIER version of a step current again (epic memql#5414, design D18): a new
/// row-version of the step carrying that version's content verbatim, written when a person moves the
/// run's head back. The store is append-only, so nothing is lost and nothing is rewritten -- the
/// later versions stay readable through the version-history read -- and every collapsed read (the
/// timeline, the procedure corpus, resume's journal loader) keeps answering with the step's newest
/// row, which is now the head again. Every per-version field is an argument, and the writer names
/// ALL of them: an update is a read-merge, and one left out would keep the LATER version's value
/// under the earlier version's number.
///
/// @serverOnly: the row is the engine's testimony about what ran, and which version is current is
/// the run's head, decided by integrations/work after it has checked that the caller owns the run.
/// Scoping to actor.userId would let an owner re-assert a version with any content they typed, which
/// is a forged execution record however correctly attributed.
@serverOnly
mutation step reassertWorkStepVersion {
  args {
    stepId             string!
    status             string!
    result             object
    resultFingerprint  string
    binding            object
    postcondition      object
    symptom            string
    attempt            int!
    version            int!
    basis              object
    override           object
    authoredBy         string
    childRunId         string
    idempotencyKey     string
    startedAt          string
    finishedAt         string
    durationMs         int
    tokens             int
    cost               float
    errorCode          string
    errorMessage       string
    actualFootprint    object
    approvalId         string
    resumeAt           string
    externalKey        string
    input              object
    fingerprint        object
    logFileId          string
    artifactFileIds    []string
  }
  update {
    accept { status, result, resultFingerprint, binding, postcondition, symptom, attempt, version, basis, override, authoredBy, childRunId, idempotencyKey, startedAt, finishedAt, durationMs, tokens, cost, errorCode, errorMessage, actualFootprint, approvalId, resumeAt, externalKey, input, fingerprint, logFileId, artifactFileIds }
    stamp {
      id: args.stepId
    }
  }
}

/// Create a goal. @serverOnly in A1 because nothing client-reachable exists to call it yet and a
/// half-built create is worse than none: epic A2 adds the caller-facing createGoal, and THAT one is
/// scoped to actor.userId, which is exactly why this one does not have to pretend to be.
@serverOnly
@actor
mutation goal createWorkGoal {
  args {
    goalId            string!
    statement         string!
    origin            string!
    responsibilityId  string
    accountIds        []string
    input             object
    ceilings          object
    requestedVia      string
    routing           object
    requestFingerprint string
  }
  insert {
    accept { statement, origin, responsibilityId, accountIds, input, ceilings, routing, requestFingerprint }
    stamp {
      id: args.goalId
      ownerUserId: actor.userId
      status: "open"
      requestedVia: args.requestedVia ?? ""
    }
  }
}

/// Record the owner's lifecycle decision without conflating execution success
/// with acceptance. Runs may finish, fail or wait while the goal remains open.
/// Only the interactive accept/cancel handlers close a goal. The server-only
/// mutation preserves the owner-checked acceptance receipt and optional feedback.
/// Scoping to actor.userId alone cannot attest human acceptance: a delegated
/// agent also acts as that owner and must not certify its own results. The
/// interactive handler validates the decision, acceptance receipt and reviewed
/// version first.
@serverOnly
mutation goal updateWorkGoal {
  args {
    goalId       string!
    status       string
    closedAt     string
    acceptance   object
    closeReason  string
    accountIds   []string
    ceilings     object
    versionTime  datetime
  }
  update {
    accept { status, closedAt, closeReason, acceptance, accountIds, ceilings }
    stamp {
      id: args.goalId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Journal one model call. @serverOnly: the row records what a PROVIDER was asked and answered, and
/// replay serves later calls from it -- a caller-written row is a poisoned cache. There is also no
/// actor.userId at the call site: the router runs inside the engine.
@serverOnly
@actor
mutation modelCall createWorkModelCall {
  args {
    modelCallId    string!
    runId          string!
    stepKey        string
    requestHash    string!
    provider       string!
    model          string!
    settings       object
    promptRef      string
    promptVersion  string
    inputTokens    int
    outputTokens   int
    cost           float
    latencyMs      int
    served         string!
    response       object
    error          string
    routerCallId   string
    decision       object
  }
  insert {
    accept { runId, stepKey, requestHash, provider, model, settings, promptRef, promptVersion, inputTokens, outputTokens, cost, latencyMs, served, response, error, routerCallId, decision }
    stamp {
      id: args.modelCallId
      ownerUserId: actor.userId
    }
  }
}

/// Journal one observation. @serverOnly: observations are the embedding source recall reads back as
/// episodic memory, so a client-reachable write is memory injection -- and scoping to actor.userId
/// would only mean the caller poisons their own recall, which is still the defect.
@serverOnly
@actor
mutation observation createWorkObservation {
  args {
    observationId  string!
    runId          string!
    stepKey        string
    kind           string!
    content        string!
    data           object
  }
  insert {
    accept { runId, stepKey, kind, content, data }
    stamp {
      id: args.observationId
      ownerUserId: actor.userId
    }
  }
}

/// Raise a human gate. @serverOnly: only the run knows it needs approval and what artifact hash it
/// parked on, and a caller-raised approval scoped to actor.userId would let somebody manufacture a
/// gate against their own run and then answer it.
@serverOnly
@actor
mutation approval createWorkApproval {
  args {
    approvalId    string!
    /// Empty ONLY for kind routingReview, which a sweep raises rather than a
    /// run. component/work.ValidateApprovalKind is where that is enforced, so
    /// the refusal can name the kind.
    runId         string
    stepKey       string
    kind          string!
    subject       object
    artifactHash  string!
    question      string
    options       []object
    evidence      object
    requestedAt   string!
    expiresAt     string
  }
  insert {
    accept { runId, stepKey, kind, subject, artifactHash, question, options, evidence, requestedAt, expiresAt }
    stamp {
      id: args.approvalId
      ownerUserId: actor.userId
      decision: ""
    }
  }
}

/// Save human guidance on an undecided budget checkpoint. The native approval
/// gate proves the owner and exact pending wait; this write grants no budget.
/// An actor.userId filter proves ownership alone, not that this is still the
/// same undecided native checkpoint or that its decision lease is held. Only
/// decideApproval may reach this writer after validating those facts and the
/// bounded feedback-only answer; a direct owned write could replace guidance
/// after a budget decision and change the instruction that resumes the run.
@serverOnly
mutation approval saveWorkApprovalGuidance {
  args {
    approvalId  string!
    answer      object!
    versionTime datetime!
  }
  update {
    accept { answer }
    stamp {
      id: args.approvalId
      createdAt: args.versionTime
    }
  }
}

/// Record a decision. @serverOnly in A1: decidedBy is the authority the row carries, and a mutation
/// argument is whatever the caller typed, so a client-reachable version lets anyone write a
/// colleague's name into an approval. Scoping to actor.userId asserts the row is the caller's,
/// which is true and beside the point -- what must hold is that decidedBy IS the verified actor,
/// and epic A2's caller-facing form stamps it from the envelope rather than accepting it.
@serverOnly
mutation approval decideWorkApproval {
  args {
    approvalId  string!
    decision    string!
    decidedBy   string!
    decidedAt   string!
    versionTime datetime
    answer      object
  }
  update {
    accept { decision, decidedBy, decidedAt, answer }
    stamp {
      id: args.approvalId
      createdAt: args.versionTime ?? now
    }
  }
}

/// Native timer receipt; never a human answer or access grant.
/// Scoping by actor.userId alone would let an owner forge elapsed time on their
/// own question. Only the native continuation handler writes this after checking
/// the immutable policy, deadline, checkpoint and execution under the decision lock.
@serverOnly
mutation approval continueWorkFeedback {
 args {
  approvalId string!
  continuedAt datetime!
  versionTime datetime!
 }
 update {
  accept { continuedAt }
  stamp {
   id: args.approvalId
   createdAt: args.versionTime
  }
 }
}

/// Create the epic memql#5414 values -- the seed materializer's write for `seed feedbackPolicy
/// feedbackPolicyPrimary` (dsl/work/seeds.memql), which calls create<Concept> with <concept>Id by convention and
/// re-asserts the row on every boot.
///
/// Server-only, and scoping to actor.userId is not available even in principle: the row has no
/// owner -- the values are the deployment's -- so there is no field for actor.userId to compare
/// against, and inventing one would give each person a private validator switch and a private
/// reuse threshold. What must hold is that no caller can rewrite the values every person's work is
/// judged by. The one writer is the seed materializer, which stamps internal origin, and the
/// concept's cluster-owner write rule stands behind this annotation.
@serverOnly
mutation feedbackPolicy createFeedbackPolicy {
  args {
    feedbackPolicyId         string!
    validateAnswers          bool!
    reusableAfterSignatures  int!
  }
  insert {
    accept { validateAnswers, reusableAfterSignatures }
    stamp {
      id: args.feedbackPolicyId
    }
  }
}

/// Only the native receipt gate can consume computer permission. actor.userId
/// scoping alone would let a client clear or fabricate its own consumption time;
/// the gate must verify the exact dispatch and serialize it across replicas.
@serverOnly
mutation approval useWorkComputerPermission {
 args {
  approvalId string!
  permissionUsedAt datetime!
  versionTime datetime!
 }
 update {
  accept { permissionUsedAt }
  stamp {
   id: args.approvalId
   createdAt: args.versionTime
  }
 }
}

/// Revocation is a native human decision. actor.userId scoping alone cannot
/// prove an interactive person or serialize revocation against dispatch; the
/// builtin verifies both while holding the approval decision gate.
@serverOnly
mutation approval revokeWorkComputerPermission {
 args {
  approvalId string!
  permissionRevokedAt datetime!
  versionTime datetime!
 }
 update {
  accept { permissionRevokedAt }
  stamp {
   id: args.approvalId
   createdAt: args.versionTime
  }
 }
}

/// Native review renewal: retains history and clears any unusable decision.
/// actor.userId scoping alone cannot prove an interactive review, serialize
/// against dispatch, or verify the saved fingerprint and exact parked run.
/// The native gate holds that authority and refuses used permissions.
@serverOnly
mutation approval refreshWorkComputerPermission {
  args {
    approvalId string!
    subject object!
    artifactHash string!
    requestedAt string!
    expiresAt string!
    versionTime datetime!
  }
  update {
    accept { subject, artifactHash, requestedAt, expiresAt }
    stamp {
      id: args.approvalId
      createdAt: args.versionTime
      decision: ""
      decidedAt: ""
      decidedBy: ""
      answer: {}
      permissionRevokedAt: ""
    }
  }
}
