use common.traits.{ statusIsActive }

use identity.concepts.{ groupMembership }

@row
shape groupMembership workViewerMembership {
  row.id
  accountId
}

/// Membership is evidence of affiliation, never evidence of employment or
/// selection as the organization producing the current deliverable.
@actor
query groupMembership workViewerMemberships {
  filter row => row.userId == actor.userId && statusIsActive(row)
  paginate 20
  shape workViewerMembership
}

/// Fresh server-assembled facts about the authenticated person. This does not
/// select an organization, change authority, or infer a missing job title.
@executor("workViewerContext")
@args(profile="optionalObject")
builtin workViewerContext { }

/// Bounded source receipts from this caller's saved conversation, read on the executing replica.
@executor("workSourceContext")
@args(profile="object")
builtin workSourceContext { conversationId string! turnId string }

/// Review a completed reply against this owned run's recorded receipts before delivery.
@executor("workReviewReply")
@args(profile="object")
builtin workReviewReply { draft object! }
