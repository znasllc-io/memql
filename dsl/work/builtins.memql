// builtins.memql
//
// The work spine's entry points (design record
// docs/superpowers/specs/2026-09-05-work-spine-design.md, section H).
// Executors live in integrations/work; the pure decisions they call live
// in component/work.
//
// These are BUILTINS rather than mutations because each one is more than
// a row write: createGoal opens the goal AND its first run and dispatches
// compile; forkRun and replayRun read a source run and derive a new one;
// decideApproval records a decision AND resumes the run parked on it. A
// statement body can hand an inserted row to the next write (`x := mutation
// ...` names the row), but dispatching, deriving and resuming a run are the
// engine's, so the composition happens in Go.
//
// Every handler repeats its own gate. A builtin's annotation set carries
// no @requiresRank, so the floor is the handler's -- these are all
// caller-scoped rather than ranked: a person acts on their own goals, and
// the row tier is what decides which those are.

/// Accept a goal and start work on it. Opens a v1:work:goal owned by the caller and its first
/// v1:work:run in `compiling`, then dispatches compile: catalog exact match, then near-match with a
/// gap list, then the cheap triage. Returns {goalId, runId}. A goal that fully matches the catalog
/// reaches no model at all.
@sdk
@executor("integration.work.createGoal")
builtin createGoal {
  statement     string!  @description("The goal in the person's own words.")
  input         object   @description("The typed input object: the shape the chosen template's args declare.")
  accountIds    []string @description("Optional account tags -- a record of who the work is for, never a visibility scope.")
  ceilings      object   @description("{tokenBudget, costCeiling, wallClockMs, maxRetries, maxModelCalls, maxEvents}. Omitted fields take the deployment's defaults; a zero is 'unset', never 'nothing allowed'.")
  requestedVia  string   @description("The surface the goal arrived through: api, ask, nexus, responsibility, library, materializer. Empty when unknown.")
}

/// Close one of the caller's goals and ask every run of it to stop. Cancellation is REQUESTED
/// rather than done: a run notices at its next step boundary, so a step already in flight finishes
/// and is journaled rather than being abandoned mid-effect.
@sdk
@executor("integration.work.cancelGoal")
builtin cancelGoal {
  goalId  string!  @description("The v1:work:goal to close.")
  reason  string   @description("Why it closed, in words a person can read.")
}

/// Fork one of the caller's runs at a step: a NEW run that serves the shared prefix from the
/// journal and runs live from the fork step on. The source run is untouched. Returns {runId}.
@sdk
@executor("integration.work.forkRun")
builtin forkRun {
  runId       string!  @description("The run to fork.")
  atStepKey   string!  @description("The step key to diverge at. Steps before it are served from the journal; this step and everything after run live.")
  variables   object   @description("Variables to override on the fork. Anything omitted is inherited from the source run.")
}

/// Replay one of the caller's runs: a NEW run that serves EVERY model call from the journal, so it
/// reaches no provider. Under the default strict policy a request with no journaled match raises a
/// divergence pinned to the first step that differs; permissive makes a fresh call and journals it.
/// Returns {runId}.
@sdk
@executor("integration.work.replayRun")
builtin replayRun {
  runId   string!  @description("The run to replay.")
  policy  string   @description("strict (default) raises a divergence on a journal miss; permissive makes a fresh call and journals it.")
}

// ---- intervention: versions, the head and branches (epic memql#5414, #5415) ----
//
// Every one of these is caller-scoped in its handler: the caller must OWN the
// run, the run must have stopped (a run still working is never re-run under
// itself), and the step must be one of the run's own top-level steps. The act
// is recorded on the RUN ROW and served on the agent that executes the run,
// because the replica a person's click arrives at is not the one that runs it.

/// Run one step of one of the caller's finished runs AGAIN, as a new VERSION of that step (design
/// D18, D20): the step runs with whatever the person changed -- the level, the model, the effort,
/// the prompt or the inputs -- on that version only, and every step after it runs again from the
/// new answer, each as a new version. Nothing is deleted: every earlier version stays readable and
/// moveRunHead goes back to it. When the person disliked the version being replaced, the axes and
/// the reason they gave ride along as guidance (D23). Returns {runId, stepKey, version, staleSteps}.
@sdk
@executor("integration.work.rerunStep")
builtin rerunStep {
  runId    string!  @description("The caller's finished run.")
  stepKey  string!  @description("The top-level step to run again.")
  level    enum("fast", "strong", "reasoning")  @description("The level of intelligence to ask for instead of the step's own. Embeddings is never offered: a different embedder answers in a different vector space.")
  model    string   @description("A policy entry to pin instead of routing by level: a provider name, fleet:<modelId>, app:<id> or app:<id>:<model>.")
  effort   enum("low", "medium", "high", "xhigh", "max")  @description("The effort to ask an app to spend. An app that is not asked keeps the effort its level maps to.")
  prompt   string   @description("For a step an app session answered, the whole prompt the session runs with; for any other step, instructions added to the step's prompt.")
  inputs   object   @description("Arguments to use instead of the step's own, by name. Anything omitted keeps its value.")
}

/// Branch one of the caller's finished runs at a step: a NEW run (mode fork) whose steps before the
/// branch point are served by REFERENCE from the source run -- they do not run again -- and whose
/// branch step runs live with the person's changes, followed by everything after it (design D19).
/// The source run is untouched. When the branch step was answered by an app session, the branch is
/// a NEW session started against the workspace as it was before that step, rebuilt from the
/// recording's content-addressed files; a branch whose snapshot is missing a file's content is
/// refused naming the file, because a branch from a partial workspace would diverge without saying
/// so. Returns {runId, forkedFromRunId, forkAtStepKey}.
@sdk
@executor("integration.work.branchRun")
builtin branchRun {
  runId    string!  @description("The caller's finished run to branch from.")
  stepKey  string!  @description("The top-level step the branch diverges at.")
  level    enum("fast", "strong", "reasoning")  @description("The level of intelligence to ask for at the branch step.")
  model    string   @description("A policy entry to pin at the branch step: a provider name, fleet:<modelId>, app:<id> or app:<id>:<model>.")
  effort   enum("low", "medium", "high", "xhigh", "max")  @description("The effort to ask an app to spend at the branch step.")
  prompt   string   @description("For a session step, the whole prompt the new session runs with; for any other step, instructions added to its prompt.")
  inputs   object   @description("Arguments to use at the branch step instead of its own, by name.")
}

/// Make an earlier version of one step of the caller's finished run current again -- going back
/// (design D18). The head moves; every later step whose recorded version was computed from the same
/// upstream becomes current again without running, and only the steps with no such version run
/// again, in order. Returns {runId, stepKey, version, staleSteps}.
@sdk
@executor("integration.work.moveRunHead")
builtin moveRunHead {
  runId    string!  @description("The caller's finished run.")
  stepKey  string!  @description("The top-level step whose version to make current.")
  version  int!     @description("The version to make current.")
}

/// Say what one of the caller's runs, or one version of one of its steps, was like (design D21): a
/// like, a dislike or neutral -- the AI Fluency framework's Discernment. A dislike must name at
/// least one axis -- the product (what it produced), the process (how it went about it) or the
/// performance (how it behaved) -- and is refused without one, because the question is the point. A
/// later verdict is a NEW row and never rewrites an earlier one. When the answer validator judged the
/// same version the other way, the disagreement is kept on the row. Returns {observationId, verdict,
/// validatorDisagrees}.
@sdk
@executor("integration.work.recordFeedback")
builtin recordFeedback {
  runId        string!  @description("The caller's run.")
  stepKey      string   @description("The top-level step judged; omit it to judge the whole run.")
  version      int      @description("The version of that step judged; the current one when omitted.")
  verdict      enum("like", "dislike", "neutral")!  @description("The person's verdict.")
  product      bool     @description("What it produced was wrong or incomplete.")
  process      bool     @description("How it went about the work was wrong.")
  performance  bool     @description("How it behaved -- its tone, pace or instruction-following -- was wrong.")
  reason       string   @description("Why, in the person's own words. It rides as guidance when the step is run again or branched, and it steers the next model used for this goal.")
}

/// Every VERSION of every step of one of the caller's runs -- the step timeline's read (design D18).
/// The standard reads collapse an append-only row to its newest version; this answers each version
/// once, folded to its newest row-version, with the run's head marked (current). Returns one entry
/// per version, keyed <stepId>@v<version>.
@sdk
@executor("integration.work.stepVersions")
builtin workStepVersions {
  runId  string!  @description("The caller's run.")
}

/// Decide one of the caller's pending approvals and resume the run parked on it. The decision is
/// refused if the artifact changed since it was approved -- an approval is a decision about a
/// specific command, patch, message or draft, and it never carries to a modified one.
@sdk
@executor("integration.work.decideApproval")
builtin decideApproval {
  approvalId  string!  @description("The v1:work:approval to decide.")
  decision    string!  @description("approved, rejected, or answered (for a feedback question).")
  answer      object   @description("The person's answer, for a feedback approval.")
}

/// Resume every run whose timer wait is due and every run whose node died mid-flight. Cron-leader
/// gated through its scheduled automation, so it runs on one replica cluster-wide.
@executor("integration.work.sweepWaiting")
builtin workSweepWaiting {
  olderThanSeconds  int  @description("How long a run must have been silent before it counts as abandoned. Defaults to twice the heartbeat interval.")
}

/// Archive then delete journal rows past their retention window: v1:work:modelCall at
/// MEMQL_WORK_MODELCALL_RETENTION_DAYS and v1:work:observation at
/// MEMQL_WORK_OBSERVATION_RETENTION_DAYS. The run's summary is folded onto the run row BEFORE its
/// detail goes, so a run stays readable after. No archive means no delete.
@executor("integration.work.retentionSweep")
builtin workRetentionSweep {
  dryRun  bool  @description("Report what would be archived and deleted without doing either.")
}

/// Check one finished goal run's answer against what was asked, BEFORE a person looks (design D22):
/// one bounded call at the run's own level applies the framework's three axes and records a decision
/// observation plus the run's validation summary. A PRE-FILTER and nothing more: it never counts as
/// a like, never certifies, never moves a procedure's ladder, and a person's verdict outranks it;
/// when they disagree the disagreement is kept as the signal that the validator needs work. Skips,
/// saying why, when the cluster's feedbackPolicy turns it off, when the run was not asked for through
/// Nexus or the API, when it reached no model, or when this answer version was already checked.
///
/// NOT @sdk, and gated in its handler on internal origin under the validateGoalAnswer automation: its
/// argument names WHOSE run to read, so a caller-supplied id would be an authorization decision.
@executor("integration.work.validateAnswer")
builtin workValidateAnswer {
  runId        string!  @description("The finished goal run whose answer to check.")
  ownerUserId  string!  @description("The run's owner as the completion event carried it. The handler borrows exactly this owner's authority and re-reads the run under it, so a hint that does not own the run reads nothing.")
}

// ---- the computer-use kill switch, in-flight half (memql#5066) ----
//
// Declared HERE rather than beside its automation in dsl/worker, because
// TestCapabilityNamesMatchTheDSL reads this file as the complete set of
// integration.work.* executors -- and a set split across two files is the
// list written twice that its own comment refuses. The automation imports it.

/// Ask every in-flight run of one owner that has ACTUALLY dispatched to one of their machines to
/// stop. The selection is the runs named by that owner's v1:worker:invocation rows, which is a fact
/// the dispatcher already records per call -- so it is no broader than "runs actually using the
/// worker", and stricter than the Plan-era predicate it replaces (a plan with a computerUseScope
/// was one AUTHORIZED to use a machine; an invocation row is one that DID).
///
/// Cancellation is REQUESTED, not done: a run notices at its next step boundary, so a step already
/// in flight finishes and is journaled rather than being abandoned mid-effect. A worker call
/// already running on somebody's laptop cannot be un-run, and its NEXT call is denied by the
/// pre-dispatch gate in integrations/agent/worker/dispatch.go, which is the enforced half and is
/// untouched by any of this.
///
/// NOT @sdk, and gated on INTERNAL ORIGIN in its handler. Its argument names WHOSE runs to stop, so
/// the argument IS the authorization decision -- which is the shape memql#2888 hardened, naming
/// this automation's predecessor as the worked example: a caller who could supply the trigger
/// payload could reach a @serverOnly construct with any user's id. Internal origin requires BOTH a
/// trusted source (an automation from the registered tree) and a payload the caller did not supply,
/// so a caller-submitted bundle and a direct client call are both refused. A cluster-owner floor
/// would not have stopped that attack: the payload is what is chosen, not the role.
@executor("integration.work.cancelComputerUseRuns")
@description("Ask every in-flight run that used the owner's machines to stop, after their computer-use kill switch was engaged.")
builtin cancelComputerUseRuns {
  ownerUserId  string!  @description("The v1:identity:user whose computer-use runs should stop.")
}

// ---- approval-driven specialist training (memql#5063) ----

/// Ask for a specialist to be trained, as a decision a person makes rather than a thing an agent
/// does. Raises a skillMint approval on one of the caller's runs; approving it opens the
/// trainSpecialist work -- the SAME template the refresh cadence opens, so approval and cadence
/// cannot drift into two trainers.
///
/// The successor to the planner agent emitting `spawnTrainingPlan`, whose loop was deleted in
/// memql#5052 (design record section F: createSpecialist / extendSpecialist / spawnTrainingPlan
/// "become skill mint and skill training under the same gates"). It keeps that shape: the request
/// hangs on a RUN, because an approval with no run is a question nobody can answer.
///
/// Two gates survive the port, and both are cost-control properties: a specialist with no
/// domain-bearing skill ESCALATES for feedback rather than starting a bounded tool loop with
/// nowhere to write, and the approval itself is the idempotency -- one approved decision starts
/// exactly one training run, inherited from the pending-list resolution rather than re-implemented.
///
/// It does NOT check the domain here. A person may attach a domain-bearing skill between asking and
/// deciding, and refusing at the request would make the fix unreachable from the surface showing
/// the problem.
@sdk
@executor("integration.work.requestSpecialistTraining")
builtin requestSpecialistTraining {
  runId         string!  @description("The caller's v1:work:run the request is raised on.")
  specialistId  string!  @description("The v1:agents:agent to train.")
  topic         string   @description("What to train on. The resolved knowledge domain when empty.")
  mode          enum("initial", "refresh")  @description("initial (default) for a fresh training run, refresh for an incremental update.")
}
