/// Discover named capabilities admitted by the current caller's permissions.
@description("Discover capabilities admitted by the current caller permissions. Search short words naming the app or operation.")
@executor("workCapabilities")
@args(profile="object")
builtin workCapabilities { search string! }

/// Search the signed-in person's conversations across sessions. Returns exact
/// speaker-attributed excerpts and source ids. No embedding coverage is assumed.
@description("Search previous conversations and messages for personal facts, names, preferences or prior work. Exact phrase search with source conversation/turn ids. Follow cursor for older pages; try short alternate phrases on no matches.")
@executor("workSearchConversations")
@args(profile="object")
builtin workSearchConversations {
 search string! @description("Short exact word or phrase, case insensitive.")
 cursor string @description("Opaque cursor from the previous search page, with the same search.")
}

/// Recall source evidence by meaning, across this person's conversations.
/// Results preserve their original messages, dates and source ids. A match is
/// relevant evidence, never permission or proof that an old assertion is true.
@description("Recall earlier conversations, preferences and prior work by meaning. Uses indexed source evidence, revalidates originals and falls back to exact search when indexing is incomplete. Use a short natural-language question.")
@executor("workRecallMemory")
@args(profile="object")
builtin workRecallMemory { search string! }

/// Recall personal source evidence by meaning without rediscovering tools.
@handler(type="query", query="query workRecallMemory(search: args.search)")
@requiresAgentRole("assistant", "specialist")
tool recallMemory { search string! @description("A short question about earlier conversations, preferences or prior work. Results are historical source evidence, not current-world facts.") }

/// Execute a discovered capability under the original caller's authority.
@description("Execute a discovered capability under the current caller authority using its exact arguments.")
@executor("workExecute")
@args(profile="object")
builtin workExecute {
  name string!
  arguments object!
}

/// Find an operation and its exact argument contract before using it. Search
/// the relevant app or concept; narrow the search using the returned names.
@handler(type="query", query="query workCapabilities(search: args.search)")
@requiresAgentRole("assistant", "specialist")
tool discoverCapabilities { search string! @description("Empty string lists accessible concepts and their reads. Otherwise short words describing the app, data or operation, or an exact capability name.") }

/// Perform a discovered operation, rechecking caller and row permissions.
@handler(type="query", query="query workExecute(name: args.name, arguments: args.arguments)")
@requiresAgentRole("assistant", "specialist")
tool executeCapability {
  name string! @description("Exact qualified name from discoverCapabilities.")
  arguments object! @description("Arguments matching its contract; resolve identifiers through reads first.")
}

/// Open or focus a MemQL OS app for the person watching this run. This is
/// navigation, never a data mutation. It needs a connected OS viewer.
@description("Open or focus a MemQL OS app for the person watching this run. Navigation only; requires a connected viewer.")
@executor("workNavigate")
@args(profile="object")
builtin workNavigate {
 app string @description("App id or label. Omit to list the current authorized app/section catalog.")
 section string @description("Existing section id or label; never invent a section.")
 record string @description("Optional name or id of an existing record to open, such as VS Code and Cursor. Resolves under the caller permissions and asks for a choice on ambiguity.")
}

/// Navigate directly to a real OS destination. Use this for opening apps,
/// sections and records; do not discover arbitrary data operations first.
@handler(type="query", query="query workNavigate(app: args.app, section: args.section, record: args.record)")
@requiresAgentRole("assistant", "specialist")
tool navigateOS {
 app string @description("App id/name; omit to list destinations.")
 section string @description("Section id/name when requested.")
 record string @description("Existing record name or id when requested.")
}

/// Search original conversation messages and checkpoint sources in this work
/// run. Results retain their source index; a checkpoint never erases evidence.
@description("Search original conversation messages and checkpoint sources in this work run by a word, name or identifier.")
@executor("recallWorkHistory")
@args(profile="object")
builtin workRecallHistory {
 search string
 checkpoint string
 messageIndex int
 offset int
 maxChars int
 cursor string
}

/// Recover exact evidence from the original messages of the current work run.
@handler(type="query", query="query workRecallHistory(search: args.search, checkpoint: args.checkpoint, messageIndex: args.messageIndex, offset: args.offset, maxChars: args.maxChars, cursor: args.cursor)")
@requiresAgentRole("assistant", "specialist")
tool recallWorkHistory {
 search string @description("A name, word, identifier or phrase from earlier conversation or tool output. Combine with checkpoint and messageIndex to jump to that phrase inside one archived message; omit offset for the initial match. Omit search to read from offset zero.")
 checkpoint string @description("Exact archived reference returned by a checkpoint or previous search; with messageIndex selects one original message.")
 messageIndex int @description("Zero-based source message index, default 0, for an exact checkpoint read. Inspect sources[].messages to select the original tool result; message zero may be a derived summary. nextMessageIndex continues the source directory.")
 offset int @description("Unicode character offset in the serialized source message, default 0 for exact reads. Use nextOffset to continue.")
 maxChars int @description("Characters per excerpt, default 1600, maximum 4000. Entire response excerpts share an 8000-character budget.")
 cursor string @description("Continue searching older archive records using the prior response's cursor. An empty page with hasMore is not an exhausted search.")
}

/// Read only context archives, one bounded page; execution-progress snapshots
/// are not pulled into memory by a history search. Authority remains per owner.
@actor
query observation workContextSourcesForOwnerRun {
 args {
  runId string!
  fingerprint string!
 }
 filter row => row.ownerUserId == actor.userId && row.runId == args.runId && row.?data.sourceMessages != nil && (args.fingerprint == "" || row.?data.contextHash == args.fingerprint)
 sort "row.createdAt", "desc"
 paginate 4
 shape workObservationFull
}

/// Reuse a checkpoint only for these exact source bytes and this owner.
@actor
query observation workCheckpointForOwner {
 args { fingerprint string! }
 filter row => row.ownerUserId == actor.userId && row.?data.contextHash == args.fingerprint
 paginate 1
 shape workObservationFull
}
