// shapes.memql
//
// Full projections, one per work concept. Explicit rather than the
// default projection so a later credential-adjacent field cannot leak
// by being added to the concept (the Users app lesson, clients/os/README.md).

/// Every goal field the OS and the SDK read.
@row
shape goal workGoalFull {
  row.id
  row.createdAt
  ownerUserId
  statement
  origin
  responsibilityId
  accountIds
  input
  ceilings
  status
  requestedVia
  closedAt
  closeReason
  // The owner's routing choice (the Ask route picker's).
  routing
}

/// Every run field, including the trust and chain fields resume restores.
@row
shape run workRunFull {
  executionAuthority
  row.id
  row.createdAt
  ownerUserId
  goalId
  goalSignature
  automationName
  templateConstructId
  templateVersion
  templateFingerprint
  variables
  input
  inputFingerprint
  triggeredBy
  triggerEvent
  callerSuppliedPayload
  mode
  forkedFromRunId
  forkAtStepKey
  replayPolicy
  status
  waitingOn
  spent
  nodeId
  heartbeatAt
  cancelRequested
  cancelledBy
  expectedFootprint
  actualFootprint
  outcome
  errorCode
  errorMessage
  chainHead
  initialChainHead
  stepOrder
  startedAt
  finishedAt
  summary
  // epic memql#5408. A body-carrying shape projects ONLY what it lists, and
  // the lift and the replay runner read runs through this shape: without
  // these two a delegated recording could not name the goal it served or the
  // run that delegated it, however faithfully the row stored them.
  parentRunId
  // epic memql#5414: the head, the stale steps, the pending re-run and the
  // validator's summary. Listed for the reason above -- Nexus, the dispatcher
  // and the acts all read runs through this shape, and a field missing here is
  // a field none of them can see.
  head
  staleSteps
  rerun
  validation
  // The owner's routing choice. The planner's compile claim and the agent's
  // journal both read the run through this shape, and each stamps the choice
  // onto the run context its model calls read -- so a field missing here is a
  // choice no node would honour.
  routing
}

/// What a run the loop protection stopped says about the stop, and nothing else: the fields the
/// automationLoopStops builtin projects from (outcome holds the loop record), with the input, the
/// variables and the triggering event deliberately left out.
@row
shape run workRunLoopStop {
  row.id
  row.createdAt
  automationName
  errorCode
  finishedAt
  outcome
}

/// Every step field.
@row
shape step workStepFull {
  row.id
  row.createdAt
  ownerUserId
  runId
  key
  seq
  stepType
  kind
  call
  dependsOn
  input
  result
  resultFingerprint
  // The environment a session's first step ran against (epic memql#5408, gap
  // G4): what a learned procedure's preconditions are learned from, so the
  // lift has to be able to read it back.
  fingerprint
  binding
  expectedFootprint
  actualFootprint
  postcondition
  status
  symptom
  attempt
  idempotencyKey
  childRunId
  approvalId
  resumeAt
  externalKey
  startedAt
  finishedAt
  durationMs
  tokens
  cost
  errorCode
  errorMessage
  // epic memql#5414: which version this row is, the head it ran against, what
  // a person changed for it and who wrote its input.
  version
  basis
  override
  authoredBy
}

/// Every modelCall field.
@row
shape modelCall workModelCallFull {
  row.id
  row.createdAt
  ownerUserId
  runId
  stepKey
  requestHash
  provider
  model
  settings
  promptRef
  promptVersion
  inputTokens
  outputTokens
  cost
  latencyMs
  served
  response
  error
  routerCallId
  decision
}

/// Every approval field.
@row
shape approval workApprovalFull {
  row.id
  row.createdAt
  ownerUserId
  runId
  stepKey
  kind
  subject
  artifactHash
  question
  options
  evidence
  requestedAt
  decidedBy
  decidedAt
  decision
  answer
  expiresAt
}

/// Every observation field except the embedding vector, which no client reads.
@row
shape observation workObservationFull {
  row.id
  row.createdAt
  ownerUserId
  runId
  stepKey
  kind
  data
  content
}

/// The epic memql#5414 values, both of them, and when the seed last wrote the row.
@row
shape feedbackPolicy feedbackPolicyFull {
  row.id
  validateAnswers
  reusableAfterSignatures
  row.createdAt
}
