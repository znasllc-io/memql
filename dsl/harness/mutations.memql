// mutations.memql
//
// Mutations in the harness namespace -- the write paths that
// create and advance the harness working state (epic #590, #582).
//
// Plan lifecycle:   createHarnessPlan
// Step lifecycle:   addHarnessStep, readyHarnessStep,
//                   startHarnessStep, completeHarnessStep,
//                   failHarnessStep
// Observation:      recordHarnessObservation
//
// State-machine enforcement: the step status transitions (pending ->
// ready -> running -> done/failed/blocked, blocked -> ready, failed ->
// ready retry) cannot be expressed in the append-only DSL alone, so a
// Go pre-insert guard (component/memql/harness_step_validation.go)
// rejects invalid transitions (e.g. done -> running). The guard runs
// on every step insert AND on every update() (which read-merges then
// routes through executeInsert), so these mutations stay declarative.
//
// Provenance: the engine stamps createdBy from the authenticated
// actor on every inserted version automatically; each mutation also
// stamps provenanceMutation with its own name so the audit trail
// names the transition, not just the actor.
//
// Authorization (owned tier): create paths stamp ownerUserId from
// actor.userId; update paths read-merge the prior row so ownerUserId
// is preserved. The conformance classifier reads actor.userId in the
// insert bodies and buckets these as owned.

// createHarnessPlan
// ==========
// Create a v1:harness:plan in status='open'. ownerUserId is
// server-stamped from actor.userId so the caller cannot land a plan
// owned by someone else.
@mcp
@description("Create a v1:harness:plan in status='open'. ownerUserId is stamped from actor.userId (owned tier). Single write path for plan creation.")
mutate plan createHarnessPlan {
  args {
    planId  string
    goal    string  @required
    input   object
  }
  insert {
    accept { goal, input }
    stamp {
      id: args.planId
      ownerUserId: actor.userId
      status: "open"
      provenanceMutation: "createHarnessPlan"
    }
  }
}

// addHarnessStep
// =======
// Add a v1:harness:step to a plan in status='pending'. The engine
// emits graph.node.created.*.v1:harness:step on the insert (the
// `.*.` partition-segment wildcard caveat applies -- see CLAUDE.md).
// attempt starts at 0; status starts at pending and walks the state
// machine via the transition mutations below.
@mcp
@description("Add a v1:harness:step to a plan, status='pending', attempt=0. ownerUserId is stamped from actor.userId (owned tier). Creating the step emits graph.node.created.*.v1:harness:step automatically on insert.")
mutate step addHarnessStep {
  args {
    stepId          string
    planId          string  @required
    title           string  @required
    idempotencyKey  string  @required
    dependsOn       []string
    input           object
  }
  insert {
    accept { planId, title, idempotencyKey, dependsOn, input }
    stamp {
      id: args.stepId
      ownerUserId: actor.userId
      status: "pending"
      attempt: 0
      provenanceMutation: "addHarnessStep"
    }
  }
}

// readyHarnessStep
// =========
// Promote a step to ready: pending -> ready (dependsOn satisfied) or
// blocked -> ready (blocker finished). Without this write the step
// state machine is unreachable past 'pending' -- addHarnessStep
// lands the step in 'pending' and the engine guard only admits
// 'ready' -> 'running', so start/complete/fail could never fire
// (#1635). update() read-merges the prior row, so the owned-tier
// fields (ownerUserId, planId, title, ...) are preserved. The engine
// step guard validates the transition and rejects an illegal source
// status (e.g. done -> ready). The failed -> ready retry path (which
// must also bump attempt) stays a separate write.
@mcp
@description("Promote a step to ready (pending -> ready when dependsOn is satisfied, or blocked -> ready when the blocker finishes). Read-merges the prior row so owned-tier fields are preserved. The engine step guard validates the transition and rejects an illegal source status. Without this mutation the state machine is stuck at 'pending' (#1635).")
mutate step readyHarnessStep {
  args {
    stepId  string  @required
  }
  update {
    id: args.stepId
    status: "ready"
    provenanceMutation: "readyHarnessStep"
  }
}

// startHarnessStep
// =========
// Claim a ready step: ready -> running. assignedAgent records which
// agent claimed it; startedAt stamps the claim time. The engine
// guard rejects this when the prior status is not 'ready' (e.g.
// done -> running is invalid).
@mcp
@description("Claim a ready step (ready -> running). Stamps assignedAgent + startedAt. The engine step guard rejects the transition when the prior status is not 'ready'.")
mutate step startHarnessStep {
  args {
    stepId         string  @required
    assignedAgent  string
  }
  update {
    id: args.stepId
    status: "running"
    args.assignedAgent
    startedAt: now
    provenanceMutation: "startHarnessStep"
  }
}

// completeHarnessStep
// ============
// Record a running step's result: running -> done (terminal). The
// engine guard rejects this when the prior status is not 'running'.
@mcp
@description("Record a running step's result (running -> done). done is terminal. The engine step guard rejects the transition when the prior status is not 'running'.")
mutate step completeHarnessStep {
  args {
    stepId  string  @required
    result  object
  }
  update {
    id: args.stepId
    status: "done"
    args.result
    completedAt: now
    provenanceMutation: "completeHarnessStep"
  }
}

// failHarnessStep
// ========
// Mark a running step failed: running -> failed. errorMessage
// carries the reason. A subsequent retry (failed -> ready) is a
// separate write that bumps attempt; the engine guard enforces that
// failStep only fires from 'running'.
@mcp
@description("Mark a running step failed (running -> failed). Stamps errorMessage + completedAt. The engine step guard rejects the transition when the prior status is not 'running'. Retry (failed -> ready, attempt++) is a separate write.")
mutate step failHarnessStep {
  args {
    stepId        string  @required
    errorMessage  string
  }
  update {
    id: args.stepId
    status: "failed"
    args.errorMessage
    completedAt: now
    provenanceMutation: "failHarnessStep"
  }
}

// recordHarnessObservation
// =================
// Append a v1:harness:observation for a step -- what actually
// happened. ownerUserId is stamped from actor.userId. content is the
// embedding source; the harness embedding loop stores it into
// node_vectors keyed by this observation's id so it becomes
// semantically recall-able (#585).
@mcp
@description("Append a v1:harness:observation for a step (tool_result / error / note / decision). ownerUserId stamped from actor.userId (owned tier). content is the embedding source for semantic recall (#585).")
mutate observation recordHarnessObservation {
  args {
    observationId  string
    stepId         string  @required
    planId         string
    kind           string  @required  @enum("tool_result", "error", "note", "decision")
    content        string  @required
    data           object
  }
  insert {
    accept { stepId, planId, kind, content, data }
    stamp {
      id: args.observationId
      ownerUserId: actor.userId
    }
  }
}

// =====================================================================
// Memory consolidation (#586) -- semanticMemory + watermark writes.
//
// These are the write paths for the scheduled consolidation automation
// (dsl/harness/automations.memql): it distills episodic memory into
// durable beliefs, reinforces beliefs it has seen before instead of
// duplicating them, decays + prunes beliefs that go unreinforced, and
// advances the per-owner watermark so the next run is incremental.
//
// Appended for #586 -- the #582 mutation blocks above are untouched.
//
// Arithmetic gotcha: the MemQL parser has no arithmetic on number /
// datetime fields (the same limitation that killed the planner's
// tokenBudgetSoftWarning automation -- see root CLAUDE.md). So the
// reinforce / decay / advance mutations take the already-computed
// confidence / reinforceCount / episodesSeen VALUES as args; the Go
// consolidation loop does the bump + decay math and hands the result
// in. The mutation stays declarative; the math lives where the engine
// can do it.
//
// Authorization (owned tier): createHarnessSemanticMemory +
// advanceHarnessConsolidationCursor stamp ownerUserId from
// actor.userId, so the conformance classifier buckets them as owned.
// The reinforce / decay / prune update paths also re-stamp
// ownerUserId: actor.userId so they classify owned too -- consolidation
// only ever rewrites the calling owner's own beliefs. The
// semanticMemory + consolidationCursor concepts are pulled into scope
// by the file-top `use harness.concepts` import (extended for #586).

// createHarnessSemanticMemory
// ===========================
// Write a brand-new distilled belief. confidence + reinforceCount +
// lastReinforced seed the decay clock; sourceEpisodes carries the
// provenance back to the episodic nodes this belief was distilled
// from. The consolidation loop calls this only after similarTo found
// NO matching existing belief (otherwise it reinforces instead).
//
// content is the embedding source -- after this insert, the embedding
// loop stores it into node_vectors keyed by this memory's id so the
// belief is itself similarTo-recall-able (for #585 recall AND for the
// next run's own dedup step).
@description("Create a v1:harness:semanticMemory -- a new distilled belief. ownerUserId stamped from actor.userId (owned tier). sourceEpisodes records provenance back to the episodic nodes it was distilled from. confidence/reinforceCount/lastReinforced seed the decay clock. content is the embedding source for similarTo dedup + recall (#585).")
mutate semanticMemory createHarnessSemanticMemory {
  args {
    memoryId        string
    kind            string    @required  @enum("fact", "preference", "outcome")
    content         string    @required
    sourceEpisodes  []string  @required
    confidence      float
    lastReinforced  datetime
  }
  insert {
    accept { kind, content, sourceEpisodes }
    stamp {
      id: args.memoryId
      ownerUserId: actor.userId
      confidence: coalesce(args.confidence, 0.5)
      reinforceCount: 1
      lastReinforced: coalesce(args.lastReinforced, now)
      status: "active"
      provenanceMutation: "createHarnessSemanticMemory"
    }
  }
}

// reinforceHarnessSemanticMemory
// ==============================
// Dedup path: a later run distilled a belief that similarTo matched an
// existing one. Instead of writing a duplicate, bump confidence +
// reinforceCount and reset the decay clock (lastReinforced = now). This
// is what makes re-running over the same episodes idempotent at the
// belief level -- no new rows, just a stronger, fresher belief.
//
// confidence + reinforceCount are passed in already-computed (the Go
// loop does the bump math; the parser can't). sourceEpisodes is the
// MERGED, deduped provenance list (prior + this run's contributors),
// so the audit trail grows as evidence accumulates.
@description("Reinforce an existing v1:harness:semanticMemory (dedup path): take the engine-computed bumped confidence + reinforceCount, reset lastReinforced to now, and replace sourceEpisodes with the merged/deduped provenance. No new belief row -- this is why re-running over the same episodes does not duplicate. ownerUserId re-stamped from actor.userId (owned tier).")
mutate semanticMemory reinforceHarnessSemanticMemory {
  args {
    memoryId        string    @required
    confidence      float     @required
    reinforceCount  int       @required
    sourceEpisodes  []string  @required
  }
  update {
    accept { confidence, reinforceCount, sourceEpisodes }
    stamp {
      id: args.memoryId
      ownerUserId: actor.userId
      lastReinforced: now
      provenanceMutation: "reinforceHarnessSemanticMemory"
    }
  }
}

// decayHarnessSemanticMemory
// ==========================
// Forgetting: a belief that has gone unreinforced past
// MEMQL_HARNESS_CONSOLIDATION_DECAY_DAYS loses confidence. The decayed
// confidence is computed engine-side (from now - lastReinforced) and
// passed in. lastReinforced is NOT reset here -- decay must keep
// measuring age from the last real reinforcement, otherwise a belief
// could never age out.
@description("Decay an unreinforced v1:harness:semanticMemory: lower confidence to the engine-computed decayed value. lastReinforced is intentionally NOT reset (decay keeps measuring age from the last real reinforcement). ownerUserId re-stamped from actor.userId (owned tier). A belief that decays below the prune floor is then retired via pruneHarnessSemanticMemory.")
mutate semanticMemory decayHarnessSemanticMemory {
  args {
    memoryId    string  @required
    confidence  float   @required
  }
  update {
    id: args.memoryId
    ownerUserId: actor.userId
    args.confidence
    provenanceMutation: "decayHarnessSemanticMemory"
  }
}

// pruneHarnessSemanticMemory
// ==========================
// A belief that decayed below MEMQL_HARNESS_CONSOLIDATION_PRUNE_CONFIDENCE
// is retired: status -> pruned. Soft-delete (the row stays, append-only
// model has no row-removal mutation) -- recall (#585) and the next run's
// dedup step filter status=='active', so a pruned belief is invisible
// without being lost from the audit trail. Mirrors the safety / platform
// retention crons' observation-only pattern.
@description("Prune a decayed v1:harness:semanticMemory: status -> 'pruned' (soft-delete; the append-only model has no row removal). Recall (#585) + consolidation dedup filter status=='active', so a pruned belief drops out of both while staying in the audit trail. ownerUserId re-stamped from actor.userId (owned tier).")
mutate semanticMemory pruneHarnessSemanticMemory {
  args {
    memoryId  string  @required
  }
  update {
    id: args.memoryId
    ownerUserId: actor.userId
    status: "pruned"
    provenanceMutation: "pruneHarnessSemanticMemory"
  }
}

// advanceHarnessConsolidationCursor
// =================================
// Move the per-owner watermark forward after a run. watermark is set to
// the engine-computed max(createdAt) over the batch just processed, so
// the next run reads only episodes newer than this -- the mechanism that
// keeps consolidation INCREMENTAL (cost bounded by the new-episode
// delta, not total history). One cursor row per owner, content-addressed
// on ownerUserId, updated in place: the insert {} path with a stable id
// upserts via the engine's ON CONFLICT, so the same call both creates
// the cursor on first run and advances it on every later run.
@description("Advance the per-owner v1:harness:consolidationCursor watermark to the engine-computed max(createdAt) of the batch just consolidated -- the incremental-cost mechanism (next run reads only episodes newer than this). Upserts on a stable per-owner id so it creates the cursor on first run and advances it thereafter. episodesSeen takes the engine-computed running total. ownerUserId stamped from actor.userId (owned tier).")
mutate consolidationCursor advanceHarnessConsolidationCursor {
  args {
    cursorId      string
    watermark     datetime  @required
    episodesSeen  int
  }
  insert {
    accept { watermark, episodesSeen }
    stamp {
      id: args.cursorId
      ownerUserId: actor.userId
      lastRunAt: now
      provenanceMutation: "advanceHarnessConsolidationCursor"
    }
  }
}
