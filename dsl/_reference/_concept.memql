// =============================================================================
// MemQL Concept Reference
// =============================================================================
//
// This file is the source of truth for `concept` syntax. It is NOT loaded by
// the engine (the leading underscore on the path tells every walker to skip
// it). Every concept-level annotation, every field-level annotation, every
// supported type, and every body-level decorator is demonstrated below with
// inline commentary.
//
// A concept defines the schema for a class of memory-graph rows. Concepts
// are the only DSL construct that introduces new persistent data: every
// other construct (queries, mutations, shapes, specs, etc.) reads or writes
// rows whose shape is defined by a concept.
//
// The canonical concept ID assembled by the engine is:
//
//     v<MAJOR>:<namespace>:<conceptName>
//
// Authors stamp the MAJOR/MINOR/PATCH via @version and the namespace via
// @namespace; the concept name comes from the declaration header. The
// engine assembles the ID; authors never write the prefix.
//
// =============================================================================
//   1. Concept-level annotations
// =============================================================================
//
// Every annotation goes above the `concept` keyword. The full author surface
// is five annotations -- nothing else is recognized.
//
//   @description("text")        Human-readable description.
//   @version("MAJOR.MINOR.PATCH") Strict semver. Major flows into ID prefix.
//   @namespace("foo[:bar:baz]")  Colon-separated lowercase identifiers.
//   @type("object"|"collection"|"reference")  Default: object.
//   @rowAuthz(<tier>)           Who may see this concept's rows -- see below.
//
// (`@scope` was retired in #56 -- see section 5.)
//
// @rowAuthz declares the row-authorization tier ONCE on the concept, instead
// of as an `actor.*` term every filter over it has to remember to carry.
// Exactly one tier per concept; a second @rowAuthz is a load error.
//
//   @rowAuthz(public)            Globally readable by intent. Spelled
//                                explicitly -- "no annotation" and "declared
//                                public" are different states.
//   @rowAuthz(clusterOwner)      Administrative rows.
//   @rowAuthz(owner="<field>")   Rows belong to a user; <field> must be a
//                                field this concept declares, and it is
//                                compared against actor.userId.
//   @rowAuthz(owner="id")        SELF-OWNED: the row IS the owner, so there
//                                is no field to name (memql#3029). `id` and
//                                only `id` -- createdBy means "who WROTE the
//                                row", not "whose row it is", and admitting
//                                it would let a concept declare an owner
//                                tier that is FALSE.
//   @rowAuthz(via="<spec>")      A relationship spec grants visibility.
//
// PHASE 1 IS INERT (memql#2920): the tier is parsed, validated and carried on
// the concept, and nothing reads it at query time -- no predicate is injected
// and no query returns a different row set. A concept with no declaration
// still loads; it produces a boot warning, not an error. Seed the ones an
// existing query filter can prove with
// `memqlmigrate --rewrite=row-authz -w dsl/*/concepts.memql`.
// See docs/public/operate/auth/per-row-authz-audit.md.
//
// Other annotations are rejected at load time with
//   `unknown concept annotation @<name>`.
//
// =============================================================================
//   2. Canonical minimal concept
// =============================================================================
//
// The minimum a concept needs to register is @namespace + the declaration:
// absent @version defaults to 1.0.0 (#2613), so annotate a version only for
// genuine non-defaults. Everything else is optional. @description is
// conventional but not required.

@namespace("reference")
@description("Smallest legal concept declaration -- one required string field.")
concept minimal {
  name string! @description("Display name.")
}

// =============================================================================
//   3. @version -- strict semver string
// =============================================================================
//
//   - Strict three-segment form: "MAJOR.MINOR.PATCH". Single-segment "1" and
//     two-segment "1.0" are rejected at load time.
//   - Major must be >= 1. Minor + patch must be >= 0.
//   - Only the MAJOR segment flows into the concept ID prefix
//     (v<MAJOR>:<namespace>:<name>). MINOR + PATCH are documentation for
//     additive / non-breaking schema evolution within a major version.
//   - Bumping major is the breaking-change signal: it changes the concept
//     ID, which changes every row id, every event topic, and every
//     cross-concept reference.
//   - Absent @version defaults to 1.0.0 (#2613): the shipping baseline
//     needs no annotation. Annotate only genuine non-defaults.

@namespace("reference")
@description("No @version annotation: the 1.0.0 default applies. ID prefix is v1:.")
concept versionedV1 {
  field string!
}

@version("2.5.7")        // post-breaking-change, minor + patch reflect evolution
@namespace("reference")
@description("Example bumping past major version 2. ID prefix becomes v2:.")
concept versionedV2 {
  field string!
}

// =============================================================================
//   4. @namespace -- colon-separated lowercase identifiers
// =============================================================================
//
//   - Pattern: ^[a-z][a-z0-9_]*(:[a-z][a-z0-9_]*)*$
//   - Single-segment ("cognition") and multi-segment ("cognition:client:tool")
//     are both valid.
//   - Dotted form (cognition.client) is rejected -- the on-the-wire
//     concept ID uses `:` as the separator, and the author surface
//     mirrors it.
//   - Every segment must start with a lowercase letter.

@namespace("cognition")
@description("Single-segment namespace.")
concept singleSegmentNs {
  field string!
}

@namespace("cognition:client:tool")
@description("Multi-segment namespace. Assembles to v1:cognition:client:tool:nested.")
concept nestedNs {
  field string!
}

// =============================================================================
//   5. @scope -- retired in #56
// =============================================================================
//
// `@scope("global")` (and its companion `@scope("partition")`) were
// retired in the partition-removal pivot. Every concept lives in one
// partition; per-concept scope no longer exists. Authoring a `@scope`
// annotation on a concept is a load-time error.

// =============================================================================
//   6. @type -- object (default) | collection | reference
// =============================================================================
//
//   - @type("object") (default): the row is a self-contained record.
//   - @type("collection"): the row is a logical container for other
//     concepts. The engine requires a @relationship(type="contains", ...)
//     in the body.
//   - @type("reference"): the row is an alias / pointer to another concept.
//     The engine requires a @relationship(type="alias"|"equals", ...) in
//     the body.
//
// -----------------------------------------------------------------------------
//   6a. When to choose @type("reference") -- the canonical rule
// -----------------------------------------------------------------------------
//
// Use @type("reference") ONLY when the product-specific row needs payload
// fields the canonical concept doesn't have. The reference row is a thin
// adapter: it carries the alias pointer plus the extension fields, and
// nothing else.
//
// If the product-side row would just be an alias with no extra fields,
// DO NOT create a reference concept. Drop it entirely and have consumers
// use the canonical id directly. Empty reference rows are pure overhead:
// they double the write rate on the concept, double cache churn, and
// add a join to every combined read for no payload payoff.
//
// The decision tree:
//
//   Q: Does the product layer need to attach fields the canonical doesn't
//      and shouldn't carry?
//
//      YES -> create @type("reference") with @relationship(type="alias")
//             pointing at the canonical. Payload = the extension fields
//             plus the pointer. Examples: a UI display config that only
//             one product cares about; a per-product authorization grant
//             on top of a generic agent.
//
//      NO  -> the canonical record is sufficient. Author the concept in
//             its canonical namespace, period. Product code reads the
//             canonical row directly. Examples: the agent concept after
//             the 2026-05 namespace cleanup -- no product-specific extension
//             fields existed, so the product-namespaced agent concept was
//             retired and v1:agents:agent became the only home.
//
// Corollary: when in doubt, default to "object in the canonical namespace."
// A future reference concept can always be added later without migrating
// existing rows; an unnecessary reference concept retired later means
// migrating every product-side row that pointed at it.

@namespace("reference")
@type("object")
@description("Default record-shaped concept.")
concept objectExample {
  field string!
}

@namespace("reference")
@type("collection")
@description("Collection concept -- requires a @relationship(type=\"contains\", ...).")
concept collectionExample {
  // Body decorator: every collection MUST declare what it contains.
  @relationship(type="contains", field="memberIds", target="v1:reference:objectExample", direction="outgoing")
  memberIds []string
}

@namespace("reference")
@type("reference")
@description("Reference concept -- requires a @relationship(type=\"alias\"|\"equals\", ...).")
concept referenceExample {
  @relationship(type="alias", field="targetId", target="v1:reference:objectExample", direction="outgoing")
  targetId string!
}

// =============================================================================
//   7. Field types
// =============================================================================
//
//   The supported scalar types:
//     string      -- text
//     bool        -- true / false
//     int         -- integer
//     float       -- floating-point number
//     datetime    -- RFC3339 timestamp
//
//   The composite forms:
//     []<type>            -- array of T (shorthand for array(T))
//     enum("a", "b", ...) -- closed value set
//     object              -- arbitrary nested object (with body fields)
//     map[string]T        -- string-keyed map (map keys must be string)
//
//   The escape hatch:
//     any         -- accepts any JSON value; no validation
//
//   Element types are checked exactly like property types, at any nesting
//   depth: []boolean is rejected with the same "did you mean" correction,
//   []datetime enforces RFC3339 per entry, and [][]string keeps its inner
//   type (memql#2951).

@namespace("reference")
@description("Every supported field type, one of each.")
concept fieldTypes {
  textField        string                      @description("UTF-8 text.")
  flagField        bool       @default("false") @description("Boolean.")
  countField       int        @default("0")     @description("Integer.")
  ratioField       float      @default("0.0")   @description("Floating-point.")
  whenField        datetime                     @description("RFC3339 timestamp.")
  arrayField       []string                     @description("Array of strings.")
  statusField      enum("active", "archived", "deleted") @default("active")
  anyField         any                          @description("Untyped JSON.")
}

// =============================================================================
//   8. Field-level annotations
// =============================================================================
//
// This section says what each annotation DOES, which is not always what its
// name suggests. Three of the fifteen are DECLARED METADATA: they parse, they
// reach the emitted schema, and nothing in the engine acts on them
// (memql#2960). They are listed as such rather than quietly omitted, because
// an author who believes an annotation acts on their data will rely on it.
//
// @secret was a fourth until memql#3036. It is now PARTIALLY enforced, and
// "partially" is doing real work -- read its entry below before deciding a
// credential is safe.
//
// ENFORCED -- the engine acts on these:
//   @required           Field must be present on insert.
//   @pattern("regex")   String pattern (only valid on string fields). On
//                       []T / map[string]T it constrains each ELEMENT.
//   @minLength(N)       Min character count. STRING ONLY, and on []T it is a
//                       character count of each ELEMENT -- there is still no
//                       element-count check (memql#2951).
//   @maxLength(N)       Max character count. STRING ONLY -- same (memql#2951).
//   @secret             PARTIAL, and the boundary is the point (memql#3036).
//                       Emits `x-secret`, read by Concept.SecretFields().
//                       REDACTED FROM: the FUNCTION-ARGS validator, and only
//                       it. An argument whose NAME matches a @secret field of
//                       the function's bound concept has its rejected value
//                       replaced by `<redacted>`; the argument name and the
//                       declared constraint (enum members, bounds, pattern)
//                       survive so the diagnostic stays usable.
//                       MATCHING IS BY ARGUMENT NAME, NOT BY WRITE TARGET. A
//                       mutation writing `apiKey: args.credential` into a
//                       @secret `apiKey` leaves `credential` UNREDACTED --
//                       renaming between arg and field is common style here,
//                       so do not rely on the write target.
//                       NOT REDACTED FROM QUERY RESULTS. A @secret value is
//                       returned in full by any query that projects it. This
//                       is an authorization decision -- it needs a definition
//                       of "elevated" and interacts with the per-row authz
//                       model deferred under memql#2803.
//                       NOT REDACTED BY THE AUTOMATION ARGS BINDER. A second
//                       validator mirrors this rule set over EVENT payloads,
//                       and a graph.node.created event carries the row's
//                       fields. It quotes the value in full and also writes it
//                       to a WARN log -- so a row value CAN reach a structured
//                       log by that path.
//                       NOT REDACTED BY THE TOOL-ARGS VALIDATOR
//                       (validateToolArgs). Compiled from the SAME args schema
//                       that carries the secret flag and auto-registered for
//                       every enabled query and mutation, it runs BEFORE the
//                       covered validator on the agent path, serializes the
//                       ENTIRE args map into a WARN log rather than quoting one
//                       value, and returns its message to the model
//                       unredacted. Tracked as memql#3117.
//                       COVERED, since memql#3112: CONCEPT PAYLOAD VALIDATION.
//                       @minimum / @maximum / @format declared on the CONCEPT
//                       are checked by JSON schema, which interpolates the
//                       value -- and a secret field's message is now replaced
//                       before Concept.Create wraps it. This was the largest
//                       uncovered surface, because a constraint the args block
//                       does not mirror is validated ONLY there.
//                       LENGTH IS NEVER REDACTED. "value too long (N runes,
//                       max M)" reports a rune count for a secret field too.
//                       So @secret stops a credential leaking through a
//                       validation diagnostic. It is NOT a general secrecy
//                       guarantee, and it is not a substitute for keeping a
//                       credential out of the graph.
//                       (component/safety/redact.go is a different surface: it
//                       takes tool / HTTP payloads, never a concept row.)
//   @minimum(N)         Min numeric value (int / float).
//   @maximum(N)         Max numeric value (int / float).
//   @variant(discriminator="field")  Discriminated-union field. See section 9.
//   @internal           TWO gates. The field is rejected from a mutation's
//                       caller args, AND excluded from a shape's default
//                       projection (Concept.ProjectableFields). Server-only in
//                       both directions.
//   @serverSet          ONE gate, and it is a REJECTION rather than a stamp:
//                       the field is refused from caller args, and YOUR
//                       mutation must set it in its `stamp { }` block. Nothing
//                       populates it for you -- the name is the misleading
//                       part. Unlike @internal, a @serverSet field IS
//                       projectable, so a shape's default projection still
//                       renders it.
//                       NOT to be confused with the reserved row intrinsics
//                       (id / createdAt / createdBy / ...). Those are table
//                       COLUMNS rather than payload properties, and you must
//                       not declare them at all -- the engine supplies each
//                       from its own source: createdBy from the acting
//                       identity, createdAt from the insert clock, id from the
//                       insert's own id (or a content hash when none is
//                       given). See section 12.
//   @pii                Marks personally-identifying data, and it is
//                       load-bearing in two places: the @scrubPii update path
//                       zeroes every @pii field via Concept.PIIFields(), and
//                       the projection-authorization gate (memql#2883,
//                       dsl/pii_projection_test.go) requires a query
//                       projecting a shape that carries a @pii field to
//                       constrain its caller. ADDING @pii TO A FIELD CAN FAIL
//                       THE BUILD. That is the intent, and it is the working
//                       template for what "enforced" looks like here.
//   @description("...") Human-readable description. Emitted into the concept
//                       schema, so it reaches sense hover -- write it as
//                       documentation, not as a note. (It does NOT reach the
//                       generated SDK. sdk/gen does read concept declarations,
//                       but only their @version / @namespace preamble, to
//                       assemble canonical ids; it never reads the field list
//                       in the body, and emits no field metadata.)
//
// DECLARED METADATA -- parsed and emitted, acted on by NOTHING (memql#2960):
//   @unique             Emits `x-unique`. There is no uniqueness check
//                       anywhere in the engine or the database; two rows may
//                       carry the same value and nothing objects.
//   @immutable          Emits `x-immutable`. Nothing prevents an update. The
//                       immutability that does exist in the tree is bespoke
//                       per construct (validateRbacBaseRoleImmutable,
//                       validateHealingBaseImmutable) and is not driven by
//                       this annotation.
//   @default("value")   Emits `default` into the schema and is NEVER APPLIED
//                       on insert -- Concept.Create validates and marshals the
//                       payload verbatim. Fill a value with the `??`
//                       null-coalescing operator in the mutation body instead.
//                       The value IS parsed (ints as ints, floats as floats,
//                       "true"/"false" as bools) but there is no datetime
//                       branch, so a `datetime` field takes a bool default
//                       without complaint.
//
// Declared metadata is still worth writing where it records real intent: @pii
// began exactly there and is now enforced in two places, with no schema change
// needed to get from one to the other.
//
// Where the rest stand, which is NOT one answer for all of them:
//   - @secret   PARTIALLY ENFORCED as of memql#3036 -- the function-args
//     validator only. The scope was re-ruled mid-build: the original approval
//     said "logs", and the measurement found no log site carries a row
//     payload, so there was nothing there to enforce against. Error messages
//     are not the smaller surface -- they are the surface that exists.
//   - @default  open -- memql#3038.
//   - @unique / @immutable  DECIDED, and the decision is no. memql#3037 was
//     closed not-planned: uniqueness over an append-only hypertable means
//     "unique among current rows", which is an epic with a migration story,
//     and @immutable's cost is defining which read-merge-write rewrites are
//     legitimate. Neither has a forcing case. Treat both as permanent declared
//     metadata; reopen only with a concrete failure that one would have caught.
//
// Unknown @-annotations on a field are rejected at load time with
//   `unknown property annotation @<name> on field "<field>"`.

@namespace("reference")
@description("Every field-level annotation in use.")
concept fieldAnnotations {
  // String constraints
  slug         string! @pattern("^[a-z][a-z0-9-]{0,49}$") @description("URL slug.")
  shortText    string @minLength(1) @maxLength(280) @description("Tweet-shaped string.")
  uniqueKey    string! @unique @description("Intended to be unique. NOT enforced -- @unique is declared metadata (memql#2960).")

  // Numeric constraints
  ratingScore  int    @minimum(1) @maximum(5) @description("1-5 rating scale.")
  priceUsd     float  @minimum(0.0) @maximum(999999.99) @description("Currency.")

  // Defaults. NONE of these is ever filled in for you -- @default is declared
  // metadata (memql#2960). A row inserted without `status` has no `status`.
  // Fill it in the mutation body with `??` instead.
  status       enum("draft", "published") @default("draft") @description("Declared default only. NOT applied on insert -- use `?? \"draft\"` in the mutation (memql#2960).")
  createdYear  int    @default("2026") @description("Declared default only. NOT applied on insert -- nothing backfills this (memql#2960).")
  isPinned     bool   @default("false") @description("Declared default only. NOT applied on insert (memql#2960).")

  // Immutability + secrecy
  externalId   string! @immutable @description("Foreign-system id, intended never to change. NOT enforced -- @immutable is declared metadata (memql#2960).")
  apiKey       string @secret @description("Sensitive. The function-args validator prints <redacted> for a rejected value. No other surface redacts it -- not query results, not the automation args binder, not the tool-args validator, and never its length (memql#3036, memql#3117).")

  // Server-owned fields. @internal is server-only in BOTH directions;
  // @serverSet is refused from caller args but still projected, which is why
  // approvedBy can be rendered and internalNote cannot.
  // NOTE both names are deliberately non-reserved: createdBy / createdAt / id
  // are row intrinsics and declaring one here is rejected at build. Section 12.
  internalNote string @internal   @description("Server-only. Never accepted from caller args, never in a default projection.")
  approvedBy   string @serverSet  @description("Refused from caller args; your mutation stamps it in `stamp { }`. Projectable.")

  // Sensitivity. Unlike @secret above, this one is enforced: @scrubPii zeroes
  // it, and a query projecting a shape that carries it must constrain its
  // caller (memql#2883).
  ownerEmail   string @pii        @description("Personally-identifying. Scrubbed by @scrubPii; gates projection authorization.")

  // Description-only (no constraint)
  notes        string @description("Free-form notes.")
}

// =============================================================================
//   9. Variant fields (discriminated unions)
// =============================================================================
//
//   A `@variant(discriminator="kind")` field declares a value whose shape
//   depends on the value of a sibling field. Like any field it carries a
//   type -- `object!` (or `object` when optional) -- BEFORE the @variant
//   annotation; the variant body then refines that object's shape per
//   discriminator value. Inside the variant body the author writes each
//   branch keyed by the discriminator value.
//
//   Engine validation: payloads carrying this field must match exactly one
//   declared branch based on the discriminator's value.

@namespace("reference")
@description("Discriminated-union example: the `body` field's shape depends on `kind`.")
concept variantExample {
  kind  enum("text", "image", "embed")!

  body  object!  @variant(discriminator="kind") {
    text {
      content   string!
      wordCount int    @default("0")
    }
    image {
      url       string!
      width     int!
      height    int!
      altText   string
    }
    embed {
      url       string!
      provider  enum("youtube", "vimeo", "twitter")!
    }
  }
}

// =============================================================================
//   10. Nested object fields
// =============================================================================
//
//   A field can introduce a nested object by declaring a body block under
//   its name. Nested objects use the same field-level annotations as
//   top-level fields.

@namespace("reference")
@description("A flat concept with a nested settings sub-object.")
concept nestedExample {
  name   string!

  // Inline nested object: the body declares its own fields.
  settings {
    autoTranscribe  bool   @default("true")
    maxAttendees    int    @default("5") @minimum(1) @maximum(50)
    theme           enum("light", "dark", "auto") @default("auto")
  }
}

// =============================================================================
//   11. Body-level @relationship decorators
// =============================================================================
//
//   A concept body can declare zero or more @relationship decorators that
//   describe how this concept points to others. These live at the top of
//   the body block (alongside fields) and accept four named args:
//
//       @relationship(
//         type="parent"|"contains"|"alias"|"equals"|"references",
//         field="<fieldName>",
//         target="v1:<ns>:<conceptName>",
//         direction="outgoing"|"incoming"
//       )
//
//   The engine uses these to:
//     - validate referential integrity at insert time
//     - drive graph-bundle expansion in queries
//     - enforce the @type("collection") / @type("reference") constraints
//
//   `type` values:
//     parent      -- the named field carries the id of a logical parent.
//                    Required for concepts that nest under another.
//     contains    -- the named field carries ids of contained children.
//                    Required when @type("collection").
//     alias       -- this concept aliases the target concept's row.
//                    Required when @type("reference").
//     equals      -- this concept equals the target concept's row (id
//                    identity). Alternative form of alias for the
//                    @type("reference") requirement.
//     references  -- soft reference -- no constraint, just metadata.

@namespace("reference")
@description("A concept with three different relationship decorators.")
concept relationshipExample {
  // Parent: this row hangs off a space.
  @relationship(type="parent", field="partitionId", target="v1:cognition:space", direction="outgoing")
  partitionId    string!

  // References (soft): this row may name an author.
  @relationship(type="references", field="authorId", target="v1:identity:user", direction="outgoing")
  authorId   string

  // Plain data fields can sit next to relationships.
  content    string!
  publishedAt datetime
}

// =============================================================================
//   12. Reserved fields -- do not declare these
// =============================================================================
//
// The engine auto-stamps these intrinsic fields on every row. Authors must
// NOT declare them in the concept body; the parser rejects collisions.
//
//   id          string    -- row identity (auto-derived from content hash)
//   createdAt   datetime  -- insert timestamp
//   createdBy   string    -- author identity id
//   concept     string    -- the concept's canonical id (v1:ns:name)
//   partition   string    -- partition the row lives in
//   payload     object    -- the auto-rolled-up payload object
//   schema      string    -- the schema variant id for this row version
//   type        string    -- the concept's @type value
//
// Queries reference these intrinsics by their bare names (e.g.
// `concept==v1:cognition:participant`). Insert mutations don't supply them.

// =============================================================================
//   13. Infrastructure-metadata concepts (formerly @scope("global"))
// =============================================================================
//
// Some concepts hold infrastructure metadata that every node loads
// identically -- cluster topology, the identity service, the partition
// registry:
//
//     v1:cluster:node, v1:cluster:nodeType    -- cluster topology
//     v1:identity:user, v1:identity:identity  -- identity service
//     v1:platform:partition                   -- the partition registry
//
// These used to carry @scope("global"), but @scope was retired in #56
// (see section 5) -- per-concept scope no longer exists, and authoring a
// @scope annotation is a load-time error. Declare these concepts exactly
// like any other; nothing in the body changes.

@namespace("cluster")
@description("Example of an infrastructure-metadata concept that every node loads.")
concept globalInfraExample {
  hostname  string!
  nodeType  enum("bff", "voice", "cognition", "agent", "planner")!
  startedAt datetime!
}
