// concepts.memql -- safety namespace
//
// The safety command-classifier (memql#226 epic) writes one
// `v1:safety:classification` row per Gate.Evaluate decision. The
// rows are the substrate for the cockpit Command Safety view + the
// FP/FN measurement that gates the shadow->enforce rollout (#235).
//
// All persisted values are already passed through
// safety.RedactedPayload before they land here, so credential-shaped
// args never reach this concept.

@namespace("safety")
@description("One row per safety-classifier decision. Captures what the Gate decided, the verdict source (rule / model / cache), the surface + action it was deciding about, and the (redacted) payload. Retention is governed by the MEMQL_SAFETY_CLASSIFICATION_RETENTION_DAYS env var (default 90); the daily purge automation hard-deletes rows whose `createdAt + retentionDays < now`. Distinct from v1:platform:policyTrace -- policyTrace covers the decision-policy evaluation tree; this concept covers the safety-classifier verdict + final gate decision per command.")
concept classification {
  surface       string! @description("Execution surface: `computer_use_headless`/`_embodied`, `workbench`, `tool_webhook`, `tool_integration`.")
  action        string! @description("Abstract action: exec / fs_read / fs_write / fs_list / fs_stat / http_fetch / gui_input / screenshot / webhook / tool_call.")
  argsRedacted  string @description("JSON-encoded redacted payload. Body + Args go through safety.RedactedPayload (TOKEN/SECRET/PASSWORD/API_KEY/Authorization fragments -> [REDACTED]). Command / URL / Paths / Method / ToolName are passed through verbatim UNLESS the classifier flagged `credential_access` (URL with userinfo, env-var assignment in a shell command, etc.), in which case the recorder drops those surface fields entirely so credentials never reach the persisted row -- the rule's reason field still carries enough context for triage. Empty when the descriptor's payload was already empty.")
  tier          string! @description("Risk tier: `none`|`low`|`medium`|`high`|`critical`.")
  categories    string @description("Comma-separated category list (e.g. `destructive,credential_access`). Empty for tier=none.")
  decision      string! @description("What the Gate decided: `allow`|`ask`|`deny`. In shadow mode the surface always proceeds regardless; in enforce mode this is honoured.")
  source        string! @description("Classifier source: `rule`|`model`|`cache`|`noop`|`disabled`. Lets ops tell rule-engine hits from LLM verdicts in queries.")
  ruleId        string @description("Stable rule identifier (`shell.destructive`, `model.classify_v1`, ...). Empty for noop/disabled sources.")
  confidence    float  @description("Classifier self-reported confidence [0, 1]. Rule verdicts are 1.0 by convention; model verdicts carry the model's own estimate.")
  reason        string @description("Short human-readable explanation -- which specific pattern fired. <= 200 chars.")
  latencyMs     float  @description("Total classification latency in ms (chain time including rules + model + cache lookup). float (matches policyTrace.durationMs) since `number` isn't a DSL primitive.")
  agentId       string @description("Calling agent id.")
  ownerUserId   string @description("Owning user id.")
  planId        string @description("Plan id, when the action is plan-scoped.")
  correlationId string @description("Correlation id linking back to the dispatch + any auditEvent.")
  mode          string! @description("Gate mode at decision time: `off`|`shadow`|`enforce`. `shadow` rows are observation-only -- the surface proceeded regardless of `decision`.")
}

// approvalRequest -- the substrate for the Ask flow (memql#232).
//
// When the decision policy returns DecisionAsk in enforce mode, the
// gate consults its ApprovalSink. The DSL-backed sink creates one of
// these rows on first encounter and idempotently looks it up on
// subsequent calls (keyed by `correlationKey`, a sha-256 of the
// normalized descriptor). Resolving the row (status `approved` /
// `denied`) is what unblocks or blocks subsequent retries.
//
// v1 is observation-friendly and intentionally minimal:
// - No TTL enforcement (advisory expiresAt only -- the retention
//   sweep that flips stale rows to `expired` lands as a follow-up).
// - No audit-event mirror on resolve (lands with the cockpit card).
// - No Plan-parking integration (the gate just returns a refusal
//   referencing the row id; cockpit / CLI resolve via the mutation).
//
// What this concept buys today: an out-of-band approval channel that
// works even before the cockpit Card surface lands. Ops can resolve
// pending rows from a CLI mutation; the next retry of the same
// gated action will see the approved row and proceed.
@namespace("safety")
@description("One row per Ask-verdict approval request. The Gate's ApprovalSink creates a `pending` row on first encounter (keyed by correlationKey for idempotency), then `resolveApprovalRequest` flips it to `approved` / `denied`. The Gate's bypass check queries by correlationKey: an approved non-expired row returns proceed=true on the next retry of the same gated action; otherwise the refusal text references the request id so a human can resolve it. Distinct from v1:safety:classification -- classification is the per-decision audit row (one per evaluation); approvalRequest is the per-(surface, action, payload) bypass token (one per unique action, reused across retries).")
concept approvalRequest {
  correlationKey   string! @description("SHA-256 hex of the normalized descriptor (surface | action | command/url/paths/tool-name + ToolArgs). Idempotency key -- repeated Ask verdicts for the same action collapse to the same row. Generated by safety.ApprovalCorrelationKey().")
  surface          string! @description("Same enum as classification.surface. Captured here so cockpit / CLI can render the request without joining back to a classification row.")
  action           string! @description("Same enum as classification.action.")
  argsRedacted     string   @description("JSON-encoded redacted payload. Same scrub semantics as classification.argsRedacted (Body + Args run through safety.RedactedPayload; Command/URL/Paths dropped on credential_access). Lets the approver see what they're approving without seeing credentials.")
  tier             string! @description("Risk tier the classifier assigned.")
  categories       string   @description("Comma-separated category list (e.g. `destructive,credential_access`).")
  reason           string   @description("Why approval was required -- usually the classifier's reason field copied verbatim.")
  expiresAt        datetime @description("Advisory TTL. Approved rows older than expiresAt should be treated as expired by the bypass check; the retention sweep that flips them to status=`expired` lands as a follow-up. Empty / zero = no TTL.")
  status           string! @description("`pending` (created, awaiting human decision) | `approved` (bypass token live until expiresAt) | `denied` (subsequent retries refused) | `expired` (advisory; set by retention sweep). Initial value on create is always `pending`.")
  decidedBy        string   @description("User id of the human who resolved the request. Empty while status=`pending`.")
  decidedAt        datetime @description("When status moved off `pending`. Empty while pending.")
  decisionReason   string   @description("Free-text rationale supplied by the approver (e.g. 'one-off; confirmed safe by ops'). Optional.")
  agentId          string   @description("Agent id that triggered the Ask. Lets the cockpit group pending requests by agent.")
  ownerUserId      string   @description("Owning user id (whose Plan / agent triggered this). Drives the cockpit's per-user inbox.")
  planId           string   @description("Plan id, when the action was Plan-scoped. Lets the cockpit deep-link the request back to the parked Plan once the Plan-parking integration lands.")
}

// outputScreening -- the substrate for incoming-content prompt-
// injection screening (memql#233). Distinct from `classification`:
//
//   - classification covers AGENCY -- "should this command run?"
//   - outputScreening covers INGRESS -- "should this string land in
//     the model's context?"
//
// Three ingress paths drive rows: tool outputs (text returned by
// tools the model invoked), HTTP fetches (workbench/agent
// http_fetch bodies), file reads (workbench/computer-use fs_read
// results), and knowledge seed material newly indexed. Shadow rows
// accumulate as the substrate for the FP/FN measurement (#235); the
// cockpit prompt-injection dashboard layers reads on top
// (separate memql-cockpit follow-up).
//
// Retention follows the same pattern as classification: env-tunable
// MEMQL_SAFETY_OUTPUT_SCREENING_RETENTION_DAYS (default 90),
// observation-only purge until the engine grows a delete() mutation.
@namespace("safety")
@description("One row per output-screening decision. Captures what the OutputGate decided about a single piece of incoming content before the model re-ingested it. Distinct from v1:safety:classification: classification covers agency (should this command run?); outputScreening covers ingress (should this string land in the model's context?). Retention is governed by MEMQL_SAFETY_OUTPUT_SCREENING_RETENTION_DAYS (default 90).")
concept outputScreening {
  contentType    string! @description("Ingress channel: `tool_output` / `http_fetch` / `file_read` / `knowledge_seed`. Lets ops slice screening data by attack surface.")
  contentLength  float  @description("Byte length of the screened content BEFORE the redactedSample truncation. Useful for spotting bloat-attack vectors (megabyte-scale content with one tiny injection buried).")
  redactedSample string @description("First N bytes of the content after secret-redaction. Capped at 4 KiB by the recorder so a poisoned 100 MB document doesn't blow the row up. Lets ops inspect what fired the verdict without keeping the whole payload.")
  tier           string! @description("Risk tier the screener assigned: `none` (clean) / `low` / `medium` / `high` (suspicious) / `critical` (overt injection).")
  categories     string @description("Comma-separated category list: `prompt_injection` / `instruction_override` / `role_hijack` / `exfiltration` / `delimiter_abuse`. Empty for tier=none.")
  verdict        string! @description("What the OutputGate decided: `clean` / `suspicious` / `blocked`. In shadow mode the gate always returns clean to the surface regardless; in enforce mode this is honoured (suspicious -> log + pass; blocked -> drop).")
  screener       string! @description("Verdict source: `rule` (deterministic pattern) / `model` (LLM classifier; not shipped today) / `cache` / `noop` / `disabled`.")
  ruleId         string @description("Stable rule identifier (`prompt_injection.ignore_previous`, etc.). Empty for noop/disabled sources.")
  confidence     float  @description("Screener self-reported confidence [0, 1]. Rule verdicts are 1.0 by convention.")
  reason         string @description("Short human-readable explanation -- which specific pattern fired. <= 200 chars.")
  latencyMs      float  @description("Total screening latency in ms. float (matches classification.latencyMs) since `number` isn't a DSL primitive.")
  agentId        string @description("Agent that triggered the ingress (where applicable; tool outputs always have one; HTTP fetches usually do).")
  ownerUserId    string @description("Owning user id.")
  planId         string @description("Plan id, when the ingress was Plan-scoped.")
  correlationId  string @description("Correlation id linking back to the dispatch.")
  mode           string! @description("OutputGate mode at decision time: `off`|`shadow`|`enforce`. `shadow` rows are observation-only -- the surface re-ingested the content regardless of `verdict`.")
}
