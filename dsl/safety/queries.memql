// queries.memql -- safety namespace.

/// Returns every v1:safety:classification row. Used by the retention sweep (mirrors
/// allPolicyTraces); future cockpit Command Safety view will layer more targeted queries on top.
@unbounded("safety classification catalog -- a bounded config set consumed whole")
query classification allSafetyClassifications {
  filter  surface!=""
  shape   classificationFull
}

/// Returns active (pending OR approved) v1:safety:approvalRequest rows for a given correlationKey.
/// The DSL-backed ApprovalSink calls this BEFORE creating a new pending row -- if an `approved`
/// non-expired row exists, the Gate bypasses with proceed=true; if a `pending` row exists, the sink
/// reuses its id rather than creating a duplicate (idempotency). `expired` and `denied` rows are
/// excluded -- the bypass check should treat them as nonexistent so a subsequent retry creates a
/// fresh pending row.
@unbounded("active approvals for a correlation key -- a bounded in-flight set consumed whole")
query approvalRequest activeApprovalsByCorrelationKey {
  args {
    correlationKey string!
  }
  filter  correlationKey==args.correlationKey && status!="denied" && status!="expired"
  shape   approvalRequestFull
}

/// Returns a single v1:safety:approvalRequest by id. Backs the cockpit drill-down view (follow-up
/// in memql-cockpit) and the `resolveApprovalRequest` read-modify-write path.
query approvalRequest approvalRequestById {
  args {
    id string!
  }
  filter  id==args.id
  shape   approvalRequestFull
}

/// Returns every v1:safety:outputScreening row. Used by the retention sweep (mirrors
/// allSafetyClassifications); future cockpit prompt-injection dashboard will layer more targeted
/// queries on top.
@unbounded("output screening catalog -- a bounded config set consumed whole")
query outputScreening allOutputScreenings {
  filter  contentType!=""
  shape   outputScreeningFull
}
