// queries.memql -- safety namespace.

use safety.concepts.{ classification, approvalRequest, outputScreening }
use safety.shapes.{ classificationFull, approvalRequestFull, outputScreeningFull }

@enabled
@unbounded("safety classification catalog -- a bounded config set consumed whole")
@description("Returns every v1:safety:classification row. Used by the retention sweep (mirrors queryAllPolicyTraces); future cockpit Command Safety view will layer more targeted queries on top.")
query classification queryAllSafetyClassifications {
  filter  payload.surface!=""
  shape   classificationFull
}

@enabled
@unbounded("active approvals for a correlation key -- a bounded in-flight set consumed whole")
@description("Returns active (pending OR approved) v1:safety:approvalRequest rows for a given correlationKey. The DSL-backed ApprovalSink calls this BEFORE creating a new pending row -- if an `approved` non-expired row exists, the Gate bypasses with proceed=true; if a `pending` row exists, the sink reuses its id rather than creating a duplicate (idempotency). `expired` and `denied` rows are excluded -- the bypass check should treat them as nonexistent so a subsequent retry creates a fresh pending row.")
query approvalRequest queryActiveApprovalsByCorrelationKey {
  args {
    correlationKey string @required
  }
  filter  payload.correlationKey==args.correlationKey && payload.status!="denied" && payload.status!="expired"
  shape   approvalRequestFull
}

@enabled
@description("Returns a single v1:safety:approvalRequest by id. Backs the cockpit drill-down view (follow-up in memql-cockpit) and the `mutationResolveApprovalRequest` read-modify-write path.")
query approvalRequest queryApprovalRequestById {
  args {
    id string @required
  }
  filter  id==args.id
  shape   approvalRequestFull
}

@enabled
@unbounded("output screening catalog -- a bounded config set consumed whole")
@description("Returns every v1:safety:outputScreening row. Used by the retention sweep (mirrors queryAllSafetyClassifications); future cockpit prompt-injection dashboard will layer more targeted queries on top.")
query outputScreening queryAllOutputScreenings {
  filter  payload.contentType!=""
  shape   outputScreeningFull
}
