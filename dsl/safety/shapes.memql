// shapes.memql -- safety namespace.

use safety.concepts.{ classification }

@row
@concepts("v1:safety:classification")
@description("Comprehensive projection of every v1:safety:classification field. Backs the retention sweep + future cockpit Command Safety view.")
shape classification classificationFull {
  row.id
  row.createdAt
  payload.surface
  payload.action
  payload.argsRedacted
  payload.tier
  payload.categories
  payload.decision
  payload.source
  payload.ruleId
  payload.confidence
  payload.reason
  payload.latencyMs
  payload.agentId
  payload.ownerUserId
  payload.planId
  payload.correlationId
  payload.mode
}
