// shapes.memql -- safety namespace.

use safety.concepts.{ classification, approvalRequest }

@row
@concepts("v1:safety:classification")
@description("Comprehensive projection of every v1:safety:classification field. Backs the retention sweep + future cockpit Command Safety view.")
shape classification classificationFull {
  row.id
  row.createdAt
  payload.surface
  payload.action
  payload.argsRedacted
  payload.tier
  payload.categories
  payload.decision
  payload.source
  payload.ruleId
  payload.confidence
  payload.reason
  payload.latencyMs
  payload.agentId
  payload.ownerUserId
  payload.planId
  payload.correlationId
  payload.mode
}

@row
@concepts("v1:safety:approvalRequest")
@description("Comprehensive projection of every v1:safety:approvalRequest field. Backs the cockpit approval inbox (memql-cockpit follow-up) + the Gate's bypass-check query.")
shape approvalRequest approvalRequestFull {
  row.id
  row.createdAt
  payload.correlationKey
  payload.surface
  payload.action
  payload.argsRedacted
  payload.tier
  payload.categories
  payload.reason
  payload.expiresAt
  payload.status
  payload.decidedBy
  payload.decidedAt
  payload.decisionReason
  payload.agentId
  payload.ownerUserId
  payload.planId
}
