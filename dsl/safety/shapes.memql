// shapes.memql -- safety namespace.

@row
@description("Comprehensive projection of every v1:safety:classification field. Backs the retention sweep + future cockpit Command Safety view.")
shape classification classificationFull {
  row.id
  row.createdAt
  surface
  action
  argsRedacted
  tier
  categories
  decision
  source
  ruleId
  confidence
  reason
  latencyMs
  agentId
  ownerUserId
  planId
  correlationId
  mode
}

@row
@description("Comprehensive projection of every v1:safety:approvalRequest field. Backs the cockpit approval inbox (memql-cockpit follow-up) + the Gate's bypass-check query.")
shape approvalRequest approvalRequestFull {
  row.id
  row.createdAt
  correlationKey
  surface
  action
  argsRedacted
  tier
  categories
  reason
  expiresAt
  status
  decidedBy
  decidedAt
  decisionReason
  agentId
  ownerUserId
  planId
}

@row
@description("Comprehensive projection of every v1:safety:outputScreening field. Backs the retention sweep + future cockpit prompt-injection dashboard.")
shape outputScreening outputScreeningFull {
  row.id
  row.createdAt
  contentType
  contentLength
  redactedSample
  tier
  categories
  verdict
  screener
  ruleId
  confidence
  reason
  latencyMs
  agentId
  ownerUserId
  planId
  correlationId
  mode
}
