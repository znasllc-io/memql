// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@version("1.0.0")
@namespace("memql")
@visibility("*")
@description("Automation execution checkpoints for failure recovery and audit history.")
concept checkpoint {
  automationFingerprint  string  @description("Content-addressed hash of the automation definition for change detection.")
  automationName  string  @required  @description("Name of the automation that was running.")
  chainHead  string  @description("Chain state before the failed step.")
  executionId  string  @required  @description("Unique identifier for this execution instance.")
  expiresAt  datetime  @required  @description("When the checkpoint becomes invalid (ISO 8601).")
  failedAt {
    error  string  @description("Error message.")
    errorCode  string  @description("Error code (if applicable).")
    stepId  string  @description("ID of the step that failed.")
    timestamp  datetime  @description("When the failure occurred (ISO 8601).")
  }
  initialChainHead  string  @description("Starting chain state for chain validation.")
  input  string  @description("Automation input data for evaluator restoration.")
  inputFingerprint  string  @description("Hash of input for verification.")
  savedAt  datetime  @required  @description("When the checkpoint was saved (ISO 8601).")
  stepIndex  int  @description("Index in the Steps slice where failure occurred.")
  stepOrder  []string  @description("Execution sequence for verification.")
  stepResults  object  @description("Results for all completed steps before failure (map of stepId to MinimalStepResult).")
  triggerContext {
    event  object  @description("Event data if triggered by event.")
    triggeredBy  string  @description("How the automation was triggered (schedule, event, manual).")
  }
}
