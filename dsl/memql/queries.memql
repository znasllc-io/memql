// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

func (Query) queryTestAutomation(ctx any) (any, error) {
  // Query checkpoints for this automation
  // Returns all checkpoints for the specified automation
  ctx.output = shape(
    concept;checkpoint.automationName==args.automationName,
    {
      node("checkpoint.executionId"),
      node("checkpoint.automationName"),
      node("checkpoint.savedAt"),
      node("checkpoint.expiresAt"),
      node("checkpoint.failedAt"),
      node("checkpoint.stepIndex")
    }
  )
  return ctx, nil
}
