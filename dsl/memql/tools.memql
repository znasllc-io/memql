// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@enabled
@handler(type="query", query="help({\"name\": \"$args.name\"})")
@executionTime("fast")
@description("Get detailed usage guidance for a MemQL named function (docs, args schema, and key calling rules)")
@mcp
tool describeFunction {
  name  string  @required @description("The function name to describe (e.g., activeSpaces)")
}

// ---- tools/v1/memql/toolSearchUsers.memql ----

// toolSearchUsers - Search for Users
// ====================================
//
// Search for users in the system.

@enabled
@handler(type="query", query="paginate(querySearchUsers({active: $args.active}), $args.limit)")
@executionTime("fast")
@description("Search for users")
@mcp
tool searchUsers {
  active  boolean  @description("Filter by active status")
  limit   integer  @default("10") @description("Maximum number of results to return")
}
