// traits.memql
//
// Reusable role filters for the `forge` namespace. Cluster roles are
// owner/admin/writer/reader (there is no literal "developer" role), so the
// forge personas map on:
//   owner   -> approver / fast-track
//   admin   -> senior developer (validate + approve)
//   writer  -> junior developer (validate)
//   reader  -> non-developer employee (submit-only, mentored)
//
// These gate the developer/owner-only read paths (the validation + approval
// queues) at the query layer, so non-developers literally cannot list other
// people's requests to act on them. Submission and "my own requests" stay
// open to every authenticated team member.

@enabled
@description("Caller is a forge developer (owner/admin/writer) -- may see the validation queue and validate requests.")
trait forgeDeveloper {
  actor.role == "owner" || actor.role == "admin" || actor.role == "writer"
}

@enabled
@description("Caller is a forge approver (owner) -- holds final approval + fast-track authority.")
trait forgeApprover {
  actor.role == "owner"
}
