// tools.memql
//
// The `forge` MCP surface -- the tools a team member's Claude calls to run
// development + people-ops. One tool binds to exactly one handler (a named
// mutation, or a query/statement). Per-row identity is stamped server-side
// inside the bound mutation (submitter/validator/approver = actor), so no
// tool call can act as someone else.
//
// Gating: submit + "my requests" are open to every authenticated team member.
// The validation/approval QUEUE tools run developer/owner-gated queries
// (traits.memql), so a non-developer calling them gets an empty list. The
// hard transition guard (only an owner may approve) is the engine pre-insert
// follow-up noted in mutations.memql.
//
// Mentoring: forgeSubmitRequest's description instructs Claude to teach a
// non-owner submitter about what they're looking at while filing -- the
// "learn about the company as you work" layer. (A dedicated mentoring prompt
// lands in the next slice.)

// ----- projects -----

@enabled
@handler(type="function", name="createProject")
@executionTime("fast")
@description("Register a project forge develops against (e.g. memql, copresent for a client). Pass a fresh unique projectId. Use this once per app/codebase; requests reference projectId.")
@allowedRoles("owner", "admin", "developer", "writer")
@mcp
tool forgeRegisterProject {
  projectId    string  @required @description("Fresh unique id for the project, e.g. a UUID. The caller mints it so it can reference the row immediately.")
  slug         string  @required @description("Stable short id, e.g. 'memql' or 'copresent-acme'.")
  name         string  @required @description("Human-readable project name.")
  targetApp    string  @description("Which app this develops: memql / memql-cockpit / copresent / ...")
  repo         string  @description("Git repository URL or path.")
  description  string  @description("What the project is.")
}

@enabled
@handler(type="query", query="activeProjects({})")
@executionTime("fast")
@description("List the active forge projects. Use this to resolve a projectId before submitting a request.")
@allowedRoles("owner", "admin", "developer", "writer", "reader")
@mcp
tool forgeActiveProjects {}

@enabled
@handler(type="query", query="projectBySlug({slug: \"$args.slug\"})")
@executionTime("fast")
@description("Resolve a forge project by its human-readable slug (e.g. 'memql', 'copresent-acme') to the full project row including its id. Use this when the caller says a project name in natural language so you can obtain the projectId for subsequent requests. Slugs are unique within the caller's partition (tenant), so this always returns at most one project.")
@allowedRoles("owner", "admin", "developer", "writer", "reader")
@mcp
tool forgeResolveProject {
  slug  string  @required  @description("The stable short slug of the project, e.g. 'memql' or 'copresent-acme'.")
}

// ----- submit + browse (open to all team members) -----

@enabled
@handler(type="function", name="createRequest")
@executionTime("fast")
@description("Submit a forge request (bug, feature, chore, question, or an HR action) for a project. submitterUserId + submitterRole are stamped server-side from the caller. status lands 'submitted' and is auto-routed by role (owner fast-tracks; a developer goes to approval; a non-developer goes to validation first). Pass a fresh unique requestId. MENTORING SEQUENCE (mandatory for non-owner submitters): after this tool returns successfully, check whether the submitter is NOT an owner. If so: (1) call the forgeMentoringExplanation prompt with the project slug, request type, title, and body to generate a short teaching explanation of the area they are touching; (2) show that explanation to the user as a friendly follow-on message; (3) immediately call forgeRecordMentoring to record a 'mentored' requestEvent on this request (pass the explanation as the note). Owner submissions skip the mentoring sequence entirely.")
@allowedRoles("owner", "admin", "developer", "writer", "reader")
@mcp
tool forgeSubmitRequest {
  requestId  string  @required @description("Fresh unique id for the request, e.g. a UUID. The caller mints it so it can reference the row immediately.")
  projectId   string  @required @description("v1:forge:project.id this request targets (from forgeActiveProjects).")
  requestType string  @enum("bug", "feature", "chore", "question", "timeOff", "checkIn") @description("Request kind. Defaults to bug.")
  title      string  @required @description("Short summary of the request.")
  body       string  @required @description("Full description: what they want, what they saw, repro steps. Capture the employee's words plus any analysis Claude added.")
  priority   string  @enum("low", "normal", "high", "urgent") @description("Optional priority. Defaults to normal.")
}

@enabled
@handler(type="query", query="myRequests({})")
@executionTime("fast")
@description("List the caller's own submitted requests, newest first.")
@allowedRoles("owner", "admin", "developer", "writer", "reader")
@mcp
tool forgeMyRequests {}

@enabled
@handler(type="query", query="requestById({requestId: \"$args.requestId\"})")
@executionTime("fast")
@description("Get a single forge request by id (full detail).")
@allowedRoles("owner", "admin", "developer", "writer", "reader")
@mcp
tool forgeRequestById {
  requestId  string  @required @description("Id of the request to fetch.")
}

@enabled
@handler(type="query", query="requestEvents({requestId: \"$args.requestId\"})")
@executionTime("fast")
@description("Get the full lifecycle/audit trail for a request (submitted, routed, validated, approved, ...), newest first.")
@allowedRoles("owner", "admin", "developer", "writer")
@mcp
tool forgeRequestHistory {
  requestId  string  @required @description("Id of the request whose history to fetch.")
}

// ----- developer/owner queues + transitions -----

@enabled
@handler(type="query", query="validationQueue({})")
@executionTime("fast")
@description("List requests awaiting first-line developer validation. Developer/owner only -- returns empty for others.")
@allowedRoles("owner", "admin", "developer", "writer")
@mcp
tool forgeValidationQueue {}

@enabled
@handler(type="function", name="validateRequest")
@executionTime("fast")
@description("Validate a request (developer action): advances it to 'needs_approval' and stamps the validator from the caller. Validate from the validation queue.")
@allowedRoles("owner", "admin", "developer", "writer")
@mcp
tool forgeValidateRequest {
  requestId  string  @required @description("Id of the request to validate.")
}

@enabled
@handler(type="query", query="approvalQueue({})")
@executionTime("fast")
@description("List validated requests awaiting owner approval. Owner only -- returns empty for others.")
@allowedRoles("owner", "admin", "developer", "writer")
@mcp
tool forgeApprovalQueue {}

@enabled
@handler(type="function", name="approveRequest")
@executionTime("fast")
@description("Approve a request (owner action): advances it to 'queued' (ready to implement; auto-execute/deploy lands when the actions substrate is wired) and stamps the approver from the caller.")
@allowedRoles("owner", "admin", "developer", "writer")
@mcp
tool forgeApproveRequest {
  requestId  string  @required @description("Id of the request to approve.")
}

@enabled
@handler(type="function", name="requestChanges")
@executionTime("fast")
@description("Send a request back for changes (developer/owner action) with a reason: sets status 'changes_requested'.")
@allowedRoles("owner", "admin", "developer", "writer")
@mcp
tool forgeRequestChanges {
  requestId   string  @required @description("Id of the request to send back.")
  resolution  string  @required @description("Why it's being sent back / what needs to change.")
}

// ----- mentoring -----

@enabled
@handler(type="function", name="recordMentoring")
@executionTime("fast")
@description("Record a 'mentored' requestEvent after Claude has delivered a teaching explanation to a non-owner submitter. Call this immediately after showing the mentoring explanation to the user. Pass the request id and the explanation text as the note (kind='mentored' is injected server-side). Owner submissions skip this tool -- only call it when the submitter role is NOT 'owner'.")
@allowedRoles("owner", "admin", "developer", "writer", "reader")
@mcp
tool forgeRecordMentoring {
  eventId    string  @description("Fresh unique id for the event, e.g. a UUID. Optional -- the engine mints one if absent.")
  requestId  string  @required @description("Id of the request that was mentored (from forgeSubmitRequest).")
  note       string  @required @description("The mentoring explanation text Claude generated and showed to the user. Stored verbatim as the event note so the audit trail captures exactly what was taught.")
}

// ----- attachments -----

@enabled
@handler(type="function", name="appendAttachmentToRequest")
@executionTime("fast")
@description("Attach ONE screenshot or file (a v1:common:attachment id) to an existing forge request. Callable repeatedly to accumulate multiple attachments. Internally fetches the current attachmentIds array, appends the new id, and writes the full updated array -- no clobbering of existing attachments. The v1:common:attachment must already exist (uploaded via the space attachments endpoint).")
@allowedRoles("owner", "admin", "developer", "writer", "reader")
@mcp
tool forgeAttachToRequest {
  requestId     string  @required @description("Id of the v1:forge:request to attach to.")
  attachmentId  string  @required @description("Id of the v1:common:attachment to link. The attachment must already be uploaded (POST /spaces/{partitionId}/attachments). Call this tool once per file; each call appends without clobbering.")
}
