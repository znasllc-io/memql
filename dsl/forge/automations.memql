// automations.memql
//
// Event-driven orchestration for the `forge` namespace.
//
// routeRequest -- the first forge automation. Fires when a v1:forge:request
// is created (the submitRequest tool -> createRequest -> node.created)
// and routes it through routeRequest by submitter role. This is the
// idiomatic MemQL shape: an MCP tool writes a node, a node.created automation
// orchestrates. The whole pipeline (validate -> approve -> implement) hangs
// off this spine; later phase automations (spike, implement, deploy) trigger
// off subsequent request transitions.
//
// recordTransition -- fires on node.updated for v1:forge:request and appends
// one requestEvent per pipeline transition. Only the post-creation statuses are
// handled here; the initial 'routed' event is already recorded by routeRequest
// inside routeRequest. Loop safety: the recorder writes a requestEvent
// (a DIFFERENT concept), so it cannot re-trigger this node.updated automation.
// A status whitelist in recordTransition ensures we only record meaningful
// pipeline transitions and silently ignore unrelated field updates (e.g. priority
// bumps that leave status unchanged or land on a status we don't map).

use forge.logic.{ recordTransition, routeRequest }

@enabled
@trigger(event="node.created", concept="v1:forge:request", partition="*")
@description("On submission of a v1:forge:request, route it to its next approval-pipeline state by the submitter's role (owner fast-track / developer -> needs_approval / non-developer -> needs_validation) and record a 'routed' audit event.")
automation routeRequest {
  step run {
    logic routeRequest { event: event }
  }
}

@enabled
@trigger(event="node.updated", concept="v1:forge:request", partition="*")
@description("On every v1:forge:request status transition (validate / approve / changes-requested / reject), append exactly one v1:forge:requestEvent with the derived kind, fromStatus (event.oldStatus), and toStatus (event.payload.status). Silently skips updates that do not change status or land on an unrecognised status. No loop risk: the recorder writes a requestEvent (a different concept) so it cannot re-fire this automation.")
automation recordTransition {
  step run {
    logic recordTransition { event: event }
  }
}
