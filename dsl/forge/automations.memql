// automations.memql
//
// Event-driven orchestration for the `forge` namespace.
//
// routeRequest -- fires on v1:forge:request node.created and routes the new
// request to its next pipeline state by submitter role, then records a 'routed'
// audit event. recordTransition -- fires on node.updated and appends one
// v1:forge:requestEvent per recognised status transition.
//
// P1 (#2368, epic #2353): both automations are DECIDE -> SWITCH -> PERSIST --
// the deployment-bundle reference shape. The role/status POLICY lives in the
// two pure logics (dsl/forge/logic.memql: requestRouteStatus /
// transitionEventKind); each automation's decide step calls its logic with
// typed event args (G5 bare fields, punned) and a switch on decide.result
// dispatches the single persist. The former shape -- one if-gated persist step
// per role/status value, policy inline in orchestration -- predated the
// decide->persist read fixes (#2271 / #2274) and is retired; the callgraph
// condition-vocabulary rule (P4, #2371) keeps it from coming back.
//
// Loop safety (memql#5381): EVERY write publishes graph.node.created -- the store
// is append-only -- so routeRequest's own advanceRequest, an update on the SAME
// v1:forge:request, fires graph.node.created again as well as node.updated.
// Without a filter routeRequest re-fired on its own advance, forever, bounded
// only by the automation budget. The first-version filter is what stops it: an
// update's created event carries firstVersion false, and the static loop check
// at load (component/automations/loop_graph.go) refuses the automation without
// it. recordTransition writes v1:forge:requestEvent, a DIFFERENT concept, so it
// never re-fires anything on v1:forge:request.

/// On submission of a v1:forge:request, route it to its next approval-pipeline state by the
/// submitter's role (owner fast-track -> queued / developer -> needs_approval / non-developer ->
/// needs_validation) and record a 'routed' audit event. Fires on the request's FIRST version only
/// (firstVersion, declared below so the filter can read it), never on its own advance. Decide ->
/// switch -> persist: the role->status policy lives in logic requestRouteStatus; approvedByUserId
/// is stamped ONLY in the queued (owner fast-track) case. P1 #2368.
@trigger(event="node.created", concept="v1:forge:request", partition="*")
@filter(row => args.firstVersion == true)
automation routeRequest {
  args {
    firstVersion bool
    id any
    submitterRole any
    submitterUserId any
  }

  step decide {
    logic requestRouteStatus ( submitterRole )
  }
  step advance {
    switch steps.decide.result {
      case "queued" {
        mutation advanceRequest (
          requestId: id,
          status: "queued",
          approvedByUserId: submitterUserId
        )
      }
      default {
        mutation advanceRequest (
          requestId: id,
          status: steps.decide.result
        )
      }
    }
  }
  step persistRouted {
    mutation recordRequestEvent (
      requestId: id,
      kind: "routed",
      fromStatus: "submitted",
      note: "routed by submitter role"
    )
  }
}

/// On every v1:forge:request status transition (validate / approve / changes-requested / reject),
/// append exactly one v1:forge:requestEvent with the derived kind, fromStatus, and toStatus. The
/// status->kind vocabulary lives in logic transitionEventKind, which returns empty -- record
/// NOTHING -- for an unrecognised status and for updates that do not change status (the oldStatus
/// == status skip the former shape claimed but never checked). No loop risk: the recorder writes a
/// requestEvent (a different concept) so it cannot re-fire this automation. P1 #2368.
@trigger(event="node.updated", concept="v1:forge:request", partition="*")
automation recordTransition {
  args {
    id any
    oldStatus any
    status any
  }

  step decide {
    logic transitionEventKind ( status, oldStatus )
  }
  step persist {
    switch steps.decide.result {
      case "" { }
      default {
        mutation recordRequestEvent (
          requestId: id,
          kind: steps.decide.result,
          fromStatus: oldStatus,
          toStatus: status
        )
      }
    }
  }
}
