// logic.memql
//
// Orchestration logic for the `forge` namespace.
//
// routeRequest -- the role-based router. Fired by the routeRequest
// automation when a v1:forge:request is created (status 'submitted'), it sets
// the next pipeline state from the submitter's role:
//
//   owner          -> queued       (fast-track: self-approved, ready to
//                                    implement; auto-execute/deploy lands when
//                                    the actions substrate is wired)
//   admin / writer -> needs_approval (a developer's own report skips
//                                    first-line validation)
//   reader         -> needs_validation (a non-developer's request must be
//                                    validated by a developer, then approved)
//
// The three guards are mutually exclusive, so exactly one transition fires.
// Each `if cond { mutation }` only runs its side effect when the guard holds
// (same pattern as data.conflictDetection's guarded publishEvent).
//
// No loop risk: the trigger is node.created; advanceRequest is an
// update (node.updated), which does not re-fire this automation.
//
// The mentoring touch for non-owners (Claude teaches the submitter about what
// they're looking at) is driven client-side via the forge prompts + the
// submitRequest tool description; a server-side `mentored` event is recorded
// when that happens. (Prompts land in the next slice.)

use forge.mutations.{ attachToRequest }
use forge.queries.{ requestById }

// ---------------------------------------------------------------------------
// recordTransition -- append one requestEvent per post-creation pipeline
// transition. Called by the recordTransition node.updated automation.
//
// Status → kind mapping (the canonical pipeline edges after routing):
//   needs_approval      -> "validated"          (developer validated the request)
//   queued              -> "approved"            (owner approved; ready to implement)
//   changes_requested   -> "changes_requested"   (reviewer sent it back)
//   rejected            -> "rejected"            (terminal rejection)
//
// Status values NOT handled here (handled elsewhere or terminal with no event):
//   submitted           -> initial insert; 'routed' is recorded by routeRequest
//   needs_validation    -> the routeRequest automation records 'routed' already
//   validated           -> intermediate state set by validateRequest
//                         before the approval hop; no standalone event kind;
//                         mapped via the needs_approval transition above
//
// Loop guard (two layers):
//   1. This automation writes v1:forge:requestEvent (a DIFFERENT concept),
//      so recordRequestEvent never fires graph.node.updated on the
//      v1:forge:request concept -- the trigger cannot re-fire.
//   2. The status whitelist below means an update that changes only a non-status
//      field (e.g. priority bump) is caught by the empty-kind guard and returns
//      early with no write. The `if kind != "" { ... }` guard is the single
//      re-entry / double-record fence.
//
// Prior-status availability: the engine publishes graph.node.updated with
// `event.oldStatus` set to the prior row's `status` field (#1158 / executor_mutation.go).
// `args.event.oldStatus` is therefore the fromStatus for the transition;
// `args.event.payload.status` is the toStatus (the new status after the update).
// ---------------------------------------------------------------------------

@enabled
@description("PURE decision: project the routing inputs (requestId + submitterRole + submitterUserId) the routeRequest automation needs to advance a newly-submitted v1:forge:request by role (owner -> queued; developer -> needs_approval; non-developer -> needs_validation) and record the 'routed' audit event. The WRITES (advanceRequest + recordRequestEvent) happen in the routeRequest automation's persist steps (ADR §2.1 single-writer). #2235.")
logic routeRequest {
  args {
    event  object  @required
  }
  body {
    // Pure projection -- the role-conditional advanceRequest and the
    // unconditional 'routed' recordRequestEvent moved to the automation's
    // persist steps. requestId is the canonical node id (advanceRequest
    // updates by it; recordRequestEvent normalizes via shortId()).
    return { requestId: args.event.payload.id, submitterRole: coalesce(args.event.payload.submitterRole, ""), submitterUserId: coalesce(args.event.payload.submitterUserId, "") }
  }
}

@enabled
@description("PURE decision: project the transition inputs (requestId + fromStatus + toStatus) the recordTransition automation needs to append exactly one v1:forge:requestEvent for the four post-creation pipeline transitions (needs_approval -> validated / queued -> approved / changes_requested / rejected). Each persist step is mutually exclusive; at most one fires per invocation. The WRITE (recordRequestEvent) happens in the recordTransition automation's persist steps (ADR §2.1 single-writer). #2235.")
logic recordTransition {
  args {
    event  object  @required
  }
  body {
    // Pure projection -- the four mutually-exclusive recordRequestEvent
    // writes moved to the automation's per-status persist steps, each
    // guarding on toStatus so exactly one fires on a recognised status and
    // the rest are no-ops. Mapping (toStatus -> kind):
    //   needs_approval    -> "validated"          (developer validated the request)
    //   queued            -> "approved"           (owner approved; ready to implement)
    //   changes_requested -> "changes_requested"  (reviewer sent it back)
    //   rejected          -> "rejected"           (terminal rejection)
    // Statuses NOT mapped: submitted / needs_validation (routeRequest records
    // "routed"); validated (intermediate, no standalone kind).
    //
    // Prior-status availability: the engine publishes graph.node.updated with
    // event.oldStatus = the prior row's status (#1158); it is the fromStatus.
    return { requestId: coalesce(args.event.payload.id, ""), fromStatus: coalesce(args.event.oldStatus, ""), toStatus: coalesce(args.event.payload.status, "") }
  }
}

// appendAttachmentToRequest -- read-merge-append helper for the
// forgeAttachToRequest MCP tool. MCP tool args cannot be []string today, so the
// tool takes a single attachmentId (scalar). This logic function fetches the
// current request row, appends the new id to the existing attachmentIds array
// via the DSL append() function (available in the step evaluator), and writes
// the full updated array via the attachToRequest mutation. (The logic carries a
// distinct name from the mutation it wraps -- C6/memql#2036 de-prefixing would
// otherwise collide logicAttachToRequest with mutationAttachToRequest.)
//
// Sequential attaches APPEND without clobbering: append() reads the existing
// step-result array (`existing.First().payload.attachmentIds`) and adds the new
// id, so calling this N times yields the N ids in order. On the FIRST attach the
// row has no attachmentIds yet, so the read resolves to an absent array and
// append() starts fresh with the single id. (#1848 fixed the prior corruption
// where the unresolved read leaked its raw source text as a literal array
// element; see component/language/compiler stepMethodAccessorPath +
// component/automations/steps evaluateAppend.)
//
// Not deduped: re-attaching an already-present id appends a duplicate (an in-DSL
// array-membership guard isn't supported yet), so callers should avoid attaching
// the same id twice.
@enabled
@description("Append one v1:common:attachment id to a v1:forge:request's attachmentIds array. Fetches the current row, appends the new id, writes the full updated array via the attachToRequest mutation. Backed by the step evaluator's append() -- the closest native append the DSL supports without a Go builtin.")
logic appendAttachmentToRequest {
  args {
    requestId     string  @required
    attachmentId  string  @required
  }
  body {
    existing := requestById({ requestId: args.requestId })
    attach   := attachToRequest({ requestId: args.requestId, attachmentIds: append(existing.First().payload.attachmentIds, args.attachmentId) })
    return args.requestId
  }
}

// recordMentoring (RETIRED, #2235) -- the forgeRecordMentoring tool's
// 'mentored'-event write was a §2.1 single-writer violation (a logic that
// wrote inline). It is replaced by the thin `recordMentoredEvent` mutation in
// mutations.memql (kind="mentored" injected in its insert body), which the
// forgeRecordMentoring tool now targets directly -- a pure single-aggregate
// write with no wrapper logic.
