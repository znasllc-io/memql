// logic.memql
//
// Orchestration logic for the `forge` namespace.
//
// logicRouteRequest -- the role-based router. Fired by the routeRequest
// automation when a v1:forge:request is created (status 'submitted'), it sets
// the next pipeline state from the submitter's role:
//
//   owner          -> queued       (fast-track: self-approved, ready to
//                                    implement; auto-execute/deploy lands when
//                                    the actions substrate is wired)
//   admin / writer -> needs_approval (a developer's own report skips
//                                    first-line validation)
//   reader         -> needs_validation (a non-developer's request must be
//                                    validated by a developer, then approved)
//
// The three guards are mutually exclusive, so exactly one transition fires.
// Each `if cond { mutation }` only runs its side effect when the guard holds
// (same pattern as data.logicConflictDetection's guarded publishEvent).
//
// No loop risk: the trigger is node.created; mutationAdvanceRequest is an
// update (node.updated), which does not re-fire this automation.
//
// The mentoring touch for non-owners (Claude teaches the submitter about what
// they're looking at) is driven client-side via the forge prompts + the
// submitRequest tool description; a server-side `mentored` event is recorded
// when that happens. (Prompts land in the next slice.)

use forge.mutations.{ mutationAdvanceRequest, mutationAttachToRequest, mutationRecordRequestEvent }
use forge.queries.{ queryRequestById }

// ---------------------------------------------------------------------------
// logicRecordTransition -- append one requestEvent per post-creation pipeline
// transition. Called by the recordTransition node.updated automation.
//
// Status → kind mapping (the canonical pipeline edges after routing):
//   needs_approval      -> "validated"          (developer validated the request)
//   queued              -> "approved"            (owner approved; ready to implement)
//   changes_requested   -> "changes_requested"   (reviewer sent it back)
//   rejected            -> "rejected"            (terminal rejection)
//
// Status values NOT handled here (handled elsewhere or terminal with no event):
//   submitted           -> initial insert; 'routed' is recorded by routeRequest
//   needs_validation    -> the routeRequest automation records 'routed' already
//   validated           -> intermediate state set by mutationValidateRequest
//                         before the approval hop; no standalone event kind;
//                         mapped via the needs_approval transition above
//
// Loop guard (two layers):
//   1. This automation writes v1:forge:requestEvent (a DIFFERENT concept),
//      so mutationRecordRequestEvent never fires graph.node.updated on the
//      v1:forge:request concept -- the trigger cannot re-fire.
//   2. The status whitelist below means an update that changes only a non-status
//      field (e.g. priority bump) is caught by the empty-kind guard and returns
//      early with no write. The `if kind != "" { ... }` guard is the single
//      re-entry / double-record fence.
//
// Prior-status availability: the engine publishes graph.node.updated with
// `event.oldStatus` set to the prior row's `status` field (#1158 / executor_mutation.go).
// `args.event.oldStatus` is therefore the fromStatus for the transition;
// `args.event.payload.status` is the toStatus (the new status after the update).
// ---------------------------------------------------------------------------

@enabled
@description("Route a newly-submitted v1:forge:request to its next pipeline state by submitter role (owner -> queued; developer -> needs_approval; non-developer -> needs_validation). Records a 'routed' audit event.")
logic logicRouteRequest {
  args {
    event  object  @required
  }
  body {
    fastTrack := if args.event.payload.submitterRole == "owner" {
      mutationAdvanceRequest({ requestId: args.event.payload.id, status: "queued", approvedByUserId: args.event.payload.submitterUserId })
    }
    toApproval := if args.event.payload.submitterRole == "admin" || args.event.payload.submitterRole == "writer" {
      mutationAdvanceRequest({ requestId: args.event.payload.id, status: "needs_approval" })
    }
    toValidation := if args.event.payload.submitterRole == "reader" {
      mutationAdvanceRequest({ requestId: args.event.payload.id, status: "needs_validation" })
    }
    recordRouted := mutationRecordRequestEvent({ requestId: args.event.payload.id, kind: "routed", fromStatus: "submitted", note: "routed by submitter role" })
    return args.event.payload.id
  }
}

@enabled
@description("On v1:forge:request node.updated: append exactly one v1:forge:requestEvent for the four post-creation pipeline transitions (validated / approved / changes_requested / rejected). Each guard is mutually exclusive; at most one fires per invocation. Returns early (no write) for unrecognised statuses.")
logic logicRecordTransition {
  args {
    event  object  @required
  }
  body {
    toStatus   := coalesce(args.event.payload.status, "")
    fromStatus := coalesce(args.event.oldStatus, "")
    requestId  := coalesce(args.event.payload.id, "")

    // Four mutually exclusive guards -- exactly one fires on a recognised
    // status; the rest are no-ops (condition evaluates false, step skipped).
    // MemQL logic bodies use := for every declaration; bodies inside `if`
    // blocks must be function calls (not string literals), so each mapped
    // status gets its own mutationRecordRequestEvent call.
    //
    // Mapping (toStatus -> kind):
    //   needs_approval    -> "validated"          (developer validated the request)
    //   queued            -> "approved"           (owner approved; ready to implement)
    //   changes_requested -> "changes_requested"  (reviewer sent it back)
    //   rejected          -> "rejected"           (terminal rejection)
    //
    // Statuses NOT mapped (handled elsewhere or no standalone event kind):
    //   submitted / needs_validation -> routeRequest records "routed"
    //   validated (intermediate)     -> no standalone kind; next hop is needs_approval
    //
    // Loop guard (two layers):
    //   1. mutationRecordRequestEvent writes v1:forge:requestEvent (a DIFFERENT
    //      concept), so it NEVER triggers graph.node.updated on v1:forge:request.
    //   2. The per-status guards only fire on the four whitelisted values, so
    //      updates that change only non-status fields are always silent.
    evtValidated        := if toStatus == "needs_approval" {
      mutationRecordRequestEvent({ requestId: requestId, kind: "validated",         fromStatus: fromStatus, toStatus: toStatus })
    }
    evtApproved         := if toStatus == "queued" {
      mutationRecordRequestEvent({ requestId: requestId, kind: "approved",          fromStatus: fromStatus, toStatus: toStatus })
    }
    evtChangesRequested := if toStatus == "changes_requested" {
      mutationRecordRequestEvent({ requestId: requestId, kind: "changes_requested", fromStatus: fromStatus, toStatus: toStatus })
    }
    evtRejected         := if toStatus == "rejected" {
      mutationRecordRequestEvent({ requestId: requestId, kind: "rejected",          fromStatus: fromStatus, toStatus: toStatus })
    }
    return toStatus
  }
}

// logicAttachToRequest -- read-merge-append helper for the forgeAttachToRequest
// MCP tool. MCP tool args cannot be []string today, so the tool takes a single
// attachmentId (scalar). This logic function fetches the current request row,
// appends the new id to the existing attachmentIds array via the DSL append()
// function (available in the step evaluator), and writes the full updated array
// via mutationAttachToRequest. Idempotent: if the id is already present the
// append() still fires, so callers should not call this twice for the same id.
// (A dedup guard would require in-DSL array-membership checks not yet supported.)
@enabled
@description("Append one v1:common:attachment id to a v1:forge:request's attachmentIds array. Fetches the current row, appends the new id, writes the full updated array via mutationAttachToRequest. Backed by the step evaluator's append() -- the closest native append the DSL supports without a Go builtin.")
logic logicAttachToRequest {
  args {
    requestId     string  @required
    attachmentId  string  @required
  }
  body {
    existing    := queryRequestById({ requestId: args.requestId })
    updatedIds  := append(existing.First().payload.attachmentIds, args.attachmentId)
    attach      := mutationAttachToRequest({ requestId: args.requestId, attachmentIds: updatedIds })
    return args.requestId
  }
}
