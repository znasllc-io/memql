// shapes.memql
//
// Read projections in the `forge` namespace.

use forge.concepts.{ project, request, requestEvent }

@row
@description("Full v1:forge:project projection.")
shape project projectFull {
  row.id
  payload.slug
  payload.name
  payload.targetApp
  payload.repo
  payload.description
  payload.status
  payload.createdByUserId
  row.createdAt
}

@row
@description("Full v1:forge:request projection: every field a queue/detail view or the routing logic needs.")
shape request requestFull {
  row.id
  payload.projectId
  payload.requestType
  payload.title
  payload.body
  payload.submitterUserId
  payload.submitterRole
  payload.attachmentIds
  payload.priority
  payload.status
  payload.targetEnv
  payload.validatedByUserId
  payload.approvedByUserId
  payload.resolution
  row.createdAt
}

@row
@description("Full v1:forge:requestEvent projection: the audit-trail row.")
shape requestEvent requestEventFull {
  row.id
  payload.requestId
  payload.kind
  payload.actorUserId
  payload.actorRole
  payload.fromStatus
  payload.toStatus
  payload.note
  row.createdAt
}
