// prompts.memql
//
// Forge-namespace prompt declarations. Bodies live in prompts/<name>.tmpl.
//
// forgeMentoringExplanation is the MENTORING PASS: given a non-owner's
// request context (project, type, title, body snippet), it produces a short
// friendly explanation of the area they are touching so they learn while they
// file. Claude calls this after forgeSubmitRequest succeeds for any submitter
// whose role is NOT "owner", then records the result via forgeRecordMentoring.

@defaultProvider("chat54Mini")
@templateFile("prompts/forgeMentoringExplanation.tmpl")
@description("Generate a short (3-6 sentence) mentoring explanation for a non-owner forge submitter. Explains the area their request touches -- one key design decision or trade-off, and one concrete tip for filing better requests in this area in the future. Called by Claude immediately after forgeSubmitRequest for reader/writer/admin submitters; the resulting text is shown to the user and then recorded as a 'mentored' requestEvent via forgeRecordMentoring.")
prompt forgeMentoringExplanation {
  projectSlug   string  @required @description("Short slug of the project the request targets (e.g. 'memql', 'acme-app'). Used to ground the explanation in the right codebase/context.")
  requestType   string  @required @description("Request kind: bug / feature / chore / question / timeOff / checkIn. Shapes the framing (a bug explanation differs from a feature one).")
  requestTitle  string  @required @description("The request title the submitter gave. The primary anchor for the mentoring explanation -- what area the model should explain.")
  requestBody   string  @required @description("The request body (full description). Provides detail the model needs to pinpoint the exact area being touched rather than giving a generic explanation.")
}
