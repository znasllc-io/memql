// queries.memql
//
// Read paths in the `forge` namespace.
//
// Gating: "my requests" + "request by id" are open to any authenticated team
// member (submitters read their own work). The validation + approval QUEUES
// are gated to developers/owners via the forge role traits, so a
// non-developer can never list other people's requests to act on them.
//
// ---------------------------------------------------------------------------
// Multi-project scoping & partition isolation -- design notes
// ---------------------------------------------------------------------------
//
// PROJECT SCOPING (within a partition / tenant)
//
//   A v1:forge:project row represents one codebase/client engagement.
//   v1:forge:request.projectId binds each request to exactly one project.
//   Queries that filter on projectId (projectRequests) therefore
//   produce a project-scoped result set:
//
//     requests(A) ∩ requests(B) = ∅    for distinct projectIds A, B
//
//   Claude resolves a human-supplied slug ("memql", "acme-app") to a
//   projectId via projectBySlug, then passes that id to
//   projectRequests, forgeSubmitRequest, etc. The slug is stable and
//   human-readable; the id is the row-stable FK. The two-step resolution
//   means Claude never guesses UUIDs and never conflates projects.
//
// CROSS-CLIENT ISOLATION (partition boundary)
//
//   The partition is the hard tenant-isolation boundary in memQL. Every row
//   carries a `partition` column; the engine stamps it from the caller's
//   auth envelope and appends `WHERE partition = $envelope` to every query
//   automatically. There is NO DSL filter needed on the client side -- the
//   engine enforces it unconditionally.
//
//   Forge maps onto this model as follows:
//
//     - One partition per client/company.  ClientA and ClientB each have their
//       own partition id (typically provisioned when the tenant is onboarded).
//     - All v1:forge:project and v1:forge:request rows for ClientA land in
//       ClientA's partition; the engine's WHERE clause guarantees ClientB's
//       session can never read them and vice-versa.
//     - Within a single client's partition, project rows further carve out
//       per-project silos at the application layer via projectId filtering.
//
//   Summary of the isolation hierarchy:
//
//     partition (engine-enforced)
//       └── project row (application-enforced via projectId FK on request)
//             └── request rows (filtered by projectRequests)
//
//   To add a new client: provision a new partition (identity admin tool),
//   onboard users into it, then call forgeRegisterProject to seed their
//   projects. The forge DSL requires NO code changes for a new client --
//   partition isolation is structural and automatic.

use common.traits.{ statusIsActive }

/// Resolve a v1:forge:project by id.
query project projectById {
  args {
    projectId  string!
  }
  filter  id == args.projectId
  shape   projectFull
}

/// List active v1:forge:project rows.
@unbounded("active forge projects -- a small bounded catalog consumed whole")
query project activeProjects {
  filter  statusIsActive
  shape   projectFull
}

/// Resolve a v1:forge:project by its stable slug (e.g. 'memql', 'acme-app'). Claude uses this to go
/// from a human-supplied name to a projectId before submitting a request or filtering requests.
/// Returns at most one row because slugs are unique within a partition.
@unbounded("forge project by unique slug -- bounded to a single row")
query project projectBySlug {
  args {
    slug  string!
  }
  filter  slug == args.slug
  shape   projectFull
}

/// List the caller's own submitted requests, newest-first. Open to any team member.
@actor
query request myRequests {
  filter  submitterUserId == actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   requestFull
}

/// Resolve a single v1:forge:request by id (detail view).
query request requestById {
  args {
    requestId  string!
  }
  filter  id == args.requestId
  shape   requestFull
}

/// List requests by project, newest-first.
query request projectRequests {
  args {
    projectId  string!
  }
  filter  projectId == args.projectId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   requestFull
}

// ----- developer/owner-gated queues -----

/// The validation queue: requests awaiting first-line developer validation. Developer/owner only
/// (forgeDeveloper).
query request validationQueue {
  filter  status == "needs_validation" && forgeDeveloper
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   requestFull
}

/// The approval queue: validated requests awaiting owner approval. Owner only (forgeApprover).
query request approvalQueue {
  filter  status == "needs_approval" && forgeApprover
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   requestFull
}

/// The full audit trail for a request, newest-first.
query requestEvent requestEvents {
  args {
    requestId  string!
  }
  filter  requestId == args.requestId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   requestEventFull
}
