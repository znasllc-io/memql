// mutations.memql
//
// Write paths in the `forge` namespace. ownerUserId-style stamping: the
// submitter/actor identity + role are stamped server-side from the auth
// context (actor.userId / actor.role) so a caller cannot submit, validate,
// or approve as someone else.
//
// State-machine note: these mutations express the transitions declaratively
// (update read-merges the prior row). The ROLE GUARD on a transition (e.g.
// "only an owner may set status=approved") is NOT enforced here -- the DSL
// cannot gate a transition on actor.role. That guard belongs in an engine
// pre-insert hook (mirroring component/memql/harness_step_validation.go) and
// is tracked as a follow-up. The query-layer gating (traits.memql) keeps
// non-developers from ever reaching the queues in the first place.

use forge.concepts.{ project, request, requestEvent }

// ---------------------------------------------------------------------------
// createProject -- register a project forge develops against.
// ---------------------------------------------------------------------------
@enabled
@description("Register a v1:forge:project. createdByUserId is stamped from actor.userId.")
mutate project createProject {
  args {
    projectId    string
    slug         string  @required
    name         string  @required
    targetApp    string
    repo         string
    description  string
  }
  insert {
    id: args.projectId
    args.slug
    args.name
    args.targetApp
    args.repo
    args.description
    status: "active"
    createdByUserId: actor.userId
    provenanceMutation: "createProject"
  }
}

// ---------------------------------------------------------------------------
// createRequest -- submit a request. submitterUserId + submitterRole
// are stamped from the auth context; status always lands 'submitted' and the
// routeRequest automation (fired by node.created) sets the role-based next
// state. Returns the created request.
// ---------------------------------------------------------------------------
@enabled
@description("Submit a v1:forge:request. submitterUserId + submitterRole are stamped server-side from actor (no spoofing). status lands 'submitted'; the routeRequest automation routes it by role.")
mutate request createRequest {
  args {
    requestId      string
    projectId      string    @required
    requestType    string
    title          string    @required
    body           string    @required
    attachmentIds  []string
    priority       string
  }
  insert {
    id: args.requestId
    args.projectId
    requestType: coalesce(args.requestType, "bug")
    args.title
    args.body
    submitterUserId: actor.userId
    submitterRole: actor.role
    args.attachmentIds
    priority: coalesce(args.priority, "normal")
    status: "submitted"
    targetEnv: "staging"
    provenanceMutation: "createRequest"
  }
}

// ---------------------------------------------------------------------------
// advanceRequest -- the generic transition. update read-merges so
// untouched fields (body, submitter, attachments) survive. Callers pass the
// target status and the relevant actor stamp (validatedByUserId /
// approvedByUserId). Pair every call with recordRequestEvent.
// ---------------------------------------------------------------------------
@enabled
@description("Transition a v1:forge:request to a new status (the approval pipeline edges). update read-merges the prior row. The role guard belongs in an engine pre-insert hook (follow-up).")
mutate request advanceRequest {
  args {
    requestId          string  @required
    status             string  @required
    validatedByUserId  string
    approvedByUserId   string
    resolution         string
  }
  update {
    id: args.requestId
    args.status
    args.validatedByUserId
    args.approvedByUserId
    args.resolution
    provenanceMutation: "advanceRequest"
  }
}

// ---------------------------------------------------------------------------
// Purpose-built transitions -- stamp the acting user from the auth context so
// the tool surface (one handler per tool) can't be spoofed. Each is an update
// (read-merges the prior row). The matching requestEvent is recorded
// separately (see the follow-up note: a node.updated -> recordTransition
// automation will append the audit event automatically).
// ---------------------------------------------------------------------------

@enabled
@description("Validate a v1:forge:request (developer action): set status 'needs_approval' and stamp validatedByUserId from actor.userId.")
mutate request validateRequest {
  args {
    requestId  string  @required
  }
  update {
    id: args.requestId
    status: "needs_approval"
    validatedByUserId: actor.userId
    provenanceMutation: "validateRequest"
  }
}

@enabled
@description("Approve a v1:forge:request (owner action): set status 'queued' (ready to implement) and stamp approvedByUserId from actor.userId.")
mutate request approveRequest {
  args {
    requestId  string  @required
  }
  update {
    id: args.requestId
    status: "queued"
    approvedByUserId: actor.userId
    provenanceMutation: "approveRequest"
  }
}

@enabled
@description("Send a v1:forge:request back for changes: set status 'changes_requested' with a reason.")
mutate request requestChanges {
  args {
    requestId  string  @required
    resolution string  @required
  }
  update {
    id: args.requestId
    status: "changes_requested"
    args.resolution
    provenanceMutation: "requestChanges"
  }
}

// ---------------------------------------------------------------------------
// attachToRequest -- link one v1:common:attachment to a request by
// writing the full (updated) attachmentIds array. The mutation DSL update
// block replaces array fields on write; it cannot natively append a single
// element. Callers must read-modify-write: fetch the current attachmentIds
// via forgeRequestById (or requestById), append the new id client-side,
// and pass the resulting array here. This mirrors the
// recordLegalAcceptance pattern -- the closest workable approach
// until the DSL gains a native arrayAppend expression. update read-merges
// all other request fields (body, status, submitter, priority, etc.) so
// they survive unchanged.
// ---------------------------------------------------------------------------
@enabled
@description("Link a v1:common:attachment to a v1:forge:request by replacing its attachmentIds array. Caller must read-modify-write: fetch the existing attachmentIds, append the new id, pass the full array here. update read-merges all other request fields.")
mutate request attachToRequest {
  args {
    requestId      string    @required
    attachmentIds  []string  @required
  }
  update {
    id: args.requestId
    args.attachmentIds
    provenanceMutation: "attachToRequest"
  }
}

// ---------------------------------------------------------------------------
// recordRequestEvent -- append an audit/pipeline event. actorUserId +
// actorRole stamped from the auth context.
//
// requestId is normalized to the SHORT id form via shortId() (#1859). The two
// caller paths feed two id shapes:
//   - automation path (routeRequest / recordTransition) passes
//     args.event.payload.id, which is the CANONICAL node id
//     (v1:forge:request:r-...) of the created/updated request row;
//   - tool path (recordMentoredEvent) passes the SHORT tool arg (r-...).
// Without normalization the audit trail splits across both forms and
// forgeRequestHistory(<shortId>) finds only the tool-written events.
// shortId() strips the `v1:forge:request:` concept prefix; it is idempotent
// (a no-op on an already-short id), so the tool path is unaffected. This single
// write-side point keeps every requestEvent.requestId in one short form.
// ---------------------------------------------------------------------------
@enabled
@description("Append a v1:forge:requestEvent (the time-series audit trail). actorUserId + actorRole stamped from actor. requestId is normalized to the short id form (shortId()) so the trail keys consistently whether the caller passes a canonical node id (automation path) or a bare short id (tool path) -- #1859.")
mutate requestEvent recordRequestEvent {
  args {
    eventId     string
    requestId   string  @required
    kind        string  @required
    fromStatus  string
    toStatus    string
    note        string
  }
  insert {
    id: args.eventId
    requestId: shortId(args.requestId)
    args.kind
    actorUserId: actor.userId
    actorRole: actor.role
    args.fromStatus
    args.toStatus
    args.note
    provenanceMutation: "recordRequestEvent"
  }
}

// ---------------------------------------------------------------------------
// recordMentoredEvent -- the forgeRecordMentoring tool's direct single writer.
// The tool surface intentionally does NOT expose `kind` (it is always
// "mentored"), so it cannot point straight at recordRequestEvent (which
// requires kind). This thin mutation injects the constant kind="mentored" in
// its insert body and forwards the caller's eventId / requestId / note,
// keeping the tool path a pure single-aggregate write. Replaces the former
// recordMentoring wrapper logic (which performed the write inline -- the
// §2.1 single-writer violation). #2235.
//
// requestId is normalized via shortId() exactly like recordRequestEvent so the
// tool-written 'mentored' events key under the same short id form as the
// automation-written audit events (#1859).
// ---------------------------------------------------------------------------
@enabled
@description("Append a 'mentored' v1:forge:requestEvent after a non-owner submitter was taught about the area they touched. Injects kind='mentored' and forwards eventId / requestId / note. actorUserId + actorRole stamped from actor; requestId normalized to short form (shortId(), #1859). The forgeRecordMentoring tool's direct single writer (replaces the recordMentoring logic -- #2235).")
mutate requestEvent recordMentoredEvent {
  args {
    eventId    string
    requestId  string  @required
    note       string  @required
  }
  insert {
    id: args.eventId
    requestId: shortId(args.requestId)
    kind: "mentored"
    actorUserId: actor.userId
    actorRole: actor.role
    args.note
    provenanceMutation: "recordMentoredEvent"
  }
}
