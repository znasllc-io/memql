// shapes.memql
//
// Reusable projections in the `actions` namespace (epic #1734). Phase 0
// (#1735) ships candidateFull -- the read projection over a captured trace.

@row
@description("Full v1:actions:candidate projection: every field the action-library browse/recall surfaces need to inspect a captured trace (#1735).")
shape candidate candidateFull {
  row.id
  ownerUserId
  planId
  stepId
  status
  calls
  resourceEdges
  callCount
  row.createdAt
}

@row
@description("Full v1:actions:action projection: the fields the harness replay path needs to resolve + replay an action (Phase 1 #1736).")
shape action actionFull {
  row.id
  ownerUserId
  slug
  kind
  intent
  capability
  sideEffectClass
  inputFingerprint
  calls
  resourceEdges
  paramBindings
  templateFingerprint
  steps
  recordedResult
  resultFingerprint
  recordedSurface
  reliability
  reinforceCount
  version
  status
  row.createdAt
}

@row
@description("Full v1:actions:surface projection: the fields the resolver needs to bind a capability to a surface (Phase 2 #1737).")
shape surface surfaceFull {
  row.id
  ownerUserId
  slug
  kind
  machineId
  capabilities
  available
  priority
  status
  lastSeen
  row.createdAt
}
