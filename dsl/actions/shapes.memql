// shapes.memql
//
// Reusable projections in the `actions` namespace (epic #1734). Phase 0
// (#1735) ships candidateFull -- the read projection over a captured trace.

/// Full v1:actions:candidate projection: every field the action-library browse/recall surfaces need
/// to inspect a captured trace (#1735).
@row
shape candidate candidateFull {
  row.id
  ownerUserId
  planId
  stepId
  status
  calls
  resourceEdges
  callCount
  row.createdAt
}

/// Full v1:actions:action projection: the fields the harness replay path needs to resolve + replay
/// an action (Phase 1 #1736).
@row
shape action actionFull {
  row.id
  ownerUserId
  slug
  kind
  intent
  capability
  sideEffectClass
  inputFingerprint
  calls
  resourceEdges
  paramBindings
  templateFingerprint
  steps
  recordedResult
  resultFingerprint
  recordedSurface
  reliability
  reinforceCount
  version
  status
  row.createdAt
}

/// Full v1:actions:surface projection: the fields the resolver needs to bind a capability to a
/// surface (Phase 2 #1737).
@row
shape surface surfaceFull {
  row.id
  ownerUserId
  slug
  kind
  machineId
  capabilities
  available
  priority
  status
  lastSeen
  row.createdAt
}
