// concepts.memql
//
// The `actions` namespace -- the action library (epic #1734): a growing,
// pgvector-indexed library of reusable, replayable actions the planner
// composes plans from and the agent loop replays without an LLM.
//
// Phase 0 (#1735, trace capture) lands ONE concept: `candidate`. It is the
// raw material every later phase builds on -- a captured, provenance-traced
// record of the concrete capability sequence an LLM step performed. No
// replay, no resolver, no trust ladder yet (those are Phases 1-4); this
// phase only records what happened, with enough provenance that a later
// phase can mint a parameterized action from it.
//
// Why a candidate is a MemoryNode: it inherits time-ordered history,
// per-row authz (ownerUserId), provenance (createdBy + provenanceMutation),
// and event emission for free -- the same substrate the harness spine
// (#582) rides.
//
// Authorization (owned tier): ownerUserId is the per-row authz key, stamped
// from actor.userId by the recording mutation; the read path filters on
// payload.ownerUserId == actor.userId.

use harness.concepts.{ plan, step }
use identity.concepts.{ user }

/// A captured trace of the concrete capability sequence an LLM step performed, with value +
/// resource provenance per call (#1735). Minted as status='candidate' on first run; a later phase
/// graduates it into a library action. This is the foundation record of the action library (epic
/// #1734) -- no replay yet.
@displayCard(primary="stepId", secondary="status", tertiary="ownerUserId", status="status")
concept candidate {
  ownerUserId   string!  @description("v1:identity:user.id of the owner. The per-row authz key (owned tier), stamped from actor.userId by recordActionCandidate.")
  planId        string!  @description("v1:harness:plan.id the trace was captured under.")
  stepId        string!  @description("v1:harness:step.id whose dispatch produced this trace.")
  status        enum("candidate", "promoted", "discarded")!  @default("candidate")  @description("Trust-ladder state. candidate = captured, not yet a library action; promoted = graduated into a library action (Phase 4); discarded = rejected or superseded.")
  calls         []object!  @description("Ordered traced capability calls, in execution order. Each entry: {index, capability, isError, args:[{name, value, source:{kind, ref, fragment}}]}. source.kind is one of stepInput | planInput | upstreamResult | literal -- derived by data-flow tracing (provenance, NOT synthesis): a value that traced to a witnessed source is bound; an untraceable value stays literal (we never invent a binding).")
  resourceEdges []object  @description("Resource-dependency edges: a later call reads a resource (path/handle) an earlier call referenced. Each entry: {fromCallIndex, toCallIndex, resource}. These become the world-group edges that pin coupled actions to one surface in Phase 2 (decision A).")
  callCount     int  @description("Number of captured calls (len(calls)). A convenience field for filtering trivial/empty traces.")
  provenanceMutation  string  @description("Name of the mutation that produced this candidate version (audit trail).")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="planId", target=plan, direction="outgoing")
  @relationship(type="parent", field="stepId", target=step, direction="outgoing")
}

// action -- a reusable, replayable library entry (Phase 1, #1736).
//
// Phase 1 mints a `primitive` action from a candidate trace once an LLM step
// completes: it stores the concrete capability sequence the step performed
// plus an `inputFingerprint` (a stable hash of the dispatched step input) and
// a `resultFingerprint` (a stable hash of the recorded tool results). On the
// next dispatch of a step with the SAME inputFingerprint, the harness replays
// the stored calls via ExecuteToolByName (default surface, no LLM); if the
// replay's result fingerprint matches the recorded one, the recorded result
// is returned and `reliability` is reinforced -- otherwise the harness falls
// back to the LLM. This is "literal replay keyed on input fingerprint against
// the default surface only" (the doc, Phase 1).
//
// What is deliberately NOT here yet: the capability->surface resolver and
// world groups (Phase 2 #1737), automatic parameterization + composites
// (Phase 3 #1738), and the surface-aware trust ladder that gates auto-promote
// vs confirm (Phase 4 #1739). `capability`, `recordedSurface`, `reliability`,
// `reinforceCount`, and `version` are carried now so those phases extend the
// row rather than migrate it.
/// A reusable, replayable library entry minted from a candidate trace (Phase 1, #1736). A primitive
/// stores one or more captured capability calls with literal args, keyed by inputFingerprint, and
/// replays them token-free on identical input against the default surface. Reliability rises on
/// verified replay; mismatches fall back to the LLM.
@displayCard(primary="slug", secondary="status", tertiary="ownerUserId", status="status")
concept action {
  ownerUserId       string!  @description("v1:identity:user.id of the owner. The per-row authz key (owned tier), stamped from actor.userId by mintAction.")
  slug              string!  @description("Human-readable name (e.g. the dominant capability slug). Not unique on its own; (ownerUserId, inputFingerprint) is the replay key.")
  kind              enum("primitive", "composite")!  @default("primitive")  @description("primitive = one or more captured capability calls replayed directly. composite = an ordered list of child action references (Phase 3 #1738). Phase 1 mints only primitives.")
  intent            string!  @description("Natural-language description of what the action does -- the future embedding source for retrieval (Phase 3). Phase 1 derives it from the step goal/input.")
  capability        string  @description("The abstract external capability verb the action performs (e.g. shell.exec, fs.writeFile, integration.github.tagRelease). For an AUTHORED primitive (#2218) this is THE single capability the action invokes -- bound from params via argTemplate; for a replay-capture action it is the dominant verb the capability->surface resolver consumes (Phase 2 #1737).")
  sideEffectClass   enum("read", "write", "exec")!  @default("write")  @description("Coarse risk class, used by the surface-aware trust gate in Phase 4 (#1739). Carried on the action for authoring/labelling; the AUTHORITATIVE sideEffectClass lives on the capability (ADR section 7, reconciled by the I7 capability vocabulary) so an authored or generated action cannot spoof it. Phase 1 records it (defaulting conservatively to write) but does not yet gate on it.")
  params            []object  @description("AUTHORED action (#2218, ADR section 2.3) input schema: the named, typed parameters the step args bind to. Each entry mirrors an args field: {name, type, required, description}. The argTemplate renders the concrete capability arguments from these. Empty for a replay-capture action (which re-binds via paramBindings instead).")
  argTemplate       object  @description("AUTHORED action (#2218, ADR section 2.3) capability-argument template: a flat map of {capabilityArgKey: templateString} rendered from params before the capability runs (a $params.<name> reference is substituted with the bound value). THE definition of what an authored primitive invokes. Empty for a replay-capture action (which carries literal calls instead).")
  inputFingerprint  string!  @description("Stable hash of the dispatched step input that minted this action. THE literal-replay key: a later step whose input hashes to the same value replays this action instead of calling the LLM.")
  calls             []object!  @description("Ordered capability calls to replay, in execution order. Each entry: {index, capability, args}. args are the literal recorded argument map (parameterization lands in Phase 3 #1738). Error/cache-hit calls are excluded at mint time.")
  resourceEdges     []object  @description("Resource-coupling edges carried from the candidate trace: {fromCallIndex, toCallIndex, resource}. Phase 2 (#1737) uses these to form world groups so coupled calls pin to a single surface (decision A).")
  paramBindings     []object  @description("Phase 3 (#1738) automatic parameterization. Per-call arg bindings derived from the data-flow tracer's provenance: {index, capability, bindings:[{name, kind, ref, fragment, template, fragmentValue, literal}]}. kind is stepInput (re-bind from the current step input at ref) or literal. Lets the action replay on VARYING input by re-binding witnessed params; an unbound arg stays its recorded literal.")
  templateFingerprint string  @description("Phase 3 (#1738) structural lookup key: a stable hash of the dispatched step input's KEY SET (not values). An input with the same shape matches this action and re-binds params by value -- the pre-planner parameterized-replay key, superseded by the planner's semantic (pgvector) search once wired.")
  steps             []object  @description("Phase 3 (#1738) composite body (kind=composite): an ordered list of child action references {actionId, version, argTemplate}. A composite replays by recursing into each child action. Empty for primitives.")
  recordedResult    object  @description("The step result the minting run produced (returned verbatim on a verified replay, since the LLM synthesis is not reproducible without the model).")
  resultFingerprint string  @description("Stable hash of the recorded tool results. A replay must reproduce this fingerprint to be trusted; a mismatch decays trust and falls back to the LLM.")
  recordedSurface   string  @description("Provenance only: the surface the action was captured on (Phase 1 is always the default surface). Replay re-resolves in Phase 2 (#1737); this never constrains where it runs.")
  reliability       float!  @default("0.5")  @description("Confidence in [0,1]. Rises on a verified successful replay (fingerprint match), decays on mismatch/disuse (Phase 4). Below a floor an action is deprecated and no longer offered (Phase 4 #1739).")
  reinforceCount    int!  @default("0")  @description("Number of verified successful replays observed. Bumped by reinforceAction (value computed engine-side, MemQL has no arithmetic).")
  lastReinforced    datetime  @description("When the action was last reinforced -- the decay clock for Phase 4 consolidation.")
  version           int!  @default("1")  @description("Monotonic version, bumped on every edit. Pin-by-default references and the verified upgrade migration land in Phase 5 (#1740).")
  status            enum("candidate", "active", "deprecated")!  @default("active")  @description("Trust-ladder state. Phase 1 mints directly as active (replay is fingerprint-verified, so it is safe to offer); the candidate->active->deprecated ladder with surface-aware gating lands in Phase 4 (#1739).")
  provenancePlanId  string  @description("v1:harness:plan.id of the run that minted this action.")
  provenanceStepId  string  @description("v1:harness:step.id of the run that minted this action.")
  provenanceMutation  string  @description("Name of the mutation that produced this action version (audit trail).")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="interactsWith", field="provenancePlanId", target=plan, direction="outgoing")
  @relationship(type="interactsWith", field="provenanceStepId", target=step, direction="outgoing")
}

// surface -- a registered execution backend the resolver binds to (Phase 2,
// #1737). A surface declares which abstract capabilities it serves and
// whether it is currently available; the capability->surface resolver
// (component/harness/surfaceresolver) chooses one per world group at replay
// time with the precedence explicit > policy > availability failover, and
// pins every resource-coupled action in a group to a SINGLE surface
// (decision A).
//
// Capability coverage is DATA, not a hardcoded engine table: a surface lists
// the capability verbs it serves, so new surfaces (additional computer-use
// machines, MCP servers) register without an engine change. The concrete
// capability->tool invocation binding for a given surface is carrier/operator
// supplied (the workbench/worker tools live in the carrier DSL), kept off the
// engine's identity here on purpose.
/// A registered execution surface for action replay (Phase 2, #1737): workbench /
/// computer-use:<machineId> / mcp:<server>, with its served capability verbs + current
/// availability. The resolver binds capability->surface per world group with explicit > policy >
/// availability precedence (decision A pins coupled actions to one surface).
@displayCard(primary="slug", secondary="kind", tertiary="ownerUserId", status="status")
concept surface {
  ownerUserId   string!  @description("v1:identity:user.id of the owner. Per-row authz key (owned tier); computer-use machines + workbenches are per-user. Stamped from actor.userId by registerSurface.")
  slug          string!  @description("Stable surface identifier used in bindings/policies: 'workbench', 'computer-use:<machineId>', 'mcp:<server>'. (ownerUserId, slug) is the registry key.")
  kind          enum("workbench", "computer-use", "mcp", "cockpit-runner")!  @description("Surface family. Drives the surface-aware trust gate in Phase 4 (#1739): a real-machine computer-use surface always confirms destructive replays. cockpit-runner is the control-plane runner (operator/CI) that executes deploy/control capabilities OUTSIDE the target cluster (memql#2220).")
  machineId     string  @description("For kind=computer-use: the stable machine identity (see open question in #1742 on stable identity across reconnects).")
  capabilities  []string!  @description("The abstract capability verbs this surface serves (e.g. fs.writeFile, fs.readFile, shell.exec). The resolver only binds a capability to a surface that lists it.")
  available     bool!  @default("true")  @description("Whether the surface is currently reachable. The availability failover chain skips unavailable surfaces; an operator/agent flips this via setSurfaceAvailability.")
  priority      int!  @default("100")  @description("Failover order within the available set (lower runs first). The default surface (workbench) is registered with a low priority so it wins by default.")
  status        enum("active", "retired")!  @default("active")  @description("Registry lifecycle. retired surfaces are kept (append-only) but excluded from resolution.")
  lastSeen      datetime  @description("Last availability heartbeat -- staleness signal for the resolver (full liveness model is an open question, #1742).")
  provenanceMutation  string  @description("Name of the mutation that produced this surface version (audit trail).")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
}
