// mutations.memql
//
// Write paths in the `actions` namespace (epic #1734). Phase 0 (#1735)
// ships ONE: recordActionCandidate -- the single path that records
// a captured trace as a v1:actions:candidate row.
//
// Authorization (owned tier): ownerUserId is stamped from actor.userId so
// the caller cannot land a candidate owned by someone else; the conformance
// classifier reads actor.userId in the insert body and buckets this as
// owned. Provenance: provenanceMutation is stamped with this mutation's own
// name; the engine stamps createdBy from the authenticated actor.
//
// Id handling mirrors recordHarnessObservation: candidateId is
// optional -- when omitted the engine assigns the id on insert.

// recordActionCandidate
// =============================
// Append a v1:actions:candidate trace for a completed LLM step. The
// ordered capability calls (with per-arg value provenance) and the
// resource-dependency edges are computed Go-side by the data-flow tracer
// (component/harness/actiontrace) and handed in as already-structured
// arrays; the mutation stays declarative.
// Internal write path: the harness Go side calls this after each LLM step;
// it is NOT exposed on the MCP/SDK surface (no @mcp / @sdk).
/// Record a v1:actions:candidate trace (the captured capability sequence + value/resource
/// provenance for one LLM step, #1735). ownerUserId is stamped from actor.userId (owned tier).
/// status is always 'candidate' on insert.
@actor
mutate candidate recordActionCandidate {
  args {
    candidateId   string
    planId        string!
    stepId        string!
    calls         []object!
    resourceEdges []object
    callCount     int
  }
  insert {
    accept { planId, stepId, calls, resourceEdges, callCount }
    stamp {
      id: args.candidateId
      ownerUserId: actor.userId
      status: "candidate"
      provenanceMutation: "recordActionCandidate"
    }
  }
}

/// Mint a v1:actions:action (primitive) from a completed LLM step (Phase 1, #1736). ownerUserId
/// stamped from actor.userId (owned tier). Stores the replayable capability calls keyed by
/// inputFingerprint.
@actor
mutate action mintAction {
  args {
    actionId          string
    slug              string!
    intent            string!
    capability        string
    sideEffectClass   string
    status            string
    inputFingerprint  string!
    calls             []object!
    resourceEdges     []object
    paramBindings     []object
    templateFingerprint string
    recordedResult    object
    resultFingerprint string
    recordedSurface   string
    provenancePlanId  string
    provenanceStepId  string
  }
  insert {
    accept { slug, intent, capability, inputFingerprint, calls, resourceEdges, paramBindings, templateFingerprint, recordedResult, resultFingerprint, recordedSurface, provenancePlanId, provenanceStepId }
    stamp {
      id: args.actionId
      ownerUserId: actor.userId
      sideEffectClass: coalesce(args.sideEffectClass, "write")
      status: coalesce(args.status, "active")
      provenanceMutation: "mintAction"
    }
  }
}

// reinforceAction
// =======================
// Bump an action's reliability + reinforceCount after a verified successful
// replay (fingerprint match). The new values are computed engine-side (the
// MemQL parser has no arithmetic, mirroring the semanticMemory reinforce
// pattern) and handed in. update read-merges the prior row, so ownerUserId
// and the captured calls are preserved. Internal write path.
/// Reinforce a v1:actions:action after a verified replay: set the engine-computed reliability +
/// reinforceCount and reset the decay clock (Phase 1 #1736; surface-aware decay lands in Phase 4
/// #1739).
mutate action reinforceAction {
  args {
    actionId       string!
    reliability    float!
    reinforceCount int!
  }
  update {
    accept { reliability, reinforceCount }
    stamp {
      id: args.actionId
      lastReinforced: now
      provenanceMutation: "reinforceAction"
    }
  }
}

// registerSurface
// =======================
// Register (or re-version) an execution surface in the resolver's registry
// (Phase 2, #1737). ownerUserId is stamped from actor.userId (owned tier).
// The served capability verbs + availability + failover priority are the
// data the resolver binds against.
/// Register a v1:actions:surface (workbench / computer-use:<machineId> / mcp:<server>) with its
/// served capabilities + availability + failover priority. ownerUserId stamped from actor.userId
/// (owned tier). #1737.
@actor
mutate surface registerSurface {
  args {
    surfaceId    string
    slug         string!
    kind         string!
    machineId    string
    capabilities []string!
    priority     int
  }
  insert {
    accept { slug, kind, machineId, capabilities }
    stamp {
      id: args.surfaceId
      ownerUserId: actor.userId
      available: true
      priority: coalesce(args.priority, 100)
      status: "active"
      lastSeen: now
      provenanceMutation: "registerSurface"
    }
  }
}

// setSurfaceAvailability
// ==============================
// Flip a surface's availability (the failover signal) and stamp the
// heartbeat clock. update read-merges so the served capabilities + slug are
// preserved. #1737.
/// Set a v1:actions:surface availability flag (the resolver's failover signal) and refresh its
/// lastSeen heartbeat. #1737.
mutate surface setSurfaceAvailability {
  args {
    surfaceId  string!
    available  boolean!
  }
  update {
    id: args.surfaceId
    args.available
    lastSeen: now
    provenanceMutation: "setSurfaceAvailability"
  }
}

/// Confirm a candidate v1:actions:action, promoting it to active so it is offered for replay (Phase
/// 4 #1739, the human gate for real-machine side effects).
mutate action confirmAction {
  args {
    actionId  string!
  }
  update {
    id: args.actionId
    status: "active"
    provenanceMutation: "confirmAction"
  }
}

/// Deprecate a v1:actions:action (reliability below floor or superseded), removing it from replay
/// (Phase 4 #1739).
mutate action deprecateAction {
  args {
    actionId  string!
  }
  update {
    id: args.actionId
    status: "deprecated"
    provenanceMutation: "deprecateAction"
  }
}

/// Set a v1:actions:action decayed reliability from the consolidation sweep (Phase 4 #1739; value
/// computed engine-side).
mutate action decayAction {
  args {
    actionId     string!
    reliability  float!
  }
  update {
    id: args.actionId
    args.reliability
    provenanceMutation: "decayAction"
  }
}

/// Bump a v1:actions:action monotonic version on edit (Phase 5 #1740; value computed engine-side).
/// Pins stay on the prior version until the verified upgrade migration moves them.
mutate action bumpActionVersion {
  args {
    actionId  string!
    version   int!
  }
  update {
    id: args.actionId
    args.version
    provenanceMutation: "bumpActionVersion"
  }
}
