// mutations.memql
//
// Write paths in the `actions` namespace (epic #1734). Phase 0 (#1735)
// ships ONE: mutationRecordActionCandidate -- the single path that records
// a captured trace as a v1:actions:candidate row.
//
// Authorization (owned tier): ownerUserId is stamped from actor.userId so
// the caller cannot land a candidate owned by someone else; the conformance
// classifier reads actor.userId in the insert body and buckets this as
// owned. Provenance: provenanceMutation is stamped with this mutation's own
// name; the engine stamps createdBy from the authenticated actor.
//
// Id handling mirrors mutationRecordHarnessObservation: candidateId is
// optional -- when omitted the engine assigns the id on insert.

use actions.concepts.{ candidate }

// mutationRecordActionCandidate
// =============================
// Append a v1:actions:candidate trace for a completed LLM step. The
// ordered capability calls (with per-arg value provenance) and the
// resource-dependency edges are computed Go-side by the data-flow tracer
// (component/harness/actiontrace) and handed in as already-structured
// arrays; the mutation stays declarative.
// Internal write path: the harness Go side calls this after each LLM step;
// it is NOT exposed on the MCP/SDK surface (no @mcp / @sdk).
@enabled
@description("Record a v1:actions:candidate trace (the captured capability sequence + value/resource provenance for one LLM step, #1735). ownerUserId is stamped from actor.userId (owned tier). status is always 'candidate' on insert.")
mutation candidate mutationRecordActionCandidate {
  args {
    candidateId   string
    planId        string    @required
    stepId        string    @required
    calls         []object  @required
    resourceEdges []object
    callCount     int
  }
  insert {
    id: args.candidateId
    ownerUserId: actor.userId
    args.planId
    args.stepId
    status: "candidate"
    args.calls
    args.resourceEdges
    args.callCount
    provenanceMutation: "mutationRecordActionCandidate"
  }
}

// mutationMintAction
// ==================
// Mint a v1:actions:action (primitive) from a completed LLM step (Phase 1,
// #1736). ownerUserId is stamped from actor.userId (owned tier). The harness
// calls this after an LLM step succeeds, passing the captured replayable
// calls + the input/result fingerprints; kind/sideEffectClass/reliability/
// reinforceCount/version/status take their concept @default values.
// Internal write path -- not on the MCP/SDK surface.
@enabled
@description("Mint a v1:actions:action (primitive) from a completed LLM step (Phase 1, #1736). ownerUserId stamped from actor.userId (owned tier). Stores the replayable capability calls keyed by inputFingerprint.")
mutation action mutationMintAction {
  args {
    actionId          string
    slug              string    @required
    intent            string    @required
    capability        string
    inputFingerprint  string    @required
    calls             []object  @required
    resourceEdges     []object
    recordedResult    object
    resultFingerprint string
    recordedSurface   string
    provenancePlanId  string
    provenanceStepId  string
  }
  insert {
    id: args.actionId
    ownerUserId: actor.userId
    args.slug
    args.intent
    args.capability
    args.inputFingerprint
    args.calls
    args.resourceEdges
    args.recordedResult
    args.resultFingerprint
    args.recordedSurface
    args.provenancePlanId
    args.provenanceStepId
    provenanceMutation: "mutationMintAction"
  }
}

// mutationReinforceAction
// =======================
// Bump an action's reliability + reinforceCount after a verified successful
// replay (fingerprint match). The new values are computed engine-side (the
// MemQL parser has no arithmetic, mirroring the semanticMemory reinforce
// pattern) and handed in. update read-merges the prior row, so ownerUserId
// and the captured calls are preserved. Internal write path.
@enabled
@description("Reinforce a v1:actions:action after a verified replay: set the engine-computed reliability + reinforceCount and reset the decay clock (Phase 1 #1736; surface-aware decay lands in Phase 4 #1739).")
mutation action mutationReinforceAction {
  args {
    actionId       string  @required
    reliability    float   @required
    reinforceCount int     @required
  }
  update {
    id: args.actionId
    args.reliability
    args.reinforceCount
    lastReinforced: now()
    provenanceMutation: "mutationReinforceAction"
  }
}

// mutationRegisterSurface
// =======================
// Register (or re-version) an execution surface in the resolver's registry
// (Phase 2, #1737). ownerUserId is stamped from actor.userId (owned tier).
// The served capability verbs + availability + failover priority are the
// data the resolver binds against.
@enabled
@description("Register a v1:actions:surface (workbench / computer-use:<machineId> / mcp:<server>) with its served capabilities + availability + failover priority. ownerUserId stamped from actor.userId (owned tier). #1737.")
mutation surface mutationRegisterSurface {
  args {
    surfaceId    string
    slug         string    @required
    kind         string    @required
    machineId    string
    capabilities []string  @required
    priority     int
  }
  insert {
    id: args.surfaceId
    ownerUserId: actor.userId
    args.slug
    args.kind
    args.machineId
    args.capabilities
    available: true
    priority: coalesce(args.priority, 100)
    status: "active"
    lastSeen: now()
    provenanceMutation: "mutationRegisterSurface"
  }
}

// mutationSetSurfaceAvailability
// ==============================
// Flip a surface's availability (the failover signal) and stamp the
// heartbeat clock. update read-merges so the served capabilities + slug are
// preserved. #1737.
@enabled
@description("Set a v1:actions:surface availability flag (the resolver's failover signal) and refresh its lastSeen heartbeat. #1737.")
mutation surface mutationSetSurfaceAvailability {
  args {
    surfaceId  string   @required
    available  boolean  @required
  }
  update {
    id: args.surfaceId
    args.available
    lastSeen: now()
    provenanceMutation: "mutationSetSurfaceAvailability"
  }
}
