// queries.memql
//
// Read paths in the `actions` namespace (epic #1734). Phase 0 (#1735)
// ships actionCandidatesForPlan -- list the captured candidate traces
// for a plan, so the trace capture is inspectable end to end.
//
// Authorization (owned tier): the filter pins payload.ownerUserId ==
// actor.userId, so a caller only ever reads its own captured traces.

use common.traits.{ statusIsActive }

@description("List v1:actions:candidate traces captured for a plan, newest-first by createdAt (owned tier). #1735.")
query candidate actionCandidatesForPlan {
  args {
    planId  string!
  }
  filter  planId == args.planId && ownerUserId == actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   candidateFull
}

// actionByInputFingerprint -- the literal-replay lookup (Phase 1 #1736).
// The harness computes a stable hash of the dispatched step input and asks
// for an active action minted under the same fingerprint; a hit is replayed
// token-free, a miss falls through to the LLM. Owned tier.
@description("Resolve an active v1:actions:action by inputFingerprint for the calling owner -- the literal-replay lookup (Phase 1 #1736).")
@unbounded("unique inputFingerprint dedupe probe scoped to the owner -- must see all matches")
query action actionByInputFingerprint {
  args {
    inputFingerprint  string!
  }
  filter  inputFingerprint == args.inputFingerprint && statusIsActive && ownerUserId == actor.userId
  shape   actionFull
}

// surfacesForOwner -- the resolver's registry read (Phase 2 #1737).
// Returns the owner's active execution surfaces; the surfaceresolver filters
// by capability + availability in Go and applies the precedence/world-group
// logic. Owned tier.
@description("List the calling owner's active v1:actions:surface registry entries for the capability->surface resolver (Phase 2 #1737). Owned tier.")
query surface surfacesForOwner {
  filter  ownerUserId == actor.userId && statusIsActive
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   surfaceFull
}

// actionByTemplateFingerprint -- Phase 3 (#1738) parameterized-replay
// lookup. Matches an action by the STRUCTURE of the step input (key set hash),
// so an action minted for one input can replay on a different input with the
// same shape via parameter re-binding. Owned tier; superseded by the planner's
// semantic search once wired.
@description("Resolve an active v1:actions:action by templateFingerprint (input structure) for the calling owner -- the parameterized-replay lookup (Phase 3 #1738). Owned tier.")
@unbounded("unique templateFingerprint dedupe probe scoped to the owner -- must see all matches")
query action actionByTemplateFingerprint {
  args {
    templateFingerprint  string!
  }
  filter  templateFingerprint == args.templateFingerprint && statusIsActive && ownerUserId == actor.userId
  shape   actionFull
}

// actionsPendingConfirm -- the confirm UI's worklist (Phase 4 #1739):
// candidate actions awaiting a human confirm before they replay. Owned tier.
@description("List the calling owner's candidate v1:actions:action rows awaiting confirmation (real-machine side effects gate on a human, Phase 4 #1739). Owned tier.")
query action actionsPendingConfirm {
  filter  status == "candidate" && ownerUserId == actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   actionFull
}

// activeActionsForOwner -- the consolidation sweep's input (Phase 4
// #1739): the owner's active actions, to decay unused ones + deprecate those
// below the reliability floor. Owned tier.
@description("List the calling owner's active v1:actions:action rows for the consolidation decay/deprecate sweep (Phase 4 #1739). Owned tier.")
query action activeActionsForOwner {
  filter  ownerUserId == actor.userId && statusIsActive
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   actionFull
}

// actionByIdAndVersion -- pin resolution (Phase 5 #1740). Resolves a
// pinned reference (id@version) to the exact action version, so a bundle that
// pinned act_x@3 always replays version 3 regardless of later edits. Owned tier.
@description("Resolve a pinned v1:actions:action reference (id + version) for the calling owner -- pin-by-default resolution (Phase 5 #1740). Owned tier.")
query action actionByIdAndVersion {
  args {
    actionId  string!
    version   int!
  }
  filter  id == args.actionId && version == args.version && ownerUserId == actor.userId
  shape   actionFull
}

// actionById -- floating-ref resolution (#1758). Resolves a bare action
// reference (no @version) to the latest version of that action. Owned tier.
@description("Resolve a floating v1:actions:action reference by id (latest version) for the calling owner -- floating-ref resolution (#1758). Owned tier.")
query action actionById {
  args {
    actionId  string!
  }
  filter  id == args.actionId && ownerUserId == actor.userId
  shape   actionFull
}

// searchActions -- the planner's library retrieval primitive (#1758). A
// Go-backed cosine search over action `intent` embeddings (node_vectors,
// vectorField='intent'), returning the top-k active actions ranked by
// _similarity. Owner-scoped in the Go handler (builtins carry their
// owner-scope in Go, like recall) -- the per-row-authz conformance classifier
// scans struct query/mutation headers, not builtins, so this is documented
// here for the audit trail.
@sdk
@executor("integration.actionSearch.searchActions")
@args(profile="object")
builtin searchActions {
  text      string!
  k         integer
  provider  string
}
