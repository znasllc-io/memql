// queries.memql
//
// Read paths in the `actions` namespace (epic #1734). Phase 0 (#1735)
// ships queryActionCandidatesForPlan -- list the captured candidate traces
// for a plan, so the trace capture is inspectable end to end.
//
// Authorization (owned tier): the filter pins payload.ownerUserId ==
// actor.userId, so a caller only ever reads its own captured traces.

use actions.concepts.{ candidate, action, surface }
use actions.shapes.{ candidateFull, actionFull, surfaceFull }
use common.traits.{ traitStatusIsActive }

@enabled
@description("List v1:actions:candidate traces captured for a plan, newest-first by createdAt (owned tier). #1735.")
query candidate queryActionCandidatesForPlan {
  args {
    planId  string  @required
  }
  filter  payload.planId == args.planId && payload.ownerUserId == actor.userId
  shape   candidateFull
}

// queryActionByInputFingerprint -- the literal-replay lookup (Phase 1 #1736).
// The harness computes a stable hash of the dispatched step input and asks
// for an active action minted under the same fingerprint; a hit is replayed
// token-free, a miss falls through to the LLM. Owned tier.
@enabled
@description("Resolve an active v1:actions:action by inputFingerprint for the calling owner -- the literal-replay lookup (Phase 1 #1736).")
query action queryActionByInputFingerprint {
  args {
    inputFingerprint  string  @required
  }
  filter  payload.inputFingerprint == args.inputFingerprint && traitStatusIsActive && payload.ownerUserId == actor.userId
  shape   actionFull
}

// querySurfacesForOwner -- the resolver's registry read (Phase 2 #1737).
// Returns the owner's active execution surfaces; the surfaceresolver filters
// by capability + availability in Go and applies the precedence/world-group
// logic. Owned tier.
@enabled
@description("List the calling owner's active v1:actions:surface registry entries for the capability->surface resolver (Phase 2 #1737). Owned tier.")
query surface querySurfacesForOwner {
  filter  payload.ownerUserId == actor.userId && traitStatusIsActive
  shape   surfaceFull
}

// queryActionByTemplateFingerprint -- Phase 3 (#1738) parameterized-replay
// lookup. Matches an action by the STRUCTURE of the step input (key set hash),
// so an action minted for one input can replay on a different input with the
// same shape via parameter re-binding. Owned tier; superseded by the planner's
// semantic search once wired.
@enabled
@description("Resolve an active v1:actions:action by templateFingerprint (input structure) for the calling owner -- the parameterized-replay lookup (Phase 3 #1738). Owned tier.")
query action queryActionByTemplateFingerprint {
  args {
    templateFingerprint  string  @required
  }
  filter  payload.templateFingerprint == args.templateFingerprint && traitStatusIsActive && payload.ownerUserId == actor.userId
  shape   actionFull
}

// queryActionsPendingConfirm -- the confirm UI's worklist (Phase 4 #1739):
// candidate actions awaiting a human confirm before they replay. Owned tier.
@enabled
@description("List the calling owner's candidate v1:actions:action rows awaiting confirmation (real-machine side effects gate on a human, Phase 4 #1739). Owned tier.")
query action queryActionsPendingConfirm {
  filter  payload.status == "candidate" && payload.ownerUserId == actor.userId
  shape   actionFull
}

// queryActiveActionsForOwner -- the consolidation sweep's input (Phase 4
// #1739): the owner's active actions, to decay unused ones + deprecate those
// below the reliability floor. Owned tier.
@enabled
@description("List the calling owner's active v1:actions:action rows for the consolidation decay/deprecate sweep (Phase 4 #1739). Owned tier.")
query action queryActiveActionsForOwner {
  filter  payload.ownerUserId == actor.userId && traitStatusIsActive
  shape   actionFull
}

// queryActionByIdAndVersion -- pin resolution (Phase 5 #1740). Resolves a
// pinned reference (id@version) to the exact action version, so a bundle that
// pinned act_x@3 always replays version 3 regardless of later edits. Owned tier.
@enabled
@description("Resolve a pinned v1:actions:action reference (id + version) for the calling owner -- pin-by-default resolution (Phase 5 #1740). Owned tier.")
query action queryActionByIdAndVersion {
  args {
    actionId  string  @required
    version   int     @required
  }
  filter  id == args.actionId && payload.version == args.version && payload.ownerUserId == actor.userId
  shape   actionFull
}
