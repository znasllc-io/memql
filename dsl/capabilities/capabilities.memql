// capabilities.memql -- declared capability vocabulary
// (construct-invocation epic memql#2322, Story 5 / memql#2325).
//
// A `capability` is a surface-backed, side-effect-classified declaration
// with a dotted/namespaced name and NO body. It is declared like a typed
// builtin: `@sideEffect` -- the UNSPOOFABLE risk class (ADR §7) -- lives
// HERE, on the capability, not on the action that invokes it. The
// implementation is supplied by the runtime surface (fs / shell / http /
// integration / mcp), so there is no DSL body.
//
// Capabilities are imported at the VERB level
// (`use capabilities.integration.github.{ tagRelease }`) and called via
// `capability tagRelease(...)`. The invocation grammar and the action
// rewrite land in later stories of the epic; this file exercises the
// DECLARATION + import + registry plumbing.

@sideEffect("write")
@description("Create a git tag + GitHub release for a version.")
capability integration.github.tagRelease {
  args {
    repo string @required
    tag  string @required
  }
}

@sideEffect("read")
@description("Read a file from the local filesystem surface.")
capability fs.readFile {
  args {
    path string @required
  }
}

@sideEffect("write")
@description("Write a file to the local filesystem surface.")
capability fs.writeFile {
  args {
    path    string @required
    content string @required
  }
}

// shell.* are PERMISSIVE / open-arg capabilities. `shell.script` runs an
// ALLOWLISTED named capability script (the I14 contract, #2221) selected by its
// reserved `script` arg; every other arg is a structured param forwarded to the
// script as data (never a `sh -c` string). The full typed catalog + the strict
// capability->surface resolver are deferred to Story 8 (#2330), so the arg
// schema below is intentionally LENIENT: only the clearly-required selector is
// marked @required, and extra/loose args a script consumes are tolerated rather
// than hard-failed. This keeps a generic shell capability authorable today
// without enumerating every script's argument surface.
@sideEffect("exec")
@description("Run an allowlisted named capability script on the runner surface, passing structured params as data.")
capability shell.script {
  args {
    script string @required
  }
}

@sideEffect("exec")
@description("Run a shell command on the runner surface.")
capability shell.exec {
  args {
    cmd string @required
  }
}
