// capabilities.memql -- the capability CATALOG: the declared, typed,
// side-effect-classified capability vocabulary (construct-invocation epic
// memql#2322; declared shape from Story 5 / memql#2325; reconciliation + strict
// arg-typing from Story 8 / memql#2330).
//
// A `capability` is a surface-backed declaration with a dotted/namespaced name
// and NO body. It is declared like a typed builtin: `@sideEffect` -- the
// UNSPOOFABLE risk class (ADR §7) -- lives HERE, on the capability, not on the
// action that invokes it. The implementation is supplied by the runtime surface
// (fs / shell / http / integration / mcp), so there is no DSL body.
//
// SOURCE OF TRUTH + RECONCILIATION (Story 8 B). This catalog is the DSL-side
// source of truth for action->capability calls, and is reconciled against the
// authoritative Go vocabulary registry (component/actions/capability) at load:
//
//   - every declared name MUST resolve to a verb in the Go closed vocabulary
//     (capability.CapabilityClass known) -- the catalog cannot invent a
//     capability outside the surface-backed set; and
//   - each `@sideEffect` MUST equal that verb's authoritative Go class
//     (read / write / exec). The class is unspoofable: a decl cannot relabel
//     its risk class. A mismatch / unknown name fails the catalog load loud
//     (component/actions.LoadCatalogFromFS; enforced at engine Init).
//
// (The Go vocabulary may carry verbs not yet declared here; that direction is
// fine -- declare them as the system grows to use them.)
//
// STRICT ARG-TYPING (Story 8 C). Each capability's `args { ... }` schema is the
// contract a calling action's `capability <verb>(...)` arguments are validated
// against (component/actions.DeclToAction): every @required arg present, no
// unknown args for a CLOSED capability, types compatible.
//
// OPEN vs CLOSED capabilities. `shell.*` and `mcp.*` are PASS-THROUGH / open:
// their per-call argument surface varies and is validated DOWNSTREAM, not by
// the static schema -- `shell.script` selects an ALLOWLISTED named capability
// script (the I14 contract, #2221) by its reserved `script` arg, and every
// other arg is a structured param the script validates via its own
// `--print-spec` envelope (never a `sh -c` string); an `mcp.<tool>` call
// carries the tool's own JSON-schema'd args. For an open capability the catalog
// still enforces the declared @required args but tolerates extras. `fs.*` /
// `http.*` / `integration.*` are CLOSED/typed: an undeclared arg is rejected.
//
// Capabilities are imported at the VERB level
// (`use capabilities.integration.github.{ tagRelease }`) and called via
// `capability tagRelease(...)` from an action body.

// =============================================================================
//   integration.*  -- named integration backends (closed/typed)
// =============================================================================

/// Create a git tag + GitHub release for a version.
@sideEffect("write")
capability integration.github.tagRelease {
  args {
    repo string!
    tag  string!
  }
}

// =============================================================================
//   fs.*  -- filesystem surface (closed/typed)
// =============================================================================

/// Read a file from the local filesystem surface.
@sideEffect("read")
capability fs.readFile {
  args {
    path string!
  }
}

/// Stat a path on the local filesystem surface (existence + metadata).
@sideEffect("read")
capability fs.stat {
  args {
    path string!
  }
}

/// Write a file to the local filesystem surface.
@sideEffect("write")
capability fs.writeFile {
  args {
    path    string!
    content string!
  }
}

// =============================================================================
//   http.*  -- outbound HTTP surface (closed/typed)
// =============================================================================

/// Issue an HTTP GET to an outbound URL and return the response.
@sideEffect("read")
capability http.get {
  args {
    url string!
  }
}

/// Issue an HTTP POST to an outbound URL with a body.
@sideEffect("write")
capability http.post {
  args {
    url  string!
    body string
  }
}

// =============================================================================
//   shell.*  -- process execution on the runner surface (OPEN/pass-through)
// =============================================================================

/// Run an allowlisted named capability script on the runner surface, passing structured params as
/// data.
@sideEffect("exec")
capability shell.script {
  args {
    script string!
  }
}

/// Run a shell command on the runner surface.
@sideEffect("exec")
capability shell.exec {
  args {
    cmd string!
  }
}
