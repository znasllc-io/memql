// automations.memql
//
// Deployment-namespace ORCHESTRATION -- the keystone of the DevOps deployment
// bundle (epic #2212, I10 #2224). Per the behavioral-constructs ADR §2: logic
// decides, mutations persist, actions touch the world, AUTOMATIONS ORCHESTRATE.
// This file authors the one automation that ties the bundle together:
// deployEngineCluster sequences the I8 deploy actions (actions.memql) with the
// I9 deploy decisions (logic.memql) and the persisted deployment lifecycle
// (createDeployment / updateDeploymentStatus, dsl/deployment/mutations.memql), one
// write per step. It is the single construct allowed to compose all the layers
// (branch / loop / call logic+query+mutation+action), and it stays
// contract-clean: the logics it calls are pure, each mutation step is one
// write, each action step is one external capability on the cockpit/runner
// surface (I13). It therefore PASSES the call-graph validator
// (test/dslconformance/callgraph_contract_test.go) rather than being baselined.
//
// =============================================================================
//   Deploy event taxonomy
// =============================================================================
//
// One event drives the whole bundle:
//
//   topic    : deploy.requested
//   concept  : v1:cluster:deployment
//   payload  : validated against the automation's `args { }` block below --
//              THE machine-checked emitter/consumer contract (G5, #2367).
//              A missing @required field or an @enum violation makes the
//              automation REFUSE to fire loudly (G1 fire-time validation);
//              field semantics are documented as @description annotations
//              on the args fields themselves.
//
// WHO EMITS IT. The event is raised on the cockpit/runner control surface, NOT
// from inside the target cluster:
//   - cockpit `deploy --env=<env>` (I15, memql-cockpit) -- the primary path.
//     `make {up,deploy}` delegate to the cockpit, which loads the pinned
//     deployment bundle and emits deploy.requested with the payload above, then
//     the embedded runtime runs THIS automation.
//   - CI -- a release pipeline can emit the same event on a tag to drive a
//     staging/production GitOps deploy from the build server.
//   - schedule -- a future cron emitter (e.g. nightly staging refresh) raises
//     the identical event; the automation is emitter-agnostic.
//
// AUTHORIZATION. `authorize` records the pure forward-deploy role decision
// (logic deploymentForwardAllowed, mirroring spec requiresDeveloperOrAbove,
// #1876). The HARD gate is upstream + at the writes: createDeployment /
// updateDeploymentStatus are only ever reached through the Go-gated deploy RPCs
// (deploycontrol.authorize), so the deploy-start write and every transition
// inherit that authorization (specs.memql). The step keeps the decision visible
// + greppable in the run record.
//
// =============================================================================
//   deployEngineCluster -- the one orchestration
// =============================================================================
//
// Sequence (decide -> record -> clone -> build -> place -> gate -> finish):
//
//   authorize       logic deploymentForwardAllowed       (decide: role gate)
//   record          createDeployment                     (persist: one write)
//   clone           action cloneRepoAtVersion            (act: checkout the ref)
//   build           forEach nt: action buildEngineImage  (act: one image / node)
//   importDevImages forEach nt where env==development:    (act: dev placement --
//                     action importImageToK3d              per-node k3d import)
//   place           switch env { development {} default { (act: staging/prod
//                     pinOverlayDigests + argoSync } }     placement -- GitOps)
//   gate            action runDeployGate                 (act: post-deploy gate)
//   outcome         logic deployOutcomeLabel             (decide: succeeded/failed)
//   finalize        switch steps.outcome.result {              (persist + act + persist)
//                     succeeded { updateDeploymentStatus succeeded; notifyDeploy }
//                     default   { revertOverlay; updateDeploymentStatus failed;
//                                 notifyDeploy } }
//
// EXECUTION ORDER. The automation scheduler runs steps in the compiler's
// dependency topo-sort order (a step executes after every step it references).
// The deploy is an ORDERED side-effect pipeline whose phases mostly do NOT pass
// data to each other, so each phase reads only the EVENT payload (a reserved
// root, not a step) and carries no inter-step reference -- which keeps every
// phase at the same dependency depth, where the sort preserves the authored
// source order (clone -> build -> place -> gate). The only data edges are the
// two at the tail: outcome reads gate.result, finalize switches on
// outcome.result, so they sort last exactly where the sequence wants them. A
// forEach/switch step's result is NOT addressable by name, so a later phase
// could not depend on it even if we wanted -- reading from the payload is what
// makes the pipeline order deterministic.
//
// PLACEMENT shape (the env split). `place` is the single env `switch`: the
// development case takes no GitOps action (overlays/ArgoCD are not the dev
// path); staging/production pin the overlay to the resolved digests and ask
// ArgoCD to sync (deploys = merges). The per-NODE development k3d import is the
// adjacent `importDevImages` forEach gated `where env=="development"` -- the
// procedural switch-case grammar hosts single steps, not loops, so a per-node
// loop rides a top-level where-filtered forEach instead of living inside the
// case. Both stay in THIS one automation; there are no per-env automations.
//
// LIFECYCLE record. record -> finalize is the deployment timeline the bundle
// persists: createDeployment (in_progress) at start, updateDeploymentStatus
// (succeeded | failed) at finish -- reconstructable asOf any time off the one
// v1:cluster:deployment concept-id timeline (#1872).
//
// DRY-RUN. The action backends are dry-run-capable capability scripts (I8/I14):
// a development deploy runs end-to-end through the bundle against no-op/dry-run
// backends and records the full lifecycle; staging/production are authored +
// dry-runnable and go live once the build-server + ArgoCD wiring is exercised.

/// Deploy the memQL ENGINE cluster to an environment (development | staging | production) on the
/// cockpit/runner surface. Sequences clone -> build -> place (env switch) -> gate ->
/// success/failure finish, recording the deployment lifecycle. Engine mesh ONLY -- no bff or
/// product-carrier nodes.
@trigger(event="deploy.requested", concept="v1:cluster:deployment", partition="*")
automation deployEngineCluster {
  args {
    deploymentId         string!
    environment          enum("development", "staging", "production")!
    engineNodeTypes      []string!
    ref                  string!
    version              string!
    workdir              string!
    overlayPath          string
    digests              object
    previousDeploymentId string
    triggeredBy          string
    dryRun               boolean
  }

  step authorize {
    logic deploymentForwardAllowed ( event )
  }
  step record {
    mutation createDeployment (
      deploymentId,
      environment:  environment,
      version,
      triggeredBy:  triggeredBy,
      status:       "in_progress",
      previousDeploymentId
    )
  }
  step clone {
    action cloneRepoAtVersion(workdir, ref: ref, dryRun)
  }
  step build {
    forEach nt in engineNodeTypes {
      action buildEngineImage(nodeType: nt, version: version, workdir, dryRun)
    }
  }
  step importDevImages {
    forEach nt in engineNodeTypes where environment == "development" {
      action importImageToK3d(nodeType: nt, cluster: "memql", version, dryRun)
    }
  }
  step place {
    switch environment {
      case "development" { }
      default {
        action pinOverlayDigests(overlayPath, digests: digests, dryRun)
        action argoSync(app: "memql", revision: ref, dryRun)
      }
    }
  }
  step gate {
    action runDeployGate(env: environment, workdir: workdir, dryRun)
  }
  step outcome {
    logic deployOutcomeLabel ( passed: steps.gate.result.result.result.passed )
  }
  step finalize {
    switch steps.outcome.result {
      case "succeeded" {
        updateDeploymentStatus { deploymentId: deploymentId, status: "succeeded" }
        action notifyDeploy(env: environment, status: "succeeded", deploymentId, dryRun)
      }
      default {
        updateDeploymentStatus { deploymentId: deploymentId, status: "failed" }
        action notifyDeploy(env: environment, status: "failed", deploymentId, dryRun)
      }
    }
  }
  step rollbackTarget {
    logic deployRollbackTarget ( passed: steps.gate.result.result.result.passed, previousDeploymentId )
  }
  step rollback {
    switch steps.rollbackTarget.result {
      case "" { }
      default {
        action revertOverlay(overlayPath, toDeploymentId: steps.rollbackTarget.result, dryRun)
      }
    }
  }
}
