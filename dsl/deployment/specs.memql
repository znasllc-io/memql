// specs.memql
//
// Deployment-namespace specs. The Deployment Console
// (znasllc-io/memql#725 + #728) is gated to owner/admin; this context-
// spec mirrors the canonical requiresAdmin in dsl/_reference/_spec.memql
// and binds to the actorEnvelope @actor shape so it evaluates
// in-process against the auth context. The DeployControlService Go
// layer enforces the same predicate via auth.AtLeastAdmin; this spec
// is the DSL-side mirror so policies / queries can delegate to it via
// spec("requiresOwnerOrAdmin").

use common.shapes.{ actorEnvelope }

@enabled
@description("Caller must hold owner or admin role to use the Deployment Console.")
@shape("actorEnvelope")
spec requiresOwnerOrAdmin {
  actor.role == "admin" || actor.role == "owner"
}
