// specs.memql
//
// Deployment-namespace specs. These context-specs bind to the
// actorEnvelope @actor shape so they evaluate in-process against the
// auth context. They are the DSL-side mirrors of the role gates the
// DeployControlService Go layer enforces (component/deploycontrol);
// policies / queries name them as a bare top-level conjunct in a filter
// (`requiresOwnerOrAdmin`, not the retired stringly call form; memql#3016).
//
// Three gates, per the locked role matrix in #1876 (epic #1871):
//
//   - requiresOwner: the OWNER-ONLY gate (#1876). Mirrors auth.IsOwner.
//     The gate for ROLLBACK (RollbackDeployment) -- not even admin may
//     roll back; only the cluster owner can.
//
//   - requiresDeveloperOrAbove: the FORWARD-DEPLOY gate (#1876).
//     Mirrors auth.AtLeastDeveloper (developer / admin / owner). Gates
//     CutVersion + Deploy (and the SuggestNextVersion read companion).
//     A developer is engineering power that may cut + ship a version;
//     writer/reader stay read-only.
//
//   - requiresOwnerOrAdmin: the original Deployment Console gate (#728).
//     Mirrors auth.AtLeastAdmin. Still the gate for the legacy console
//     actions (DeployStaging / Promote / Rollback / RolloutAction /
//     GetDeploymentStatus).
//
// #1872 (persisted deployments): createDeployment +
// updateDeploymentStatus (dsl/deployment/mutations.memql) are only
// ever invoked from these Go-gated write RPCs, so the deploy-start write
// and every status transition inherit the same authorization decision
// the console read/write path enforces.

use common.shapes.{ actorEnvelope }

/// Caller must hold the owner role. The owner-only gate (#1876): rollback -- not even admin may
/// roll back a deployment.
spec actorEnvelope requiresOwner {
  return role == "owner"
}

/// Caller must hold developer, admin, or owner role. The forward-deploy gate (#1876): cut a version
/// + deploy. Writer/reader are read-only; rollback is owner-only via requiresOwner.
spec actorEnvelope requiresDeveloperOrAbove {
  return role == "developer" || role == "admin" || role == "owner"
}
