// mutations.memql
//
// Deployment-namespace PERSISTENCE -- the deploy record writes the DevOps
// deployment bundle owns (epic #2212, I11 #2225). Per the behavioral-
// constructs ADR §2: logic decides, MUTATIONS PERSIST, actions touch the
// world, automations orchestrate. These four mutations are the single
// graph-write path for the deploy data model (one write per body): the
// deploy-start record + every status transition (deployment), and the
// per-node-type spec create + re-pin (deploymentNodeSpec).
//
// CENTRALIZED HERE BY I11. These were authored under dsl/cluster/mutations.memql
// (split from the cluster topology mutations); I11 relocates them into the one
// cohesive `deployment` pack next to the concepts they write, the read
// shapes/queries, and the bundle's behavioral constructs. The concept ids are
// HELD STABLE (v1:cluster:deployment / v1:cluster:deploymentNodeSpec -- see
// concepts.memql), so the mutation NAMES and the records they write are
// byte-identical to before; only the DSL import path moved
// (`use deployment.concepts.{ ... }`). The deployEngineCluster automation
// (automations.memql) and the deploy pack (examples/deploypack) reach these via
// `use deployment.mutations.{ ... }`; component/deploycontrol invokes them by
// name through the engine, unaffected by the relocation.

// ---- createDeployment ----

// Write a new deployment record at deploy start (#1872). The
// deploymentId is used as the explicit concept id so every later
// status transition (updateDeploymentStatus) appends a new
// payload version under the SAME time-series timeline -- one record per
// deployment. (The history IS in the table; reading more than the newest
// row is not something the query layer offers today -- #2880.)
//
// deploymentId is ALSO stamped as a payload field. It is NOT for
// deploymentById, which filters `row.id` as of #2784 -- this comment used
// to say otherwise, and would have stopped the next person from deleting
// the field on the strength of a reader that no longer exists. The live
// readers are component/node/reconciler.go, which reads it off the
// payload, and the deploymentFull projection.
//
// Admin action: the Deployment Console gates this path to owner/admin
// in Go (deploycontrol.authorize -> auth.AtLeastAdmin); the DSL mirror
// is spec("requiresOwnerOrAdmin") in dsl/deployment/specs.memql.
//
// Every field is bound with an explicit key + coalesce to a valid value
// (mirroring createNode #1643/#1671): status defaults to
// "pending" and environment to "development" so the enum columns always
// receive a member of their value set; the plain string fields coalesce
// to "" when the caller omits them.
/// Create a v1:cluster:deployment record at deploy start (status defaults to pending). Uses
/// deploymentId as the concept id so status transitions append to one timeline. #1872.
mutate deployment createDeployment {
  args {
    deploymentId         string!
    status               enum("pending", "in_progress", "succeeded", "failed", "superseded", "rolled_back")
    version              string
    imageDigest          string
    provider             string
    environment          enum("development", "staging", "production")
    region               string
    clusterId            string
    triggeredBy          string
    notes                string
    changelog            string
    previousDeploymentId string
  }
  insert {
    id: args.deploymentId
    deploymentId: args.deploymentId
    status: args.status ?? "pending"
    version: args.version ?? ""
    imageDigest: args.imageDigest ?? ""
    provider: args.provider ?? ""
    environment: args.environment ?? "development"
    region: args.region ?? ""
    clusterId: args.clusterId ?? ""
    triggeredBy: args.triggeredBy ?? ""
    notes: args.notes ?? ""
    changelog: args.changelog ?? ""
    previousDeploymentId: args.previousDeploymentId ?? ""
    updatedAt: now
  }
}

// ---- updateDeploymentStatus ----

// Transition a deployment's status (#1872). Read-merge update form
// (mirrors updateNodeHealth): only status + updatedAt change;
// every other field (version/imageDigest/provider/environment/region/
// clusterId/triggeredBy/notes/changelog/previousDeploymentId) inherits
// from the persisted row, so a status-only transition never wipes the
// deploy metadata stamped at create time. The append writes a new row
// under the same concept id, and the CDC path emits
// graph.node.updated.<partition>.v1:cluster:deployment, which the
// cockpit Deployments view subscribes to.
//
// Admin action: gated to owner/admin in Go (deploycontrol.authorize);
// DSL mirror spec("requiresOwnerOrAdmin").
/// Transition a v1:cluster:deployment's status (pending -> in_progress -> succeeded|failed;
/// succeeded -> superseded; any -> rolled_back). Read-merge update: only status + updatedAt change,
/// deploy metadata inherits. #1872.
mutate deployment updateDeploymentStatus {
  args {
    deploymentId  string!
    status        enum("pending", "in_progress", "succeeded", "failed", "superseded", "rolled_back")!
  }
  update {
    id: args.deploymentId
    args.status
    updatedAt: now
  }
}

// ---- createDeploymentNodeSpec ----

// Write a per-node-type spec for a deployment (Epic 2 / #2094). The
// concept id is the HASHED composite of (deploymentId, nodeType), so
// every later re-pin (updateDeploymentNodeSpec) appends a new payload
// version under the SAME time-series timeline -- one record per
// (deployment, nodeType), reconstructable asOf any time. deploymentId
// is ALSO written as a payload field -- stamped, normalised, see below -- and
// nodeType is accepted as given, so nodeSpecsForDeployment can filter on the
// bare deploymentId without canonical-id prefixing.
//
// Why hashed rather than joined (#2885): a raw
// concat(deploymentId, ":", nodeType) is a colon-bearing shortId, and
// Concept.Create runs core/id ValidateShortId BEFORE it touches the
// store -- that admits only a colon-free shortId or the concept-prefixed
// form, so the raw join was rejected on every call and this mutation
// could never write a row. hash() yields 64 hex chars, which is bare.
//
// NORMALISED with shortId() since #2925. authoring-rules section 20 requires
// it because the hash is byte-level: a caller passing a bare deploymentId and
// one passing the canonical "v1:cluster:deployment:<short>" form would hash to
// different ids and mint TWO timelines for the same (deployment, nodeType).
// shortId() is canonical-or-bare in, bare out (#1859), so both shapes derive
// one id for the ids this pack actually sees -- a colon-free uuid from
// id.NewShortId and the canonical form around it. Every SHORT id this tree
// mints is colon- and whitespace-free -- NewShortId, Slugify, the system-node
// helpers and hash() all are -- so shortId() is a fixed point on each, and
// maps the canonical form built around one back onto it.
//
// It is NOT idempotent in general, and the exact condition is subtle enough
// that two attempts to state it here were wrong: it turns on trailing empty
// segments and on whitespace inside the value, not just on segment counts.
// memql#2981 carries the measured predicate and its counterexamples. What
// matters here: an SDK caller can supply a value for which a bare and a
// canonical form still derive DIFFERENT ids, which is section 20's own
// prohibited outcome.
//
// It took #2925 to make that spelling usable: shortId() parsed in an id: slot
// and then died at render, because the mutation-template id evaluator had no
// ShortIdExpr case. The other two spellings are still blocked, and their
// blockers are real defects rather than authoring mistakes:
//
//   - ambient canonicalId, no import: canonical_id_refs.go accepts the
//     ambient path only when the concept id contains ":"+domain+":". The
//     directory domain here is `deployment` but these concepts declare
//     @namespace("cluster"), so the id is v1:cluster:deployment and the check
//     fails -- "concept ... is neither imported nor a same-domain concept".
//     Filed as #2976.
//   - `use cluster.concepts.{ deployment }`: memqllint rejects it while the
//     engine's resolver accepts it on a unique trailing-segment match (that
//     divergence is #2945), AND adding any explicit import for the concept
//     suppresses the same-domain fallback in dslimports, which drops
//     createDeployment and updateDeploymentStatus out of lane-3 field
//     validation. TestMutationFieldLaneCoversEveryMutation catches that and
//     names both mutations, so the coverage loss is loud rather than silent --
//     but it is still caused by an edit that looks unrelated to either. Filed
//     as #2977.
//
// What shortId() does NOT fix, measured input by input rather than reasoned
// about. BareShortId does not simply strip a canonical prefix:
//
//   "  d-abc123  "        -> "d-abc123"           (it TrimSpaces)
//   "foo:v1:bar:baz:qux"  -> "qux"                (first v<digits> segment,
//                                                  when >=3 segments follow)
//   "a:v1:b:c"            -> unchanged             (only 2 follow)
//   "d:x", "x:y:z"        -> unchanged
//
// So normalising the FK cannot make the ":" separator unambiguous on its own,
// and #2980 closes that from the other end instead.
//
// nodeType is a plain discriminator, not a concept reference, so it is hashed
// as written -- but it carries @pattern("^[^:]+$") (#2980), and THAT is what
// makes the composite key injective. With the trailing part colon-free the
// split at the last colon is unique, so
//
//   shortId(d1) + ":" + n1  ==  shortId(d2) + ":" + n2
//
// forces n1 == n2 and shortId(d1) == shortId(d2) -- the same logical pair.
// #2980's witness dies on it: ("d", "x:y") is rejected at the arg boundary,
// while ("d:x", "y") is still admitted and still derives what it always did.
//
// The constraint is on nodeType and deliberately NOT on deploymentId. This
// mutation accepts the CANONICAL "v1:cluster:deployment:<short>" form on
// purpose -- that is what the shortId() normalisation above exists for -- and
// @pattern validates the RAW arg, before shortId() runs. Forbidding colons
// there would reject the exact shape #2925 landed to support. Constraining the
// trailing part alone is both sufficient and compatible. authoring-rules
// section 20 states the general form.
//
// Enforcement is real, not decorative: convertArgsField compiles @pattern into
// a cached regexp (function_loader.go), validateArgsField matches it on every
// call (function_validator.go), and executeMutationFunctionCall runs
// validateFunctionArgs BEFORE renderMutationTemplate (engine.go) -- so nothing
// reaches the hash without passing the check, the generated SDK path included,
// which is the reachability #2980 flagged.
//
// No id changes: no in-tree caller passes a colon-bearing nodeType (deploypack
// sends "bff"), so this rejects input nobody sends rather than re-keying
// anything. Changing the SEPARATOR would not have that property -- it rewrites
// every derived id, colon-bearing or not -- which is why #2980's option 2 was
// not taken despite the issue listing it as migration-free.
//
// No migration. The only in-tree producer of THIS mutation is
// examples/deploypack, whose argString trims and forwards a bare id minted by
// id.NewShortId -- so the derived id is byte-identical to before. (Not
// component/deploycontrol: it calls createDeployment and updateDeploymentStatus,
// which this does not touch.) Inputs that DO change are canonical ids,
// whitespace-padded ids, and some v<digits>-shaped strings (see the table
// above -- "a:v1:b:c" is unchanged). None of these is sent by an in-tree
// caller, and no rows exist to migrate since this mutation could not write at
// all until #2885. Pinned by
// TestShortId_IsANoOpForEveryInTreeProducer.
//
// Engine-as-spine: version coalesces to "" -- an empty version means
// "resolve against the deployment's engine version", a non-empty value
// pins this node type. replicas defaults to the concept @default(1).
//
// Admin action: the deploy pack gates the write path; the DSL mirror
// is spec("requiresOwnerOrAdmin") on the cut-version/rollback effects
// (Epic 2.6). Additive: no existing overlay or query is affected.
/// Create a v1:cluster:deploymentNodeSpec row for a (deploymentId, nodeType) pair. The concept id
/// is hash(concat(shortId(deploymentId), ':', nodeType)) so re-pins append to one timeline and a
/// bare or canonical deploymentId derive the same row.
/// Engine-as-spine: empty version resolves against the deployment engine version. Epic 2 / #2094.
mutate deploymentNodeSpec createDeploymentNodeSpec {
  args {
    deploymentId  string!
    // ^[^:]+$ -- the trailing part of the hashed composite key must be free of
    // the ":" separator, or two distinct pairs alias onto one id (#2980).
    nodeType      string! @pattern("^[^:]+$")
    version       string
    replicas      int
    imageDigest   string
  }
  insert {
    accept { nodeType }
    stamp {
      // deploymentId is STAMPED, not accepted, so the payload field carries
      // the same normalised value the id is derived from. Accepting it raw
      // while normalising the id would collapse a bare and a canonical caller
      // onto one timeline whose payload holds whichever shape was stamped
      // last -- and nodeSpecsForDeployment filters on this field with
      // `asOf latest`, so a canonical re-pin would make the spec invisible to
      // a bare lookup (#2925 review).
      deploymentId: shortId(args.deploymentId)
      id: hash(concat(
        shortId(args.deploymentId), ":",
        args.nodeType
      ))
      version: args.version ?? ""
      replicas: args.replicas ?? 1
      imageDigest: args.imageDigest ?? ""
      updatedAt: now
    }
  }
}

// ---- updateDeploymentNodeSpec ----

// Re-pin an existing per-node-type deployment spec (Epic 2 / #2094).
// Read-merge update form (mirrors updateDeploymentStatus): only
// version + replicas + imageDigest + updatedAt change; deploymentId +
// nodeType inherit from the persisted row, so a re-pin never re-keys
// the spec. The append writes a new row under the same concept id, and
// the CDC path emits
// graph.node.updated.<partition>.v1:cluster:deploymentNodeSpec.
//
// The caller passes deploymentId + nodeType (NOT the composite id) so
// the mutation re-derives the same concept id the create used. That id
// expression MUST stay byte-identical to createDeploymentNodeSpec's
// (#2885): the two are the only thing keeping a re-pin on the create's
// timeline, and a divergence would silently fork a second one rather
// than fail.
/// Re-pin a v1:cluster:deploymentNodeSpec's version / replicas / imageDigest by (deploymentId,
/// nodeType). Read-merge update: deploymentId + nodeType inherit, only the spec fields + updatedAt
/// change. Append under the same hashed composite concept id. Epic 2 / #2094.
mutate deploymentNodeSpec updateDeploymentNodeSpec {
  args {
    deploymentId  string!
    // ^[^:]+$ -- the trailing part of the hashed composite key must be free of
    // the ":" separator, or two distinct pairs alias onto one id (#2980).
    nodeType      string! @pattern("^[^:]+$")
    version       string
    replicas      int
    imageDigest   string
  }
  update {
    id: hash(concat(
      shortId(args.deploymentId), ":",
      args.nodeType
    ))
    version: args.version ?? ""
    replicas: args.replicas ?? 1
    imageDigest: args.imageDigest ?? ""
    updatedAt: now
  }
}
