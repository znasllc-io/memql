// shopify domain -- engine-called index writes (memql#4137).
//
// No @actor: these are reached from the Shopify integration after a
// verified Storefront fetch (or a products/delete). A caller cannot
// invent a product; the builtin refuses to call upsert when fetch misses.
//
// @serverOnly since epic memql#4378, and it is a statement about the
// MIRROR rather than about these two mutations. v1:shopify:shopifyProduct
// declares @origin("shopify"), so the engine refuses ANY write to it that
// does not come from the shopify connector -- which means a
// client-reachable mutation over it is an SDK method that can only ever
// fail. @serverOnly removes them from the generated SDK, so the refusal
// lands at build time in the client instead of at runtime in the user's
// face. The connector stamps internal origin for exactly these calls
// (integrations/shopify/connector.go's connectorContext).

/// Upsert the thin index row after a successful Storefront/Admin fetch.
/// Id is the Shopify GID. present is stamped true.
///
/// @serverOnly, and actor.userId scoping is not the fix here because there
/// is no caller to scope TO. The bound concept declares @origin("shopify"),
/// so the engine refuses every write to it from every actor.userId that
/// exists -- a cluster owner's included -- and admits only
/// auth.ConnectorActor("shopify"), which is not a user and carries no
/// actor.userId a filter could name. The annotation does not create the
/// refusal; it moves where a client MEETS it, from a runtime failure in
/// front of a user to an SDK method that was never generated.
@serverOnly
mutate shopifyProduct upsertShopifyProduct {
  args {
    productId          string!
    handle             string!
    availableForSale   bool!
  }
  insert {
    accept { handle, availableForSale }
    stamp {
      id: args.productId
      present: true
    }
  }
}

/// Retire an index row we already had. Does not create a row -- the
/// engine update of a missing id is a no-op / miss, never an invent.
///
/// @serverOnly for the same reason as upsertShopifyProduct above: the bound
/// concept is a MIRROR, so actor.userId scoping has nobody to scope to --
/// every user is refused and the one admitted writer is the shopify
/// connector's actor, which has no actor.userId.
@serverOnly
mutate shopifyProduct retireShopifyProduct {
  args {
    productId  string!
  }
  update {
    id: args.productId
    present: false
    availableForSale: false
  }
}
