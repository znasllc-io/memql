// shopify domain -- inbound + scheduled reconcile (memql#4137).
//
// TRANSPORT is POST /inbound/{source} (HMAC allowlist, Shopify-shaped
// scheme). This automation fires on every inbound row and the builtin
// no-ops unless the source/body is a product delivery, same shape as
// ingestCampaignFeedback.
//
// The inboundRequest row has no topic header, so the GID is parsed
// from the body (admin_graphql_api_id / gid / numeric id) and then
// Storefront is fetched. A delete and a miss both retire; they never
// invent.
//
// Webhooks are at-least-once / occasionally not-at-all, so a 6-hour
// reconcile re-fetches known index rows.

use shopify.builtins.{ shopifyApplyInboundProduct, shopifyReconcileIndex }

/// On a staged inbound webhook, offer it to the thin Shopify index.
@trigger(event="node.created", concept="v1:platform:inboundRequest", partition="*")
automation applyShopifyInboundProduct {
  args {
    id     any
    body   any
    source any
  }
  step apply {
    builtin shopifyApplyInboundProduct (
      inboundRequestId: id
      body: body
      source: source
    )
  }
}

/// Reconcile present index rows every 6 hours. The builtin re-fetches
/// known GIDs; a miss retires, a hit upserts. Nothing new is invented.
@trigger(schedule="0 0 */6 * * *")
automation reconcileShopifyIndex {
  step apply {
    builtin shopifyReconcileIndex ()
  }
}
