/// Every field of the mirrored Customer. Empty body on purpose: that IS the
/// default projection over the bound concept, so a field the generator adds
/// next quarter is projected without a second edit.
@row
shape customer customerMirror {
}

/// One mirrored Shopify Customer by store and GID.
@actor
query customer shopifyCustomerByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  storeId==args.storeId && gid==args.gid && actor.isClusterOwner==true
  shape   customerMirror
}

/// Live mirrored Shopify Customer rows for one store, newest origin update
/// first. `since` narrows to what changed, which is how reconciliation
/// pages without re-reading the whole domain.
@actor
query customer shopifyCustomerForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    storeId==args.storeId && isNotDeleted && actor.isClusterOwner==true && when(args.since) { updatedAt>=args.since }
  sort      "updatedAt", "desc"
  paginate  100
  shape     customerMirror
}
