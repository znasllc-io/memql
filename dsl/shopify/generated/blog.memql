use common.traits.{ isNotDeleted }

/// Shopify Blog, mirrored. Cluster-owner tier: commerce data is business
/// data, not per-user data (design D5).
@origin("shopify")
@rowAuthz(clusterOwner)
@displayCard(primary="gid", secondary="title", status="deleted")
concept blog {
