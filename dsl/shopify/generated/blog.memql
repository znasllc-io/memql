/// Every field of the mirrored Blog. Empty body on purpose: that IS the
/// default projection over the bound concept, so a field the generator adds
/// next quarter is projected without a second edit.
@row
shape blog blogMirror {
}

/// One mirrored Shopify Blog by store and GID.
@actor
query blog shopifyBlogByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  row => row.storeId == args.storeId && row.gid == args.gid && actor.isClusterOwner == true
  shape   blogMirror
}

/// Live mirrored Shopify Blog rows for one store, newest origin update
/// first. `since` narrows to what changed, which is how reconciliation
/// pages without re-reading the whole domain.
@actor
query blog shopifyBlogForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    row => row.storeId == args.storeId
                && isNotDeleted(row)
                && actor.isClusterOwner == true
                && (args.since == nil || row.updatedAt >= args.since)
  sort      "updatedAt", "desc"
  paginate  100
  shape     blogMirror
}
