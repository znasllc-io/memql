  gid        string!
  /// The ORIGIN's version. A write whose updatedAt is older than the stored one is refused as stale.
  updatedAt  datetime!
  /// Where updatedAt came from: "origin", Shopify's own version; or "read", a time MemQL read Shopify -- for a row
  /// Shopify publishes no version for, and for a tombstone, whose standing is when it was read (syncedAt), not a version.
  /// Counted only beside versionReadAt equal to syncedAt; otherwise the row was written before every write said, and the
  /// guard reads it as holding no version.
  versionSource string
  /// When MemQL read Shopify for the write that last changed this row, on MemQL's clock: the fetch, the page, the start of a
  /// relist's listing or of a bulk export, the receipt of a delete. Whether the record exists is judged by it. A pass that
  /// finds the row unchanged writes nothing, so this is not when it was last checked; the domain's sync state (lastReconcileAt) is.
  syncedAt   datetime!
  /// The syncedAt of the write that set versionSource, which that marker counts beside.
  versionReadAt string
  /// Tombstone. A delete topic, a clean fetch that finds nothing, or a relist that does not list the row sets it; the row and its history stay.
  deleted    bool
  /// Admin GraphQL articlesCount.
  articlesCount              object
  /// Admin GraphQL commentPolicy.
  commentPolicy              enum("AUTO_PUBLISHED", "CLOSED", "MODERATED")
  /// Admin GraphQL feed.
  feed                       object
  /// Admin GraphQL handle.
  handle                     string
  /// Admin GraphQL metafields. Merchant-owned and own-app metafields, keyed
  /// "namespace.key". App-owned metafields of OTHER apps are not visible to
  /// anyone (2025-05-19).
  metafields                 object
