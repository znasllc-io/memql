/// One mirrored Shopify ProductVariant by store and GID.
@actor
query productVariant shopifyProductVariantByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  row => row.storeId == args.storeId && row.gid == args.gid && actor.isClusterOwner == true
  shape   productVariantMirror
}

/// Live mirrored Shopify ProductVariant rows for one store, newest origin
/// update first. `since` narrows to what changed, which is how
/// reconciliation pages without re-reading the whole domain.
@actor
query productVariant shopifyProductVariantForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    row => row.storeId == args.storeId
                && isNotDeleted(row)
                && actor.isClusterOwner == true
                && (args.since == nil || row.updatedAt >= args.since)
  sort      "updatedAt", "desc"
  paginate  100
  shape     productVariantMirror
}
