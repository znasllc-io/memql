/// Every field of the mirrored Product. Empty body on purpose: that IS the
/// default projection over the bound concept, so a field the generator adds
/// next quarter is projected without a second edit.
@row
shape product productMirror {
}

/// One mirrored Shopify Product by store and GID.
@actor
query product shopifyProductByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  storeId==args.storeId && gid==args.gid && actor.isClusterOwner==true
  shape   productMirror
}

/// Live mirrored Shopify Product rows for one store, newest origin update
/// first. `since` narrows to what changed, which is how reconciliation
/// pages without re-reading the whole domain.
@actor
query product shopifyProductForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    storeId==args.storeId && isNotDeleted && actor.isClusterOwner==true && when(args.since) { updatedAt>=args.since }
  sort      "updatedAt", "desc"
  paginate  100
  shape     productMirror
}
