/// Every field of the mirrored MarketingActivity. Empty body on purpose:
/// that IS the default projection over the bound concept, so a field the
/// generator adds next quarter is projected without a second edit.
@row
shape marketingActivity marketingActivityMirror {
}

/// One mirrored Shopify MarketingActivity by store and GID.
@actor
query marketingActivity shopifyMarketingActivityByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  row => row.storeId == args.storeId && row.gid == args.gid && actor.isClusterOwner == true
  shape   marketingActivityMirror
}

/// Live mirrored Shopify MarketingActivity rows for one store, newest
/// origin update first. `since` narrows to what changed, which is how
/// reconciliation pages without re-reading the whole domain.
@actor
query marketingActivity shopifyMarketingActivityForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    row => row.storeId == args.storeId
                && isNotDeleted(row)
                && actor.isClusterOwner == true
                && (args.since == nil || row.updatedAt >= args.since)
  sort      "updatedAt", "desc"
  paginate  100
  shape     marketingActivityMirror
}
