/// One mirrored Shopify MetafieldDefinition by store and GID.
@actor
query metafieldDefinition shopifyMetafieldDefinitionByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  storeId==args.storeId && gid==args.gid && actor.isClusterOwner==true
