}

/// Live mirrored Shopify MetafieldDefinition rows for one store, newest
/// origin update first. `since` narrows to what changed, which is how
/// reconciliation pages without re-reading the whole domain.
@actor
query metafieldDefinition shopifyMetafieldDefinitionForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    storeId==args.storeId && isNotDeleted && actor.isClusterOwner==true && when(args.since) { updatedAt>=args.since }
  sort      "updatedAt", "desc"
  paginate  100
  shape     metafieldDefinitionMirror
}
