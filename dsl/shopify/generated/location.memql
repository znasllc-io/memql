/// Every field of the mirrored Location. Empty body on purpose: that IS the
/// default projection over the bound concept, so a field the generator adds
/// next quarter is projected without a second edit.
@row
shape location locationMirror {
}

/// One mirrored Shopify Location by store and GID.
@actor
query location shopifyLocationByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  row => row.storeId == args.storeId && row.gid == args.gid && actor.isClusterOwner == true
  shape   locationMirror
}

/// Live mirrored Shopify Location rows for one store, newest origin update
/// first. `since` narrows to what changed, which is how reconciliation
/// pages without re-reading the whole domain.
@actor
query location shopifyLocationForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    row => row.storeId == args.storeId
                && isNotDeleted(row)
                && actor.isClusterOwner == true
                && (args.since == nil || row.updatedAt >= args.since)
  sort      "updatedAt", "desc"
  paginate  100
  shape     locationMirror
}
