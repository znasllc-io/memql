/// Every field of the mirrored Fulfillment. Empty body on purpose: that IS
/// the default projection over the bound concept, so a field the generator
/// adds next quarter is projected without a second edit.
@row
shape fulfillment fulfillmentMirror {
}

/// One mirrored Shopify Fulfillment by store and GID.
@actor
query fulfillment shopifyFulfillmentByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  row => row.storeId == args.storeId && row.gid == args.gid && actor.isClusterOwner == true
  shape   fulfillmentMirror
}

/// Live mirrored Shopify Fulfillment rows for one store, newest origin
/// update first. `since` narrows to what changed, which is how
/// reconciliation pages without re-reading the whole domain.
@actor
query fulfillment shopifyFulfillmentForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    row => row.storeId == args.storeId
                && isNotDeleted(row)
                && actor.isClusterOwner == true
                && (args.since == nil || row.updatedAt >= args.since)
  sort      "updatedAt", "desc"
  paginate  100
  shape     fulfillmentMirror
}
