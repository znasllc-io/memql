/// Every field of the mirrored DraftOrder. Empty body on purpose: that IS
/// the default projection over the bound concept, so a field the generator
/// adds next quarter is projected without a second edit.
@row
shape draftOrder draftOrderMirror {
}

/// One mirrored Shopify DraftOrder by store and GID.
@actor
query draftOrder shopifyDraftOrderByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  row => row.storeId == args.storeId && row.gid == args.gid && actor.isClusterOwner == true
  shape   draftOrderMirror
}

/// Live mirrored Shopify DraftOrder rows for one store, newest origin
/// update first. `since` narrows to what changed, which is how
/// reconciliation pages without re-reading the whole domain.
@actor
query draftOrder shopifyDraftOrderForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    row => row.storeId == args.storeId
                && isNotDeleted(row)
                && actor.isClusterOwner == true
                && (args.since == nil || row.updatedAt >= args.since)
  sort      "updatedAt", "desc"
  paginate  100
  shape     draftOrderMirror
}
