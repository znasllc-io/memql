/// One mirrored Shopify AbandonedCheckout by store and GID.
@actor
query abandonedCheckout shopifyAbandonedCheckoutByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  storeId==args.storeId && gid==args.gid && actor.isClusterOwner==true
