use common.traits.{ isNotDeleted }

/// Shopify Segment, mirrored. Cluster-owner tier: commerce data is business
/// data, not per-user data (design D5).
@namespace("shopify")
@origin("shopify")
@rowAuthz(clusterOwner)
@displayCard(primary="gid", secondary="name", status="deleted")
concept segment {
  /// The v1:shopify:store row this mirror belongs to. Every read is store-scoped.
  storeId    string!
  /// Shopify's own identity, gid://shopify/<Type>/<id>. Stable across renames.
  gid        string!
  /// The ORIGIN's version. A write whose updatedAt is older than the stored one is refused as stale.
  updatedAt  datetime!
  /// When MemQL last wrote this row. Drift is (now - syncedAt) and the store's health reports it.
  syncedAt   datetime!
