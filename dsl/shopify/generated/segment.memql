}

/// One mirrored Shopify Segment by store and GID.
@actor
query segment shopifySegmentByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  storeId==args.storeId && gid==args.gid && actor.isClusterOwner==true
  shape   segmentMirror
}

/// Live mirrored Shopify Segment rows for one store, newest origin update
/// first. `since` narrows to what changed, which is how reconciliation
/// pages without re-reading the whole domain.
@actor
query segment shopifySegmentForStore {
  args {
    storeId  string!
    since    datetime
  }
  filter    storeId==args.storeId && isNotDeleted && actor.isClusterOwner==true && when(args.since) { updatedAt>=args.since }
  sort      "updatedAt", "desc"
  paginate  100
  shape     segmentMirror
}
