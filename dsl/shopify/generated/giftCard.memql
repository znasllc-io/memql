/// One mirrored Shopify GiftCard by store and GID.
@actor
query giftCard shopifyGiftCardByGid {
  args {
    storeId  string!
    gid      string!
  }
  filter  storeId==args.storeId && gid==args.gid && actor.isClusterOwner==true
