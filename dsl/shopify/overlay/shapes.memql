use shopify.overlay.concepts.{ store, complianceJob }

/// The store row as the connector and the portal read it.
///
/// row.id is projected explicitly because the STORE ID is the row id and
/// nothing else carries it: it is the segment of the inbound source name,
/// the scope of every mirror row, and the key of every sync state. A read
/// that returned the configuration without it would be unusable.
///
/// The three credential REFERENCES are projected; the credentials are not,
/// and cannot be -- the row has never held them.
@row
shape store storeFull {
  row.id
  domain
  name
  appClientId
  adminTokenRef
  storefrontTokenRef
  webhookSecretRef
  apiVersion
  scopesGranted
  protectedDataLevel
  plan
  status
  ownerUserId
  health
  subscriptionsCheckedAt
  redactedAt
  uninstalledAt
  connectedAt
  isDevelopment
  developmentOfStoreId
  row.createdAt
}

/// Every field of a queued privacy job. Empty body: the default
/// projection over the bound concept.
@row
shape complianceJob complianceJobFull {
}

/// A privacy job as its row stands, with the row's id and its version. The
/// connector reads a job by id through this before it writes the row, and
/// fences the write on the version it read: a request and a pass of the
/// runner write the same row, and of two that finish together one must lose
/// and decide again.
@row
shape complianceJob complianceJobStored {
  row.id
  storeId
  topic
  customerGid
  orderGids
  requestId
  shopDomain
  dueAt
  status
  outcome
  lastError
  scrubbedAt
  completedAt
  requestedAt
  row.createdAt
}
