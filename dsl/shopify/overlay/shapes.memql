use shopify.overlay.concepts.{ store, complianceJob }
use shopify.generated.order.{ order }
use shopify.generated.orderLineItem.{ orderLineItem }
use shopify.generated.refund.{ refund }
use shopify.generated.shop.{ shop }

/// The store row as the connector and the portal read it.
///
/// row.id is projected explicitly because the STORE ID is the row id and
/// nothing else carries it: it is the segment of the inbound source name,
/// the scope of every mirror row, and the key of every sync state. A read
/// that returned the configuration without it would be unusable.
///
/// The three credential REFERENCES are projected; the credentials are not,
/// and cannot be -- the row has never held them.
@row
shape store storeFull {
  row.id
  domain
  name
  appClientId
  adminTokenRef
  storefrontTokenRef
  webhookSecretRef
  apiVersion
  scopesGranted
  protectedDataLevel
  plan
  status
  ownerUserId
  health
  subscriptionsCheckedAt
  redactedAt
  uninstalledAt
  connectedAt
  isDevelopment
  developmentOfStoreId
  row.createdAt
}

/// Every field of a queued privacy job. Empty body: the default
/// projection over the bound concept.
@row
shape complianceJob complianceJobFull {
}

/// A privacy job as its row stands, with the row's id and its version. The
/// connector reads a job by id through this before it writes the row, and
/// fences the write on the version it read: a request and a pass of the
/// runner write the same row, and of two that finish together one must lose
/// and decide again.
@row
shape complianceJob complianceJobStored {
  row.id
  storeId
  topic
  customerGid
  orderGids
  requestId
  shopDomain
  dueAt
  status
  outcome
  lastError
  scrubbedAt
  completedAt
  requestedAt
  deliveryIds
  exportId
  row.createdAt
}

// ---- the store statistics walk (the 2026-11-11 store statistics design) ----
//
// What the walk reads of a store, and nothing more. It reads every
// organization's stores under the cluster-owner predicate and keys each row by
// its store, so a shape projects what a figure is made of: no person's name,
// no address, no phone and no account. The buyer's email is on the two order
// shapes only, where a returning buyer is told from a new one. The one name
// projected is the shop's own and the store's own.
//
// row.createdAt is the write time of a row's newest version: the walk resumes
// from the newest it read. `deleted` is projected on every mirror shape
// because the walk is handed tombstones too, and retires the fact a retired
// row made.

/// An order as the statistics walk reads it: the business date, the money
/// sets a sale is figured from, and the buyer it is counted under.
@row
shape order storeStatisticsOrder {
  row.id
  row.createdAt
  storeId
  gid
  syncedAt
  deleted
  processedAt
  sourceCreatedAt
  cancelledAt
  test
  taxesIncluded
  currencyCode
  customerGid
  email
  subtotalLineItemsQuantity
  totalShippingPriceSet
  totalTaxSet
  originalTotalDutiesSet
  currentSubtotalPriceSet
  totalDiscountsSet
  totalRefundedSet
}

/// An order line as the statistics walk reads it: the product, the
/// quantities sold and kept, the unit price and the discounts on it.
@row
shape orderLineItem storeStatisticsLine {
  row.id
  row.createdAt
  storeId
  gid
  parentGid
  deleted
  isGiftCard
  productGid
  title
  quantity
  currentQuantity
  originalUnitPriceSet
  discountAllocations
}

/// A refund as the statistics walk reads it: when, how much, and what it
/// gave back -- lines, shipping, duties and adjustments.
@row
shape refund storeStatisticsRefund {
  row.id
  row.createdAt
  storeId
  gid
  parentGid
  syncedAt
  deleted
  processedAt
  sourceCreatedAt
  totalRefundedSet
  duties
  refundLineItems
  refundShippingLines
  orderAdjustments
}

/// The buyer of an order, for the count of new and returning buyers.
@row
shape order storeStatisticsBuyer {
  row.id
  row.createdAt
  storeId
  gid
  deleted
  email
}

/// The shop as the statistics walk reads it: its currency, its time zone,
/// whether its prices include tax, and its plan.
@row
shape shop storeStatisticsShop {
  row.id
  row.createdAt
  storeId
  deleted
  name
  currencyCode
  ianaTimezone
  taxesIncluded
  plan
}

/// A configured store as the statistics walk reads it: which stores there
/// are, whether one is a development store, and whether it is still
/// installed. No credential reference and no owner.
@row
shape store storeStatisticsStore {
  row.id
  domain
  name
  isDevelopment
  scopesGranted
  uninstalledAt
  redactedAt
  health
}
