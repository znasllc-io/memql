@sdk
@executor("integration.shopify.ensureSubscriptions")
@description("Register every mirrored webhook topic for every ingesting store at the pinned API version, update the ones whose URL, version or includeFields have drifted, and remove ours the allowlist no longer wants. Shopify deletes a subscription after eight consecutive delivery failures, so this is what brings a store back after an outage. Records the outcome on each store's health. For the scheduled automation or a cluster owner; anybody else is refused before anything runs.")
builtin shopifyEnsureSubscriptions {
}

@sdk
@executor("integration.shopify.runComplianceJobs")
@description("Run the privacy jobs that are due: export what the mirror holds on a customer to the store owner's Library (nothing, once she has been erased), erase a customer from every version of every row of the person and from the store's processed deliveries, purge a redacted shop's mirror with its sync state and its staged deliveries. Every erasure is made twice, an hour apart, and a job that fails is run again at every run until it is done. Every pass that ran is audited. A shop's purge reads the store as it is now: a store whose row records the uninstall is purged, and any other is asked first and purged only when the origin refuses the app outright, so a reverted uninstall does not cost the mirror; a purge that is skipped queues the store's backfills that have not started. The deliveries that asked for a job are deleted when it is done. For the scheduled automation or a cluster owner; anybody else is refused before anything runs.")
builtin shopifyRunComplianceJobs {
}

@sdk

@executor("integration.shopify.fetchProduct")
@description("Read a mirrored Shopify product by GID or handle. Answers from the mirror, so it costs no Admin API call and no cost points. Tokens never appear in the reply. For the store's owner or a cluster owner; anybody else is refused before the mirror is read.")
builtin shopifyFetchProduct {
  storeId  string  @description("The store. When omitted: the only configured store for a cluster owner; for anybody else the one store they own, and a storeId is asked for when they own several.")
  id       string
  handle   string
}

@sdk
@executor("integration.shopify.shopifyql")
@description("Run an ad-hoc ShopifyQL analytics query for questions the mirror cannot answer. Requires read_reports and protected-customer-data Level 2 approval; refused below that with a reason naming the level, which Shopify's own 403 does not. For the store's owner or a cluster owner; anybody else is refused before Shopify is asked.")
builtin shopifyql {
  storeId  string  @description("The store. When omitted: the only configured store for a cluster owner; for anybody else the one store they own, and a storeId is asked for when they own several.")
  query    string
}

@sdk
@executor("integration.shopify.storeHealth")
@description("Report the status, granted-versus-needed scopes, subscription reconcile time, cost-bucket state and per-domain sync state with drift counters of each store the caller may read: every store for a cluster owner or a caller who may read stores, a store's owner their own, anybody else none. The read behind the portal's Stores page.")
builtin shopifyStoreHealth {
  storeId  string  @description("One store. When omitted, every store the caller may read.")
}

/// One store's verdict (U6): whether it is being recorded, and when it is not, why and the one act
/// that fixes each reason. Computed in the engine from the store row, its sync state and its
/// given-up deliveries, so a screen draws it without a copy of the rules.
///
/// `state` is recording, starting, paused, needs attention or not connected, `since` when it began,
/// `resumedAt` when the store last left paused or not connected (empty when it never has), and
/// `connectedAt` when a connect last started its recording afresh (empty for a store connected before
/// that was recorded), and `grantRecordedAt` when a connect last recorded its grant (empty for a store
/// connected before that was recorded). Each reason has a `code` (data_not_declared, approval_outdated, grant_lost,
/// events_not_registered, check_failing, changes_not_recorded, privacy_request_failing), one
/// `sentence` for a person, and an `act` with its `actLabel` and `actUrl` (or none); `count` is a
/// floor when `atLeast` is true. Each reason also says in machine fields what it stands in the way
/// of: `concerns` is wholeStore (nothing of the store is recorded as it should be), concepts (the
/// generated concepts named in `concepts`, sorted, and the children read with them) or noRecording
/// (not about recording); `concepts` is a list, empty unless `concerns` is concepts. `outside` and
/// `withheld` are plain words. `outsideConcepts` is the machine form of what the store does not
/// record: the generated concept names, sorted, of the domains outside its connection, refused as not
/// requested, or refused by the origin as not granted (a child read with its parent is outside with
/// it). A reply without it is from an older node and says nothing about what is outside.
/// `may.act` says whether the caller may take the acts. For the store's owner, a cluster owner, or a
/// caller who may read stores; anyone else is refused before the store's state is read.
@sdk
@executor("integration.shopify.storeVerdict")
@requiresCapability("execute", "app:deployables/store")
@description("One store's verdict: state (recording, starting, paused, needs attention, not connected), since, resumedAt, connectedAt and grantRecordedAt (when a connect last recorded the store's grant); reasons, each {code, domain, sentence, detail, count, atLeast, act, actLabel, actUrl, concerns, concepts} (atLeast: the count is a floor; concerns: wholeStore, concepts or noRecording, what the reason stands in the way of; concepts: the generated concept names it concerns, sorted, empty unless concerns is concepts); recorded, each {kind, lastChangeAt, lastCheckedAt}; outside and withheld in plain words; outsideConcepts, the generated concept names, sorted, of the domains the store does not record (outside its connection, not requested, or not granted by the origin); ordersFrom; alert {state, reason}; may {act}. For the store's owner, a cluster owner, or a caller who may read stores.")
builtin shopifyStoreVerdict {
  storeId  string!  @description("The store.")
}

/// Register again: run the store's subscription pass now and record it on the store's health, as
/// the daily pass does. For the store's owner or a cluster owner; anyone else is refused before
/// Shopify is asked.
@sdk
@executor("integration.shopify.storeRegisterEvents")
@requiresCapability("execute", "app:deployables/store")
@description("Register again: reconcile one store's webhook subscriptions now and record the pass on its health. Returns {status, storeId, desired, existing, created, failed}; status is registered or failed. For the store's owner or a cluster owner.")
builtin shopifyStoreRegisterEvents {
  storeId  string!  @description("The store whose subscriptions are registered again.")
}

/// Try again: put the store's deliveries that used their four tries back in line, through
/// datasyncRequeueInbound for the source shopify-<store>. For the store's owner or a cluster owner;
/// anyone else is refused before anything is read.
@sdk
@executor("integration.shopify.storeRetryDeliveries")
@requiresCapability("execute", "app:deployables/store")
@description("Try again: put one store's given-up deliveries back in line, so the retry pass tries each again within a minute. Returns {status, storeId, source}. For the store's owner or a cluster owner.")
builtin shopifyStoreRetryDeliveries {
  storeId  string!  @description("The store whose given-up deliveries are tried again.")
}

/// Pause recording, or resume it: a store being recorded (configured, backfilling or live) moves to
/// paused, and a paused one to live, through setStoreStatus written as the deployment, so a store's
/// owner who is not a cluster owner may take the Store page's two acts without the store row's own
/// gate being widened. Each pause and resume is audited under the caller. A store that is not
/// connected (error, uninstalled, purged) is refused before anything is written, and asking for the
/// state the store is in writes nothing. For the store's owner or a cluster owner; anyone else is
/// refused before anything else is read.
@sdk
@executor("integration.shopify.storeSetRecording")
@requiresCapability("execute", "app:deployables/store")
@description("Pause or resume recording one store: recording false moves a store being recorded (configured, backfilling or live) to paused, true moves a paused store to live, and asking for the state it is in writes nothing. Each pause and resume is audited under the caller. Returns {status, storeId}; status is live (being recorded) or paused. A store that is not connected (error, uninstalled, purged) is refused. For the store's owner or a cluster owner.")
builtin shopifyStoreSetRecording {
  storeId    string!   @description("The store.")
  recording  boolean!  @description("True resumes recording; false pauses it.")
}

/// The store watch: one pass computes every store's verdict, records it on the store's health as
/// `verdict` {state, reasons, since, episode, resumedAt, mailedFor, recoveredFor, alert {state, reason}},
/// and stages one email to the store's owner when an episode -- needs attention and not connected, in
/// any order, unbroken -- has lasted the alert wait, and one when the store is recording again. Driven by the watchShopifyStores automation, so
/// it carries no @sdk and refuses a call without internal origin in its handler.
@executor("integration.shopify.watchStores")
@description("One pass of the store watch: compute every store's verdict, record it on the store's health, and email the store's owner once when it has needed attention or been disconnected for the alert wait and once when it is recording again. Only the engine reaches it: a call without internal origin is refused.")
builtin shopifyWatchStores { }

/// The alert wait: how many minutes a store needs attention, or is disconnected, before its owner is
/// emailed. 30 when SHOPIFY_STORE_ALERT_MINUTES is unset, unreadable or out of range.
@sdk
@executor("integration.shopify.storeAlertWait")
@requiresCapability("read", "app:settings/connections")
@description("The minutes a store needs attention before its owner is emailed. Returns {minutes, isDefault, maySet}; isDefault is true when nothing valid is set (30 minutes), maySet whether the caller, a cluster owner, may change it.")
builtin shopifyStoreAlertWait { }

/// Set the alert wait, from 1 to 1440 minutes, in the global variable SHOPIFY_STORE_ALERT_MINUTES.
/// A cluster owner's; anybody else, and any value out of range, is refused before anything is read.
@sdk
@executor("integration.shopify.storeAlertWaitSet")
@requiresCapability("execute", "app:settings/connections")
@description("Cluster owners only. Set the minutes a store needs attention before its owner is emailed, from 1 to 1440. Returns {minutes, isDefault, maySet}.")
builtin shopifyStoreAlertWaitSet {
  minutes  int!  @description("Minutes, from 1 to 1440.")
}

@sdk
@executor("integration.shopify.commerceSold")
@description("What sold in a window, grouped by product or by variant, read entirely from the mirror -- no Admin API call and no cost points. Reports units and orders per line, and reports truncated=true when the walk hit its page cap rather than returning a smaller number and letting the caller believe it. For the store's owner or a cluster owner; anybody else is refused before the mirror is read.")
builtin commerceSold {
  storeId  string  @description("The store. When omitted: the only configured store for a cluster owner; for anybody else the one store they own, and a storeId is asked for when they own several.")
  from     string
  to       string
  groupBy  string
}

@sdk
@executor("integration.shopify.commerceStock")
@description("Inventory levels below a threshold at one location. Shopify models inventory as NAMED quantities (available, committed, on_hand), so the threshold is applied in Go and a level with no `available` count reads as unknown rather than as a stockout. For the store's owner or a cluster owner; anybody else is refused before the mirror is read.")
builtin commerceStock {
  storeId      string  @description("The store. When omitted: the only configured store for a cluster owner; for anybody else the one store they own, and a storeId is asked for when they own several.")
  locationGid  string
  threshold    integer
}

@sdk
@executor("integration.shopify.commerceCustomers")
@description("Repeat-customer and refund rates for a window, from the mirror. Repeat rate is customers with more than one order over customers with any; refund rate is refunds over orders. For the store's owner or a cluster owner; anybody else is refused before the mirror is read.")
builtin commerceCustomers {
  storeId  string  @description("The store. When omitted: the only configured store for a cluster owner; for anybody else the one store they own, and a storeId is asked for when they own several.")
  from     string
  to       string
}

@sdk
@executor("integration.shopify.commerceCompany")
@description("One B2B account: its orders in a window, how many still have payment terms outstanding, and its MemQL-owned credit limit. The two halves come from different systems, and the question a rep asks -- can this account order -- needs both. For the store's owner or a cluster owner; anybody else is refused before the mirror is read.")
builtin commerceCompany {
  storeId     string  @description("The store. When omitted: the only configured store for a cluster owner; for anybody else the one store they own, and a storeId is asked for when they own several.")
  companyGid  string
  from        string
  to          string
}

/// Ask one store's Storefront API the three questions a storefront preview can answer (epic
/// memql#5531, issue memql#5547): does the catalog read, does a cart accept a line, does a
/// checkoutUrl come back.
///
/// IT CREATES A CART, and saying so is part of the contract rather than a footnote. That is the
/// thing being observed, which is why it is pointed at a DEVELOPMENT store by a guard one level up
/// (component/sitepreview) rather than being safe to run anywhere. Nothing is paid for and no order
/// is placed; the payment walk happens in a browser on Shopify's hosted checkout and is not
/// something this cluster can observe at all.
///
/// IT WRITES NOTHING. The observation rows these results become are written by `sitePreviewProbe`,
/// which calls this and owns v1:platform:sitePreviewObservation. The split is the module taxonomy:
/// the call to Shopify lives in the package this repository classifies as the one that talks to
/// Shopify, and the rows live with the concept that declares them.
///
/// The reply never carries the checkout URL -- only its host. An observation row is readable by
/// every operator the composite tier admits, and a checkout URL is a live cart somebody else could
/// pay from.
@sdk
@executor("integration.shopify.storefrontProbe")
@requiresCapability("execute", "app:deployables/preview")
@description("Ask one store's Storefront API the three questions a storefront preview can answer: does the catalog read, does a cart accept a line, does a checkoutUrl come back. Creates a cart on the store and buys nothing. Returns {storeId, storeDomain, isDevelopment, catalog, cart, checkout}, each of the three {ok, detail, failure, durationMs}. For the store's owner, a cluster owner, or a caller who may read stores; anybody else is refused before Shopify is asked.")
builtin storefrontProbe {
  storeId  string  @description("The store to ask. When omitted: the only configured store for a cluster owner; for anybody else the one store they own, and a storeId is asked for when they own several.")
}

// The B2B writes the wholesale pack's entitlement adapters reach Shopify through (epic
// memql#5533, issues memql#5558 and memql#5559).
//
// THESE ARE THE ONLY CAPABILITIES IN THIS CONNECTOR THAT CHANGE WHAT SOMEBODY PAYS.
// Everything propagate.go pushes is a metafield in a namespace nobody else uses -- additive,
// invisible to a shopper, changing no price and no order. A catalog with a price list attached
// to a company location is a different kind of act, which is why integrations/shopify/wholesale.go
// is a separate file with its own rules: nothing is ever deleted, the catalog ceiling is reported
// before anything is created, and every object carries the MemQL application id that made it.
//
// THEY CARRY NO @requiresCapability, and that is deliberate rather than an omission. The
// authorization for granting a wholesale entitlement is the PACK'S and it is already three
// checks deep: only a Client principal may record a decision, only an approved application has
// an entitlement to provision, and only a caller who can read the application can decide it.
// A capability gate here would be a second, different answer to a question already answered --
// and it would have to be held by the client's own approval automation, which is exactly the
// process the pack deliberately does not own.
//
// THE PACK'S CHECKS ARE NOT THESE BUILTINS' GATE, THOUGH. A builtin with no @requiresCapability
// has no rank floor, so any signed-in caller can name one of these directly and never pass
// through the pack at all. Each handler therefore asks who is calling before it reads the store
// or asks Shopify anything (integrations/shopify/wholesale_capabilities.go, wholesaleStore): the
// engine's own call (internal origin), the store's owner, or a cluster owner. Anybody else is
// refused, in the same words whether or not the store exists.
@sdk
@executor("integration.shopify.provisionWholesale")
@description("Create or find one buyer's B2B account: a company stamped with the MemQL application id, its location, the buyer as a company contact, and an ACTIVE catalog with a price list. Idempotent -- a second call for one application finds the first company rather than making a twin. Refuses BEFORE creating anything when the store is below Plus and already holds its three company-location catalogs, answering {status: refused, reason} rather than an error so the caller can tell a ceiling from an outage. For the engine's own call (internal origin), the store's owner or a cluster owner; anybody else is refused before the store is read or Shopify is asked.")
builtin shopifyProvisionWholesale {
  storeId        string!  @description("The store to provision on.")
  applicationId  string!  @description("The MemQL application this grant came from. Becomes the company's externalId, which is what makes a retry find the first company.")
  companyName    string!  @description("The business being entitled.")
  buyerEmail     string!  @description("The applicant's email. The customer who becomes the company contact; created when the store has none.")
  buyerName      string   @description("The applicant's name, split on the last space into the two fields Shopify wants.")
  catalogTitle   string   @description("Defaults to '<company> wholesale'.")
  percentOff     integer  @description("Whole-number percentage off published prices. Zero creates the price list with no adjustment, which is somewhere for the merchant to put real per-variant prices.")
  currencyCode   string   @description("The price list currency.")
}

@sdk
@executor("integration.shopify.revokeWholesale")
@description("End a B2B entitlement by setting its catalog to DRAFT. DELETES NOTHING: the company, its location, its contact, the price list and every order placed under them are untouched, because revoking trade terms is ending a discount rather than erasing a customer -- and deleting a company would take its order history's association with it. For the engine's own call (internal origin), the store's owner or a cluster owner; anybody else is refused before the store is read or Shopify is asked.")
builtin shopifyRevokeWholesale {
  storeId    string!  @description("The store.")
  reference  string!  @description("The encoded refs a provision returned. Opaque to the pack, which never parses it.")
}

@sdk
@executor("integration.shopify.tagWholesaleCustomer")
@description("The plan-independent grant: add one tag to the buyer's customer record. Writes the tag and NOTHING else -- what the tag does is the merchant's own automatic discount, which this connector deliberately does not create on their behalf. Refuses when no customer on the store has that email, because a tag on an account that does not exist entitles nobody. For the engine's own call (internal origin), the store's owner or a cluster owner; anybody else is refused before the store is read or Shopify is asked.")
builtin shopifyTagWholesaleCustomer {
  storeId     string!  @description("The store.")
  buyerEmail  string!  @description("The customer to tag.")
  tag         string  @description("Defaults to memql-wholesale. Prefixed with ours so this connector never removes a tag somebody else put there.")
}

@sdk
@executor("integration.shopify.untagWholesaleCustomer")
@description("The plan-independent revoke: remove that one tag from the buyer's customer record. For the engine's own call (internal origin), the store's owner or a cluster owner; anybody else is refused before the store is read or Shopify is asked.")
builtin shopifyUntagWholesaleCustomer {
  storeId     string!  @description("The store.")
  buyerEmail  string!  @description("The customer to untag.")
  tag         string  @description("Defaults to memql-wholesale.")
}

@sdk
@executor("integration.shopify.wholesaleCatalogHeadroom")
@description("How many more company-location catalogs this store may hold: -1 on Plus, which is unlimited, and otherwise three minus what it already has. Since 2026-04-02 companies, payment terms, volume pricing and up to three catalogs are available BELOW Plus, so the ceiling is real and this is what lets an adapter REPORT it rather than discover it at the fourth grant, in a merchant's live store. For the engine's own call (internal origin), the store's owner or a cluster owner; anybody else is refused before the store is read or Shopify is asked.")
builtin shopifyWholesaleCatalogHeadroom {
  storeId  string!  @description("The store to measure.")
}

// ---- Connect Shopify: the Store panel's four calls (design 12.1-12.5) ----
//
// EVERY CALL NAMES A SITE, NEVER A SHOP. The store is resolved on the server
// (integrations/shopify ResolveConnectSite): the caller must be able to WRITE
// the site, it must be a shopify_storefront, and the shop is the one named by
// the package run that last published it. A browser that could name the shop
// could point its own storefront's credentials at somebody else's store.
//
// ALL FOUR TAKE THE STORE PART. The writes behind them run as the deployment
// (the connector's operatorContext), because a store row and its sealed secrets
// are the cluster's rather than a person's -- which is exactly why the part, and
// the site checks after it, are the whole of who may reach those writes. Begin's
// one write, the connect state, is the exception: it names the person, so it is
// written as them, through component/identity's Store.
//
// THE THREE WRITES ARE A CLUSTER OWNER'S (memql#5638, G9). They take a person's
// own Shopify app credentials and pasted Storefront tokens, and MemQL OS no
// longer calls them: people connect a store through Settings -> Connections,
// where Shopify's launch and the operator's registered app are the only inputs
// (shopifyAccountConnectBegin, below). They stay for an owner repairing a store
// by hand and for any product bundle still calling them. The floor is in each
// handler, because a builtin carries no @requiresRank, and the callback asks it
// of the person again; the store part stays the first gate.

/// Where one storefront stands with Connect Shopify (design 12.2) -- what the Store panel draws, and
/// the only thing it draws from: a binding says nothing about whether a store is connected.
///
/// `reason` is 'ok' when the storefront resolved, and otherwise one of site_not_writable,
/// not_a_storefront, store_not_named or store_redacted, with every other key present and empty.
/// `appSaved` is true when the store has a live appClientId or a pending app was saved; `pendingApp`
/// when a pending app is waiting for an approval; `connected` when the store has an Admin token;
/// `storefrontTokenSet` when it names a Storefront token. `requiredScopes` is the one scope list the
/// Shopify app must request, Storefront scopes first; `grantedScopes` is what the store was granted.
/// Never returns a credential.
@sdk
@executor("integration.shopify.connectStatus")
@requiresCapability("execute", "app:deployables/store")
@description("Where one storefront stands with Connect Shopify, read from the store the server resolves for the site -- never from its binding. Returns {reason, storeId, shopDomain, appSaved, pendingApp, connected, storefrontTokenSet, requiredScopes, grantedScopes}; reason is 'ok', or site_not_writable, not_a_storefront, store_not_named or store_redacted. Never returns a credential.")
builtin shopifyConnectStatus {
  siteId  string!  @description("The storefront deployable. The shop is resolved on the server from the package run that last published it.")
}

/// Save the Shopify app's client ID and secret from a storefront's Store panel (design 12.3, D7).
///
/// PENDING ONLY (D12). The client ID lands as the globalVariable SHOPIFY_<ID>_PENDING_CLIENT_ID and
/// the secret, sealed on the server, as the globalSecret SHOPIFY_<ID>_PENDING_CLIENT_SECRET. The store
/// row, its live appClientId and the secret that verifies its webhooks are never touched: saving
/// proves nothing about the shop, so it can move nothing a webhook is checked with. They change only
/// after the shop's own staff approve Connect Shopify.
///
/// Reserved to a cluster owner (memql#5638): any other caller is refused before anything is read.
@sdk
@executor("integration.shopify.storeAppSave")
@requiresCapability("execute", "app:deployables/store")
@description("Cluster owners only. Save a Shopify app's client ID and client secret for a storefront's store, as PENDING credentials that take effect only after the shop's staff approve Connect Shopify. The secret crosses the wire once, is sealed server-side under MEMQL_MASTER_KEY, and appears in no row, log line or reply; the store row and its live credentials are untouched. Returns {reason, storeId, shopDomain}; reason is 'ok', a resolution refusal (site_not_writable, not_a_storefront, store_not_named, store_redacted), app_credentials_invalid, or secret_name_ambiguous when more than one secret row carries the name.")
builtin shopifyStoreAppSave {
  siteId        string!  @description("The storefront deployable whose store the app belongs to.")
  clientId      string!  @description("The Shopify app's client ID, from the Dev Dashboard.")
  clientSecret  string!  @secret @description("The Shopify app's client secret. Read once, sealed, and discarded; never stored or echoed in the clear.")
}

/// Begin Connect Shopify for a storefront's store (design 12.4, D1, D10): answer the URL the browser
/// navigates to -- Shopify's approve page for the shop the server resolved -- with a single-use state
/// bound to the caller.
///
/// The app Shopify is asked to approve is the PENDING one a save left, when there is one, otherwise
/// the store's current app and its webhook secret; with neither the reason is shopify_app_not_saved
/// and nothing is written. The state (v1:identity:githubConnectState, purpose shopify_connect) names
/// the shop, the site, the app's client id and which secret verifies the callback, and lives ten
/// minutes. The plaintext state appears only inside authorizeUrl; only its digest is stored. The
/// redirect is this cluster's own identity service, never anything the request said.
///
/// Reserved to a cluster owner (memql#5638), at Begin and again at the callback.
@sdk
@executor("integration.shopify.connectBegin")
@requiresCapability("execute", "app:deployables/store")
@description("Cluster owners only. Begin Connect Shopify for a storefront's store. Writes a ten-minute single-use state bound to the caller and answers {authorizeUrl, reason}: navigate the browser to authorizeUrl, Shopify's approve page for the shop the server resolved; Shopify redirects back to this cluster's identity service, which finishes the connection. reason is 'ok', a resolution refusal (site_not_writable, not_a_storefront, store_not_named, store_redacted), shopify_app_not_saved when neither a pending app nor the store's current app is saved (authorizeUrl empty), or connect_state_invalid when the state could not be stored. Never returns a credential, and never echoes the state anywhere but inside authorizeUrl.")
builtin shopifyConnectBegin {
  siteId      string!  @description("The storefront deployable. The shop is resolved on the server from the package run that last published it.")
  returnPath  string   @description("Where in MemQL OS to land when Connect finishes -- a same-origin path. Anything absolute, protocol-relative or carrying a control character is dropped for the OS root.")
}

/// Use a pasted Storefront API token for a storefront's store, or clear the one it has (design 12.5, D8).
///
/// Reserved to a cluster owner (memql#5638), who may change the token served under every site bound
/// to the store. A token is checked with one Storefront request before it is sealed; an empty token
/// clears the reference so the next Connect mints one, and is refused while a live storefront is
/// bound to the store.
@sdk
@executor("integration.shopify.storefrontTokenSet")
@requiresCapability("execute", "app:deployables/store")
@description("Cluster owners only. Seal a pasted Storefront API token for a storefront's store and point the store at it, or, with an empty token, clear the store's Storefront token so the next Connect Shopify mints one. A token is checked with one Storefront API request first. Returns {reason, storeId, shopDomain}; reason is 'ok', a resolution refusal, store_not_connected (the store has no row yet), storefront_token_required (clearing while a live storefront is bound), storefront_token_invalid, or secret_name_ambiguous.")
builtin shopifyStorefrontTokenSet {
  siteId  string!  @description("The storefront deployable whose store the token is for.")
  token   string   @secret @description("The Storefront API token. Empty clears the store's token. Read once, sealed, and discarded.")
}

/// Provider readiness contains no client credentials. Registration belongs to
/// the cluster operator; people authorize through Shopify.
@sdk
@executor("integration.shopify.connectionProviderStatus")
@requiresCapability("read", "app:settings/connections")
builtin shopifyConnectionProviderStatus { }

/// Begin a reusable personal store connection without changing any deployable.
/// The shop is derived from a recent signed Shopify App URL launch, then authorized
/// through the session-bound callback. No caller-supplied store address is accepted.
@sdk
@executor("integration.shopify.accountConnectBegin")
@requiresCapability("execute", "app:settings/connections")
builtin shopifyAccountConnectBegin {
  signedQuery string!
  returnPath string
}

/// The store statistics rollup (the 2026-11-11 store statistics design). NO @sdk: it is the
/// storeStatisticsRollupSweep automation's work, and its handler admits that automation's
/// maintenance principal at internal origin and no other caller, a cluster owner included. It reads
/// the stores and their mirror rows from Go, never as statements of the automation, and answers
/// counts: the engine's work journal keeps what an automation step answers, and two of the walk's
/// reads carry a buyer's email.
@executor("integration.storeStats.rollup")
@description("Keep every store's statistics. Lists every configured store through the engine, gives each its row in the store statistics tables, and walks each in turn, one store's failure leaving the next walked; one run at a time on a node. Answers {stores, rows, facts, unreadable, behind, rebuilt, removed}: counts, and the ids of the stores the lists name, never a row.")
builtin storeStatisticsRollup { }

/// One store's sales figures (the 2026-11-11 store statistics design, U9), the read the Store
/// statistics page of a storefront deployable calls. Gated twice: the engine judges the sales part
/// in the organization of the site `siteId` names, and the handler judges it again in Go against the
/// site it reads under the caller's own context, then holds the store to the site's own bound or
/// preview store. Nothing of a store is read before both have answered. The figures are read from
/// the component's own tables, never from an order row, so the caller need not be a cluster owner.
@sdk
@executor("integration.storeStats.statistics")
@args(profile="object")
@requiresCapability("execute", "app:deployables/sales")
@description("One store's sales figures for a period, for the store statistics page of a storefront deployable. Answers one row: the store (storeName, storeDomain, currency, timezone as the store recorded it, development, taxesIncluded), which of the site's bindings names it (destination: binding, previewBinding, or both when the two name the one store), the period cut in periodZone, the store's own zone or UTC when it has none that loads (start, end, prevStart, bucket, series), and how current the figures are (recording: its state, which is the verdict's word or purging or rebuilding while the store's figures are being deleted or rebuilt, every reason with its sentence, since, and blocked; asOf, set only while something stands in the way; rebuilding), then the figures. Money is a decimal string; a figure that is not known is null and never zero. For a caller who holds execute on app:deployables/sales in the site's organization, in their own session, asking for the site's own bound or preview store. A caller the engine's capability gate refuses gets its capability_not_held refusal; a period that is not one of the five gets the period's own sentence; every other refusal is one sentence, 'This deployable does not serve that store for you.' No refusal reads anything of a store.")
builtin storeStatistics {
  siteId   string!  @description("The storefront deployable.")
  storeId  string!  @description("The store of one of its destinations, as a bare id.")
  period   string!  @description("24h, 7d, 30d, 90d or 12m.")
}

/// The store statistics check (the 2026-11-11 store statistics design). NO @sdk: it is the
/// storeStatisticsCheckSweep automation's work, and its handler admits that automation's maintenance
/// principal at internal origin and no other caller, a cluster owner included. It walks each
/// caught-up store's mirror rows again from Go and answers counts, for the rollup's reasons.
@executor("integration.storeStats.check")
@description("Carry every store's check pass on: walk each caught-up store's mirrored orders, lines and refunds again from its floor, compare each fact with what its row gives now by version and by content, write again what differs, and at the end of a pass delete, in batches, the facts no row answers for. Answers {stores, compared, mismatched, repaired, disagreeing, finished}: counts (compared counts comparisons, not rows: a row an overlap reads again is compared again), and the ids of the stores whose pass ended, never a row.")
builtin storeStatisticsCheck { }

/// Rebuild one store's statistics. NO @sdk, and no rank floor of the engine's: its handler admits a
/// person who is a cluster owner and nobody else, a maintenance principal included, before it reads
/// the store id. The walk then deletes the store's facts in batches and refills them, and a check
/// begins once it has caught up; storeStatisticsCheckState says when that check ended clean.
@executor("integration.storeStats.rebuild")
@description("Cluster owners only. Rebuild one store's statistics: raise its generation, mark it rebuilding and delete its watermarks and check row, so the walk deletes its facts in batches and refills them, and a check begins when the walk has caught up. A store the statistics hold no row for is refused. Answers {storeId, rebuildingSince}.")
builtin storeStatisticsRebuild {
  storeId  string!  @description("The store, as its bare id or v1:shopify:store:<id>.")
}

/// One store's check, as the statistics hold it. NO @sdk: its handler admits a person who is a
/// cluster owner and nobody else, before it reads the store id.
@executor("integration.storeStats.checkState")
@description("Cluster owners only. One store's check: when the pass under way began, when the last pass began and ended, when one last ended with nothing mismatched, and that last pass's counts: compared (comparisons, not rows: a row an overlap reads again is compared again), mismatched, repaired and disagreeing; a time that never was is null. A store the statistics hold no row for is refused. Answers one node, checkState: {storeId, passUnderWaySince, lastStartedAt, lastFinishedAt, cleanAt, compared, mismatched, repaired, disagreeing}.")
builtin storeStatisticsCheckState {
  storeId  string!  @description("The store, as its bare id or v1:shopify:store:<id>.")
}
