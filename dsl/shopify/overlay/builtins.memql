@sdk
@executor("integration.shopify.ensureSubscriptions")
@description("Register every mirrored webhook topic for every ingesting store at the pinned API version, update the ones whose URL, version or includeFields have drifted, and remove ours the allowlist no longer wants. Shopify deletes a subscription after eight consecutive delivery failures, so this is what brings a store back after an outage. Records the outcome on each store's health.")
builtin shopifyEnsureSubscriptions {
}

@sdk
@executor("integration.shopify.runComplianceJobs")
@description("Run the queued privacy jobs whose hold has elapsed: export a customer's data to the Library, scrub a redacted customer's PII across every version, purge a redacted shop's whole mirror. Every action is audited; shop/redact re-checks reachability first so a reverted uninstall does not cost the mirror.")
builtin shopifyRunComplianceJobs {
}

@sdk

@executor("integration.shopify.fetchProduct")
@description("Read a mirrored Shopify product by GID or handle. Answers from the mirror, so it costs no Admin API call and no cost points. Tokens never appear in the reply.")
builtin shopifyFetchProduct {
  storeId  string
  id       string
  handle   string
}

@sdk
@executor("integration.shopify.shopifyql")
@description("Run an ad-hoc ShopifyQL analytics query for questions the mirror cannot answer. Requires read_reports and protected-customer-data Level 2 approval; refused below that with a reason naming the level, which Shopify's own 403 does not.")
builtin shopifyql {
  storeId  string
  query    string
}

@sdk
@executor("integration.shopify.storeHealth")
@description("Report every configured store's status, granted-versus-needed scopes, subscription reconcile time, cost-bucket state and per-domain sync state with drift counters. The read behind the portal's Stores page.")
builtin shopifyStoreHealth {
  storeId  string
}

@sdk
@executor("integration.shopify.commerceSold")
@description("What sold in a window, grouped by product or by variant, read entirely from the mirror -- no Admin API call and no cost points. Reports units and orders per line, and reports truncated=true when the walk hit its page cap rather than returning a smaller number and letting the caller believe it.")
builtin commerceSold {
  storeId  string
  from     string
  to       string
  groupBy  string
}

@sdk
@executor("integration.shopify.commerceStock")
@description("Inventory levels below a threshold at one location. Shopify models inventory as NAMED quantities (available, committed, on_hand), so the threshold is applied in Go and a level with no `available` count reads as unknown rather than as a stockout.")
builtin commerceStock {
  storeId      string
  locationGid  string
  threshold    integer
}

@sdk
@executor("integration.shopify.commerceCustomers")
@description("Repeat-customer and refund rates for a window, from the mirror. Repeat rate is customers with more than one order over customers with any; refund rate is refunds over orders.")
builtin commerceCustomers {
  storeId  string
  from     string
  to       string
}

@sdk
@executor("integration.shopify.commerceCompany")
@description("One B2B account: its orders in a window, how many still have payment terms outstanding, and its MemQL-owned credit limit. The two halves come from different systems, and the question a rep asks -- can this account order -- needs both.")
builtin commerceCompany {
  storeId     string
  companyGid  string
  from        string
  to          string
}

/// Ask one store's Storefront API the three questions a storefront preview can answer (epic
/// memql#5531, issue memql#5547): does the catalog read, does a cart accept a line, does a
/// checkoutUrl come back.
///
/// IT CREATES A CART, and saying so is part of the contract rather than a footnote. That is the
/// thing being observed, which is why it is pointed at a DEVELOPMENT store by a guard one level up
/// (component/sitepreview) rather than being safe to run anywhere. Nothing is paid for and no order
/// is placed; the payment walk happens in a browser on Shopify's hosted checkout and is not
/// something this cluster can observe at all.
///
/// IT WRITES NOTHING. The observation rows these results become are written by `sitePreviewProbe`,
/// which calls this and owns v1:platform:sitePreviewObservation. The split is the module taxonomy:
/// the call to Shopify lives in the package this repository classifies as the one that talks to
/// Shopify, and the rows live with the concept that declares them.
///
/// The reply never carries the checkout URL -- only its host. An observation row is readable by
/// every operator the composite tier admits, and a checkout URL is a live cart somebody else could
/// pay from.
@sdk
@executor("integration.shopify.storefrontProbe")
@requiresCapability("execute", "app:deployables/preview")
@description("Ask one store's Storefront API the three questions a storefront preview can answer: does the catalog read, does a cart accept a line, does a checkoutUrl come back. Creates a cart on the store and buys nothing. Returns {storeId, storeDomain, isDevelopment, catalog, cart, checkout}, each of the three {ok, detail, failure, durationMs}.")
builtin storefrontProbe {
  storeId  string  @description("The store to ask. The only configured store when omitted.")
}

// The B2B writes the wholesale pack's entitlement adapters reach Shopify through (epic
// memql#5533, issues memql#5558 and memql#5559).
//
// THESE ARE THE ONLY CAPABILITIES IN THIS CONNECTOR THAT CHANGE WHAT SOMEBODY PAYS.
// Everything propagate.go pushes is a metafield in a namespace nobody else uses -- additive,
// invisible to a shopper, changing no price and no order. A catalog with a price list attached
// to a company location is a different kind of act, which is why integrations/shopify/wholesale.go
// is a separate file with its own rules: nothing is ever deleted, the catalog ceiling is reported
// before anything is created, and every object carries the MemQL application id that made it.
//
// THEY CARRY NO @requiresCapability, and that is deliberate rather than an omission. The
// authorization for granting a wholesale entitlement is the PACK'S and it is already three
// checks deep: only a Client principal may record a decision, only an approved application has
// an entitlement to provision, and only a caller who can read the application can decide it.
// A capability gate here would be a second, different answer to a question already answered --
// and it would have to be held by the client's own approval automation, which is exactly the
// process the pack deliberately does not own.
@sdk
@executor("integration.shopify.provisionWholesale")
@description("Create or find one buyer's B2B account: a company stamped with the MemQL application id, its location, the buyer as a company contact, and an ACTIVE catalog with a price list. Idempotent -- a second call for one application finds the first company rather than making a twin. Refuses BEFORE creating anything when the store is below Plus and already holds its three company-location catalogs, answering {status: refused, reason} rather than an error so the caller can tell a ceiling from an outage.")
builtin shopifyProvisionWholesale {
  storeId        string!  @description("The store to provision on.")
  applicationId  string!  @description("The MemQL application this grant came from. Becomes the company's externalId, which is what makes a retry find the first company.")
  companyName    string!  @description("The business being entitled.")
  buyerEmail     string!  @description("The applicant's email. The customer who becomes the company contact; created when the store has none.")
  buyerName      string   @description("The applicant's name, split on the last space into the two fields Shopify wants.")
  catalogTitle   string   @description("Defaults to '<company> wholesale'.")
  percentOff     integer  @description("Whole-number percentage off published prices. Zero creates the price list with no adjustment, which is somewhere for the merchant to put real per-variant prices.")
  currencyCode   string   @description("The price list currency.")
}

@sdk
@executor("integration.shopify.revokeWholesale")
@description("End a B2B entitlement by setting its catalog to DRAFT. DELETES NOTHING: the company, its location, its contact, the price list and every order placed under them are untouched, because revoking trade terms is ending a discount rather than erasing a customer -- and deleting a company would take its order history's association with it.")
builtin shopifyRevokeWholesale {
  storeId    string!  @description("The store.")
  reference  string!  @description("The encoded refs a provision returned. Opaque to the pack, which never parses it.")
}

@sdk
@executor("integration.shopify.tagWholesaleCustomer")
@description("The plan-independent grant: add one tag to the buyer's customer record. Writes the tag and NOTHING else -- what the tag does is the merchant's own automatic discount, which this connector deliberately does not create on their behalf. Refuses when no customer on the store has that email, because a tag on an account that does not exist entitles nobody.")
builtin shopifyTagWholesaleCustomer {
  storeId     string!  @description("The store.")
  buyerEmail  string!  @description("The customer to tag.")
  tag         string  @description("Defaults to memql-wholesale. Prefixed with ours so this connector never removes a tag somebody else put there.")
}

@sdk
@executor("integration.shopify.untagWholesaleCustomer")
@description("The plan-independent revoke: remove that one tag from the buyer's customer record.")
builtin shopifyUntagWholesaleCustomer {
  storeId     string!  @description("The store.")
  buyerEmail  string!  @description("The customer to untag.")
  tag         string  @description("Defaults to memql-wholesale.")
}

@sdk
@executor("integration.shopify.wholesaleCatalogHeadroom")
@description("How many more company-location catalogs this store may hold: -1 on Plus, which is unlimited, and otherwise three minus what it already has. Since 2026-04-02 companies, payment terms, volume pricing and up to three catalogs are available BELOW Plus, so the ceiling is real and this is what lets an adapter REPORT it rather than discover it at the fourth grant, in a merchant's live store.")
builtin shopifyWholesaleCatalogHeadroom {
  storeId  string!  @description("The store to measure.")
}
