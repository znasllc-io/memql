// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@description("Get active human participants in a space")
@unbounded("human participants in a space -- a bounded membership set consumed whole for routing")
query participant activeHumanParticipants {
  args {
    partitionId  string!
  }
  filter  partitionId==args.partitionId && participantType=="human" && statusIsActive
  shape   participantFull
}

// queryLatestSpaceContextForSpace + queryLatestSpaceContextSnapshot
// were extracted to the product pack
// (the carrier repo's pack queries file) by Epic 3
// (3.3b-i, memql#1991) along with the v1:cognition:space:context
// concept (ids preserved).

// ---- queries/v1/cognition/agentInteractionCount.memql ----

// agentInteractionCount - Cross-space agent interaction signal
// =================================================================
//
// Returns the count of utterances posted by a given agent across
// EVERY space in the current partition (i.e. for this user). Used
// by the agent reply prompt's "agentIsKnownToUser" signal so the
// agent can frame its first turn correctly: a non-zero count means
// the user has worked with this agent before -- skip the
// "Hi everyone, I am X" introduction. Zero means it really is a
// first meeting and a brief warm intro is appropriate.
//
// Why this query exists: greetOnJoinAI's "have we already greeted?"
// check is space-scoped (greetingUtterance filters by partitionId).
// The over-introduction symptom -- agent re-introduces in every new
// space even though the user has talked to them many times -- is
// exactly that gap. This query is the partition-scoped counterpart
// the prompt-side framing reads instead.
//
// Arguments:
//   agentId (string, required) - The agent ID to count utterances for
//
// Returns:
//   Array of utterance records (may be large; the caller typically
//   only needs to know empty-vs-non-empty, but the full list is
//   available for future use cases like "last interaction was N
//   minutes ago" framing).
//
// Usage:
//   agentInteractionCount({agentId: "<agent-id>"})
//

@description("Count utterances by an agent across ALL spaces in the current partition. Drives the agentIsKnownToUser signal.")
query utterance agentInteractionCount {
  args {
    agentId  string!
  }
  filter  source.agentId==args.agentId && utteranceType in ["speech", "agentGreeting"] && isActiveRecord
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   utteranceFull
}

// ---- queries/v1/cognition/allArchivedSpacesAcrossUsers.memql ----

// allArchivedSpacesAcrossUsers - Cron Sweep Helper
// =================================================
//
// Scoped helper used ONLY by the purgeExpiredArchivedSpaces cron
// automation. Returns every archived space in the partition,
// regardless of creator -- the cron then iterates each row, looks up
// the creator's archiveRetentionDays preference, and decides whether
// to hard-delete based on `now > archivedAt + retentionDays`.
//
// Distinct from queryArchivedSpaces (which is scoped to a single user
// for the SpacesListPanel's Archived tab). This one is the cross-user
// view the sweep needs.
//
// No userId filter on purpose -- the cron must see every user's
// archived rows in one pass.

// ---- queries/v1/cognition/archivedSpaces.memql ----

// archivedSpaces - Query Archived Spaces
// =======================================
//
// Returns spaces with space.status == "archived". Archived spaces
// are hidden from the Active tab and on a retention countdown to
// hard-delete -- the purgeExpiredArchivedSpaces cron uses space.archivedAt
// against User.preferences.archiveRetentionDays to decide when each
// row gets a deleted=true marker.
//
// Drives the Archived tab in the SpacesListPanel. The frontend reads
// space.archivedAt + the user's retention preference to render a
// "Auto-deletes in N days" countdown badge per row -- last call before
// purge.
//
// Arguments:
//   userId (string, optional)   - Filter by owner (matches payload.ownerUserId,
//                                 a v1:identity:user id -- NOT the createdBy
//                                 email). Frontend passes the current user's id.
//
// Returns:
//   Array of space records via the spaceFull shape (includes archivedAt).
//
// NOTE: archived spaces carry active=false (mutationArchiveSpace /
// the frontend's archiveSpace wrapper set it), so this query does NOT apply
// isActiveRecord -- that would exclude every archived row. It gates
// on status=='archived' and excludes hard-delete tombstones via
// isNotDeleted.

// ---- queries/v1/cognition/ownedSpaceById.memql ----

// The row's `partitionId` is auto-canonicalized to
// `<partition>:v1:cognition:space:<slug>` on insert (concept's
// @relationship annotation drives this). The frontend passes
// whatever it has -- usually the bare slug. Canonicalize the
// arg before the equality check so both forms resolve to the
// same value and the comparison matches.
@description("Active audio overrides for every agent in a space. Read by the cognition handler before TTS forwarding.")
@unbounded("audio overrides for a space -- bounded by space participants, consumed whole")
query audioOverride audioOverridesForSpace {
  args {
    partitionId  string!
  }
  filter  partitionId==args.partitionId && isActiveRecord
  shape   audioOverrideFull
}

// queryActiveGreetSuppression was extracted to the product pack
// (the carrier repo's pack queries file) by Epic 3
// (3.3b-i, memql#1991) along with the v1:cognition:greetSuppression
// concept (ids preserved).

// ---- queries/v1/cognition/expiredArchivedSpaces.memql ----

// queryExpiredArchivedSpaces
// ===========================
//
// Returns archived spaces whose pre-computed expiresAt is before the
// supplied `now` cutoff. Used by the purgeExpiredArchivedSpaces cron
// to sweep stale archives.
//
// expiresAt is stamped onto each archived row by the frontend
// (its archiveSpace mutation wrapper) as `archivedAt + retentionDays`,
// using the user's CURRENT archiveRetentionDays preference. When the
// user bumps retention 30->60, the SettingsListPanel handler
// re-stamps every currently-archived space's expiresAt so the bump
// extends them; deleted-already rows aren't restored, matching the
// product spec.
//
// The `now` cutoff is passed in as an arg (rather than referencing the clock inline)
// because the memQL query planner rejects function-call literals in
// filter comparisons (see queryExpiredPendingGuestInvitations).

// ---- queries/v1/cognition/greetingUtterance.memql ----

// greetingUtterance - Check for Existing Greeting
// ====================================================
//
// Checks if a greeting utterance already exists for a specific agent
// in a specific space. Prevents duplicate greetings.
//
// Arguments:
//   partitionId (string, required) - The space ID to check
//   agentId (string, required) - The agent ID to check
//
// Returns:
//   Array of utterance records (0 or more):
//   - id: Utterance identifier
//   - partitionId: Space identifier
//   - source: Object containing kind and agentId
//
// Usage:
//   greetingUtterance({partitionId: "space-123", agentId: "sofia"})
//

@description("Check if a greeting utterance already exists for an agent in a space")
@unbounded("the greeting utterance for (space,agent) -- bounded to a single row")
query utterance greetingUtterance {
  args {
    partitionId  string!
    agentId  string!
  }
  filter  partitionId==args.partitionId && source.agentId==args.agentId && source.kind in ["agentGreeting"] && isActiveRecord
  shape   utteranceFull
}

// Checks whether the assistant has already posted the
// awaitingFeedback announcement chat message for a specific Plan
// (epic memql#1404 / child #1406). The announcement utterance is
// stamped with source.feedbackAnnouncePlanId == <planId>; this
// read-before-write dedup is the fail-safe backstop behind the
// cross-replica advisory-lock gate (dispatchGate.tryAnnounceFeedback)
// so a duplicate plan-updated event while the Plan is still
// awaitingFeedback can't re-post the same "needs your input" message.
//
// Arguments:
//   planId (string, required) - The Plan whose announcement to check.
//
// Returns:
//   Array of utterance records (0 or more); non-empty means the
//   announcement was already posted.
@description("Check if the assistant already posted the awaitingFeedback announcement for a Plan (dedup behind the cross-replica announce gate, #1406).")
@unbounded("the feedback-announcement utterance for a plan -- bounded to a single row")
query utterance feedbackAnnouncementForPlan {
  args {
    planId  string!
  }
  filter  source.feedbackAnnouncePlanId==args.planId && isActiveRecord
  shape   utteranceFull
}

// Callers MUST pass the canonical partitionId
// (`v1:cognition:space:<slug>`). Using `canonicalId()`
// inside this predicate triggers the executor's "unsupported
// literal type *ast.CanonicalIdExpr" error path -- the SQL fast-
// path doesn't pre-evaluate canonicalId() when the rest of the
// WHERE chain includes a bool comparison, and the in-memory
// fallback comparator can't evaluate the AST node. Pre-
// canonicalize on the Go side instead.
//
// We intentionally do NOT filter by `isGroupGA==true`: the
// participant-update mutations (status flips, presence touch)
// re-insert the row without carrying the original isGroupGA flag,
// and memql's time-series semantics return the latest version --
// which often has isGroupGA missing/false even though the
// underlying participant IS the GA. Filtering by participantType
// + status is sufficient under v1 (each user has at most one
// active AI participant per space; that's their GA).
@description("Active AI (group GA) participant for a space. The partitionId arg is compared against the stored payload field, which holds the canonical v1:cognition:space id -- internal callers pass that form today; the arg flips to a bare space id with the #2441/#2443 cutover.")
@unbounded("the GA/assistant participant for a space -- bounded to a single row")
query participant groupGAForSpace {
  args {
    partitionId  string!
  }
  filter  partitionId==args.partitionId && participantType=="si" && statusIsActive
  shape   participantFull
}

// ---- queries/v1/cognition/hasAIResponseForReply.memql ----

// hasAIResponseForReply - Idempotency Check for AI Response
// ================================================================
//
// Checks whether an AI response already exists for a given utterance.
// Used as an idempotency guard to prevent duplicate AI responses
// when the same event is processed multiple times.
//
// Arguments:
//   replyToId (string, required)     - The utterance ID being replied to
//   participantId (string, required) - The AI participant ID that would be responding
//
// Returns:
//   Array of matching utterance records (0 = no response yet, 1+ = already responded)

@description("Check if an AI response already exists for a given utterance (idempotency check).")
@unbounded("existence probe for an AI response to a reply -- a dedupe gate bounded to a single row")
query utterance hasAIResponseForReply {
  args {
    replyToId  string!
    participantId  string!
  }
  filter  replyToId==args.replyToId && participantId==args.participantId
  shape   utteranceFull
}

// ---- queries/v1/cognition/participantByAgentSpace.memql ----

// participantByAgentSpace - Check if Agent Already in Space
// ===============================================================
//
// Checks if a specific AI agent is already participating in a space
// (status != "left"). Returns both "active" and "idle" participants --
// any participant that has NOT left the space. Used to prevent
// duplicate AI participant records during auto-join.
//
// NOTE: participant has no `active` boolean field; liveness is
// governed by `status`. This query intentionally uses
// `payload.status!="left"` (not isActiveRecord) so AI rows are
// not silently excluded.
//
// Arguments:
//   partitionId (string, required)  - The space ID to check
//   agentId (string, required)  - The agent ID to check
//
// Returns:
//   Array of participant records (should be 0 or 1 record)
//   - id: Participant identifier
//   - partitionId: Space identifier
//   - agentId: Agent identifier
//   - status: Participant status (excludes "left")
//
// Usage:
//   participantByAgentSpace({partitionId: "space-123", agentId: "sofia"})
//

@description("Check if an AI agent is already a participant in a space (excludes left status)")
@unbounded("the participant for (space,agent) -- bounded to a single row")
query participant participantByAgentSpace {
  args {
    partitionId  string!
    agentId  string!
  }
  filter  partitionId==args.partitionId && agentId==args.agentId && status!="left"
  shape   participantFull
}

// ---- queries/v1/cognition/participantSession.memql ----

// participantSession - Query Session State for Participants
// =========================================================
//
// Returns the real-time interaction session state for participants from the
// v1:cognition:session concept. Sessions track the current tier, device states
// (microphone/camera), AI output modes, and active stream identifiers.
//
// Sessions are created when a participant joins a space and track their
// moment-to-moment interaction state, separate from the participant record
// which tracks authorization and lifecycle.
//
// Arguments:
//   partitionId (string, optional)       - Filter by space ID to get all sessions in a space.
//   participantId (string, optional) - Filter by specific participant ID.
//
// Returns:
//   Array of session records with fields like:
//   - id: Unique session identifier
//   - session.partitionId: ID of the space this session belongs to
//   - session.participantId: ID of the participant this session tracks
//   - session.activeTier: Current interaction tier (text, speechToText, voiceToVoice, voiceAvatar, voiceVision)
//   - session.humanInput: Device states (microphoneEnabled, cameraEnabled)
//   - session.aiOutput: AI output states (voiceEnabled, avatarEnabled, visionEnabled)
//   - session.streams: Active stream IDs (realtimeSessionId, avatarStreamId)
//   - session.startedAt: When the session started
//   - session.lastActivityAt: Timestamp of last activity
//
// Usage:
//   participantSession()                                      // Returns all sessions
//   participantSession({"partitionId": "space-123"})              // Get all sessions in a space
//   participantSession({"participantId": "participant-456"})  // Get session for specific participant
//   participantSession({"partitionId": "space-123", "participantId": "participant-456"})  // Specific session
//

@description("Returns session state for participants in spaces. Optional filters: partitionId, participantId")
@unbounded("the participant session for (space,participant) -- bounded to a single row")
query session participantSession {
  args {
    partitionId  string
    participantId  string
  }
  filter  when(args.partitionId) { partitionId==args.partitionId } && when(args.participantId) { participantId==args.participantId }
  shape   sessionFull
}

// ---- queries/v1/cognition/savedSpaces.memql ----

// savedSpaces - Query Saved Spaces
// =================================
//
// Returns spaces with space.status == "saved". Saved spaces are
// manually preserved by the user (clicked "Save" in the SpacesListPanel
// or had their daily roll over via the rolloverDailySpace cron with
// preferences.dailySpaceRolloverAction == "save"). They never
// auto-delete -- the purgeExpiredArchivedSpaces cron only touches
// status == "archived" rows.
//
// Drives the Saved tab in the SpacesListPanel.
//
// Arguments:
//   userId (string, optional)   - Filter by owner (matches payload.ownerUserId,
//                                 a v1:identity:user id -- NOT the createdBy
//                                 email). Frontend passes the current user's id
//                                 so each user sees their own saved spaces.
//
// Returns:
//   Array of space records via the spaceFull shape.
//

// ---- queries/v1/cognition/aiParticipantForSpace.memql ----

// queryAIParticipantForSpace - Find Active AI Participant in Space
// =================================================================
//
// Finds the active AI participant in a given space. Returns the first
// AI participant with status "active". Used by the cognition automation
// to identify which AI agent is responding in a space.
//
// Arguments:
//   partitionId (string, required) - The space to search in
//
// Returns:
//   Array of AI participant records (typically 0 or 1)

@description("Find the active AI participant in a space.")
@unbounded("the assistant participant for a space -- bounded to a single row")
query participant siParticipantForSpace {
  args {
    partitionId  string!
  }
  filter  partitionId==args.partitionId && participantType=="si" && statusIsActive
  shape   participantFull
}

// querySpaceContext was extracted to the product pack
// (the carrier repo's pack queries file) by Epic 3
// (3.3b-i, memql#1991) along with the v1:cognition:space:context
// concept (ids preserved).

// ---- queries/v1/cognition/spaceMeta.memql ----

// querySpaceMeta - Full Space Record by ID
// =========================================
//
// Returns the space by id via the spaceFull shape. Every consumer
// that needs arbitrary space fields (owner, slot caps, selected
// agents) reads through this rather than re-declaring its own
// projection.
//
// Replaces the old `querySpaceArchitecture` query that existed to
// resolve the now-retired `architecture` field.
//
// Arguments:
//   partitionId (string, required) - The space ID to look up
//
// Returns:
//   Single shaped record (or empty) with name, description, status,
//   settings, slot capacities (maxHumans / maxAgents), selected
//   specialist agent ids, createdBy, and createdAt.

@description("Participants for a space, optionally narrowed by status or participantType. Used by the cognition handler + space-context engine.")
@unbounded("participants in a space -- a bounded membership roster consumed whole")
query participant spaceParticipants {
  args {
    partitionId          string!
    status           string
    participantType  string
  }
  filter  partitionId==args.partitionId && when(args.status) { status==args.status } && when(args.participantType) { participantType==args.participantType }
  shape   participantFull
}

// Caching (5.5 / memql#1969): the per-space message stream is the hottest
// read in the product (every chat render) and append-only, so a short TTL
// pays off without much staleness risk -- a new utterance evicts the cached
// page immediately via 5.4. SHORT TTL (30s) because the stream appends
// constantly. This query is keyset-paginated (sort+paginate below), so the
// result-cache key MUST include the cursor (engine.go cacheKey) -- without
// that fix page 2 would collide with the cached page 1. v1:cognition:* writes
// (created/updated/deleted) are forwarded cross-node in
// component/node/routing.go so eviction fires on every replica.
@description("Returns utterances for the given space. Optional participantId / utteranceType args narrow the result further. Used by the cockpit Chat tab to populate the utterance pane and by the BFF for downstream consumers.")
@cache(30)
query utterance spaceUtterances {
  args {
    partitionId          string!
    participantId    string
    utteranceType    string
  }
  filter  partitionId==args.partitionId && when(args.participantId) { participantId==args.participantId } && when(args.utteranceType) { utteranceType==args.utteranceType }
  // Pagination (5.2 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of the full message-history pull. The append-only
  // utterance stream is the canonical keyset-eligible shape. Literal page size
  // -- struct-query paginate takes an integer literal only.
  sort     "createdAt", "desc"
  paginate 50
  shape    utteranceFull
}

// queryUserMicStatesForSpace was extracted to the product pack
// (the carrier repo's pack queries file) by Epic 3
// (3.3b-i, memql#1991) along with the v1:cognition:micState concept
// (ids preserved).

// The row's `partitionId` is auto-canonicalized to
// `<partition>:v1:cognition:space:<slug>` on insert (concept's
// @relationship annotation drives this). The frontend passes
// whatever it has -- usually the bare slug. Canonicalize the
// arg before the equality check so both forms resolve to the
// same value and the comparison matches.
@description("Active video overrides for every agent in a space. Read by the voice-agent process at session start.")
@unbounded("video overrides for a space -- bounded by space participants, consumed whole")
query videoOverride videoOverridesForSpace {
  args {
    partitionId  string!
  }
  filter  partitionId==args.partitionId && isActiveRecord
  shape   videoOverrideFull
}

// querySpacePrivateUtterancesForViewer was extracted to the product
