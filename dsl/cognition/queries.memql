// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@enabled
@useConcept(participant)
@description("Get active human participants in a space")
query queryActiveHumanParticipants {
  args {
    spaceId  string  @required
  }
  filter  participant.spaceId==args.spaceId; participant.participantType=="human"; participant.status=="active"; traitIsActiveRecord
  shape   participantFull
}

func (Query) queryActiveSpaces(ctx any) (any, error) {
  ctx.output = shape(
    concept;
    traitIsActiveRecord;
    traitIsNotArchived;
    ?.createdBy==args.userId;
    ?.space.status==coalesce(args.status, "active"),
    "spaceFull"
  )
  return ctx, nil
}

// ---- queries/v1/cognition/agentInteractionCount.memql ----

// queryAgentInteractionCount - Cross-space agent interaction signal
// =================================================================
//
// Returns the count of utterances posted by a given agent across
// EVERY space in the current partition (i.e. for this user). Used
// by the agent reply prompt's "agentIsKnownToUser" signal so the
// agent can frame its first turn correctly: a non-zero count means
// the user has worked with this agent before -- skip the
// "Hi everyone, I am X" introduction. Zero means it really is a
// first meeting and a brief warm intro is appropriate.
//
// Why this query exists: greetOnJoinSI's "have we already greeted?"
// check is space-scoped (queryGreetingUtterance filters by spaceId).
// The over-introduction symptom -- agent re-introduces in every new
// space even though the user has talked to them many times -- is
// exactly that gap. This query is the partition-scoped counterpart
// the prompt-side framing reads instead.
//
// Arguments:
//   agentId (string, required) - The agent ID to count utterances for
//
// Returns:
//   Array of utterance records (may be large; the caller typically
//   only needs to know empty-vs-non-empty, but the full list is
//   available for future use cases like "last interaction was N
//   minutes ago" framing).
//
// Usage:
//   queryAgentInteractionCount({agentId: "<agent-id>"})
//

@enabled
@useConcept(utterance)
@description("Count utterances by an agent across ALL spaces in the current partition. Drives the agentIsKnownToUser signal.")
query queryAgentInteractionCount {
  args {
    agentId  string  @required
  }
  filter  utterance.source.agentId==args.agentId; utterance.utteranceType in ["speech", "agentGreeting"]; traitIsActiveRecord
  shape   utteranceFull
}

// ---- queries/v1/cognition/allArchivedSpacesAcrossUsers.memql ----

// allArchivedSpacesAcrossUsers - Cron Sweep Helper
// =================================================
//
// Scoped helper used ONLY by the purgeExpiredArchivedSpaces cron
// automation. Returns every archived space in the partition,
// regardless of creator -- the cron then iterates each row, looks up
// the creator's archiveRetentionDays preference, and decides whether
// to hard-delete based on `now > archivedAt + retentionDays`.
//
// Distinct from queryArchivedSpaces (which is scoped to a single user
// for the SpacesListPanel's Archived tab). This one is the cross-user
// view the sweep needs.
//
// No userId filter on purpose -- the cron must see every user's
// archived rows in one pass.

@enabled
@useConcept(space)
@description("Returns every archived space in the partition, for the purge cron's per-row retention check.")
query queryAllArchivedSpacesAcrossUsers {
  filter  traitIsActiveRecord; traitStatusIsArchived
  shape   spaceFull
}

// ---- queries/v1/cognition/archivedSpaces.memql ----

// archivedSpaces - Query Archived Spaces
// =======================================
//
// Returns spaces with space.status == "archived". Archived spaces
// are hidden from the Active tab and on a retention countdown to
// hard-delete -- the purgeExpiredArchivedSpaces cron uses space.archivedAt
// against User.preferences.archiveRetentionDays to decide when each
// row gets a deleted=true marker.
//
// Drives the Archived tab in the SpacesListPanel. The frontend reads
// space.archivedAt + the user's retention preference to render a
// "Auto-deletes in N days" countdown badge per row -- last call before
// purge.
//
// Arguments:
//   userId (string, optional)   - Filter by creator (matches createdBy).
//                                 Frontend passes the current user's
//                                 primary email.
//
// Returns:
//   Array of space records via the spaceFull shape (includes archivedAt).
//

@enabled
@useConcept(space)
@description("Returns spaces with space.status == 'archived'. Optional filter: userId (createdBy).")
query queryArchivedSpaces {
  args {
    userId  string
  }
  filter  traitIsActiveRecord; traitStatusIsArchived; ?.createdBy==args.userId
  shape   spaceFull
}

func (Query) queryAudioOverridesForSpace(ctx any) (any, error) {
  // The row's `spaceId` is auto-canonicalized to
  // `<partition>:v1:cognition:space:<slug>` on insert (concept's
  // @relationship annotation drives this). The frontend passes
  // whatever it has -- usually the bare slug. Canonicalize the
  // arg before the equality check so both forms resolve to the
  // same value and the comparison matches.
  ctx.output = shape(
    concept;
    ?.audioOverride.spaceId==canonicalId(args.spaceId, "v1:cognition:space");
    ?.audioOverride.active==true,
    "audioOverrideFull"
  )
  return ctx, nil
}

// ---- queries/v1/cognition/expiredArchivedSpaces.memql ----

// queryExpiredArchivedSpaces
// ===========================
//
// Returns archived spaces whose pre-computed expiresAt is before the
// supplied `now` cutoff. Used by the purgeExpiredArchivedSpaces cron
// to sweep stale archives.
//
// expiresAt is stamped onto each archived row by the frontend
// (copresentMutations.archiveSpace) as `archivedAt + retentionDays`,
// using the user's CURRENT archiveRetentionDays preference. When the
// user bumps retention 30->60, the SettingsListPanel handler
// re-stamps every currently-archived space's expiresAt so the bump
// extends them; deleted-already rows aren't restored, matching the
// product spec.
//
// `now` is passed in (rather than read via timestamp() inline)
// because the memQL query planner rejects function-call literals in
// filter comparisons (see queryExpiredPendingGuestInvitations).

@enabled
@useConcept(space)
@description("Archived spaces whose space.expiresAt is before the supplied cutoff.")
query queryExpiredArchivedSpaces {
  args {
    now  string  @required
  }
  filter  traitIsActiveRecord; traitStatusIsArchived; space.expiresAt<args.now
  shape   spaceFull
}

// ---- queries/v1/cognition/greetingUtterance.memql ----

// queryGreetingUtterance - Check for Existing Greeting
// ====================================================
//
// Checks if a greeting utterance already exists for a specific agent
// in a specific space. Prevents duplicate greetings.
//
// Arguments:
//   spaceId (string, required) - The space ID to check
//   agentId (string, required) - The agent ID to check
//
// Returns:
//   Array of utterance records (0 or more):
//   - id: Utterance identifier
//   - spaceId: Space identifier
//   - source: Object containing kind and agentId
//
// Usage:
//   queryGreetingUtterance({spaceId: "space-123", agentId: "sofia"})
//

@enabled
@useConcept(utterance)
@description("Check if a greeting utterance already exists for an agent in a space")
query queryGreetingUtterance {
  args {
    spaceId  string  @required
    agentId  string  @required
  }
  filter  utterance.spaceId==args.spaceId; utterance.source.agentId==args.agentId; utterance.source.kind in ["agentGreeting"]; traitIsActiveRecord
  shape   utteranceFull
}

func (Query) queryGroupGAForSpace(ctx any) (any, error) {
  // Callers MUST pass the canonical spaceId
  // (`<partition>:v1:cognition:space:<slug>`). Using `canonicalId()`
  // inside this predicate triggers the executor's "unsupported
  // literal type *ast.CanonicalIdExpr" error path -- the SQL fast-
  // path doesn't pre-evaluate canonicalId() when the rest of the
  // WHERE chain includes a bool comparison, and the in-memory
  // fallback comparator can't evaluate the AST node. Pre-
  // canonicalize on the Go side instead.
  //
  // We intentionally do NOT filter by `isGroupGA==true`: the
  // participant-update mutations (status flips, presence touch)
  // re-insert the row without carrying the original isGroupGA flag,
  // and memql's time-series semantics return the latest version --
  // which often has isGroupGA missing/false even though the
  // underlying participant IS the GA. Filtering by participantType
  // + status is sufficient under v1 (each user has at most one
  // active SI participant per space; that's their GA).
  ctx.output = shape(
    concept;
    participant.spaceId==args.spaceId;
    participant.participantType=="si";
    participant.status=="active",
    "participantFull"
  )
  return ctx, nil
}

// ---- queries/v1/cognition/hasSIResponseForReply.memql ----

// queryHasAIResponseForReply - Idempotency Check for SI Response
// ================================================================
//
// Checks whether an SI response already exists for a given utterance.
// Used as an idempotency guard to prevent duplicate SI responses
// when the same event is processed multiple times.
//
// Arguments:
//   replyToId (string, required)     - The utterance ID being replied to
//   participantId (string, required) - The SI participant ID that would be responding
//
// Returns:
//   Array of matching utterance records (0 = no response yet, 1+ = already responded)

@enabled
@useConcept(utterance)
@description("Check if an SI response already exists for a given utterance (idempotency check).")
query queryHasSIResponseForReply {
  args {
    replyToId  string  @required
    participantId  string  @required
  }
  filter  utterance.replyToId==args.replyToId; utterance.participantId==args.participantId
  shape   utteranceFull
}

// ---- queries/v1/cognition/participantByAgentSpace.memql ----

// queryParticipantByAgentSpace - Check if Agent Already in Space
// ===============================================================
//
// Checks if a specific AI agent is already participating in a space.
// Used to prevent duplicate AI participant records during auto-join.
//
// Arguments:
//   spaceId (string, required)  - The space ID to check
//   agentId (string, required)  - The agent ID to check
//
// Returns:
//   Array of participant records (should be 0 or 1 record)
//   - id: Participant identifier
//   - spaceId: Space identifier
//   - agentId: Agent identifier
//   - status: Participant status (excludes "left")
//
// Usage:
//   queryParticipantByAgentSpace({spaceId: "space-123", agentId: "sofia"})
//

@enabled
@useConcept(participant)
@description("Check if an AI agent is already a participant in a space (excludes left status)")
query queryParticipantByAgentSpace {
  args {
    spaceId  string  @required
    agentId  string  @required
  }
  filter  participant.spaceId==args.spaceId; participant.agentId==args.agentId; participant.status!="left"; traitIsActiveRecord
  shape   participantFull
}

// ---- queries/v1/cognition/participantSession.memql ----

// participantSession - Query Session State for Participants
// =========================================================
//
// Returns the real-time interaction session state for participants from the
// v1:cognition:session concept. Sessions track the current tier, device states
// (microphone/camera), AI output modes, and active stream identifiers.
//
// Sessions are created when a participant joins a space and track their
// moment-to-moment interaction state, separate from the participant record
// which tracks authorization and lifecycle.
//
// Arguments:
//   spaceId (string, optional)       - Filter by space ID to get all sessions in a space.
//   participantId (string, optional) - Filter by specific participant ID.
//
// Returns:
//   Array of session records with fields like:
//   - id: Unique session identifier
//   - session.spaceId: ID of the space this session belongs to
//   - session.participantId: ID of the participant this session tracks
//   - session.activeTier: Current interaction tier (text, speechToText, voiceToVoice, voiceAvatar, voiceVision)
//   - session.humanInput: Device states (microphoneEnabled, cameraEnabled)
//   - session.aiOutput: AI output states (voiceEnabled, avatarEnabled, visionEnabled)
//   - session.streams: Active stream IDs (realtimeSessionId, avatarStreamId)
//   - session.startedAt: When the session started
//   - session.lastActivityAt: Timestamp of last activity
//
// Usage:
//   participantSession()                                      // Returns all sessions
//   participantSession({"spaceId": "space-123"})              // Get all sessions in a space
//   participantSession({"participantId": "participant-456"})  // Get session for specific participant
//   participantSession({"spaceId": "space-123", "participantId": "participant-456"})  // Specific session
//

@enabled
@useConcept(session)
@description("Returns session state for participants in spaces. Optional filters: spaceId, participantId")
query queryParticipantSession {
  args {
    spaceId  string
    participantId  string
  }
  filter  ?.session.spaceId==args.spaceId; ?.session.participantId==args.participantId
  shape   sessionFull
}

// ---- queries/v1/cognition/savedSpaces.memql ----

// savedSpaces - Query Saved Spaces
// =================================
//
// Returns spaces with space.status == "saved". Saved spaces are
// manually preserved by the user (clicked "Save" in the SpacesListPanel
// or had their daily roll over via the rolloverDailySpace cron with
// preferences.dailySpaceRolloverAction == "save"). They never
// auto-delete -- the purgeExpiredArchivedSpaces cron only touches
// status == "archived" rows.
//
// Drives the Saved tab in the SpacesListPanel.
//
// Arguments:
//   userId (string, optional)   - Filter by creator (matches createdBy).
//                                 Frontend passes the current user's
//                                 primary email so each user sees their
//                                 own saved spaces.
//
// Returns:
//   Array of space records via the spaceFull shape.
//

@enabled
@useConcept(space)
@description("Returns spaces with space.status == 'saved'. Optional filter: userId (createdBy).")
query querySavedSpaces {
  args {
    userId  string
  }
  filter  traitIsActiveRecord; traitStatusIsSaved; ?.createdBy==args.userId
  shape   spaceFull
}

// ---- queries/v1/cognition/siParticipantForSpace.memql ----

// querySIParticipantForSpace - Find Active SI Participant in Space
// =================================================================
//
// Finds the active SI participant in a given space. Returns the first
// SI participant with status "active". Used by the cognition automation
// to identify which SI agent is responding in a space.
//
// Arguments:
//   spaceId (string, required) - The space to search in
//
// Returns:
//   Array of SI participant records (typically 0 or 1)

@enabled
@useConcept(participant)
@description("Find the active SI participant in a space.")
query querySiParticipantForSpace {
  args {
    spaceId  string  @required
  }
  filter  participant.spaceId==args.spaceId; participant.participantType=="si"; participant.status=="active"
  shape   participantFull
}

// ---- queries/v1/cognition/spaceContext.memql ----

// spaceContext - Query Space Runtime Context Snapshots
// ===================================================
//
// Returns computed runtime context snapshots for spaces.
// This is designed for AI turn-taking and optional UI awareness (counts, active media).
//
// Arguments:
//   spaceId (string, optional) - Filter by space ID.
//

@enabled
@useConcept(context)
@description("Returns runtime context snapshots for spaces. Optional filter: spaceId")
query querySpaceContext {
  args {
    spaceId  string
  }
  filter  ?.context.spaceId==args.spaceId
  shape   spaceContextFull
}

// ---- queries/v1/cognition/spaceMeta.memql ----

// querySpaceMeta - Full Space Record by ID
// =========================================
//
// Returns the space by id via the spaceFull shape. Every consumer
// that needs arbitrary space fields (owner, slot caps, selected
// agents) reads through this rather than re-declaring its own
// projection.
//
// Replaces the old `querySpaceArchitecture` query that existed to
// resolve the now-retired `architecture` field.
//
// Arguments:
//   spaceId (string, required) - The space ID to look up
//
// Returns:
//   Single shaped record (or empty) with name, description, status,
//   settings, slot capacities (maxHumans / maxAgents), selected
//   specialist agent ids, createdBy, and createdAt.

@enabled
@useConcept(space)
@description("Returns the full space record by id.")
query querySpaceMeta {
  args {
    spaceId  string  @required
  }
  filter  id==args.spaceId
  shape   spaceFull
}

func (Query) querySpaceParticipantPresence(ctx any) (any, error) {
  ctx.output = shape(
    concept;
    ?.presence.spaceId==args.spaceId;
    ?.presence.participantId==args.participantId,
    {
      node("id"),
      node("presence.spaceId"),
      node("presence.participantId"),
      node("presence.state"),
      node("presence.label"),
      node("presence.reason"),
      node("presence.sinceAt"),
      node("presence.lastUpdatedAt"),
      node("presence.lastUtteranceId"),
      node("presence.lastError"),
      node("presence.intent"),
      node("createdAt")
    }
  )
  return ctx, nil
}

func (Query) querySpaceParticipants(ctx any) (any, error) {
  ctx.output = shape(
    concept;
    ?.participant.spaceId==args.spaceId;
    ?.participant.status==args.status;
    ?.participant.participantType==args.participantType,
    "participantFull"
  )
  return ctx, nil
}

func (Query) querySpaceUtterances(ctx any) (any, error) {
  ctx.output = shape(
    concept;
    ?.utterance.spaceId==args.spaceId;
    ?.utterance.participantId==args.participantId;
    ?.utterance.utteranceType==args.utteranceType,
    "utteranceFull"
  )
  return ctx, nil
}

// ---- queries/v1/cognition/userMicStatesForSpace.memql ----

// userMicStatesForSpace
// =====================
//
// Returns the latest per-user mic state rows scoped to one space.
// The cognition handler queries this when resolving mirror_user
// agents: it locates the row matching the space's owner (or, more
// generally, any human currently in the space) and skips TTS
// publish if that user is muted.

@enabled
@useConcept(micState)
@description("Latest mic state rows per user for a space.")
query queryUserMicStatesForSpace {
  args {
    spaceId  string  @required
  }
  filter  ?.micState.spaceId==args.spaceId
  shape   micStateFull
}

func (Query) queryVideoOverridesForSpace(ctx any) (any, error) {
  // The row's `spaceId` is auto-canonicalized to
  // `<partition>:v1:cognition:space:<slug>` on insert (concept's
  // @relationship annotation drives this). The frontend passes
  // whatever it has -- usually the bare slug. Canonicalize the
  // arg before the equality check so both forms resolve to the
  // same value and the comparison matches.
  ctx.output = shape(
    concept;
    ?.videoOverride.spaceId==canonicalId(args.spaceId, "v1:cognition:space");
    ?.videoOverride.active==true,
    "videoOverrideFull"
  )
  return ctx, nil
}
