// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Summarize older conversation messages into a concise rolling summary so the live transcript
/// window stays bounded. Incorporates and extends any previous summary; focuses on facts,
/// decisions, questions asked/answered, and action items. Used by Polyphon context compaction
/// (component/polyphon/context_builder.go).
@defaultProvider("chat54Mini")
@templateFile("prompts/cognitionCompaction.tmpl")
prompt cognitionCompaction {
  entries         []object! @description("Conversation messages to summarize, oldest first; each {speakerName, speakerType, text}.")
  previousSummary string              @description("Prior rolling summary to incorporate and extend; empty on the first compaction.")
}

/// Phase 6 of the chat-architecture plan. Per-(active human, space) discussion-mode dispatcher.
/// Reads recent group activity + the user's recent private (Team-tab) thread + the user's roster of
/// agents and decides whether one of those agents should chime in proactively in the user's private
/// thread. Returns either {shouldDispatch: false} or {shouldDispatch: true, agentId, message,
/// taskKind?, taskDescription?}. Activity-level capped: caller filters by
/// User.preferences.discussionModeActivityLevel before invoking.
@defaultProvider("chat54Mini")
@templateFile("prompts/cognitionDiscussionDispatch.tmpl")
prompt cognitionDiscussionDispatch {
  activityLevel    string! @description("'low' | 'medium' | 'high' -- shapes the prompt's eagerness to dispatch (low = mentions only; high = also distress / questions).")
  forUserDisplayName string! @description("User whose Team thread the dispatch would land in.")
  spaceContext     object    @description("Title, goal, status -- for grounding.")
  recentGroup      []object            @description("Last several group utterances (most recent last), {speakerName, content, timestamp}.")
  recentPrivate    []object            @description("Last several utterances in this user's private thread (most recent last).")
  userAgents       []object! @description("This user's roster of agents in the space, {agentId, displayName, role, domains, keywords}.")
  inFlightTurnCount int                @description("How many inter-agent turns have already fired in this dispatch loop iteration. Hard cap is 3.")
  threshold        float               @description("Decaying firing threshold [0, 1]. Each prior turn in this iteration adds +0.1; the dispatcher should only return shouldDispatch=true when its self-assessed value crosses this bar.")
}

/// Per Q10: classify whether the latest chat message warrants spawning a Plan (background work) or
/// can be answered inline. Returns needsPlan + suggested planKind + planHint with the recommended
/// owning agent + confidence + reasoning. Cheap small-model call; runs alongside the existing
/// nextSpeaker routing decision so the chat agent's reply path can branch on the result without
/// modifying the established turn-taking prompt.
@defaultProvider("chat54Mini")
@templateFile("prompts/cognitionPlanTriage.tmpl")
prompt cognitionPlanTriage {
  utterance      string! @description("The latest message to triage.")
  speakerName    string!
  intent         string              @description("Classified intent of the utterance.")
  transcript     []object            @description("Recent conversation context (oldest first, up to 5 entries).")
  agents         []object! @description("Available agents with id, name, role, domains.")
  attachmentRefs []object            @description("Recent attachment ids the user has dropped in this thread; non-empty implies the message likely refers to one.")
  activeDocs     []object            @description("Validated knowledge documents available for retrieval, with id + format + summary.")
}

/// epic #1404 / child #1406 (assistant-mediated plan feedback). A Plan in this space is parked in
/// awaitingFeedback with a pending question; classify whether the user's latest chat message is the
/// ANSWER to that question (vs. an unrelated remark) and, when it is, extract the free-text
/// feedback to fold into attachPlanFeedback. Cheap small-model structured call; runs only when the
/// space actually has an awaitingFeedback Plan.
@defaultProvider("chat54Mini")
@templateFile("prompts/cognitionFeedbackRoute.tmpl")
prompt cognitionFeedbackRoute {
  question       string! @description("The feedback question the Plan is awaiting (Plan.feedbackRequest.question).")
  userText       string! @description("The user's latest chat message to classify against the question.")
  feedbackReason string             @description("Why the Plan parked (Plan.feedbackReason), e.g. scope_elevation_required / phase_checkpoint -- context only.")
  options        []object           @description("When the question is a choice, the {label, value} options the user may be picking among.")
  lastAgentText  string             @description("The most recent agent message before the user's, for conversational context.")
}

/// Predict conversation trajectory for proactive cognition behavior
@defaultProvider("chat54Mini")
@templateFile("prompts/cognitionPrediction.tmpl")
prompt cognitionPrediction {
  transcript  []object! @description("Recent transcript entries with speakerName, speakerType, text")
  agents      []object! @description("Available AI agents with name, role, and domains")
}

/// Generate an AI assistant reply for a space based on participants and recent conversation
/// context.
@defaultProvider("chat54Mini")
@templateFile("prompts/cognitionReply.tmpl")
prompt cognitionReply {
  trigger              string!
  assistant            object!
  space                object!
  participants         []object
  history              []object!
  conversationContext  object
  spaceContext         object
  historyInMessages    bool
  attachmentSummaries  []object
  peerActivity         []object
  peerRoster           []object
  selectionReason      string
  handoffFrom          string
  textOnlyFallback     bool
  surveyProgress       object
  tourProgress         object
  // directive: the conductor's structured instruction for THIS
  // turn -- mode (primary / chimein / brief_ack / defer), brevity
  // hint, optional content angle, plus skip-flags that turn off
  // ad-hoc prompt reasoning the conductor has already pre-decided
  // (skipHandoffOpener, skipSelfIntro, skipRoomAnnounce). Without
  // this declaration the prompt's additionalProperties=false
  // schema would reject the data and the whole call would error
  // before the LLM is invoked -- which is what was making chime-
  // ins fire in logs but never persist.
  directive            object
}

/// Decide whether any AI agent should respond to a human utterance, and if so, which one. Returns
/// respond=false when silence is the right answer. Sub-500ms fast-model target.
@defaultProvider("chat54Mini")
@templateFile("prompts/cognitionRouting.tmpl")
prompt cognitionRouting {
  agents            []object! @description("Available AI agents with id, name, role, description, domains, keywords")
  transcript        []object            @description("Recent conversation (oldest first, up to last 5 entries)")
  speakerName       string! @description("Name of the human who sent the latest message")
  utterance         string! @description("The latest human message to route")
  intent            string              @description("Classified intent of the utterance (question, task_request, statement, etc.)")
  mentions          []object            @description("Agent names mentioned in the utterance")
  phase             string              @description("Conversation phase (opening, active, closing, etc.)")
  prediction        object              @description("Anticipated next agent / topics from the prediction goroutine")
  previousResponder object              @description("Previous AI responder {id, name, role, lastTopic} -- empty on first turn")
  space             object              @description("Space context {id, spaceType, description?, goal?} -- helps disambiguate equally-qualified agents using what the space is for")
}

/// Read the room and produce a per-turn plan for a multi-agent conversation. Returns the
/// conversation phase, a global guidance line, and per-agent instructions for the primary speaker
/// plus any chime-ins. This is the 'brain' that prevents agents from defaulting to help-desk
/// patterns by telling each one specifically how to participate on this turn.
@defaultProvider("chat54Mini")
@templateFile("prompts/conductorTurn.tmpl")
prompt conductorTurn {
  // The agents present in the space (only AI participants; humans
  // travel separately so the prompt can reason about who they're
  // talking to vs. who could respond).
  agents       []object! @description("Available AI agents with id, name, role, description, domains")

  // Recent transcript -- last ~15 turns oldest-first. The conductor
  // uses this to detect phase (just opened? deep in a topic? wrapping
  // up?) and tone (casual? frustrated? focused?).
  transcript   []object            @description("Recent conversation entries, oldest first")

  // The human who just spoke, plus what they said.
  speakerName  string! @description("Name of the human who sent the latest message")
  utterance    string! @description("The latest human message")
  intent       string              @description("Heuristic intent classification (greeting, question, etc.)")
  mentions     []object            @description("Agent names mentioned in the utterance, with role: addressee or reference")

  // Space metadata so the conductor can ground answers in what the
  // room is actually for (goal / description / title), instead of
  // generic 'what are we working on?'
  space        object              @description("Space context {id, name, spaceType, goal, description}")

  // Humans present so the conductor can reason about who's in the
  // room and address them by first name when natural.
  humans       []object            @description("Human participants {displayName, currentSpeaker}")

  // Session summary maintained turn-over-turn on the per-space
  // ConductorState. The conductor updates it on each call (in the
  // SessionSummary output field), and on the next turn it lands here
  // as input. Provides continuity beyond the 15-turn transcript
  // window so the conductor remembers what's been going on even
  // when older messages have rolled out.
  sessionSummary string            @description("Rolling 1-2 sentence summary of what's been going on in this room.")

  // Last-responder anchor. Display name of the most-recent AI to
  // speak before this turn. Surfaced as its own input (separate
  // from the transcript) so the LLM treats it as a high-weight
  // signal for implicit follow-ups -- the user's "ok cool" / "btw"
  // / "how" turn defaults primary to this agent unless an
  // @-mention or domain pivot redirects. Empty on the very first
  // turn or when no AI has spoken yet.
  lastResponder  string            @description("Display name of the most-recent AI participant to speak before this turn; the implicit addressee of follow-up shapes.")
}

// Provider: chat54Nano (gpt-5.4-nano), the fastest structured-
// output-capable tier (#1329 candidate 1). This call serializes
// ahead of EVERY text-turn dispatch, so its latency is paid by the
// whole pre-dispatch pipeline; the schema is tiny (intent /
// carriesAction / answersPriorAgentPrompt / addressedAgentName /
// confidence / reasoning) and explicitly low-complexity, so it does
// not need the Mini tier it previously rode. Must stay on an OpenAI
// provider: only openAIProvider implements CallChatStructured
// (json_schema constrained decoding); an Anthropic-class name would
// silently fall back to the default structured provider.
/// Classify a user message in a multi-agent space: intent, whether it carries an action request,
/// whether it answers a prior agent prompt, who (if anyone) it's addressing. Pure semantic
/// classification -- no decision about who answers (that's the conductor). Designed for caching:
/// input is just the user text + the prior agent text + the agent roster, no per-conversation
/// state, so identical phrasings hit the cache regardless of conversation. Sub-500ms fast-model
/// target.
@defaultProvider("chat54Nano")
@templateFile("prompts/messageClassification.tmpl")
prompt messageClassification {
  userText      string! @description("The latest human message to classify")
  lastAgentText string           @description("The previous agent message (empty when no prior agent turn). Lets the classifier detect when the user message is answering a question or offer the agent posed.")
  agentRoster   string           @description("JSON-encoded list of agent display names in the room, so the classifier can resolve in-text mentions like 'is Nova there' even without an @-prefix.")
}
