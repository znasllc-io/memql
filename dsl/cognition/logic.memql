// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// automations/v1/cognition/autoJoinSI/automation.memql
//
// PURPOSE:
// On space creation, auto-join the CREATOR's currently-active
// assistant into the space. Under the one-assistant model
// (copresent #124) this is the ONLY AI participant a space ever
// carries -- there are no specialists and no agent picker.
//
// BEHAVIOR BY DESIGN:
// - The space OWNER's active assistant is always auto-joined, and
//   is the only assistant (maxAgents=1).
// - Joiners' assistants are NEVER auto-joined. When a new
//   human enters an existing space, their personal assistant stays
//   out; the space's AI representation is its creator's assistant.
// - Specialists and system agents never participate in spaces.
// - Idempotent: safe to re-fire.
//
// TRIGGER: New v1:cognition:space created with status=="active".
//
// HOW IT FINDS THE GA:
// The graph-event payload emitted on node-create flattens both the
// node's payload AND the Actor (createdBy on the MemoryNode) into
// `ctx.input.payload`. We key GAs on the user's primary email in
// provisionAssistant, and the Actor stamp is also the user's
// email (see component/auth/security.go ActorFromToken), so a single
// event-payload read resolves the lookup -- no cross-step reference
// needed. The compiler's bare-step-reference rewriter only handles
// `.metadata` suffixes, so reading space fields via a separate
// query + `.result.*` accessor chain would fail compile-time token
// resolution and break execution (the "unknown reference" and
// "unexpected token $" class of errors we hit during the refactor).
//
// SIDE EFFECTS:
// - Creates v1:cognition:participant records (SI type) for the
//   creator's GA and each specialist agent (only if missing).
// - bootstrapSession automation creates sessions for new SI
//   participants.
// - Emits "si.auto-joined" event for observability.
use agents.queries.{ queryAgentById, queryAssistantAgentForUser }
use cognition.builtins.{ ensureDailySpaceForCaller, ensureDailySpaceForUser, rolloverDailySpacesAllUsers }
use cognition.mutations.{ mutationCreateSessionForParticipant, mutationDeleteSpaceNow, mutationJoinSpaceAsSI, mutationSendTextUtterance }
use cognition.queries.{ queryExpiredArchivedSpaces, queryHasSIResponseForReply, queryParticipantByAgentSpace, queryParticipantSession }
use identity.queries.{ queryUserById, queryUsersActiveInSpace }

@description("Triggered when a v1:cognition:space is created with status='active'. Auto-joins the creator's currently-active assistant as a v1:cognition:participant on the new space, with forUserId=creator and isGroupGA=true (so the participant guard prevents non-elevated callers from removing it via the Roster tab). This is the ONLY AI participant a space carries (maxAgents=1, one-assistant model copresent #124). Idempotent. Emits 'si.auto-joined' for observability.")
logic logicAutoJoinSI {
  args {
    event object @required
  }
  body {
  // GA resolution uses the space row's ownerUserId, which is the
  // SAME across every call to mutationCreateDailySpace regardless
  // of which actor triggered the mutation (signup automation,
  // login automation, frontend hook). The previous implementation
  // derived the agent id from hash(args.event.payload.actor) =
  // the createdBy stamp, which varied per caller and produced a
  // different "agent id" each time -- the participant-content-
  // addressing key was therefore different per fire, so the
  // deterministic-id dedupe collapsed nothing and the user wound
  // up with N participants pointing at N hash-derived agent ids
  // that didn't match any real agent. memql#273.
  //
  // Multi-assistant resolution (memql#408 / copresent#125):
  // The owner may have multiple assistant agents (kind="assistant",
  // roleSlug="assistant"); the SPA persists their currently-selected
  // one on User.preferences.activeAssistantId. We honour that
  // explicit pick by looking up the user, reading the active id,
  // and if present resolving the agent directly via queryAgentById.
  // When the active id is empty (single-assistant user, or a freshly
  // bootstrapped user before the SPA stamps the field) we fall back
  // to the legacy queryAssistantAgentForUser path which keys on
  // (ownerUserId, roleSlug="assistant").
  //
  // Both queries return 0 or 1 rows in the steady state; the actual
  // canonical id is pulled out via coalesce(getGA.First().id, "").
  // memql#580: bare step identifiers (getActiveGA / getFallbackGA) now
  // resolve to their step result in BOTH the logic-runner evaluator and
  // the arg-time evaluator (#575 fixed only the latter, which is why this
  // automation kept inserting a ghost SI whose agentId was the unevaluated
  // literal `coalesce(getGA.First().id, "")`). A builtin arg that still
  // fails to resolve now drops to nil instead of passing its raw source
  // text through, so an unevaluated expression can never reach a mutation.
  getUser := queryUserById({ userId: args.event.payload.ownerUserId })
  activeAssistantId := coalesce(getUser.First().payload.preferences.activeAssistantId, "")

  // When activeAssistantId is set we look up that agent by id.
  // When it isn't we fall back to the legacy roleSlug-keyed query.
  // Exactly one of the two steps actually fires per invocation,
  // determined by the activeAssistantId emptiness.
  getActiveGA := if activeAssistantId != "" {
    queryAgentById({ agentId: activeAssistantId })
  }
  getFallbackGA := if activeAssistantId == "" {
    queryAssistantAgentForUser({ ownerUserId: args.event.payload.ownerUserId })
  }

  // coalesce(getActiveGA, getFallbackGA) picks whichever query produced
  // a row -- the bare step identifiers resolve to their step results
  // (memql#580), so getGA holds the ExecuteResult and getGA.First().id
  // navigates it, rather than getGA collapsing to a literal step name.
  getGA := coalesce(getActiveGA, getFallbackGA)

  // Existence check on the participant uses the SAME agent id the
  // mutation below will write, so re-fires of this automation see
  // the existing row and short-circuit. queryParticipantByAgentSpace
  // returns 0 or 1 rows; the mutation's content-addressed id keeps
  // duplicates collapsed even if this check ever misses.
  checkExistingGA := if !getGA.Empty() {
    queryParticipantByAgentSpace({
      spaceId: args.event.payload.id,
      agentId: coalesce(getGA.First().id, "")
    })
  }

  // Owner GA join carries two chat-architecture flags (Phase 1.5):
  //   - forUserId = the space owner. This anchors the GA to the
  //     owner's Team-tab roster so per-user-roster queries find it
  //     and the per-(user, space) 3-cap counts it against the owner.
  //   - isGroupGA = true. The engine pre-insert participant guard
  //     refuses status='left' inserts on rows carrying this flag for
  //     non-elevated callers, so the GA cannot be removed via the
  //     "Remove agent" affordance in the Roster tab. Only system
  //     actors (e.g., space-deletion cleanup) may demote it.
  // Both fields ride through unchanged because autoJoinSI runs as a
  // system actor (system:automation:autoJoinSI), which the participant
  // guard treats as elevated and trusts the explicit forUserId on.
  insertGA := if !getGA.Empty() && checkExistingGA.Empty() {
    mutationJoinSpaceAsSI({
      spaceId: args.event.payload.id,
      agentId: coalesce(getGA.First().id, ""),
      displayName: coalesce(getGA.First().payload.name, "Assistant"),
      forUserId: args.event.payload.ownerUserId,
      isGroupGA: true
    })
  }

  // No specialist auto-join: under the one-assistant model
  // (copresent #124) a space carries exactly one assistant -- the
  // owner's active one, joined above. Specialists and system agents
  // never participate in spaces, so there is nothing else to join.

  // Emit for observability. Only event-local references here -- the
  // automation compiler doesn't resolve cross-step refs from inside
  // publishEvent's payload block.
  emitAutoJoinComplete := publishEvent({
    topic: "si.auto-joined",
    payload: {
      spaceId: args.event.payload.id,
      ownerUserId: args.event.payload.ownerUserId,
      timestamp: timestamp()
    }
  })

  return emitAutoJoinComplete
  }
}

// automations/v1/cognition/bootstrapSession/automation.memql
// Auto-creates a v1:cognition:session record when a participant is created.
// Ensures every participant has a session tracking their real-time interaction state.
@description("Auto-creates a v1:cognition:session record when a v1:cognition:participant is created, with default device + stream state. Ensures every participant has a session tracking their real-time interaction state. Idempotent via queryParticipantSession existence check. Emits 'session.created' for downstream consumers.")
logic logicBootstrapSession {
  args {
    event object @required
  }
  body {
  // The event payload contains the newly created participant node with flattened fields:
  // args.event.payload.id = participant ID
  // args.event.payload.spaceId = space ID (flattened from node payload)
  // args.event.payload.participantType = "human" or "si" (flattened from node payload)
  // args.event.payload.payload = full node payload for backwards compatibility

  // Check if session already exists for this participant
  checkExistingSession := queryParticipantSession({ participantId: args.event.payload.id })

  // Create the session record with default device + stream state.
  // Voice / video flow is no longer gated by a tier ceiling -- the
  // user's mic toggle (humanInput.microphoneEnabled) plus each
  // agent's audioControl mode decide who publishes audio in the room.
  createSession := if checkExistingSession.Empty() { mutationCreateSessionForParticipant({ participantId: args.event.payload.id, spaceId: args.event.payload.spaceId }) }

  // Emit session created event for downstream consumers
  emitSessionCreated := if checkExistingSession.Empty() { publishEvent({ topic: "session.created", payload: { sessionId: args.event.payload.id, participantId: args.event.payload.id, spaceId: args.event.payload.spaceId, timestamp: timestamp() } }) }

  return coalesce(createSession, checkExistingSession.First())
  }
}

// automations/v1/cognition/generateResponse/automation.memql
// Generates and inserts an SI response when the cognition integration
// determines that a response is needed. The Go handler performs event
// reception, concurrent context loading, Polyphon scoring, and streaming
// dispatch, then emits this event with pre-loaded context when a
// non-streaming SI response is needed.
@description("Generates and inserts an SI response when the Go cognition handler decides a non-streaming response is needed and emits this event with pre-loaded prompt data. Calls the prompt template, inserts a v1:cognition:utterance via mutationSendTextUtterance, and bumps participant presence to idle. Idempotent via queryHasSIResponseForReply.")
logic logicGenerateResponse {
  args {
    event object @required
  }
  body {
  // The event payload is assembled by the Go cognition handler with:
  //   spaceId           - Space where the utterance was sent
  //   utteranceId       - The triggering utterance node ID
  //   triggerText       - The utterance text that triggered the response
  //   siParticipantId   - The SI participant that should respond
  //   agentId           - The agent concept ID for the responding SI
  //   promptTemplateId  - Which prompt template to use (e.g., "cognitionReply")
  //   promptData        - Pre-assembled prompt data (assistant, space, participants, history, etc.)
  //   toolNames         - Tool whitelist for the SI response

  // Check idempotency -- skip if we already responded to this utterance
  existingResponse := queryHasSIResponseForReply({
    replyToId: args.event.payload.utteranceId,
    participantId: args.event.payload.siParticipantId
  })

  // Generate SI response via the prompt template
  siResponse := if existingResponse.Empty() {
    si(args.event.payload.promptTemplateId, args.event.payload.promptData)
  }

  // Insert the SI response as a new utterance
  insertResponse := if existingResponse.Empty() {
    mutationSendTextUtterance({
      args.event.payload.spaceId,
      participantId: args.event.payload.siParticipantId,
      text: siResponse,
      replyToId: args.event.payload.utteranceId,
      source: { inputMethod: "si", agentId: args.event.payload.agentId }
    })
  }

  // Update presence to idle after responding
  presenceUpdate := if existingResponse.Empty() {
    cognitionTrackPresence({
      participantId: args.event.payload.siParticipantId,
      args.event.payload.spaceId,
      state: "idle"
    })
  }

  return insertResponse
  }
}

// ---- logic/v1/cognition/purgeExpiredArchivedSpaces.memql ----

// purgeExpiredArchivedSpaces
// ==========================
//
// Daily sweep that hard-deletes archived spaces whose retention
// window has elapsed. Pattern mirrors expireGuestInvitations.
//
// The deadline (payload.expiresAt) is pre-computed at archive time
// (frontend stamps archivedAt + retentionDays), so the query is a
// plain `expiresAt < now` comparison and the cron loop just calls
// deleteSpaceNow per row.
//
// Defensive: only acts on rows where ALL of:
//   payload.status == "archived"   (traitStatusIsArchived in the query)
//   payload.active == true         (traitIsActiveRecord in the query)
//   payload.expiresAt < now        (filter in the query)
// Saved + scheduled + active spaces are untouched.
//
// Runs daily at 02:00 UTC. Cadence is loose (vs expireGuestInvitations's
// 30-second tick) because retention is measured in days; missing the
// boundary by a few hours doesn't matter -- next run catches it.
@description("Daily 02:00 UTC sweep that hard-deletes archived v1:cognition:space rows whose payload.expiresAt has passed (deadline pre-computed at archive time as archivedAt + retentionDays). Defensive: only acts on rows where status='archived' AND active=true AND expiresAt<now. Saved/scheduled/active spaces are untouched.")
logic logicPurgeExpiredArchivedSpaces {
  args {
    event object @required
  }
  body {
  expired := queryExpiredArchivedSpaces({ now: timestamp() })

  for item := range expired.Nodes() {
    deleteStep := mutationDeleteSpaceNow({
      spaceId: item.id,
      payload: {
        item.payload.name,
        status: "archived",
        active: false,
        deleted: true
      }
    })
  }

  return expired.Len()
  }
}

// voiceMigrationOnSecondHuman
// ===========================
//
// PURPOSE:
// Phase 7 of the chat-architecture plan. When the SECOND active human
// shows up in a space, voice transport migrates from each user's per-
// user Team thread to the shared GROUP thread. The automation emits
// the canvas-card pair that announces the migration:
//
//   Public group card  -- "{user} joined -- voice is active in this chat."
//                          Visible to every space participant.
//   Private operator   -- "Voice moved to the group chat -- push-to-talk
//   card per user        or type to message your team here."
//                          Per-existing-user; lands on each user's
//                          private canvas timeline.
//
// TRIGGER:
// graph.node.created.v1:identity:user fires on every user-row write
// (primary path: mutationSetUserActiveSpace shipping a new version).
// We filter to rows whose payload.activeSpaceId is non-empty -- a user
// whose pointer is set has just become active in some space.
//
// FIRE CONDITION:
// queryUsersActiveInSpace returns the full set of users currently
// pointing at the same space. We act when the count is exactly 2 --
// the just-joined user PLUS one prior active human. Counts of 1 (single
// user) and 3+ (already migrated) are no-ops.
//
// IDEMPOTENCY:
// The public canvas-state id is content-addressed on
// (space, "voice-migrated"). Re-firing the automation for the same
// (space) lands the same id, which the executeInsert path collapses
// via ON CONFLICT. The per-user private cards are content-addressed
// on (space, "voice-migrated", userId) for the same reason.
//
// REVERSE MIGRATION:
// When the count drops below 2 (last other human leaves), the symmetric
// "voice moved back to your Team chat" card lands -- handled by a
// sibling automation when needed (deferred until the frontend wiring
// shows the need).
@description("Phase 7 of chat-architecture. Triggered when a user's activeSpaceId pointer changes. When exactly two humans become active in the same space, emits a public 'voice.migrated.group' canvas card plus per-user 'voice.migrated.private' cards announcing voice transport migration from Team to Group thread. Idempotent via content-addressed stateIds.")
logic logicVoiceMigrationOnSecondHuman {
  args {
    event object @required
  }
  body {
  active := queryUsersActiveInSpace({ spaceId: args.event.payload.activeSpaceId })

  // The plan calls for exactly the 1-to-2 transition. The query returns
  // all currently-active users in the space; act when there are exactly
  // 2. ANY OTHER count is a no-op (single user = first to focus the
  // space; 3+ = already migrated; 0 wouldn't appear here because the
  // event filter required a non-empty activeSpaceId on the writer).
  publishGroupCard := if active.Count() == 2 {
    mutationCreateCanvasState({
      stateId: concat("voice-migrated-public-", hash(args.event.payload.activeSpaceId)),
      space: args.event.payload.activeSpaceId,
      kind: "card",
      data: {
        variant: "voice.migrated.group",
        message: "Voice is now active in this chat -- a second person joined."
      },
      visibility: "public",
      actor: { kind: "system" },
      importance: "notify"
    })
  }

  publishPrivateCard := if active.Count() == 2 {
    mutationCreateCanvasState({
      stateId: concat("voice-migrated-private-", hash(concat(
        args.event.payload.activeSpaceId, ":", args.event.payload.id
      ))),
      space: args.event.payload.activeSpaceId,
      kind: "card",
      data: {
        variant: "voice.migrated.private",
        message: "Voice moved to the group chat. Push-to-talk or type to message your team here."
      },
      visibility: "private",
      forUserId: args.event.payload.id,
      actor: { kind: "system" },
      importance: "ambient"
    })
  }

  return publishPrivateCard
  }
}

// ---- logicProvisionDailySpaceOnUserCreate -----------------------
//
// Fires when a new v1:identity:user row lands. The event payload
// carries the user's full row at args.event.payload, so the userId
// reads directly off args.event.payload.id without a follow-up
// query. We pass that through to the dailyspace.ensureForUser
// capability which owns the timezone math + idempotent insert.
//
// dailySpaceEnabled gating lives inside the Go capability (not in
// an automation @filter) because the value is nested under
// preferences and the filter expression syntax doesn't navigate
// nested payload paths reliably. The capability short-circuits +
// reports skip-reason in its result, which is sufficient for the
// observability story.
@description("Fires when a new v1:identity:user row lands. Delegates to the dailyspace.ensureForUser capability which owns the timezone math + idempotent insert of today's daily space for that user. dailySpaceEnabled gating lives inside the Go capability since the value sits under preferences and filter syntax doesn't navigate nested payload paths reliably.")
logic logicProvisionDailySpaceOnUserCreate {
  args {
    event object @required
  }
  body {
    return ensureDailySpaceForUser({ userId: args.event.payload.id })
  }
}

// ---- logicEnsureDailySpaceForCaller -----------------------------
//
// Top-level entry point for interactive clients (the cockpit Chat
// tab today) that want today's daily provisioned for whoever is
// authenticated on the current request. Wraps
// integration.dailyspace.ensureForCaller (via the
// `ensureDailySpaceForCaller` builtin), which reads the calling
// user's id off the request's auth context, then runs the same
// ensureForUser orchestration the cron + automation paths use.
//
// Why a Logic wrapper: the engine's top-level Execute path
// dispatches Logic and Mutation function calls but not bare
// builtin calls. Wrapping the builtin in a Logic gives callers
// an Execute-able entry (`logicEnsureDailySpaceForCaller({})`)
// without forcing them to also know how to build a triggering
// event.
@enabled
@description("Ensure today's daily space exists for the authenticated caller. Top-level Execute entry point for interactive clients; resolves userId from the request's auth context inside the dailyspace integration.")
logic logicEnsureDailySpaceForCaller {
  body {
    return ensureDailySpaceForCaller({})
  }
}

// ---- logicEnsureDailySpaceOnAuthSession -------------------------
//
// Fires on every v1:identity:authSession create -- one per login.
// The session payload carries userId (the v1:identity:user.id the
// session authenticates as). We dispatch ensureForUser the same
// way as the user-create automation; the idempotent insert
// collapses to a no-op when today's daily already exists.
//
// This is the path that makes the cron-frequency concern moot:
// every time the user re-auths, today's daily is guaranteed to
// exist before any read query the SPA might issue.
@description("Fires on every v1:identity:authSession create (one per login). Calls dailyspace.ensureForUser for the authenticating user; the idempotent insert collapses to a no-op when today's daily already exists. This is the path that makes the cron-frequency concern moot -- every login guarantees today's daily exists before the SPA reads.")
logic logicEnsureDailySpaceOnAuthSession {
  args {
    event object @required
  }
  body {
    // authSession.userId is OPTIONAL (token issuance can race ahead of the
    // user-row insert; see the concept). subject -- the JWT sub claim
    // (v1:identity:user:<uuid>) -- is the canonical, always-present key, so
    // fall back to it; otherwise login provisions no daily space and the SPA
    // lands the user in an empty app.
    return ensureDailySpaceForUser({ userId: coalesce(args.event.payload.userId, args.event.payload.subject) })
  }
}

// ---- logicRolloverDailySpace -----------------------------------
//
// Hourly cron tick. Delegates the entire per-user sweep to the
// dailyspace.rolloverAllUsers capability, which walks queryActiveUsers
// and calls ensureForUser per row. Returns a one-row summary the
// automation logs.
@description("Hourly cron tick. Delegates the entire per-user sweep to the dailyspace.rolloverAllUsers capability, which walks queryActiveUsers and calls ensureForUser per row. Returns a one-row summary the automation logs.")
logic logicRolloverDailySpace {
  args {
    event object
  }
  body {
    return rolloverDailySpacesAllUsers({})
  }
}
