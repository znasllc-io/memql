// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// automations/v1/cognition/autoJoinAI/automation.memql
//
// PURPOSE:
// On space creation, auto-join the CREATOR's currently-active
// assistant into the space. Under the one-assistant model
// (frontend#124) this is the ONLY AI participant a space ever
// carries -- there are no specialists and no agent picker.
//
// BEHAVIOR BY DESIGN:
// - The space OWNER's active assistant is always auto-joined, and
//   is the only assistant (maxAgents=1).
// - Joiners' assistants are NEVER auto-joined. When a new
//   human enters an existing space, their personal assistant stays
//   out; the space's AI representation is its creator's assistant.
// - Specialists and system agents never participate in spaces.
// - Idempotent: safe to re-fire.
//
// TRIGGER: New v1:cognition:space created with status=="active".
//
// HOW IT FINDS THE GA:
// The graph-event payload emitted on node-create flattens both the
// node's payload AND the Actor (createdBy on the MemoryNode) into
// `ctx.input.payload`. We key GAs on the user's primary email in
// provisionAssistant, and the Actor stamp is also the user's
// email (see component/auth/security.go ActorFromToken), so a single
// event-payload read resolves the lookup -- no cross-step reference
// needed. The compiler's bare-step-reference rewriter only handles
// `.metadata` suffixes, so reading space fields via a separate
// query + `.result.*` accessor chain would fail compile-time token
// resolution and break execution (the "unknown reference" and
// "unexpected token $" class of errors we hit during the refactor).
//
// SIDE EFFECTS:
// - Creates v1:cognition:participant records (AI type) for the
//   creator's GA and each specialist agent (only if missing).
// - bootstrapSession automation creates sessions for new AI
//   participants.
// - Emits "si.auto-joined" event for observability.
use identity.queries.{ usersActiveInSpace }

// automations/v1/cognition/bootstrapSession/automation.memql
// Auto-creates a v1:cognition:session record when a participant is created.
// Ensures every participant has a session tracking their real-time interaction state.
// PURE decide logic (#2235 / #2271): it only READS (the existence check) and
// returns the boolean decision "no session exists yet -> create one". The two
// writes it used to perform inline (the createSessionForParticipant insert + the
// session.created emit -- the ADR §2.1 logic-purity violation) now live as
// `if`-gated steps on the bootstrapSession automation, gated on
// `steps.decide.result == true`, mirroring the cluster bootstrapCluster pattern.
@description("Decides whether a new v1:cognition:session must be created for a freshly-created participant: returns true when no session exists yet (idempotency via participantSession). The bootstrapSession automation performs the gated createSessionForParticipant insert + session.created emit.")
logic bootstrapSession {
  args {
    event object!
  }
  body {
  // The event payload contains the newly created participant node with flattened fields:
  // args.event.payload.id = participant ID
  // args.event.payload.partitionId = space ID (flattened from node payload)
  // args.event.payload.participantType = "human" or "si" (flattened from node payload)

  // Check if session already exists for this participant; decide create-or-not.
  checkExistingSession := query participantSession( participantId: args.event.payload.id )

  return checkExistingSession.empty()
  }
}

// automations/v1/cognition/generateResponse/automation.memql
// Generates and inserts an AI response when the cognition integration
// determines that a response is needed. The Go handler performs event
// reception, concurrent context loading, Polyphon scoring, and streaming
// dispatch, then emits this event with pre-loaded context when a
// non-streaming AI response is needed.
// PURE decide logic (#2235 / #2271): idempotency READ + the ai() call, returning
// the generated reply TEXT as a scalar (empty string when a response already
// exists, so nothing is written). The two graph writes it used to perform inline
// (the sendTextUtterance insert -- the ADR §2.1 logic-purity violation -- plus
// the presence bump) now live as `if`-gated steps on the generateResponse
// automation, gated on `steps.decide.result != ""` and reading the reply text
// via `steps.decide.result`. This is the scalar form of the decide->persist
// pattern; the engine fix (#2271) makes the Bundle-wrapped step result read flat.
// ai() is a read/compute (not a graph write), so the logic stays contract-pure.
@description("Decides + generates the AI reply for a cognition.response.requested event: returns the reply text (empty when a response already exists -- idempotency via hasAIResponseForReply). The generateResponse automation performs the gated sendTextUtterance insert + presence bump from this text.")
@eventField("agentId", "promptData", "promptTemplateId", "siParticipantId", "partitionId", "utteranceId")
logic generateResponse {
  args {
    event object!
  }
  body {
  // The event payload is assembled by the Go cognition handler with:
  //   partitionId       - Space where the utterance was sent
  //   utteranceId       - The triggering utterance node ID
  //   siParticipantId   - The AI participant that should respond
  //   agentId           - The agent concept ID for the responding AI
  //   promptTemplateId  - Which prompt template to use (e.g., "cognitionReply")
  //   promptData        - Pre-assembled prompt data (assistant, space, participants, history, etc.)

  // Check idempotency -- skip if we already responded to this utterance.
  existingResponse := query hasAIResponseForReply(
    replyToId: args.event.payload.utteranceId,
    participantId: args.event.payload.siParticipantId
  )

  // Generate the AI response via the prompt template (only when not already answered).
  aiResponse := if existingResponse.empty() {
    ai(args.event.payload.promptTemplateId, args.event.payload.promptData)
  }

  // The reply text -- empty string when already answered, so the automation's
  // `!= ""`-gated persist + presence steps skip.
  return coalesce(aiResponse, "")
  }
}

// ---- logic/v1/cognition/purgeExpiredArchivedSpaces.memql ----

// voiceMigrationOnSecondHuman
// ===========================
//
// PURPOSE:
// Phase 7 of the chat-architecture plan. When the SECOND active human
// shows up in a space, voice transport migrates from each user's per-
// user Team thread to the shared GROUP thread. The automation emits
// the canvas-card pair that announces the migration:
//
//   Public group card  -- "{user} joined -- voice is active in this chat."
//                          Visible to every space participant.
//   Private operator   -- "Voice moved to the group chat -- push-to-talk
//   card per user        or type to message your team here."
//                          Per-existing-user; lands on each user's
//                          private canvas timeline.
//
// TRIGGER:
// graph.node.created.v1:identity:user fires on every user-row write
// (primary path: setUserActiveSpace shipping a new version).
// We filter to rows whose payload.activePartitionId is non-empty -- a user
// whose pointer is set has just become active in some space.
//
// FIRE CONDITION:
// usersActiveInSpace returns the full set of users currently
// pointing at the same space. We act when the count is exactly 2 --
// the just-joined user PLUS one prior active human. Counts of 1 (single
// user) and 3+ (already migrated) are no-ops.
//
// IDEMPOTENCY:
// The public canvas-state id is content-addressed on
// (space, "voice-migrated"). Re-firing the automation for the same
// (space) lands the same id, which the executeInsert path collapses
// via ON CONFLICT. The per-user private cards are content-addressed
// on (space, "voice-migrated", userId) for the same reason.
//
// REVERSE MIGRATION:
// When the count drops below 2 (last other human leaves), the symmetric
// "voice moved back to your Team chat" card lands -- handled by a
// sibling automation when needed (deferred until the frontend wiring
// shows the need).
@description("Phase 7 of chat-architecture. Triggered when a user's activePartitionId pointer changes. When exactly two humans become active in the same space, emits a public 'voice.migrated.group' canvas card plus per-user 'voice.migrated.private' cards announcing voice transport migration from Team to Group thread. Idempotent via content-addressed stateIds.")
@eventField("activePartitionId", "id")
logic voiceMigrationOnSecondHuman {
  args {
    event object!
  }
  body {
  active := query usersActiveInSpace( partitionId: args.event.payload.activePartitionId )

  // The plan calls for exactly the 1-to-2 transition. The query returns
  // all currently-active users in the space; act when there are exactly
  // 2. ANY OTHER count is a no-op (single user = first to focus the
  // space; 3+ = already migrated; 0 wouldn't appear here because the
  // event filter required a non-empty activePartitionId on the writer).
  publishGroupCard := if active.count() == 2 {
    mutation mutationCreateCanvasState(
      stateId: concat("voice-migrated-public-", hash(args.event.payload.activePartitionId)),
      space: args.event.payload.activePartitionId,
      kind: "card",
      data: {
        variant: "voice.migrated.group",
        message: "Voice is now active in this chat -- a second person joined."
      },
      visibility: "public",
      actor: { kind: "system" },
      importance: "notify"
    )
  }

  publishPrivateCard := if active.count() == 2 {
    mutation mutationCreateCanvasState(
      stateId: concat("voice-migrated-private-", hash(concat(
        args.event.payload.activePartitionId, ":", args.event.payload.id
      ))),
      space: args.event.payload.activePartitionId,
      kind: "card",
      data: {
        variant: "voice.migrated.private",
        message: "Voice moved to the group chat. Push-to-talk or type to message your team here."
      },
      visibility: "private",
      forUserId: args.event.payload.id,
      actor: { kind: "system" },
      importance: "ambient"
    )
  }

  return publishPrivateCard
  }
}
