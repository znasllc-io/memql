// Builtins in the cognition namespace.

// ---- builtin recentChat --------------------------------------------
//
// Read recent utterances + space context. Wires the recentChat tool
// to the chat integration's handler (integration.chat.recentChat).
//
// Single-chat architecture: every space has one v1:cognition:utterance
// stream. This builtin reads only that concept; there is no per-user
// private thread.

@enabled
@executor("integration.chat.recentChat")
@args(profile="object")
@description("Read recent utterances + space context. Five operations: readRecent / readByKeyword / readByTime / getSpaceContext / listParticipants.")
builtin recentChat {
  spaceId    string  @required
  agentId    string
  operation  string  @required
  count      int
  keyword    string
  fromTime   string
  toTime     string
}

// ---- builtin ensureDailySpaceForUser --------------------------------
//
// Server-driven daily-space provisioning. Wires the dailyspace
// integration's ensureForUser handler (integration.dailyspace.ensureForUser)
// so the cognition automations can ensure a single user has today's
// daily space without owning the timezone math or the read-then-write
// orchestration in DSL.
//
// Idempotent on (userShortId, dateKey): repeat calls within the same
// day collapse via the engine's id-conflict semantics. Safe to fire
// from user-create, login, and the hourly cron.

@enabled
@executor("integration.dailyspace.ensureForUser")
@args(profile="object")
@description("Ensure today's daily space exists for the given user. Idempotent; no-op when user's preferences.dailySpaceEnabled is false.")
builtin ensureDailySpaceForUser {
  userId  string  @required
}

// ---- builtin rolloverDailySpacesAllUsers ----------------------------
//
// Hourly cron entry point. Walks every active user and ensures
// today's daily exists for each (calling ensureForUser internally).
// Returns one summary node with counts: {users, ensured, skipped,
// errors, errorBatch?}. Errors per user don't abort the sweep --
// the batch keeps the first five for triage.

@enabled
@executor("integration.dailyspace.rolloverAllUsers")
@args(profile="object")
@description("Hourly cron entry point. Ensures today's daily for every active user; returns a summary.")
builtin rolloverDailySpacesAllUsers {
}
