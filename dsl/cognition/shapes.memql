// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use cognition.concepts.{ audioOverride, participant, presence, session, space, utterance, videoOverride }

@row
@description("Per-(space, agent) audio override projection")
shape audioOverride audioOverrideFull {
  row.id
  payload.spaceId
  payload.agentId
  payload.setBy
  payload.mode
  payload.active
  row.createdAt
}

@row
@description("Comprehensive participant projection with all fields")
shape participant participantFull {
  row.id
  payload.spaceId
  payload.userId
  payload.agentId
  payload.participantType
  payload.displayName
  payload.status
  payload.joinedAt
  payload.leftAt
  payload.capabilityOverrides
  payload.hidden
  row.createdAt
}

@row
@description("Comprehensive session projection with device + stream state")
shape session sessionFull {
  row.id
  payload.humanInput
  payload.aiOutput
  payload.streams
  payload.startedAt
  payload.lastActivityAt
}

@row
@description("Comprehensive space projection with all fields")
shape space spaceFull {
  row.id
  payload.name
  payload.description
  payload.ownerUserId
  payload.goal
  payload.status
  payload.archivedAt
  payload.expiresAt
  payload.savedAt
  payload.scheduledAt
  payload.settings
  payload.turnStateId
  payload.active
  payload.spaceType
  payload.kind
  payload.private
  payload.dailyDateKey
  payload.maxHumans
  payload.maxAgents
  row.createdAt
  row.createdBy
}

@row
@description("Id-only projection of v1:cognition:space rows. Backs the heartbeat path (memql#287) that just needs to iterate active spaces -- avoids paying the spaceFull projection cost when only the id is consumed.")
shape space spaceIdOnly {
  row.id
}

@row
@description("Comprehensive utterance projection with all fields")
