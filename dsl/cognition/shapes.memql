// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@description("Per-(space, agent) audio override projection")
shape audioOverride audioOverrideFull {
  row.id
  partitionId
  agentId
  setBy
  mode
  active
  row.createdAt
}

@row
@description("Comprehensive participant projection with all fields")
shape participant participantFull {
  row.id
  partitionId
  userId
  agentId
  participantType
  displayName
  status
  joinedAt
  leftAt
  capabilityOverrides
  hidden
  row.createdAt
}

@row
@description("Comprehensive session projection with device + stream state")
shape session sessionFull {
  row.id
  humanInput
  aiOutput
  streams
  startedAt
  lastActivityAt
}

@row
@description("Comprehensive utterance projection with all fields")
shape utterance utteranceFull {
  row.id
  partitionId
  participantId
  utteranceType
  text
  action
  audioId
  videoId
  duration
  replyToId
  timestamps
  analysis
  source
  citations
  retrieved
  row.createdAt
}

@row
@description("Per-(space, agent) video override projection")
shape videoOverride videoOverrideFull {
  row.id
  partitionId
  agentId
  setBy
  mode
  active
  row.createdAt
}

// privateUtteranceFull + misrouteFeedbackFull were extracted to the
// product pack (the carrier repo's pack shapes file) by
// Epic 3 (3.3b-i, memql#1991) along with their concepts (ids preserved).

@row
@description("UI-friendly presence snapshot for a participant. Carries the high-level state (thinking / responding / waiting / ...) plus the short UI label + timing fields. The SPA keys these latest-wins by participantId to drive the presence panel + chat activity indicator.")
shape presence presenceFull {
  row.id
  partitionId
  participantId
  state
  label
  reason
  intent
  sinceAt
  lastUpdatedAt
  lastUtteranceId
  lastError
  row.createdAt
}
