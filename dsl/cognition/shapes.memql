  payload.spaceId
  payload.snapshot
  payload.computedAt
  payload.lastUpdatedAt
  row.createdAt
}

@row
@description("Snapshot-only projection of v1:cognition:space:context rows. Backs the deterministic-comparison path in getLatestSpaceContextSnapshot (memql#290) -- minimises payload size when the consumer only needs payload.snapshot. The previous handwritten runtime query used an inline `{\"snapshot\": node(\"payload.snapshot\")}` template; this shape is its DSL-defined equivalent.")
shape context spaceContextSnapshotOnly {
  payload.snapshot
}

@row
@description("Comprehensive space projection with all fields")
shape space spaceFull {
  row.id
  payload.name
  payload.description
  payload.goal
  payload.status
  payload.archivedAt
  payload.expiresAt
  payload.savedAt
  payload.scheduledAt
  payload.settings
  payload.turnStateId
  payload.active
  payload.spaceType
  payload.kind
  payload.private
  payload.dailyDateKey
  payload.maxHumans
  payload.maxAgents
  row.createdAt
  row.createdBy
}

@row
@description("Id-only projection of v1:cognition:space rows. Backs the heartbeat path (memql#287) that just needs to iterate active spaces -- avoids paying the spaceFull projection cost when only the id is consumed.")
shape space spaceIdOnly {
  row.id
}

