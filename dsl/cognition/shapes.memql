// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use cognition.concepts.{ audioOverride, context, greetSuppression, micState, misrouteFeedback, participant, presence, privateUtterance, session, space, utterance, videoOverride }

@row
@description("Per-(space, agent) audio override projection")
shape audioOverride audioOverrideFull {
  row.id
  payload.spaceId
  payload.agentId
  payload.setBy
  payload.mode
  payload.active
  row.createdAt
}

@row
@description("Greet-on-join suppression projection (copresent#252)")
shape greetSuppression greetSuppressionFull {
  row.id
  payload.spaceId
  payload.expiresAt
  payload.active
  row.createdAt
}

@row
@description("Per-(space, user) mic state projection")
shape micState micStateFull {
  row.id
  payload.spaceId
  payload.userId
  payload.muted
  payload.updatedAt
  row.createdAt
}

@row
@description("Comprehensive participant projection with all fields")
shape participant participantFull {
