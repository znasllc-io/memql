  row.id
  payload.spaceId
  payload.participantId
  payload.utteranceType
  payload.text
  payload.action
  payload.audioId
  payload.videoId
  payload.duration
  payload.replyToId
  payload.timestamps
  payload.analysis
  payload.source
  payload.citations
  payload.retrieved
  row.createdAt
}

@row
@description("Per-(space, agent) video override projection")
shape videoOverride videoOverrideFull {
  row.id
  payload.spaceId
  payload.agentId
  payload.setBy
  payload.mode
  payload.active
