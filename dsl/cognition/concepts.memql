// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@version("1.0.0")
@namespace("cognition")
@description("Per-(spaceId, agentId) audio control override. Lets a user dial a single agent's TTS publication on / off / mirror_user inside one space without changing the agent's own default (audioControl on v1:agents:agent). Written by the orb-corner overlay in PresencePanel + the canvas presence widget. Read by the cognition handler before forwarding TTS to the Bridge Agent: an active override beats the agent default; absence falls through to the agent default. id is the deterministic audioOverride:<spaceId>:<agentId> so re-toggling on the same orb hits the same row instead of growing a per-click history.")
concept audioOverride {
  spaceId   string  @required @description("v1:cognition:space.id this override is scoped to.")
  agentId   string  @required @description("v1:agents:agent.id this override targets.")
  setBy     string  @description("v1:identity:user.id of the actor who flipped the override -- the space owner under v1 permission rules. Audited against v1:identity:auditEvent.")
  mode      enum("always_on", "always_off", "mirror_user")  @required @description("Effective publication state. The bridge gating path treats this exactly the same as the agent default once selected: always_on publishes unconditionally; always_off suppresses TTS while letting text replies still flow to chat; mirror_user honours the user's current mic state, querying it at TTS-start time (not per-frame).")
  active    bool  @default("true") @description("Soft-revoke flag. Setting active=false collapses back to the agent default without losing the row's history.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="interactsWith", field="agentId", target="v1:agents:agent", direction="outgoing")
}

@version("1.0.0")
@namespace("cognition:text")
@description("A streaming text chunk emitted incrementally during AI response generation. The frontend subscribes to creation events and accumulates chunks into a real-time message.")
concept chunk {
  done  bool  @required  @description("Whether this is the final chunk.")
  index  int  @required  @description("Sequential chunk index (0-based).")
  participantId  string  @required  @description("AI participant generating the text.")
  replyId  string  @required  @description("Stable id for the entire turn. Every chunk in the same agent reply carries the same replyId, and the committed utterance for the reply uses this as its id. The frontend keys the rendered bubble by replyId so streaming chunks and the final commit address the same React element -- no remount, no avatar flicker.")
  spaceId  string  @required  @description("Space where the text is being generated.")
  text  string  @required  @description("The text content of this chunk.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="createdBy", field="participantId", target="v1:cognition:participant", direction="outgoing")
}

@version("1.0.0")
@namespace("cognition:client:tool")
@description("Ephemeral request envelope for a client-executed tool call bridging cluster nodes. Inserted by cognition's client-tool relay when the agent node emits a ClientToolCall that needs to reach a browser stream on BFF. The browser (via its client-tool relay bridge) subscribes to these events, dispatches the tool, and inserts a matching v1:cognition:client:tool:response. Records are not retained -- once the response arrives the pair is a no-op for future consumers. Lives under v1:cognition because the relay is a cognition-level concern (mediating between the agent loop and the browser stream); consuming products need not define their own variant.")
concept request {
  callId  string  @required  @description("UUID correlating this request with its eventual v1:cognition:client:tool:response. Matches the ClientToolCall.call_id the agent emitted.")

  toolName  string  @required  @description("Canonical tool name (e.g. `uiReadState`, `uiHighlight`). Resolved against the client-side tool registry.")

  argumentsJSON  string  @description("JSON-encoded arguments object for the tool. Empty string is equivalent to `{}`.")

  spaceId  string  @description("ID of the space this turn belongs to. Used to scope subscriptions on the browser side so each user only responds to calls aimed at their active space.")

  participantId  string  @description("ID of the participant the browser is acting as. Lets the browser filter to its own user/session and prevents a call intended for user A from being answered by user B sharing the space.")

  agentId  string  @description("ID of the agent that requested the call. Audit-only -- the response routes back to the agent via cognition, not via this field.")

  expiresAt  datetime  @description("When the request stops being valid. Browsers arriving late ignore requests past this time; cognition drops stale correlations.")
}

// ---- concepts/v1/cognition/client/tool/response/concept.memql ----

@version("1.0.0")
@namespace("cognition:client:tool")
@description("Ephemeral response envelope paired with a v1:cognition:client:tool:request. Inserted by the browser after it dispatches the tool via the client-tool relay bridge. Cognition subscribes to these events, matches on callId, wraps the payload in a ClientToolResult MemqlClientMessage and forwards it to the agent node via AiForwardRequest so the parked agent tool-loop waiter unblocks.")
concept response {
  callId  string  @required  @description("UUID matching the v1:cognition:client:tool:request this response fulfils.")

  contentJSON  string  @description("JSON-encoded ToolResultContent[] produced by the browser-side tool dispatcher. Empty for error results.")

  isError  bool  @description("True when the tool failed. errorMessage carries the reason.")

  errorMessage  string  @description("Human-readable error message when isError=true. Empty on success.")

  spaceId  string  @description("ID of the space the tool ran against. Propagated from the request for traceability.")
}

// ---- concepts/v1/cognition/space/context/concept.memql ----

@version("1.0.0")
@namespace("cognition:space")
@description("Queryable runtime context snapshot for a space (participants, sessions, media activity). Intended to improve AI turn-taking and provide UI context.")
concept context {
  computedAt  datetime  @required  @description("When this snapshot was computed.")
  lastUpdatedAt  datetime  @required  @description("When this snapshot was last written (same as computedAt for now).")
  snapshot {
    participants {
      active  int
      ais  int
      humans  int
      idle  int
      left  int
      total  int
    }
    sessions {
      ai {
        avatarActive  int
        avatarEnabled  int
        visionEnabled  int
        voiceEnabled  int
      }
      human {
        audioActive  int
        cameraEnabled  int
        isSpeaking  int
        microphoneEnabled  int
        videoActive  int
      }
      tiers  object  @description("Counts of activeTier values.")
      total  int
    }
  }
  spaceId  string  @required  @description("ID of the space this context snapshot belongs to.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
}

// ---- concepts/v1/cognition/micState/concept.memql ----

@version("1.0.0")
@namespace("cognition")
@description("Per-(spaceId, userId) mic state record. The CoPresent MediaControls footer writes this on every mic toggle so the cognition handler can resolve mirror_user audio control: when the user mutes, mirror_user agents skip TTS publish on their next turn; when the user unmutes, they speak. id is the deterministic micState:<spaceId>:<userId> so the latest toggle wins at read time without growing a per-click history. Distinct from v1:cognition:participant.presence -- that record carries SI-side state (thinking / responding / etc) and we don't want mic toggles in the same versioned chain.")
concept micState {
  spaceId    string  @required @description("v1:cognition:space.id this state is scoped to.")
  userId     string  @required @description("v1:identity:user.id whose mic state this is.")
  muted      bool    @required @description("True when the user's LiveKit mic is muted (track.enabled=false). False when actively publishing audio.")
  updatedAt  datetime @required @description("Wall-clock time the toggle landed -- used for staleness checks (e.g. ignore rows older than 30s when picking the effective state).")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="parent", field="userId", target="v1:identity:user", direction="outgoing")
}

@version("1.0.0")
@namespace("cognition")
@description("A human or SI participant instance within a space.")
concept participant {
  agentId  string  @description("ID of the agent template (for SI participants).")
  capabilityOverrides {
    avatar  bool
    lipSync  bool
    vision  bool
    voiceToVoice  bool
  }
  displayName  string  @required  @description("Display name shown in the UI.")
  forUserId  string  @description("v1:identity:user.id this SI participant belongs to (which human's team is this agent on?). Required on every SI participant inserted by the agent-roster mutations -- humans bring their own agents into their own private team chat, never each other's. Empty for human participants. The engine pre-insert guard enforces non-empty forUserId on SI participants and validates it matches the authenticated caller (non-elevated callers cannot land an agent on someone else's team). Used by the per-user-per-space 3-cap and by Phase 6's discussion-mode dispatch loop to find the per-user agent set.")
  isGroupGA  bool  @default(false)  @description("True only on the owner's Assistant when it sits in the space's group context. The owner's GA is the only AI in group chat; specialists stay in per-user team chats. The participant guard rejects status='left' inserts on isGroupGA=true rows from non-elevated callers, so the GA cannot be removed from the group via the Roster tab. Set by the autoJoinSI automation on space creation (Phase 1.5) and never via the agent-roster mutations.")
  isGuest  bool  @default(false)  @description("Whether this participant joined via a guest invite (external, no CoPresent account).")
  joinedAt  datetime  @description("When the participant joined the space.")
  leftAt  datetime  @description("When the participant left the space.")
  participantType  enum("human", "si")  @required  @description("Whether this is a human or SI participant. Guests use \"human\" with isGuest=true and userId empty.")
  spaceId  string  @required  @description("ID of the space this participant belongs to.")
  status  enum("active", "idle", "left")  @default("active")  @description("Participant lifecycle status. Real-time speaking state is tracked in v1:cognition:session.")
  userId  string  @description("External user ID (for human participants).")
  hidden  bool  @default(false)  @description("When true, the participant is present in the space for routing purposes but is never rendered in participant-facing UI (PresencePanel, invite lists, etc.).")

  @relationship(type="interactsWith", field="agentId", target="v1:agents:agent", direction="outgoing")
  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="parent", field="userId", target="v1:identity:user", direction="outgoing")
  @relationship(type="interactsWith", field="forUserId", target="v1:identity:user", direction="outgoing")
}

// ---- concepts/v1/cognition/participant/presence/concept.memql ----

@version("1.0.0")
@namespace("cognition:participant")
@description("UI-friendly presence snapshot for a participant (especially AI). Used to show current agent status such as thinking/responding/waiting.")
concept presence {
  intent {
    action  string
    aiPermission  enum("auto", "requested", "blocked")
    requiresHumanApproval  bool
    shouldRespond  bool
  }
  label  string  @required  @description("Short UI label for the current state (e.g. 'Thinking…', 'Waiting', 'Paused').")
  lastError  string  @description("Optional: last error message (safe, non-sensitive).")
  lastUpdatedAt  datetime  @required  @description("When this presence snapshot was last written.")
  lastUtteranceId  string  @description("Optional: utterance that this status relates to.")
  participantId  string  @required  @description("ID of the participant this presence snapshot describes.")
  reason  string  @description("Optional, user-friendly explanation for state (avoid internal jargon).")
  sinceAt  datetime  @required  @description("When this state began (best-effort).")
  spaceId  string  @required  @description("ID of the space this presence snapshot belongs to.")
  state  enum("idle", "listening", "thinking", "responding", "typing", "waiting", "needs_clarification", "needs_human", "paused", "error", "working", "using_tool", "researching", "investigating")  @required  @description("High-level, user-friendly state for UI rendering.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="parent", field="participantId", target="v1:cognition:participant", direction="outgoing")
}

@version("1.0.0")
@namespace("cognition")
@description("Real-time interaction state tracking device + stream + activity for a participant in a space. Audio capability is gated by the user's mic toggle (humanInput.microphoneEnabled) plus the agent's audioControl mode -- there is NO tier ceiling anymore. Whether voice flows in / out of the room is purely a function of who has their mic open and which agents are configured to publish TTS.")
concept session {
  aiOutput {
    avatarEnabled  bool  @default("false")  @description("Whether AI avatar video is currently rendering.")
    visionEnabled  bool  @default("false")  @description("Whether AI vision processing is currently active.")
    voiceEnabled  bool  @default("false")  @description("Whether AI voice output is currently active.")
  }
  humanInput {
    cameraEnabled  bool  @default("false")  @description("Whether the camera is currently enabled.")
    isSpeaking  bool  @default("false")  @description("Real-time indicator of whether the participant is currently speaking (audio input detected).")
    microphoneEnabled  bool  @default("false")  @description("Whether the microphone is currently enabled.")
  }
  lastActivityAt  datetime  @description("Timestamp of last activity in this session.")
  participantId  string  @required  @description("ID of the participant this session tracks.")
  spaceId  string  @required  @description("ID of the space this session belongs to.")
  startedAt  datetime  @description("When the session started.")
  streams  string  @description("Active stream and session identifiers for external services.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="parent", field="participantId", target="v1:cognition:participant", direction="outgoing")
}

@version("1.0.0")
@namespace("cognition")
@type("collection")
@description("Persistent rooms where humans and AI assistants meet, converse, and interact. Every space is a multi-participant room with a bounded capacity for humans and for agents -- there is no longer a 1:1 vs group distinction.")
@displayCard(primary="name", secondary="kind", tertiary="ownerUserId", status="status")
concept space {
  ownerUserId  string  @required  @description("v1:identity:user.id of the space owner. The owner is the human whose assistant is wired into the space (the only AI presence that speaks to humans). Stamped at create time from the request actor; the @relationship below pins the parent.")
  active  bool  @default("true")  @description("Whether the space is active. Set to false when the space leaves the active list (archived, saved, or hard-deleted) -- traitIsActiveRecord (payload.active==true) hides it from active-tab queries.")
  deleted  bool  @default("false")  @description("Hard-delete tombstone. Set to true by mutationDeleteSpaceNow (the Archived-tab \"Delete now\" override) and by the purgeExpiredArchivedSpaces cron when an archived space hits its retention deadline. traitIsNotDeleted (payload.deleted!=true) filters these rows out of every listing; mirrors v1:cognition:privateUtterance.deleted.")
  archivedAt  datetime  @description("When the space was archived. Only set on rows whose status flipped to 'archived'. Cleared when the space is restored to active or saved.")
  expiresAt  datetime  @description("Concrete deadline at which the purge cron hard-deletes this archived space. Stamped at archive time as archivedAt + User.preferences.archiveRetentionDays. Re-stamped on retention-setting changes so a 30->60 bump extends currently-archived spaces. The cron query is a plain `payload.expiresAt < now` comparison -- no per-row user lookup needed.")
  savedAt  datetime  @description("When the user manually saved the space ('saved' status -- preserved indefinitely, never auto-deleted). Cleared when the space leaves the saved state.")
  description  string  @description("Optional description of the space.")
  goal {
    statement  string  @description("Short statement of what the space is working toward (e.g. \"Plan Q3 roadmap\"). Set by the Configure-manually path in CreateSpaceModal; the display name can be auto-derived from it via aiSuggest(domain=spaceTitle). Optional -- the AI-describe path produces a name directly without a goal.")
    timeframe  enum("daily", "weekly", "monthly")  @description("The cadence the goal is pursued on. Purely descriptive grounding for cognition -- NOT related to space.kind=daily or status=scheduled (those are separate lifecycle concerns).")
  }
  name  string  @required  @description("Display name of the space.")
  participantIds  []string  @description("IDs of participants in this space.")
  maxHumans  int  @default("5")  @description("Maximum number of human participants allowed in this space (default 5). Enforced at join time by the participant pre-insert guard.")
  maxAgents  int  @default("1")  @description("Maximum number of AI assistant participants allowed in this space. Always 1 under the one-assistant model (copresent #124): a space carries EXACTLY ONE assistant -- the owner's currently-active one, auto-joined by the autoJoinSI automation. Specialists and system agents never participate in spaces.")
  scheduledAt  datetime  @description("When the space is scheduled to start (if status is 'scheduled').")
  settings {
    autoTranscribe  bool  @default("true")  @description("Whether to automatically transcribe audio.")
    defaultAITier  enum("text", "speechToText", "voiceToVoice", "voiceAvatar", "voiceVision")  @default("text")  @description("Default interaction tier for AI participants.")
    recordMedia  bool  @default("false")  @description("Whether to record audio/video.")
  }
  spaceType  enum("employeeCheckin", "advocatePortal", "handoffSession", "<nil>")  @description("Type of HR space for mode-specific AI behavior.")
  status  enum("active", "saved", "archived", "scheduled")  @default("active")  @description("Current lifecycle status of the space. Active = working space (default). Saved = manually preserved by the user; never auto-deleted. Archived = hidden from the active list and on a retention countdown to hard-delete (see archivedAt + User.preferences.archiveRetentionDays). Scheduled = future-dated meeting.")
  kind  enum("regular", "daily")  @default("regular")  @description("Space kind. 'regular' is the user-created default. 'daily' is a per-user singleton automatically provisioned every day; pinned at the top of the active list, private to the user + their assistant, and rolled over by the rolloverDailySpace cron.")
  private  bool  @default("false")  @description("When true, the space is private to its creator and their assistant -- no other users / agents can join. Daily spaces always set this to true.")
  dailyDateKey  string  @description("YYYY-MM-DD date stamp for daily spaces, computed in the user's local timezone at provisioning time. Used to make the space id idempotent (daily-{userHash}-{dateKey}) so a duplicate provision is a no-op. Empty for non-daily spaces.")
  turnStateId  string  @description("ID of the turn state owned by this space.")
  utteranceIds  []string  @description("IDs of utterances in this space.")

  @relationship(type="parent", field="ownerUserId", target="v1:identity:user", direction="outgoing")
  @relationship(type="contains", field="participantIds", target="v1:cognition:participant", direction="outgoing")
  @relationship(type="owns", field="turnStateId", target="v1:cognition:turn:state", direction="outgoing")
  @relationship(type="contains", field="utteranceIds", target="v1:cognition:utterance", direction="outgoing")
}

@version("1.0.0")
@namespace("cognition:turn")
@description("Tracks conversation turn-taking state including who is speaking and AI participation permissions.")
concept state {
  aiAnalysisJSON  string  @description("Raw JSON string with richer analysis output (internal/debug/UI).")
  aiDecision {
    action  enum("respond", "ask_clarifying", "wait", "yield", "notify_human", "block")  @default("wait")  @description("Recommended action for the AI in response to the most recent utterance.")
    confidence  float  @description("Confidence score (0..1) for the decision.")
    mentionedAI  bool  @default("false")  @description("Whether the AI assistant was explicitly mentioned or addressed.")
    reason  string  @description("Human-readable explanation for the decision (safe to show in UI).")
    requiresHumanApproval  bool  @default("false")  @description("Whether a human must approve before the AI takes an action beyond replying.")
    sentiment  enum("positive", "neutral", "negative", "unknown")  @default("unknown")  @description("Coarse sentiment signal for the most recent utterance.")
    shouldRespond  bool  @default("false")  @description("Whether an AI agent should respond to the most recent utterance.")
  }
  aiPermission  enum("auto", "requested", "blocked")  @default("auto")  @description("Permission level for AI to jump into conversation.")
  conversationContextJSON  string  @description("JSON string containing enriched conversation context from the turn state decision analysis (tone, topic continuity, momentum, pending topics).")
  currentSpeakerId  string  @description("ID of the participant currently speaking.")
  lastActivityAt  datetime  @description("Timestamp of last conversation activity.")
  lastNudgeAt  datetime  @description("Timestamp when the silence nudge evaluation was last performed.")
  lastNudgeUtteranceId  string  @description("Utterance ID for which the silence nudge evaluation was last performed (idempotency key).")
  lastUtteranceId  string  @description("ID of the most recent utterance observed for this space.")
  lastUtteranceType  string  @description("Type of the most recent utterance observed (speech, text, action, system).")
  queue  []string  @description("Queue of participant IDs waiting to speak.")
  respondingAgentId  string  @description("ID of the AI participant selected to respond in this turn. Used by the AI responder to pick the right agent in multi-agent spaces.")
  silenceDuration  int  @description("Milliseconds of silence (for detecting pauses).")
  spaceId  string  @required  @description("ID of the space this turn state belongs to.")
  trigger  string  @description("Why this turn state version was produced (e.g., utterance, silence_nudge, init).")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
}

@version("1.0.0")
@namespace("cognition")
@description("A single multi-modal contribution to the conversation stream.")
concept utterance {
  action {
    idempotencyKey  string  @description("Optional idempotency key to allow safe retries.")
    payload  object  @description("JSON-serializable action payload (object).")
    schemaVersion  int  @description("Schema version for the action payload.")
    type  string  @description("Action type identifier (e.g., 'form.submit').")
  }
  analysis {
    entities  []object  @description("Extracted entities.")
    intent  string  @description("Detected intent or action.")
    mentionedParticipants  []string  @description("IDs of participants mentioned.")
    sentiment  string  @description("Detected sentiment.")
    shouldSIRespond  bool  @description("Hint for turn-taking: should SI respond?")
  }
  audioId  string  @description("ID of associated audio media asset.")
  citations  []object  @description("Source citations for the utterance text. Each item has shape {domainId: string, matchedPhrase: string} -- the frontend wraps each matchedPhrase in the rendered text with a clickable chip linking to the named knowledge domain. Populated by cognition from the agent's respondToUser envelope.")
  retrieved  []object  @description("RAG retrieval audit -- the full chunk pool the agent's replier surfaced to the LLM BEFORE the model decided what to cite. Each item has shape {domainId, sourceRef, similarity, textPreview, citation}. Distinct from `citations`: `citations` names what the model used; `retrieved` names what the model SAW. The frontend's 'Show details' expander beneath each agent reply renders both so the user can see passages the model considered but didn't cite. Empty when no domains were attached or retrieval returned nothing.")
  duration  int  @description("Duration in milliseconds (for audio/video).")
  participantId  string  @required  @description("ID of the participant who created this utterance.")
  participantType  enum("human", "si", "system")  @description("Type of participant (denormalized from participant for filtering).")
  replyToId  string  @description("ID of utterance this is replying to (for threading).")
  source {
    avatarProvider  string  @description("Avatar video provider used (e.g., heygen, simli).")
    inputMethod  enum("typed", "stt", "realtimeVoice")  @description("How the human created this utterance.")
    outputMethod  enum("text", "tts", "realtimeVoice", "avatarVideo")  @description("How the SI delivered this utterance.")
    pipeline  string  @description("Source pipeline label, e.g. \"polyphon\" for utterances created by the bridge agent's STT path. Replaces the retired tier field; the cognition handler keys voice-vs-text routing on this when present.")
    sttProvider  string  @description("Speech-to-text provider used (e.g., openai-realtime, openai-whisper, deepgram).")
    ttsProvider  string  @description("Text-to-speech provider used (e.g., elevenlabs, openai).")
  }
  spaceId  string  @required  @description("ID of the space this utterance belongs to.")
  text  string  @description("Text content (transcribed or typed).")
  timestamps {
    words  []object
  }
  utteranceType  enum("speech", "text", "action", "system")  @required  @description("Type of utterance.")
  videoId  string  @description("ID of associated video media asset.")

  @relationship(type="interactsWith", field="participantId", target="v1:cognition:participant", direction="outgoing")
  @relationship(type="interactsWith", field="replyToId", target="v1:cognition:utterance", direction="outgoing")
  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
}

// ---- concepts/v1/cognition/videoOverride/concept.memql ----

@version("1.0.0")
@namespace("cognition")
@description("Per-(spaceId, agentId) video control override. Lets a user dial a single agent's avatar publication on / off / mirror_user inside one space without changing the agent's own default (videoControl on v1:agents:agent). Mirrors v1:cognition:audioOverride exactly -- same fields, same id pattern, same write/read paths -- but governs lip-synced video instead of TTS audio. Read by the voice-agent process at session start (Phase 9): an active override beats the agent default; absence falls through to the agent default. id is the deterministic videoOverride:<spaceId>:<agentId> so re-toggling on the same orb hits the same row instead of growing a per-click history.")
concept videoOverride {
  spaceId   string  @required @description("v1:cognition:space.id this override is scoped to.")
  agentId   string  @required @description("v1:agents:agent.id this override targets.")
  setBy     string  @description("v1:identity:user.id of the actor who flipped the override -- the space owner under v1 permission rules. Audited against v1:identity:auditEvent.")
  mode      enum("always_on", "always_off", "mirror_user")  @required @description("Effective publication state. The voice-agent's avatar-gating path treats this exactly the same as the agent default once selected: always_on publishes unconditionally; always_off suppresses video while letting audio + chat continue; mirror_user honours the user's current video state at session start.")
  active    bool  @default("true") @description("Soft-revoke flag. Setting active=false collapses back to the agent default without losing the row's history.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="interactsWith", field="agentId", target="v1:agents:agent", direction="outgoing")
}

@version("1.0.0")
@namespace("cognition")
@description("Rolled-up guardrail health metrics for a time window. Written by the rollupGuardrailHealth automation from v1:cognition:unmetCapability rows; advisory-only signal for tuning the fit-score threshold and identifying missing specialist domains. One row per rollup run.")
concept guardrailHealth {
  periodStart             datetime  @required  @description("Start of the rollup window (inclusive).")
  periodEnd               datetime  @required  @description("End of the rollup window (exclusive).")
  generatedAt             datetime  @required  @description("When this rollup was produced.")

  totalUnmet              int  @required  @default("0")  @description("Total v1:cognition:unmetCapability rows in the window.")
  specialistGapCount      int  @required  @default("0")  @description("Rows with severity=specialist_gap -- assistant absorbed the turn.")
  fullGapCount            int  @required  @default("0")  @description("Rows with severity=full_gap -- no agent could help.")

  belowThresholdCount     int  @default("0")  @description("Triggered by the fit-score gate.")
  handoffChainCapCount    int  @default("0")  @description("Triggered by the handoff-chain cap.")
  noFitNoFallbackCount    int  @default("0")  @description("Triggered when no fallback agent was available (silent).")
  routerEscalatedCount    int  @default("0")  @description("Triggered when the router itself requested escalation_notice.")
  routerFallbackCount     int  @default("0")  @description("Triggered when the router itself requested fallback_attempt.")

  avgFitScore             float  @description("Mean topFitScore across the window (null when totalUnmet==0).")
  currentThreshold        float  @description("Fit-score threshold in effect at rollup time.")
  suggestedThreshold      float  @description("Advisory threshold suggestion based on observed fit-score distribution. Consumer decides whether to apply.")

  topMissingDomains       string  @description("JSON array of { domain, count } entries ranked by frequency -- clusters of utterances that nobody in the relevant spaces could handle. Product signal for which specialist agents to add next.")
  topSpaces               string  @description("JSON array of { spaceId, count } entries -- spaces with the highest unmet rate.")
  notes                   string  @description("Free-form notes from the rollup (e.g. 'handoff_chain_cap triggered 8x, review routing prompt').")
}

@version("1.0.0")
@namespace("cognition")
@description("A single instance of the cognition router determining that no agent in a space could meet the user's request -- either the assistant stepped in as fallback (specialist_gap) or nobody could help (full_gap). Emitted by cognition via the cognition.capability.unmet event and consumed by the guardrail health rollup for product-level insight into missing capabilities.")
concept unmetCapability {
  spaceId          string   @required  @description("ID of the space the utterance occurred in.")
  utteranceId      string   @description("ID of the triggering human utterance.")
  utterance        string   @description("Text of the user's request that no agent could meet.")
  speakerName      string   @description("Display name of the human who spoke.")

  severity         enum("specialist_gap", "full_gap")  @required  @description("specialist_gap: assistant absorbed the turn as fallback (we lacked a specialist). full_gap: even the assistant could not help / no assistant in the room.")
  turnMode         enum("answer", "fallback_attempt", "escalation_notice")  @description("Turn mode the router chose. answer = specialist stretch absorbed it; fallback_attempt = assistant stretched on a knowledge gap; escalation_notice = assistant refused and flagged.")
  trigger          enum("below_threshold", "handoff_chain_cap", "no_fit_no_fallback", "router_escalated", "router_fallback")  @required  @description("Why the unmet event fired: threshold gate, chain cap, missing assistant, or router-initiated.")

  topFitScore      float   @description("Router's fit score for the chosen agent (0..1). Low scores indicate nobody was a strong match.")
  routedAgentId    string  @description("ID of the agent the router ultimately routed to (may be empty when no agent was selected).")
  routedAgentName  string  @description("Display name of the routed agent.")

  rosterSnapshot   string  @description("JSON-serialized snapshot of the space's agent roster at decision time (id/name/role/domains/keywords). Used by the rollup to cluster missing domains.")
  reason           string  @description("Router's short explanation of why no agent fit.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
}

// ---- concepts/v1/cognition/privateUtterance/concept.memql ----

@version("1.0.0")
@namespace("cognition")
@description("Per-user 'Team-tab' utterance -- the private thread sister of v1:cognition:utterance. Each row lives in exactly one user's Team thread inside a space (the row's forUserId names the owner); the group thread reads NEVER surface it. forUserId is SERVER-STAMPED from actor.userId on insert -- callers cannot land a privateUtterance in someone else's thread regardless of what they pass. Authz tier: owned. Driven by the SPA's Team-tab + misroute Move flows (visionarys-io/copresent#44, Phase 8). Spec ref: memql#190.")
concept privateUtterance {
  forUserId        string  @required @description("The user whose Team-tab thread owns this row. Server-stamped from actor.userId pre-insert by every mutation in this concept.")
  spaceId          string  @required @description("Owning space.")
  participantId    string  @required @description("v1:cognition:participant.id of the speaker. May be a human (the owner) OR an SI (an agent reply in the Team thread).")
  participantType  enum("human", "si", "system") @description("Denormalized from participant for filtering. Mirrors v1:cognition:utterance.participantType.")
  text             string  @description("Text content -- typed or transcribed.")
  utteranceType    enum("speech", "text", "action", "system")  @required @description("Same enum as v1:cognition:utterance.utteranceType; carried so the renderer doesn't have to branch on concept.")
  replyToId        string  @description("Optional reply-to utterance id. Cross-thread allowed for misroute Move (a reply in the private thread to a group-thread utterance).")
  source           object  @description("Same shape as v1:cognition:utterance.source -- inputMethod / pipeline / sttProvider / etc.")
  active           bool    @default("true") @description("Soft-deactivate flag.")
  deleted          bool    @default("false") @description("Soft-delete flag.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
  @relationship(type="interactsWith", field="participantId", target="v1:cognition:participant", direction="outgoing")
}

// ---- concepts/v1/cognition/misrouteFeedback/concept.memql ----

@version("1.0.0")
@namespace("cognition")
@description("Append-only audit row capturing the misroute classifier's prediction and the user's response. Phase 8 feedback corpus -- drives tuning of the wrong-tab gating classifier whose toggle is exposed in CoPresent's Conversation Preferences (misrouteSafetyEnabled). forUserId is SERVER-STAMPED from actor.userId pre-insert. One row per classifier-gated send: when the user moves the message, dismisses the warning, the timeout fires, or the classifier blocks outright. Authz tier: owned. Spec ref: memql#190.")
concept misrouteFeedback {
  forUserId        string  @required @description("User whose send action triggered the classifier. Server-stamped from actor.userId pre-insert.")
  spaceId          string  @required @description("Space the send was scoped to.")
  originalThread   enum("group", "private")  @required @description("Tab the user was typing into when the classifier fired.")
  intendedThread   enum("group", "private")  @required @description("Tab the classifier predicted as the better fit.")
  confidence       float   @required @description("Classifier confidence 0.0-1.0.")
  why              string  @description("Classifier rationale -- free text the model emits alongside its decision.")
  message          string  @required @description("The original message text the classifier scored.")
  utteranceId      string  @description("Source utterance id when the row was persisted (the user wasn't blocked at send time).")
  movedToId        string  @description("Destination utterance id when userAction='moved'. Empty otherwise.")
  userAction       enum("moved", "dismissed", "timeout", "blocked") @required @description("How the user responded. 'moved' = clicked Move, classifier won; 'dismissed' = clicked Send anyway; 'timeout' = warning auto-collapsed; 'blocked' = hard-block prevented send entirely.")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
}

// ---- concepts/v1/cognition/greetSuppression/concept.memql ----

@version("1.0.0")
@namespace("cognition")
@description("Short-lived marker that suppresses the greet-on-join LLM greeting for a space while a first-run walkthrough / guide is starting (copresent#252). The frontend arms it (deterministic id per space) when a brand-new user's first-run flow begins; greet-on-join reads it (queryActiveGreetSuppression) and SKIPS the greeting + LLM call when a non-expired one exists -- so the wasteful opening greeting doesn't fire while the guided intake is taking over the conversation. TTL-bounded via expiresAt so it never permanently mutes greetings. id is the deterministic greetSuppression-<hash(canonical spaceId)> so re-arming the same space upserts the latest row instead of growing history. Space-scoped (read by the cognition handler), mirroring v1:cognition:audioOverride.")
concept greetSuppression {
  spaceId    string  @required @description("Canonical v1:cognition:space.id whose greet-on-join to suppress.")
  armedBy    string  @description("v1:identity:user.id of the actor who armed it (the space owner under v1 permission rules). Audit only.")
  expiresAt  string  @required @description("RFC3339; the suppression is ignored once now > expiresAt.")
  active     bool    @default("true") @description("Soft-revoke flag (mirrors the override concepts).")

  @relationship(type="parent", field="spaceId", target="v1:cognition:space", direction="outgoing")
}
