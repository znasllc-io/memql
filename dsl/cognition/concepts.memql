// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use agents.concepts.{ agent }
use identity.concepts.{ user }

/// Per-(partitionId, agentId) audio control override. Lets a user dial a single agent's TTS
/// publication on / off / mirror_user inside one space without changing the agent's own default
/// (audioControl on v1:agents:agent). Written by the orb-corner overlay in PresencePanel + the
/// canvas presence widget. Read by the cognition handler before forwarding TTS to the Bridge Agent:
/// an active override beats the agent default; absence falls through to the agent default. id is
/// the deterministic audioOverride:<partitionId>:<agentId> so re-toggling on the same orb hits the
/// same row instead of growing a per-click history.
@displayCard(primary="mode", secondary="agentId", tertiary="setBy", status="active")
concept audioOverride {
  partitionId   string! @description("v1:cognition:space.id this override is scoped to.")
  agentId   string! @description("v1:agents:agent.id this override targets.")
  setBy     string  @description("v1:identity:user.id of the actor who flipped the override -- the space owner under v1 permission rules. Audited against v1:identity:auditEvent.")
  mode      enum("always_on", "always_off", "mirror_user")! @description("Effective publication state. The bridge gating path treats this exactly the same as the agent default once selected: always_on publishes unconditionally; always_off suppresses TTS while letting text replies still flow to chat; mirror_user honours the user's current mic state, querying it at TTS-start time (not per-frame).")
  active    bool  @default("true") @description("Soft-revoke flag. Setting active=false collapses back to the agent default without losing the row's history.")

  @relationship(type="interactsWith", field="agentId", target=agent, direction="outgoing")
}

/// A streaming text chunk emitted incrementally during AI response generation. The frontend
/// subscribes to creation events and accumulates chunks into a real-time message.
// @no-displayCard: Transport, not an entity. One row per streamed token batch -- thousands
//   per reply -- and `text` is a partial fragment that is meaningless outside
//   the `replyId` accumulation it belongs to. Promoting it to a row label
//   would present fragments as if they were messages.
@namespace("cognition:text")
concept chunk {
  done  bool!  @description("Whether this is the final chunk.")
  index  int!  @description("Sequential chunk index (0-based).")
  participantId  string!  @description("AI participant generating the text.")
  replyId  string!  @description("Stable id for the entire turn. Every chunk in the same agent reply carries the same replyId, and the committed utterance for the reply uses this as its id. The frontend keys the rendered bubble by replyId so streaming chunks and the final commit address the same React element -- no remount, no avatar flicker.")
  partitionId  string!  @description("Space where the text is being generated.")
  text  string!  @description("The text content of this chunk.")

  @relationship(type="createdBy", field="participantId", target=participant, direction="outgoing")
}

/// Ephemeral request envelope for a client-executed tool call bridging cluster nodes. Inserted by
/// cognition's client-tool relay when the agent node emits a ClientToolCall that needs to reach a
/// browser stream on BFF. The browser (via its client-tool relay bridge) subscribes to these
/// events, dispatches the tool, and inserts a matching v1:cognition:client:tool:response. Records
/// are not retained -- once the response arrives the pair is a no-op for future consumers. Lives
/// under v1:cognition because the relay is a cognition-level concern (mediating between the agent
/// loop and the browser stream); consuming products need not define their own variant.
@displayCard(primary="toolName", secondary="callId", tertiary="agentId")
@namespace("cognition:client:tool")
concept request {
  callId  string!  @description("UUID correlating this request with its eventual v1:cognition:client:tool:response. Matches the ClientToolCall.call_id the agent emitted.")

  toolName  string!  @description("Canonical tool name (e.g. `uiReadState`, `uiHighlight`). Resolved against the client-side tool registry.")

  argumentsJSON  string  @description("JSON-encoded arguments object for the tool. Empty string is equivalent to `{}`.")

  partitionId  string  @description("ID of the space this turn belongs to. Used to scope subscriptions on the browser side so each user only responds to calls aimed at their active space.")

  participantId  string  @description("ID of the participant the browser is acting as. Lets the browser filter to its own user/session and prevents a call intended for user A from being answered by user B sharing the space.")

  agentId  string  @description("ID of the agent that requested the call. Audit-only -- the response routes back to the agent via cognition, not via this field.")

  expiresAt  datetime  @description("When the request stops being valid. Browsers arriving late ignore requests past this time; cognition drops stale correlations.")
}

// ---- concepts/v1/cognition/client/tool/response/concept.memql ----

/// Ephemeral response envelope paired with a v1:cognition:client:tool:request. Inserted by the
/// browser after it dispatches the tool via the client-tool relay bridge. Cognition subscribes to
/// these events, matches on callId, wraps the payload in a ClientToolResult MemqlClientMessage and
/// forwards it to the agent node via AiForwardRequest so the parked agent tool-loop waiter
/// unblocks.
// @no-displayCard: The return leg of a client tool call, addressed only by the `callId` it
//   answers; the payload is an opaque JSON blob. Nothing on the row labels it
//   -- the request (which carries `toolName`) is the browsable half of the
//   pair.
@namespace("cognition:client:tool")
concept response {
  callId  string!  @description("UUID matching the v1:cognition:client:tool:request this response fulfils.")

  contentJSON  string  @description("JSON-encoded ToolResultContent[] produced by the browser-side tool dispatcher. Empty for error results.")

  isError  bool  @description("True when the tool failed. errorMessage carries the reason.")

  errorMessage  string  @description("Human-readable error message when isError=true. Empty on success.")

  partitionId  string  @description("ID of the space the tool ran against. Propagated from the request for traceability.")
}

/// A human or AI participant instance within a space.
@displayCard(primary="displayName", secondary="participantType", tertiary="agentId", status="status")
concept participant {
  agentId  string  @description("ID of the agent template (for AI participants).")
  capabilityOverrides {
    avatar  bool
    lipSync  bool
    vision  bool
    voiceToVoice  bool
  }
  displayName  string!  @description("Display name shown in the UI.")
  forUserId  string  @description("v1:identity:user.id this AI participant belongs to (which human's team is this agent on?). Required on every AI participant inserted by the agent-roster mutations -- humans bring their own agents into their own private team chat, never each other's. Empty for human participants. The engine pre-insert guard enforces non-empty forUserId on AI participants and validates it matches the authenticated caller (non-elevated callers cannot land an agent on someone else's team). Used by the per-user-per-space 3-cap and by Phase 6's discussion-mode dispatch loop to find the per-user agent set.")
  isGroupGA  bool  @default(false)  @description("True only on the owner's Assistant when it sits in the space's group context. The owner's GA is the only AI in group chat; specialists stay in per-user team chats. The participant guard rejects status='left' inserts on isGroupGA=true rows from non-elevated callers, so the GA cannot be removed from the group via the Roster tab. Set by the autoJoinAI automation on space creation (Phase 1.5) and never via the agent-roster mutations.")
  isGuest  bool  @description("Whether this participant joined via a guest invite (external, no user account of their own). No mutation writes it; an absent value reads as false (not a guest), which is the fail-closed direction.")
  joinedAt  datetime  @description("When the participant joined the space.")
  leftAt  datetime  @description("When the participant left the space.")
  participantType  enum("human", "si")!  @description("Whether this is a human or AI participant. Guests use \"human\" with isGuest=true and userId empty.")
  partitionId  string!  @description("ID of the space this participant belongs to.")
  status  enum("active", "idle", "left")  @default("active")  @description("Participant lifecycle status. Real-time speaking state is tracked in v1:cognition:session.")
  userId  string  @description("External user ID (for human participants).")
  hidden  bool  @default(false)  @description("When true, the participant is present in the space for routing purposes but is never rendered in participant-facing UI (PresencePanel, invite lists, etc.).")

  @relationship(type="interactsWith", field="agentId", target=agent, direction="outgoing")
  @relationship(type="parent", field="userId", target=user, direction="outgoing")
  @relationship(type="interactsWith", field="forUserId", target=user, direction="outgoing")
}

// ---- concepts/v1/cognition/participant/presence/concept.memql ----

/// UI-friendly presence snapshot for a participant (especially AI). Used to show current agent
/// status such as thinking/responding/waiting.
@displayCard(primary="label", secondary="participantId", tertiary="reason", status="state")
@namespace("cognition:participant")
concept presence {
  intent {
    action  string
    aiPermission  enum("auto", "requested", "blocked")
    requiresHumanApproval  bool
    shouldRespond  bool
  }
  label  string!  @description("Short UI label for the current state (e.g. 'Thinking…', 'Waiting', 'Paused').")
  lastError  string  @description("Optional: last error message (safe, non-sensitive).")
  lastUpdatedAt  datetime!  @description("When this presence snapshot was last written.")
  lastUtteranceId  string  @description("Optional: utterance that this status relates to.")
  participantId  string!  @description("ID of the participant this presence snapshot describes.")
  reason  string  @description("Optional, user-friendly explanation for state (avoid internal jargon).")
  sinceAt  datetime!  @description("When this state began (best-effort).")
  partitionId  string!  @description("ID of the space this presence snapshot belongs to.")
  state  enum("idle", "listening", "thinking", "responding", "typing", "waiting", "needs_clarification", "needs_human", "paused", "error", "working", "using_tool", "researching", "investigating")!  @description("High-level, user-friendly state for UI rendering.")

  @relationship(type="parent", field="participantId", target=participant, direction="outgoing")
}

/// Real-time interaction state tracking device + stream + activity for a participant in a space.
/// Audio capability is gated by the user's mic toggle (humanInput.microphoneEnabled) plus the
/// agent's audioControl mode -- there is NO tier ceiling anymore. Whether voice flows in / out of
/// the room is purely a function of who has their mic open and which agents are configured to
/// publish TTS.
// @no-displayCard: Per-participant streaming bookkeeping: two nested objects, a stream map,
//   and three timestamps. Every scalar is a foreign key or a clock reading,
//   so a primary slot would be a forced choice that identifies nothing.
concept session {
  aiOutput {
    avatarEnabled  bool  @default("false")  @description("Whether AI avatar video is currently rendering.")
    visionEnabled  bool  @default("false")  @description("Whether AI vision processing is currently active.")
    voiceEnabled  bool  @default("false")  @description("Whether AI voice output is currently active.")
  }
  humanInput {
    cameraEnabled  bool  @default("false")  @description("Whether the camera is currently enabled.")
    isSpeaking  bool  @default("false")  @description("Real-time indicator of whether the participant is currently speaking (audio input detected).")
    microphoneEnabled  bool  @default("false")  @description("Whether the microphone is currently enabled.")
  }
  lastActivityAt  datetime  @description("Timestamp of last activity in this session.")
  participantId  string!  @description("ID of the participant this session tracks.")
  partitionId  string!  @description("ID of the space this session belongs to.")
  startedAt  datetime  @description("When the session started.")
  streams  object  @description("Active stream and session identifiers for external services: {realtimeSessionId?, avatarStreamId?, audioTrackId?, videoTrackId?}. Matches the createSessionForParticipant `streams object` arg and the SPA's SessionStreams payload (memql#1321).")

  @relationship(type="parent", field="participantId", target=participant, direction="outgoing")
}

/// Tracks conversation turn-taking state including who is speaking and AI participation
/// permissions.
// @no-displayCard: Singleton turn-state row per space. Every scalar is either a foreign key
//   that changes on each turn (currentSpeakerId, lastUtteranceId) or a machine
//   counter, so a primary slot would relabel the same row on every write. The
//   row id -- the space -- is the stable identity.
@namespace("cognition:turn")
concept state {
  aiAnalysisJSON  string  @description("Raw JSON string with richer analysis output (internal/debug/UI).")
  aiDecision {
    action  enum("respond", "ask_clarifying", "wait", "yield", "notify_human", "block")  @default("wait")  @description("Recommended action for the AI in response to the most recent utterance.")
    confidence  float  @description("Confidence score (0..1) for the decision.")
    mentionedAI  bool  @default("false")  @description("Whether the AI assistant was explicitly mentioned or addressed.")
    reason  string  @description("Human-readable explanation for the decision (safe to show in UI).")
    requiresHumanApproval  bool  @default("false")  @description("Whether a human must approve before the AI takes an action beyond replying.")
    sentiment  enum("positive", "neutral", "negative", "unknown")  @default("unknown")  @description("Coarse sentiment signal for the most recent utterance.")
    shouldRespond  bool  @default("false")  @description("Whether an AI agent should respond to the most recent utterance.")
  }
  aiPermission  enum("auto", "requested", "blocked")  @description("Permission level for AI to jump into conversation. Convention: \"auto\" -- NOT applied on insert, and no mutation is bound to this concept, so a writer must supply it explicitly.")
  conversationContextJSON  string  @description("JSON string containing enriched conversation context from the turn state decision analysis (tone, topic continuity, momentum, pending topics).")
  currentSpeakerId  string  @description("ID of the participant currently speaking.")
  lastActivityAt  datetime  @description("Timestamp of last conversation activity.")
  lastNudgeAt  datetime  @description("Timestamp when the silence nudge evaluation was last performed.")
  lastNudgeUtteranceId  string  @description("Utterance ID for which the silence nudge evaluation was last performed (idempotency key).")
  lastUtteranceId  string  @description("ID of the most recent utterance observed for this space.")
  lastUtteranceType  string  @description("Type of the most recent utterance observed (speech, text, action, system).")
  queue  []string  @description("Queue of participant IDs waiting to speak.")
  respondingAgentId  string  @description("ID of the AI participant selected to respond in this turn. Used by the AI responder to pick the right agent in multi-agent spaces.")
  silenceDuration  int  @description("Milliseconds of silence (for detecting pauses).")
  partitionId  string!  @description("ID of the space this turn state belongs to.")
  trigger  string  @description("Why this turn state version was produced (e.g., utterance, silence_nudge, init).")

}

/// A single multi-modal contribution to the conversation stream.
@displayCard(primary="text", secondary="participantType", tertiary="participantId", status="utteranceType")
concept utterance {
  action {
    idempotencyKey  string  @description("Optional idempotency key to allow safe retries.")
    payload  object  @description("JSON-serializable action payload (object).")
    schemaVersion  int  @description("Schema version for the action payload.")
    type  string  @description("Action type identifier (e.g., 'form.submit').")
  }
  analysis {
    entities  []object  @description("Extracted entities.")
    intent  string  @description("Detected intent or action.")
    mentionedParticipants  []string  @description("IDs of participants mentioned.")
    sentiment  string  @description("Detected sentiment.")
    shouldAIRespond  bool  @description("Hint for turn-taking: should AI respond?")
  }
  audioId  string  @description("ID of associated audio media asset.")
  citations  []object  @description("Source citations for the utterance text. Each item has shape {domainId: string, matchedPhrase: string} -- the frontend wraps each matchedPhrase in the rendered text with a clickable chip linking to the named knowledge domain. Populated by cognition from the agent's respondToUser envelope.")
  retrieved  []object  @description("RAG retrieval audit -- the full chunk pool the agent's replier surfaced to the LLM BEFORE the model decided what to cite. Each item has shape {domainId, sourceRef, similarity, textPreview, citation}. Distinct from `citations`: `citations` names what the model used; `retrieved` names what the model SAW. The frontend's 'Show details' expander beneath each agent reply renders both so the user can see passages the model considered but didn't cite. Empty when no domains were attached or retrieval returned nothing.")
  duration  int  @description("Duration in milliseconds (for audio/video).")
  participantId  string!  @description("ID of the participant who created this utterance.")
  participantType  enum("human", "si", "system")  @description("Type of participant (denormalized from participant for filtering).")
  replyToId  string  @description("ID of utterance this is replying to (for threading).")
  source {
    agentId  string  @description("v1:agents:agent.id of the AI TEMPLATE that produced this utterance, stamped by cognition's responder on every AI reply. Distinct from participantId, which is per-(space, agent): a cross-space read like agentInteractionCount needs a stable agent identity to filter on, and without this stamp agentIsKnownToUser permanently returns false and agents re-introduce themselves in every new space.")
    avatarProvider  string  @description("Avatar video provider used (e.g., heygen, simli).")
    feedbackAnnouncePlanId  string  @description("v1:planner:plan.id whose awaitingFeedback announcement this utterance is. Read by feedbackAnnouncementForPlan as the read-before-write dedup behind the cross-replica announce gate (#1406), so a duplicate plan-updated event cannot re-post the same needs-your-input message.")
    inputMethod  enum("typed", "stt", "realtimeVoice")  @description("How the human created this utterance.")
    kind  string  @description("Sub-type discriminator for system- and agent-generated utterances, keyed on by readers that want one flavour rather than all of them (greetingUtterance filters kind==\"agentGreeting\"). Written by three paths: cognition's action notices (insertSystemActionUtterance), the plan-feedback announce/ack pair, and the createGreetingUtterance mutation. Known values: agentGreeting, planFeedbackRequest, planFeedbackAck, reactive_dispatch_start, reactive_dispatch_result, unmet_capability. Deliberately a plain string rather than an enum -- insertSystemActionUtterance merges an arbitrary caller-supplied map into the source, so the set is open by construction and pinning it here would reject a value a writer already emits.")
    outputMethod  enum("text", "tts", "realtimeVoice", "avatarVideo")  @description("How the AI delivered this utterance.")
    pipeline  string  @description("Source pipeline label, e.g. \"polyphon\" for utterances created by the bridge agent's STT path. Replaces the retired tier field; the cognition handler keys voice-vs-text routing on this when present.")
    sttProvider  string  @description("Speech-to-text provider used (e.g., openai-realtime, openai-whisper).")
    ttsProvider  string  @description("Text-to-speech provider used (e.g., elevenlabs, openai).")
  }
  partitionId  string!  @description("ID of the space this utterance belongs to.")
  text  string  @description("Text content (transcribed or typed).")
  timestamps {
    words  []object
  }
  utteranceType  enum("speech", "text", "action", "system")!  @description("Type of utterance.")
  videoId  string  @description("ID of associated video media asset.")

  @relationship(type="interactsWith", field="participantId", target=participant, direction="outgoing")
  @relationship(type="interactsWith", field="replyToId", target=utterance, direction="outgoing")
}

// ---- concepts/v1/cognition/videoOverride/concept.memql ----

/// Per-(partitionId, agentId) video control override. Lets a user dial a single agent's avatar
/// publication on / off / mirror_user inside one space without changing the agent's own default
/// (videoControl on v1:agents:agent). Mirrors v1:cognition:audioOverride exactly -- same fields,
/// same id pattern, same write/read paths -- but governs lip-synced video instead of TTS audio.
/// Read by the voice-agent process at session start (Phase 9): an active override beats the agent
/// default; absence falls through to the agent default. id is the deterministic
/// videoOverride:<partitionId>:<agentId> so re-toggling on the same orb hits the same row instead
/// of growing a per-click history.
@displayCard(primary="mode", secondary="agentId", tertiary="setBy", status="active")
concept videoOverride {
  partitionId   string! @description("v1:cognition:space.id this override is scoped to.")
  agentId   string! @description("v1:agents:agent.id this override targets.")
  setBy     string  @description("v1:identity:user.id of the actor who flipped the override -- the space owner under v1 permission rules. Audited against v1:identity:auditEvent.")
  mode      enum("always_on", "always_off", "mirror_user")! @description("Effective publication state. The voice-agent's avatar-gating path treats this exactly the same as the agent default once selected: always_on publishes unconditionally; always_off suppresses video while letting audio + chat continue; mirror_user honours the user's current video state at session start.")
  active    bool  @default("true") @description("Soft-revoke flag. Setting active=false collapses back to the agent default without losing the row's history.")

  @relationship(type="interactsWith", field="agentId", target=agent, direction="outgoing")
}

// videoOverride concept above. The product-specific cognition concepts
// (space:context, micState, privateUtterance, misrouteFeedback,
// greetSuppression) were extracted to the product pack
// (the carrier repo's pack concepts file) by Epic 3
// (3.3b-i, memql#1991). Ids are preserved (v1:cognition:*) -- the
// pack keeps @namespace("cognition") on the moved concepts; only the
// file location changed.

/// Rolled-up guardrail health metrics for a time window. Written by the rollupGuardrailHealth
/// automation from v1:cognition:unmetCapability rows; advisory-only signal for tuning the fit-score
/// threshold and identifying missing specialist domains. One row per rollup run.
@displayCard(primary="periodStart", secondary="periodEnd", tertiary="totalUnmet")
concept guardrailHealth {
  periodStart             datetime!  @description("Start of the rollup window (inclusive).")
  periodEnd               datetime!  @description("End of the rollup window (exclusive).")
  generatedAt             datetime!  @description("When this rollup was produced.")

  totalUnmet              int!  @default("0")  @description("Total v1:cognition:unmetCapability rows in the window.")
  specialistGapCount      int!  @default("0")  @description("Rows with severity=specialist_gap -- assistant absorbed the turn.")
  fullGapCount            int!  @default("0")  @description("Rows with severity=full_gap -- no agent could help.")

  belowThresholdCount     int  @description("Zero when untriggered (an absent value reads as 0; no mutation is bound to this concept, so a Go rollup writer supplies it). Triggered by the fit-score gate.")
  handoffChainCapCount    int  @description("Zero when untriggered (an absent value reads as 0; no mutation is bound to this concept, so a Go rollup writer supplies it). Triggered by the handoff-chain cap.")
  noFitNoFallbackCount    int  @description("Zero when untriggered (an absent value reads as 0; no mutation is bound to this concept, so a Go rollup writer supplies it). Triggered when no fallback agent was available (silent).")
  routerEscalatedCount    int  @description("Zero when untriggered (an absent value reads as 0; no mutation is bound to this concept, so a Go rollup writer supplies it). Triggered when the router itself requested escalation_notice.")
  routerFallbackCount     int  @description("Zero when untriggered (an absent value reads as 0; no mutation is bound to this concept, so a Go rollup writer supplies it). Triggered when the router itself requested fallback_attempt.")

  avgFitScore             float  @description("Mean topFitScore across the window (null when totalUnmet==0).")
  currentThreshold        float  @description("Fit-score threshold in effect at rollup time.")
  suggestedThreshold      float  @description("Advisory threshold suggestion based on observed fit-score distribution. Consumer decides whether to apply.")

  topMissingDomains       string  @description("JSON array of { domain, count } entries ranked by frequency -- clusters of utterances that nobody in the relevant spaces could handle. Product signal for which specialist agents to add next.")
  topSpaces               string  @description("JSON array of { partitionId, count } entries -- spaces with the highest unmet rate.")
  notes                   string  @description("Free-form notes from the rollup (e.g. 'handoff_chain_cap triggered 8x, review routing prompt').")
}

/// A single instance of the cognition router determining that no agent in a space could meet the
/// user's request -- either the assistant stepped in as fallback (specialist_gap) or nobody could
/// help (full_gap). Emitted by cognition via the cognition.capability.unmet event and consumed by
/// the guardrail health rollup for product-level insight into missing capabilities.
@displayCard(primary="utterance", secondary="speakerName", tertiary="reason", status="severity")
concept unmetCapability {
  partitionId          string!  @description("ID of the space the utterance occurred in.")
  utteranceId      string   @description("ID of the triggering human utterance.")
  utterance        string   @description("Text of the user's request that no agent could meet.")
  speakerName      string   @description("Display name of the human who spoke.")

  severity         enum("specialist_gap", "full_gap")!  @description("specialist_gap: assistant absorbed the turn as fallback (we lacked a specialist). full_gap: even the assistant could not help / no assistant in the room.")
  turnMode         enum("answer", "fallback_attempt", "escalation_notice")  @description("Turn mode the router chose. answer = specialist stretch absorbed it; fallback_attempt = assistant stretched on a knowledge gap; escalation_notice = assistant refused and flagged.")
  trigger          enum("below_threshold", "handoff_chain_cap", "no_fit_no_fallback", "router_escalated", "router_fallback")!  @description("Why the unmet event fired: threshold gate, chain cap, missing assistant, or router-initiated.")

  topFitScore      float   @description("Router's fit score for the chosen agent (0..1). Low scores indicate nobody was a strong match.")
  routedAgentId    string  @description("ID of the agent the router ultimately routed to (may be empty when no agent was selected).")
  routedAgentName  string  @description("Display name of the routed agent.")

  rosterSnapshot   string  @description("JSON-serialized snapshot of the space's agent roster at decision time (id/name/role/domains/keywords). Used by the rollup to cluster missing domains.")
  reason           string  @description("Router's short explanation of why no agent fit.")

}
