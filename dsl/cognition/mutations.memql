  }
}

// ---- mutations/v1/cognition/restoreSpace.memql ----

// restoreSpace
// ============
//
// Inserts a new version of a space record, typically used to move
// a saved or archived space back to the "active" working state.
// The caller passes the full updated payload (status="active",
// active=true, archivedAt: null, savedAt: null).
//
// Same generic-upsert shape as the other space-lifecycle mutations
// (archiveSpace / saveSpace / deleteSpaceNow). The frontend's
// copresentMutations.ts wrappers compose the per-state payload.

@enabled
@description("Insert a new version of a space record to restore it to the active state.")
mutation space mutationRestoreSpace {
  args {
    spaceId  string  @required
    payload  object  @required
  }
  insert space {
    id: args.spaceId
    args.payload
  }
}

// ---- mutations/v1/cognition/saveSpace.memql ----

// saveSpace
// =========
//
// Inserts a new version of a space record, typically used to mark
// the space as "saved" -- a manually preserved state that NEVER auto-
// deletes regardless of the user's archive retention setting.
//
// The caller is responsible for passing the full updated payload
// (e.g., status="saved", active=true, savedAt=timestamp(),
// archivedAt: null to clear any prior archive timestamp).
//
// Pattern matches mutationArchiveSpace / mutationRestoreSpace /
// mutationDeleteSpaceNow -- they're all generic full-payload upserts;
// the frontend (copresentMutations.ts wrappers) owns the per-state
// payload composition.

@enabled
@description("Insert a new version of a space record with the 'saved' status payload.")
mutation space mutationSaveSpace {
  args {
    spaceId  string  @required
    payload  object  @required
  }
  insert space {
    id: args.spaceId
    args.payload
  }
}

// ---- mutations/v1/cognition/sendActionUtterance.memql ----

// sendActionUtterance
// ==================
//
// Inserts a new structured "action" utterance into a space conversation.
// Use this for structured UI submits (lead creation, etc.) without stuffing JSON into text.
//
// Notes:
// - payload.utteranceType is set to "action"
// - payload.text is intentionally omitted
// - createdAt can be provided (RFC3339) or defaults to now
// - If action.idempotencyKey is provided, a deterministic utterance ID is derived for safe retries

@enabled
@description("Create an action utterance in a space.")
mutation utterance mutationSendActionUtterance {
  args {
    utteranceId      string
    spaceId          string  @required
    participantId    string  @required
    participantType  string
    replyToId        string
    source           object
    createdAt        string
    action           object  @required
  }
  insert utterance {
    id: coalesce(
      args.utteranceId,
      cond(
        args.action.idempotencyKey,
        concat("utt-", hash(concat(
          canonicalId(args.spaceId, "v1:cognition:space"), ":",
          canonicalId(args.participantId, "v1:cognition:participant"), ":",
          args.action.type, ":", args.action.idempotencyKey
        ))),
        concat("utt-", hash(concat(
          canonicalId(args.spaceId, "v1:cognition:space"), ":",
          canonicalId(args.participantId, "v1:cognition:participant"), ":",
          coalesce(args.createdAt, timestamp()), ":", args.action.type
        )))
      )
    )
    args.spaceId
    args.participantId
    participantType: coalesce(args.participantType, "human")
    utteranceType: "action"
    args.replyToId
    args.source
    action: {
        type: args.action.type,
        payload: args.action.payload,
        schemaVersion: coalesce(args.action.schemaVersion, 1),
        idempotencyKey: args.action.idempotencyKey
      }
  }
}

// ---- mutations/v1/cognition/sendRealtimeTranscriptUtterance.memql ----

// sendRealtimeTranscriptUtterance
// ==============================
//
// Inserts a transcript-only realtime voice utterance into a space conversation.
// This write path is intended for realtime transcript persistence and supports
// deterministic IDs when idempotencyKey is provided.

@enabled
@description("Create a transcript-only realtime voice utterance in a space.")
mutation utterance mutationSendRealtimeTranscriptUtterance {
  args {
    utteranceId      string
    idempotencyKey   string
    createdAt        string
    spaceId          string  @required
    participantId    string  @required
    participantType  string  @enum("human", "si", "system")
    text             string
    audioId          string
    videoId          string
    duration         number
    timestamps       object
    source           object
  }
  insert utterance {
    id: coalesce(
      args.utteranceId,
      cond(
        args.idempotencyKey,
        concat("utt-", hash(concat(
          canonicalId(args.spaceId, "v1:cognition:space"), ":",
          canonicalId(args.participantId, "v1:cognition:participant"), ":",
          args.idempotencyKey
        ))),
        concat("utt-", hash(concat(
          canonicalId(args.spaceId, "v1:cognition:space"), ":",
          canonicalId(args.participantId, "v1:cognition:participant"), ":",
          timestamp(), ":", coalesce(args.text, "")
        )))
      )
    )
    args.spaceId
    args.participantId
    participantType: coalesce(args.participantType, "human")
    utteranceType: "speech"
    args.text
    args.audioId
    args.videoId
    args.duration
    args.timestamps
    source: {
        inputMethod: coalesce(args.source.inputMethod, "realtimeVoice"),
        outputMethod: coalesce(args.source.outputMethod, "realtimeVoice"),
        pipeline: coalesce(args.source.pipeline, "polyphon"),
        sttProvider: args.source.sttProvider,
        ttsProvider: args.source.ttsProvider,
        avatarProvider: args.source.avatarProvider,
        transcriptOnly: "true",
        args.idempotencyKey
      }
  }
}

