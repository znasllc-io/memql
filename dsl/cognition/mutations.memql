// ---- mutations/v1/cognition/touchSession.memql ----

// touchSession
// ============
//
// Inserts a new version of a v1:identity:authSession record with the
// provided payload. Typically used to bump lastActivityAt (append-only
// heartbeat). Bound to authSession -- NOT v1:cognition:session, which
// requires participantId/spaceId that an auth session never carries
// (memql#1639).

@enabled
@description("Update an auth-session record (typically a heartbeat to bump lastActivityAt). Read-merges the existing row (update()): only the fields in `payload` change; the @required discriminators (subject, tokenHash, source, expiresAt) and every other omitted field inherit from the persisted row instead of having to be re-supplied (memql#1628). The session row must already exist.")
mutation authSession mutationTouchSession {
  args {
    sessionId  string  @required
    payload    object  @required
  }
  update {
    id: args.sessionId
    args.payload
  }
}

// ---- mutations/v1/cognition/updateParticipantPresence.memql ----

// updateParticipantPresence
// =========================
//
// Upserts participant presence snapshots for UI status overlays.
// This is append-only versioning with deterministic IDs for latest-wins reads.

@enabled
@description("Upsert a participant presence snapshot for multi-client status consistency.")
mutation presence mutationUpdateParticipantPresence {
  args {
    presenceId       string
    participantId    string  @required
    spaceId          string  @required
    state            string  @required  @enum("idle", "listening", "thinking", "typing", "responding", "working", "waiting", "needs_human", "needs_clarification", "paused", "error", "using_tool", "researching", "investigating")
    label            string  @required
    reason           string
    sinceAt          string
    lastUpdatedAt    string
    lastUtteranceId  string
    lastError        string
    intent           object
  }
  insert {
    // participantId is a canonical colon id (v1:cognition:participant:...);
    // a bare concat would yield "presence-v1:cognition:..." whose colons are
    // rejected as an invalid shortId. hash() encodes it to a colon-free,
    // deterministic digest so latest-wins reads still collapse on the same
    // (participant) pair (memql#1640). The explicit-presenceId workaround
    // still wins via coalesce.
    id: coalesce(
      args.presenceId,
      concat("presence-", hash(args.participantId))
    )
    args.spaceId
    args.participantId
    args.state
    args.label
    args.reason
    sinceAt: coalesce(args.sinceAt, timestamp())
    lastUpdatedAt: coalesce(args.lastUpdatedAt, timestamp())
    args.lastUtteranceId
    args.lastError
    args.intent
  }
}

// ---- mutations/v1/cognition/updateParticipantStatus.memql ----

// updateParticipantStatus
// =======================
//
// Inserts a new version of a participant record with the provided payload.
// The caller is responsible for passing the full updated payload.

@enabled
@description("Update a participant record (typically status). Read-merges the existing row (update()): only the fields in `payload` change; every omitted field inherits from the persisted row instead of being wiped (memql#1628 class). The participant row must already exist (created on join).")
mutation participant mutationUpdateParticipantStatus {
  args {
    participantId  string  @required
    payload        object  @required
  }
  update {
    id: args.participantId
    args.payload
  }
}

