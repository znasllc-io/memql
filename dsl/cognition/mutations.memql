// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use cognition.concepts.{ audioOverride, chunk, request, response, participant, presence, session, space, utterance, videoOverride }
use agents.concepts.{ agent }
use identity.concepts.{ user, authSession }

@enabled
@description("Add the caller's agent to a space's roster. forUserId is server-stamped; per-user-per-space 3-cap and agent-ownership are enforced by the engine guard.")
mutation participant mutationAddAgentToSpace {
  args {
    spaceId              string  @required
    agentId              string  @required
    displayName          string  @required
    capabilityOverrides  object
  }
  insert {
    id: concat("si-", hash(concat(
      canonicalId(args.agentId, agent), ":",
      canonicalId(args.spaceId, space)
    )))
    args.spaceId
    args.agentId
    participantType: "si"
    args.displayName
    status: "active"
    joinedAt: timestamp()
    args.capabilityOverrides
    hidden: false
    isGroupGA: false
  }
}

// ---- mutations/v1/cognition/archiveSpace.memql ----

// archiveSpace
// ============
//
// Inserts a new version of a space record with the provided payload.
// The caller is responsible for passing the full updated payload (e.g., active=false, status="archived").

@enabled
@description("Insert a new version of a space record (typically used to archive a space). Server-side stamps ownerUserId from actor.userId so callers don't need to thread it through the payload -- per-row authz already gates that only the owner reaches this mutation, and at create time ownerUserId == actor.userId. Also stamps archivedAt (now) when the caller's payload omits it, so queryArchivedSpaces (which gates on status=='archived', not archivedAt presence) and the retention cron see a complete archived row even from minimal-payload callers. memql#401 / #1637.")
mutation space mutationArchiveSpace {
  args {
    spaceId  string  @required
    payload  object  @required
  }
  insert {
    id: args.spaceId
    ownerUserId: actor.userId
    args.payload
    archivedAt: coalesce(args.payload.archivedAt, timestamp())
  }
}

// ---- mutations/v1/cognition/createDailySpace.memql ----

// createDailySpace
// =================
//
// Creates the per-user, per-day daily space. Same shape as
// mutationCreateSpace but with the daily-specific fields baked in
// (kind="daily", private=true) so the caller doesn't have to know
// the convention.
//
// IDEMPOTENCY:
// The space id is content-addressable as `daily-{userShortId}-{dateKey}`,
// computed by the caller. Calling this mutation twice for the same
// (user, dateKey) inserts a second version of the same row -- the
// node id collides, so it's effectively a no-op upsert.
//
// LIFECYCLE OWNER -- server-driven (rewritten 2026-05-18):
// The dailyspace integration (integrations/dailyspace/) owns
// provisioning + rollover. Three automations call its
// ensureDailySpaceForUser capability:
//
//   provisionDailySpaceOnUserCreate -- fires on every new
//     v1:identity:user row. New users get their daily before they
//     ever look for it.
//
//   ensureDailySpaceOnAuthSession -- fires on every login
//     (v1:identity:authSession create). Returning users after a
//     day's gap have today's daily ready by the time the SPA
//     queries their space list.
//
//   rolloverDailySpace -- hourly cron. Safety net for users who
//     stay logged in across midnight (no authSession fires for
//     them). Walks every active user with preferences.dailySpaceEnabled
//     != false; idempotent per user.
//
// The Go capability owns the IANA-timezone date math
// (integration.timeutil.dateKeyInTimezone) and reads
// preferences.dailySpaceEnabled / timezone off the user row before
// dispatching this mutation.
//
// SPA INTEGRATION:
// The legacy useDailySpace hook on the SPA is now a read-only lens:
// today's daily is always present server-side, so the hook just
// reads it. Calling this mutation from the client is permitted
// (the idempotent insert collapses) but redundant.
//
// PHASE 10 (chat architecture):
// The hard maxHumans=1 / maxAgents=1 override that locked daily
// spaces to "1 human + 1 agent" was deleted. Daily spaces now use
// the v1:cognition:space concept's defaults (maxHumans=5, maxAgents=3
// per the per-user-per-space cap), so the user can invite collaborators
// and add specialists from their roster. Auto-provisioning at this
// mutation level still seeds nothing -- the autoJoinAI automation on
// space-created handles the owner assistant, same path the regular
// space flow uses.

@enabled
@description("Create a daily space (kind=daily, private=true). Idempotent on (userHash, dateKey). Phase 10: no maxHumans=1/maxAgents=1 lock; the user can grow a daily space into a full team conversation if they want.")
mutation space mutationCreateDailySpace {
  args {
    spaceId       string  @required
    name          string  @required
    dailyDateKey  string  @required
    ownerUserId   string  @required
  }
  insert {
    id: args.spaceId
    args.ownerUserId
    args.name
    args.dailyDateKey
    kind: "daily"
    private: true
    status: "active"
    active: true
  }
}

// ---- mutations/v1/cognition/createGreetingUtterance.memql ----

// mutationCreateGreetingUtterance - Create AI Greeting Utterance
// ===============================================================
//
// Creates a greeting utterance when an AI participant joins a space.
// Uses a deterministic ID to prevent duplicate greetings.
//
// Arguments:
//   spaceId (string, required)       - Space ID
//   participantId (string, required) - AI participant ID
//   agentId (string, required)       - Agent template ID
//   text (string, required)          - Greeting text
//   greetingKind (string, required)  - "agentGreeting"
//
// Returns: Inserted utterance node
//
// Usage:
//   mutationCreateGreetingUtterance({
//     spaceId: "space-123",
//     participantId: "ai-sofia-space-123",
//     agentId: "sofia",
//     text: "Hi everyone!",
//     greetingKind: "agentGreeting"
//   })
//
// Note: the AI display name is NOT written onto the utterance row --
// `displayName` is not a field on v1:cognition:utterance (the concept
// enforces additionalProperties:false), so writing it rejected the
// insert and the join greeting never landed (memql#419). The name is
// already carried by the participant referenced via participantId;
// consumers derive it from there, exactly as every other utterance
// insert does.
//

@enabled
@description("Create a greeting utterance for an AI participant joining a space")
mutation utterance mutationCreateGreetingUtterance {
  args {
    spaceId        string  @required
    participantId  string  @required
    agentId        string  @required
    text           string  @required
    greetingKind   string  @required
  }
  insert {
    args.spaceId
    args.participantId
    participantType: "si"
    utteranceType: "text"
    args.text
    source: {
        kind: args.greetingKind,
        args.agentId
      }
  }
}

// ---- mutations/v1/cognition/createSessionForParticipant.memql ----

// createSessionForParticipant
// ==========================
//
// Creates (or re-creates) a v1:cognition:session record for a participant in a space.

@enabled
@description("Create a session record for a participant in a space.")
mutation session mutationCreateSessionForParticipant {
  args {
    sessionId      string
    spaceId        string  @required
    participantId  string  @required
    humanInput     object
    aiOutput       object
    streams        object
  }
  insert {
    id: args.sessionId
    args.spaceId
    args.participantId
    args.humanInput
    args.aiOutput
    args.streams
    startedAt: timestamp()
    lastActivityAt: timestamp()
  }
}

// ---- mutations/v1/cognition/createSpace.memql ----

// createSpace
// ===========
//
// Creates a new v1:cognition:space record. Every space is a
// multi-participant room with slot capacity for humans and agents;
// there is no longer a 1:1 vs group distinction. `maxHumans` /
// `maxAgents` default to 5 / 3 when the caller omits them.

@enabled
@description("Create a space.")
mutation space mutationCreateSpace {
  args {
    spaceId           string
    name              string  @required
    description       string
    goal              object
    settings          object
    status            string
    spaceType         string
    scheduledAt       string
    turnStateId       string
    participantIds    array
    utteranceIds      array
    active            bool
    maxHumans         int
    maxAgents         int
  }
  insert {
    id: args.spaceId
    ownerUserId: actor.userId
    args.name
    args.description
    args.goal
    args.settings
    status: coalesce(args.status, "active")
    args.spaceType
    args.scheduledAt
    args.turnStateId
    args.participantIds
    args.utteranceIds
    active: coalesce(args.active, true)
    maxHumans: coalesce(args.maxHumans, 5)
    maxAgents: coalesce(args.maxAgents, 1)
  }
}

// ---- mutations/v1/cognition/setSpaceGoal.memql ----

// setSpaceGoal
// ============
//
// Partial update that sets (or replaces) a space's structured goal
// after creation. Uses update() (read-merge-validate-write) so the
// caller doesn't have to re-pass the full space payload -- only the
// goal block changes, everything else inherits from the prior row.
//
// `goal` is the structured object {statement, timeframe}; timeframe is
// one of daily / weekly / monthly and is purely descriptive grounding
// for cognition (NOT tied to space.kind=daily or status=scheduled).
// Server-side stamps ownerUserId from actor.userId so the update stays
// owned-classified for per-row authz.

@enabled
@description("Set or replace a space's structured goal {statement, timeframe} after creation. Partial update via update() -- only the goal changes; everything else inherits from the prior row.")
mutation space mutationSetSpaceGoal {
  args {
    spaceId  string  @required
    goal     object  @required
  }
  update {
    id: args.spaceId
    ownerUserId: actor.userId
    args.goal
  }
}

// ---- mutations/v1/cognition/deleteSpaceNow.memql ----

// deleteSpaceNow
// ==============
//
// Inserts a new version of a space record marking it as hard-deleted
// (`active=false`, `deleted=true`, `status="archived"`). Used by the
// "Delete now" override in the Archived tab + by the cron purge sweep
// (purgeExpiredArchivedSpaces) when an archived space hits its
// retention deadline.
//
// memQL is append-only -- the historical rows still exist in the
// time-series table; downstream queries filter on traitIsNotDeleted
// so the row disappears from every list.
//
// Same generic-upsert shape as the other space-lifecycle mutations.
// The frontend's copresentMutations.ts wrapper composes the payload
// (typically: keep name + ids, set deleted=true / active=false /
// status="archived").

@enabled
@description("Insert a new version of a space record marking it as hard-deleted (deleted=true). Server-side stamps ownerUserId from actor.userId so callers don't need to thread it through the payload (memql#401).")
mutation space mutationDeleteSpaceNow {
  args {
    spaceId  string  @required
    payload  object  @required
  }
  insert {
    id: args.spaceId
    ownerUserId: actor.userId
    args.payload
  }
}

// ---- mutations/v1/cognition/emitClientToolRequest.memql ----

// emitClientToolRequest
// =====================
//
// Inserts a v1:cognition:client:tool:request record. Called by the
// cognition client-tool relay when an agent node emits a ClientToolCall
// that needs to reach a browser on BFF. Browsers subscribe to these
// events scoped by spaceId/participantId, dispatch via their local
// tool bridge, and answer by inserting a
// v1:cognition:client:tool:response with the same callId.

@enabled
@description("Emit a client-tool request envelope for cross-node relay to a browser stream.")
mutation request mutationEmitClientToolRequest {
  args {
    requestId      string  @required
    callId         string  @required
    toolName       string  @required
    argumentsJSON  string
    spaceId        string
    participantId  string
    agentId        string
    expiresAt      string
  }
  insert {
    id: args.requestId
    args.callId
    args.toolName
    args.argumentsJSON
    args.spaceId
    args.participantId
    args.agentId
    args.expiresAt
  }
}

// ---- mutations/v1/cognition/emitClientToolResponse.memql ----

// emitClientToolResponse
// ======================
//
// Inserts a v1:cognition:client:tool:response record. Called by the
// browser (from its client-tool relay bridge) after dispatching a tool
// from a matching v1:cognition:client:tool:request. Cognition subscribes
// to these events, matches on callId, wraps the payload in a
// ClientToolResult MemqlClientMessage and forwards it to the agent
// node via AiForwardRequest so the parked tool-loop waiter unblocks.

@enabled
@description("Emit a client-tool response envelope fulfilling a pending clientToolRequest.")
mutation response mutationEmitClientToolResponse {
  args {
    responseId    string  @required
    callId        string  @required
    contentJSON   string
    isError       bool
    errorMessage  string
    spaceId       string
  }
  insert {
    id: args.responseId
    args.callId
    args.contentJSON
    isError: coalesce(args.isError, false)
    args.errorMessage
    args.spaceId
  }
}

// ---- mutations/v1/cognition/emitTextChunk.memql ----

// emitTextChunk
// ==============
//
// Creates a v1:cognition:text:chunk node in the graph. The engine automatically
// emits a graph.node.created.v1:cognition:text:chunk event, which the frontend
// subscribes to for real-time streaming text display.

@enabled
@description("Emit a streaming text chunk during AI response generation.")
mutation chunk mutationEmitTextChunk {
  args {
    chunkId        string   @required
    spaceId        string   @required
    participantId  string   @required
    replyId        string   @required
    text           string   @required
    index          number   @required
    done           boolean  @required
  }
  insert {
    id: concat("text-chunk-", args.chunkId)
    args.spaceId
    args.participantId
    args.replyId
    args.text
    args.index
    args.done
  }
}

// ---- mutations/v1/cognition/joinSpaceAsHuman.memql ----

// joinSpaceAsHuman
// ===============
//
// Creates (or re-creates) a human participant record for a space.
//
// IDEMPOTENCY:
// The participant id is content-addressed on (canonical spaceId,
// canonical userId). Both args go through canonicalId() before
// hashing, so the id is invariant whether the caller passes a bare
// slug ("user-abc") or an already-canonical id
// ("_system:v1:identity:user:user-abc"). Repeat joins land on the
// SAME participant id; memQL stores them as time-series versions of
// one logical row, and the latest-version dedup at query time keeps
// the UI from rendering doubles.
//
// The payload's spaceId and userId also get canonicalized at insert
// time by the engine's @relationship auto-canon (see
// MemQLEngine.canonicalizeRelationshipFields), so `payload.userId
// == arg(...)` queries match consistently regardless of input
// shape. The explicit canonicalId() calls below are still required
// for the id derivation -- the id is computed BEFORE the payload is
// canonicalized, so the engine's auto-canon doesn't see it.

@enabled
@description("Join a space as a human participant.")
mutation participant mutationJoinSpaceAsHuman {
  args {
    spaceId              string  @required
    userId               string  @required
    displayName          string  @required
    status               string
    joinedAt             string
    capabilityOverrides  object
  }
  insert {
    // Idempotent: content-addressed on (space, user) so repeat joins
    // land on the same participant id. The caller does not supply the
    // id (memql#213 dropped the ignored participantId arg).
    id: concat("participant-", hash(concat(
      canonicalId(args.spaceId, space), ":",
      canonicalId(args.userId, user)
    )))
    args.spaceId
    args.userId
    participantType: "human"
    args.displayName
    status: coalesce(args.status, "active")
    joinedAt: coalesce(args.joinedAt, timestamp())
    args.capabilityOverrides
  }
}

// ---- mutations/v1/cognition/joinSpaceAsAI.memql ----

// joinSpaceAsAI
// ============
//
// Creates (or re-creates) an AI participant record for a space.
//
// IDEMPOTENCY:
// The id is content-addressed on (canonical agentId, canonical
// spaceId) -- both args go through canonicalId() before being
// concatenated. The id is invariant whether the caller passes bare
// slugs or already-canonical ids; repeat joins land on the SAME
// participant id (memQL versions, no duplicate rows).
//
// Without canonicalId(), an automation passing bare slugs and a
// browser passing canonical ids would derive different participant
// ids and produce two visible rows for the same logical
// (space, agent) pair.
//
// The id pattern stays human-readable -- "si-{canonicalAgentId}-
// {canonicalSpaceId}" -- so the legacy autoJoinAI automation that
// computes the same string can keep using checkExistingGA's lookup
// without re-encoding via hash().

@enabled
@description("Join a space as an AI participant. Uses canonicalized deterministic ID.")
mutation participant mutationJoinSpaceAsAI {
  args {
    spaceId              string  @required
    agentId              string  @required
    displayName          string  @required
    status               string
    joinedAt             string
    capabilityOverrides  object
    hidden               bool
    forUserId            string
    isGroupGA            bool
  }
  insert {
    // Idempotent: content-addressed on (agent, space), matching the
    // other AI-join mutations. The caller does not supply the id
    // (memql#213 dropped the ignored participantId arg).
    id: concat("si-", hash(concat(
      canonicalId(args.agentId, agent), ":",
      canonicalId(args.spaceId, space)
    )))
    args.spaceId
    args.agentId
    participantType: "si"
    args.displayName
    status: coalesce(args.status, "active")
    joinedAt: coalesce(args.joinedAt, timestamp())
    args.capabilityOverrides
    hidden: coalesce(args.hidden, false)
    args.forUserId
    args.isGroupGA
  }
}

// ---- mutations/v1/cognition/leaveSpace.memql ----

// leaveSpace
// ==========
//
// Inserts a new version of a participant record with the provided payload.
// The caller is responsible for passing the full updated payload (e.g., status="left", leftAt=timestamp()).

@enabled
@description("Insert a new version of a participant record (typically used to mark the participant as left).")
mutation participant mutationLeaveSpace {
  args {
    participantId  string  @required
    payload        object  @required
  }
  insert {
    id: args.participantId
    args.payload
  }
}

// ---- mutations/v1/cognition/removeAgentFromSpace.memql ----

// removeAgentFromSpace
// ====================
//
// Removes the caller's agent from a space's roster by inserting a new
// participant version with status='left'. The canonical entry point
// for the per-row remove affordance in the Roster tab (Phase 3 of the
// chat architecture plan).
//
// Phase 1.4 of the chat architecture plan. Append-only -- a removal
// is a new version of the same participant id with status='left'.
// The engine pre-insert participant guard enforces:
//
//   1. The agent's forUserId on the row being superseded must match
//      the authenticated caller (or caller is elevated). A user
//      cannot remove another user's agent.
//   2. Owner's GA pin is honored: status='left' inserts on rows whose
//      isGroupGA=true are rejected for non-elevated callers. The GA
//      can only be removed via system actor or cluster-owner paths
//      (e.g., space-deletion), not by the user clicking remove in
//      the roster.

@enabled
@description("Remove the caller's agent from a space (status='left'). The engine guard enforces caller-owns-agent and rejects removal of the pinned owner GA.")
mutation participant mutationRemoveAgentFromSpace {
  args {
    spaceId  string  @required
    agentId  string  @required
  }
  update {
    id: concat("si-", hash(concat(
      canonicalId(args.agentId, agent), ":",
      canonicalId(args.spaceId, space)
    )))
    status: "left"
    leftAt: timestamp()
  }
}

// ---- mutations/v1/cognition/renameSpace.memql ----

// renameSpace
// ===========
//
// Partial-update (read-merge-write) of a space record. The caller passes
// only the fields it wants to change (typically payload={name}); `update`
// merges them onto the existing row so goal / maxAgents / maxHumans /
// status / active are preserved. Using `insert` here was a full-record-
// replacement footgun -- a partial payload wiped every unstated field to
// null (memql#1637). Mirrors the planner partial-update mutations
// (mutationStartPlan, mutationCompleteToolInvocation) and the guide /
// calendar / identity `update { id, args.payload }` pattern.

@enabled
@description("Partial-update a space record (read-merge-write; typically used to rename a space). Only the fields in the caller's payload change; all other fields are preserved. Server-side stamps ownerUserId from actor.userId (memql#401 / #1637).")
mutation space mutationRenameSpace {
  args {
    spaceId  string  @required
    payload  object  @required
  }
  update {
    id: args.spaceId
    ownerUserId: actor.userId
    args.payload
  }
}

// ---- mutations/v1/cognition/restoreSpace.memql ----

// restoreSpace
// ============
//
// Inserts a new version of a space record, typically used to move
// a saved or archived space back to the "active" working state.
// The caller passes the full updated payload (status="active",
// active=true, archivedAt: null, savedAt: null).
//
// Same generic-upsert shape as the other space-lifecycle mutations
// (archiveSpace / saveSpace / deleteSpaceNow). The frontend's
// copresentMutations.ts wrappers compose the per-state payload.

@enabled
@description("Insert a new version of a space record to restore it to the active state. Server-side stamps ownerUserId from actor.userId so callers don't need to thread it through the payload (memql#401).")
mutation space mutationRestoreSpace {
  args {
    spaceId  string  @required
    payload  object  @required
  }
  insert {
    id: args.spaceId
    ownerUserId: actor.userId
    args.payload
  }
}

// ---- mutations/v1/cognition/saveSpace.memql ----

// saveSpace
// =========
//
// Inserts a new version of a space record, typically used to mark
// the space as "saved" -- a manually preserved state that NEVER auto-
// deletes regardless of the user's archive retention setting.
//
// The caller is responsible for passing the full updated payload
// (e.g., status="saved", active=true, savedAt=timestamp(),
// archivedAt: null to clear any prior archive timestamp).
//
// Pattern matches mutationArchiveSpace / mutationRestoreSpace /
// mutationDeleteSpaceNow -- they're all generic full-payload upserts;
// the frontend (copresentMutations.ts wrappers) owns the per-state
// payload composition.

@enabled
@description("Insert a new version of a space record with the 'saved' status payload. Server-side stamps ownerUserId from actor.userId so callers don't need to thread it through the payload (memql#401).")
mutation space mutationSaveSpace {
  args {
    spaceId  string  @required
    payload  object  @required
  }
  insert {
    id: args.spaceId
    ownerUserId: actor.userId
    args.payload
  }
}

// ---- mutations/v1/cognition/sendActionUtterance.memql ----

// sendActionUtterance
// ==================
//
// Inserts a new structured "action" utterance into a space conversation.
// Use this for structured UI submits (lead creation, etc.) without stuffing JSON into text.
//
// Notes:
// - payload.utteranceType is set to "action"
// - payload.text is intentionally omitted
// - createdAt can be provided (RFC3339) or defaults to now
// - If action.idempotencyKey is provided, a deterministic utterance ID is derived for safe retries

@enabled
@description("Create an action utterance in a space.")
mutation utterance mutationSendActionUtterance {
  args {
    utteranceId      string
    spaceId          string  @required
    participantId    string  @required
    participantType  string
    replyToId        string
    source           object
    createdAt        string
    action           object  @required
  }
  insert {
    id: coalesce(
      args.utteranceId,
      cond(
        args.action.idempotencyKey,
        concat("utt-", hash(concat(
          canonicalId(args.spaceId, space), ":",
          canonicalId(args.participantId, participant), ":",
          args.action.type, ":", args.action.idempotencyKey
        ))),
        concat("utt-", hash(concat(
          canonicalId(args.spaceId, space), ":",
          canonicalId(args.participantId, participant), ":",
          coalesce(args.createdAt, timestamp()), ":", args.action.type
        )))
      )
    )
    args.spaceId
    args.participantId
    participantType: coalesce(args.participantType, "human")
    utteranceType: "action"
    args.replyToId
    args.source
    action: {
        type: args.action.type,
        payload: args.action.payload,
        schemaVersion: coalesce(args.action.schemaVersion, 1),
        idempotencyKey: args.action.idempotencyKey
      }
  }
}

// ---- mutations/v1/cognition/sendRealtimeTranscriptUtterance.memql ----

// sendRealtimeTranscriptUtterance
// ==============================
//
// Inserts a transcript-only realtime voice utterance into a space conversation.
// This write path is intended for realtime transcript persistence and supports
// deterministic IDs when idempotencyKey is provided.

@enabled
@description("Create a transcript-only realtime voice utterance in a space.")
mutation utterance mutationSendRealtimeTranscriptUtterance {
  args {
    utteranceId      string
    idempotencyKey   string
    createdAt        string
    spaceId          string  @required
    participantId    string  @required
    participantType  string  @enum("human", "si", "system")
    text             string
    audioId          string
    videoId          string
    duration         number
    timestamps       object
    source           object
  }
  insert {
    id: coalesce(
      args.utteranceId,
      cond(
        args.idempotencyKey,
        concat("utt-", hash(concat(
          canonicalId(args.spaceId, space), ":",
          canonicalId(args.participantId, participant), ":",
          args.idempotencyKey
        ))),
        concat("utt-", hash(concat(
          canonicalId(args.spaceId, space), ":",
          canonicalId(args.participantId, participant), ":",
          timestamp(), ":", coalesce(args.text, "")
        )))
      )
    )
    createdAt: coalesce(args.createdAt, timestamp())
    args.spaceId
    args.participantId
    participantType: coalesce(args.participantType, "human")
    utteranceType: "speech"
    args.text
    args.audioId
    args.videoId
    args.duration
    args.timestamps
    source: {
        inputMethod: coalesce(args.source.inputMethod, "realtimeVoice"),
        outputMethod: coalesce(args.source.outputMethod, "realtimeVoice"),
        pipeline: coalesce(args.source.pipeline, "polyphon"),
        sttProvider: args.source.sttProvider,
        ttsProvider: args.source.ttsProvider,
        avatarProvider: args.source.avatarProvider,
        transcriptOnly: "true",
        args.idempotencyKey
      }
  }
}

// ---- mutations/v1/cognition/sendSpeechUtterance.memql ----

// sendSpeechUtterance
// ===================
//
// Inserts a new speech utterance into a space conversation.

@enabled
@description("Create a speech utterance in a space.")
mutation utterance mutationSendSpeechUtterance {
  args {
    utteranceId      string
    spaceId          string  @required
    participantId    string  @required
    participantType  string
    text             string
    audioId          string
    videoId          string
    duration         number
    timestamps       object
    source           object
  }
  insert {
    id: coalesce(
      args.utteranceId,
      concat("utt-", hash(concat(
        canonicalId(args.spaceId, space), ":",
        canonicalId(args.participantId, participant), ":",
        timestamp()
      )))
    )
    args.spaceId
    args.participantId
    participantType: coalesce(args.participantType, "human")
    utteranceType: "speech"
    args.text
    args.audioId
    args.videoId
    args.duration
    args.timestamps
    args.source
  }
}

// ---- mutations/v1/cognition/sendTextUtterance.memql ----

// sendTextUtterance
// =================
//
// Inserts a new text utterance into a space conversation.

@enabled
@description("Create a text utterance in a space.")
mutation utterance mutationSendTextUtterance {
  args {
    utteranceId      string
    spaceId          string  @required
    participantId    string  @required
    participantType  string
    text             string  @required
    replyToId        string
    source           object
    citations        []object
  }
  insert {
