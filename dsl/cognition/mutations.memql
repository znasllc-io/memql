// ---- mutations/v1/cognition/setAgentAudioOverride.memql ----

// setAgentAudioOverride
// ====================
//
// Writes the per-(spaceId, agentId) audio control override that the
// Bridge Agent gating path consults before publishing TTS into a
// LiveKit room. The frontend's PresencePanel + canvas presence
// widget orb-corner overlay calls this on every click cycle
// (always_on -> always_off -> mirror_user -> always_on).
//
// IDEMPOTENCY:
// The id is the deterministic audioOverride:hash(spaceId:agentId)
// so re-toggling the same orb hits the SAME row -- memQL stores the
// versions as a time-series and the latest wins at read time. No
// per-click row growth.
//
// The bridge gating order is:
//   active override (this row) > agent default (audioControl on
//   v1:agents:agent) > "always_off" fallback for legacy agents.
//
// active=false on this row collapses to the agent default without
// destroying history.

@enabled
@description("Set the per-session audio control mode for an agent in a space.")
mutation audioOverride mutationSetAgentAudioOverride {
  args {
    spaceId  string  @required
    agentId  string  @required
    mode     string  @required
    setBy    string
    active   bool
  }
  insert audioOverride {
    id: concat("audioOverride-", hash(concat(
      canonicalId(args.spaceId, "v1:cognition:space"), ":",
      canonicalId(args.agentId, "v1:agents:agent")
    )))
    args.spaceId
    args.agentId
    args.setBy
    args.mode
    active: coalesce(args.active, true)
  }
}

// ---- mutations/v1/cognition/setAgentVideoOverride.memql ----

// setAgentVideoOverride
// =====================
//
// Writes the per-(spaceId, agentId) video control override that the
// voice-agent's avatar-gating path consults before publishing
// lip-synced video (Anam / Simli) into a LiveKit room. The frontend's
// PresencePanel orb-corner overlay calls this on every click cycle
// (always_on -> always_off -> mirror_user -> always_on).
//
// Mirrors mutationSetAgentAudioOverride field-for-field; the only
// difference is the target concept (v1:cognition:videoOverride)
// versus v1:cognition:audioOverride, and the id prefix.
//
// IDEMPOTENCY:
// The id is the deterministic videoOverride:hash(spaceId:agentId)
// so re-toggling the same orb hits the SAME row -- memQL stores the
// versions as a time-series and the latest wins at read time. No
// per-click row growth.
//
// The voice-agent gating order is:
//   active override (this row) > agent default (videoControl on
//   v1:agents:agent) > "always_off" fallback for legacy agents.
//
// active=false on this row collapses to the agent default without
// destroying history.

@enabled
@description("Set the per-session video control mode for an agent in a space.")
mutation videoOverride mutationSetAgentVideoOverride {
  args {
    spaceId  string  @required
    agentId  string  @required
    mode     string  @required
    setBy    string
    active   bool
  }
  insert videoOverride {
    id: concat("videoOverride-", hash(concat(
      canonicalId(args.spaceId, "v1:cognition:space"), ":",
      canonicalId(args.agentId, "v1:agents:agent")
    )))
    args.spaceId
    args.agentId
    args.setBy
    args.mode
    active: coalesce(args.active, true)
  }
}

// ---- mutations/v1/cognition/setUserMicState.memql ----

// setUserMicState
// ===============
//
// Writes the per-(spaceId, userId) mic state. The CoPresent
// MediaControls footer fires this on every LiveKit mic toggle so
// the cognition handler can resolve mirror_user agents'
// publication on the very next agent turn.
//
// IDEMPOTENCY:
// id is deterministic on (spaceId, userId) so re-toggling lands on
// the SAME row -- memQL stores the versions as a time-series and
// the latest payload wins at read time. No per-click row growth.

@enabled
@description("Set the per-user mic state for a space (LiveKit mic muted / unmuted).")
mutation micState mutationSetUserMicState {
  args {
    spaceId  string  @required
    userId   string  @required
    muted    bool    @required
  }
  insert micState {
    id: concat("micState-", hash(concat(
      canonicalId(args.spaceId, "v1:cognition:space"), ":",
      canonicalId(args.userId, "v1:identity:user")
    )))
    args.spaceId
    args.userId
    args.muted
    updatedAt: timestamp()
  }
}

// ---- mutations/v1/cognition/touchSession.memql ----

// touchSession
// ============
//
// Inserts a new version of a session record with the provided payload.
// Typically used to bump lastActivityAt (append-only heartbeat).

@enabled
@description("Insert a new version of a session record (typically used as a heartbeat).")
mutation session mutationTouchSession {
  args {
    sessionId  string  @required
    payload    object  @required
  }
  insert session {
    id: args.sessionId
    args.payload
  }
}

// ---- mutations/v1/cognition/updateParticipantPresence.memql ----

// updateParticipantPresence
// =========================
//
// Upserts participant presence snapshots for UI status overlays.
// This is append-only versioning with deterministic IDs for latest-wins reads.

@enabled
@description("Upsert a participant presence snapshot for multi-client status consistency.")
mutation presence mutationUpdateParticipantPresence {
  args {
    presenceId       string
    participantId    string  @required
    spaceId          string  @required
    state            string  @required  @enum("idle", "listening", "thinking", "typing", "responding", "working", "waiting", "needs_human", "paused", "error")
    label            string  @required
    reason           string
    sinceAt          string
    lastUpdatedAt    string
    lastUtteranceId  string
    lastError        string
    intent           object
  }
  insert presence {
    id: coalesce(
      args.presenceId,
      concat("presence-", args.participantId)
    )
    args.spaceId
    args.participantId
    args.state
    args.label
    args.reason
    sinceAt: coalesce(args.sinceAt, timestamp())
    lastUpdatedAt: coalesce(args.lastUpdatedAt, timestamp())
    args.lastUtteranceId
    args.lastError
    args.intent
  }
}

// ---- mutations/v1/cognition/updateParticipantStatus.memql ----

// updateParticipantStatus
// =======================
//
// Inserts a new version of a participant record with the provided payload.
// The caller is responsible for passing the full updated payload.

@enabled
@description("Insert a new version of a participant record (typically used to update status).")
mutation participant mutationUpdateParticipantStatus {
  args {
    participantId  string  @required
    payload        object  @required
  }
  insert participant {
    id: args.participantId
    args.payload
  }
}

