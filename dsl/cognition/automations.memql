// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Auto-creates a session when a participant joins a space
@trigger(event="node.created", concept="v1:cognition:participant", partition="*")
automation bootstrapSession {
  args {
    id any
    partitionId any
  }

  step decide {
    logic bootstrapSession ( event )
  }
  step createSession {
    if steps.decide.result == true {
      mutation createSessionForParticipant (
        participantId: coalesce(id, ""),
        partitionId:   coalesce(partitionId, "")
      )
    }
  }
  step emitSessionCreated {
    if steps.decide.result == true {
      publishEvent(
        topic: "session.created",
        payload: {
          sessionId:     coalesce(id, ""),
          participantId: coalesce(id, ""),
          partitionId:   coalesce(partitionId, ""),
          timestamp:     now
        }
      )
    }
  }
}

/// Generate and insert AI response for an utterance
@trigger(event="cognition.response.requested")
automation generateResponse {
  args {
    agentId any
    partitionId any
    siParticipantId any
    utteranceId any
  }

  step decide {
    logic generateResponse ( event )
  }
  step insert {
    if steps.decide.result != "" {
      mutation sendTextUtterance (
        partitionId:   coalesce(partitionId, ""),
        participantId: coalesce(siParticipantId, ""),
        text:          steps.decide.result,
        replyToId:     coalesce(utteranceId, ""),
        source:        { inputMethod: "si", agentId: coalesce(agentId, "") }
      )
    }
  }
  step presence {
    if steps.decide.result != "" {
      builtin cognitionTrackPresence(
        participantId: coalesce(siParticipantId, ""),
        partitionId:   coalesce(partitionId, ""),
        state:         "idle"
      )
    }
  }
}

// ---- automations/v1/cognition/purgeExpiredArchivedSpaces/automation.memql ----

/// On second-active-human-in-space, emit the Phase 7 voice-migration canvas-card pair (public group
/// card + private operator card per existing user).
@filter(payload.activePartitionId!="")
automation voiceMigrationOnSecondHuman @trigger(event="node.created", concept="v1:identity:user", partition="*") => logic voiceMigrationOnSecondHuman
