// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use cognition.logic.{ logicAutoJoinAI, logicBootstrapSession, logicGenerateResponse, logicPurgeExpiredArchivedSpaces, logicVoiceMigrationOnSecondHuman }

@enabled
@trigger(event="node.created", concept="v1:cognition:space", partition="*")
@filter(payload.active==true)
@description("On space creation, joins the creator's assistant plus any specialist agents picked at creation time. Joiners' GAs are never auto-joined.")
automation autoJoinAI {
  step run {
    logic autoJoinAI { event: event }
  }
}

// automations/v1/cognition/bootstrapSession/automation.memql
// Auto-creates a v1:cognition:session record when a participant is created.
// Ensures every participant has a session tracking their real-time interaction state.
@enabled
@trigger(event="node.created", concept="v1:cognition:participant", partition="*")
@description("Auto-creates a session when a participant joins a space")
automation bootstrapSession {
  step run {
    logic bootstrapSession { event: event }
  }
}

// automations/v1/cognition/generateResponse/automation.memql
// Generates and inserts an AI response when the cognition integration
// determines that a response is needed. The Go handler performs event
// reception, concurrent context loading, Polyphon scoring, and streaming
// dispatch, then emits this event with pre-loaded context when a
// non-streaming AI response is needed.
@enabled
@trigger(event="cognition.response.requested")
@description("Generate and insert AI response for an utterance")
automation generateResponse {
  step run {
    logic generateResponse { event: event }
  }
}

// ---- automations/v1/cognition/purgeExpiredArchivedSpaces/automation.memql ----

// purgeExpiredArchivedSpaces
// ==========================
//
// Daily sweep that hard-deletes archived spaces whose retention
// window has elapsed. Pattern mirrors expireGuestInvitations.
//
// The deadline (payload.expiresAt) is pre-computed at archive time
// (frontend stamps archivedAt + retentionDays), so the query is a
// plain `expiresAt < now` comparison and the cron loop just calls
// deleteSpaceNow per row.
//
// Defensive: only acts on rows where ALL of:
//   payload.status == "archived"   (traitStatusIsArchived in the query)
//   payload.active == true         (traitIsActiveRecord in the query)
//   payload.expiresAt < now        (filter in the query)
// Saved + scheduled + active spaces are untouched.
//
// Runs daily at 02:00 UTC. Cadence is loose (vs expireGuestInvitations's
// 30-second tick) because retention is measured in days; missing the
// boundary by a few hours doesn't matter -- next run catches it.
@enabled
@trigger(schedule="0 0 2 * * *")
@description("Daily sweep to hard-delete archived spaces past their expiresAt deadline.")
automation purgeExpiredArchivedSpaces {
  step run {
    logic purgeExpiredArchivedSpaces { event: event }
  }
}

// voiceMigrationOnSecondHuman
// ===========================
//
// PURPOSE:
// Phase 7 of the chat-architecture plan. When the SECOND active human
// shows up in a space, voice transport migrates from each user's per-
// user Team thread to the shared GROUP thread. The automation emits
// the canvas-card pair that announces the migration:
//
//   Public group card  -- "{user} joined -- voice is active in this chat."
//                          Visible to every space participant.
//   Private operator   -- "Voice moved to the group chat -- push-to-talk
//   card per user        or type to message your team here."
//                          Per-existing-user; lands on each user's
//                          private canvas timeline.
//
// TRIGGER:
// graph.node.created.v1:identity:user fires on every user-row write
// (primary path: mutationSetUserActiveSpace shipping a new version).
// We filter to rows whose payload.activeSpaceId is non-empty -- a user
// whose pointer is set has just become active in some space.
//
// FIRE CONDITION:
// queryUsersActiveInSpace returns the full set of users currently
// pointing at the same space. We act when the count is exactly 2 --
// the just-joined user PLUS one prior active human. Counts of 1 (single
// user) and 3+ (already migrated) are no-ops.
//
// IDEMPOTENCY:
// The public canvas-state id is content-addressed on
// (space, "voice-migrated"). Re-firing the automation for the same
// (space) lands the same id, which the executeInsert path collapses
// via ON CONFLICT. The per-user private cards are content-addressed
// on (space, "voice-migrated", userId) for the same reason.
//
// REVERSE MIGRATION:
// When the count drops below 2 (last other human leaves), the symmetric
// "voice moved back to your Team chat" card lands -- handled by a
// sibling automation when needed (deferred until the frontend wiring
// shows the need).
@enabled
@trigger(event="node.created", concept="v1:identity:user", partition="*")
@filter(payload.activeSpaceId!="")
@description("On second-active-human-in-space, emit the Phase 7 voice-migration canvas-card pair (public group card + private operator card per existing user).")
automation voiceMigrationOnSecondHuman {
  step run {
    logic voiceMigrationOnSecondHuman { event: event }
  }
}
