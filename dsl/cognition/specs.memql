// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use cognition.concepts.{ participant }

@description("Matches participants with human participantType")
spec specIsHumanParticipant {
  payload.participantType == "human"
}

// ---- specs/v1/cognition/isAIParticipant.memql ----

// specIsAIParticipant - SI Participant Type Spec
// ===============================================
//
// Reusable filter that matches participants with SI type.
// SI participants are automated agents in spaces.
//
// Usage in queries:
//   concept==v1:cognition:participant;specIsAIParticipant()
//

@description("Matches participants with SI participantType")
spec specIsAIParticipant {
  payload.participantType=="si"
}
