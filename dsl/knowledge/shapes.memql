  payload.bbox
  payload.caption
  payload.domainHints
  payload.validationStatus
  payload.validatedBy
  payload.validatedAt
  payload.dedupStatus
  payload.matchesEntityIndexId
  payload.embeddedAsChunkId
  row.createdAt
}

@row
@useConcept(spreadsheetRow)
@description("Comprehensive SpreadsheetRow projection. Backs the per-item drawer on the validation card + the dedup-resolution UI.")
shape spreadsheetRowFull {
