// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@useConcept(document)
@description("Comprehensive Document projection. Backs the Knowledge page detail view + the plan.completed canvas card's structured-result preview + the validation card.")
shape documentFull {
  row.id
  document.attachmentId
  document.planId
  document.spaceId
  document.fileName
  document.mimeType
  document.format
  document.itemKind
  document.itemCount
  document.summary
  document.domainHints
  document.attachedDomains
  document.validationStatus
  document.validatedBy
  document.validatedAt
  document.supersedesDocumentId
  document.supersededByDocumentId
  document.supersededAt
  document.embeddingStatus
  document.embeddedItemCount
  document.uploadedBy
  row.createdAt
  row.createdBy
}

@row
@useConcept(domainEntitySchema)
@description("DomainEntitySchema projection. Backs the entity-schema-confirmation card + the domain settings drawer.")
shape domainEntitySchemaFull {
  row.id
  domainEntitySchema.domainId
  domainEntitySchema.entityKind
  domainEntitySchema.keyFields
  domainEntitySchema.displayFields
  domainEntitySchema.inferredFromDocumentId
  domainEntitySchema.inferredFromTaskId
  domainEntitySchema.confirmedBy
  domainEntitySchema.confirmedAt
  domainEntitySchema.active
  row.createdAt
}

@row
@useConcept(entityIndex)
@description("EntityIndex projection. Used by the analyzer for dedup lookups + by the per-item drawer to render the matched canonical entry side-by-side with the incoming row.")
shape entityIndexFull {
  row.id
  entityIndex.domainId
  entityIndex.entityKind
  entityIndex.keyHash
  entityIndex.sourceDocumentId
  entityIndex.sourceItemId
  entityIndex.validatedAt
  entityIndex.forceAdded
  entityIndex.dedupOverrideNote
  row.createdAt
}

@row
@useConcept(imageRegion)
@description("Comprehensive ImageRegion projection. Backs the per-region drawer on the validation card + visual retrieval.")
shape imageRegionFull {
  row.id
  imageRegion.documentId
  imageRegion.regionSeq
  imageRegion.bbox
  imageRegion.caption
  imageRegion.domainHints
  imageRegion.validationStatus
  imageRegion.validatedBy
  imageRegion.validatedAt
  imageRegion.dedupStatus
  imageRegion.matchesEntityIndexId
  imageRegion.embeddedAsChunkId
  row.createdAt
}

@row
@useConcept(spreadsheetRow)
@description("Comprehensive SpreadsheetRow projection. Backs the per-item drawer on the validation card + the dedup-resolution UI.")
shape spreadsheetRowFull {
  row.id
  spreadsheetRow.documentId
  spreadsheetRow.rowSeq
  spreadsheetRow.data
  spreadsheetRow.domainHints
  spreadsheetRow.validationStatus
  spreadsheetRow.validatedBy
  spreadsheetRow.validatedAt
  spreadsheetRow.dedupStatus
  spreadsheetRow.matchesEntityIndexId
  spreadsheetRow.diffFromMatched
  spreadsheetRow.embeddedAsChunkId
  row.createdAt
}

@row
@useConcept(validationEvent)
@description("Comprehensive ValidationEvent projection. Backs the audit history drawer on Document detail.")
shape validationEventFull {
  row.id
  validationEvent.targetConceptType
  validationEvent.targetId
  validationEvent.fromStatus
  validationEvent.toStatus
  validationEvent.actorUserId
  validationEvent.reason
  validationEvent.note
  row.createdAt
}
