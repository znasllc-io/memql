// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use knowledge.concepts.{ document, domainEntitySchema, entityIndex, imageRegion, knowledgeBridge, knowledgeDomain, spreadsheetRow, validationEvent }

@row
@description("Comprehensive Document projection. Backs the Knowledge page detail view + the plan.completed canvas card's structured-result preview + the validation card.")
shape document documentFull {
  row.id
  payload.attachmentId
  payload.planId
  payload.partitionId
  payload.fileName
  payload.mimeType
  payload.format
  payload.itemKind
  payload.itemCount
  payload.summary
  payload.domainHints
  payload.attachedDomains
  payload.validationStatus
  payload.validatedBy
  payload.validatedAt
  payload.supersedesDocumentId
  payload.supersededByDocumentId
  payload.supersededAt
  payload.embeddingStatus
  payload.embeddedItemCount
  payload.uploadedBy
  row.createdAt
  row.createdBy
}

@row
@description("DomainEntitySchema projection. Backs the entity-schema-confirmation card + the domain settings drawer.")
shape domainEntitySchema domainEntitySchemaFull {
  row.id
  payload.domainId
  payload.entityKind
  payload.keyFields
  payload.displayFields
  payload.inferredFromDocumentId
  payload.inferredFromTaskId
  payload.confirmedBy
  payload.confirmedAt
  payload.active
  row.createdAt
}

@row
@description("EntityIndex projection. Used by the analyzer for dedup lookups + by the per-item drawer to render the matched canonical entry side-by-side with the incoming row.")
shape entityIndex entityIndexFull {
  row.id
  payload.domainId
  payload.entityKind
  payload.keyHash
  payload.sourceDocumentId
  payload.sourceItemId
  payload.validatedAt
  payload.forceAdded
  payload.dedupOverrideNote
  row.createdAt
}

@row
@description("Comprehensive ImageRegion projection. Backs the per-region drawer on the validation card + visual retrieval.")
shape imageRegion imageRegionFull {
  row.id
  payload.documentId
  payload.regionSeq
  payload.bbox
  payload.caption
  payload.domainHints
  payload.validationStatus
  payload.validatedBy
  payload.validatedAt
  payload.dedupStatus
  payload.matchesEntityIndexId
  payload.embeddedAsChunkId
  row.createdAt
}

@row
@description("Comprehensive SpreadsheetRow projection. Backs the per-item drawer on the validation card + the dedup-resolution UI.")
shape spreadsheetRow spreadsheetRowFull {
  row.id
  payload.documentId
  payload.rowSeq
  payload.data
  payload.domainHints
  payload.validationStatus
  payload.validatedBy
  payload.validatedAt
  payload.dedupStatus
  payload.matchesEntityIndexId
  payload.diffFromMatched
  payload.embeddedAsChunkId
  row.createdAt
}

@row
@description("Comprehensive ValidationEvent projection. Backs the audit history drawer on Document detail.")
shape validationEvent validationEventFull {
  row.id
  payload.targetConceptType
  payload.targetId
  payload.fromStatus
  payload.toStatus
  payload.actorUserId
  payload.reason
  payload.note
  row.createdAt
}

@row
@description("Knowledge domain projection used by the Trainer Agent dispatch path (Q3 + Q9 of the planner-redesign work). Carries the cadence fields the refresh cron consumes (refreshCadenceDays, lastSeededAt, staleSignalCount) plus the descriptive fields the Planner Agent needs to decide whether a stale signal warrants an immediate refresh vs waiting for the cadence backstop.")
shape knowledgeDomain knowledgeDomainFull {
  row.id
  payload.name
  payload.description
  payload.category
  payload.active
  payload.scope
  payload.ownerId
  payload.tier
  payload.source
  payload.refreshCadenceDays
  payload.lastSeededAt
  payload.staleSignalCount
  payload.predefined
}

@row
@description("Comprehensive knowledge-bridge projection. Backs queryKnowledgeBridgeById -- the cross-domain bridge lookup the training pipeline uses to find an existing (roleSlug, sortedDomainIds) bridge corpus and reuse it rather than regenerating per agent. Carries the combination key fields (roleSlug, domainIds, combinationKey, bridgeId) plus the freshness / status bookkeeping (chunkCount, recipeVersion, generatedAt, active).")
shape knowledgeBridge knowledgeBridgeFull {
  row.id
  payload.bridgeId
  payload.roleSlug
  payload.domainIds
  payload.combinationKey
  payload.chunkCount
  payload.recipeVersion
  payload.generatedAt
  payload.active
  row.createdAt
}
