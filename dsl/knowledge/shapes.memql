// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@useConcept(document)
@description("Comprehensive Document projection. Backs the Knowledge page detail view + the plan.completed canvas card's structured-result preview + the validation card.")
shape documentFull {
  row.id
  payload.attachmentId
  payload.planId
  payload.spaceId
  payload.fileName
  payload.mimeType
  payload.format
  payload.itemKind
  payload.itemCount
  payload.summary
  payload.domainHints
  payload.attachedDomains
  payload.validationStatus
  payload.validatedBy
  payload.validatedAt
  payload.supersedesDocumentId
  payload.supersededByDocumentId
  payload.supersededAt
  payload.embeddingStatus
  payload.embeddedItemCount
  payload.uploadedBy
  row.createdAt
  row.createdBy
}

@row
@useConcept(domainEntitySchema)
@description("DomainEntitySchema projection. Backs the entity-schema-confirmation card + the domain settings drawer.")
shape domainEntitySchemaFull {
  row.id
  payload.domainId
  payload.entityKind
  payload.keyFields
  payload.displayFields
  payload.inferredFromDocumentId
  payload.inferredFromTaskId
  payload.confirmedBy
  payload.confirmedAt
  payload.active
  row.createdAt
}

@row
@useConcept(entityIndex)
@description("EntityIndex projection. Used by the analyzer for dedup lookups + by the per-item drawer to render the matched canonical entry side-by-side with the incoming row.")
shape entityIndexFull {
  row.id
  payload.domainId
  payload.entityKind
  payload.keyHash
  payload.sourceDocumentId
  payload.sourceItemId
  payload.validatedAt
  payload.forceAdded
  payload.dedupOverrideNote
  row.createdAt
}

@row
@useConcept(imageRegion)
