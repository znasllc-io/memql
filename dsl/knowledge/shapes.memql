@row
@useConcept(validationEvent)
@description("Comprehensive ValidationEvent projection. Backs the audit history drawer on Document detail.")
shape validationEventFull {
  row.id
  payload.targetConceptType
  payload.targetId
  payload.fromStatus
  payload.toStatus
  payload.actorUserId
  payload.reason
  payload.note
  row.createdAt
}

@row
@useConcept(knowledgeDomain)
@description("Knowledge domain projection used by the Trainer Agent dispatch path (Q3 + Q9 of the planner-redesign work). Carries the cadence fields the refresh cron consumes (refreshCadenceDays, lastSeededAt, staleSignalCount) plus the descriptive fields the Planner Agent needs to decide whether a stale signal warrants an immediate refresh vs waiting for the cadence backstop.")
shape knowledgeDomainFull {
  row.id
  payload.name
  payload.description
  payload.category
  payload.active
  payload.scope
  payload.ownerId
  payload.tier
  payload.source
  payload.refreshCadenceDays
  payload.lastSeededAt
  payload.staleSignalCount
  payload.predefined
}
