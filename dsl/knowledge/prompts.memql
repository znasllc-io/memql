// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Generate ~10 cross-domain 'bridge' chunks for a (role, domain set) combination. Each chunk
/// explicitly addresses how the domains overlap, conflict, or compose for an agent in that role --
/// the kind of cross-cutting insight per-domain chunks miss because they're scoped to one domain.
/// Per docs/planning/knowledge-seeder.md (v2 bridge chunks). Hash-keyed by (roleSlug,
/// sortedDomainIds) so this prompt fires once per unique combination across the tenant.
@defaultProvider("chat54Mini")
@templateFile("prompts/seedDomainBridge.tmpl")
prompt seedDomainBridge {
  roleSlug      string! @description("Agent role -- shapes how the bridge content frames cross-domain reasoning. customer-service vs accounting-finance change the bridge entirely.")
  roleLabel     string! @description("Human-readable role name for the prompt body, e.g. 'Customer Service'.")
  domains       []object! @description("List of {id, name, description} for each domain in this combination. The bridge addresses how these specifically intersect.")
  targetCount   int      @description("Approximate number of bridge chunks to produce. Default 10. Bridges are deliberately smaller than per-domain corpora -- they're supplementary, not the primary content.")
}

/// Generate ~30 retrievable knowledge chunks for a domain. Output is structured -- principle /
/// decisionRule / factExample chunks with title, body, and keyTerms. Used by the knowledge seeder
/// to populate empty domain shells with LLM-generated baseline content. Each chunk should be
/// self-contained, 100-300 words, dense, citation-worthy, declarative -- the kind of content an
/// agent answering a question in this domain benefits from having retrieved into its prompt
/// context. See docs/planning/knowledge-seeder.md for the full pipeline.
@defaultProvider("chat54Mini")
@templateFile("prompts/seedDomainContent.tmpl")
prompt seedDomainContent {
  domainId       string! @description("Domain id (slug) to generate content for, e.g. 'physics_quantum_mechanics'.")
  domainName     string! @description("Display name, e.g. 'Quantum Mechanics'.")
  domainDescription string! @description("One-line description from the standardDomain entry.")
  category       string  @description("Coarse grouping (science / humanities / creative / etc.) -- helps the model calibrate tone + register.")
  targetCount    int     @description("Approximate number of chunks to produce. Defaults to 30 if absent (60 for broadSurvey domains). Mix: ~8 principles, ~12 decisionRules, ~10 factExamples (~25-30 factExamples in broad-survey mode).")
  tier           string  @description("Tier A or B (C never reaches this prompt -- the seeder skips it). B prompts add explicit 'general info, not professional advice' framing where appropriate.")
  broadSurvey    bool    @description("True for domains whose scope spans many sub-areas (multi-millennium history, world civilizations, etc.). Flips the prompt into named-anchor coverage mode -- requires factExample chunks to title specific events / people / works / dates. Defaults to false; the seeder sets it from StandardDomain.BroadSurvey.")
}
