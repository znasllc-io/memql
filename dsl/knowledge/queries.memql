// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.shapes.{ documentChunkDomainLite, documentChunkFull }

/// Returns the parent domainId for every chunk in the active partition. Frontend groups + counts to
/// render per-domain chunk counts in the Knowledge panel.
@unbounded("distinct chunk domain ids -- a bounded dedupe enumeration consumed whole")
query documentChunk allDocumentChunkDomains {
  filter  domainId!=""
  shape   documentChunkDomainLite
}

// documentChunksForDomain -- every chunk in a knowledge domain.
// Backs the Trainer Agent's mode='refresh' existingCorpus input: the
// trainSpecialist dispatcher reads the current chunks so the Trainer
// can decide what's still current vs. what to mark superseded. The
// Go-side dispatcher truncates the text per chunk before handing the
// corpus to the prompt (token budget).

/// Every documentChunk attached to a knowledge domain, full shape. Consumed by the trainSpecialist
/// dispatcher for the Trainer Agent's mode='refresh' existingCorpus
/// (read-what's-there-now-to-decide-what-to-supersede).
query documentChunk documentChunksForDomain {
  args {
    domainId  string!
  }
  filter  domainId==args.domainId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   documentChunkFull
}

// queryDocumentsForDomain, queryDocumentsForSpace, and queryEntityIndexLookup
// used to have dead stub headers here (restructure-script artifacts): none
// of the three is declared in this file, or anywhere in dsl/knowledge/.
// Removed.


/// Every knowledge domain this cluster holds.
///
/// The read the Training app's domain cards have never had (epic memql#4800).
/// Until this landed, that page was entirely CHUNK-derived: it rolled domains
/// up out of `v1:knowledge:documentChunk.domainId` and labelled each card with
/// the raw id, because the domain row itself had no client read surface and no
/// concept declaration behind it. With this, a card can say the domain's name
/// and render the account it is tagged with.
///
/// NO ACTOR TERM, because the concept declares no row-authz tier -- see the
/// concept for why that matches its sibling `documentChunk` rather than
/// departing from it. A caller reads the cluster's catalog, which is the same
/// catalog for everybody.
///
/// `active` is NOT filtered here. The seeder's own existence probe treats a
/// missing key and true alike, and a surface that wants only live domains can
/// fold on the field; a query that pre-filtered it would hide exactly the rows
/// an operator asking "why is this domain not working" needs to see.
query knowledgeDomain knowledgeDomainsAll {
  shape  knowledgeDomainFull
  sort   "name", "asc"
}
