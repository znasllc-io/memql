// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use knowledge.concepts.{ document, documentChunk, domainEntitySchema, entityIndex, imageRegion, knowledgeBridge, knowledgeDomain, spreadsheetRow, validationEvent }

@enabled
@description("Returns the parent domainId for every chunk in the active partition. Frontend groups + counts to render per-domain chunk counts in the Knowledge panel.")
query documentChunk queryAllDocumentChunkDomains {
  filter  payload.domainId!=""
  shape   documentChunkDomainLite
}

// queryDocumentChunksForDomain -- every chunk in a knowledge domain.
// Backs the Trainer Agent's mode='refresh' existingCorpus input: the
// trainSpecialist dispatcher reads the current chunks so the Trainer
// can decide what's still current vs. what to mark superseded. The
// Go-side dispatcher truncates the text per chunk before handing the
// corpus to the prompt (token budget).

@enabled
@description("Every documentChunk attached to a knowledge domain, full shape. Consumed by the trainSpecialist dispatcher for the Trainer Agent's mode='refresh' existingCorpus (read-what's-there-now-to-decide-what-to-supersede).")
query documentChunk queryDocumentChunksForDomain {
  args {
    domainId  string  @required
  }
  filter  payload.domainId==args.domainId
  shape   documentChunkFull
}

@enabled
@description("Single Document by id.")
query document queryDocumentById {
  args {
    documentId  string  @required
  }
  filter  id==args.documentId
  shape   documentFull
}

// ---- queries/v1/knowledge/documentsForDomain.memql ----

// queryDocumentsForDomain -- all validated Documents attached to a knowledge domain.
// Backs the Knowledge page detail view ("what's in this domain").

@enabled
@description("Validated Documents attached to a knowledge domain. attachedDomains is a []string, so membership (`in`) is the correct join -- memql#1708: the old `payload.attachedDomains==args.domainId` compared the whole list against a scalar and never matched, so the detail view came back empty even for a validated, correctly-attached Document.")
query document queryDocumentsForDomain {
  args {
    domainId  string  @required
  }
  filter  args.domainId in payload.attachedDomains && payload.validationStatus=="validated"
  shape   documentFull
}

// ---- queries/v1/knowledge/documentsForSpace.memql ----

// queryDocumentsForSpace -- list every Document in a space.
// Backs the Knowledge page's "all uploads in this space" view.

@enabled
@description("All Documents in a space, regardless of validation status.")
query document queryDocumentsForSpace {
  args {
    spaceId  string  @required
  }
  filter  payload.spaceId==args.spaceId
  shape   documentFull
}

// ---- queries/v1/knowledge/entityIndexLookup.memql ----

// queryEntityIndexLookup -- the dedup lookup. Given a (domainId,
// entityKind, keyHash) triple, return any matching index entries.
// Multiple matches happen when force-added overrides exist.

@enabled
@description("Look up entity-index entries by (domainId, entityKind, keyHash) for cross-file dedup.")
query entityIndex queryEntityIndexLookup {
  args {
    domainId  string  @required
    entityKind  string  @required
    keyHash  string  @required
  }
  filter  payload.domainId==args.domainId && payload.entityKind==args.entityKind && payload.keyHash==args.keyHash
  shape   entityIndexFull
}

@enabled
@description("Active entity schemas for a knowledge domain (a domain may declare multiple entity kinds).")
query domainEntitySchema queryEntitySchemaForDomain {
  args {
    domainId  string  @required
  }
  filter  payload.domainId==args.domainId && traitIsActiveRecord
  shape   domainEntitySchemaFull
}

@enabled
@description("All ImageRegions for an image Document, in region-seq order.")
query imageRegion queryImageRegionsForDocument {
  args {
    documentId  string  @required
  }
  filter  payload.documentId==args.documentId
  shape   imageRegionFull
}

@enabled
@description("Look up a single knowledge-bridge row by its deterministic id. Used by the bridge generator to detect 'this combination has already been seeded; reuse instead of regenerating'.")
query knowledgeBridge queryKnowledgeBridgeById {
  args {
    bridgeId  string  @required
  }
  filter  when(args.bridgeId) { id==args.bridgeId }
  shape   knowledgeBridgeFull
}

@enabled
@description("Look up a single knowledge domain by id.")
query knowledgeDomain queryKnowledgeDomainById {
  args {
    domainId  string  @required
  }
  filter  when(args.domainId) { id==args.domainId }
  shape   knowledgeDomainFull
}

@enabled
@description("List all active knowledge domains. Used by the agent builder's knowledge picker and by operator-turn retrieval to resolve domain metadata.")
query knowledgeDomain queryListKnowledgeDomains {
  filter  traitIsActiveRecord
  shape   knowledgeDomainFull
}

@enabled
@description("All SpreadsheetRows for a Document, in row-seq order.")
query spreadsheetRow querySpreadsheetRowsForDocument {
  args {
    documentId  string  @required
  }
  filter  payload.documentId==args.documentId
  shape   spreadsheetRowFull
}

// `@public` marks this query as intentionally not caller-scoped.
// Audit history of validation transitions on a target row;
// visibility follows the target's own scope (whoever can read the
// target can read its validation history). If we ever want per-row
// gating on audit reads, file under #54.
@enabled
@public
@description("Audit history of validation transitions for a specific target row.")
query validationEvent queryValidationEventsForTarget {
  args {
    targetId  string  @required
  }
  filter  payload.targetId==args.targetId
  shape   validationEventFull
}

@enabled
@description("Per Q9 scheduled fallback: list active knowledge domains whose lastSeededAt + refreshCadenceDays * 86400 < now (the cadence backstop fires). The refreshDueKnowledgeDomains cron consumes this nightly + spawns trainSpecialist Plans (mode='refresh') for each row returned. Predefined domains AND user-created domains are both eligible -- the picker constraint sits on the domain row's refreshCadenceDays (null = disabled).")
query knowledgeDomain queryDueRefreshDomains {
  args {}
  filter  traitIsActiveRecord && payload.refreshCadenceDays!=null
  shape   knowledgeDomainFull
}
