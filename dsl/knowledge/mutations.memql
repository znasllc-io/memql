// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use knowledge.concepts.{ document, documentChunk, domainEntitySchema, entityIndex, imageRegion, knowledgeBridge, knowledgeDomain, spreadsheetRow, validationEvent }

@enabled
@description("Attach a validated Document to a knowledge domain. Triggers lazy embedding of typed items into documentChunk for that domain.")
mutation document mutationAttachDocumentToDomain {
  args {
    documentId       string  @required
    attachedDomains  object  @required
  }
  update {
    id: args.documentId
    args.attachedDomains
  }
}

// ---- mutations/v1/knowledge/createDocument.memql ----

// mutationCreateDocument -- single write path for v1:knowledge:document.
// Called by the analyzer after a Plan's Tasks have produced a structured
// breakdown of an attachment.

@enabled
@description("Insert a v1:knowledge:document row. Lands as unvalidated; user validates from the plan.completed card.")
mutation document mutationCreateDocument {
  args {
    documentId    string
    attachmentId  string  @required
    planId        string  @required
    spaceId       string  @required
    fileName      string  @required
    mimeType      string  @required
    format        string  @required
    itemKind      string
    itemCount     int
    summary       string
    domainHints   object
    uploadedBy    string  @required
  }
  insert {
    id: args.documentId
    args.attachmentId
    args.planId
    args.spaceId
    args.fileName
    args.mimeType
    args.format
    args.itemKind
    args.itemCount
    args.summary
    args.domainHints
    validationStatus: "unvalidated"
    embeddingStatus: "none"
    args.uploadedBy
  }
}

@enabled
@description("Create a document chunk linked to a knowledge domain. Called by every chunk-writing integration (seedDomainContent, augmentDomainGenerate, ensureKnowledgeBridge, the CoPresent UI corpus ingest). source is REQUIRED and tags the chunk's provenance class -- the dev-refresh cache filter and the citation registry both read it as the source of truth. Optional sourceUtteranceId / sourceAgentId / sourceTopic carry chat-driven augment provenance back-pointers.")
mutation documentChunk mutationCreateDocumentChunk {
  args {
    chunkId            string  @required
    domainId           string  @required
    text               string  @required
    source             string  @required
    sourceRef          string
    seq                int
    tokenCount         int
    sourceUtteranceId  string
    sourceAgentId      string
    sourceTopic        string
  }
  insert {
    id: args.chunkId
    args.domainId
    args.text
    args.source
    sourceRef: coalesce(args.sourceRef, "")
    seq: coalesce(args.seq, 0)
    tokenCount: coalesce(args.tokenCount, 0)
    args.sourceUtteranceId
    args.sourceAgentId
    args.sourceTopic
  }
}

@enabled
@description("Insert a per-domain entity schema. Called by the entity-inference Plan after the user confirms the proposed schema on the domain-setup card.")
mutation domainEntitySchema mutationCreateDomainEntitySchema {
  args {
    schemaId                string
    domainId                string    @required
    entityKind              string    @required
    keyFields               []string  @required
    displayFields           []string
    inferredFromDocumentId  string
    inferredFromTaskId      string
    confirmedBy             string
    confirmedAt             string
  }
  insert {
    id: args.schemaId
    args.domainId
    args.entityKind
    args.keyFields
    args.displayFields
    args.inferredFromDocumentId
    args.inferredFromTaskId
    args.confirmedBy
    args.confirmedAt
    active: true
  }
}

@enabled
@description("Insert a v1:knowledge:entityIndex row when an item is validated as 'new' against a domain. Future dedup checks against the same keyHash will surface this row.")
mutation entityIndex mutationCreateEntityIndexEntry {
  args {
    entryId            string
    domainId           string  @required
    entityKind         string  @required
    keyHash            string  @required
    sourceDocumentId   string  @required
    sourceItemId       string  @required
    validatedAt        string  @required
    forceAdded         bool
    dedupOverrideNote  string
  }
  insert {
    id: args.entryId
    args.domainId
    args.entityKind
    args.keyHash
    args.sourceDocumentId
    args.sourceItemId
    args.validatedAt
    forceAdded: coalesce(args.forceAdded, false)
    args.dedupOverrideNote
  }
}

@enabled
@description("Insert a v1:knowledge:imageRegion. Called per-region by the image analyzer.")
mutation imageRegion mutationCreateImageRegion {
  args {
    regionId     string
    documentId   string  @required
    regionSeq    int     @required
    bbox         object  @required
    caption      string  @required
    domainHints  object
  }
  insert {
    id: args.regionId
    args.documentId
    args.regionSeq
    args.bbox
    args.caption
    args.domainHints
    validationStatus: "unvalidated"
    dedupStatus: "na"
  }
}

@enabled
@description("Insert a v1:common:knowledgeBridge row. Caller is the knowledge integration's bridge generator -- one bridge per unique (roleSlug, sortedDomainIds) pair across the whole tenant.")
mutation knowledgeBridge mutationCreateKnowledgeBridge {
  args {
    bridgeId        string  @required
    roleSlug        string  @required
    domainIds       array   @required
    combinationKey  string  @required
    chunkCount      int
    recipeVersion   string
    generatedAt     string
  }
  insert {
    id: args.bridgeId
    args.bridgeId
    args.roleSlug
    args.domainIds
    args.combinationKey
    chunkCount: coalesce(args.chunkCount, 0)
    recipeVersion: coalesce(args.recipeVersion, "v1")
    args.generatedAt
    active: true
  }
}

@enabled
@description("Create or replace a knowledge domain. Use the slug as domainId (e.g. 'business_administration', 'copresent_ui') so agents can reference domains by a stable human-readable id. v1: optional scope + ownerId support workspace + private domains (Q21). v2: source + refreshCadenceDays support the citation registry + per-domain freshness cadence picker.")
mutation knowledgeDomain mutationCreateKnowledgeDomain {
  args {
    domainId             string  @required
    name                 string  @required
    description          string
    category             string
    relevantForRoles     array
    lockedForRoles       array
    requiredByToolSlugs  array
    active               bool
    scope                string
    ownerId              string
    tier                 string
    lastSeededAt         string
    seederRecipeVersion  string
    source               string
    refreshCadenceDays   int
    predefined           bool
  }
  insert {
    id: args.domainId
    args.name
    args.description
    category: coalesce(args.category, "business")
    relevantForRoles: coalesce(args.relevantForRoles, [])
    lockedForRoles: coalesce(args.lockedForRoles, [])
    requiredByToolSlugs: coalesce(args.requiredByToolSlugs, [])
    active: coalesce(args.active, true)
    scope: coalesce(args.scope, "workspace")
    args.ownerId
    tier: coalesce(args.tier, "A")
    args.lastSeededAt
    args.seederRecipeVersion
    source: coalesce(args.source, "llmSeeded")
    refreshCadenceDays: coalesce(args.refreshCadenceDays, 90)
    predefined: coalesce(args.predefined, false)
  }
}

@enabled
@description("Insert a v1:knowledge:spreadsheetRow. Called per-row by the analyzer during a Document's structured breakdown.")
mutation spreadsheetRow mutationCreateSpreadsheetRow {
  args {
    rowId        string
    documentId   string  @required
    rowSeq       int     @required
    data         object  @required
    domainHints  object
  }
  insert {
    id: args.rowId
    args.documentId
    args.rowSeq
    args.data
    args.domainHints
    validationStatus: "unvalidated"
    dedupStatus: "na"
  }
}

@enabled
@description("Append-only audit log entry for a validation status transition.")
mutation validationEvent mutationCreateValidationEvent {
  args {
    eventId            string
    targetConceptType  string  @required
    targetId           string  @required
    fromStatus         string  @required
    toStatus           string  @required
    actorUserId        string
    reason             string
    note               string
  }
  insert {
    id: args.eventId
    args.targetConceptType
    args.targetId
    args.fromStatus
    args.toStatus
    args.actorUserId
    reason: coalesce(args.reason, "user")
    args.note
  }
}

@enabled
@description("Soft-delete a knowledge domain by flipping active=false. Agents that reference the domain keep working; the domain just stops appearing in the builder picker.")
mutation knowledgeDomain mutationDeleteKnowledgeDomain {
  args {
    domainId             string  @required
    name                 string  @required
    description          string
    category             string
    relevantForRoles     array
    requiredByToolSlugs  array
  }
  insert {
    id: args.domainId
    args.name
    args.description
    category: coalesce(args.category, "business")
    relevantForRoles: coalesce(args.relevantForRoles, [])
    requiredByToolSlugs: coalesce(args.requiredByToolSlugs, [])
    active: false
  }
}

// ---- mutations/v1/common/markKnowledgeDomainSeeded.memql ----

// mutationMarkKnowledgeDomainSeeded -- partial update that stamps
// the freshness fields (lastSeededAt + seederRecipeVersion) on a
// knowledge domain after a successful seeder run. Uses update()
// (read-merge-validate-write) so the caller doesn't have to re-pass
// every required field on the domain concept.
//
// Called by the knowledge integration's seeder right after a
// runSeederForDomain success. The training pipeline reads
// lastSeededAt + seederRecipeVersion to decide whether to re-seed
// on retrain.

@enabled
@description("Stamp lastSeededAt + seederRecipeVersion on a knowledge domain after a successful seeder run. Partial update via update() -- only the freshness fields change; everything else inherits from the prior row.")
mutation knowledgeDomain mutationMarkKnowledgeDomainSeeded {
  args {
    domainId             string  @required
    lastSeededAt         string  @required
    seederRecipeVersion  string  @required
  }
  update {
    id: args.domainId
    args.lastSeededAt
    args.seederRecipeVersion
  }
}

// ---- mutations/v1/knowledge/updateDocumentValidation.memql ----

// mutationUpdateDocumentValidation -- transition a Document's
// validationStatus. Stamps validatedBy / validatedAt; the audit
// log entry is written separately via mutationCreateValidationEvent
// so callers can compose without coupling.

@enabled
@description("Update a Document's validationStatus + validatedBy/validatedAt. Append-only; new version with the new status wins.")
mutation document mutationUpdateDocumentValidation {
  args {
    documentId        string  @required
    validationStatus  string  @required
    validatedBy       string
    validatedAt       string
  }
  update {
    id: args.documentId
    args.validationStatus
    args.validatedBy
    args.validatedAt
  }
}

// ---- mutations/v1/knowledge/updateDocumentEmbeddingStatus.memql ----

// mutationUpdateDocumentEmbeddingStatus -- drive a Document's
// embeddingStatus none -> partial -> complete as its typed items get
// lazily embedded into documentChunk (#645). Written by the knowledge
// integration's embedDomainItems capability after it recomputes the live
// vector coverage of the Document's chunks. Partial update: only the
// embedding bookkeeping fields change; validation + content fields are
// untouched.

@enabled
@description("Update a Document's embeddingStatus (none / partial / complete) + embeddedItemCount as its items get embedded into documentChunk. Driven by the embedDomainItems Plan; partial update preserves every other field.")
mutation document mutationUpdateDocumentEmbeddingStatus {
  args {
    documentId         string  @required
    embeddingStatus    string  @required
    embeddedItemCount  int
  }
  update {
    id: args.documentId
    args.embeddingStatus
    embeddedItemCount: coalesce(args.embeddedItemCount, 0)
  }
}

@enabled
@description("Update a SpreadsheetRow's validation / dedup state. Append-only; new version with new fields wins.")
mutation spreadsheetRow mutationUpdateSpreadsheetRow {
  args {
    rowId                 string  @required
    validationStatus      string
    validatedBy           string
    validatedAt           string
    dedupStatus           string
    matchesEntityIndexId  string
    diffFromMatched       object
    embeddedAsChunkId     string
  }
  update {
    id: args.rowId
    args.validationStatus
    args.validatedBy
    args.validatedAt
    args.dedupStatus
    args.matchesEntityIndexId
    args.diffFromMatched
    args.embeddedAsChunkId
  }
}

@enabled
@description("Per Q9 event-driven refresh: increment a knowledge domain's staleSignalCount. The Planner Agent calls this when it detects degraded responses citing the domain (low-confidence citations, contradicted-by-fresh-source results, etc.). When staleSignalCount crosses a threshold (the Planner Agent's own policy; default 3), the Planner may spawn a trainSpecialist Plan with mode='refresh' rather than waiting for the cadence backstop.")
mutation knowledgeDomain mutationMarkKnowledgeDomainStale {
  args {
    domainId           string  @required
    staleSignalCount   int     @required
  }
  update {
    id: args.domainId
    args.staleSignalCount
  }
}

@enabled
@description("Per Q9 refresh path: zero out the staleSignalCount and stamp lastSeededAt to now() after a trainSpecialist Plan with mode='refresh' completes. Idempotent; safe to re-run.")
mutation knowledgeDomain mutationResetStaleAfterRefresh {
  args {
    domainId       string  @required
    lastSeededAt   string  @required
  }
  update {
    id: args.domainId
    args.lastSeededAt
    staleSignalCount: 0
  }
}

// ---- mutations/v1/knowledge/writeKnowledgeChunk.memql ----

// mutationWriteKnowledgeChunk -- the Trainer Agent's chunk-write path
// (Q3 / Q9). Backs the writeKnowledgeChunk tool the Trainer Agent calls
// during a trainSpecialist Plan. Distinct from mutationCreateDocumentChunk
// (the general chunk-write path used by the seeder / bridge / CoPresent
// ingest) only in that it hard-stamps source="trainerAgent",
// validationStatus="validated" (Trainer output ships as canonical, the
// same way seeded content does), and requires sourceRef -- the Trainer's
// invariant is that every chunk it emits cites a real consulted source.

@enabled
@description("Write a knowledge chunk distilled by the Trainer Agent during a trainSpecialist Plan. Hard-stamps source='trainerAgent' + validationStatus='validated'. sourceRef is REQUIRED (the Trainer's no-fabricated-citations invariant -- every chunk points at a real URL or named source). Lands as canonical, retrievable once embedded.")
mutation documentChunk mutationWriteKnowledgeChunk {
  args {
    chunkId      string  @required
    domainId     string  @required
    text         string  @required
    sourceRef    string  @required
    seq          int
    tokenCount   int
    sourceTopic  string
  }
  insert {
    id: args.chunkId
    args.domainId
    args.text
    args.sourceRef
    seq: coalesce(args.seq, 0)
    tokenCount: coalesce(args.tokenCount, 0)
    args.sourceTopic
    source: "trainerAgent"
    validationStatus: "validated"
    superseded: false
  }
}

// ---- mutations/v1/knowledge/markChunkSuperseded.memql ----

// mutationMarkChunkSuperseded -- the Trainer Agent's refresh-mode
// deprecation path (Q9). Backs the markChunkSuperseded tool. When a
// trainSpecialist Plan runs with mode='refresh', the Trainer reads the
// existing corpus, web-searches for updates, and flags outdated chunks
// here so retrieval stops surfacing them. Partial update via update() --
// only the supersession fields change; the chunk stays in the table for
// audit + provenance.

@enabled
@description("Flag an existing knowledge chunk as outdated. Called by the Trainer Agent's markChunkSuperseded tool during a mode='refresh' trainSpecialist Plan. Sets superseded=true + supersededAt + supersededReason; retrieval excludes superseded chunks. Partial update -- the chunk row is preserved for audit.")
mutation documentChunk mutationMarkChunkSuperseded {
  args {
    chunkId           string  @required
    supersededAt      string  @required
    supersededReason  string
  }
  update {
    id: args.chunkId
    superseded: true
    args.supersededAt
    args.supersededReason
  }
}
