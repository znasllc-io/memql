// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// ---- mutations/v1/knowledge/createDocument.memql ----

// mutationCreateDocument -- single write path for v1:knowledge:document.
// Called by the analyzer after a Plan's Tasks have produced a structured
// breakdown of an attachment.

/// Create a document chunk linked to a knowledge domain. Called by every chunk-writing integration
/// (seedDomainContent, augmentDomainGenerate, ensureKnowledgeBridge, the product UI corpus ingest).
/// source is REQUIRED and tags the chunk's provenance class -- the dev-refresh cache filter and the
/// citation registry both read it as the source of truth. Optional sourceUtteranceId /
/// sourceAgentId / sourceTopic carry chat-driven augment provenance back-pointers.
mutate documentChunk createDocumentChunk {
  args {
    chunkId            string!
    domainId           string!
    text               string!
    source             string!
    sourceRef          string
    seq                int
    tokenCount         int
    sourceUtteranceId  string
    sourceAgentId      string
    sourceTopic        string
  }
  insert {
    accept { domainId, text, source, sourceUtteranceId, sourceAgentId, sourceTopic }
    stamp {
      id: args.chunkId
      sourceRef: args.sourceRef ?? ""
      seq: args.seq ?? 0
      tokenCount: args.tokenCount ?? 0
    }
  }
}

// ---- mutations/v1/common/markKnowledgeDomainSeeded.memql ----

// mutationMarkKnowledgeDomainSeeded -- partial update that stamps
// the freshness fields (lastSeededAt + seederRecipeVersion) on a
// knowledge domain after a successful seeder run. Uses update()
// (read-merge-validate-write) so the caller doesn't have to re-pass
// every required field on the domain concept.
//
// Called by the knowledge integration's seeder right after a
// runSeederForDomain success. The training pipeline reads
// lastSeededAt + seederRecipeVersion to decide whether to re-seed
// on retrain.

// ---- mutations/v1/knowledge/updateDocumentValidation.memql ----

// mutationUpdateDocumentValidation -- transition a Document's
// validationStatus. Stamps validatedBy / validatedAt; the audit
// log entry is written separately via mutationCreateValidationEvent
// so callers can compose without coupling.

// ---- mutations/v1/knowledge/updateDocumentEmbeddingStatus.memql ----

// mutationUpdateDocumentEmbeddingStatus -- drive a Document's
// embeddingStatus none -> partial -> complete as its typed items get
// lazily embedded into documentChunk (#645). Written by the knowledge
// integration's embedDomainItems capability after it recomputes the live
// vector coverage of the Document's chunks. Partial update: only the
// embedding bookkeeping fields change; validation + content fields are
// untouched.

// ---- mutations/v1/knowledge/writeKnowledgeChunk.memql ----

// writeKnowledgeChunk -- the Trainer Agent's chunk-write path
// (Q3 / Q9). Backs the writeKnowledgeChunk tool the Trainer Agent calls
// during a trainSpecialist Plan. Distinct from createDocumentChunk
// (the general chunk-write path used by the seeder / bridge / UI-corpus
// ingest) only in that it hard-stamps source="trainerAgent",
// validationStatus="validated" (Trainer output ships as canonical, the
// same way seeded content does), and requires sourceRef -- the Trainer's
// invariant is that every chunk it emits cites a real consulted source.

/// Write a knowledge chunk distilled by the Trainer Agent during a trainSpecialist Plan.
/// Hard-stamps source='trainerAgent' + validationStatus='validated'. sourceRef is REQUIRED (the
/// Trainer's no-fabricated-citations invariant -- every chunk points at a real URL or named
/// source). Lands as canonical, retrievable once embedded.
mutate documentChunk writeKnowledgeChunk {
  args {
    chunkId      string!
    domainId     string!
    text         string!
    sourceRef    string!
    seq          int
    tokenCount   int
    sourceTopic  string
  }
  insert {
    accept { domainId, text, sourceRef, sourceTopic }
    stamp {
      id: args.chunkId
      seq: args.seq ?? 0
      tokenCount: args.tokenCount ?? 0
      source: "trainerAgent"
      validationStatus: "validated"
      superseded: false
    }
  }
}

// ---- mutations/v1/knowledge/markChunkSuperseded.memql ----

// markChunkSuperseded -- the Trainer Agent's refresh-mode
// deprecation path (Q9). Backs the markChunkSuperseded tool. When a
// trainSpecialist Plan runs with mode='refresh', the Trainer reads the
// existing corpus, web-searches for updates, and flags outdated chunks
// here so retrieval stops surfacing them. Partial update via update() --
// only the supersession fields change; the chunk stays in the table for
// audit + provenance.

/// Flag an existing knowledge chunk as outdated. Called by the Trainer Agent's markChunkSuperseded
/// tool during a mode='refresh' trainSpecialist Plan. Sets superseded=true + supersededAt +
/// supersededReason; retrieval excludes superseded chunks. Partial update -- the chunk row is
/// preserved for audit.
mutate documentChunk markChunkSuperseded {
  args {
    chunkId           string!
    supersededAt      string!
    reason            string
    supersededReason  string
  }
  update {
    id: args.chunkId
    superseded: true
    args.supersededAt
    // The Trainer Agent's prompt calls markChunkSuperseded(chunkId, reason),
    // so the natural arg name is `reason`; the concept field is
    // `supersededReason`. Accept either and land it on the concept field --
    // previously `reason` was silently dropped. (#1633)
    supersededReason: args.reason ?? args.supersededReason ?? ""
  }
}
