// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use accounts.concepts.{ account }

/// A single retrievable text chunk attached to a knowledge domain. Chunks are produced by the
/// knowledge ingestion integration (which splits source text and embeds each chunk). The embedding
/// itself lives in the node_vectors table keyed by this chunk's id, via integration.embedding.store
/// with vectorField='content'. Per Q8: text-style breakdowns of user-uploaded Documents (PDF
/// sections, markdown chunks, plain text chunks) reuse this concept rather than duplicating the
/// chunk infrastructure into a new typed concept.
@displayCard(primary="text", secondary="sourceRef", tertiary="domainId", status="validationStatus")
concept documentChunk {
  domainId    string!  @description("ID of the parent v1:knowledge:knowledgeDomain. Queries filter by this to scope retrieval to the agent's selected domains.")
  text        string!  @description("The chunk text. Kept as plain text so findSimilar can re-embed on demand and the model can render it in the system_knowledge prompt block.")
  sourceRef   string  @description("Where the chunk came from, e.g. 'opid:agents.new', 'doc:README.md#L42', 'url:https://docs.example.com/agents'. Used for citation in the UI and for idempotent re-ingestion.")
  seq         int     @default("0") @description("Order within the source (0-based). A document of N chunks has seq 0..N-1.")
  tokenCount  int     @default("0") @description("Approximate token count, rough character-length / 4 heuristic. Used for budgeting context windows when assembling the system_knowledge block.")
  documentId  string  @description("Per Q8: optional back-reference to a v1:knowledge:document row when this chunk came from a user-uploaded file rather than a seeded corpus. Null for seeded UI-corpus chunks; populated for chunks produced by the analyzer. NOTE: no `document` concept is declared anywhere in this engine tree today -- see the dead-stub headers below this concept.")
  validationStatus  enum("unvalidated", "validated", "rejected") @default("unvalidated") @description("Per Q15: validation gating mirror of v1:knowledge:document. validated = ingestible into knowledge domains; rejected = soft-deleted from retrieval. Seeded chunks default to 'validated' since they ship as canonical.")
  source  enum("llmSeeded", "augment", "crossDomainBridge", "appStructure", "fileUpload", "trainerAgent")! @description("Provenance discriminator for audit, UI grouping, and the dev-refresh cache filter. Aligned with the citation-registry source taxonomy on the agent-reply side -- one word, one meaning across the whole stack. 'llmSeeded' = baseline LLM-generated content from seedDomainContent (catalog Tier-A/B bodies, Tier-B disclaimers, Tier-C Wikipedia chunks). 'augment' = topic-focused chunks added via the chat 'Analyze for training' action; carries sourceUtteranceId + sourceAgentId + sourceTopic back-pointers. 'crossDomainBridge' = bridge content generated when an agent has 2+ domains. 'appStructure' = the product UI corpus that drives operator UI moves (cited silently). 'fileUpload' = user-uploaded document content (when wired). 'trainerAgent' = chunks distilled by the Trainer Agent's web-search + reasoning pipeline (Q3, Q9); cited with provenance back to the original web sources via sourceRef. Required: every writer must declare which class of provenance it represents.")
  sourceAgentId  string  @description("When source='augment': bare id of the v1:agents:agent whose retrieval gap surfaced this chunk. Same provenance audit purpose as sourceUtteranceId.")
  sourceTopic  string  @description("When source='augment': the narrow topic the augmentDomainContent prompt was asked to cover (e.g. 'Bronze Age Collapse and the Sea Peoples'). Useful for grouping all chunks generated from one augment action together in the Knowledge panel.")
  superseded  bool @default("false") @description("Per Q9 trainSpecialist mode='refresh': set true when the Trainer Agent marks this chunk outdated (via markChunkSuperseded). Superseded chunks are excluded from retrieval -- they stay in the table for audit / provenance but no longer surface in the system_knowledge block. The replacement chunk (if any) carries fresher content written in the same refresh run.")
  supersededAt  datetime @description("When this chunk transitioned to superseded. Set alongside superseded=true by markChunkSuperseded.")
  supersededReason  string  @description("The Trainer Agent's stated reason for marking the chunk outdated (e.g. 'superseded by 2026 figures', 'source page removed'). Surfaced in the Knowledge panel's chunk-history view.")

}

// The restructure-script section headers that used to sit here
// (spreadsheetRow, validationEvent, liveSource, liveConnector, liveSnapshot)
// named no concept declared in this file, or anywhere in dsl/ -- dead stubs
// left behind by scripts/restructure-by-construct with no body to accompany
// them. Removed rather than kept as headers to nothing; see
// documentChunk.documentId above for the related dangling
// v1:knowledge:document reference.
//
// `knowledgeDomain` was one of those headers, and it is a header no longer:
// the concept below closes that gap (epic memql#4800).

// ===========================================================================
// A CONCEPT WHOSE ROWS EXISTED BEFORE ITS DECLARATION DID
// ===========================================================================
// `v1:knowledge:knowledgeDomain` rows have been written for a long time --
// integrations/knowledge/seed.go executes `createKnowledgeDomain(...)` over
// the standard-domain catalog at boot -- while the concept was declared in NO
// .memql file anywhere in this tree. That is the same shape as the guest
// invitation gap (memql#4258): first-party Go naming constructs the engine
// cannot resolve. The visible consequence was on the client side, and the
// Training app wrote it down: a domain card is labelled by its raw domainId,
// because the domain's own payload -- name, category, tier -- had no client
// read surface at all (clients/os/src/apps/training/DomainsSection.tsx).
//
// WHAT THIS DECLARATION DOES AND DOES NOT DO. It gives the concept a schema, a
// shape and a read path, so `name` and the account tag below can be rendered.
// It deliberately does NOT declare `createKnowledgeDomain`. Declaring the write
// would silently switch the catalog seeder on for every engine-only build --
// hundreds of rows appearing at boot on clusters that have never had them --
// and that is a decision about the catalog, not about this epic's tag. The
// asymmetry is recorded rather than tidied: the read is what was asked for.
//
// THE TIER, AND THE QUESTION memql#4809 FILED RATHER THAN GUESSED AT.
//
// This concept has no row-level authorization axis, and that is a fact about
// the catalog rather than a gap in the declaration. A knowledge domain is the
// cluster's shared corpus index -- the same population for every caller, with
// no owner field and nowhere to get one, since the seeder writes these rows as
// the system. All three tiers the engine offered when this concept landed were
// wrong in the same way: `owner=` has no field to name and no writer to stamp
// one, `clusterOwner` hides the catalog from the writers the Training app is
// for, and the composite needs the owner the first one does not have.
//
// So the answer is the fourth tier plus the narrowing memql#4809 asked the
// gate to learn: `public` is the only tier that injects NO predicate, which is
// the honest shape for rows that carry no distinction -- but plain `public`
// also means "an anonymous stranger may read this", which is a much larger
// claim than this catalog's author is making. `accountId` below ties a domain
// to a CLIENT ACCOUNT, and the accounts epic gates every account read at
// admin; publishing "this deployment trained a domain for account X" to the
// internet is not a decision anybody made.
//
// `requiresIdentity` says the part `public` alone cannot: no row-level
// distinction exists here, AND this is not an invitation to the internet. It
// lands at exactly one site -- conceptDeclaresPublicTier, the single function
// deciding anonymous reach -- and changes nothing else about the tier.
//
// WHERE THE AUTHORIZATION ACTUALLY LIVES: at the SURFACE. `knowledgeDomainsAll`
// carries @requiresRank("writer") and `domainsForAccount` @requiresRank("admin"),
// each mirroring the OS app manifest floor that until now was presentation
// pretending to be a gate (D6: @requiresRank gates WHO MAY CALL; @rowAuthz
// still decides WHICH ROWS come back -- and here the answer to the second
// question is "all of them, to everyone who may ask").
//
// THIS RULING IS FOR THIS CONCEPT ONLY. The sibling `v1:knowledge:documentChunk`
// stays undeclared: it holds corpus TEXT rather than a catalog entry, it is
// per-domain scoped through documentChunk.domainId, and it has four
// client-reachable mutations where this concept has none -- so its residual is
// a WRITE question this read-side ruling does not touch.
@displayCard(primary="name", secondary="category", tertiary="description", status="active")
@rowAuthz(public, requiresIdentity)
concept knowledgeDomain {
  name                 string!  @description("The domain's human name, e.g. 'Residential real estate'. What the Training app renders on a card instead of the raw id, once rows carry it.")
  description          string   @description("What the domain covers, in a sentence. Written by the catalog seeder from the standard-domain registration.")
  category             string   @description("Catalog grouping the domain belongs to, e.g. 'personal' / 'business'. Free text rather than an enum: the catalog is product-extensible through RegisterSeedDomain, and a closed set here would refuse a pack's own category at load.")
  tier                 enum("A", "B", "C")  @description("Safety tier. Absent reads as A by convention -- @default is deliberately NOT declared, because this domain declares no create mutation (see the header) and @default is never applied on insert (memql#3038); an annotation nothing stamps is a silent no-op the conformance gate refuses. The convention lives here instead -- A = general, B = safety-relevant, C = high-stakes regulated. THE tier the disclaimer machinery actually keys on (integrations/knowledge/seed_domain_content.go): a Tier-B domain carries disclaimerChunkText as chunk 0, a Tier-C domain gets curated content or an upload-authoritative-sources placeholder. v1:agents:agentRole.tier and v1:skills:skill.tier mirror this value by convention and neither is what fires the effect -- see their own descriptions, which record that correction.")
  active               bool     @description("Whether the domain participates. Absent reads as participating, and the convention is stated rather than declared as @default for the reason `tier` records. The seeder's existence probe (domainExists) treats a missing key and true as the same answer, so a row written before this field existed reads as active.")
  predefined           bool     @description("True for a domain that ships in the standard catalog, false for one created at runtime. Lets a surface tell a catalog domain from a domain somebody made.")
  source               string   @description("Which registration wrote the row -- the standard catalog, or a pack's RegisterSeedDomain. Provenance for an operator asking where a domain came from.")
  relevantForRoles     []string  @description("Agent-role slugs this domain is offered for. Read by the role -> domain mapping at seed time; nothing at request time consults it.")
  requiredByToolSlugs  []string  @description("Tool slugs that need this domain present. A catalog-integrity input, not a runtime gate.")
  accountId            string   @description("The v1:accounts:account this domain is tagged with -- which client it was trained for (epic memql#4800, D5). A TAG, and the word is exact: it is rendered on the Training domain card and filterable there, and NOTHING ELSE READS IT. Agent routing, domain attachment, retrieval, scoring and the system_knowledge block are all deliberately unaffected -- an agent carrying a tagged domain behaves identically to one carrying an untagged one, and `domainsForAccount` (dsl/accounts/queries.memql) is the only query in the tree that mentions the field. That restraint is the decision, not an omission: routing off account-tagged domains is named in the design as follow-up work, and building half of it here would make the tag mean something nobody agreed to.")

  @relationship(type="references", as="forAccount", field="accountId", target=account, direction="outgoing")
}
