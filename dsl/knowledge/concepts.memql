// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@version("1.0.0")
@namespace("knowledge")
@visibility("bff", "cognition", "agent", "planner")
@description("A user-uploaded file (or chat-promoted segment) that's been analyzed and structured into queryable items. Container concept that owns metadata + back-references; the actual structured content lives in per-format item concepts (v1:knowledge:spreadsheetRow for tabular, v1:knowledge:imageRegion for visual, v1:common:documentChunk for text-style breakdowns of PDFs / markdown / plain text). Per the v1 brainstorm Q8 hybrid model: one Document container query gives the Knowledge page its listing, typed per-format item queries give analytic surfaces (e.g. spreadsheet row column-filters) without JSON-path indirection.")
concept document {
  attachmentId      string  @required @description("Back-reference to v1:common:attachment. The bytes live in GCS via the attachment row; this Document carries the analyzed projection.")
  planId            string  @required @description("Back-reference to the v1:planner:plan that produced this analysis. Used by the Tasks page expand-drawer + by re-analysis triggers.")
  spaceId           string  @required @description("Workspace partition this Document belongs to; redundant with attachment.spaceId but stored explicitly for cheap per-space queries.")
  fileName          string  @required @description("Original filename, copied from the attachment for display.")
  mimeType          string  @required @description("MIME type, copied from the attachment.")
  format            enum("spreadsheet", "pdf", "image", "text", "markdown", "conversation") @required @description("High-level classification. Picks which item concept stores the breakdown: spreadsheet -> spreadsheetRow; pdf|text|markdown -> documentChunk; image -> imageRegion; conversation -> documentChunk (for chat-promoted segments).")
  itemKind          enum("spreadsheetRow", "documentChunk", "imageRegion") @description("Which item concept this Document's per-row / per-section / per-region payloads land in. Set by the analyzer after extraction.")
  itemCount         int     @default("0") @description("Total items extracted (spreadsheet rows / PDF sections / image regions / text chunks). For very large documents the analyzer may set this to the row total even when only a sample has been materialized; see Q8's two-pass scale safeguard.")
  summary           string  @description("LLM-generated 2-3 sentence summary of the Document. Surfaced on the plan.completed card body and on the Knowledge page detail view.")
  domainHints       []string  @description("Knowledge domain ids the analyzer thinks this Document belongs to. Used to seed the attach-to-domain picker on the validation card.")
  attachedDomains   []string  @description("Knowledge domain ids the user has attached this Document to. Items propagate to those domains for retrieval.")
  validationStatus  enum("unvalidated", "validated", "rejected", "partiallyValidated", "superseded") @required @default("unvalidated") @description("Document-level validation rollup. Per-item validation can override individual items; computed by cascadeDocumentValidationRollup. validated = ingestible into knowledge domains; rejected = soft-deleted; partiallyValidated = some items validated, some not; superseded = a newer Document replaced this one.")
  validatedBy       string  @description("v1:identity:user.id who clicked Validate on the Document card. Null when unvalidated / system-validated.")
  validatedAt       datetime @description("When validation last transitioned. Refreshed on rollup recompute.")
  supersedesDocumentId    string  @description("Set at upload time when the user picked 'Replace' on the supersession prompt. Points to the predecessor Document; cascadeSupersessionOnValidation flips that predecessor to 'superseded' when this Document is validated.")
  supersededByDocumentId  string  @description("Set on this Document when it's been superseded by a newer version. Points to the successor Document. Agents skip superseded Documents during retrieval.")
  supersededAt      datetime @description("When this Document transitioned to superseded.")
  embeddingStatus   enum("none", "partial", "complete") @required @default("none") @description("Whether typed items in this Document have been lazily embedded into documentChunk for semantic retrieval (Q14). Bumps to 'complete' after the embedDomainItems Plan finishes.")
  embeddedItemCount int     @default("0") @description("Count of items that have been embedded. itemCount - embeddedItemCount = remaining work for the embedDomainItems Plan.")
  uploadedBy        string  @required @description("v1:identity:user.id of the uploader. Owner-only operations (delete, re-validate, attach) check against this.")

  @relationship(type="parent", field="attachmentId", target="v1:common:attachment", direction="outgoing")
  @relationship(type="parent", field="planId", target="v1:planner:plan", direction="outgoing")
}

@version("1.0.0")
@namespace("common")
@visibility("bff", "cognition", "agent", "planner")
@description("A single retrievable text chunk attached to a knowledge domain. Chunks are produced by the knowledge ingestion integration (which splits source text and embeds each chunk). The embedding itself lives in the node_vectors table keyed by this chunk's id, via integration.embedding.store with vectorField='content'. Per Q8: text-style breakdowns of user-uploaded Documents (PDF sections, markdown chunks, plain text chunks) reuse this concept rather than duplicating the chunk infrastructure into a new typed concept.")
concept documentChunk {
  domainId    string  @required  @description("ID of the parent v1:common:knowledgeDomain. Queries filter by this to scope retrieval to the agent's selected domains.")
  text        string  @required  @description("The chunk text. Kept as plain text so findSimilar can re-embed on demand and the model can render it in the system_knowledge prompt block.")
  sourceRef   string  @description("Where the chunk came from, e.g. 'opid:agents.new', 'doc:README.md#L42', 'url:https://docs.copresent.app/agents'. Used for citation in the UI and for idempotent re-ingestion.")
  seq         int     @default("0") @description("Order within the source (0-based). A document of N chunks has seq 0..N-1.")
  tokenCount  int     @default("0") @description("Approximate token count, rough character-length / 4 heuristic. Used for budgeting context windows when assembling the system_knowledge block.")
  documentId  string  @description("Per Q8: optional back-reference to v1:knowledge:document when this chunk came from a user-uploaded file rather than a seeded corpus. Null for seeded copresent_ui chunks; populated for chunks produced by the analyzer.")
  validationStatus  enum("unvalidated", "validated", "rejected") @default("unvalidated") @description("Per Q15: validation gating mirror of v1:knowledge:document. validated = ingestible into knowledge domains; rejected = soft-deleted from retrieval. Seeded chunks default to 'validated' since they ship as canonical.")
  source  enum("llmSeeded", "augment", "crossDomainBridge", "appStructure", "fileUpload") @required @description("Provenance discriminator for audit, UI grouping, and the dev-refresh cache filter. Aligned with the citation-registry source taxonomy on the agent-reply side -- one word, one meaning across the whole stack. 'llmSeeded' = baseline LLM-generated content from seedDomainContent (catalog Tier-A/B bodies, Tier-B disclaimers, Tier-C Wikipedia chunks). 'augment' = topic-focused chunks added via the chat 'Analyze for training' action; carries sourceUtteranceId + sourceAgentId + sourceTopic back-pointers. 'crossDomainBridge' = bridge content generated when an agent has 2+ domains. 'appStructure' = CoPresent UI corpus that drives operator UI moves (cited silently). 'fileUpload' = user-uploaded document content (when wired). Required: every writer must declare which class of provenance it represents.")
  sourceUtteranceId  string  @description("When source='augment': bare id of the v1:cognition:utterance that triggered the augment action. Lets the Knowledge panel show 'Added from chat with <agent> on <date>' provenance and lets a future cleanup audit reach back to the conversation.")
  sourceAgentId  string  @description("When source='augment': bare id of the v1:agents:agent whose retrieval gap surfaced this chunk. Same provenance audit purpose as sourceUtteranceId.")
  sourceTopic  string  @description("When source='augment': the narrow topic the augmentDomainContent prompt was asked to cover (e.g. 'Bronze Age Collapse and the Sea Peoples'). Useful for grouping all chunks generated from one augment action together in the Knowledge panel.")

  @relationship(type="parent", field="domainId", target="v1:common:knowledgeDomain", direction="outgoing")
}

@version("1.0.0")
@namespace("knowledge")
@visibility("bff", "cognition", "agent", "planner")
@description("Per-knowledge-domain entity schema declaration. Specifies what 'an entity' looks like in a domain (entityKind), which fields uniquely identify it (keyFields), and which fields are descriptive (displayFields). Powers cross-file dedup (Q17): when a Document is attached to a domain, the analyzer hashes each item's key field values and looks up the entityIndex to detect duplicates. Per Q17 Option D: the schema is INFERRED by an entity-inference Plan triggered on the SECOND validated Document into a domain (the first Document seeds the inference); the user confirms the proposal once and the schema locks in. Subsequent Documents use it for dedup automatically.")
concept domainEntitySchema {
  domainId          string  @required @description("v1:common:knowledgeDomain.id this schema describes.")
  entityKind        string  @required @description("Human-readable entity type name, e.g. 'Employee', 'Customer', 'Project'. A domain can hold multiple entity kinds (HR Records: Employee + Department + Role); each gets its own schema row.")
  keyFields         []string @required @description("Field names whose values combine into the entity's unique key. Hashed via sha256 to produce entityIndex.keyHash. Examples: ['email', 'employee_id'] for Employee.")
  displayFields     []string @description("Optional descriptive fields for UI surfaces (entity preview, side-by-side diff). Not used for dedup.")
  inferredFromDocumentId  string  @description("Provenance: which Document seeded the inference. Audit-only.")
  inferredFromTaskId      string  @description("Provenance: which entity-inference Plan ran the inference.")
  confirmedBy             string  @description("v1:identity:user.id who confirmed the proposed schema. Set when the user clicks Confirm on the domain-setup card.")
  confirmedAt             datetime @description("When the user confirmed the schema.")
  active                  bool @default("true") @description("Soft-delete flag. Schema changes after lock-in trigger a re-index of historical items; setting active=false skips dedup entirely for the domain.")

  @relationship(type="parent", field="domainId", target="v1:common:knowledgeDomain", direction="outgoing")
}

@version("1.0.0")
@namespace("knowledge")
@visibility("bff", "cognition", "agent", "planner")
@description("The cross-file dedup lookup table. One row per validated entity in a domain (per entityKind), keyed by sha256(normalized key field values). Populated when an item is validated as 'new'; queried during analysis-time / attach-time dedup to detect when an incoming row matches an existing canonical entity. Per Q17/Q26: this is the load-bearing piece of cross-file dedup; without it the HR example ('all of these employees already exist') is unfulfillable.")
concept entityIndex {
  domainId        string  @required @description("v1:common:knowledgeDomain.id this entity belongs to.")
  entityKind      string  @required @description("Matches v1:knowledge:domainEntitySchema.entityKind. Lets a single domain hold multiple entity kinds without their indexes colliding.")
  keyHash         string  @required @description("sha256 of normalized key field values (DomainEntitySchema.keyFields[].toLower().trim() joined by ':'). The dedup lookup primary key. Two indexes with the same (domainId, entityKind, keyHash) are conceptually the same entity.")
  sourceDocumentId  string  @required @description("The Document that contributed this entity. When the source Document is rejected / superseded the corresponding index entry should be cleaned up.")
  sourceItemId      string  @required @description("Specific item (SpreadsheetRow / documentChunk / ImageRegion id) that contributed this entity.")
  validatedAt       datetime @required @description("When the user validated the source item, marking the entity canonical.")
  forceAdded        bool @default("false") @description("Set true when the user picked 'Add anyway (force)' on the dedup card despite a key-hash collision. Future dedup checks against the same hash surface ALL force-added entries side by side and let the user pick.")
  dedupOverrideNote  string @description("Optional note from the user explaining why a force-added entry is genuinely a separate entity ('two different people share an email used as a key field, separate them').")
}

@version("1.0.0")
@namespace("knowledge")
@visibility("bff", "cognition", "agent", "planner")
@description("One detected region inside an image Document. Carries a bounding box, a vision-model-generated caption, and (lazily) a visual embedding. Per Q8: images get their own typed concept because bbox + caption + embedding doesn't fit the text-as-content shape of v1:common:documentChunk.")
concept imageRegion {
  documentId        string  @required @description("Back-reference to the parent v1:knowledge:document (format='image').")
  regionSeq         int     @required @description("0-based region index. Whole-image regions get seq 0; sub-regions follow.")
  bbox              object  @required @description("Bounding box: {x: int, y: int, width: int, height: int} in source-image pixel coordinates. Whole-image is the image's own dimensions.")
  caption           string  @required @description("Vision-model-generated description of what's in this region. Used as the embedding text for semantic retrieval -- 'find image regions about quarterly revenue charts' embeds the caption, not the pixels.")
  domainHints       []string  @description("Knowledge domain ids the analyzer thinks this region belongs to.")
  validationStatus  enum("unvalidated", "validated", "rejected") @required @default("unvalidated") @description("Per-region validation, same model as SpreadsheetRow.")
  validatedBy       string  @description("Validator user id.")
  validatedAt       datetime
  dedupStatus       enum("new", "duplicate", "update", "na") @required @default("na") @description("Same dedup model as SpreadsheetRow; v0.x rarely populates non-na for images since images don't usually have entity schemas, but the field is here for symmetry.")
  matchesEntityIndexId  string
  embeddedAsChunkId string  @description("Once lazy-embedded into v1:common:documentChunk (caption text), this points to the chunk id.")

  @relationship(type="parent", field="documentId", target="v1:knowledge:document", direction="outgoing")
}

@version("1.0.0")
@namespace("common")
@visibility("bff", "cognition", "agent", "planner")
@description("Synthetic 'bridge' that combines multiple knowledge domains for a specific role. Generated per-agent at training time when an agent has 2+ knowledge domains attached: the bridge captures cross-domain connections specific to that combination + role (e.g. how a customer_service agent applies tax_law + accounting differently from a legal_compliance agent applying the same two domains). Hash-keyed by (roleSlug, sortedDomainIds) so identical combinations across agents share the same bridge corpus -- pay for the LLM call once per (role, combo) pair, reuse for all subsequent agents that match. Per docs/planning/knowledge-seeder.md (v2 bridge chunks).")
concept knowledgeBridge {
  bridgeId            string  @required @description("Stable id derived from sha256(roleSlug + ':' + sortedDomainIds.join(',')); shared across agents that have the same role + domain set.")
  roleSlug            string  @required @description("The role this bridge specialises framing for. customer_service x {accounting, tax_law} is a different bridge from accounting_finance x {accounting, tax_law}.")
  domainIds           []string @required @description("Sorted list of domain ids this bridge spans. Reading this back gives you the combination key.")
  combinationKey      string  @required @description("Human-readable join of domainIds for at-a-glance debugging in logs / DB. Same content as sorted(domainIds).join(',').")
  chunkCount          int     @description("Number of chunks generated under this bridge id. Cached for status displays.")
  recipeVersion       string  @description("Seeder recipe version used to generate this bridge; bumping invalidates it on next train.")
  generatedAt         datetime @description("When the bridge was first generated. Read by any future bridge-freshness check.")
  active              bool    @default("true") @description("Soft-delete flag. False = bridge no longer attaches to new agents but historical agents that reference it still resolve.")
}

// ---- concepts/v1/common/knowledgeDomain/concept.memql ----

@version("1.0.0")
@namespace("common")
@visibility("bff", "cognition", "agent", "planner")
@description("A knowledge domain that agents can specialise in. First-class replacement for the hardcoded domain list that used to live in the frontend. Each domain can have document chunks ingested into it for retrieval-augmented generation, and can declare which tool slugs REQUIRE it (so the UI auto-adds it when the user picks a tool like copresent_control). Per Q21: user-created domains carry a scope (workspace = visible to all in partition; private = visible only to owner) plus an ownerId; seeded domains stay workspace-scoped with ownerId null (system-owned). Per docs/planning/knowledge-seeder.md: seeded domains carry a tier (A=auto-seed, B=auto-seed with disclaimer, C=high-stakes, do-not-auto-seed) that drives the seeder pipeline's content strategy.")
concept knowledgeDomain {
  name         string  @required  @description("Display name, e.g. 'CoPresent UI' or 'Business Administration'.")
  description  string  @description("One-line description of what this domain covers.")
  category     enum("core", "business", "technical", "product", "internal", "science", "humanities", "creative", "specialized", "hobby")  @default("business") @description("Coarse grouping used by the UI picker. core/business/technical/product/internal cover the original business-and-app catalog; science/humanities/creative/specialized/hobby are the catalog-expansion buckets (physics, history, music, law, sports, etc.).")
  relevantForRoles  []string  @description("Agent role slugs (from AGENT_ROLES) that see this domain in their picker. Empty means 'all roles'.")
  requiredByToolSlugs  []string  @description("Stored-tool slugs (as in capabilities.tools, e.g. 'uiClick' or 'copresent_control') that REQUIRE this domain. The agent builder unions these into the agent's selected domains at save time; the delegateTakeover handler reads them to decide which domains to retrieve from.")
  active       bool    @default("true") @description("Whether this domain is selectable in the agent builder. Soft-delete via active=false instead of deleting the row so historical agents that reference it still resolve.")
  scope        enum("workspace", "private") @default("workspace") @description("Per Q21: 'workspace' = visible to everyone in the partition (default; matches seeded domains); 'private' = visible only to ownerId. Retrieval queries auto-filter on this.")
  ownerId      string  @description("v1:identity:user.id of the creator. Required for scope='private' (used as visibility filter); informational for scope='workspace'. Null for seeded domains (system-owned).")
  tier         enum("A", "B", "C")  @default("A") @description("Seeder tier per docs/planning/knowledge-seeder.md. A = general knowledge, LLM-seeded normally. B = safety-relevant, LLM-seeded with a 'general info, not professional advice' disclaimer chunk prepended. C = high-stakes specialist (clinical medicine, surgical technique, securities advice, legal practice); seeder fetches Wikipedia content for the configured articles, or falls back to a 'upload your own authoritative content' placeholder if no Wikipedia mapping exists. Set automatically at seed time from the StandardDomain.Tier field; user-created domains default to A.")
  lastSeededAt        datetime  @description("When the seeder last successfully ran for this domain. Read by the training pipeline's freshness check -- if the domain is older than the freshness window AND has been seeded before, training re-seeds it. Null = never seeded.")
  seederRecipeVersion string    @description("The recipe version (e.g. 'v1') used the last time this domain was seeded. Bumping the global recipe version invalidates all prior seeds; training detects this on retrain and triggers a re-seed.")
  source              enum("llmSeeded", "crossDomainBridge", "fileUpload", "conversationCapture", "webIngest", "appStructure") @default("llmSeeded") @description("Where this domain's chunks come from. Drives the citation label format the agent uses when it cites a chunk in a reply (Go-side citation registry in integrations/agent/replier.go). 'llmSeeded' = generated by the seedDomainContent prompt (default for the catalog). 'crossDomainBridge' = generated by seedDomainBridge. 'fileUpload' = chunks extracted from user-uploaded files. 'conversationCapture' = chunks captured from a chat. 'webIngest' = chunks fetched from a URL. 'appStructure' = the copresent_ui docs that drive operator-mode UI moves -- agents do NOT cite these audibly.")
  refreshCadenceDays  int       @default("90") @description("How often (in days) the domain should be re-seeded by the freshness check. Picker constraint on the create/edit modal: 30 / 90 / 120. Read by the training pipeline's domainNeedsRefresh check -- if lastSeededAt is older than refreshCadenceDays days, retrain re-seeds. Default 90 matches the prior hardcoded freshnessWindow and is a sensible LLM-content drift cadence.")
  predefined          bool      @default("false") @description("True for domains that ship in the Go-side catalog (integrations/knowledge/seed.go) and are re-seeded on every memQL startup. The frontend renders these as LOCKED in the Knowledge panel: name / description / category / scope / source are read-only, only refreshCadenceDays is editable, the row is not delete-able, and file upload / drop is disabled (predefined domains carry only LLM-seeded chunks, not user-uploaded content). User-created domains via the '+ New' button default to false and remain fully editable.")
}

// ---- concepts/v1/knowledge/spreadsheetRow/concept.memql ----

@version("1.0.0")
@namespace("knowledge")
@visibility("bff", "cognition", "agent", "planner")
@description("One row extracted from a spreadsheet Document. Typed (not polymorphic-via-data) so analytic queries can filter on data.<columnName>=<value> as native column predicates rather than JSON-path indirection. Per the v1 brainstorm Q8: text-style breakdowns reuse v1:common:documentChunk; spreadsheet rows and image regions get their own concepts because their structure can't fit a free-text chunk shape.")
concept spreadsheetRow {
  documentId          string  @required @description("Back-reference to the parent v1:knowledge:document.")
  rowSeq              int     @required @description("0-based row index within the source spreadsheet, header excluded.")
  data                object  @required @description("Column-name -> value map. The Document.metadata.columnSchema (set by the analyzer at extraction time) is the authoritative column list; rows whose data omits a known column carry the column with value null.")
  domainHints         []string  @description("Knowledge domain ids the analyzer thinks this row belongs to. Used by attach-time dedup + filtering on the per-item drawer.")
  validationStatus    enum("unvalidated", "validated", "rejected") @required @default("unvalidated") @description("Per-row validation. Defaults to inheriting the Document's status via cascadeValidationToItems; user can override per-row in the per-item drawer (Q15 hybrid granularity).")
  validatedBy         string  @description("v1:identity:user.id who validated/rejected this specific row.")
  validatedAt         datetime @description("Per-row validation timestamp.")
  dedupStatus         enum("new", "duplicate", "update", "na") @required @default("na") @description("Set during attach-time dedup against the target domain's entityIndex (Q17/Q26). new = no key match; duplicate = key match + all values identical; update = key match + values differ; na = no entity schema applies.")
  matchesEntityIndexId  string  @description("Set when dedupStatus in (duplicate, update); points to the v1:knowledge:entityIndex row this row matches. Lets the per-item drawer side-by-side the existing entry vs the incoming one for review.")
  diffFromMatched     object  @description("For dedupStatus='update': map of column-name -> {old, new} for fields that differ from the matched entity. Drives the side-by-side diff view.")
  embeddedAsChunkId   string  @description("Once lazy-embedded into v1:common:documentChunk for semantic retrieval, this points to the embedded chunk's id. Lets retrieval avoid double-counting structured + embedded representations of the same row.")

  @relationship(type="parent", field="documentId", target="v1:knowledge:document", direction="outgoing")
}

// ---- concepts/v1/knowledge/validationEvent/concept.memql ----

@version("1.0.0")
@namespace("knowledge")
@visibility("bff", "cognition", "agent", "planner")
@description("Append-only audit log for every validation status transition on any data-bearing concept (Document, SpreadsheetRow, ImageRegion, documentChunk). Powers the validation history view on Document detail and gives auditing the provenance trail it needs ('who validated this row two months ago when we were ramping up; do they still vouch for it'). Per Q15: denormalized validationStatus on the data concept gives fast queries; this event log gives history. Two writes per validation action; cheap.")
concept validationEvent {
  targetConceptType  string  @required @description("Fully-qualified target concept name, e.g. 'v1:knowledge:document' or 'v1:knowledge:spreadsheetRow'. Lets the audit query distinguish per-Document validations from per-row.")
  targetId           string  @required @description("Id of the row that transitioned. Pair with targetConceptType to dereference.")
  fromStatus         string  @required @description("Previous validationStatus value.")
  toStatus           string  @required @description("New validationStatus value.")
  actorUserId        string  @description("v1:identity:user.id who triggered the transition. Null for system-driven cascades (e.g. supersession purge).")
  reason             enum("user", "cascade", "supersession", "rollup", "system") @required @default("user") @description("Why the transition fired. user = explicit click in the UI; cascade = parent Document validation propagated; supersession = a newer Document took over; rollup = item changes recomputed the Document rollup; system = automation or admin-driven.")
  note               string  @description("Optional freeform note from the user (e.g. why they rejected an item). Surfaced in the audit history view.")
}
