// automations.memql
//
// The two triggers of epic C's wiring paragraph: one on a session subrun
// reaching `succeeded`, and one schedule over the corpus.
//
// Neither activates anything. A learned procedure is persisted as a validated
// bundle whose construct stays a candidate on the trust ladder; promotion is a
// person's, and epic D owns it.

/// Mine only completed recordings. The owner travels with the event; the handler borrows that
/// one owner's authority and rechecks the persisted run before reading their corpus.
@trigger(event="node.updated", concept="v1:work:run")
@filter(row => row.status == "succeeded" && row.ownerUserId != "" && row.goalSignature != "")
automation learnFromSucceededRun {
  args {
    id           any
    ownerUserId  any
  }

  learned := builtin procedureLearnFromRun(runId: args.id ?? "", ownerUserId: args.ownerUserId ?? "")
}

/// Every six hours: mine the second corpus level, where an automation invocation is a symbol like
/// any action, so a repeated sequence of automations becomes a higher automation by the same
/// compression rule (design D24). It runs per owner; the sweep reads no rows of its own and the
/// builtin refuses a blank ownerUserId, because a read with no actor returns zero rows and no
/// error -- which would look exactly like a cluster that has learned everything there is.
@trigger(schedule="0 0 */6 * * *")
automation mineProcedureCorpusAcrossAutomations {
  args {
    ownerUserId  any
  }

  mined := builtin procedureMineCorpus(ownerUserId: args.ownerUserId ?? "", level: 2)
}
