// Agent-facing telephony tools. Exposed to the realtime voice agent through
// the existing tool bridge; assigning them to an agent is owner config (the
// agent needs the telephony skill). Calls attach to a partition-scoped room,
// never a product space (Amendment A).
//
// These tools were authored with snake_case names (place_call, ...) that
// FAILED tool-registry validation (names must be camelCase), so they never
// actually registered -- surfaced by memql#2356 once the loader's register
// failures moved Debug->Warn. Renamed to camelCase here so they load cleanly
// (the names now also match the telephony*Call builtins + the
// integration.telephony.* capabilities they resolve through, all of which
// are implemented). `@mcp` was dropped at the same time: these are LIVE
// outbound-phone-call tools that were never part of the curated external MCP
// connector surface (TestMCPCuratedToolSurface, #1596/#1597), so letting them
// register must not silently add phone-calling to the connector as a side
// effect of a lint fix. Re-add `@mcp` -- and add them to that curated list --
// only as a deliberate, reviewed connector-exposure decision.

@description("Place an outbound phone call to a number. The callee is bridged into the room so you can talk to them. Optionally dial DTMF digits after connect for IVR menus.")
@handler(type="function", name="telephonyPlaceCall")
@executionTime("slow")
tool placeCall {
  to           string! @description("The phone number to call, in E.164 (e.g. +14155550100)")
  from         string! @description("The caller-ID phone number to present, in E.164")
  partitionId  string! @description("The tenant partition the call belongs to")
  dtmf         string  @description("Optional digits to dial after the call connects")
}

@description("Hang up / end an active phone call.")
@handler(type="function", name="telephonyEndCall")
@executionTime("fast")
tool endCall {
  room      string! @description("The call's room")
  identity  string! @description("The call's SIP participant identity")
}

@description("Transfer an active phone call to another phone number.")
@handler(type="function", name="telephonyTransferCall")
@executionTime("fast")
tool transferCall {
  room      string!
  identity  string!
  to        string! @description("The phone number to transfer to, in E.164")
}

@description("Send DTMF tones (digits) to an active call to navigate phone menus / IVRs.")
@handler(type="function", name="telephonySendDtmf")
@executionTime("fast")
tool sendDtmf {
  room      string!
  identity  string!
  digits    string! @description("The digits to send, e.g. '1' or '0#'")
}
