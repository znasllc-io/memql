// Row-projection shapes for the telephony concepts. Used by the telephony
// queries and by the cockpit number/call views.

@row
@description("Full DID projection: address, carrier, the bound partition (Amendment A), purpose/status, origination class, and cost/lifecycle.")
shape number numberFull {
  row.id
  e164
  carrier
  partitionId
  purpose
  status
  providerId
  numberType
  monthlyCost
  purchasedAt
  row.createdAt
}

@row
@description("Full trunk projection: carrier, direction, LiveKit trunk id, SIP edge, secret reference (never the secret), and status.")
shape trunk trunkFull {
  row.id
  carrier
  direction
  name
  livekitTrunkId
  sipEdgeUri
  secretRef
  status
  row.createdAt
}

@row
@description("Full call-record projection for billing + observability: direction, endpoints, the bound partition + room (Amendment A), carrier, timing, duration, disposition, and cost attribution.")
shape call callFull {
  row.id
  direction
  fromE164
  toE164
  partitionId
  room
  carrier
  providerCallId
  agentId
  startedAt
  endedAt
  durationSeconds
  disposition
  costEstimate
  row.createdAt
}

@row
@description("Consent / opt-out projection for an external number.")
shape consent consentFull {
  row.id
  phoneNumber
  partitionId
  status
  reason
  source
  row.createdAt
}
