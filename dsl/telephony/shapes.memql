// Row-projection shapes for the telephony concepts. Used by the telephony
// queries and by the cockpit number/call views.

use telephony.concepts.{ number, trunk, call }

@row
@description("Full DID projection: address, carrier, the bound partition (Amendment A), purpose/status, origination class, and cost/lifecycle.")
shape number numberFull {
  row.id
  payload.e164
  payload.carrier
  payload.partitionId
  payload.purpose
  payload.status
  payload.providerId
  payload.numberType
  payload.monthlyCost
  payload.purchasedAt
  row.createdAt
}

@row
@description("Full trunk projection: carrier, direction, LiveKit trunk id, SIP edge, secret reference (never the secret), and status.")
shape trunk trunkFull {
  row.id
  payload.carrier
  payload.direction
  payload.name
  payload.livekitTrunkId
  payload.sipEdgeUri
  payload.secretRef
  payload.status
  row.createdAt
}

@row
@description("Full call-record projection for billing + observability: direction, endpoints, the bound partition + room (Amendment A), carrier, timing, duration, disposition, and cost attribution.")
shape call callFull {
  row.id
  payload.direction
  payload.fromE164
  payload.toE164
  payload.partitionId
  payload.room
  payload.carrier
  payload.providerCallId
  payload.agentId
  payload.startedAt
  payload.endedAt
  payload.durationSeconds
  payload.disposition
  payload.costEstimate
  row.createdAt
}
