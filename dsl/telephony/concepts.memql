// Telephony data model -- numbers, trunks, and calls as first-class,
// queryable, append-only time-series data. Powers DID routing, billing, and
// call observability.
//
// Telephony is CORE and product-agnostic: every record binds to a generic
// `partitionId` (the canonical tenant scope, memql.PartitionScope), NEVER a
// CoPresent space (Amendment A). A product maps its own scope onto a
// partition in its pack; the telephony core only ever sees partitionId.

@version("1.0.0")
@namespace("telephony")
@description("A provisioned PSTN phone number (DID). Bound to a partition; inbound calls to this DID route to a partition-scoped room. Carrier identifiers are opaque (providerId). Compliance state (E911, consent) is layered by the compliance slice.")
concept number {
  e164          string  @required @description("Canonical +<countrycode><number> address, e.g. '+14155550100'.")
  carrier       string  @required @description("Owning carrier name ('telnyx', ...).")
  partitionId   string  @required @description("Canonical tenant scope this DID belongs to. Inbound calls route to a room scoped by this partition. NEVER a CoPresent spaceId (Amendment A).")
  purpose       enum("inbound", "outbound", "both")  @default("both") @description("How the DID is used.")
  status        enum("active", "releasing", "released")  @default("active") @description("Lifecycle state.")
  providerId    string  @description("Carrier's opaque identifier for the number (the value BuyNumber consumes / ReleaseNumber resolves).")
  numberType    enum("local", "tollfree", "mobile")  @default("local") @description("Origination class; drives per-minute inbound cost.")
  monthlyCost   float   @description("Recurring per-number cost in USD, when the carrier reports it.")
  purchasedAt   datetime  @description("When the DID was purchased.")
}

@version("1.0.0")
@namespace("telephony")
@description("A LiveKit SIP trunk configuration record (inbound and/or outbound) for a carrier. Holds the LiveKit trunk id and a reference to externally-stored credentials -- never the secret values themselves (those live in external-secrets).")
concept trunk {
  carrier        string  @required @description("Carrier this trunk fronts ('telnyx', ...).")
  direction      enum("inbound", "outbound", "both")  @required @description("Call directions this trunk serves.")
  name           string  @description("Human-readable trunk name.")
  livekitTrunkId string  @description("The id LiveKit SIP assigned to this trunk (SIPInboundTrunkInfo / SIPOutboundTrunkInfo).")
  sipEdgeUri     string  @description("SIP signaling target the carrier reaches (e.g. 'sip:edge.example.com:5061;transport=tls').")
  secretRef      string  @description("Reference to the external-secrets entry holding trunk credentials. NEVER the secret value.")
  status         enum("active", "disabled")  @default("active") @description("Whether the trunk is in service.")
}

@version("1.0.0")
@namespace("telephony")
@description("An append-only PSTN call record: one row per call, written on connect and updated on disconnect. Powers billing, observability, and per-call cost attribution. Bound to a partition + a partition-scoped room (Amendment A).")
concept call {
  direction       enum("inbound", "outbound")  @required @description("Call direction.")
  fromE164        string  @required @description("Calling party E.164.")
  toE164          string  @required @description("Called party E.164.")
  partitionId     string  @required @description("Canonical tenant scope for the call. NEVER a CoPresent spaceId (Amendment A).")
  room            string  @required @description("Partition-scoped LiveKit room the call is bridged into.")
  carrier         string  @description("Carrier that carried the call.")
  providerCallId  string  @description("Carrier / LiveKit SIP participant or call id, for cross-referencing carrier CDRs.")
  agentId         string  @description("Identity of the voice agent that handled the call, when known.")
  startedAt       datetime  @description("Call connect time.")
  endedAt         datetime  @description("Call disconnect time.")
  durationSeconds int     @default("0") @description("Billable duration in seconds.")
  disposition     enum("in_progress", "completed", "no_answer", "busy", "failed", "canceled")  @default("in_progress") @description("Call outcome.")
  costEstimate    float   @default("0") @description("Estimated total cost in USD (carrier + model audio), for per-call attribution.")
}
