// Telephony data model -- numbers, trunks, and calls as first-class,
// queryable, append-only time-series data. Powers DID routing, billing, and
// call observability.
//
// Telephony is CORE and product-agnostic: every record binds to a generic
// `partitionId` (the canonical tenant scope, memql.PartitionScope), NEVER a
// product-level space (Amendment A). A product maps its own scope onto a
// partition in its pack; the telephony core only ever sees partitionId.

/// A provisioned PSTN phone number (DID). Bound to a partition; inbound calls to this DID route to
/// a partition-scoped room. Carrier identifiers are opaque (providerId). Compliance state (E911,
/// consent) is layered by the compliance slice.
concept number {
  e164          string! @description("Canonical +<countrycode><number> address, e.g. '+14155550100'.")
  carrier       string! @description("Owning carrier name ('telnyx', ...).")
  partitionId   string! @description("Canonical tenant scope this DID belongs to. Inbound calls route to a room scoped by this partition. NEVER a product-layer partitionId (Amendment A).")
  purpose       enum("inbound", "outbound", "both")  @default("both") @description("How the DID is used.")
  status        enum("active", "releasing", "released")  @default("active") @description("Lifecycle state.")
  providerId    string  @description("Carrier's opaque identifier for the number (the value BuyNumber consumes / ReleaseNumber resolves).")
  numberType    enum("local", "tollfree", "mobile")  @default("local") @description("Origination class; drives per-minute inbound cost.")
  monthlyCost   float   @description("Recurring per-number cost in USD, when the carrier reports it.")
  purchasedAt   datetime  @description("When the DID was purchased.")
  e911Registered  bool  @default("false") @description("Whether an E911 emergency address is registered for this DID. Compliance gate before the DID goes live (memql#1915).")
  e911AddressId   string  @description("Carrier reference for the registered E911 address.")
  callerIdVerified bool @default("false") @description("Whether this DID is verified for outbound caller-ID presentation (STIR/SHAKEN attestation is carrier-side; this flags our own verified ownership).")
}

/// A LiveKit SIP trunk configuration record (inbound and/or outbound) for a carrier. Holds the
/// LiveKit trunk id and a reference to externally-stored credentials -- never the secret values
/// themselves (those live in external-secrets).
concept trunk {
  carrier        string! @description("Carrier this trunk fronts ('telnyx', ...).")
  direction      enum("inbound", "outbound", "both")! @description("Call directions this trunk serves.")
  name           string  @description("Human-readable trunk name.")
  livekitTrunkId string  @description("The id LiveKit SIP assigned to this trunk (SIPInboundTrunkInfo / SIPOutboundTrunkInfo).")
  sipEdgeUri     string  @description("SIP signaling target the carrier reaches (e.g. 'sip:edge.example.com:5061;transport=tls').")
  secretRef      string  @description("Reference to the external-secrets entry holding trunk credentials. NEVER the secret value.")
  status         enum("active", "disabled")  @default("active") @description("Whether the trunk is in service.")
}

/// An append-only PSTN call record: one row per call, written on connect and updated on disconnect.
/// Powers billing, observability, and per-call cost attribution. Bound to a partition + a
/// partition-scoped room (Amendment A).
@rowAuthz(clusterOwner)
concept call {
  direction       enum("inbound", "outbound")! @description("Call direction.")
  fromE164        string! @description("Calling party E.164.")
  toE164          string! @description("Called party E.164.")
  partitionId     string! @description("Canonical tenant scope for the call. NEVER a product-layer partitionId (Amendment A).")
  room            string! @description("Partition-scoped LiveKit room the call is bridged into.")
  carrier         string  @description("Carrier that carried the call.")
  providerCallId  string  @description("Carrier / LiveKit SIP participant or call id, for cross-referencing carrier CDRs.")
  agentId         string  @description("Identity of the voice agent that handled the call, when known.")
  startedAt       datetime  @description("Call connect time.")
  endedAt         datetime  @description("Call disconnect time.")
  durationSeconds int     @default("0") @description("Billable duration in seconds.")
  disposition     enum("in_progress", "completed", "no_answer", "busy", "failed", "canceled")  @default("in_progress") @description("Call outcome.")
  costEstimate    float   @default("0") @description("Estimated total cost in USD (carrier + model audio), for per-call attribution.")
}

/// TCPA consent / opt-out state for an external phone number. Outbound calls to an opted-out number
/// are blocked with an auditable reason (memql#1915). Append-only: the newest row per phoneNumber
/// is authoritative.
concept consent {
  phoneNumber  string! @description("The external party's E.164 number this consent record governs.")
  partitionId  string! @description("Tenant partition the consent was recorded under (Amendment A).")
  status       enum("opted_in", "opted_out")! @description("Consent state. opted_out blocks outbound calls.")
  reason       string  @description("Why the state was set (e.g. 'user requested removal', 'written consent on file').")
  source       string  @description("Where the consent came from (e.g. 'ivr_optout', 'admin', 'import').")
}
