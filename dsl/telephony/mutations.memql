// Telephony writes -- persist provisioned numbers, SIP trunks, and call
// records. Invoked by the telephony integration (provisioning, inbound
// dispatch, outbound placeCall) and the call lifecycle. Records bind to a
// partition, never a space (Amendment A).

/// Persist a provisioned DID. Called after a carrier BuyNumber succeeds.
mutate number recordNumber {
  args {
    e164         string!
    carrier      string!
    partitionId  string!
    purpose      enum("inbound", "outbound", "both")
    providerId   string
    numberType   enum("local", "tollfree", "mobile")
    monthlyCost  float
  }
  insert {
    accept { e164, carrier, partitionId, providerId }
    stamp {
      purpose:     args.purpose ?? "both"
      status:      "active"
      numberType:  args.numberType ?? "local"
      monthlyCost: args.monthlyCost ?? 0
      purchasedAt: now
    }
  }
}

/// Update a DID's lifecycle status (e.g. on release).
mutate number updateNumberStatus {
  args {
    id      string!
    status  enum("active", "releasing", "released")!
  }
  update {
    accept { id, status }
  }
}

/// Persist a LiveKit SIP trunk configuration. secretRef points at external-secrets, never a secret
/// value.
mutate trunk recordTrunk {
  args {
    carrier        string!
    direction      enum("inbound", "outbound", "both")!
    name           string
    livekitTrunkId string
    sipEdgeUri     string
    secretRef      string
  }
  insert {
    accept { carrier, direction, name, livekitTrunkId, sipEdgeUri, secretRef }
    stamp {
      status: "active"
    }
  }
}

/// Write an append-only call record. A completed leg writes one row with the real duration +
/// disposition; durationSeconds/disposition default to an in-progress row when omitted (Amendment
/// A: bound to partition + partition-scoped room).
mutate call recordCall {
  args {
    direction       enum("inbound", "outbound")!
    fromE164        string!
    toE164          string!
    partitionId     string!
    room            string!
    carrier         string
    providerCallId  string
    agentId         string
    durationSeconds int
    disposition     enum("in_progress", "completed", "no_answer", "busy", "failed", "canceled")
    costEstimate    float
  }
  insert {
    accept { direction, fromE164, toE164, partitionId, room, carrier, providerCallId, agentId }
    stamp {
      startedAt:       now
      durationSeconds: args.durationSeconds ?? 0
      disposition:     args.disposition ?? "in_progress"
      costEstimate:    args.costEstimate ?? 0
    }
  }
}

/// Close a call record on disconnect: stamp end time, duration, disposition, and cost estimate.
mutate call closeCall {
  args {
    id              string!
    durationSeconds int!
    disposition     enum("completed", "no_answer", "busy", "failed", "canceled")!
    costEstimate    float
  }
  update {
    accept { id, durationSeconds, disposition }
    stamp {
      endedAt:         now
      costEstimate:    args.costEstimate ?? 0
    }
  }
}

/// Record TCPA consent / opt-out for an external number (append-only; newest wins).
mutate consent setConsent {
  args {
    phoneNumber  string!
    partitionId  string!
    status       enum("opted_in", "opted_out")!
    reason       string
    source       string
  }
  insert {
    accept { phoneNumber, partitionId, status, reason, source }
  }
}

/// Set E911 / caller-ID verification state on an owned DID (by row id).
mutate number setNumberE911 {
  args {
    id               string!
    e911Registered   bool!
    e911AddressId    string
    callerIdVerified bool
  }
  update {
    accept { id, e911Registered, e911AddressId }
    stamp {
      callerIdVerified: args.callerIdVerified ?? false
    }
  }
}
