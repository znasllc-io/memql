// Telephony writes -- persist provisioned numbers, SIP trunks, and call
// records. Invoked by the telephony integration (provisioning, inbound
// dispatch, outbound place_call) and the call lifecycle. Records bind to a
// partition, never a space (Amendment A).

use telephony.concepts.{ number, trunk, call, consent }

@enabled
@description("Persist a provisioned DID. Called after a carrier BuyNumber succeeds.")
mutate number recordNumber {
  args {
    e164         string  @required
    carrier      string  @required
    partitionId  string  @required
    purpose      string  @enum("inbound", "outbound", "both")
    providerId   string
    numberType   string  @enum("local", "tollfree", "mobile")
    monthlyCost  float
  }
  insert {
    args.e164
    args.carrier
    args.partitionId
    purpose:     coalesce(args.purpose, "both")
    status:      "active"
    args.providerId
    numberType:  coalesce(args.numberType, "local")
    monthlyCost: coalesce(args.monthlyCost, 0)
    purchasedAt: now
  }
}

@enabled
@description("Update a DID's lifecycle status (e.g. on release).")
mutate number updateNumberStatus {
  args {
    id      string  @required
    status  string  @required @enum("active", "releasing", "released")
  }
  update {
    id:     args.id
    status: args.status
  }
}

@enabled
@description("Persist a LiveKit SIP trunk configuration. secretRef points at external-secrets, never a secret value.")
mutate trunk recordTrunk {
  args {
    carrier        string  @required
    direction      string  @required @enum("inbound", "outbound", "both")
    name           string
    livekitTrunkId string
    sipEdgeUri     string
    secretRef      string
  }
  insert {
    args.carrier
    args.direction
    args.name
    args.livekitTrunkId
    args.sipEdgeUri
    args.secretRef
    status: "active"
  }
}

@enabled
@description("Write an append-only call record. A completed leg writes one row with the real duration + disposition; durationSeconds/disposition default to an in-progress row when omitted (Amendment A: bound to partition + partition-scoped room).")
mutate call recordCall {
  args {
    direction       string  @required @enum("inbound", "outbound")
    fromE164        string  @required
    toE164          string  @required
    partitionId     string  @required
    room            string  @required
    carrier         string
    providerCallId  string
    agentId         string
    durationSeconds int
    disposition     string  @enum("in_progress", "completed", "no_answer", "busy", "failed", "canceled")
    costEstimate    float
  }
  insert {
    args.direction
    args.fromE164
    args.toE164
    args.partitionId
    args.room
    args.carrier
    args.providerCallId
    args.agentId
    startedAt:       now
    durationSeconds: coalesce(args.durationSeconds, 0)
    disposition:     coalesce(args.disposition, "in_progress")
    costEstimate:    coalesce(args.costEstimate, 0)
  }
}

@enabled
@description("Close a call record on disconnect: stamp end time, duration, disposition, and cost estimate.")
mutate call closeCall {
  args {
    id              string  @required
    durationSeconds int     @required
    disposition     string  @required @enum("completed", "no_answer", "busy", "failed", "canceled")
    costEstimate    float
  }
  update {
    id:              args.id
    endedAt:         now
    durationSeconds: args.durationSeconds
    disposition:     args.disposition
    costEstimate:    coalesce(args.costEstimate, 0)
  }
}

@enabled
@description("Record TCPA consent / opt-out for an external number (append-only; newest wins).")
mutate consent setConsent {
  args {
    phoneNumber  string  @required
    partitionId  string  @required
    status       string  @required @enum("opted_in", "opted_out")
    reason       string
    source       string
  }
  insert {
    args.phoneNumber
    args.partitionId
    args.status
    args.reason
    args.source
  }
}

@enabled
@description("Set E911 / caller-ID verification state on an owned DID (by row id).")
mutate number setNumberE911 {
  args {
    id               string  @required
    e911Registered   bool @required
    e911AddressId    string
    callerIdVerified bool
  }
  update {
    id:               args.id
    e911Registered:   args.e911Registered
    e911AddressId:    args.e911AddressId
    callerIdVerified: coalesce(args.callerIdVerified, false)
  }
}
