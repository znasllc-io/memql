// Telephony reads -- numbers by partition and call records by partition /
// number / time. Phone numbers and call logs are sensitive cluster
// infrastructure, so reads are cluster-owner gated (Amendment A scoping is by
// partition, not space).

/// ADMIN: DIDs provisioned to a partition, newest first. Cluster-owner gated -- numbers are cluster
/// infrastructure.
@actor
query number numbersByPartition {
  args {
    partitionId  string!
  }
  filter  partitionId==args.partitionId && actor.isClusterOwner==true
  sort    "row.createdAt", "desc"
  shape   numberFull
}

/// ADMIN: every provisioned DID across all partitions, newest first. Cluster-owner gated. Backs the
/// cockpit numbers view.
@actor
query number allNumbers {
  filter  actor.isClusterOwner==true
  sort    "row.createdAt", "desc"
  paginate 100
  shape   numberFull
}

/// ADMIN: call records for a partition, newest first. Cluster-owner gated. Powers billing +
/// observability.
@actor
query call callsByPartition {
  args {
    partitionId  string!
  }
  filter  partitionId==args.partitionId && actor.isClusterOwner==true
  sort    "row.createdAt", "desc"
  paginate 100
  shape   callFull
}

/// ADMIN: call records that touched a specific DID (as caller or callee), newest first.
/// Cluster-owner gated.
@actor
query call callsByNumber {
  args {
    e164  string!
  }
  filter  (fromE164==args.e164 || toE164==args.e164) && actor.isClusterOwner==true
  sort    "row.createdAt", "desc"
  paginate 100
  shape   callFull
}

/// Opt-out rows for an external number (newest first). Read in the outbound call path to block
/// calls to opted-out numbers (TCPA). Not owner-gated: the enforcement check runs in the agent/call
/// context, not an admin one.
query consent consentOptOut {
  args {
    phoneNumber  string!
  }
  filter  phoneNumber==args.phoneNumber && status=="opted_out"
  sort    "row.createdAt", "desc"
  shape   consentFull
}

/// Resolve an owned DID row by its E.164 (newest first). Used to set E911 / compliance state by
/// number.
query number numberByE164 {
  args {
    e164  string!
  }
  filter  e164==args.e164
  sort    "row.createdAt", "desc"
  shape   numberFull
}
