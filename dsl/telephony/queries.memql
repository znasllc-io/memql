// Telephony reads -- numbers by partition and call records by partition /
// number / time. Phone numbers and call logs are sensitive cluster
// infrastructure, so reads are cluster-owner gated (Amendment A scoping is by
// partition, not space).

use telephony.concepts.{ number, call, consent }
use telephony.shapes.{ numberFull, callFull, consentFull }

@enabled
@description("ADMIN: DIDs provisioned to a partition, newest first. Cluster-owner gated -- numbers are cluster infrastructure.")
query number numbersByPartition {
  args {
    partitionId  string  @required
  }
  filter  payload.partitionId==args.partitionId && actor.isClusterOwner==true
  sort    "createdAt", "desc"
  shape   numberFull
}

@enabled
@description("ADMIN: every provisioned DID across all partitions, newest first. Cluster-owner gated. Backs the cockpit numbers view.")
query number allNumbers {
  filter  actor.isClusterOwner==true
  sort    "createdAt", "desc"
  paginate 100
  shape   numberFull
}

@enabled
@description("ADMIN: call records for a partition, newest first. Cluster-owner gated. Powers billing + observability.")
query call callsByPartition {
  args {
    partitionId  string  @required
  }
  filter  payload.partitionId==args.partitionId && actor.isClusterOwner==true
  sort    "createdAt", "desc"
  paginate 100
  shape   callFull
}

@enabled
@description("ADMIN: call records that touched a specific DID (as caller or callee), newest first. Cluster-owner gated.")
query call callsByNumber {
  args {
    e164  string  @required
  }
  filter  (payload.fromE164==args.e164 || payload.toE164==args.e164) && actor.isClusterOwner==true
  sort    "createdAt", "desc"
  paginate 100
  shape   callFull
}

@enabled
@description("Opt-out rows for an external number (newest first). Read in the outbound call path to block calls to opted-out numbers (TCPA). Not owner-gated: the enforcement check runs in the agent/call context, not an admin one.")
query consent consentOptOut {
  args {
    phoneNumber  string  @required
  }
  filter  payload.phoneNumber==args.phoneNumber && payload.status=="opted_out"
  sort    "createdAt", "desc"
  shape   consentFull
}

@enabled
@description("Resolve an owned DID row by its E.164 (newest first). Used to set E911 / compliance state by number.")
query number numberByE164 {
  args {
    e164  string  @required
  }
  filter  payload.e164==args.e164
  sort    "createdAt", "desc"
  shape   numberFull
}
