// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use knowledge.concepts.{ documentChunk, knowledgeDomain }
use common.concepts.{ media }

@row
@description("Minimal document-chunk projection used for per-domain counting on the frontend. Returns only the parent domainId for each chunk so the Knowledge panel can build a {domainId: count} map without paying for full-chunk-payload bandwidth.")
shape documentChunk documentChunkDomainLite {
  payload.domainId
}

@row
@description("Document chunk projection including the source reference and ordering.")
shape documentChunk documentChunkFull {
  row.id
  payload.domainId
  payload.text
  payload.sourceRef
  payload.seq
  payload.tokenCount
  row.createdAt
}

// ---- shapes/v1/common/knowledgedomainFull.memql ----

// Source + cadence + freshness fields (`payload.source`,
// `payload.refreshCadenceDays`, `payload.lastSeededAt`,
// `payload.seederRecipeVersion`) are required by:
//   - integrations/agent/replier.go citation registry (reads source)
//   - integrations/training/training.go domainNeedsRefresh (reads
//     lastSeededAt, seederRecipeVersion, refreshCadenceDays)
//   - copresent useKnowledgeDomains hook (surfaces source,
//     refreshCadenceDays, lastSeededAt to the Knowledge panel)
// Without these in the projection, downstream consumers silently
// get empty values and fall back to defaults that mask the real
// configuration. The shape parser does NOT accept `//` comments
// inside the @template({...}) literal -- keep all rationale in
// the leading comment block above the function.

@row
@description("Knowledge domain projection for the agent builder picker, operator-turn retrieval, the citation registry's domain lookup (replier.go), the training pipeline's domain freshness check (training.go's domainNeedsRefresh), and the Knowledge panel's row + modal renderers (cadence badge, last-updated, next-refresh).")
shape knowledgeDomain knowledgeDomainFull {
  row.id
  payload.name
  payload.description
  payload.category
  payload.relevantForRoles
  payload.requiredByToolSlugs
  payload.active
  payload.source
  payload.refreshCadenceDays
  payload.lastSeededAt
  payload.seederRecipeVersion
  payload.predefined
  row.createdAt
}

// =============================================================================
// Trait shapes -- concept-agnostic row scaffolds
// =============================================================================
//
// These shapes carry @row WITHOUT a concept binding in the signature
// (i.e. `shape <name>`, not `shape <Concept> <name>`), which is what
// makes them concept-agnostic. Specs bind to a trait shape via
// `@shape("<name>")` when they want to filter rows by a predicate
// that applies across many different concepts (e.g. "active row",
// "cancelled row").
//
// Trait shapes project ONLY the payload fields their predicates check,
// so the engine knows the predicate's field-reference universe without
// committing to a single concept's schema.

@row
@description("Concept-agnostic scaffold for predicates that check payload.active.")
shape activeRowTrait {
  payload.active
}

@row
@description("Concept-agnostic scaffold for predicates that check payload.status.")
shape statusRowTrait {
  payload.status
}

@row
@description("Concept-agnostic scaffold for predicates that check payload.deleted (soft-delete flag).")
shape deletedRowTrait {
  payload.deleted
}

@row
@description("Concept-agnostic scaffold for predicates that check payload.archivedAt (archive timestamp).")
shape archivedRowTrait {
  payload.archivedAt
}

@row
@description("Concept-agnostic scaffold for predicates that check payload.savedAt (save timestamp).")
shape savedRowTrait {
  payload.savedAt
}

@row
@description("Concept-agnostic scaffold for predicates that check the validation lifecycle (payload.validationStatus + payload.checkedAt + payload.confirmedAt).")
shape validationRowTrait {
  payload.validationStatus
  payload.checkedAt
  payload.confirmedAt
}

// =============================================================================
// Actor shape -- auth-envelope projection
// =============================================================================
//
// @actor shapes project the engine's auth envelope rather than row
// fields. Context-specs (predicates that check actor.* fields only)
// bind here via `@shape("actorEnvelope")`.

@actor
@description("Actor envelope projection: authenticated actor, role, and now.")
shape actorEnvelope {
  actor.userId
  actor.role
  actor.identityId
  actor.isClusterOwner
  actor.now
}

// ---- shapes/v1/common/mediaFull.memql ----

// Full projection of v1:common:media for the SPA's `useMedia(spaceId,
// filters)` hook (visionarys-io/copresent src/hooks/useCopresent.ts).
// Surface mirrors the SPA's Media interface so the generated SDK
// hands back rows with no client-side shape adapters needed.
//
// memql-bff-copresent#44 (audit) + memql#191.

@row
@description("Full projection of a v1:common:media row -- every payload field used by the CoPresent SPA's Media interface, plus the row intrinsics the frontend reads for ordering and ids.")
shape media mediaFull {
  row.id
  payload.spaceId
  payload.mediaType
  payload.mimeType
  payload.url
  payload.filename
  payload.size
  payload.duration
  payload.dimensions
  payload.transcription
  payload.metadata
  row.createdAt
}
