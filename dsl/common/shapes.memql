// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use knowledge.concepts.{ documentChunk }

/// Attachment projection for the download endpoint (memql#804): the file's storage URL + the
/// metadata needed to serve it back (name + MIME + owning space for the cross-space guard).
@row
shape attachment attachmentDownload {
  row.id
  fileName
  mimeType
  blobUrl
  partitionId
  status
}

// documentChunkDomainLite carries `validationStatus` as well as the domain id
// (memql#4740), and the second field is what makes the rollup HONEST rather
// than cheaper.
//
// `allDocumentChunkDomains` is `@unbounded` -- "a bounded dedupe enumeration
// consumed whole" -- so one read already returns a row per chunk in the
// cluster. With only `domainId` on it, a per-domain validated / unvalidated /
// rejected breakdown could be built exactly one way: page
// `documentChunksForDomain` per domain and count the FIRST 50, which is a
// number that looks like a total and is not one. The projected status turns
// the same one-pass read into a complete rollup with no extra round trip.
//
// Additive: the portal's existing grouping consumer reads `domainId` and is
// unaffected by a key it does not look at.
/// Minimal document-chunk projection used for per-domain counting on the frontend. Returns the
/// parent domainId plus the chunk's validation status, so a caller can build both a
/// {domainId: count} map and a per-domain validated/unvalidated/rejected rollup from one read.
@row
shape documentChunk documentChunkDomainLite {
  domainId
  validationStatus
}

// documentChunkFull gained the six provenance + lifecycle fields the MemQL OS
// Training app's review queue renders (memql#4739).
//
// A CONCEPT FIELD IS NOT A READABLE FIELD. Every one of these is declared on
// `documentChunk` and was projected by nothing, so a client asking this query
// for a chunk's validation state got a row with no such key -- which renders
// as "this chunk has no status", not as "this projection does not carry one".
// The review queue is defined by three of them (`validationStatus` selects the
// queue, `superseded` keeps history out of it, `documentId` groups an upload
// batch), so without the projection the section would read an empty queue
// against a cluster full of unvalidated chunks and look like it was working.
//
// Additive for the Trainer Agent's `existingCorpus` read, which names the
// fields it forwards; the dispatcher truncates `text` per chunk for its token
// budget and these six are short.
/// Document chunk projection including the source reference, ordering, provenance discriminator
/// and validation / supersession state. Backs the Trainer Agent's mode='refresh' existingCorpus
/// and the Training app's review queue (which selects on validationStatus, groups by documentId
/// and renders superseded chunks as history rather than as work).
@row
shape documentChunk documentChunkFull {
  row.id
  domainId
  text
  sourceRef
  seq
  tokenCount
  documentId
  source
  sourceTopic
  validationStatus
  superseded
  supersededReason
  row.createdAt
}

// ---- shapes/v1/common/knowledgedomainFull.memql ----

// Source + cadence + freshness fields (`payload.source`,
// `payload.refreshCadenceDays`, `payload.lastSeededAt`,
// `payload.seederRecipeVersion`) are required by:
//   - integrations/agent/replier.go citation registry (reads source)
//   - integrations/planner/refresh_cron.go domainIsDue (reads
//     lastSeededAt, seederRecipeVersion, refreshCadenceDays)
//   - the frontend's useKnowledgeDomains hook (surfaces source,
//     refreshCadenceDays, lastSeededAt to the Knowledge panel)
// Without these in the projection, downstream consumers silently
// get empty values and fall back to defaults that mask the real
// configuration. The shape parser does NOT accept `//` comments
// inside the @template({...}) literal -- keep all rationale in
// the leading comment block above the function.

// =============================================================================
// Trait shapes -- concept-agnostic row scaffolds
// =============================================================================
//
// These shapes carry @row WITHOUT a concept binding in the signature
// (i.e. `shape <name>`, not `shape <Concept> <name>`), which is what
// makes them concept-agnostic. Specs bind to a trait shape via the
// two-identifier signature form -- `spec <traitShapeName> <name> {
// return <bool> }` (e.g. `spec activeRowTrait isActive { ... }`) --
// when they want to filter rows by a predicate that applies across
// many different concepts (e.g. "active row", "cancelled row"). The
// `@shape("<name>")` annotation pin is retired (epic #2281); the
// binding moved to the signature.
//
// Trait shapes project ONLY the payload fields their predicates check,
// so the engine knows the predicate's field-reference universe without
// committing to a single concept's schema.

/// Concept-agnostic scaffold for predicates that check payload.active.
@row
shape activeRowTrait {
  active
}

/// Concept-agnostic scaffold for predicates that check payload.status.
@row
shape statusRowTrait {
  status
}

/// Concept-agnostic scaffold for predicates that check payload.deleted (soft-delete flag).
@row
shape deletedRowTrait {
  deleted
}

/// Concept-agnostic scaffold for predicates that check payload.archivedAt (archive timestamp).
@row
shape archivedRowTrait {
  archivedAt
}

/// Concept-agnostic scaffold for predicates that check payload.savedAt (save timestamp).
@row
shape savedRowTrait {
  savedAt
}

/// Concept-agnostic scaffold for predicates that check the validation lifecycle
/// (payload.validationStatus + payload.checkedAt + payload.confirmedAt).
@row
shape validationRowTrait {
  validationStatus
  checkedAt
  confirmedAt
}

// =============================================================================
// Actor shape -- auth-envelope projection
// =============================================================================
//
// @actor shapes project the engine's auth envelope rather than row
// fields. Context-specs (caller predicates) bind here via their
// SIGNATURE -- `spec actorEnvelope <name> { return <bare key> }` (epic
// #2281) -- and read the projected key by bare name.

/// Actor envelope projection: authenticated actor, role, and now.
@actor
shape actorEnvelope {
  actor.userId
  actor.role
  actor.identityId
  actor.isClusterOwner
  actor.now
}

// ---- shapes/v1/common/mediaFull.memql ----

// Full projection of v1:common:media for the SPA's `useMedia(partitionId,
// filters)` hook (frontend repo, src/hooks).
// Surface mirrors the SPA's Media interface so the generated SDK
// hands back rows with no client-side shape adapters needed.
//
// carrier#44 (audit) + memql#191.

/// Full projection of a v1:common:media row -- every payload field used by the product SPA's Media
/// interface, plus the row intrinsics the frontend reads for ordering and ids.
@row
shape media mediaFull {
  row.id
  partitionId
  mediaType
  mimeType
  url
  filename
  size
  duration
  dimensions
  transcription
  metadata
  row.createdAt
}
