// ---- queries/v1/common/builtin/builtinDateKeyInTimezone.memql ----

// builtinDateKeyInTimezone -- IANA-timezone YYYY-MM-DD date key.
//
// Computes the calendar date in the given IANA timezone (e.g.
// "America/Los_Angeles"). Returns one row whose payload is
// `{dateKey: "2026-05-18", tzUsed: "America/Los_Angeles"}`. Falls
// back to UTC on empty / unparseable timezone -- the handler never
// errors on a bad tz string, so the daily-space automations always
// get *some* date back instead of crashing on a typo'd user pref.
//
// Daily-space automations (provisionDailySpaceOnUserCreate,
// ensureDailySpaceOnLogin, rolloverDailySpace) call this to compute
// the dateKey portion of the deterministic space id
// `daily-<userHash>-<dateKey>`.

@executor("integration.timeutil.dateKeyInTimezone")
@description("Compute today's YYYY-MM-DD date key in the given IANA timezone. Falls back to UTC on empty/invalid timezone.")
builtin dateKeyInTimezone {
  timezone  string
  now       string
}

// ---- The data-origins inventory (epic memql#4378) ----
//
// @sdk on this and on the four datasync builtins below: most builtins are
// internal and stay out of the generated SDKs, but these five ARE the
// operator surface. The portal's Data origins page reads the inventory and
// drives backfill / pause / retry / discard through them, and a typed
// method is what keeps that page from hand-building call strings.
//
// Engine-native, and here rather than in dsl/platform because every
// other registry-projecting builtin -- concepts, tools, functions,
// routerListModels -- is here too. The concept it projects onto
// (v1:platform:dataOrigin) lives in platform, which is where the row
// SHAPE belongs; the reader belongs with its siblings.

@sdk
@executor("dataOrigins")
@description("List every registered concept with its data state (mirror | origin | native), the system where its changes are made, and the connectors it depends on. Produced from the live concept registry, never persisted. Feeds the portal's Data origins page.")
builtin dataOrigins { }

// ---- AI provider configuration (epic memql#4440) ----
//
// The three constructs behind the portal's Settings -> AI providers page.
// Here rather than in dsl/platform for the same reason dataOrigins is: every
// registry-projecting builtin lives together, and the row SHAPES live in
// platform.
//
// ALL THREE ARE OWNER-ONLY, AND THE WALL IS IN GO. A builtin carries no role
// predicate of its own and the coarse write check admits every role from
// `writer` up, so a `@description` promising owner-only would be a comment
// rather than a gate. See component/memql/provider_auth_status_read.go and
// provider_verify.go, where the refusals actually are.

@sdk
@executor("providerAuthStatus")
@description("List every AI provider this NODE has registered: its vendor and model, whether this node can call it, which tier of the resolution chain supplied its credential (federation | globalSecret | globalVariable | env | unresolved), and -- when it cannot be called -- why not. Produced from the live provider registry, never persisted, and carrying no credential or fingerprint of one. Per-node on purpose: two replicas genuinely can disagree, and that disagreement is the most useful thing this read surfaces. Owner-only.")
builtin providerAuthStatus { }

@sdk
@executor("providersReload")
@description("Re-resolve AI provider credentials from the graph on EVERY node, so a key seeded through the portal takes effect fleet-wide with no restart. Reloads this node synchronously and broadcasts the same request over the mesh; each node builds a replacement registry fully and swaps it in atomically, so in-flight calls are unaffected and a node that cannot build one keeps what it had. Writes a providers_reloaded audit line naming who asked. Owner-only.")
builtin providersReload {
  /// Ties every node's log line back to one Apply. Generated when omitted.
  requestId  string
}

@sdk
@executor("providerVerify")
@description("Make ONE authenticated, token-free call to a provider's vendor and report whether the credential THIS node resolved was accepted. Lists models -- the cheapest authenticated request either vendor serves -- so it can be pressed as often as an operator likes without spending inference. A rejected key is an ANSWER (verified=false with the vendor's reason), not an error. Owner-only.")
builtin providerVerify {
  /// The registered provider entry to verify, by name.
  provider  string!
}

// ---- The sync runtime (epic memql#4378) ----
//
// Four builtins over component/datasync. The first two are driven by the
// automations in dsl/platform/automations.memql; the last two are what an
// operator's Data origins page calls.

@executor("integration.datasync.dispatchInbound")
@description("Route one staged inbound request to the connector its source names, apply the returned mirror writes behind the version guard (a write older than the stored row's is recorded stale and skipped), and stamp the request processed or failed. A no-op for a source no connector serves, which is most of them.")
builtin datasyncDispatchInbound {
  inboundRequestId  string
  source            string
  topic             string
  body              string
}

@executor("integration.datasync.reconcileDomains")
@description("Sweep every mirrored domain whose own DomainSpec interval says it is due, healing drift through the same version-guarded apply path inbound uses. Skips paused domains and connectors that do not implement Reconcile.")
builtin datasyncReconcileDomains { }

@sdk
@executor("integration.datasync.startBackfill")
@description("Drive one domain's backfill page by page from its stored cursor, persisting progress on v1:platform:syncState after every page so a restart resumes rather than restarts. Operator-driven; nothing schedules it.")
builtin datasyncStartBackfill {
  connector  string!
  conceptId  string!
}

@sdk
@executor("integration.datasync.setSyncPaused")
@description("Pause or resume one domain: stops its backfill, its reconciliation and its outbox drain, without unregistering the connector or changing any declaration.")
builtin datasyncSetSyncPaused {
  connector  string!
  conceptId  string!
  paused     boolean!
}

@sdk
@executor("integration.datasync.retryOutboxEntry")
@description("Return one DEAD-lettered outbox entry to the queue with its attempts reset. Refuses an entry that is not dead: a pending or failed one is still the drain worker's, and acting on it would race a delivery in flight.")
builtin datasyncRetryOutboxEntry {
  entryId  string!
}

@sdk
@executor("integration.datasync.discardOutboxEntry")
@description("Discard one DEAD-lettered outbox entry: the operator has decided this change will never be delivered. The row survives as audit history carrying the reason. Refuses an entry that is not dead.")
builtin datasyncDiscardOutboxEntry {
  entryId  string!
  reason   string
}
