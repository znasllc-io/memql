// ---- queries/v1/common/builtin/builtinDateKeyInTimezone.memql ----

// builtinDateKeyInTimezone -- IANA-timezone YYYY-MM-DD date key.
//
// Computes the calendar date in the given IANA timezone (e.g.
// "America/Los_Angeles"). Returns one row whose payload is
// `{dateKey: "2026-05-18", tzUsed: "America/Los_Angeles"}`. Falls
// back to UTC on empty / unparseable timezone -- the handler never
// errors on a bad tz string, so the daily-space automations always
// get *some* date back instead of crashing on a typo'd user pref.
//
// Daily-space automations (provisionDailySpaceOnUserCreate,
// ensureDailySpaceOnLogin, rolloverDailySpace) call this to compute
// the dateKey portion of the deterministic space id
// `daily-<userHash>-<dateKey>`.

@executor("integration.timeutil.dateKeyInTimezone")
@description("Compute today's YYYY-MM-DD date key in the given IANA timezone. Falls back to UTC on empty/invalid timezone.")
builtin dateKeyInTimezone {
  timezone  string
  now       string
}

// ---- The data-origins inventory (epic memql#4378) ----
//
// @sdk on this and on the four datasync builtins below: most builtins are
// internal and stay out of the generated SDKs, but these five ARE the
// operator surface. The portal's Data origins page reads the inventory and
// drives backfill / pause / retry / discard through them, and a typed
// method is what keeps that page from hand-building call strings.
//
// Engine-native, and here rather than in dsl/platform because every
// other registry-projecting builtin -- concepts, tools, functions,
// routerListModels -- is here too. The concept it projects onto
// (v1:platform:dataOrigin) lives in platform, which is where the row
// SHAPE belongs; the reader belongs with its siblings.

@sdk
@executor("dataOrigins")
@description("List every registered concept with its data state (mirror | origin | native), the system where its changes are made, and the connectors it depends on. Produced from the live concept registry, never persisted. Feeds the portal's Data origins page.")
builtin dataOrigins { }

// ---- The automation graph and the loops it stopped (epic memql#5380) ----
//
// The two reads behind MemQL OS's Cluster > Automations section, and @sdk for
// the reason dataOrigins is: a typed method keeps that section from
// hand-building call strings. Neither is a row read with a tier to gate it --
// the graph is a projection of the answering node's scheduler, and the stops
// are read by the engine under its own cluster actor, because a system run's
// row has no owner a caller could be matched against -- so the capability on
// each IS the wall, enforced before the executor runs.

/// The static loop graph over the automations this node registered, one v1:platform:automationNode
/// row per automation: its trigger, filter, writes, the calls the graph cannot see into, its @loop
/// and @mode, the automations it starts and why, its stratum, and the cycle it lies on. Built once
/// per registered set and never persisted. Carries no run and no payload.
@sdk
@executor("automationGraph")
@requiresCapability("read", "app:cluster/automations")
builtin automationGraph { }

/// The latest 50 runs the loop protection stopped, newest first, one v1:platform:automationLoopStop
/// row each: the chain of automation names and run ids that led to the stop, the bound it passed,
/// and when. Read by the engine under its own cluster actor and projected without payloads -- no
/// input, variables or triggering event reaches the reply.
@sdk
@executor("automationLoopStops")
@requiresCapability("read", "app:cluster/automations")
builtin automationLoopStops { }

// ---- Local models on the fleet (epic memql#4676) ----
//
// Here with the other registry-projecting readers; the row SHAPES live in
// platform, exactly as dataOrigins' and providerAuthStatus's do.
//
// NEITHER IS OWNER-GATED, and that is the difference from the three above.
// Those project the CLUSTER'S vendor configuration, which is reconnaissance
// and nobody's business but the operator's. These two answer "what can I run",
// scoped to the caller's own machines plus the shared-inference set -- a
// question every user of the portal has to be able to ask, because the
// first-run gate asks it on their behalf before they have reached anything.

@sdk
@executor("fleetModels")
@description("List every model the caller's fleet can run right now: the model id, its context window and capability flags, and the machines behind it with their online and busy state. Produced from live worker registrations, never persisted -- the answer is which machines are awake, so a stored copy's staleness would be indistinguishable from the condition it describes. Scoped to the caller's own machines plus the shared-inference set; a model call carries the caller's prompts and routes only to their machines. Feeds the portal's Providers page and the fleet machine cards.")
builtin fleetModels { }

@sdk
@executor("inferenceStatus")
@description("Answer, in one row, whether this caller can get inference at all and through which of the three doors: a local model on their fleet, the Anthropic workload-identity federation, or a configured API key. Read from the SAME catalog and provider registry the router reads, so eligibility has exactly one implementation -- a second one drifts, and the drift lets a user through to a console whose features all refuse. Backs the shell's first-run gate.")
builtin inferenceStatus { }

@sdk
@executor("providerAuthStatus")
@description("List every AI provider this NODE has registered: its vendor and model, whether this node can call it, which tier of the resolution chain supplied its credential (federation | globalSecret | globalVariable | env | unresolved), and -- when it cannot be called -- why not. Produced from the live provider registry, never persisted, and carrying no credential or fingerprint of one. Per-node on purpose: two replicas genuinely can disagree, and that disagreement is the most useful thing this read surfaces. Owner-only.")
builtin providerAuthStatus { }

@sdk
@executor("providersReload")
@description("Re-resolve AI provider credentials from the graph on EVERY node, so a key seeded through Settings -> AI providers takes effect fleet-wide with no restart. Reloads this node synchronously and broadcasts the same request over the mesh; each node builds a replacement registry fully and swaps it in atomically, so in-flight calls are unaffected and a node that cannot build one keeps what it had. Writes a providers_reloaded audit line naming who asked. Owner-only.")
builtin providersReload {
  /// Ties every node's log line back to one Apply. Generated when omitted.
  requestId  string
}

@sdk
@executor("providerVerify")
@description("Make ONE authenticated, token-free call to a provider's vendor and report whether the credential THIS node resolved was accepted. Lists models -- the cheapest authenticated request either vendor serves -- so it can be pressed as often as an operator likes without spending inference. A rejected key is an ANSWER (verified=false with the vendor's reason), not an error. Owner-only.")
builtin providerVerify {
  /// The registered provider entry to verify, by name.
  provider  string!
}


@sdk
@executor("providerFederationSet")
@description("Write one vendor's workload identity federation ids as v1:platform:globalVariable rows. This is the ONLY door to a cloud vendor: no key is at rest anywhere, because each pod exchanges its own projected token for a short-lived bearer. Plaintext rows are correct here; none of these ids is a credential. All-or-none is enforced BEFORE the write, per vendor (Anthropic's workspace id excepted, which it needs only for a multi-workspace rule): a partial set refuses BOOT, so accepting one here would take the fleet down at its next restart, hours from the save that caused it. Owner-or-developer -- a developer helps an owner through setup.")
builtin providerFederationSet {
  /// Which vendor these ids configure: anthropic or openai. Required, and closed -- an unknown vendor is refused rather than written under names nothing reads.
  vendor              string!
  /// Anthropic. The OIDC federation rule id (fdrl_...) the token exchange names.
  ruleId              string
  /// Anthropic. UUID of the organization the rule belongs to.
  organizationId      string
  /// OpenAI. The identity provider id the token exchange names.
  identityProviderId  string
  /// The service account the vendor maps this cluster onto. Both vendors take one.
  serviceAccountId    string
  /// Anthropic only, and optional: it is needed only when a rule spans more than one workspace, so it is outside the all-or-none set.
  workspaceId         string
}

// ---- The sync runtime (epic memql#4378) ----
//
// Four builtins over component/datasync. The first two are driven by the
// automations in dsl/platform/automations.memql; the last two are what an
// operator's Data origins page calls.

@executor("integration.datasync.dispatchInbound")
@description("Route one staged inbound request to the connector its source names, apply the returned mirror writes behind the version guard (a write older than the stored row's is recorded stale and skipped), and stamp the request processed or failed. A no-op for a source no connector serves, which is most of them.")
builtin datasyncDispatchInbound {
  inboundRequestId  string
  source            string
  topic             string
  body              string
}

@executor("integration.datasync.reconcileDomains")
@description("Sweep every mirrored domain whose own DomainSpec interval says it is due, healing drift through the same version-guarded apply path inbound uses. Skips paused domains and connectors that do not implement Reconcile.")
builtin datasyncReconcileDomains { }

@sdk
@executor("integration.datasync.startBackfill")
@description("Drive one domain's backfill page by page from its stored cursor, persisting progress on v1:platform:syncState after every page so a restart resumes rather than restarts. Operator-driven; nothing schedules it.")
builtin datasyncStartBackfill {
  connector  string!
  conceptId  string!
}

@sdk
@executor("integration.datasync.setSyncPaused")
@description("Pause or resume one domain: stops its backfill, its reconciliation and its outbox drain, without unregistering the connector or changing any declaration.")
builtin datasyncSetSyncPaused {
  connector  string!
  conceptId  string!
  paused     boolean!
}

@sdk
@executor("integration.datasync.retryOutboxEntry")
@description("Return one DEAD-lettered outbox entry to the queue with its attempts reset. Refuses an entry that is not dead: a pending or failed one is still the drain worker's, and acting on it would race a delivery in flight.")
builtin datasyncRetryOutboxEntry {
  entryId  string!
}

@sdk
@executor("integration.datasync.discardOutboxEntry")
@description("Discard one DEAD-lettered outbox entry: the operator has decided this change will never be delivered. The row survives as audit history carrying the reason. Refuses an entry that is not dead.")
builtin datasyncDiscardOutboxEntry {
  entryId  string!
  reason   string
}

// ---- Pulling a model onto one of your machines (epic memql#5103) ----
//
// The first of these that is an ACT rather than a read, and the one that
// makes something happen on hardware the cluster does not own.
//
// It RETURNS AT ONCE and the v1:worker:modelPull row is how anyone watches:
// a 70B model is tens of gigabytes over a domestic connection, so a call
// that blocked until the download finished would hold a gRPC stream for
// hours and lose the whole pull if the person closed the tab.

@sdk
@executor("fleetModelPull")
@description("Ask one of YOUR OWN fleet machines to pull a model, and return at once with the id of the record to watch. The model id is passed to the machine's runtime verbatim, in the runtime's own vocabulary (llama3.1:8b, or a Hugging Face GGUF repository as hf.co/owner/repo:Q4_K_M). Owner-only: the machine must be yours, unrevoked, and connected to the cluster right now, and each of those is refused BEFORE anything is written -- a pull names one machine and has nothing to fall through to, so a refusal you can act on beats a spinner that fails later. Progress, the runtime's own status line, and the final verdict all land on the v1:worker:modelPull row this returns the id of.")
builtin fleetModelPull {
  registrationId  string!  @description("v1:worker:registration.id of the machine to pull to. It must be one of the caller's own; another user's id answers exactly as a made-up one does.")
  model           string!  @description("The model id in the runtime's own vocabulary. Carried verbatim -- the router selects on this exact string, so a model pulled under one spelling is unreachable under any other.")
}

// ---- routing rules (epic memql#5127, design D7) ----

@executor("integration.router.activateRoutingRule")
@args(when="object", excludes="array")
@description("Add a routing rule at runtime. Renders the form into a `rule` construct DETERMINISTICALLY -- no model is involved -- runs it through the same authoring gates a DSL rule passes, and arms it live; it survives a restart through the authored-bundle re-arm. Owner or developer. A form naming a SHIPPED rule is refused: the shipped set is re-read from the embedded tree on every boot, so a custom rule taking one of those names would be replaced at the next restart with nothing saying so. `when` is an OBJECT of condition keys (level, modality, prompt, role, actorRole, tag, touches) and that shape is load-bearing: a key present with an empty value is a condition matching only an empty value, while an ABSENT key is no condition at all, and separate string arguments could not tell those apart.")
builtin routingRuleActivate {
  name           string!
  policy         string!
  precedence     integer!
  description    string
  level          enum("fast", "strong", "reasoning", "embeddings")
  onUnavailable  enum("degrade", "park")
}

@executor("integration.router.retireRoutingRule")
@description("Retire a runtime-authored routing rule by name. Owner or developer. A shipped rule is refused -- one you want out of the way is out-ranked with a custom rule at a higher precedence, not removed.")
builtin routingRuleRetire {
  name  string!
}

// ---- Pulling the whole recommended set (epic memql#5146, D2) ----
//
// The same act, once per model, in the order the catalog recommends. A person
// who has just paired a Mac Studio should not have to decide which four models
// to pull, in which order, and then press four buttons: the catalog knows which
// models suit a machine of this class, the engine knows the class, and the whole
// of what is left for a person to say is "yes, do that".
//
// It opens one v1:worker:modelPull row per model through the SAME path the
// per-model act uses -- no second pull mechanism, no second sweep. What it adds
// is the set and the order.

@sdk
@executor("fleetPullRecommended")
@description("Ask one of YOUR OWN fleet machines to pull every model the catalog recommends for its class, in order, and return at once with the ids of the records to watch. One pull record per model, opened through the same path the per-model act uses. Owner-only, and every refusal -- the machine is not yours, is offline, has not reported its hardware, or is under the floor for local models -- happens BEFORE the first row is written, so a half-run set is not a state this can leave behind: a person watching four bars, two of which will never move, cannot tell a queue from a failure. Profiles the machine cannot pull are REPORTED rather than attempted, each with the sentence saying why, because what the act did not do is half of what a person needs to read.")
builtin fleetPullRecommended {
  registrationId  string!  @description("v1:worker:registration.id of the machine to pull to. It must be one of the caller's own; another user's id answers exactly as a made-up one does.")
}

@sdk
@executor("fleetRecommended")
@description("What the catalog recommends for one of YOUR OWN machines, and why anything is blocked: one entry per level, strongest first, each with the model, its size, and either a pullable flag or the sentence saying what is in the way. The act's answer without the act, so the machine page and fleetPullRecommended read ONE implementation -- a second one in the browser would drift, and the drift presents as a page offering a pull the act then refuses. Also carries the machine's computed class and the usable memory that produced it. A machine whose cockpit has not reported its hardware answers with an EMPTY class and an empty set rather than a list of blocked entries: there is nothing to recommend and nothing to explain, and a page listing every profile as blocked reads as a machine that failed rather than one that has not spoken.")
builtin fleetRecommended {
  registrationId  string!  @description("v1:worker:registration.id of the machine to recommend for. It must be one of the caller's own.")
}

@sdk
@executor("fleetSharingLedger")
@description("What one of YOUR OWN machines has done this week: how many calls ran on it, for how many people, and how those calls split across the four levels. COUNTS AND LEVELS, and nothing else -- somebody who lends their machine to the team is entitled to know it is being used and NOT entitled to read what it was used for, so the narrowing happens in the engine before anything leaves it rather than in a renderer that could later be rewritten. People are counted and never named. A read that FAILS answers `readable: false` rather than zero: telling somebody who lent their machine that nobody used it is a specific claim, and a failed read is not evidence for it.")
builtin fleetSharingLedger {
  registrationId  string!  @description("v1:worker:registration.id of the machine to report on. It must be one of the caller's own; another user's id answers exactly as a made-up one does.")
}

// ---- Measuring a model on one of your machines (epic memql#5146, D3) ----
//
// The pull's act one question later. A pull says a model is on the disk; this
// says what it DOES there -- structured-output validity against five of the
// platform's own schemas, tool-call correctness over three tool definitions,
// and throughput at two prompt sizes.
//
// It measures and it GATES NOTHING this release. Eligibility for a call stays
// with the advertised flags; a measurement only orders. A probe that refuses a
// working model on a bad run is worse than no probe.

@sdk
@executor("fleetModelProbe")
@description("Ask one of YOUR OWN fleet machines to measure a model it already has, and return at once with the id of the record to watch. The suite is pinned by this engine and echoed back by the machine, so figures can never be filed under a suite that was not run. Owner-only, and the machine must be yours, unrevoked and connected right now -- the same refusals a pull makes, reused deliberately, because offline is offline whichever act is asking. Progress lands per case on the v1:worker:modelProbe row this returns the id of; the figures land on a v1:platform:modelMeasurement row keyed by machine, model and suite version. Every figure is a measured statistic OR a named reason there is none: a machine nobody has probed and a model that failed every case are different answers, and a page that renders both as zero would lead to opposite actions.")
builtin fleetModelProbe {
  registrationId  string!  @description("v1:worker:registration.id of the machine to measure on. It must be one of the caller's own; another user's id answers exactly as a made-up one does.")
  model           string!  @description("The model id in the runtime's own vocabulary. The machine must already ADVERTISE it -- a probe measures a model that is present, where a pull exists precisely because one is not, so probing an unadvertised model would measure a download.")
}

// ---- The nightly evidence fold (epic memql#5146, D5) ----

@description("Fold the week's router calls into per-model, per-level evidence rows, and open a routingReview approval where the evidence carries a demotion. It PROPOSES and never applies: routing is a thing a person is accountable for, and a rule that appeared overnight because a threshold was crossed is an edit nobody made. Above a 0.3 structured-failure rate over at least twenty calls it renders the exclusion rule, hashes the exact text, and puts it to a person; approving arms it through the authoring pipeline and declining is recorded so the same week's evidence does not ask again. Calls that did not say which level they were serving are COUNTED AND EXCLUDED rather than folded under a blank -- a demotion at an unknown level is a demotion at every level, which is far more than the evidence supports.")
@executor("integration.router.routingEvidenceFold")
builtin routingEvidenceFold {
}


/// Create or replace a cluster-wide routing policy with a preferred source and ordered fallbacks.
/// Read routerListPolicies first and pass its revision. A stale revision refuses without changes.
/// Owner or developer only. The active embeddings binding cannot acquire another source or fallback.
@sdk
@executor("routingPolicySave")
builtin routingPolicySave {
  name string!
  description string
  primary string!
  fallbacks []string
  expectedRevision integer!
}

/// Restore a shipped policy's original sources. User-created policies have no shipped default.
/// Owner or developer only; expectedRevision comes from routerListPolicies.
@sdk
@executor("routingPolicyReset")
builtin routingPolicyReset {
  name string!
  expectedRevision integer!
}

/// Read shipped and custom rules in actual evaluation order, with configuration revision.
@sdk
@executor("routingRules")
builtin routingRules { }

/// Validate a custom rule definition against current policies and locked-rule constraints.
/// This validates the definition; it does not claim a replay of historical decisions.
@sdk
@executor("routingRuleValidate")
builtin routingRuleValidate {
  expectedRevision integer
  conditions object
  name string!
  policy string!
  precedence integer!
  level string
  onUnavailable string
  excludes []string
}

/// Save a custom cluster rule at the revision returned by validation. Shipped rules cannot be changed.
@sdk
@executor("routingRuleSave")
builtin routingRuleSave {
  conditions object
  name string!
  policy string!
  precedence integer!
  expectedRevision integer!
  description string
  level string
  onUnavailable string
  excludes []string
}

/// Remove a custom rule after reading its current revision. Shipped rules cannot be removed.
@sdk
@executor("routingRuleRemove")
builtin routingRuleRemove {
  name string!
  expectedRevision integer!
}

/// Ask MemQL to compose a validated policy draft. No policy is saved; review it and call routingPolicySave or routingPolicyReset with its revision. Requires inference and owner/developer access.
@sdk
@executor("routingPolicyDescribe")
builtin routingPolicyDescribe {
  sentence string!
}

/// Compile a rule draft using local inference. Review and validate before routingRuleSave; no configuration is changed.
@sdk
@executor("routingRuleDescribe")
builtin routingRuleDescribe {
  sentence string!
}
