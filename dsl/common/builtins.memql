// ---- queries/v1/common/builtin/builtinEnsureKnowledgeBridge.memql ----

// builtinEnsureKnowledgeBridge - Cross-domain bridge generator
// ============================================================
//
// For an agent's (roleSlug, domainIds) combination, ensures a
// cross-domain bridge corpus exists -- generating it via the
// seedDomainBridge prompt if missing. Hash-keyed by
// (roleSlug, sortedDomainIds) so identical combinations across
// agents share the same bridge id + chunks (paid once per unique
// (role, combo) pair across the tenant; reused forever after).
//
// Returns a synthetic node carrying the bridge id so the training
// pipeline can auto-attach the id to the agent's
// capabilities.domains. Empty bridge id when no bridge is needed
// (fewer than 2 domains, or roleSlug missing).
//
// Invoked by:
//   - The training pipeline post-Step-C, when an agent has 2+
//     knowledge domains.
//   - Future direct calls if we add a "regenerate bridges" admin
//     surface.
//
// See docs/internal/planning/knowledge-seeder.md (v2 bridge chunks) and
// integrations/knowledge/seed_bridge.go for the pipeline.

@executor("integration.knowledge.ensureKnowledgeBridge")
@args(profile="object", additionalProperties="true")
@description("For an agent's (roleSlug, sortedDomainIds), ensures a cross-domain bridge corpus exists. Idempotent + hash-keyed -- pays for the bridge generation once per unique combination then reuses.")
builtin ensureKnowledgeBridge {
  roleSlug   string!
  domainIds  array!
}

