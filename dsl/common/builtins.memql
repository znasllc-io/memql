// ---- queries/v1/common/builtin/builtinSeedAllDomainContent.memql ----

// builtinSeedAllDomainContent - Full-catalog LLM seeder
// =======================================================
//
// Loops every shipped knowledge domain and runs seedDomainContent
// per entry. Best-effort -- one domain failing doesn't abort the
// rest. Logs a per-run summary (domains seeded / chunks written /
// failures) at the end. See seedDomainContent for per-domain
// behaviour.
//
// Invoked manually for catalog-wide regeneration:
//   client.executeQueryAsync({
//     query: 'seedAllDomainContent({recipeVersion: "v1"})'
//   })
//
// Optional filters:
//   - tierFilter -- 'A' / 'B' / 'C' to seed only that tier
//   - domainIdPrefix -- only seed domains whose id starts with
//     this string (e.g. 'physics_')
//
// Cost: ~$300-500 for the full ~250-domain catalog at recipe v1;
// partial runs proportional. See docs/planning/knowledge-seeder.md.

@executor("integration.knowledge.seedAllDomainContent")
@args(profile="object", additionalProperties="true")
@description("Run seedDomainContent across every shipped domain. Optional tierFilter / domainIdPrefix narrow the run.")
builtin seedAllDomainContent {
  recipeVersion   string
  tierFilter      string
  domainIdPrefix  string
}

// ---- queries/v1/common/builtin/builtinSeedDomainContent.memql ----

// builtinSeedDomainContent - Single-domain LLM seeder
// =====================================================
//
// Generate ~30 retrievable chunks for one domain via the
// seedDomainContent prompt, embed them, store them as
// v1:knowledge:documentChunk rows. Idempotent at a given
// recipeVersion via deterministic chunk ids.
//
// Invoked by:
//   - The training pipeline's just-in-time path (trainAgent step A
//     when a domain is empty or stale).
//   - Direct call for recipe iteration: client.executeQueryAsync({
//       query: 'seedDomainContent({domainId: "physics_quantum_mechanics"})'
//     })
//
// See docs/planning/knowledge-seeder.md and
// integrations/knowledge/seed_domain_content.go for the pipeline.

@executor("integration.knowledge.seedDomainContent")
@args(profile="object", additionalProperties="true")
@description("Generate + embed + store seeded knowledge chunks for one domain. Tier-A LLM-generates; Tier-B prepends a disclaimer; Tier-C fetches Wikipedia or writes a placeholder.")
builtin seedDomainContent {
  domainId       string!
  recipeVersion  string
}

// ---- builtins for the Trainer Agent's tool surface (Q3 / Q9) ----
//
// The Trainer Agent (dsl/agents/prompts/trainerAgent.tmpl) drives a
// trainSpecialist Plan by calling a small tool set during its bounded
// tool loop. Three of those tools -- webSearch, fetchUrl, embedChunk --
// are Go-backed builtins (the other two -- writeKnowledgeChunk,
// markChunkSuperseded -- are mutation-backed and route via the tool's
// @handler directly, no builtin needed). embedChunk is a real
// embed-and-store path as of #645; embedDomainItems (below) is the bulk
// domain-warm capability the planner's Plan dispatcher drives.
//
// The trainer-tool wiring lives in integrations/planner/train_specialist_dispatch.go;
// the Go handlers live in integrations/knowledge/trainer_tools.go.

@executor("integration.knowledge.webSearch")
@args(profile="object", additionalProperties="true")
@description("Issue a web search for the Trainer Agent. Returns a list of {url, title, snippet}. STUB: no web-search provider is wired in-repo yet (tracked separately); returns an empty result set + a note so the Trainer can fall back to fetchUrl on URLs it already knows. See integrations/knowledge/trainer_tools.go.")
builtin webSearch {
  query        string!
  num_results  int
}

@executor("integration.knowledge.fetchUrl")
@args(profile="object", additionalProperties="true")
@description("Fetch + extract readable text from a URL for the Trainer Agent. Backed by a bounded http.Client (dial / response / size caps). Returns {url, status, contentType, text, truncated}.")
builtin fetchUrl {
  url  string!
}

@executor("integration.knowledge.embedChunk")
@args(profile="object", additionalProperties="true")
@description("Embed one knowledge chunk so it becomes retrievable via similarTo (#645 lazy embedding). Resolves the chunk text, computes a vector, writes it to node_vectors keyed by the chunk id. Idempotent -- a chunk that already has a vector is acknowledged without re-embedding. Returns {chunkId, embedded, alreadyEmbedded}.")
builtin embedChunk {
  chunkId   string!
  provider  string
}

@executor("integration.knowledge.embedDomainItems")
@args(profile="object", additionalProperties="true")
@description("Embed every unembedded validated chunk attached to a knowledge domain (optionally scoped to one Document), then recompute the parent Document's embeddingStatus none -> partial -> complete (#645). Materializes vectors into node_vectors so seeded + uploaded knowledge becomes semantically retrievable. Idempotent. Driven by the planner's embedDomainItems Plan dispatcher. Returns {domainId, documentId, total, embedded, already, failed, documentsRolledUp}.")
builtin embedDomainItems {
  domainId    string!
  documentId  string
  provider    string
}

