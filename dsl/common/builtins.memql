// builtinKnowledgeAugmentDomainAnalyze
// ====================================
//
// Preflight analyser for the chat 'Analyze for training' action. Takes
// the user's question, the agent's response, the agent's attached
// knowledge domains, and the RAG retrieval pool the agent saw, and
// returns a structured outcome (addable / alreadyCovered / outOfScope)
// with a best-fit domainId + topic + reasoning + confidence. The
// frontend uses the outcome to decide whether to surface a Confirm
// step before paying for the heavier augmentDomainGenerate call.

@executor("integration.knowledge.augmentDomainAnalyze")
@sdk
@args(profile="object", additionalProperties="true")
@description("Decide whether a chat exchange's topic warrants augmenting one of an agent's knowledge domains. Returns {outcome, domainId, topic, reasoning, confidence}. Drives the chat 'Analyze for training' button preflight.")
builtin knowledgeAugmentDomainAnalyze {
  userQuestion   string!
  agentResponse  string!
  domains        []object!
  retrieved      []object
}

// ---- queries/v1/common/builtin/builtinKnowledgeAugmentDomainGenerate.memql ----

// builtinKnowledgeAugmentDomainGenerate
// =====================================
//
// Topic-focused chunk generator. Runs the augmentDomainContent prompt
// to produce ~10 dense chunks targeted at a specific topic within a
// knowledge domain, embeds each + writes them with source='augment'
// and provenance back-pointers (sourceUtteranceId, sourceAgentId,
// sourceTopic). Inserts an audit Plan row (kind='augmentDomain') so
// the work shows up in the Tasks panel + the canvas plan-completed
// card lifecycle.
//
// Synchronous in v1 (~30s for the full AI + embed + write path);
// the frontend shows a "training queued" state until it returns.

@executor("integration.knowledge.augmentDomainGenerate")
@sdk
@args(profile="object", additionalProperties="true")
@description("Generate + embed + persist topic-focused chunks for a knowledge domain. Inserts a Plan row for audit. Returns {planId, chunksAdded, domainId, domainName, topic}.")
builtin knowledgeAugmentDomainGenerate {
  domainId           string!
  topic              string!
  sourceUtteranceId  string
  sourceAgentId      string
  partitionId            string!
  requestedBy        string!
}

// ---- queries/v1/common/builtin/builtinKnowledgeIngest.memql ----

// builtinKnowledgeIngest - Knowledge Base Document Ingestion
// ==========================================================
//
// Split a document into chunks, embed each chunk, and persist both the
// chunk rows (v1:knowledge:documentChunk) and their vectors (node_vectors).
// Idempotent by {domainId, sourceRef, seq, text} hash -- re-ingesting
// the same source replaces the embeddings on conflict.

@executor("integration.knowledge.ingest")
@args(profile="object", additionalProperties="true")
@description("Chunk + embed + persist a document into a knowledge domain. source is REQUIRED and tags the chunk's provenance class -- one of llmSeeded / augment / crossDomainBridge / appStructure / fileUpload. Read by the dev-refresh cache filter and by the citation registry; pick the value that matches what's being ingested.")
builtin knowledgeIngest {
  domainId   string!
  text       string!
  source     string!
  sourceRef  string
  chunkSize  int
  overlap    int
  provider   string
}

