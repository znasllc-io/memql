// the same source replaces the embeddings on conflict.

@executor("integration.knowledge.ingest")
@args(profile="object", additionalProperties="true")
@description("Chunk + embed + persist a document into a knowledge domain. source is REQUIRED and tags the chunk's provenance class -- one of llmSeeded / augment / crossDomainBridge / appStructure / fileUpload. Read by the dev-refresh cache filter and by the citation registry; pick the value that matches what's being ingested.")
builtin knowledgeIngest {
  domainId   string!
  text       string!
  source     string!
  sourceRef  string
  chunkSize  int
  overlap    int
  provider   string
}

