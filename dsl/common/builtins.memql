// ---- queries/v1/common/builtin/builtinSimilarTo.memql ----

// builtinSimilarTo - Vector Similarity Retrieval
// ================================================
//
// First-class DSL operator for pgvector cosine retrieval. Generalised
// over the target concept and the optional payload-domain filter, so
// any concept with a content-field vector in `node_vectors` is fair
// game -- document chunks, transcript snippets, anything embeddable.
//
// Dispatches to the `similarity` integration (integrations/similarity)
// whose handler embeds the text, runs the generic pgvector join, and
// returns the top-K nodes in similarity order. The capability carries
// PreserveOrder=true so callers observe that order without a
// client-side re-sort.

@executor("integration.similarity.similarTo")
@args(profile="object", additionalProperties="true")
@description("Retrieve top-K nodes of the given concept ranked by cosine similarity to the supplied free-text query. Optionally scoped to a payload.domainId list. domains is passed through additionalProperties because the current builtin arg parser accepts `[]string` field types but array-element typecheck is still permissive.")
builtin similarTo {
  text      string!
  concept   string!
  limit     int
  provider  string
}

