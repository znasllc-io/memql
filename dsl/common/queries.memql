// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// ---- queries/v1/common/attachmentById.memql ----

// attachmentById -- fetch one v1:common:attachment row by id, scoped to a
// space, for the download endpoint (memql#804).
//
// Authz tier: granted. The attachment concept is space-scoped (no
// ownerUserId), so the row set is gated by the partitionId arg + partition
// isolation -- and the download HTTP handler enforces CallerOwnsSpace(partitionId)
// (the same space-ownership gate the upload path uses) BEFORE calling this,
// then re-checks the returned row's partitionId. The partitionId predicate here also
// stops cross-space id probing. Mirrors spaceMedia's space-scoped pattern.

/// Fetch a single v1:common:attachment row by id within a space. Backs the attachment download
/// endpoint (GET /spaces/{partitionId}/attachments/{attachmentId}); the handler gates on space
/// ownership first.
@unbounded("attachment by id (guarded) within a space -- bounded to a single row")
query attachment attachmentById {
  args {
    attachmentId  string!
    partitionId       string!
  }
  filter  when(args.attachmentId) { row.id==args.attachmentId } && partitionId==args.partitionId
  shape   attachmentDownload
}

// ---- queries/v1/common/spaceMedia.memql ----

// spaceMedia -- list v1:common:media rows attached to a space.
//
// Surfaced for the product SPA's `useMedia(partitionId, filters)` hook
// (frontend repo, src/hooks). The hook
// returns Media[] for the space's audio / video / image / document
// attachments. SPA callers may pass an optional mediaType filter --
// the arg-conditional `?.payload.mediaType` predicate fires only
// when the caller supplies it; an absent filter returns every type.
//
// Authz tier: granted. The partitionId arg gates the row set; partition
// isolation prevents cross-tenant leakage. Matches the pattern of
// the sibling `spaceUtterances` in dsl/cognition/queries.memql.
//
// carrier#44 (audit) + memql#191.

/// Returns v1:common:media rows attached to a space. Optional mediaType filter narrows to audio /
/// video / image / document. The frontend's useMedia hook calls this for the per-space attachments
/// view.
query media spaceMedia {
  args {
    partitionId    string! @pattern("^v1:[a-z0-9]+:[a-z0-9_]+:[a-zA-Z0-9_-]{1,128}$")
    mediaType  string
  }
  filter  partitionId==args.partitionId && when(args.mediaType) { mediaType==args.mediaType }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   mediaFull
}
