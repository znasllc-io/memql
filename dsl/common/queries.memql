// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.concepts.{ media, attachment }
use common.shapes.{ attachmentDownload }

// ---- queries/v1/common/attachmentById.memql ----

// queryAttachmentById -- fetch one v1:common:attachment row by id, scoped to a
// space, for the download endpoint (memql#804).
//
// Authz tier: granted. The attachment concept is space-scoped (no
// ownerUserId), so the row set is gated by the spaceId arg + partition
// isolation -- and the download HTTP handler enforces CallerOwnsSpace(spaceId)
// (the same space-ownership gate the upload path uses) BEFORE calling this,
// then re-checks the returned row's spaceId. The spaceId predicate here also
// stops cross-space id probing. Mirrors querySpaceMedia's space-scoped pattern.

@enabled
@description("Fetch a single v1:common:attachment row by id within a space. Backs the attachment download endpoint (GET /spaces/{spaceId}/attachments/{attachmentId}); the handler gates on space ownership first.")
query attachment queryAttachmentById {
  args {
    attachmentId  string  @required
    spaceId       string  @required
  }
  filter  when(args.attachmentId) { id==args.attachmentId } && payload.spaceId==args.spaceId
  shape   attachmentDownload
}

// ---- queries/v1/common/spaceMedia.memql ----

// querySpaceMedia -- list v1:common:media rows attached to a space.
//
// Surfaced for the CoPresent SPA's `useMedia(spaceId, filters)` hook
// (visionarys-io/copresent src/hooks/useCopresent.ts:1359). The hook
// returns Media[] for the space's audio / video / image / document
// attachments. SPA callers may pass an optional mediaType filter --
// the arg-conditional `?.payload.mediaType` predicate fires only
// when the caller supplies it; an absent filter returns every type.
//
// Authz tier: granted. The spaceId arg gates the row set; partition
// isolation prevents cross-tenant leakage. Matches the pattern of
// the sibling `querySpaceUtterances` in dsl/cognition/queries.memql.
//
// memql-bff-copresent#44 (audit) + memql#191.

@enabled
@description("Returns v1:common:media rows attached to a space. Optional mediaType filter narrows to audio / video / image / document. The frontend's useMedia hook calls this for the per-space attachments view (visionarys-io/copresent src/hooks/useCopresent.ts).")
query media querySpaceMedia {
  args {
    spaceId    string  @required @pattern("^v1:[a-z0-9]+:[a-z0-9_]+:[a-zA-Z0-9_-]{1,128}$")
    mediaType  string
  }
  filter  payload.spaceId==args.spaceId && when(args.mediaType) { payload.mediaType==args.mediaType }
  shape   mediaFull
}
