// concepts.memql
//
// Concepts in the common namespace.

/// A file attachment uploaded to a space, with extracted transcription.
@displayCard(primary="fileName", secondary="mimeType", tertiary="uploadedBy", status="status")
concept attachment {
  fileName  string!  @description("Original filename of the uploaded file.")
  fileSize  int  @description("File size in bytes.")
  blobUrl  string!  @description("Azure Blob Storage URL where the file is stored (https://account.blob.core.windows.net/container/object).")
  mimeType  string!  @description("MIME type of the uploaded file.")
  partitionId  string!  @description("ID of the space this attachment belongs to.")
  status  enum("processing", "ready", "error")!  @description("Processing status of the attachment.")
  summary  string  @description("AI-generated 2-3 sentence summary of the file content.")
  transcription  string  @description("Extracted plain text from the file, or image description for images.")
  uploadedBy  string!  @description("Actor identifier of the user who uploaded the file.")

}

/// Audio, video, image, and document assets referenced by utterances.
@displayCard(primary="filename", secondary="mimeType", tertiary="url", status="mediaType")
concept media {
  dimensions {
    height  int
    width  int
  }
  duration  int  @description("Duration in milliseconds (for audio/video).")
  filename  string  @description("Original filename.")
  mediaType  enum("audio", "video", "image", "document")!  @description("Type of media asset.")
  metadata  object  @description("Additional format-specific metadata.")
  mimeType  string!  @description("MIME type of the asset.")
  size  int  @description("File size in bytes.")
  partitionId  string!  @description("ID of the space this media belongs to.")
  transcription {
    text  string  @description("Full transcribed text.")
    timestamps  []object
  }
  url  string!  @description("Storage URL for the asset.")

}
