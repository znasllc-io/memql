// concepts.memql
//
// Concepts in the common namespace.

/// A file attachment with extracted transcription.
@displayCard(primary="fileName", secondary="mimeType", tertiary="uploadedBy", status="status")
@belongsTo(account)
concept attachment {
  fileName  string!  @description("Original filename of the uploaded file.")
  fileSize  int  @description("File size in bytes.")
  blobUrl  string!  @bytes(under="spaces") @description("Azure Blob Storage URL where the file is stored (https://account.blob.core.windows.net/container/object).")
  mimeType  string!  @description("MIME type of the uploaded file.")
  status  enum("processing", "ready", "error")!  @description("Processing status of the attachment.")
  summary  string  @description("AI-generated 2-3 sentence summary of the file content.")
  transcription  string  @description("Extracted plain text from the file, or image description for images.")
  uploadedBy  string!  @description("Actor identifier of the user who uploaded the file.")
  accountId  string  @description("The account this row belongs to (see @belongsTo). The engine fills it in at insert and carries it forward on every update.")

}

