// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Matches records whose active field is true.
trait isActiveRecord = row => row.active == true

// ---- specs/v1/common/isCancelled.memql ----

// isCancelled - Cancelled Status Spec
// ========================================
//
// Reusable filter that matches records with cancelled status.
// Cancelled records were scheduled but did not complete.
//
// Usage in a query filter:
//   filter row => isCancelled(row)
//
/// Matches records with cancelled status
trait isCancelled = row => row.status == "cancelled"

// ---- specs/v1/data/isChecked.memql ----

// isChecked - Checked Data Record Spec
// ==========================================
//
// Reusable filter that matches data records in checked validation state.
// Checked records have been synthetically validated but not yet confirmed
// by a human identity. May be usable if the concept's policy allows it.
//
// Usage in a query filter:
//   filter row => isChecked(row)
//
/// Matches active data records in checked validation state
trait isChecked = row => row.active == true && row.validationState == "checked"

// ---- specs/v1/common/isCompleted.memql ----

// isCompleted - Completed Status Spec
// =======================================
//
// Reusable filter that matches records with completed status.
// Completed check-ins have survey responses submitted.
// Completed flags/cases have been resolved.
//
// Usage in a query filter:
//   filter row => isCompleted(row)
//
/// Matches records with completed status
trait isCompleted = row => row.status == "completed"

// ---- specs/v1/data/isConfirmed.memql ----

// isConfirmed - Confirmed Data Record Spec
// ==============================================
//
// Reusable filter that matches data records in confirmed validation state.
// Confirmed records have been validated by a human identity and are always
// considered usable.
//
// Usage in a query filter:
//   filter row => isConfirmed(row)
//
/// Matches active data records in confirmed validation state
trait isConfirmed = row => row.active == true && row.validationState == "confirmed"

// ---- specs/v1/data/isDraft.memql ----

// isDraft - Draft Data Record Spec
// =====================================
//
// Reusable filter that matches data records in draft validation state.
// Draft records are being worked on and are not yet usable.
//
// Usage in a query filter:
//   filter row => isDraft(row)
//
/// Matches active data records in draft validation state
trait isDraft = row => row.active == true && row.validationState == "draft"

// ---- specs/v1/common/isInProgress.memql ----

// isInProgress - In Progress Status Spec
// ===========================================
//
// Reusable filter that matches records with inProgress status.
// InProgress records are actively being worked on or executed.
//
// Usage in a query filter:
//   filter row => isInProgress(row)
//
/// Matches records with inProgress status
trait isInProgress = row => row.status == "inProgress"

// ---- specs/v1/common/isNotArchived.memql ----

// isNotArchived - Not Archived Status Spec
// ==============================================
//
// Reusable filter that matches records that are NOT archived.
// Used to exclude archived items from active queries.
//
// Usage in a query filter:
//   filter row => isNotArchived(row)
//
/// Matches records that are not archived
trait isNotArchived = row => row.status != "archived"

// ---- specs/v1/common/isNotDeleted.memql ----

// isNotDeleted - Not Deleted Record Spec
// ============================================
//
// Reusable filter that excludes records whose deleted field is true.
// Deleted records have been permanently removed by the user and
// should not appear in any listing. This is distinct from
// isActiveRecord, which checks active status -- an agent can
// be inactive (deactivated) but still visible in management views.
//
// Usage in a query filter:
//   filter row => isNotDeleted(row)
//
/// Excludes records whose deleted field is true.
trait isNotDeleted = row => row.deleted != true

// ---- specs/v1/common/isOpen.memql ----

// isOpen - Open Status Spec
// =============================
//
// Reusable filter that matches records with open status.
// Open records require action and haven't been resolved yet.
// Applicable to flags, cases, and other actionable items.
//
// Usage in a query filter:
//   filter row => isOpen(row)
//
/// Matches records with open status requiring action
trait isOpen = row => row.status == "open"

// ---- specs/v1/common/isScheduled.memql ----

// isScheduled - Scheduled Status Spec
// ========================================
//
// Reusable filter that matches records with scheduled status.
// Scheduled records are pending execution at a future time.
//
// Usage in a query filter:
//   filter row => isScheduled(row)
//
/// Matches records with scheduled status
trait isScheduled = row => row.status == "scheduled"

// ---- specs/v1/data/isUsable.memql ----

// isUsable - Usable Data Record Spec
// ========================================
//
// Reusable filter that matches data records that may be usable.
// Matches both checked and confirmed records. Whether checked records
// are actually usable depends on the concept's policy (checkedDataUsable).
// Policy-aware filtering happens at the query level.
//
// Implementation note: the body is a negation because the lexer once had
// no || operator. A record is usable if it is active AND its validation
// state is not "draft", which matches "checked" and "confirmed" -- and,
// since `!=` is null-safe, a row with no validation state at all.
//
// Usage in a query filter:
//   filter row => isUsable(row)
//
/// Matches active data records in checked or confirmed validation state
trait isUsable = row => row.active == true && row.validationState != "draft"

// The retired `requiresAdmin` was an actor.* predicate; under the spec/shape binding
// redesign (epic #2281) a caller predicate is a `spec` bound to an
// @actor shape, not a trait (a trait is the deliberately-unbound row
// predicate over payload fields). It now lives in dsl/common/specs.memql
// as `spec actorEnvelope requiresAdmin`. It has since been deleted outright
// (epic memql#5166): a slug comparison cannot see a custom role, so a role
// question is `@requiresRank` or `@requiresCapability` rather than any spec.

// ---- specs/v1/common/statusIsActive.memql ----

// statusIsActive - Active Status Spec
// ========================================
//
// Reusable filter that matches records with active status.
// Active employees are currently employed and receiving check-ins.
// Active advocates are available for assignment.
//
// Usage in a query filter:
//   filter row => statusIsActive(row)
//
/// Matches records with active status
trait statusIsActive = row => row.status == "active"

// ---- specs/v1/common/statusIsArchived.memql ----

// statusIsArchived - Archived Status Spec
// ============================================
//
// Reusable filter that matches records whose status is "archived".
// Archived spaces are hidden from the active list and on a retention
// countdown to hard-delete (see purgeExpiredArchivedSpaces automation +
// User.preferences.archiveRetentionDays).
//
// Counterpart to isNotArchived (which excludes archived rows from
// active lists). Used by queryArchivedSpaces to populate the Archived
// tab in the SpacesListPanel.
//
// Usage in a query filter:
//   filter row => statusIsArchived(row)
//
/// Matches records whose status is "archived".
trait statusIsArchived = row => row.status == "archived"

// ---- specs/v1/common/statusIsSaved.memql ----

// statusIsSaved - Saved Status Spec
// ======================================
//
// Reusable filter that matches records whose status is "saved".
// Saved spaces are user-preserved -- they never auto-delete, regardless
// of the archive retention policy. Used by querySavedSpaces to populate
// the Saved tab in the SpacesListPanel.
//
// Usage in a query filter:
//   filter row => statusIsSaved(row)
//
/// Matches records whose status is "saved".
trait statusIsSaved = row => row.status == "saved"

// ---- statusIsPending ----
//
// Reusable filter that matches records whose status is "pending".
// Used by identity flows (access requests, invitations) where pending
// rows are queued for action by an admin or the original requester.

/// Matches records whose status is "pending".
trait statusIsPending = row => row.status == "pending"

// ---- statusIsRunning ----
//
// Reusable filter that matches records whose status is "running".
// Used by planner Plans / Tasks and by worker invocations that are
// actively executing right now.

/// Matches records whose status is "running".
trait statusIsRunning = row => row.status == "running"

// ---- identityIsApiKey ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "api_key". Distinct from worker tokens
// (identityIsWorkerToken) so callers can scope per-credential-class
// queries explicitly.

/// Matches v1:identity:identity rows whose identityType is "api_key".
trait identityIsApiKey = row => row.identityType == "api_key"

// ---- identityIsWorkerToken ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "worker_token". Worker tokens are admitted
// only on the WorkerService gRPC path; this trait scopes per-worker
// credential lookups.

/// Matches v1:identity:identity rows whose identityType is "worker_token".
trait identityIsWorkerToken = row => row.identityType == "worker_token"

// ---- identityIsNodeToken ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "node_token". Node tokens authenticate
// inter-node NodeService.Stream peer calls (memql#105 / #338); this
// trait scopes per-node credential lookups used by the bootstrap-
// minted identity-row persistence path (memql#343).

/// Matches v1:identity:identity rows whose identityType is "node_token".
trait identityIsNodeToken = row => row.identityType == "node_token"

// ---- identityIsBadge ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "badge". Badges are registered operator
// credentials for shared terminals (memql#2513): the identity
// service's POST /auth/badge/grant exchange looks rows up by
// credentials.keyHash to mint a short-lived class="badge" grant
// token for the owning user.

/// Matches v1:identity:identity rows whose identityType is "badge".
trait identityIsBadge = row => row.identityType == "badge"

// ---- identityIsMagicLink ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "magic_link". One row per (user, verified
// email), stamped by the magic-link consume path.
//
// What makes this worth a trait of its own rather than an inline
// comparison: it is the row that answers "can this person still get
// in by email". The passkey management surface (memql#3409) counts
// it before it lets a user revoke their last authenticator, so a
// revocation that would leave no sign-in route is warned about
// rather than silently performed.

/// Matches v1:identity:identity rows whose identityType is "magic_link".
trait identityIsMagicLink = row => row.identityType == "magic_link"

// ---- identityIsPasskey ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "passkey" -- a registered WebAuthn
// discoverable credential (memql#3406). The registration ceremony
// looks rows up by credentials.credentialId to reject a duplicate
// enrolment, and the login ceremony (memql#3407) resolves a
// usernameless assertion through the same key.

/// Matches v1:identity:identity rows whose identityType is "passkey".
trait identityIsPasskey = row => row.identityType == "passkey"

// ---- identityIsOidc ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType is "oidc" -- the link to an upstream identity provider
// (memql#4611). It stores NO SECRET: the credential lives at the
// provider, and this row holds only the (issuer, subject) pair the
// provider asserted, which is what lands a returning person on their
// existing user row rather than a duplicate.

/// Matches v1:identity:identity rows whose identityType is "oidc".
trait identityIsOidc = row => row.identityType == "oidc"

// ---- identityIsRecoveryKey ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "recovery_key" -- the owner break-glass
// credential (memql#3964). One active row per cluster, bound to one
// owner, redeemed exactly once to register a passkey for an owner who
// has lost every sign-in route.
//
// IT SITS BESIDE identityIsMagicLink AND identityIsPasskey AND IS
// DELIBERATELY NOT USED WHERE THEY ARE. Those two are the sign-in
// ROUTES: signInIdentitiesForUser matches them, and the break-glass
// gate refuses redemption whenever that query returns a row. A
// recovery key is not a route -- it is what you reach for when you
// have none -- so adding it to that query's filter would make the key
// permanently refuse itself. That is the single likeliest way to
// break this feature while every individual edit looks reasonable, so
// it is written down in three places: here, on the concept's
// identityType description, and on the query itself.

/// Matches v1:identity:identity rows whose identityType is "recovery_key".
trait identityIsRecoveryKey = row => row.identityType == "recovery_key"

// ---- isDeletionScheduled ----
//
// Matches records that carry a non-empty deletionScheduledAt field.
// Used by the user-deletion cooldown sweep to enumerate identities
// queued for hard delete after the retention window expires.

/// Matches records that have a deletion scheduled (deletionScheduledAt is set).
trait isDeletionScheduled = row => row.deletionScheduledAt != ""
