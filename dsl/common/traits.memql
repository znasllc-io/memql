// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Matches records with active==true field
trait isActiveRecord {
  return active==true
}

// ---- specs/v1/common/isCancelled.memql ----

/// Matches records with cancelled status
trait isCancelled {
  return status=="cancelled"
}

// ---- specs/v1/data/isChecked.memql ----

/// Matches active data records in checked validation state
trait isChecked {
  return active==true && validationState=="checked"
}

// ---- specs/v1/common/isCompleted.memql ----

/// Matches records with completed status
trait isCompleted {
  return status=="completed"
}

// ---- specs/v1/data/isConfirmed.memql ----

/// Matches active data records in confirmed validation state
trait isConfirmed {
  return active==true && validationState=="confirmed"
}

// ---- specs/v1/data/isDraft.memql ----

/// Matches active data records in draft validation state
trait isDraft {
  return active==true && validationState=="draft"
}

// ---- specs/v1/common/isInProgress.memql ----

/// Matches records with inProgress status
trait isInProgress {
  return status=="inProgress"
}

// ---- specs/v1/common/isNotArchived.memql ----

/// Matches records that are not archived
trait isNotArchived {
  return status!="archived"
}

// ---- specs/v1/common/isNotDeleted.memql ----

/// Excludes records with deleted==true field
trait isNotDeleted {
  return deleted!=true
}

// ---- specs/v1/common/isOpen.memql ----

/// Matches records with open status requiring action
trait isOpen {
  return status=="open"
}

// ---- specs/v1/common/isScheduled.memql ----

/// Matches records with scheduled status
trait isScheduled {
  return status=="scheduled"
}

// ---- specs/v1/data/isUsable.memql ----

/// Matches active data records in checked or confirmed validation state
trait isUsable {
  return active==true && validationState!="draft"
}

// `requiresAdmin` was an actor.* predicate; under the spec/shape binding
// redesign (epic #2281) a caller predicate is a `spec` bound to an
// @actor shape, not a trait (a trait is the deliberately-unbound row
// predicate over payload fields). It now lives in dsl/common/specs.memql
// as `spec actorEnvelope requiresAdmin`.

// ---- specs/v1/common/statusIsActive.memql ----

/// Matches records with active status
trait statusIsActive {
  return status=="active"
}

// ---- specs/v1/common/statusIsArchived.memql ----

/// Matches records with payload.status == 'archived'.
trait statusIsArchived {
  return status=="archived"
}

// ---- specs/v1/common/statusIsSaved.memql ----

/// Matches records with payload.status == 'saved'.
trait statusIsSaved {
  return status=="saved"
}

// ---- statusIsPending ----
//
// Reusable filter that matches records with payload.status == 'pending'.
// Used by identity flows (access requests, invitations) where pending
// rows are queued for action by an admin or the original requester.

/// Matches records with payload.status == 'pending'.
trait statusIsPending {
  return status=="pending"
}

// ---- statusIsRunning ----
//
// Reusable filter that matches records with payload.status == 'running'.
// Used by planner Plans / Tasks and by worker invocations that are
// actively executing right now.

/// Matches records with payload.status == 'running'.
trait statusIsRunning {
  return status=="running"
}

// ---- identityIsApiKey ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "api_key". Distinct from worker tokens
// (identityIsWorkerToken) so callers can scope per-credential-class
// queries explicitly.

/// Matches v1:identity:identity rows with identityType=='api_key'.
trait identityIsApiKey {
  return identityType=="api_key"
}

// ---- identityIsWorkerToken ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "worker_token". Worker tokens are admitted
// only on the WorkerService gRPC path; this trait scopes per-worker
// credential lookups.

/// Matches v1:identity:identity rows with identityType=='worker_token'.
trait identityIsWorkerToken {
  return identityType=="worker_token"
}

// ---- identityIsNodeToken ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "node_token". Node tokens authenticate
// inter-node NodeService.Stream peer calls (memql#105 / #338); this
// trait scopes per-node credential lookups used by the bootstrap-
// minted identity-row persistence path (memql#343).

/// Matches v1:identity:identity rows with identityType=='node_token'.
trait identityIsNodeToken {
  return identityType=="node_token"
}

// ---- identityIsBadge ----
//
// Concept-targeted trait for v1:identity:identity rows whose
// identityType field is "badge". Badges are registered operator
// credentials for shared terminals (memql#2513): the identity
// service's POST /auth/badge/grant exchange looks rows up by
// credentials.keyHash to mint a short-lived class="badge" grant
// token for the owning user.

/// Matches v1:identity:identity rows with identityType=='badge'.
trait identityIsBadge {
  return identityType=="badge"
}

// ---- isDeletionScheduled ----
//
// Matches records that carry a non-empty deletionScheduledAt field.
// Used by the user-deletion cooldown sweep to enumerate identities
// queued for hard delete after the retention window expires.

/// Matches records that have a deletion scheduled (deletionScheduledAt is set).
trait isDeletionScheduled {
  return deletionScheduledAt!=""
}
