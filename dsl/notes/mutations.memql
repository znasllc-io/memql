// notes domain -- caller-scoped writes.
//
// Authz tier: owned. Every mutation stamps ownerUserId from
// actor.userId server-side (never from a caller-supplied arg) so a
// caller can neither create a note owned by someone else nor
// reassign an existing note's owner. The update path re-inserts a
// new version of the row (memQL's insert-versioning model -- there
// is no in-place update block); ownerUserId is re-stamped on every
// version so ownership is immutable across the row's history.
// updatedAt is stamped to `now` on every write.

use notes.concepts.{ note }

@enabled
@description("Create a note for the caller. Owned: ownerUserId is stamped from actor.userId, so a caller can only ever create their own notes. title and tags are optional; body is required. updatedAt is stamped to now.")
mutation note mutationCreateNote {
  args {
    noteId  string    @required
    title   string
    body    string    @required
    tags    []string
  }
  insert {
    id: args.noteId
    ownerUserId: actor.userId
    args.title
    args.body
    args.tags
    updatedAt: now
  }
}

@enabled
@description("Update a note (title / body / tags) by inserting a new version with the supplied payload. Owned: ownerUserId is re-stamped from actor.userId so a caller can never reassign ownership; updatedAt is re-stamped to now. The caller threads the full merged payload built from the current row plus the changed fields.")
mutation note mutationUpdateNote {
  args {
    noteId   string  @required
    payload  object  @required
  }
  insert {
    id: args.noteId
    ownerUserId: actor.userId
    updatedAt: now
    args.payload
  }
}
