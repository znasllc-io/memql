// notes domain -- caller-scoped reads.
//
// Authz tier: owned. Every filter gates on
// payload.ownerUserId==actor.userId so a caller can only ever read
// their own notes; no arg widens the row set beyond their ownership.

use notes.concepts.{ note }

@enabled
@description("List the caller's notes. Owned: the row set is gated by ownerUserId==actor.userId server-side, so cross-user reads are impossible.")
query note notes {
  filter  ownerUserId==actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full notes-list pull. Literal page size --
  // the struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape    noteFull
}

@enabled
@description("Fetch a single note by id, gated to the caller. Owned: ownerUserId==actor.userId is the load-bearing guard, so a caller can never read another user's note even with its id. Used by the update tool to confirm the row exists before re-inserting a new version.")
@mcp
@unbounded("note by id (guarded) gated to the caller -- bounded to a single row")
query note noteById {
  args {
    noteId  string  @required
  }
  filter  when(args.noteId) { id==args.noteId } && ownerUserId==actor.userId
  shape   noteFull
}

@enabled
@description("Search the caller's notes by tag. Owned: ownerUserId==actor.userId gates the row set server-side; the tag predicate narrows to notes carrying the given tag. Body substring matching is done client-side over this caller-scoped result so the search never leaks across users.")
query note notesByTag {
  args {
    tag  string  @required
  }
  filter  ownerUserId==actor.userId && when(args.tag) { args.tag in tags }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full tag-filtered notes pull. Literal page
  // size -- the struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape    noteFull
}
