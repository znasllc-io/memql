// queries.memql
//
// Authoring-namespace read surface (epic memql#954, issue #955).
// Every query is caller-scoped (filter on payload.ownerUserId ==
// actor.userId) -- authored bundles + constructs are owned data, only
// the author reads them. Backs the management UI, the gate runners
// (#956/#958), the authored runtime loader (#959), and the compose-first
// catalog matcher (#957).

use authoring.concepts.{ bundle, construct, dependencyEdge }
use authoring.shapes.{ bundleFull, constructFull, dependencyEdgeFull }
use common.traits.{ traitStatusIsActive }

@enabled
@description("All authoring bundles owned by the caller, newest first. Backs the 'my authored capabilities' management list.")
query bundle queryAuthoringBundlesForOwner {
  filter  payload.ownerUserId==actor.userId
  shape   bundleFull
}

@enabled
@description("One authoring bundle by id, scoped to the caller. Backs the gate runners + the approval (Gate 3) artifact view.")
query bundle queryAuthoringBundleById {
  args {
    bundleId  string  @required
  }
  filter  payload.ownerUserId==actor.userId && id==args.bundleId
  shape   bundleFull
}

@enabled
@description("The caller's currently-active bundles. Backs the authored-construct runtime loader (#959) -- the set of authored automations to register on boot / on change.")
query bundle queryActiveAuthoringBundles {
  filter  payload.ownerUserId==actor.userId && traitStatusIsActive
  shape   bundleFull
}

// SYSTEM-SCOPED active-bundle query (#1039). Unlike the owner-scoped
// queries above, this returns EVERY active bundle across ALL owners --
// there is NO payload.ownerUserId==actor.userId filter. It exists for one
// caller: the boot-time authored-runtime re-arm (wireAuthoredRuntime),
// which must enumerate other owners' active bundles to re-register their
// constructs after a restart. A normal user never reads through it.
//
// Per-row-authz classification: ADMIN. The `actor.isClusterOwner == true`
// gate is the cluster-owner spec the per-row-authz audit
// (docs/auth/per-row-authz-audit.md) requires for a cross-owner read --
// it both classifies the query as admin (dsl/conformance_test.go) and
// REALLY gates it: a non-cluster-owner caller matches nothing (the actor
// constant binds false). The boot re-arm runs under a cluster-owner
// envelope, so it sees every owner's active bundles; per-owner construct
// loads + the scheduler run then re-stamp the BUNDLE AUTHOR's envelope so
// no privilege escalation leaks into the fired automation.
@enabled
@description("ADMIN/SYSTEM: every active authoring bundle across ALL owners (NOT owner-scoped). Cluster-owner gated. Backs the boot-time authored-runtime re-arm (#1039) that re-registers active bundles' automations after a restart.")
query bundle querySystemActiveAuthoringBundles {
  filter  actor.isClusterOwner==true && traitStatusIsActive
  shape   bundleFull
}

@enabled
@description("The bundle compiled from a given Responsibility, scoped to the caller. Lets the planner find the existing artifact when a Responsibility is edited (to supersede rather than duplicate).")
query bundle queryAuthoringBundleForResponsibility {
  args {
    responsibilityId  string  @required
  }
  filter  payload.ownerUserId==actor.userId && payload.responsibilityId==args.responsibilityId
  shape   bundleFull
}

@enabled
@description("The bundle post-hoc captured from a given Plan (everyday-task capture path, #1161), scoped to the caller. Lets the capture orchestrator skip re-authoring a task it already captured (idempotency on a re-delivered terminal Plan event) and backs the per-task view/edit/export surface (#1162).")
query bundle queryAuthoringBundleForPlan {
  args {
    sourcePlanId  string  @required
  }
  filter  payload.ownerUserId==actor.userId && payload.sourcePlanId==args.sourcePlanId
  shape   bundleFull
}

@enabled
@description("All authored constructs belonging to a bundle, scoped to the caller. Backs the gate runners (compile/bind the whole closure) + the runtime register/unregister path.")
query construct queryAuthoringConstructsForBundle {
  args {
    bundleId  string  @required
  }
  filter  payload.ownerUserId==actor.userId && payload.bundleId==args.bundleId
  shape   constructFull
}

@enabled
@description("The caller's cataloged (reusable) constructs. Backs the compose-first matcher (#957): the planner searches these before authoring a net-new dependency.")
query construct queryCataloguedConstructsForOwner {
  filter  payload.ownerUserId==actor.userId && payload.catalogued==true
  shape   constructFull
}

@enabled
@description("All dependency edges declared by a bundle (what it depends on), scoped to the caller. Backs dependency-closure inspection for a bundle.")
query dependencyEdge queryDependencyEdgesForBundle {
  args {
    bundleId  string  @required
  }
  filter  payload.ownerUserId==actor.userId && payload.bundleId==args.bundleId
  shape   dependencyEdgeFull
}

@enabled
@description("IMPACT ANALYSIS (#957): every edge that depends ON a given construct, scoped to the caller. The dependents to re-validate before changing a shared / cataloged construct. The caller joins bundleId -> v1:authoring:bundle to filter to ACTIVE dependents.")
query dependencyEdge queryDependentsOfConstruct {
  args {
    toName  string  @required
    toKind  string  @required
  }
  filter  payload.ownerUserId==actor.userId && payload.toName==args.toName && payload.toKind==args.toKind
  shape   dependencyEdgeFull
}

@enabled
@description("Every dependency edge owned by the caller. Backs a full dependency-graph view.")
query dependencyEdge queryDependencyEdgesForOwner {
  filter  payload.ownerUserId==actor.userId
  shape   dependencyEdgeFull
}
