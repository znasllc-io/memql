// queries.memql
//
// Authoring-namespace read surface (epic memql#954, issue #955).
// Every query is caller-scoped (filter on payload.ownerUserId ==
// actor.userId) -- authored bundles + constructs are owned data, only
// the author reads them. Backs the management UI, the gate runners
// (#956/#958), the authored runtime loader (#959), and the compose-first
// catalog matcher (#957).

use common.traits.{ statusIsActive }

/// All authoring bundles owned by the caller, newest first. Backs the 'my authored capabilities'
/// management list.
@actor
query bundle authoringBundlesForOwner {
  filter  ownerUserId==actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   bundleFull
}

/// One authoring bundle by id, scoped to the caller. Backs the gate runners + the approval (Gate 3)
/// artifact view.
@actor
query bundle authoringBundleById {
  args {
    bundleId  string!
  }
  filter  ownerUserId==actor.userId && id==args.bundleId
  shape   bundleFull
}

/// The caller's currently-active bundles. Backs the authored-construct runtime loader (#959) -- the
/// set of authored automations to register on boot / on change.
@actor
query bundle activeAuthoringBundles {
  filter  ownerUserId==actor.userId && statusIsActive
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   bundleFull
}

/// ADMIN/SYSTEM: every active authoring bundle across ALL owners (NOT owner-scoped). Cluster-owner
/// gated. Backs the boot-time authored-runtime re-arm (#1039) that re-registers active bundles'
/// automations after a restart.
@actor
query bundle systemActiveAuthoringBundles {
  filter  actor.isClusterOwner==true && statusIsActive
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   bundleFull
}

/// The bundle compiled from a given Responsibility, scoped to the caller. Lets the planner find the
/// existing artifact when a Responsibility is edited (to supersede rather than duplicate).
@unbounded("the authoring bundle for one responsibility -- bounded to a single row")
@actor
query bundle authoringBundleForResponsibility {
  args {
    responsibilityId  string!
  }
  filter  ownerUserId==actor.userId && responsibilityId==args.responsibilityId
  shape   bundleFull
}

/// The bundle post-hoc captured from a given Plan (everyday-task capture path, #1161), scoped to
/// the caller. Lets the capture orchestrator skip re-authoring a task it already captured
/// (idempotency on a re-delivered terminal Plan event) and backs the per-task view/edit/export
/// surface (#1162).
@unbounded("the authoring bundle for one source plan -- bounded to a single row")
@actor
query bundle authoringBundleForPlan {
  args {
    sourcePlanId  string!
  }
  filter  ownerUserId==actor.userId && sourcePlanId==args.sourcePlanId
  shape   bundleFull
}

/// All authored constructs belonging to a bundle, scoped to the caller. Backs the gate runners
/// (compile/bind the whole closure) + the runtime register/unregister path.
@unbounded("constructs within one bundle -- bounded by the bundle; the caller compiles the whole bundle")
@actor
query construct authoringConstructsForBundle {
  args {
    bundleId  string!
  }
  filter  ownerUserId==actor.userId && bundleId==args.bundleId
  shape   constructFull
}

/// The caller's cataloged (reusable) constructs. Backs the compose-first matcher (#957): the
/// planner searches these before authoring a net-new dependency.
@actor
query construct cataloguedConstructsForOwner {
  filter  ownerUserId==actor.userId && catalogued==true
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   constructFull
}

/// All dependency edges declared by a bundle (what it depends on), scoped to the caller. Backs
/// dependency-closure inspection for a bundle.
@unbounded("dependency edges within one bundle -- the full edge set is needed to compile the bundle")
@actor
query dependencyEdge dependencyEdgesForBundle {
  args {
    bundleId  string!
  }
  filter  ownerUserId==actor.userId && bundleId==args.bundleId
  shape   dependencyEdgeFull
}

/// IMPACT ANALYSIS (#957): every edge that depends ON a given construct, scoped to the caller. The
/// dependents to re-validate before changing a shared / cataloged construct. The caller joins
/// bundleId -> v1:authoring:bundle to filter to ACTIVE dependents.
@unbounded("dependents of a construct -- the full dependent set is needed for impact analysis")
@actor
query dependencyEdge dependentsOfConstruct {
  args {
    toName  string!
    toKind  string!
  }
  filter  ownerUserId==actor.userId && toName==args.toName && toKind==args.toKind
  shape   dependencyEdgeFull
}

/// Every dependency edge owned by the caller. Backs a full dependency-graph view.
@actor
query dependencyEdge dependencyEdgesForOwner {
  filter  ownerUserId==actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "createdAt", "desc"
  paginate 50
  shape   dependencyEdgeFull
}
