// queries.memql
//
// Authoring-namespace read surface (epic memql#954, issue #955).
// Every query is caller-scoped (filter on row.ownerUserId ==
// actor.userId) -- authored bundles + constructs are owned data, only
// the author reads them. Backs the management UI, the gate runners
// (#956/#958), the authored runtime loader (#959), and the compose-first
// catalog matcher (#957).

use common.traits.{ statusIsActive }

/// All authoring bundles owned by the caller, newest first. Backs the 'my authored capabilities'
/// management list.
@actor
query bundle authoringBundlesForOwner {
  filter  row => row.ownerUserId == actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   bundleFull
}

/// One authoring bundle by id, scoped to the caller. Backs the gate runners + the approval (Gate 3)
/// artifact view.
@actor
query bundle authoringBundleById {
  args {
    bundleId  string!
  }
  filter  row => row.ownerUserId == actor.userId && row.id == args.bundleId
  shape   bundleFull
}

/// The caller's currently-active bundles. Backs the authored-construct runtime loader (#959) -- the
/// set of authored automations to register on boot / on change.
@actor
query bundle activeAuthoringBundles {
  filter  row => row.ownerUserId == actor.userId && statusIsActive(row)
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   bundleFull
}

// SYSTEM-SCOPED active-bundle query (#1039). Unlike the owner-scoped
// queries above, this returns EVERY active bundle across ALL owners --
// there is NO `row.ownerUserId == actor.userId` filter. It exists for one
// caller: the boot-time authored-runtime re-arm (wireAuthoredRuntime),
// which must enumerate other owners' active bundles to re-register their
// constructs after a restart. A normal user never reads through it.
//
// Per-row-authz classification: ADMIN. The `actor.isClusterOwner == true`
// gate is the cluster-owner spec the per-row-authz audit
// (docs/public/operate/auth/per-row-authz-audit.md) requires for a cross-owner read --
// it both classifies the query as admin (test/dslconformance/conformance_test.go) and
// REALLY gates it: a non-cluster-owner caller matches nothing (the actor
// constant binds false). The boot re-arm runs under a cluster-owner
// envelope, so it sees every owner's active bundles; per-owner construct
// loads + the scheduler run then re-stamp the BUNDLE AUTHOR's envelope so
// no privilege escalation leaks into the fired automation.
/// ADMIN/SYSTEM: every active authoring bundle across ALL owners (NOT owner-scoped). Cluster-owner
/// gated. Backs the boot-time authored-runtime re-arm (#1039) that re-registers active bundles'
/// automations after a restart.
@actor
query bundle systemActiveAuthoringBundles {
  filter  row => actor.isClusterOwner == true && statusIsActive(row)
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   bundleFull
}

/// The bundle compiled from a given Responsibility, scoped to the caller. Lets the planner find the
/// existing artifact when a Responsibility is edited (to supersede rather than duplicate).
@unbounded("the authoring bundle for one responsibility -- bounded to a single row")
@actor
query bundle authoringBundleForResponsibility {
  args {
    responsibilityId  string!
  }
  filter  row => row.ownerUserId == actor.userId && row.responsibilityId == args.responsibilityId
  shape   bundleFull
}

/// The bundle post-hoc captured from a given run (the capture path, epic memql#1160), scoped to
/// the caller. Lets the capture orchestrator skip re-authoring a run it already captured
/// (idempotency on a re-delivered terminal run event) and backs the per-run view/edit/export
/// surface.
@unbounded("the authoring bundle for one source run -- bounded to a single row")
@actor
query bundle authoringBundleForRun {
  args {
    sourceRunId  string!
  }
  filter  row => row.ownerUserId == actor.userId && row.sourceRunId == args.sourceRunId
  shape   bundleFull
}

/// All authored constructs belonging to a bundle, scoped to the caller. Backs the gate runners
/// (compile/bind the whole closure) + the runtime register/unregister path.
@unbounded("constructs within one bundle -- bounded by the bundle; the caller compiles the whole bundle")
@actor
query construct authoringConstructsForBundle {
  args {
    bundleId  string!
  }
  filter  row => row.ownerUserId == actor.userId && row.bundleId == args.bundleId
  shape   constructFull
}

/// The caller's cataloged (reusable) constructs. Backs the compose-first matcher (#957): the
/// planner searches these before authoring a net-new dependency.
@actor
query construct cataloguedConstructsForOwner {
  filter  row => row.ownerUserId == actor.userId && row.catalogued == true
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   constructFull
}

/// All dependency edges declared by a bundle (what it depends on), scoped to the caller. Backs
/// dependency-closure inspection for a bundle.
@unbounded("dependency edges within one bundle -- the full edge set is needed to compile the bundle")
@actor
query dependencyEdge dependencyEdgesForBundle {
  args {
    bundleId  string!
  }
  filter  row => row.ownerUserId == actor.userId && row.bundleId == args.bundleId
  shape   dependencyEdgeFull
}

/// IMPACT ANALYSIS (#957): every edge that depends ON a given construct, scoped to the caller. The
/// dependents to re-validate before changing a shared / cataloged construct. The caller joins
/// bundleId -> v1:authoring:bundle to filter to ACTIVE dependents.
@unbounded("dependents of a construct -- the full dependent set is needed for impact analysis")
@actor
query dependencyEdge dependentsOfConstruct {
  args {
    toName  string!
    toKind  string!
  }
  filter  row => row.ownerUserId == actor.userId && row.toName == args.toName && row.toKind == args.toKind
  shape   dependencyEdgeFull
}

/// Every dependency edge owned by the caller. Backs a full dependency-graph view.
@actor
query dependencyEdge dependencyEdgesForOwner {
  filter  row => row.ownerUserId == actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   dependencyEdgeFull
}

/// The caller's catalogued construct for one goal signature -- compile's EXACT-MATCH tier (epic
/// memql#4966). Pushed down as a filter rather than folded in Go after a full catalog pull, because
/// the exact tier is the one that must stay cheap: it is what makes a repeated goal reach no model
/// at all, and paging an owner's whole catalog to find one row would put a cost on the free path
/// that grows with how much the person has already automated.
@actor
@unbounded("one goal signature -- the catalog holds at most a handful of constructs per signature, and compile reads them all to rank by reliability")
query construct cataloguedConstructsForGoalSignature {
  args {
    goalSignature  string!
  }
  filter  row => row.ownerUserId == actor.userId
              && row.catalogued == true
              && row.goalSignature == args.goalSignature
  shape   constructFull
}

/// One owned authored construct by its stored identity. Work execution uses the run's template
/// reference, then verifies its bundle and recompiles the complete closure on the executing node.
@actor
query construct authoringConstructById {
  args { constructId string! }
  filter row => row.ownerUserId == actor.userId && row.id == args.constructId
  shape constructFull
}

/// The caller's learned procedures on a SERVABLE rung for one goal signature -- the ladder's half of
/// compile's exact-match tier (epic memql#5408). Compile reads it beside
/// cataloguedConstructsForGoalSignature and runs every row through component/work.DecideServe, which
/// is what decides whether a rung serves: shadow is returned so that decision can say "the app
/// serves and the construct replays beside it", and candidate and retired are excluded here because
/// nothing ever serves from either. A learned procedure is served through the LADDER, never by being
/// catalogued, which is why this does not ask `catalogued`. The shadow comparison reads it too, to
/// find the procedures a succeeded recording is compared against.
@actor
@unbounded("one goal signature -- an owner holds at most a handful of learned procedures per signature, and compile reads them all to rank trusted before canary")
query construct procedureConstructsForGoalSignature {
  args {
    goalSignature  string!
  }
  filter  row => row.ownerUserId == actor.userId
              && row.goalSignature == args.goalSignature
              && row.ladder in ["shadow", "canary", "trusted"]
  shape   constructFull
}

/// The caller's learned procedures, newest first, on every rung -- retired included, because Nexus
/// shows where each one stands and the ladder's sweeps walk them all, page by page. A learned
/// procedure is a construct the lift wrote into the `procedure` target namespace; nothing authored
/// is ever written there.
@actor
query construct learnedProceduresForOwner {
  filter   row => row.ownerUserId == actor.userId && row.targetNamespace == "procedure"
  sort     "row.createdAt", "desc"
  paginate 100
  shape    procedureCard
}

/// One of the caller's learned procedures by NAME -- the idempotent lift (epic memql#5408, G15). The
/// name is derived from the corpus key, so a re-mine of the same corpus proposes the same name, and
/// the lift reads this before it writes: absent means create, present with the same procedureHash
/// means write nothing, present with a different one means re-lift in place.
///
/// NEWEST FIRST, AND ONE ROW. Before the lift became idempotent every re-mine minted a fresh
/// construct under the same name, so an owner can hold several; the most recently written is the one
/// the lift continues. The older ones carry no rung and nothing serves them.
@actor
query construct procedureConstructByName {
  args {
    name  string!
  }
  filter   row => row.ownerUserId == actor.userId
               && row.name == args.name
               && row.targetNamespace == "procedure"
  sort     "row.createdAt", "desc"
  paginate 1
  shape    constructFull
}

/// The certification ladder's values: the one row `seed ladderPolicy primary` writes
/// (dsl/authoring/seeds.memql), pinned to its literal id so a row at any other id is never read as
/// the policy. Readable from the `reader` rung up -- every predefined role -- and @requiresRank
/// bounds the callers to exactly the concept's read floor, so the tier decides the whole row set
/// for every caller this admits. The Go reader treats an absent or refused row as
/// component/work.DefaultLadderPolicy(), which carries the seed's numbers.
@requiresRank("reader")
query ladderPolicy ladderPolicyCurrent {
  filter  row => row.id == "v1:authoring:ladderPolicy:primary"
  shape   ladderPolicyFull
}
