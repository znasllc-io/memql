// shapes.memql
//
// Projections for the authoring namespace (epic memql#954, issue #955).
// Comprehensive @row shapes over v1:authoring:bundle + v1:authoring:construct
// for the management UI, the gate runners, and the authored runtime loader.

/// Comprehensive bundle projection: every field including the validation/dry-run reports and
/// lifecycle timestamps. Backs the management list, the Gate 3 approval artifact, and the runtime
/// loader.
@row
shape bundle bundleFull {
  row.id
  ownerUserId
  responsibilityId
  sourceRunId
  title
  summary
  status
  version
  supersedesBundleId
  reusedConstructRefs
  validationReport
  dryRunReport
  failureReason
  activatedAt
  retiredAt
  row.createdAt
  row.createdBy
}

/// Comprehensive construct projection: source + cached compiled form + catalog metadata. Backs the
/// gate runners (compile/bind the closure), the runtime register path, and the catalog matcher.
@row
shape construct constructFull {
  row.id
  ownerUserId
  bundleId
  kind
  name
  targetNamespace
  source
  // origin is what a promoted CONCEPT re-derives its canonical id from at
  // re-hydration (epic memql#5375). A body-carrying shape projects ONLY the
  // paths it lists, so leaving it out would make the row's origin invisible to
  // the boot walk however faithfully it is stored -- the defect the
  // grammarVersion and conceptRetired notes below both record.
  origin
  // grammarVersion is stamped at create by the durable promote/stage write path
  // and read by explainStaleGrammarStamp, which turns a recompile failure into
  // the named memqlmigrate command instead of a raw parse error. It was MISSING
  // from this list until memql#3929, so AuthoringConstructRow.GrammarVersion was
  // always empty and that diagnosis could never fire -- the same class of defect
  // the conceptRetired note below records, on the field that explains failures.
  grammarVersion
  compiledForm
  status
  // conceptRetired is what the boot re-hydration reads to replay a demoted
  // concept as retired rather than active (memql#3756). A body-carrying shape
  // projects ONLY the paths it lists, so a field missing here is a field the
  // re-hydration cannot see, whatever the row stores.
  conceptRetired
  // conceptDataStaged is the same class of field (epic memql#3974): the boot
  // re-hydration folds it per canonical concept id to decide whether a promoted
  // concept's rows are visible, and the fold's silent direction is the one where
  // the field reads false. Listed here to keep the projection in step with the
  // row for every consumer that receives the SHAPED form -- the SDK, the wire,
  // the review surfaces -- rather than only the sparse stored payload the
  // in-process boot walk happens to read today.
  conceptDataStaged
  catalogued
  catalogKey
  catalogMatchText
  catalogedAt
  catalogedFromBundleId
  goalSignature
  reliability
  reinforceCount
  lastReinforced
  // The certification ladder (epic memql#5408), listed for the reason every
  // note above gives: a body-carrying shape projects ONLY the paths it lists,
  // and authoringConstructById is how the replay runner, the promotion
  // decision and compile read a construct -- a field missing here is a field
  // none of them can see, whatever the row stores.
  ladder
  preconditions
  procedure
  procedureHash
  shadowMatches
  canaryMatches
  distinctBindings
  failures
  insufficient
  promotionApprovalId
  lastReplayAt
  ladderReason
  ladderChangedAt
  // Reuse (epic memql#5414, D24), listed for the reason every note above
  // gives: the sweep, compile's section tiers and Nexus read constructs
  // through this shape.
  reuse
  reuseEvidence
  reuseOverride
  row.createdAt
  row.createdBy
}

/// Dependency edge projection (#957): from-construct, to-construct, resolution source, and owning
/// bundle. Backs dependency-closure + impact-analysis views.
@row
shape dependencyEdge dependencyEdgeFull {
  row.id
  ownerUserId
  bundleId
  fromConstruct
  fromKind
  toName
  toKind
  toSource
  row.createdAt
  row.createdBy
}

/// A learned procedure as Nexus lists and opens it (epic memql#5408): where it stands on the
/// certification ladder and the evidence that put it there, its reliability, and what it replays --
/// the procedure template, its learned preconditions and the version hash an approval pins. The
/// rendered MemQL source is deliberately NOT here: the list does not show it, and a page that needs
/// it reads the construct whole through authoringConstructById.
@row
shape construct procedureCard {
  row.id
  name
  kind
  status
  ladder
  shadowMatches
  canaryMatches
  distinctBindings
  failures
  insufficient
  promotionApprovalId
  lastReplayAt
  ladderReason
  ladderChangedAt
  reliability
  reinforceCount
  lastReinforced
  goalSignature
  procedure
  preconditions
  procedureHash
  bundleId
  // Reuse (epic memql#5414, D24): Nexus shows the label on every row.
  reuse
  reuseEvidence
  reuseOverride
  row.createdAt
}

/// The certification ladder's values, every one of them, and when the seed last wrote the row.
@row
shape ladderPolicy ladderPolicyFull {
  row.id
  shadowMatches
  distinctBindings
  canaryMatches
  failuresToDemote
  insufficientToDemote
  retireAfterDays
  row.createdAt
}
