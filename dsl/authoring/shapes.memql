// shapes.memql
//
// Projections for the authoring namespace (epic memql#954, issue #955).
// Comprehensive @row shapes over v1:authoring:bundle + v1:authoring:construct
// for the management UI, the gate runners, and the authored runtime loader.

@row
@description("Comprehensive bundle projection: every field including the validation/dry-run reports and lifecycle timestamps. Backs the management list, the Gate 3 approval artifact, and the runtime loader.")
shape bundle bundleFull {
  row.id
  ownerUserId
  responsibilityId
  sourcePlanId
  title
  summary
  status
  version
  supersedesBundleId
  reusedConstructRefs
  validationReport
  dryRunReport
  failureReason
  activatedAt
  retiredAt
  row.createdAt
  row.createdBy
}

@row
@description("Comprehensive construct projection: source + cached compiled form + catalog metadata. Backs the gate runners (compile/bind the closure), the runtime register path, and the catalog matcher.")
shape construct constructFull {
  row.id
  ownerUserId
  bundleId
  kind
  name
  targetNamespace
  source
  compiledForm
  status
  catalogued
  catalogKey
  catalogMatchText
  catalogedAt
  catalogedFromBundleId
  row.createdAt
  row.createdBy
}

@row
@description("Dependency edge projection (#957): from-construct, to-construct, resolution source, and owning bundle. Backs dependency-closure + impact-analysis views.")
shape dependencyEdge dependencyEdgeFull {
  row.id
  ownerUserId
  bundleId
  fromConstruct
  fromKind
  toName
  toKind
  toSource
  row.createdAt
  row.createdBy
}
