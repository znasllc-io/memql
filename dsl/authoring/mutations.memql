// mutations.memql
//
// Authoring-namespace write surface (epic memql#954, issue #955).
// Lifecycle mutations for v1:authoring:bundle + v1:authoring:construct.
// Every mutation server-stamps ownerUserId from actor.userId (never
// caller-supplied) -- authored automations run under the author's authz
// envelope, so ownership is the per-row gate. No engine wiring here;
// the gates (#956 validation, #958 dry-run) and the authored runtime
// (#959) call these to record state.

@description("Create a draft authoring bundle -- the atomic unit a Responsibility compiles into. ownerUserId is stamped from actor.userId. Members are added via createAuthoringConstruct; reused (composed) constructs are recorded on reusedConstructRefs.")
@actor
mutate bundle createAuthoringBundle {
  args {
    bundleId            string!
    title               string!
    summary             string
    responsibilityId    string
    sourcePlanId        string
    version             int
    supersedesBundleId  string
    reusedConstructRefs []object
  }
  insert {
    accept { title, summary, responsibilityId, sourcePlanId, supersedesBundleId, reusedConstructRefs }
    stamp {
      id: args.bundleId
      ownerUserId: actor.userId
      version: coalesce(args.version, 1)
      status: "draft"
    }
  }
}

@description("Create an authored construct (the .memql source for one automation / logic / shape / spec / trait / policy / mutation / query / prompt) as a member of a bundle. ownerUserId stamped from actor.userId; status starts draft and follows the bundle.")
@actor
mutate construct createAuthoringConstruct {
  args {
    constructId      string!
    bundleId         string!
    kind             enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")!
    name             string!
    targetNamespace  string!
    source           string!
    grammarVersion   string
  }
  insert {
    accept { bundleId, kind, name, targetNamespace, source, grammarVersion }
    stamp {
      id: args.constructId
      ownerUserId: actor.userId
      status: "draft"
    }
  }
}

@description("Record the Gate 1 (isolated compile+bind, #956) result on a bundle and transition status. status is validated on success or failed on a binding error; validationReport carries the structured diagnostics; failureReason carries the headline on failure. Re-stamps ownerUserId (keeps the row owned + satisfies per-row authz).")
@actor
mutate bundle recordBundleValidation {
  args {
    bundleId          string!
    status            enum("validated", "failed")!
    validationReport  object!
    failureReason     string
  }
  update {
    accept { status, validationReport, failureReason }
    stamp {
      id: args.bundleId
      ownerUserId: actor.userId
    }
  }
}

@description("Record the Gate 2 (tiered behavioral dry-run, #958) result on a bundle and transition status. status is dryRunPassed on success or failed otherwise; dryRunReport carries the trace + side-effect manifest + cost estimate (the Gate 3 approval artifact).")
@actor
mutate bundle recordBundleDryRun {
  args {
    bundleId       string!
    status         enum("dryRunPassed", "failed")!
    dryRunReport   object!
    failureReason  string
  }
  update {
    accept { status, dryRunReport, failureReason }
    stamp {
      id: args.bundleId
      ownerUserId: actor.userId
    }
  }
}

@description("Activate a bundle after Gate 3 approval: status -> active and activatedAt stamped. The authored-construct runtime (#959) registers the bundle's constructs on this transition; member constructs are flipped to active via setConstructStatus.")
@actor
mutate bundle activateAuthoringBundle {
  args {
    bundleId  string!
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    status: "active"
    activatedAt: now
  }
}

@description("Generic lifecycle transition for the remaining bundle states: paused (circuit breaker / user hold), retired (superseded or removed), or failed. retiredAt is stamped by retireAuthoringBundle; this mutation handles pause/unpause + failed. failureReason optional.")
@actor
mutate bundle setAuthoringBundleStatus {
  args {
    bundleId       string!
    status         enum("draft", "paused", "active", "failed")!
    failureReason  string
  }
  update {
    accept { status, failureReason }
    stamp {
      id: args.bundleId
      ownerUserId: actor.userId
    }
  }
}

@description("Retire a bundle: status -> retired and retiredAt stamped. Used when a new version supersedes it or the user removes the capability. The authored runtime (#959) unregisters its constructs on this transition.")
@actor
mutate bundle retireAuthoringBundle {
  args {
    bundleId  string!
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    status: "retired"
    retiredAt: now
  }
}

@description("Set a construct's lifecycle status (draft / active / retired), following its parent bundle. The authored runtime flips constructs to active on bundle activation and retired on bundle retirement.")
@actor
mutate construct setConstructStatus {
  args {
    constructId  string!
    status       enum("draft", "active", "retired")!
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    args.status
  }
}

@description("Store the cached compiled form for a construct, produced by the Gate 1 compile+bind harness (#956), so activation doesn't re-parse.")
@actor
mutate construct setConstructCompiledForm {
  args {
    constructId   string!
    compiledForm  object!
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    args.compiledForm
  }
}

@description("Promote a construct into the owner's reusable catalog with provenance (#957): catalogued -> true, catalogKey set to the dedup signature, catalogMatchText set to the embedded near-match text, and the provenance pair (catalogedAt + catalogedFromBundleId) stamped so later bundles that compose it inherit where it came from. The embedding itself is written separately into node_vectors by the Go catalog-write path (PromoteConstructToCatalog). Called post-activation as the catalog-write path.")
@actor
mutate construct catalogueConstruct {
  args {
    constructId       string!
    catalogKey        string!
    catalogMatchText  string!
    fromBundleId      string!
  }
  update {
    accept { catalogKey, catalogMatchText }
    stamp {
      id: args.constructId
      ownerUserId: actor.userId
      catalogued: true
      catalogedAt: now
      catalogedFromBundleId: args.fromBundleId
    }
  }
}

@description("Record one dependency edge for a bundle's construct (#957). Written by the compile/bind pass once it resolves a construct's references. ownerUserId stamped from actor.userId.")
@actor
mutate dependencyEdge recordDependencyEdge {
  args {
    edgeId         string!
    bundleId       string!
    fromConstruct  string!
    fromKind       enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")!
    toName         string!
    toKind         enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")!
    toSource       enum("core", "catalog", "bundle")!
  }
  insert {
    accept { bundleId, fromConstruct, fromKind, toName, toKind, toSource }
    stamp {
      id: args.edgeId
      ownerUserId: actor.userId
    }
  }
}
