// mutations.memql
//
// Authoring-namespace write surface (epic memql#954, issue #955).
// Lifecycle mutations for v1:authoring:bundle + v1:authoring:construct.
// Every mutation server-stamps ownerUserId from actor.userId (never
// caller-supplied) -- authored automations run under the author's authz
// envelope, so ownership is the per-row gate. No engine wiring here;
// the gates (#956 validation, #958 dry-run) and the authored runtime
// (#959) call these to record state.

use authoring.concepts.{ bundle, construct, dependencyEdge }

@enabled
@description("Create a draft authoring bundle -- the atomic unit a Responsibility compiles into. ownerUserId is stamped from actor.userId. Members are added via mutationCreateAuthoringConstruct; reused (composed) constructs are recorded on reusedConstructRefs.")
mutation bundle mutationCreateAuthoringBundle {
  args {
    bundleId            string  @required
    title               string  @required
    summary             string
    responsibilityId    string
    version             int
    supersedesBundleId  string
    reusedConstructRefs []object
  }
  insert {
    id: args.bundleId
    ownerUserId: actor.userId
    args.title
    args.summary
    args.responsibilityId
    args.supersedesBundleId
    args.reusedConstructRefs
    version: coalesce(args.version, 1)
    status: "draft"
  }
}

@enabled
@description("Create an authored construct (the .memql source for one automation / logic / shape / spec / trait / policy / mutation / query / prompt) as a member of a bundle. ownerUserId stamped from actor.userId; status starts draft and follows the bundle.")
mutation construct mutationCreateAuthoringConstruct {
  args {
    constructId      string  @required
    bundleId         string  @required
    kind             string  @required @enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")
    name             string  @required
    targetNamespace  string  @required
    source           string  @required
  }
  insert {
    id: args.constructId
    ownerUserId: actor.userId
    args.bundleId
    args.kind
    args.name
    args.targetNamespace
    args.source
    status: "draft"
  }
}

@enabled
@description("Record the Gate 1 (isolated compile+bind, #956) result on a bundle and transition status. status is validated on success or failed on a binding error; validationReport carries the structured diagnostics; failureReason carries the headline on failure. Re-stamps ownerUserId (keeps the row owned + satisfies per-row authz).")
mutation bundle mutationRecordBundleValidation {
  args {
    bundleId          string  @required
    status            string  @required @enum("validated", "failed")
    validationReport  object  @required
    failureReason     string
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    args.status
    args.validationReport
    args.failureReason
  }
}

@enabled
@description("Record the Gate 2 (tiered behavioral dry-run, #958) result on a bundle and transition status. status is dryRunPassed on success or failed otherwise; dryRunReport carries the trace + side-effect manifest + cost estimate (the Gate 3 approval artifact).")
mutation bundle mutationRecordBundleDryRun {
  args {
    bundleId       string  @required
    status         string  @required @enum("dryRunPassed", "failed")
    dryRunReport   object  @required
    failureReason  string
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    args.status
    args.dryRunReport
    args.failureReason
  }
}

@enabled
@description("Activate a bundle after Gate 3 approval: status -> active and activatedAt stamped. The authored-construct runtime (#959) registers the bundle's constructs on this transition; member constructs are flipped to active via mutationSetConstructStatus.")
mutation bundle mutationActivateAuthoringBundle {
  args {
    bundleId  string  @required
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    status: "active"
    activatedAt: timestamp()
  }
}

@enabled
@description("Generic lifecycle transition for the remaining bundle states: paused (circuit breaker / user hold), retired (superseded or removed), or failed. retiredAt is stamped by mutationRetireAuthoringBundle; this mutation handles pause/unpause + failed. failureReason optional.")
mutation bundle mutationSetAuthoringBundleStatus {
  args {
    bundleId       string  @required
    status         string  @required @enum("draft", "paused", "active", "failed")
    failureReason  string
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    args.status
    args.failureReason
  }
}

@enabled
@description("Retire a bundle: status -> retired and retiredAt stamped. Used when a new version supersedes it or the user removes the capability. The authored runtime (#959) unregisters its constructs on this transition.")
mutation bundle mutationRetireAuthoringBundle {
  args {
    bundleId  string  @required
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    status: "retired"
    retiredAt: timestamp()
  }
}

@enabled
@description("Set a construct's lifecycle status (draft / active / retired), following its parent bundle. The authored runtime flips constructs to active on bundle activation and retired on bundle retirement.")
mutation construct mutationSetConstructStatus {
  args {
    constructId  string  @required
    status       string  @required @enum("draft", "active", "retired")
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    args.status
  }
}

@enabled
@description("Store the cached compiled form for a construct, produced by the Gate 1 compile+bind harness (#956), so activation doesn't re-parse.")
mutation construct mutationSetConstructCompiledForm {
  args {
    constructId   string  @required
    compiledForm  object  @required
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    args.compiledForm
  }
}

@enabled
@description("Promote a construct into the owner's reusable catalog with provenance (#957): catalogued -> true, catalogKey set to the dedup signature, catalogMatchText set to the embedded near-match text, and the provenance pair (catalogedAt + catalogedFromBundleId) stamped so later bundles that compose it inherit where it came from. The embedding itself is written separately into node_vectors by the Go catalog-write path (PromoteConstructToCatalog). Called post-activation as the catalog-write path.")
mutation construct mutationCatalogueConstruct {
  args {
    constructId       string  @required
    catalogKey        string  @required
    catalogMatchText  string  @required
    fromBundleId      string  @required
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    catalogued: true
    args.catalogKey
    args.catalogMatchText
    catalogedAt: now
    catalogedFromBundleId: args.fromBundleId
  }
}

@enabled
@description("Record one dependency edge for a bundle's construct (#957). Written by the compile/bind pass once it resolves a construct's references. ownerUserId stamped from actor.userId.")
mutation dependencyEdge mutationRecordDependencyEdge {
  args {
    edgeId         string  @required
    bundleId       string  @required
    fromConstruct  string  @required
    fromKind       string  @required @enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")
    toName         string  @required
    toKind         string  @required @enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")
    toSource       string  @required @enum("core", "catalog", "bundle")
  }
  insert {
    id: args.edgeId
    ownerUserId: actor.userId
    args.bundleId
    args.fromConstruct
    args.fromKind
    args.toName
    args.toKind
    args.toSource
  }
}
