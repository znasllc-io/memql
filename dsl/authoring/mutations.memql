// mutations.memql
//
// Authoring-namespace write surface (epic memql#954, issue #955).
// Lifecycle mutations for v1:authoring:bundle + v1:authoring:construct.
// Every mutation server-stamps ownerUserId from actor.userId (never
// caller-supplied) -- authored automations run under the author's authz
// envelope, so ownership is the per-row gate. No engine wiring here;
// the gates (#956 validation, #958 dry-run) and the authored runtime
// (#959) call these to record state.

/// Create a draft authoring bundle -- the atomic unit a Responsibility compiles into. ownerUserId
/// is stamped from actor.userId. Members are added via createAuthoringConstruct; reused (composed)
/// constructs are recorded on reusedConstructRefs.
@actor
mutate bundle createAuthoringBundle {
  args {
    bundleId            string!
    title               string!
    summary             string
    responsibilityId    string
    sourcePlanId        string
    version             int
    supersedesBundleId  string
    reusedConstructRefs []object
  }
  insert {
    accept { title, summary, responsibilityId, sourcePlanId, supersedesBundleId, reusedConstructRefs }
    stamp {
      id: args.bundleId
      ownerUserId: actor.userId
      version: args.version ?? 1
      status: "draft"
    }
  }
}

/// Create an authored construct (the .memql source for one concept / automation / logic / shape /
/// spec / trait / policy / mutation / query / prompt) as a member of a bundle. ownerUserId stamped
/// from actor.userId; status starts draft and follows the bundle.
@actor
mutate construct createAuthoringConstruct {
  args {
    constructId      string!
    bundleId         string!
    kind             enum("concept", "automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")!
    name             string!
    targetNamespace  string!
    source           string!
    grammarVersion   string
  }
  insert {
    accept { bundleId, kind, name, targetNamespace, source, grammarVersion }
    stamp {
      id: args.constructId
      ownerUserId: actor.userId
      status: "draft"
    }
  }
}

/// Record the Gate 1 (isolated compile+bind, #956) result on a bundle and transition status. status
/// is validated on success or failed on a binding error; validationReport carries the structured
/// diagnostics; failureReason carries the headline on failure. Re-stamps ownerUserId (keeps the row
/// owned + satisfies per-row authz).
@actor
mutate bundle recordBundleValidation {
  args {
    bundleId          string!
    status            enum("validated", "failed")!
    validationReport  object!
    failureReason     string
  }
  update {
    accept { status, validationReport, failureReason }
    stamp {
      id: args.bundleId
      ownerUserId: actor.userId
    }
  }
}

/// Record the Gate 2 (tiered behavioral dry-run, #958) result on a bundle and transition status.
/// status is dryRunPassed on success or failed otherwise; dryRunReport carries the trace +
/// side-effect manifest + cost estimate (the Gate 3 approval artifact).
@actor
mutate bundle recordBundleDryRun {
  args {
    bundleId       string!
    status         enum("dryRunPassed", "failed")!
    dryRunReport   object!
    failureReason  string
  }
  update {
    accept { status, dryRunReport, failureReason }
    stamp {
      id: args.bundleId
      ownerUserId: actor.userId
    }
  }
}

/// Activate a bundle after Gate 3 approval: status -> active and activatedAt stamped. The
/// authored-construct runtime (#959) registers the bundle's constructs on this transition; member
/// constructs are flipped to active via setConstructStatus.
@actor
mutate bundle activateAuthoringBundle {
  args {
    bundleId  string!
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    status: "active"
    activatedAt: now
  }
}

/// Generic lifecycle transition for the remaining bundle states: paused (circuit breaker / user
/// hold), retired (superseded or removed), or failed. retiredAt is stamped by
/// retireAuthoringBundle; this mutation handles pause/unpause + failed. failureReason optional.
@actor
mutate bundle setAuthoringBundleStatus {
  args {
    bundleId       string!
    status         enum("draft", "paused", "active", "failed")!
    failureReason  string
  }
  update {
    accept { status, failureReason }
    stamp {
      id: args.bundleId
      ownerUserId: actor.userId
    }
  }
}

/// Retire a bundle: status -> retired and retiredAt stamped. Used when a new version supersedes it
/// or the user removes the capability. The authored runtime (#959) unregisters its constructs on
/// this transition.
@actor
mutate bundle retireAuthoringBundle {
  args {
    bundleId  string!
  }
  update {
    id: args.bundleId
    ownerUserId: actor.userId
    status: "retired"
    retiredAt: now
  }
}

/// Set a construct's lifecycle status (draft / staged / active / retired), following its parent
/// bundle. The authored runtime flips constructs to active on bundle activation and retired on
/// bundle retirement. `staged` is the owner-scoped middle tier (memql#3928): the durable stage path
/// writes it, and training flips the SAME row staged -> active rather than writing a second one, so
/// a trained construct has one lifecycle rather than two rows disagreeing about which tier it is in.
@actor
mutate construct setConstructStatus {
  args {
    constructId  string!
    status       enum("draft", "staged", "active", "retired")!
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    args.status
  }
}

/// Mark a promoted CONCEPT construct row retired-in-place (memql#3756): the concept keeps its
/// registry entry -- name still claimed, existing rows still readable -- and new writes to it are
/// refused. status is deliberately left alone: flipping it to "retired" is what the OTHER demote
/// outcome does (zero rows -> withdraw the definition entirely), and a status-retired row is
/// SKIPPED by the boot re-hydration, which for a concept with rows under it would strand every one
/// of them. There is no inverse mutation: a re-promote writes a NEW construct row carrying
/// conceptRetired=false, and the re-hydration resolves a concept as live whenever any un-stamped
/// row for it survives.
@actor
mutate construct retireConstructConcept {
  args {
    constructId  string!
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    conceptRetired: true
  }
}

/// Mark a promoted CONCEPT construct row's DATA staged (epic memql#3974): the concept stays
/// REGISTERED and resolvable and keeps accepting writes, and only the VISIBILITY of the rows under
/// it is withheld until it is trained. status is deliberately left alone, and for the same reason
/// retireConstructConcept leaves it alone: a status-retired row is SKIPPED by the boot
/// re-hydration, so the concept would not re-register at all and its staged rows would be
/// unreadable rather than staged. It is equally deliberately not `status: staged`, which belongs to
/// the construct-staging tier (memql#3928) and means the opposite kind of thing -- resolution scoped
/// to one author -- on a kind (`concept`) that tier refuses outright. The inverse is
/// trainConstructConceptData below (memql#3986); a re-promote is NOT one, because a promote carries
/// the staging forward rather than dropping it -- see that mutation's note.
@actor
mutate construct stageConstructConceptData {
  args {
    constructId  string!
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    conceptDataStaged: true
  }
}

/// Make a staged CONCEPT construct row's DATA live (memql#3986): the rows written under the concept
/// while it was staged stop being withheld and join the ordinary read path, in place, with no row
/// rewritten -- visibility is concept-grain, so the flag on this row is the whole of it. The exact
/// inverse of stageConstructConceptData above, and the ONLY inverse: it exists because a re-promote
/// deliberately does NOT un-stage. Under the `a live row wins` fold an unstamped row resolves the
/// concept as live, so a promote that said nothing about staging used to publish every row an author
/// had accumulated -- a disclosure caused by an edit to a SCHEMA, silent, and not undoable. The
/// promote path now carries the staging forward instead, which leaves this mutation as the single
/// named door out of staged. status is left alone here exactly as its sibling leaves it alone, and
/// for the same reason: this is a statement about the visibility of rows, not about whether the
/// construct re-registers. Every stamped row for the concept is written, not just one -- the fold
/// would already resolve live off a single cleared row, but a row left stamped keeps asserting on
/// the review surfaces that data is withheld when it is not.
@actor
mutate construct trainConstructConceptData {
  args {
    constructId  string!
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    conceptDataStaged: false
  }
}

/// Store the cached compiled form for a construct, produced by the Gate 1 compile+bind harness
/// (#956), so activation doesn't re-parse.
@actor
mutate construct setConstructCompiledForm {
  args {
    constructId   string!
    compiledForm  object!
  }
  update {
    id: args.constructId
    ownerUserId: actor.userId
    args.compiledForm
  }
}

/// Promote a construct into the owner's reusable catalog with provenance (#957): catalogued ->
/// true, catalogKey set to the dedup signature, catalogMatchText set to the embedded near-match
/// text, and the provenance pair (catalogedAt + catalogedFromBundleId) stamped so later bundles
/// that compose it inherit where it came from. The embedding itself is written separately into
/// node_vectors by the Go catalog-write path (PromoteConstructToCatalog). Called post-activation as
/// the catalog-write path.
@actor
mutate construct catalogueConstruct {
  args {
    constructId       string!
    catalogKey        string!
    catalogMatchText  string!
    fromBundleId      string!
  }
  update {
    accept { catalogKey, catalogMatchText }
    stamp {
      id: args.constructId
      ownerUserId: actor.userId
      catalogued: true
      catalogedAt: now
      catalogedFromBundleId: args.fromBundleId
    }
  }
}

/// Record one dependency edge for a bundle's construct (#957). Written by the compile/bind pass
/// once it resolves a construct's references. ownerUserId stamped from actor.userId.
@actor
mutate dependencyEdge recordDependencyEdge {
  args {
    edgeId         string!
    bundleId       string!
    fromConstruct  string!
    fromKind       enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")!
    toName         string!
    toKind         enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt")!
    toSource       enum("core", "catalog", "bundle")!
  }
  insert {
    accept { bundleId, fromConstruct, fromKind, toName, toKind, toSource }
    stamp {
      id: args.edgeId
      ownerUserId: actor.userId
    }
  }
}

/// Record the work spine's catalog key on a construct compiled from a goal (epic memql#4966), so
/// compile's exact-match tier can find it again. Server-only: the signature is what decides whether
/// a later goal is served from the catalog WITHOUT a model, so a caller able to write it could
/// point any goal at any template of theirs and have the engine replay it as an exact match.
/// Scoping to actor.userId is not the missing piece -- the row is already owner-stamped and a
/// caller can only reach their own constructs; what is missing is that a caller may not assert this
/// equivalence AT ALL, which is what @serverOnly says and a tier cannot. Written by
/// integration.work's promotion path after a run has actually succeeded.
@serverOnly
mutate construct recordConstructGoalSignature {
  args {
    constructId    string!
    goalSignature  string!
  }
  update {
    accept { goalSignature }
    stamp {
      id: args.constructId
    }
  }
}

/// Move a construct along the trust ladder (epic memql#4966, spec section E `Promote`). The new
/// values are computed by the caller rather than incremented here, because a MemQL update is a
/// read-merge and carries no arithmetic. Server-only for the same reason as the signature above:
/// reliability is the engine's own evidence about how far a template has earned being replayed
/// without a model, and a caller who could write it could promote an unproven template into the
/// cheap path. Scoping to actor.userId does not help -- these are already the caller's own rows,
/// and the point is that the JUDGEMENT is not theirs to make.
@serverOnly
mutate construct recordConstructReliability {
  args {
    constructId     string!
    reliability     float!
    reinforceCount  int!
    lastReinforced  string!
  }
  update {
    accept { reliability, reinforceCount, lastReinforced }
    stamp {
      id: args.constructId
    }
  }
}
