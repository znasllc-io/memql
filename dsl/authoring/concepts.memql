// concepts.memql
//
// Concepts in the authoring namespace (epic memql#954, issue #955).
//
// These are the graph-stored substrate for planner-authored `.memql`
// automations: a user Responsibility compiles into a *bundle* (one
// automation + its dependency closure), each member construct carrying
// its own `.memql` source + cached compiled form. The bundle is the
// ATOMIC unit of validation and activation -- you never half-activate
// a closure. Lifecycle (draft -> validated -> dryRunPassed -> active
// -> paused -> retired/failed) mirrors the staged gates in the design
// doc (docs/design/authored-automations-954.md): Gate 1 isolated
// compile+bind, Gate 2 tiered behavioral dry-run, Gate 3 user approval.
//
// This issue (#955) defines the concepts + lifecycle mutations/queries/
// shapes ONLY. No engine wiring: the sandbox compile/bind harness
// (#956), catalog matching (#957), dry-run (#958), authored runtime
// (#959), and planner authoring loop (#960) build on top of these rows.

use identity.concepts.{ user }
use planner.concepts.{ plan, responsibility }

@version("1.0.0")
@namespace("authoring")
@description("An atomic, versioned unit of planner-authored DSL: one automation plus the dependency closure it needs (logic / shapes / specs / traits / policies / mutations / queries / prompts), compiled from a user Responsibility. The bundle is the unit of validation and activation -- the whole closure passes Gate 1 (isolated compile+bind), Gate 2 (tiered behavioral dry-run), and Gate 3 (user approval) together, then activates together into the sandboxed authored-construct runtime (#959). Never part of the core engine Init() path, so a malformed bundle can never brick the cluster. Member constructs are v1:authoring:construct rows pointing back via bundleId.")
@displayCard(primary="title", secondary="status", tertiary="responsibilityId", status="status")
concept bundle {
  ownerUserId         string  @required @description("v1:identity:user.id who owns this bundle (the Responsibility author). Per-row authz owner; server-stamped from actor.userId at create, never caller-supplied. Authored automations run under THIS user's authz envelope -- no privilege escalation.")
  responsibilityId    string  @description("v1:planner:responsibility.id this bundle was compiled from, when authored via the Responsibility intake path. Empty for bundles authored directly. Links the human-facing standing directive to its compiled artifact.")
  sourcePlanId        string  @description("v1:planner:plan.id this bundle was post-hoc captured from, when authored via the everyday-task capture path (epic memql#1160, issue #1161) rather than a standing Responsibility. Empty for Responsibility-authored or directly-authored bundles. Links the one-off task that ran to its reproducible, inspectable compiled artifact; also the idempotency + lookup key for the capture orchestrator (skip re-authoring a re-delivered terminal event) and the #1162 view/edit/export surface.")
  title               string  @required @description("Human-readable name of the capability this bundle implements (e.g. 'Draft a reply when a refund escalation arrives'). Surfaced on management cards + the approval (Gate 3) artifact.")
  summary             string  @description("Longer human description of what the bundle does, generated by the planner design pass. Shown on the approval card alongside the dry-run trace + side-effect manifest.")
  status              enum("draft", "validated", "dryRunPassed", "active", "paused", "retired", "failed") @required @default("draft") @description("Lifecycle. draft = constructs authored, not yet validated. validated = passed Gate 1 (isolated compile+bind) -- see validationReport. dryRunPassed = passed Gate 2 (tiered behavioral dry-run) -- see dryRunReport. active = approved (Gate 3) and registered into the authored-construct runtime; its automation is live. paused = temporarily disabled by the user or a circuit breaker without retiring. retired = permanently deactivated (superseded by a new version or removed). failed = a gate failed (validation or dry-run); failureReason carries why. Transitioned via the authoring mutations; the engine does not enforce a hard state machine here (the planner loop drives transitions).")
  version             int     @default("1") @description("Monotonic version of this capability. A user edit to the Responsibility (or a dependency change) produces a NEW bundle that supersedes the prior one via supersedesBundleId, rather than mutating an active bundle in place.")
  supersedesBundleId  string  @description("When this bundle is a new version of an existing capability, the v1:authoring:bundle.id it replaces. On activation the superseded bundle is retired. Empty for a first-version bundle.")
  reusedConstructRefs []object @description("Existing constructs this bundle COMPOSES rather than authors (the compose-first dependency strategy). Each entry: {name, kind, namespace, source: 'core'|'catalog'}. Net-new dependencies are authored as their own v1:authoring:construct rows; this list records the reuse edges for the dependency graph + impact analysis (#957).")
  validationReport    object  @description("Gate 1 result (isolated compile+bind, #956): {ok: bool, diagnostics: [{constructName, severity, message, line?}], boundConcepts: [...], unresolvedRefs: [...]}. Populated by recordBundleValidation. Empty until Gate 1 runs.")
  dryRunReport        object  @description("Gate 2 result (tiered behavioral dry-run, #958): {ok: bool, trace: [...], sideEffectManifest: {mutations: [...], aiCalls: [...], webCalls: [...], blockedWebhooks: [...]}, costEstimate: {tokens, usd}}. The approval artifact shown to the user at Gate 3. Populated by recordBundleDryRun. Empty until Gate 2 runs.")
  failureReason       string  @description("Populated when status transitions to failed -- which gate failed and why (e.g. 'gate1: spec specX references unknown field payload.foo'). Cleared on a successful re-author.")
  activatedAt         datetime @description("When the bundle was approved + registered into the authored runtime (status -> active). Null until activated.")
  retiredAt           datetime @description("When the bundle was retired. Null unless status=retired.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="responsibilityId", target=responsibility, direction="outgoing")
  @relationship(type="interactsWith", field="sourcePlanId", target=plan, direction="outgoing")
  @relationship(type="interactsWith", field="supersedesBundleId", target=bundle, direction="outgoing")
}

@version("1.0.0")
@namespace("authoring")
@description("One authored DSL construct that is a member of a v1:authoring:bundle: the `.memql` source for an automation / logic / shape / spec / trait / policy / mutation / query / prompt, plus its cached compiled form. These are the NET-NEW constructs the planner authored because nothing existing fit (compose-first, author-the-gap); reused constructs are recorded on the bundle's reusedConstructRefs instead. After a bundle activates, a construct can be promoted into the per-owner reusable catalog (catalogued=true) so later bundles compose it -- the catalog match key lives in catalogKey (#957).")
@displayCard(primary="name", secondary="kind", tertiary="bundleId", status="status")
concept construct {
  ownerUserId       string  @required @description("v1:identity:user.id who owns this construct (same as the parent bundle's owner). Per-row authz owner; server-stamped from actor.userId at create.")
  bundleId          string  @required @description("v1:authoring:bundle.id this construct belongs to. Every authored construct is a member of exactly one bundle.")
  kind              enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt") @required @description("Which DSL construct kind this source defines. Drives which loader/validator the sandbox compile+bind harness (#956) routes it through.")
  name              string  @required @description("The construct's DSL name as it appears in source (e.g. the automation/logic/spec name). Owner-scoped uniqueness; the authored runtime registers it under targetNamespace so two users' authored constructs never collide.")
  targetNamespace   string  @required @description("The namespace this construct registers under in the authored runtime (e.g. an owner-scoped namespace). Resolution precedence at runtime is core (sealed) -> owner-catalog -> bundle-local.")
  source            string  @required @description("The raw `.memql` source text for this construct. The single source of truth; the compiled form is derived + cached.")
  grammarVersion    string  @description("The engine grammar epoch this source was authored under (parser.GrammarVersion, S6 #2361), stamped at create. Re-hydration compares it against the running engine's grammar: a MISMATCHED stamp quarantines the row with an error naming the memqlmigrate rewrite mode instead of a silent degradation. Empty on legacy rows (treated as unknown; recompile decides).")
  compiledForm      object  @description("Cached compiled representation produced by the sandbox compile+bind harness (#956), so activation doesn't re-parse. Empty until Gate 1 compiles the bundle.")
  status            enum("draft", "active", "retired") @required @default("draft") @description("Follows the parent bundle's lifecycle at a construct grain: draft while the bundle is pre-activation, active once the bundle activates, retired when the bundle retires. Lets a cataloged construct outlive a single bundle.")
  catalogued        bool    @default("false") @description("True once this construct has been promoted into the owner's reusable catalog (post-activation), so later bundles can compose it instead of re-authoring. Drives the compose-first reuse path (#957).")
  catalogKey        string  @description("Dedup / match key for the catalog (#957): a stable signature of what this construct does (e.g. kind + bound concept + normalized predicate), used by the similarTo-backed matcher to find an existing construct before authoring a new one. Empty until catalogued.")
  catalogMatchText  string  @description("The name-independent semantic text (kind + @description intent + canonicalized body) that was embedded for the near-match retrieval tier (#957). Computed by CatalogMatchText at promotion time and stored alongside the embedding (the vector itself lives in node_vectors keyed by this construct's id, vector_field='content') so similarTo can rank close-but-not-identical constructs for a stated need, and a re-embed can backfill from it. Empty until catalogued.")
  catalogedAt       datetime @description("Provenance (#957): when this construct was promoted into the owner's reusable catalog (the post-activation catalog-write path). Null until catalogued. Together with ownerUserId (who) and catalogedFromBundleId (which activated bundle) this is the full reuse provenance later bundles inherit when they compose it.")
  catalogedFromBundleId string @description("Provenance (#957): the v1:authoring:bundle.id whose activation promoted this construct into the catalog. Normally the construct's own bundleId, but recorded explicitly so the provenance survives even after that bundle retires (a cataloged construct outlives a single bundle). Empty until catalogued.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="bundleId", target=bundle, direction="outgoing")
  @relationship(type="interactsWith", field="catalogedFromBundleId", target=bundle, direction="outgoing")
}

@version("1.0.0")
@namespace("authoring")
@description("One dependency edge in a bundle's construct graph (epic memql#954, issue #957). Construct `fromConstruct` (kind `fromKind`) in bundle `bundleId` depends on construct `toName` (kind `toKind`), which resolves from `toSource` (core = sealed engine, catalog = the owner's reusable catalog, bundle = bundle-local). Edges are recorded at compile time so the catalog can run IMPACT ANALYSIS -- 'which bundles depend on this construct' -- before a shared / cataloged construct changes. This is the reuse-coupling mitigation from the design doc: editing a cataloged construct re-validates its dependents.")
@displayCard(primary="fromConstruct", secondary="toName", tertiary="bundleId", status="toSource")
concept dependencyEdge {
  ownerUserId    string  @required @description("v1:identity:user.id who owns this edge (the bundle owner). Per-row authz owner; server-stamped from actor.userId.")
  bundleId       string  @required @description("v1:authoring:bundle.id whose construct declares this dependency.")
  fromConstruct  string  @required @description("Name of the depending construct (the one that references the dependency).")
  fromKind       enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt") @required @description("Kind of the depending construct.")
  toName         string  @required @description("Name of the depended-on construct.")
  toKind         enum("automation", "logic", "shape", "spec", "trait", "policy", "mutation", "query", "prompt") @required @description("Kind of the depended-on construct.")
  toSource       enum("core", "catalog", "bundle") @required @description("Where the dependency resolves under the precedence core -> owner-catalog -> bundle-local. Edges to `catalog` are the ones impact analysis cares about when a shared construct changes.")

  @relationship(type="parent", field="ownerUserId", target=user, direction="outgoing")
  @relationship(type="parent", field="bundleId", target=bundle, direction="outgoing")
}
