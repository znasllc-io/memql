// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Full projection of a v1:worker:invocation row. Backs the per-plan and per-user invocation feeds.
@row
shape invocation workerInvocationFull {
  row.id
  ownerUserId
  workerId
  agentId
  planId
  taskId
  correlationId
  tool
  action
  argsRedacted
  startedAt
  completedAt
  durationMs
  outcome
  exitCode
  signal
  errorCode
  errorMessage
  bytesIn
  bytesOut
  outputPreview
  routing
  row.createdAt
}

/// Full projection of a v1:worker:registration row. Backs the /me/workers panel + /admin/workers +
/// the agent-side dispatch routing path. Includes lastSeenAt so the frontend can compute
/// online/offline state.
@row
shape registration workerRegistrationFull {
  row.id
  ownerUserId
  identityId
  name
  displayName
  capabilities
  capabilityDescriptor
  labels
  operatorLabels
  connectedNodeId
  lastSelectedAt
  activeCount
  concurrency
  platformInfo
  permissions
  version
  buildTag
  registeredAt
  lastSeenAt
  lastConnectedFromIP
  revokedAt
  revokedBy
  revokeReason
  row.createdAt
}

/// Full projection of a v1:worker:routingPolicy row. Backs routingPolicyForOwner (the router's
/// read) and the Fleet page's policy editor.
@row
shape routingPolicy workerRoutingPolicyFull {
  row.id
  ownerUserId
  strategy
  requireLabels
  preferLabels
  fallback
  active
  row.createdAt
}
