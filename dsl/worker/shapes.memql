// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Full projection of a v1:worker:invocation row. Backs the per-plan and per-user invocation feeds.
@row
shape invocation workerInvocationFull {
  row.id
  ownerUserId
  workerId
  agentId
  runId
  stepId
  correlationId
  tool
  action
  argsRedacted
  startedAt
  completedAt
  durationMs
  outcome
  exitCode
  signal
  errorCode
  errorMessage
  bytesIn
  bytesOut
  outputPreview
  routing
  row.createdAt
}

/// Full projection of a v1:worker:registration row. Backs the /me/workers panel + /admin/workers +
/// the agent-side dispatch routing path. Includes lastSeenAt so the frontend can compute
/// online/offline state.
@row
shape registration workerRegistrationFull {
  row.id
  ownerUserId
  identityId
  name
  displayName
  capabilities
  capabilityDescriptor
  labels
  operatorLabels
  connectedNodeId
  lastSelectedAt
  activeCount
  concurrency
  platformInfo
  hardware
  sharing
  permissions
  apps
  appDescriptors
  version
  buildTag
  registeredAt
  lastSeenAt
  rttMs
  rttAt
  lastConnectedFromIP
  revokedAt
  revokedBy
  revokeReason
  row.createdAt
}

/// Full projection of a v1:worker:appSession row (memql#4360). Backs the session detail page, the
/// machine card's recent-sessions list and the accounting rollup.
@row
shape appSession workerAppSessionFull {
  row.id
  ownerUserId
  workerId
  app
  kind
  runId
  stepId
  sessionRunId
  status
  workspace
  prompt
  inputArtifactIds
  responseSchema
  result
  resultSubmittedAt
  transcriptFileId
  transcriptTruncated
  recordedSteps
  droppedActions
  usage
  billing
  exitCode
  producedArtifactIds
  appSessionRef
  credentialRef
  credentialExpiresAt
  mcpEndpoint
  errorMessage
  cancelReason
  startedAt
  endedAt
  row.createdAt
}

/// Card projection of a v1:worker:appSession row: everything a list needs and neither the prompt
/// nor the workspace. Kept narrow for the reason it always was -- a list renders a handful of
/// lines and must not pull a page of text per row to do it.
@row
shape appSession workerAppSessionCard {
  row.id
  ownerUserId
  workerId
  app
  kind
  runId
  stepId
  status
  billing
  usage
  exitCode
  startedAt
  endedAt
  row.createdAt
}

/// Full projection of a v1:worker:delegationPolicy row (memql#4362). Backs the policy editor and
/// the planner's triage read.
@row
shape delegationPolicy workerDelegationPolicyFull {
  row.id
  ownerUserId
  preferSubscriptionApps
  eligibleKinds
  appOrder
  maxConcurrentSessions
  workspaceRoot
  credentialLifetimeSeconds
  updatedAt
  row.createdAt
}

/// Full projection of a v1:worker:routingPolicy row. Backs routingPolicyForOwner (the router's
/// read) and the Fleet page's policy editor.
@row
shape routingPolicy workerRoutingPolicyFull {
  row.id
  ownerUserId
  strategy
  requireLabels
  preferLabels
  modelPreference
  fallback
  active
  row.createdAt
}

/// Full projection of a v1:worker:modelPull row. Backs the machine detail's Models group,
/// which renders a live pull, and the sweep that fails abandoned ones.
@row
shape modelPull workerModelPullFull {
  row.id
  ownerUserId
  workerId
  model
  status
  statusLine
  layer
  completedBytes
  totalBytes
  readvertised
  errorMessage
  targetNodeId
  requestedAt
  updatedAt
  endedAt
  row.createdAt
}

/// Full projection of one probe (epic memql#5146). Backs the machine page's live progress and the
/// stale sweep's read.
@row
shape modelProbe workerModelProbeFull {
  row.id
  ownerUserId
  workerId
  model
  suiteVersion
  status
  completedCases
  totalCases
  currentCase
  measurementId
  errorMessage
  targetNodeId
  requestedAt
  updatedAt
  endedAt
  row.createdAt
}
