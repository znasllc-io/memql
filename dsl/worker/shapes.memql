// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@useConcept(invocation)
@description("Full projection of a v1:worker:invocation row. Backs the per-plan and per-user invocation feeds.")
shape workerInvocationFull {
  row.id
  invocation.ownerUserId
  invocation.workerId
  invocation.agentId
  invocation.planId
  invocation.taskId
  invocation.correlationId
  invocation.tool
  invocation.action
  invocation.argsRedacted
  invocation.startedAt
  invocation.completedAt
  invocation.durationMs
  invocation.outcome
  invocation.exitCode
  invocation.signal
  invocation.errorCode
  invocation.errorMessage
  invocation.bytesIn
  invocation.bytesOut
  invocation.outputPreview
  row.createdAt
}

@row
@useConcept(registration)
@description("Full projection of a v1:worker:registration row. Backs the /me/workers panel + /admin/workers + the agent-side dispatch routing path. Includes lastSeenAt so the frontend can compute online/offline state.")
shape workerRegistrationFull {
  row.id
  registration.ownerUserId
  registration.identityId
  registration.name
  registration.capabilities
  registration.labels
  registration.concurrency
  registration.platformInfo
  registration.permissions
  registration.version
  registration.buildTag
  registration.registeredAt
  registration.lastSeenAt
  registration.lastConnectedFromIP
  registration.revokedAt
  registration.revokedBy
  registration.revokeReason
  row.createdAt
}
