// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@row
@useConcept(invocation)
@description("Full projection of a v1:worker:invocation row. Backs the per-plan and per-user invocation feeds.")
shape workerInvocationFull {
  row.id
  payload.ownerUserId
  payload.workerId
  payload.agentId
  payload.planId
  payload.taskId
  payload.correlationId
  payload.tool
  payload.action
  payload.argsRedacted
  payload.startedAt
  payload.completedAt
  payload.durationMs
  payload.outcome
  payload.exitCode
  payload.signal
  payload.errorCode
  payload.errorMessage
  payload.bytesIn
  payload.bytesOut
  payload.outputPreview
  row.createdAt
}

@row
@useConcept(registration)
@description("Full projection of a v1:worker:registration row. Backs the /me/workers panel + /admin/workers + the agent-side dispatch routing path. Includes lastSeenAt so the frontend can compute online/offline state.")
shape workerRegistrationFull {
  row.id
  payload.ownerUserId
  payload.identityId
  payload.name
  payload.capabilities
  payload.labels
  payload.concurrency
  payload.platformInfo
  payload.permissions
  payload.version
  payload.buildTag
  payload.registeredAt
  payload.lastSeenAt
  payload.lastConnectedFromIP
  payload.revokedAt
  payload.revokedBy
  payload.revokeReason
  row.createdAt
}
