/// Read this person's eligible workers across all cluster replicas.
/// computerUseOnline means desktop control with a display is available;
/// headlessOnline means host tools are available. Neither grants permission.
/// machines lists names, exact requireLabels selectors and scoped-permission
/// support, platform and the worker account's homeDirectory when reported.
/// Missing homeDirectory means unknown; ask for the path or update Cockpit.
/// Ask the person to choose when the intended target is unclear.
@handler(type="function", name="agentworkerStatus")
@requiresAgentRole("assistant", "specialist")
tool workerStatus {
 ownerUserId string! @autoInjected
 agentId string @autoInjected
}

/// Check saved permission or request access for the exact operation. Reads and
/// commands MUST include operation; a missing operation is an error, not a
/// request for broader access. Use sessionKind only for desktop, writes or HTTP.
/// Explain the purpose and the chosen machine's requireLabels from workerStatus. If several
/// machines match, ask which to use with requestUserFeedback first. A selection
/// is not permission. Approval is shown in Nexus; no action runs first.
@handler(type="function", name="agentworkerRequestScope")
@requiresAgentRole("assistant", "specialist")
tool requestComputerUseScope {
 sessionKind enum("desktop", "file_write", "http") @description("Only for desktop interaction, fs_write or http_fetch, using expiring access for this run. Never use for fs_read, fs_list, fs_stat or exec: those require operation. Do not supply both.")
 operation object @description("Supply this for a headless read or exact command. Copy paths from the selected machine's homeDirectory or the person; do not guess. Never replace a refused operation with broader access.") {
  tool enum("workerHost")!
  action enum("fs_read", "fs_list", "fs_stat", "exec")!
  args object! {
   path string @description("Required for reads: exact absolute path. For home listing copy workerStatus.machines[].homeDirectory.")
   cmd string @description("Required for exec: exact command to approve and run.")
   cwd string @description("Required for exec: explicit absolute working directory other than /. Do not use ~ or environment variables.")
   timeoutSec integer @description("Optional command timeout, 1-600 seconds.")
   maxBytes integer @description("Optional file read limit, 1-5242880 bytes.")
  }
  directory string @description("Required for reads: absolute directory containing args.path. For fs_list use the same directory as args.path.")
 }
 intent string!
 requestedScope enum("observe", "full")!
 summary string!
 requireLabels object
 ownerUserId string! @autoInjected
 agentId string! @autoInjected
 partitionId string @autoInjected
}

/// Perform a headless operation on an enrolled computer after scoped approval.
/// Prefer workbenchHost when personal files or this person's computer are unnecessary.
@handler(type="function", name="agentworkerDispatchHost")
@requiresAgentRole("assistant", "specialist")
tool workerHost {
 action enum("exec", "fs_read", "fs_write", "fs_list", "fs_stat", "http_fetch")!
 args object @description("fs_list/fs_read/fs_stat require an absolute path. exec takes cmd (the exact command), cwd (absolute working directory), and optional timeoutSec; use the same args as the approved operation.")
 requireLabels object @description("Copy the selected machine's requireLabels from workerStatus. Keep the same target for approval and execution; do not omit it for work on a specific computer.")
 ownerUserId string! @autoInjected
 agentId string! @autoInjected
 runId string! @autoInjected
}

/// Interact with an enrolled computer's desktop after scoped approval.
/// An alternative for authorized tasks that require a graphical interface when
/// named capabilities or headless tools cannot complete them. Probe workerStatus first;
/// use requireLabels={display: "true"}. Reuse existing valid approval.
@handler(type="function", name="agentworkerDispatchComputer")
@requiresAgentRole("assistant", "specialist")
tool workerComputer {
 action string!
 args object
 requireLabels object
 ownerUserId string! @autoInjected
 agentId string! @autoInjected
 runId string! @autoInjected
}

/// Retain electricity research from official utility/service-area and tariff
/// sources. Use only the locality/postcode the owner authorized, never retrieve
/// or disclose a precise machine address. Do not guess a utility from a city.
/// Include all plausible providers for confirmation; unavailable is valid.
/// research: {status: found|ambiguous|unavailable, candidates:[{name,sourceUrl,
/// evidence}], tariffs:[{provider,name,currency,timezone,sourceUrls,checkedAt,
/// refreshAfter,effectiveFrom,effectiveUntil?,rateBands:[{name,perKWh,
/// appliesWhen}],assumptions:[]}],notes,runId}. Dates are ISO; effective dates
/// YYYY-MM-DD; checkedAt/refreshAfter RFC3339. Capture every applicable TOU and
/// tier band; state tax/fee exclusions. No bill, no known tariff selection.
@handler(type="function", name="fleetRecordElectricityResearch")
@requiresAgentRole("assistant", "specialist")
tool recordElectricityResearch {
  registrationId string!
  locationRevision string!
  research object!
}
