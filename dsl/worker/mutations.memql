// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use agents.concepts.{ agentAuthorization }
use identity.concepts.{ user }

/// Insert a worker tool-invocation telemetry row.
mutate invocation createWorkerInvocation {
  args {
    invocationId   string!
    ownerUserId    string!
    workerId       string!
    agentId        string!
    planId         string
    taskId         string
    correlationId  string
    tool           string!
    action         string!
    argsRedacted   object
    startedAt      string!
    completedAt    string
    durationMs     int
    outcome        string!
    exitCode       int
    signal         string
    errorCode      string
    errorMessage   string
    bytesIn        int
    bytesOut       int
    outputPreview  string
    routing        object
  }
  insert {
    id: args.invocationId
    args.ownerUserId
    args.workerId
    args.agentId
    planId: args.planId ?? ""
    taskId: args.taskId ?? ""
    correlationId: args.correlationId ?? ""
    args.tool
    args.action
    argsRedacted: args.argsRedacted ?? {}
    args.startedAt
    completedAt: args.completedAt ?? ""
    durationMs: args.durationMs ?? 0
    args.outcome
    exitCode: args.exitCode ?? 0
    signal: args.signal ?? ""
    errorCode: args.errorCode ?? ""
    errorMessage: args.errorMessage ?? ""
    bytesIn: args.bytesIn ?? 0
    bytesOut: args.bytesOut ?? 0
    outputPreview: args.outputPreview ?? ""
    routing: args.routing ?? {}
  }
}

// ---- mutations/v1/worker/createWorkerRegistration.memql ----

// createWorkerRegistration
// ========================
//
// Persists a v1:worker:registration row when a worker first connects
// via WorkerService.Stream and presents a valid mql_wkr_<token>.
// Subsequent reconnects locate the existing row by identityId (the
// auth path resolves the token to its v1:identity:identity row, and
// that's a 1:1 mapping with the registration) and refresh the
// registration-authoritative fields via
// refreshWorkerRegistration instead of re-running this
// mutation.
//
// ownerUserId is taken from the identity's userId, NOT from the
// caller -- the worker authenticates as worker:<id>, not as the
// registering user.

/// Create a worker registration row on first connect. ownerUserId is STAMPED FROM THE ACTOR, not
/// taken from args: the concept declares @rowAuthz(owner="ownerUserId", clusterOwner), and a
/// declared owner field any mutation writes from caller args fails
/// TestDeclaredOwnerFieldsAreServerStamped (its exemption list is empty and is meant to stay so).
/// The worker authenticates as worker:<id> rather than as its owner, so component/worker's store
/// runs this write under auth.ContextWithUserActor for the owner resolved from the worker_token's
/// identity row -- the same borrowed-authority shape createAuthActivity uses, and for the same
/// reason: the service knows whose credential it is before the actor envelope does.
@actor
mutate registration createWorkerRegistration {
  args {
    registrationId       string!
    identityId           string!
    name                 string!
    capabilities         array!
    capabilityDescriptor object
    labels               object
    concurrency          object!
    platformInfo         object
    permissions          object
    version              string
    buildTag             string
    registeredAt         string!
    lastSeenAt           string
    lastConnectedFromIP  string
    connectedNodeId      string
  }
  insert {
    id: args.registrationId
    ownerUserId: actor.userId
    args.identityId
    args.name
    args.capabilities
    capabilityDescriptor: args.capabilityDescriptor ?? {}
    labels: args.labels ?? {}
    args.concurrency
    platformInfo: args.platformInfo ?? {}
    permissions: args.permissions ?? {}
    version: args.version ?? ""
    buildTag: args.buildTag ?? ""
    args.registeredAt
    lastSeenAt: args.lastSeenAt ?? args.registeredAt
    lastConnectedFromIP: args.lastConnectedFromIP ?? ""
    connectedNodeId: args.connectedNodeId ?? ""
    // operatorLabels, displayName, lastSelectedAt and activeCount are
    // deliberately absent. A create has nothing to preserve, and naming them
    // here would invite the same list to be copied into
    // refreshWorkerRegistration -- which is exactly the write that must NOT
    // carry them (memql#4350 / design D3).
  }
}

// ---- mutations/v1/worker/refreshWorkerRegistration.memql ----

// refreshWorkerRegistration
// =========================
//
// Refreshes the registration-authoritative fields on an existing
// v1:worker:registration row when its worker reconnects (memql#1332).
// Everything the Register message carries is re-stamped from the new
// registration -- name, capabilities, capabilityDescriptor, labels,
// concurrency, platformInfo, permissions, version, buildTag -- plus
// lastSeenAt / lastConnectedFromIP. Without this the persisted row
// goes stale across cockpit upgrades (e.g. a worker upgraded to
// advertise new actions keeps its old descriptor until the row is
// recreated) even though the in-memory registry is always fresh.
//
// Omission semantics: a registration that OMITS the capability
// descriptor clears the persisted one (coalesce to {}) -- the worker
// no longer advertises a descriptor, so the row must not keep the
// old one. Identity / lifecycle fields (id, ownerUserId, identityId,
// registeredAt, revoked*) are never touched here.

/// Refresh registration-authoritative fields on worker reconnect.
mutate registration refreshWorkerRegistration {
  args {
    registrationId       string!
    name                 string!
    capabilities         array!
    capabilityDescriptor object
    labels               object
    concurrency          object!
    platformInfo         object
    permissions          object
    version              string
    buildTag             string
    lastSeenAt           string!
    lastConnectedFromIP  string
    connectedNodeId      string
  }
  update {
    id: args.registrationId
    args.name
    args.capabilities
    capabilityDescriptor: args.capabilityDescriptor ?? {}
    labels: args.labels ?? {}
    args.concurrency
    platformInfo: args.platformInfo ?? {}
    permissions: args.permissions ?? {}
    version: args.version ?? ""
    buildTag: args.buildTag ?? ""
    args.lastSeenAt
    lastConnectedFromIP: args.lastConnectedFromIP ?? ""
    connectedNodeId: args.connectedNodeId ?? ""
    // operatorLabels IS NOT WRITTEN HERE, and that is the whole of design D3.
    // `labels` above is overwritten from the Register message on every
    // reconnect; an operator tag living in that map would be erased by the
    // machine that carries it, silently, roughly whenever the laptop's lid
    // closed. update{} is a read-merge (memql#1628), so a field this body does
    // not name survives untouched -- which means the prohibition is enforced by
    // the ABSENCE of a line, and a well-meaning "complete the field list" edit
    // is what would break it. displayName is absent for the same reason: the
    // owner's rename must outlive the hostname the cockpit re-reports.
  }
}

// ---- mutations/v1/worker/revokeWorker.memql ----

// revokeWorker
// ============
//
// Stamps revokedAt / revokedBy / revokeReason on a worker registration.
// The agent node's worker registry checks revokedAt on every dispatch
// and on a periodic sweep -- a revoked worker's gRPC stream is closed
// out-of-band so any in-flight calls fail with worker_disconnected.

/// Revoke a worker registration.
mutate registration revokeWorker {
  args {
    registrationId  string!
    revokedAt       string!
    revokedBy       string
    revokeReason    string
  }
  update {
    id: args.registrationId
    args.revokedAt
    revokedBy: args.revokedBy ?? ""
    revokeReason: args.revokeReason ?? ""
  }
}

// ---- mutations/v1/worker/softDeleteWorkerInvocation.memql ----

// softDeleteWorkerInvocation
// ===========================
//
// Soft-deletes a worker invocation row by stamping `deleted=true`
// in the payload. The isNotDeleted trait, applied at the query layer
// (see dsl/worker/queries.memql), hides deleted rows from queries;
// the underlying time-series row survives for forensic recovery if
// needed.
//
// Called by the workerInvocationRetentionSweep cron once a row
// passes the WORKER_INVOCATION_RETENTION_DAYS window.

/// Soft-delete a worker invocation row past retention.
mutate invocation softDeleteWorkerInvocation {
  args {
    invocationId  string!
  }
  update {
    id: args.invocationId
    deleted: true
  }
}

// @mergeFields("preferences") is load-bearing: update() does
// TOP-LEVEL field replacement, so without it this single-key write
// would replace the ENTIRE stored preferences object -- wiping theme,
// timezone, archiveRetentionDays, dailySpaceEnabled, voice mode, and
// the operator-control settings on every kill-switch flip
// (memql#1339). The annotation opts the preferences field into an
// engine-side deep-merge so sibling keys survive.
// The row is selected by actor.userId, NOT by a caller-supplied userId
// (memql#2840). computerUseEnabled is one of the three layers checked before
// any computer-use dispatch -- the agent capability flag, the standing scope
// grant, and this per-user kill switch
// (component/memql/authoring_capability_gate.go) -- so a caller-supplied id let
// anyone disable, or silently re-enable, another user's switch.
//
// Stamping the actor is the whole of the defence, because there is no other: a
// mutation carries no executable guard (see the state-machine note in
// dsl/forge/mutations.memql -- "the DSL cannot gate a transition on
// actor.role"), and the request path consults no capability before running a
// named mutation (memql#2802). Whatever the author writes here IS the
// authorization.
//
// If an administrative override is ever wanted it belongs in a separately-named
// mutation whose name says so, not in a second meaning for this one.
/// Set the CALLER's User.preferences.computerUseEnabled.
@actor
@mergeFields("preferences")
mutate user toggleComputerUseEnabled {
  args {
    enabled  bool!
  }
  update {
    id: actor.userId
    preferences: {
        computerUseEnabled: args.enabled
      }
  }
}

// CHECKED IN THE memql#3177 PASS, and left as it stands deliberately -- the reasoning matters,
// because this mutation is the second half of the escalation that issue closes.
//
// It takes a caller-supplied row id with no owner predicate, exactly like
// revokeAgentAuthorization, so on its own it could raise the computer-use ceiling on ANY
// authorization row whose id the caller knew. What limited it before #3177 was only that a
// caller could not profitably point it at somebody else's grant; once `userId` was rewritable
// through updateAgentAuthorization's payload splat, this became the step that turned a
// hijacked row into `full` scope.
//
// Both halves are closed at the engine now: `v1:agents:agentAuthorization` declares
// `@rowAuthz(owner="userId")`, so executeWrite resolves this row BEFORE the read-merge and
// refuses when its userId is not the caller's (component/memql/rowauthz_write_guard.go,
// memql#3174).
//
// The body needs no owner re-stamp: `args.computerUseScope` is a NAMED field, not a payload
// splat, so `userId` is not among the keys this mutation can write and the read-merge inherits
// it from the persisted row. TestDeclaredOwnerFieldsAreServerStamped is what keeps that true --
// turn this body into a splat and that gate fails.
/// Set computerUseScope on an agent authorization row. Self-service: the engine refuses the write
/// when the target row's userId is not the caller's (the concept's declared owner tier).
mutate agentAuthorization updateAgentAuthScope {
  args {
    authorizationId   string!
    computerUseScope  string!
  }
  update {
    id: args.authorizationId
    args.computerUseScope
  }
}

// ---- mutations/v1/worker/updateWorkerLastSeen.memql ----

// updateWorkerLastSeen
// ====================
//
// The heartbeat flush: lastSeenAt + lastConnectedFromIP, and since
// memql#4350 connectedNodeId + activeCount as well.
//
// The cadence WAS 60s on a 15s beat, throttled on the reasoning that
// per-beat writes bought freshness nobody read. That reasoning was
// circular: nothing read lastSeenAt BECAUSE it was up to a minute
// stale. HeartbeatBatchInterval is now 15s -- the beat itself -- so
// this fires once per heartbeat, and the flush cadence is the
// freshness budget of the derived `online` flag
// (component/worker.OnlineWindow is twice it). The in-memory registry
// still tracks the live timestamp on every beat; what changed is that
// the row is no longer a minute behind it.
//
// A failed flush does not advance the session's watermark, so the next
// beat retries (memql#1340).

/// Bump lastSeenAt + lastConnectedFromIP on a worker registration.
mutate registration updateWorkerLastSeen {
  args {
    registrationId       string!
    lastSeenAt           string!
    lastConnectedFromIP  string
    connectedNodeId      string
    activeCount          int
  }
  update {
    id: args.registrationId
    args.lastSeenAt
    lastConnectedFromIP: args.lastConnectedFromIP ?? ""
    connectedNodeId: args.connectedNodeId ?? ""
    activeCount: args.activeCount ?? 0
  }
}

// ---- clearWorkerConnectedNode ----
//
// The disconnect half of connectedNodeId. Without it a machine whose
// stream dropped keeps naming the replica that used to hold it, and the
// router forwards a dispatch to a node that will refuse it -- a slower,
// noisier version of the no-worker case, and one that looks like a mesh
// fault rather than an offline laptop.
//
// lastSeenAt is deliberately NOT touched: it is the record of when the
// machine was last heard from, and moving it on the way out would make a
// disconnected worker look fresh for one online window.

/// Clear connectedNodeId on a worker registration when its stream closes.
/// NOT @serverOnly, deliberately. Its caller is component/worker, which is not on
/// call_origin.go's internal-origin allowlist and should not be: every context in that package
/// descends from a worker's own inbound stream. The concept's owner tier is the gate instead --
/// the store stamps auth.ContextWithUserActor for the registration's owner, and the write guard
/// refuses any other actor. The residue is that a signed-in person could clear the field on their
/// OWN machine, which the next heartbeat re-stamps within one interval.
mutate registration clearWorkerConnectedNode {
  args {
    registrationId  string!
  }
  update {
    id: args.registrationId
    connectedNodeId: ""
    activeCount: 0
  }
}

// ---- The Fleet: the owner's own writes (epic memql#4349) ----
//
// renameWorker and setWorkerOperatorLabels take a caller-supplied
// registrationId with no owner predicate in the body, and that is SAFE HERE
// for exactly one reason: v1:worker:registration declares
// @rowAuthz(owner="ownerUserId", clusterOwner), so executeWrite resolves the
// target row BEFORE the read-merge and refuses when its ownerUserId is neither
// the caller nor a cluster owner (component/memql/rowauthz_write_guard.go,
// memql#3174). Neither body can write ownerUserId -- both name their fields
// explicitly rather than splatting a payload -- so the read-merge inherits the
// owner from the persisted row and the guard cannot be walked past by
// rewriting the field it checks. That is the same reasoning updateAgentAuthScope
// above carries, and it is worth restating rather than referring to, because a
// future body that splats args is where it stops being true.

/// Rename one of the caller's machines. Writes displayName; `name` stays the cockpit's hostname,
/// which the next reconnect re-stamps.
mutate registration renameWorker {
  args {
    registrationId  string!
    displayName     string!  @maxLength(120)
  }
  update {
    id: args.registrationId
    args.displayName
  }
}

/// Replace the operator-set labels on one of the caller's machines. The whole map is replaced, not
/// merged: the Fleet page edits the set as a set, and a merge would make removing a label
/// impossible through this surface.
mutate registration setWorkerOperatorLabels {
  args {
    registrationId  string!
    operatorLabels  object!
  }
  update {
    id: args.registrationId
    args.operatorLabels
  }
}

/// Stamp lastSelectedAt on the machine the router just picked. Server-side: the router runs on
/// behalf of the session's owner, and a client that could stamp this could steer roundRobin.
@serverOnly
mutate registration touchWorkerSelected {
  args {
    registrationId  string!
  }
  update {
    id: args.registrationId
    lastSelectedAt: now
  }
}

// ---- The routing policy ----
//
// ONE ACTIVE POLICY PER USER is the model, and the DSL cannot enforce it:
// @unique is declared metadata with no check behind it (memql#2960), and a
// mutation carries no filter to make the write conditional. So the invariant is
// held on both sides instead of asserted on neither:
//
//   - the WRITE side edits in place. The Fleet page reads myRoutingPolicies,
//     and calls updateRoutingPolicy on the active row when one exists;
//     createRoutingPolicy runs once, for a user who has none.
//   - the READ side is DETERMINISTIC regardless. routingPolicyForOwner sorts
//     newest first and the router takes the first row, so even if two active
//     rows ever existed, every agent replica would still choose the same
//     policy. That property is the one that actually matters: a fleet routed
//     differently depending on which replica served the turn is the bug class
//     this epic exists to close, and it must not be reintroduced by the
//     policy read itself.
//
// deactivateRoutingPolicy is how a superseded row leaves the active set. Rows
// are never deleted: an invocation's routing.policyId names the row that made
// the choice, and deleting it would leave that record pointing at nothing.

/// Create the caller's routing policy. Run once, for a user who has none; edits go through
/// updateRoutingPolicy.
@actor
mutate routingPolicy createRoutingPolicy {
  args {
    policyId       string!
    strategy       string!  @enum("firstFit", "roundRobin", "leastLoaded", "labelMatch")
    requireLabels  object
    preferLabels   object
    fallback       string!  @enum("none", "nextMatching")
  }
  insert {
    id: args.policyId
    ownerUserId: actor.userId
    args.strategy
    requireLabels: args.requireLabels ?? {}
    preferLabels: args.preferLabels ?? {}
    args.fallback
    active: true
  }
}

/// Edit the caller's routing policy in place. The concept's owner tier is what scopes this to a
/// row the caller owns; the body cannot write ownerUserId, so the read-merge keeps it.
mutate routingPolicy updateRoutingPolicy {
  args {
    policyId       string!
    strategy       string!  @enum("firstFit", "roundRobin", "leastLoaded", "labelMatch")
    requireLabels  object
    preferLabels   object
    fallback       string!  @enum("none", "nextMatching")
  }
  update {
    id: args.policyId
    args.strategy
    requireLabels: args.requireLabels ?? {}
    preferLabels: args.preferLabels ?? {}
    args.fallback
    active: true
  }
}

/// Take a routing policy out of the active set. The row is kept -- an invocation's
/// routing.policyId names it.
mutate routingPolicy deactivateRoutingPolicy {
  args {
    policyId  string!
  }
  update {
    id: args.policyId
    active: false
  }
}
