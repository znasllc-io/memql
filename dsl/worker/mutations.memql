// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use agents.concepts.{ agentAuthorization }
use identity.concepts.{ user }

/// Insert a worker tool-invocation telemetry row.
mutate invocation createWorkerInvocation {
  args {
    invocationId   string!
    ownerUserId    string!
    workerId       string!
    agentId        string!
    planId         string
    taskId         string
    correlationId  string
    tool           string!
    action         string!
    argsRedacted   object
    startedAt      string!
    completedAt    string
    durationMs     int
    outcome        string!
    exitCode       int
    signal         string
    errorCode      string
    errorMessage   string
    bytesIn        int
    bytesOut       int
    outputPreview  string
  }
  insert {
    id: args.invocationId
    args.ownerUserId
    args.workerId
    args.agentId
    planId: args.planId ?? ""
    taskId: args.taskId ?? ""
    correlationId: args.correlationId ?? ""
    args.tool
    args.action
    argsRedacted: args.argsRedacted ?? {}
    args.startedAt
    completedAt: args.completedAt ?? ""
    durationMs: args.durationMs ?? 0
    args.outcome
    exitCode: args.exitCode ?? 0
    signal: args.signal ?? ""
    errorCode: args.errorCode ?? ""
    errorMessage: args.errorMessage ?? ""
    bytesIn: args.bytesIn ?? 0
    bytesOut: args.bytesOut ?? 0
    outputPreview: args.outputPreview ?? ""
  }
}

// ---- mutations/v1/worker/createWorkerRegistration.memql ----

// createWorkerRegistration
// ========================
//
// Persists a v1:worker:registration row when a worker first connects
// via WorkerService.Stream and presents a valid mql_wkr_<token>.
// Subsequent reconnects locate the existing row by identityId (the
// auth path resolves the token to its v1:identity:identity row, and
// that's a 1:1 mapping with the registration) and refresh the
// registration-authoritative fields via
// refreshWorkerRegistration instead of re-running this
// mutation.
//
// ownerUserId is taken from the identity's userId, NOT from the
// caller -- the worker authenticates as worker:<id>, not as the
// registering user.

/// Create a worker registration row on first connect.
mutate registration createWorkerRegistration {
  args {
    registrationId       string!
    ownerUserId          string!
    identityId           string!
    name                 string!
    capabilities         array!
    capabilityDescriptor object
    labels               object
    concurrency          object!
    platformInfo         object
    permissions          object
    version              string
    buildTag             string
    /// Local-app inventory the cockpit reported (memql#4359): a list of
    /// {id, version, signedIn, subscription, allowed}. Stored verbatim,
    /// including apps this engine cannot drive.
    apps                 array
    registeredAt         string!
    lastSeenAt           string
    lastConnectedFromIP  string
  }
  insert {
    id: args.registrationId
    args.ownerUserId
    args.identityId
    args.name
    args.capabilities
    capabilityDescriptor: args.capabilityDescriptor ?? {}
    labels: args.labels ?? {}
    args.concurrency
    platformInfo: args.platformInfo ?? {}
    permissions: args.permissions ?? {}
    version: args.version ?? ""
    buildTag: args.buildTag ?? ""
    apps: args.apps ?? []
    args.registeredAt
    lastSeenAt: args.lastSeenAt ?? args.registeredAt
    lastConnectedFromIP: args.lastConnectedFromIP ?? ""
  }
}

// ---- mutations/v1/worker/refreshWorkerRegistration.memql ----

// refreshWorkerRegistration
// =========================
//
// Refreshes the registration-authoritative fields on an existing
// v1:worker:registration row when its worker reconnects (memql#1332).
// Everything the Register message carries is re-stamped from the new
// registration -- name, capabilities, capabilityDescriptor, labels,
// concurrency, platformInfo, permissions, version, buildTag -- plus
// lastSeenAt / lastConnectedFromIP. Without this the persisted row
// goes stale across cockpit upgrades (e.g. a worker upgraded to
// advertise new actions keeps its old descriptor until the row is
// recreated) even though the in-memory registry is always fresh.
//
// Omission semantics: a registration that OMITS the capability
// descriptor clears the persisted one (coalesce to {}) -- the worker
// no longer advertises a descriptor, so the row must not keep the
// old one. Identity / lifecycle fields (id, ownerUserId, identityId,
// registeredAt, revoked*) are never touched here.

/// Refresh registration-authoritative fields on worker reconnect.
mutate registration refreshWorkerRegistration {
  args {
    registrationId       string!
    name                 string!
    capabilities         array!
    capabilityDescriptor object
    labels               object
    concurrency          object!
    platformInfo         object
    permissions          object
    version              string
    buildTag             string
    /// Local-app inventory from the latest Register (memql#4359). An
    /// omitted list CLEARS the persisted one, the same way the
    /// capability descriptor does: the worker no longer reports apps.
    apps                 array
    lastSeenAt           string!
    lastConnectedFromIP  string
  }
  update {
    id: args.registrationId
    args.name
    args.capabilities
    capabilityDescriptor: args.capabilityDescriptor ?? {}
    labels: args.labels ?? {}
    args.concurrency
    platformInfo: args.platformInfo ?? {}
    permissions: args.permissions ?? {}
    version: args.version ?? ""
    buildTag: args.buildTag ?? ""
    apps: args.apps ?? []
    args.lastSeenAt
    lastConnectedFromIP: args.lastConnectedFromIP ?? ""
  }
}

// ---- mutations/v1/worker/revokeWorker.memql ----

// revokeWorker
// ============
//
// Stamps revokedAt / revokedBy / revokeReason on a worker registration.
// The agent node's worker registry checks revokedAt on every dispatch
// and on a periodic sweep -- a revoked worker's gRPC stream is closed
// out-of-band so any in-flight calls fail with worker_disconnected.

/// Revoke a worker registration.
mutate registration revokeWorker {
  args {
    registrationId  string!
    revokedAt       string!
    revokedBy       string
    revokeReason    string
  }
  update {
    id: args.registrationId
    args.revokedAt
    revokedBy: args.revokedBy ?? ""
    revokeReason: args.revokeReason ?? ""
  }
}

// ---- mutations/v1/worker/softDeleteWorkerInvocation.memql ----

// softDeleteWorkerInvocation
// ===========================
//
// Soft-deletes a worker invocation row by stamping `deleted=true`
// in the payload. The isNotDeleted trait, applied at the query layer
// (see dsl/worker/queries.memql), hides deleted rows from queries;
// the underlying time-series row survives for forensic recovery if
// needed.
//
// Called by the workerInvocationRetentionSweep cron once a row
// passes the WORKER_INVOCATION_RETENTION_DAYS window.

/// Soft-delete a worker invocation row past retention.
mutate invocation softDeleteWorkerInvocation {
  args {
    invocationId  string!
  }
  update {
    id: args.invocationId
    deleted: true
  }
}

// @mergeFields("preferences") is load-bearing: update() does
// TOP-LEVEL field replacement, so without it this single-key write
// would replace the ENTIRE stored preferences object -- wiping theme,
// timezone, archiveRetentionDays, dailySpaceEnabled, voice mode, and
// the operator-control settings on every kill-switch flip
// (memql#1339). The annotation opts the preferences field into an
// engine-side deep-merge so sibling keys survive.
// The row is selected by actor.userId, NOT by a caller-supplied userId
// (memql#2840). computerUseEnabled is one of the three layers checked before
// any computer-use dispatch -- the agent capability flag, the standing scope
// grant, and this per-user kill switch
// (component/memql/authoring_capability_gate.go) -- so a caller-supplied id let
// anyone disable, or silently re-enable, another user's switch.
//
// Stamping the actor is the whole of the defence, because there is no other: a
// mutation carries no executable guard (see the state-machine note in
// dsl/forge/mutations.memql -- "the DSL cannot gate a transition on
// actor.role"), and the request path consults no capability before running a
// named mutation (memql#2802). Whatever the author writes here IS the
// authorization.
//
// If an administrative override is ever wanted it belongs in a separately-named
// mutation whose name says so, not in a second meaning for this one.
/// Set the CALLER's User.preferences.computerUseEnabled.
@actor
@mergeFields("preferences")
mutate user toggleComputerUseEnabled {
  args {
    enabled  bool!
  }
  update {
    id: actor.userId
    preferences: {
        computerUseEnabled: args.enabled
      }
  }
}

// CHECKED IN THE memql#3177 PASS, and left as it stands deliberately -- the reasoning matters,
// because this mutation is the second half of the escalation that issue closes.
//
// It takes a caller-supplied row id with no owner predicate, exactly like
// revokeAgentAuthorization, so on its own it could raise the computer-use ceiling on ANY
// authorization row whose id the caller knew. What limited it before #3177 was only that a
// caller could not profitably point it at somebody else's grant; once `userId` was rewritable
// through updateAgentAuthorization's payload splat, this became the step that turned a
// hijacked row into `full` scope.
//
// Both halves are closed at the engine now: `v1:agents:agentAuthorization` declares
// `@rowAuthz(owner="userId")`, so executeWrite resolves this row BEFORE the read-merge and
// refuses when its userId is not the caller's (component/memql/rowauthz_write_guard.go,
// memql#3174).
//
// The body needs no owner re-stamp: `args.computerUseScope` is a NAMED field, not a payload
// splat, so `userId` is not among the keys this mutation can write and the read-merge inherits
// it from the persisted row. TestDeclaredOwnerFieldsAreServerStamped is what keeps that true --
// turn this body into a splat and that gate fails.
/// Set computerUseScope on an agent authorization row. Self-service: the engine refuses the write
/// when the target row's userId is not the caller's (the concept's declared owner tier).
mutate agentAuthorization updateAgentAuthScope {
  args {
    authorizationId   string!
    computerUseScope  string!
  }
  update {
    id: args.authorizationId
    args.computerUseScope
  }
}

// ---- mutations/v1/worker/updateWorkerLastSeen.memql ----

// updateWorkerLastSeen
// ====================
//
// Heartbeat-batched lastSeenAt + lastConnectedFromIP update. The
// worker stream handler calls this opportunistically -- it does NOT
// fire on every heartbeat (15s) because that would saturate the
// engine; the in-memory registry tracks the live timestamp on every
// beat, and the stream handler flushes to the database at most once
// per HeartbeatBatchInterval (60s), persisting the first heartbeat
// of each stream immediately so a (re)connected worker's row is
// fresh within one beat (memql#1340).

/// Bump lastSeenAt + lastConnectedFromIP on a worker registration.
mutate registration updateWorkerLastSeen {
  args {
    registrationId       string!
    lastSeenAt           string!
    lastConnectedFromIP  string
  }
  update {
    id: args.registrationId
    args.lastSeenAt
    lastConnectedFromIP: args.lastConnectedFromIP ?? ""
  }
}

// ---- mutations/v1/worker/updateWorkerApps.memql ----

// updateWorkerApps
// ================
//
// Re-stamps the reported local-app inventory and the labels derived
// from it (memql#4359). Separate from updateWorkerLastSeen because an
// inventory change is a ROUTING change, and routing must not wait for
// the 60s heartbeat flush window: signing into Claude Code makes the
// machine selectable on the next beat, and signing out removes it
// just as fast.
//
// The two fields travel TOGETHER on purpose. `labels` carries the
// derived `app:<id>` entries alongside whatever the operator set by
// hand; writing the inventory without the labels would leave a row
// whose apps say one thing and whose routing labels say another, and
// nothing downstream could tell which was current.

/// Re-stamp a worker's reported app inventory and its derived routing labels.
mutate registration updateWorkerApps {
  args {
    registrationId       string!
    /// The full reported inventory: {id, version, signedIn, subscription, allowed}.
    /// An empty list is a machine reporting that it now has none.
    apps                 array
    /// The complete label set, operator-set labels included. Replaces
    /// the stored one wholesale -- a merge here could not remove the
    /// label of an app the user just signed out of.
    labels               object
    lastSeenAt           string!
    lastConnectedFromIP  string
  }
  update {
    id: args.registrationId
    apps: args.apps ?? []
    labels: args.labels ?? {}
    args.lastSeenAt
    lastConnectedFromIP: args.lastConnectedFromIP ?? ""
  }
}

// ---- mutations/v1/worker/createAppSession.memql ----

// createAppSession
// ================
//
// Opens the row for one delegated app run (memql#4360). Written
// BEFORE AppSessionStart goes on the wire, so a session that the
// worker never acknowledges still has a row saying it was attempted
// -- the alternative loses the attempt entirely, and "nothing
// happened" and "it failed to start" then read identically.
//
// @serverOnly: the row carries the credential's identity handle and
// the workspace the consent card approved. A client-reachable create
// would let a caller name its own workspace and its own credential.

@serverOnly
/// Open the row for a delegated app-session run.
mutate appSession createAppSession {
  args {
    sessionId      string!
    ownerUserId    string!
    workerId       string!
    app            string!  @enum("claude-code", "codex")
    kind           string!  @enum("run", "open", "attach")
    planId         string
    taskId         string
    workspace      string
    prompt         string
    inputArtifactIds  array
    mcpEndpoint    string
    credentialIdentityId  string
    credentialExpiresAt   string
    startedAt      string!
  }
  insert {
    id: args.sessionId
    args.ownerUserId
    args.workerId
    args.app
    args.kind
    planId: args.planId ?? ""
    taskId: args.taskId ?? ""
    status: "starting"
    workspace: args.workspace ?? ""
    prompt: args.prompt ?? ""
    inputArtifactIds: args.inputArtifactIds ?? []
    transcript: ""
    transcriptBytes: 0
    transcriptTruncated: false
    usage: {}
    billing: "unknown"
    mcpEndpoint: args.mcpEndpoint ?? ""
    credentialIdentityId: args.credentialIdentityId ?? ""
    credentialExpiresAt: args.credentialExpiresAt ?? ""
    args.startedAt
  }
}

// ---- mutations/v1/worker/appendAppSessionTranscript.memql ----

// appendAppSessionTranscript
// ==========================
//
// Flushes the accumulated transcript onto a live session row. The
// engine holds the buffer and writes the whole bounded string rather
// than one row-write per chunk: a chatty run emits thousands of
// chunks a minute, and a write each would saturate the engine to
// deliver text nobody is reading between flushes.
//
// `transcriptTruncated` and `transcriptBytes` travel with it so a
// reader can see that truncation happened and by how much. A
// transcript that stops without saying why reads as a run that
// stopped.

@serverOnly
/// Flush the accumulated transcript onto a live app-session row.
mutate appSession appendAppSessionTranscript {
  args {
    sessionId      string!
    transcript     string
    transcriptBytes  int
    transcriptTruncated  bool
    status         string  @enum("starting", "running")
  }
  update {
    id: args.sessionId
    transcript: args.transcript ?? ""
    transcriptBytes: args.transcriptBytes ?? 0
    transcriptTruncated: args.transcriptTruncated ?? false
    status: args.status ?? "running"
  }
}

// ---- mutations/v1/worker/endAppSession.memql ----

// endAppSession
// =============
//
// Drives a session to a terminal status with everything the app
// reported. `usage` is recorded VERBATIM: an app that reports
// nothing gets known=false and zeroes, and the billing enum says
// `unknown` rather than folding silence into either `metered` or
// `subscription`. Inferring here is what would make the number the
// owner asked for -- what the subscription covered -- untrustworthy.

@serverOnly
/// Drive an app session to a terminal status with its reported usage.
mutate appSession endAppSession {
  args {
    sessionId      string!
    status         string!  @enum("ended", "failed", "cancelled")
    exitCode       int
    usage          object
    billing        string  @enum("metered", "subscription", "unknown")
    transcript     string
    transcriptBytes  int
    transcriptTruncated  bool
    producedArtifactIds  array
    appSessionRef  string
    errorMessage   string
    cancelReason   string
    endedAt        string!
  }
  update {
    id: args.sessionId
    args.status
    exitCode: args.exitCode ?? 0
    usage: args.usage ?? {}
    billing: args.billing ?? "unknown"
    transcript: args.transcript ?? ""
    transcriptBytes: args.transcriptBytes ?? 0
    transcriptTruncated: args.transcriptTruncated ?? false
    producedArtifactIds: args.producedArtifactIds ?? []
    appSessionRef: args.appSessionRef ?? ""
    errorMessage: args.errorMessage ?? ""
    cancelReason: args.cancelReason ?? ""
    args.endedAt
  }
}

// ---- mutations/v1/worker/setDelegationPolicy.memql ----

// setDelegationPolicy
// ===================
//
// Upserts the caller's delegation preference (memql#4362). One row
// per user at a derived id, so a second write updates rather than
// forking a second policy the planner would have to choose between.

/// Create or update the caller's app-delegation policy.
mutate delegationPolicy setDelegationPolicy {
  args {
    policyId       string!
    ownerUserId    string!
    preferSubscriptionApps  bool
    eligibleKinds  array
    appOrder       array
    maxConcurrentSessions  int
    workspaceRoot  string
    credentialLifetimeSeconds  int
    updatedAt      string!
  }
  insert {
    id: args.policyId
    args.ownerUserId
    preferSubscriptionApps: args.preferSubscriptionApps ?? false
    eligibleKinds: args.eligibleKinds ?? []
    appOrder: args.appOrder ?? []
    maxConcurrentSessions: args.maxConcurrentSessions ?? 1
    workspaceRoot: args.workspaceRoot ?? ""
    credentialLifetimeSeconds: args.credentialLifetimeSeconds ?? 14400
    args.updatedAt
  }
}
