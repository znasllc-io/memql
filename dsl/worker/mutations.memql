// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@enabled
@useConcept(invocation)
@description("Insert a worker tool-invocation telemetry row.")
mutation mutationCreateWorkerInvocation {
  args {
    invocationId   string  @required
    ownerUserId    string  @required
    workerId       string  @required
    agentId        string  @required
    planId         string
    taskId         string
    correlationId  string
    tool           string  @required
    action         string  @required
    argsRedacted   object
    startedAt      string  @required
    completedAt    string
    durationMs     int
    outcome        string  @required
    exitCode       int
    signal         string
    errorCode      string
    errorMessage   string
    bytesIn        int
    bytesOut       int
    outputPreview  string
  }
  insert invocation {
    id: args.invocationId
    args.ownerUserId
    args.workerId
    args.agentId
    planId: coalesce(args.planId, "")
    taskId: coalesce(args.taskId, "")
    correlationId: coalesce(args.correlationId, "")
    args.tool
    args.action
    argsRedacted: coalesce(args.argsRedacted, {})
    args.startedAt
    completedAt: coalesce(args.completedAt, "")
    durationMs: coalesce(args.durationMs, 0)
    args.outcome
    exitCode: coalesce(args.exitCode, 0)
    signal: coalesce(args.signal, "")
    errorCode: coalesce(args.errorCode, "")
    errorMessage: coalesce(args.errorMessage, "")
    bytesIn: coalesce(args.bytesIn, 0)
    bytesOut: coalesce(args.bytesOut, 0)
    outputPreview: coalesce(args.outputPreview, "")
  }
}

// ---- mutations/v1/worker/createWorkerRegistration.memql ----

// createWorkerRegistration
// ========================
//
// Persists a v1:worker:registration row when a worker first connects
// via WorkerService.Stream and presents a valid mql_wkr_<token>.
// Subsequent reconnects locate the existing row by identityId (the
// auth path resolves the token to its v1:identity:identity row, and
// that's a 1:1 mapping with the registration) and update lastSeenAt
// via mutationUpdateWorkerLastSeen instead of re-running this
// mutation.
//
// ownerUserId is taken from the identity's userId, NOT from the
// caller -- the worker authenticates as worker:<id>, not as the
// registering payload.

@enabled
@useConcept(registration)
@description("Create a worker registration row on first connect.")
mutation mutationCreateWorkerRegistration {
  args {
    registrationId       string  @required
    ownerUserId          string  @required
    identityId           string  @required
    name                 string  @required
    capabilities         array   @required
    labels               object
    concurrency          object  @required
    platformInfo         object
    permissions          object
    version              string
    buildTag             string
    registeredAt         string  @required
    lastSeenAt           string
    lastConnectedFromIP  string
  }
  insert registration {
    id: args.registrationId
    args.ownerUserId
    args.identityId
    args.name
    args.capabilities
    labels: coalesce(args.labels, {})
    args.concurrency
    platformInfo: coalesce(args.platformInfo, {})
    permissions: coalesce(args.permissions, {})
    version: coalesce(args.version, "")
    buildTag: coalesce(args.buildTag, "")
    args.registeredAt
    lastSeenAt: coalesce(args.lastSeenAt, args.registeredAt)
    lastConnectedFromIP: coalesce(args.lastConnectedFromIP, "")
  }
}

// ---- mutations/v1/worker/revokeWorker.memql ----

// revokeWorker
// ============
//
// Stamps revokedAt / revokedBy / revokeReason on a worker payload.
// The agent node's worker registry checks revokedAt on every dispatch
// and on a periodic sweep -- a revoked worker's gRPC stream is closed
// out-of-band so any in-flight calls fail with worker_disconnected.

@enabled
@useConcept(registration)
@description("Revoke a worker payload.")
mutation mutationRevokeWorker {
  args {
    registrationId  string  @required
    revokedAt       string  @required
    revokedBy       string
    revokeReason    string
  }
  update registration {
    id: args.registrationId
    args.revokedAt
    revokedBy: coalesce(args.revokedBy, "")
    revokeReason: coalesce(args.revokeReason, "")
  }
}

// ---- mutations/v1/worker/softDeleteWorkerInvocation.memql ----

// softDeleteWorkerInvocation
// ===========================
//
// Soft-deletes a worker invocation row by stamping `deleted=true`
// in the payload. The concept's @skipDeleted annotation hides
// deleted rows from queries; the underlying time-series row
// survives for forensic recovery if needed.
//
// Called by the workerInvocationRetentionSweep cron once a row
// passes the WORKER_INVOCATION_RETENTION_DAYS window.

@enabled
@useConcept(invocation)
@description("Soft-delete a worker invocation row past retention.")
mutation mutationSoftDeleteWorkerInvocation {
  args {
    invocationId  string  @required
  }
  update invocation {
    id: args.invocationId
    deleted: true
  }
}

@enabled
@useConcept(user)
@description("Set User.preferences.computerUseEnabled.")
mutation mutationToggleComputerUseEnabled {
  args {
    userId   string  @required
    enabled  bool    @required
  }
  update user {
    id: args.userId
    preferences: {
        computerUseEnabled: args.enabled
      }
  }
}

@enabled
@useConcept(agentAuthorization)
@description("Set computerUseScope on an agent authorization row.")
mutation mutationUpdateAgentAuthScope {
  args {
    authorizationId   string  @required
    computerUseScope  string  @required
  }
  update agentAuthorization {
    id: args.authorizationId
    args.computerUseScope
  }
}

// ---- mutations/v1/worker/updateWorkerLastSeen.memql ----

// updateWorkerLastSeen
// ====================
//
// Heartbeat-batched lastSeenAt + lastConnectedFromIP update. The
// worker stream handler calls this opportunistically -- it does NOT
// fire on every heartbeat (15s) because that would saturate the
// engine; the in-memory registry tracks the live timestamp and
// flushes to the database every 60s or on disconnect.

@enabled
@useConcept(registration)
@description("Bump lastSeenAt + lastConnectedFromIP on a worker payload.")
mutation mutationUpdateWorkerLastSeen {
  args {
    registrationId       string  @required
    lastSeenAt           string  @required
    lastConnectedFromIP  string
  }
  update registration {
    id: args.registrationId
    args.lastSeenAt
    lastConnectedFromIP: coalesce(args.lastConnectedFromIP, "")
  }
}
