// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.traits.{ isNotDeleted, statusIsRunning }
use planner.concepts.{ plan }
use planner.shapes.{ planFull }

/// List worker invocation rows for retention pruning. When createdBefore is supplied, restricts to
/// rows created strictly before it -- the retention sweep's logic computes the cutoff (now -
/// WORKER_INVOCATION_RETENTION_DAYS) and pushes it down (#2369).
@unbounded("expired worker-invocation retention sweep -- an internal sweep that must see all")
query invocation expiredWorkerInvocations {
  args {
    createdBefore  string
  }
  filter  action!="" && isNotDeleted && when(args.createdBefore) { row.createdAt<args.createdBefore }
  shape   workerInvocationFull
}

// ---- queries/v1/worker/invocationsForPlan.memql ----

// invocationsForPlan
// ==================
//
// Telemetry feed for a Plan: every workerHost / workerComputer call
// the Plan's tasks dispatched. Backs the Tasks-page drilldown and
// the plan.completed canvas card's "view worker activity" link.
//
// Arguments:
//   planId (string, required) - v1:planner:plan.id

/// List all worker invocations belonging to a Plan.
query invocation invocationsForPlan {
  args {
    planId  string!
  }
  filter  planId==args.planId && isNotDeleted
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   workerInvocationFull
}

// ---- queries/v1/worker/invocationsForUser.memql ----

// invocationsForUser
// ==================
//
// All worker invocations across the user's plans + ad-hoc agent
// calls. Used by the operator-side observability panel and the
// per-worker activity history on /me/workers/{id}.
//
// Arguments:
//   ownerUserId (string, required) - v1:identity:user.id

// `@public` marks this query as intentionally not caller-scoped.
// The only known callsite is the worker invocation retention sweep
// (system actor). Splitting into self + system variants tracked
// under #54.
/// List worker invocations belonging to a user.
@public
query invocation invocationsForUser {
  args {
    ownerUserId  string!
  }
  filter  ownerUserId==args.ownerUserId && isNotDeleted
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   workerInvocationFull
}

/// List a user's running plans.
/// memql#2800: SERVER-SIDE ONLY. Returns another user's in-flight plans --
/// including, via withComputerUseScope, which of them hold host-control scope.
/// A caller-supplied userId is not a caller check, so over the wire this
/// enumerated any user's plans.
///
/// It cannot be scoped to actor.userId instead: its caller is the
/// killSwitchSuspendsRunningPlans automation (dsl/worker/logic.memql), which
/// fires on a USER ROW UPDATE and suspends THAT user's plans. The actor there
/// is the automation's context, not the affected user, so caller-scoping would
/// return the wrong set and silently stop the kill switch -- a security
/// control failing open while looking closed.
///
/// The automation path stamps auth.ContextWithInternalOrigin in
/// component/automations/executor.go's executeStep -- the dispatch point every
/// step type goes through -- and only for automations loaded from the
/// registered tree, so this construct stays reachable from the kill-switch
/// automation and not from a caller-submitted bundle.
///
/// NOTE the kill switch does not currently run, for an unrelated and
/// pre-existing reason: `args.event.node.id ?? ""` reaches argument
/// validation as an unevaluated CoalesceExpr (memql#2870, reproduced at the
/// merge base). The origin plumbing below is correct and was verified
/// separately; do not read it as evidence the automation works end to end. (An earlier
/// attempt stamped the `input:` block instead, which no step uses, and this
/// comment claimed success while the switch was in fact refused as a client
/// call. TestTreeLoadedAutomationReachesDispatchTrusted drives a real
/// tree-loaded automation through ExecuteWithEvent and asserts the dispatch
/// origin, and TestCompiledSourceAutomationIsUntrustedEndToEnd does the same
/// for source compiled at runtime -- a caller-submitted bundle must NOT reach
/// this construct.)
@serverOnly
query plan runningPlansForUser {
  args {
    withComputerUseScope  boolean
    userId  string!
  }
  filter  requestedBy==args.userId && statusIsRunning && when(args.withComputerUseScope) { computerUseScope!=null }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   planFull
}

// ---- queries/v1/worker/workerByIdentityId.memql ----

// workerByIdentityId
// ==================
//
// Existing-registration probe used by the WorkerService Register
// handshake. The interceptor has already resolved the worker
// identity (via workerTokenByKeyHash); this query is the
// follow-up call from upsertRegistration that decides whether to
// insert a new v1:worker:registration row or refresh the existing
// one for that identity (1:1 mapping by identityId).
//
// Arguments:
//   identityId (string, required) - v1:identity:identity.id

/// Look up the worker registration owned by an identity row.
@unbounded("worker by identityId -- bounded to a single row")
query registration workerByIdentityId {
  args {
    identityId  string!
  }
  filter  identityId==args.identityId
  shape   workerRegistrationFull
}

// ---- queries/v1/worker/workersForUser.memql ----

// workersForUser
// ==============
//
// Returns every worker (online + offline + revoked) registered to
// the given user. Backs the /me/workers panel and the agent-side
// dispatch routing path -- the registry's in-memory cache rebuilds
// from this query on agent-node startup so registrations survive
// restart.
//
// Arguments:
//   ownerUserId (string, required) - v1:identity:user.id
//
// Returns:
//   Array of registration rows in workerRegistrationFull shape,
//   most recently seen first.

// `@public` marks this query as intentionally not caller-scoped.
// Callsites: the worker dispatcher's "has any worker registered"
// probe (`integrations/agent/worker/integration.go:workerHasConfigured`)
// and the worker registration sweep (`component/worker/store.go`),
// both system-actor paths. Splitting into self + system variants
// tracked under #54.
/// List all workers owned by a user.
@public
query registration workersForUser {
  args {
    ownerUserId  string!
  }
  filter  ownerUserId==args.ownerUserId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   workerRegistrationFull
}
