// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use common.traits.{ isActiveRecord, isNotDeleted, statusIsRunning }
use planner.concepts.{ plan }
use planner.shapes.{ planFull }

/// List worker invocation rows for retention pruning. When createdBefore is supplied, restricts to
/// rows created strictly before it -- the retention sweep's logic computes the cutoff (now -
/// WORKER_INVOCATION_RETENTION_DAYS) and pushes it down (#2369).
@unbounded("expired worker-invocation retention sweep -- an internal sweep that must see all")
query invocation expiredWorkerInvocations {
  args {
    createdBefore  string
  }
  filter  action!="" && isNotDeleted && when(args.createdBefore) { row.createdAt<args.createdBefore }
  shape   workerInvocationFull
}

// ---- queries/v1/worker/invocationsForPlan.memql ----

// invocationsForPlan
// ==================
//
// Telemetry feed for a Plan: every workerHost / workerComputer call
// the Plan's tasks dispatched. Backs the Tasks-page drilldown and
// the plan.completed canvas card's "view worker activity" link.
//
// Arguments:
//   planId (string, required) - v1:planner:plan.id

/// List all worker invocations belonging to a Plan.
query invocation invocationsForPlan {
  args {
    planId  string!
  }
  filter  planId==args.planId && isNotDeleted
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   workerInvocationFull
}

// ---- queries/v1/worker/invocationsForUser.memql ----

// invocationsForUser
// ==================
//
// All worker invocations across the user's plans + ad-hoc agent
// calls. Used by the operator-side observability panel and the
// per-worker activity history on /me/workers/{id}.
//
// Arguments:
//   ownerUserId (string, required) - v1:identity:user.id

// `@public` marks this query as intentionally not caller-scoped.
// The only known callsite is the worker invocation retention sweep
// (system actor). Splitting into self + system variants tracked
// under #54.
/// List worker invocations belonging to a user.
@public
query invocation invocationsForUser {
  args {
    ownerUserId  string!
  }
  filter  ownerUserId==args.ownerUserId && isNotDeleted
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   workerInvocationFull
}

/// List a user's running plans.
/// memql#2800: SERVER-SIDE ONLY. Returns another user's in-flight plans --
/// including, via withComputerUseScope, which of them hold host-control scope.
/// A caller-supplied userId is not a caller check, so over the wire this
/// enumerated any user's plans.
///
/// It cannot be scoped to actor.userId instead: its caller is the
/// killSwitchSuspendsRunningPlans automation (dsl/worker/logic.memql), which
/// fires on a USER ROW UPDATE and suspends THAT user's plans. The actor there
/// is the automation's context, not the affected user, so caller-scoping would
/// return the wrong set and silently stop the kill switch -- a security
/// control failing open while looking closed.
///
/// The automation path stamps auth.ContextWithInternalOrigin in
/// component/automations/executor.go's executeStep -- the dispatch point every
/// step type goes through -- and only for automations loaded from the
/// registered tree, so this construct stays reachable from the kill-switch
/// automation and not from a caller-submitted bundle.
///
/// NOTE the kill switch does not currently run, for an unrelated and
/// pre-existing reason: `args.event.payload.id ?? ""` reaches argument
/// validation as an unevaluated CoalesceExpr (memql#2870, reproduced at the
/// merge base). The origin plumbing below is correct and was verified
/// separately; do not read it as evidence the automation works end to end. (An earlier
/// attempt stamped the `input:` block instead, which no step uses, and this
/// comment claimed success while the switch was in fact refused as a client
/// call. TestTreeLoadedAutomationReachesDispatchTrusted drives a real
/// tree-loaded automation through ExecuteWithEvent and asserts the dispatch
/// origin, and TestCompiledSourceAutomationIsUntrustedEndToEnd does the same
/// for source compiled at runtime -- a caller-submitted bundle must NOT reach
/// this construct.)
@serverOnly
query plan runningPlansForUser {
  args {
    withComputerUseScope  boolean
    userId  string!
  }
  filter  requestedBy==args.userId && statusIsRunning && when(args.withComputerUseScope) { computerUseScope!=null }
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   planFull
}

// ---- queries/v1/worker/workerByIdentityId.memql ----

// workerByIdentityId
// ==================
//
// Existing-registration probe used by the WorkerService Register
// handshake. The interceptor has already resolved the worker
// identity (via workerTokenByKeyHash); this query is the
// follow-up call from upsertRegistration that decides whether to
// insert a new v1:worker:registration row or refresh the existing
// one for that identity (1:1 mapping by identityId).
//
// Arguments:
//   identityId (string, required) - v1:identity:identity.id

/// Look up the worker registration owned by an identity row.
///
/// The `ownerUserId==actor.userId` conjunct is not redundant with the concept's tier -- it is
/// what makes this read's result set the SAME before and after enforcement, which
/// TestRowAuthzEnforcementLandGate is the gate for. It is satisfied at runtime because the only
/// caller, component/worker's register handshake, runs under auth.ContextWithUserActor for the
/// owner the worker_token's identity row named. A worker authenticates as worker:<id>, so without
/// that stamp this read returns nothing at all -- which is the failure that reads as "this
/// machine has never registered" and silently creates a duplicate row on every reconnect.
@actor
@unbounded("worker by identityId -- bounded to a single row")
query registration workerByIdentityId {
  args {
    identityId  string!
  }
  filter  identityId==args.identityId && ownerUserId==actor.userId
  shape   workerRegistrationFull
}

// ---- queries/v1/worker/workersForUser.memql ----

// workersForUser
// ==============
//
// Returns every worker (online + offline + revoked) registered to
// the given user. Backs the /me/workers panel and the agent-side
// dispatch routing path -- the registry's in-memory cache rebuilds
// from this query on agent-node startup so registrations survive
// restart.
//
// Arguments:
//   ownerUserId (string, required) - v1:identity:user.id
//
// Returns:
//   Array of registration rows in workerRegistrationFull shape,
//   most recently seen first.

// NO LONGER @public (epic memql#4349). It carried that annotation because its
// three callers were server-side paths passing an ownerUserId with no caller
// check -- the shape #54 tracked splitting. v1:worker:registration now declares
// the composite owner tier, and every one of those callers stamps
// auth.ContextWithUserActor for the owner before it reads, so the caller check
// the annotation excused now EXISTS. Keeping @public would have left a
// caller-supplied ownerUserId reachable over the wire against a concept whose
// rows carry a hostname, a platform and a last-connect IP.
//
// The args stay: they are what the callers pass, and with the actor conjunct
// beside them a mismatch returns nothing rather than somebody else's fleet.
/// List all workers owned by a user. Caller-scoped: the supplied owner must be the actor.
@actor
query registration workersForUser {
  args {
    ownerUserId  string!
  }
  filter  ownerUserId==args.ownerUserId && ownerUserId==actor.userId
  // Pagination (5.3 / epic #1964): bounded first page + keyset cursor over
  // (createdAt, id) instead of a full-table pull. Literal page size -- the
  // struct-query paginate directive only accepts an integer literal.
  sort     "row.createdAt", "desc"
  paginate 50
  shape   workerRegistrationFull
}

// ---- queries/v1/worker/appSessionById.memql ----

// appSessionById
// ==============
//
// One delegated app-session row with its transcript. Backs the live
// transcript panel on a task (memql#4363).

@actor
/// Read one app-session row, transcript included.
query appSession appSessionById {
  args {
    sessionId  string!
  }
  // Caller-scoped. `ownerUserId==actor.userId` implies the composite tier's
  // floor (`owner || clusterOwner`) -- A implies A||B -- so this satisfies
  // the land gate as a plain top-level conjunct. Writing the disjunction
  // here instead would be UNDECIDABLE to the enforcement analyzer, which
  // reads a disjunction inside a conjunct as opaque.
  //
  // The cluster-owner arm is therefore NOT reachable through this named
  // query: it lives in the tier's injected row admission, which is what an
  // operator's generic concept read goes through. That split is deliberate
  // -- a named read is somebody asking for their own sessions.
  filter  ownerUserId==actor.userId && row.id==args.sessionId
  shape   workerAppSessionFull
}

// ---- queries/v1/worker/appSessionsForTask.memql ----

// appSessionsForTask
// ==================
//
// Every app session a Task opened. A Task normally has one, but a
// retry opens a second: showing only the latest would hide the
// attempt that failed, which is the one worth reading.

@actor
/// List the app sessions belonging to a Task.
query appSession appSessionsForTask {
  args {
    taskId  string!
  }
  filter   ownerUserId==actor.userId && taskId==args.taskId
  sort     "row.createdAt", "desc"
  paginate 20
  shape    workerAppSessionFull
}

// ---- queries/v1/worker/appSessionsForUser.memql ----

// appSessionsForUser
// ==================
//
// The user's delegated runs, newest first. Card projection: the
// transcript is the largest field on the row by orders of magnitude,
// so a list that projected it would pull megabytes to render a
// handful of lines.

@actor
/// List the caller's app sessions, newest first, without transcripts.
query appSession appSessionsForUser {
  // Caller-scoped: the engine's own reads run under the owner's actor
  // (auth.ContextWithUserActor), the same borrowed-authority pattern the
  // campaign sender uses, so the engine never out-ranks the user whose
  // rows it is reading.
  // No when() guard here on purpose: a ConditionalFilterExpression makes
  // the whole filter undecidable to the row-authz analyzer, so it cannot
  // prove the ownership floor holds. A decidable filter that always
  // enforces the floor is worth more than an optional app narrowing the
  // one consumer does not use.
  filter   ownerUserId==actor.userId
  sort     "row.createdAt", "desc"
  paginate 50
  shape    workerAppSessionCard
}

// ---- queries/v1/worker/liveAppSessionsForUser.memql ----

// liveAppSessionsForUser
// ======================
//
// The user's sessions that have not reached a terminal status. What
// the delegation policy's maxConcurrentSessions is checked against
// BEFORE a new session is opened -- counting terminal rows would make
// the cap tighten permanently as history accumulated.

@actor
@unbounded("the concurrency-cap read -- it must see EVERY live session the user has, and a paginated read would undercount and let maxConcurrentSessions be exceeded. Bounded in practice by that same cap.")
/// List the caller's app sessions that are still live.
query appSession liveAppSessionsForUser {
  filter  ownerUserId==actor.userId && status in ["starting", "running"]
  shape   workerAppSessionCard
}

// ---- queries/v1/worker/delegationPolicyForUser.memql ----

// delegationPolicyForUser
// =======================
//
// The caller's delegation preference. Absent means "never delegate":
// the planner treats a missing row as preferSubscriptionApps=false,
// so a user who has not opted in is never surprised by an agent
// running on their laptop.

@actor
@unbounded("one row per user by construction -- the id is derived from the user id, so setDelegationPolicy updates rather than forking. The full set for one caller is at most one row.")
/// Read the caller's app-delegation policy.
query delegationPolicy delegationPolicyForUser {
  filter  ownerUserId==actor.userId
  shape   workerDelegationPolicyFull
}

// ---- The Fleet (epic memql#4349) ----
//
// THREE READS OF ONE CONCEPT, and the split is the identity/authActivity
// precedent (dsl/identity/queries.memql), not duplication. v1:worker:registration
// declares the composite tier `@rowAuthz(owner="ownerUserId", clusterOwner)`, so
// the ENGINE already ANDs `(ownerUserId==actor.userId)||(actor.isClusterOwner)`
// onto every row. What differs between the three is WHO ASKS and with what:
//
//   workersForOwnerWithStatus  the ROUTER, server-side, for a user who is not
//                              the caller (there is no caller -- a turn dispatches
//                              on behalf of the session's owner). @serverOnly, and
//                              its Go caller stamps BOTH internal origin (for the
//                              annotation) and a user actor (for the tier).
//   myWorkersWithStatus        the Fleet page, for the signed-in person.
//   allWorkersWithStatus       the Fleet page, for a cluster owner, optionally
//                              narrowed to one owner.
//
// `online` is NOT projected, because it cannot be: a shape body is a path list
// and online is `revokedAt is empty AND lastSeenAt within
// 2 x HeartbeatFlushInterval`. The rule has exactly two implementations --
// component/worker.IsOnline and clients/portal/src/fleet/online.ts -- and
// TestFleetOnlineWindowMatchesPortal fails the build when their windows
// disagree. Deriving it from the in-memory registry instead is the thing this
// design refuses: the registry is one replica's stream table, so it answers
// "connected to ME", and the fleet needs "connected to ANY replica".

/// The caller's own machines, with everything the router orders and filters on.
///
/// ONE QUERY FOR TWO READERS, and that is the point. The design had a separate
/// `workersForOwnerWithStatus(ownerUserId)` for the router, @serverOnly because a caller-supplied
/// owner id is not a caller check. It is not needed: the router has no caller of its own -- it
/// dispatches on behalf of the session's owner -- and therefore already runs under
/// auth.ContextWithUserActor for that owner. Reading `actor.userId` is then both simpler and
/// strictly safer than accepting an argument: there is no id to supply, so there is nothing to
/// enumerate, and no @serverOnly annotation to keep honest.
@actor
query registration myWorkersWithStatus {
  filter   ownerUserId==actor.userId
  sort     "row.createdAt", "asc"
  paginate 200
  shape    workerRegistrationFull
}

/// Every machine in the cluster, for a cluster owner; optionally narrowed to one owner. Backs
/// /fleet/machines' operator view, which adds an owner column.
@actor
query registration allWorkersWithStatus {
  args {
    ownerUserId  string
  }
  filter   actor.isClusterOwner==true && when(args.ownerUserId) { ownerUserId==args.ownerUserId }
  sort     "row.createdAt", "asc"
  paginate 200
  shape    workerRegistrationFull
}

/// The caller's active routing policy, or nothing when they never set one (the common case --
/// the router then applies firstFit + nextMatching).
///
/// Caller-scoped for the same reason myWorkersWithStatus is: the router runs under the session
/// owner's actor, so an ownerUserId argument would be a caller-supplied id standing in for a
/// caller check it already has.
@actor
query routingPolicy routingPolicyForOwner {
  filter   ownerUserId==actor.userId && isActiveRecord
  // NEWEST FIRST, and the router takes the first row. One active policy per
  // user is the model, but the DSL cannot enforce it (@unique is declared
  // metadata with no check, memql#2960), so the READ is what makes two active
  // rows harmless: every replica still resolves the same policy.
  sort     "row.createdAt", "desc"
  paginate 5
  shape    workerRoutingPolicyFull
}

/// The signed-in person's routing policies, newest first. The Fleet page's policy editor reads the
/// active one and writes through updateRoutingPolicy; superseded rows are kept because an
/// invocation's routing.policyId points at whichever row made the choice.
@actor
query routingPolicy myRoutingPolicies {
  filter   ownerUserId==actor.userId
  sort     "row.createdAt", "desc"
  paginate 20
  shape    workerRoutingPolicyFull
}

/// Recent calls dispatched to one of the caller's machines, newest first. Backs the per-machine
/// activity list on /fleet/machines, which renders the routing record: the strategy that chose it,
/// the candidates considered, and what it was rerouted from.
@actor
query invocation invocationsForWorker {
  args {
    workerId  string!
  }
  filter  workerId==args.workerId && ownerUserId==actor.userId && isNotDeleted
  sort     "row.createdAt", "desc"
  paginate 25
  shape   workerInvocationFull
}

/// Recent calls dispatched to ANY machine, for a cluster owner supporting somebody else's fleet.
/// The self-scoped invocationsForWorker above is what a person reads about their own machine;
/// this is its operator counterpart, and the pair exists because v1:worker:invocation declares no
/// tier -- so the caller scope has to be in the FILTER, and one filter cannot be both. Without
/// this, the Fleet page's operator view showed an empty activity list for every machine it could
/// otherwise fully describe, which reads as "this machine is idle" rather than "you are not its
/// owner".
@actor
query invocation invocationsForWorkerAsOperator {
  args {
    workerId  string!
  }
  filter  actor.isClusterOwner==true && workerId==args.workerId && isNotDeleted
  sort     "row.createdAt", "desc"
  paginate 25
  shape   workerInvocationFull
}
