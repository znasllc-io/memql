// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// killSwitchSuspendsRunningPlans
// ===============================
//
// Triggered when a v1:identity:user row updates. Detects the
// User.preferences.computerUseEnabled flip from true -> false and
// transitions every running plan owned by that user (with
// computerUseScope set) to awaitingFeedback with reason=
// kill_switch_engaged.
//
// The frontend's plan card surfaces a "re-enable computer use" link
// that flips the flag back; the user then explicitly resumes each
// affected plan (we deliberately do NOT auto-resume on flag flip --
// the kill switch is the emergency-stop, and re-enable is the
// confirmation, but resume is per-plan-explicit).
use planner.mutations.{ mutationUpdatePlanStatus }
use platform.queries.{ queryGlobalVariable }
use worker.mutations.{ mutationSoftDeleteWorkerInvocation }
use worker.queries.{ queryExpiredWorkerInvocations, queryRunningPlansForUser }

@description("Triggered on v1:identity:user update. When preferences.computerUseEnabled flips true->false, transitions every running plan owned by that user (with computerUseScope set) to awaitingFeedback with feedbackReason='kill_switch_engaged'. Re-enable flips the flag back; resume is per-plan-explicit (no auto-resume on flag flip).")
logic logicKillSwitchSuspendsRunningPlans {
  args {
    event object @required
  }
  body {
  enabled := coalesce(args.event.node.payload.preferences.computerUseEnabled, true)
  userId := coalesce(args.event.node.id, "")
  plans := queryRunningPlansForUser({ userId: userId })
  for item := range plans.Nodes() {
    suspend := if !enabled and item.payload.computerUseScope != "" {
      mutationUpdatePlanStatus({
        planId: item.id,
        status: "awaitingFeedback",
        feedbackReason: "kill_switch_engaged"
      })
    }
  }
  return plans.Len()
  }
}

// workerInvocationRetentionSweep
// ===============================
//
// Daily 02:30 UTC sweep. Soft-deletes worker-invocation rows older
// than WORKER_INVOCATION_RETENTION_DAYS (default 90). Per-user
// invocation queries already filter on @skipDeleted so the rows
// disappear from UIs the moment the soft-delete lands.
//
// Different from auditEventRetentionSweep on the identity side
// (default 365) because per-call telemetry is high-volume and
// security signals are not. Operators tune via the
// WORKER_INVOCATION_RETENTION_DAYS env var.
//
// MemQL parser limitations:
//   - The filter side of queryExpiredWorkerInvocations can't push
//     the duration math into the query (no `>` operator on
//     datetime). Per-row gating uses
//       addDuration(item.createdAt, "P{retention}D") < timestamp()
@description("Daily 02:30 UTC sweep that soft-deletes v1:worker:invocation rows older than WORKER_INVOCATION_RETENTION_DAYS (default 90). Per-row windowing via addDuration since MemQL filters can't push duration math down. Per-user invocation queries filter on @skipDeleted so rows disappear from UIs the moment the soft-delete lands.")
logic logicWorkerInvocationRetentionSweep {
  args {
    event object @required
  }
  body {
  candidates := queryExpiredWorkerInvocations({})
  retention := queryGlobalVariable({ name: "WORKER_INVOCATION_RETENTION_DAYS" })

  for item := range candidates.Nodes() {
    sweep := if addDuration(item.createdAt, concat("P", coalesce(retention.First().payload.value, "90"), "D")) < timestamp() {
      mutationSoftDeleteWorkerInvocation({
        invocationId: item.id
      })
    }
  }

  return candidates.Len()
  }
}

