// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// killSwitchSuspendsRunningPlans
// ===============================
//
// Triggered when a v1:identity:user row updates. Detects the
// User.preferences.computerUseEnabled flip from true -> false and
// transitions every running plan owned by that user (with
// computerUseScope set) to awaitingFeedback with reason=
// kill_switch_engaged.
//
// The frontend's plan card surfaces a "re-enable computer use" link
// that flips the flag back; the user then explicitly resumes each
// affected plan (we deliberately do NOT auto-resume on flag flip --
// the kill switch is the emergency-stop, and re-enable is the
// confirmation, but resume is per-plan-explicit).
use platform.queries.{ globalVariable }
use worker.queries.{ expiredWorkerInvocations, runningPlansForUser }

@description("Pure decide for the kill-switch sweep: returns every running plan owned by the updated user. The suspend write + the gate (computerUseEnabled==false AND the plan has a computerUseScope) live in the killSwitchSuspendsRunningPlans automation's forEach step (#2235). Re-enable flips the flag back; resume is per-plan-explicit.")
logic killSwitchSuspendsRunningPlans {
  args {
    event object @required
  }
  body {
  return runningPlansForUser({ userId: coalesce(args.event.node.id, "") })
  }
}

// workerInvocationRetentionSweep
// ===============================
//
// Daily 02:30 UTC sweep. Soft-deletes worker-invocation rows older
// than WORKER_INVOCATION_RETENTION_DAYS (default 90). Per-user
// invocation queries already filter on @skipDeleted so the rows
// disappear from UIs the moment the soft-delete lands.
//
// Different from auditEventRetentionSweep on the identity side
// (default 365) because per-call telemetry is high-volume and
// security signals are not. Operators tune via the
// WORKER_INVOCATION_RETENTION_DAYS env var.
//
// MemQL parser limitations:
//   - The filter side of expiredWorkerInvocations can't push
//     the duration math into the query (no `>` operator on
//     datetime). Per-row gating uses
//       addDuration(item.createdAt, "P{retention}D") < now
@description("Pure decide for the worker-invocation retention sweep: returns every soft-deletable candidate row. The retention-var read, the per-row window gate (createdAt + P{N}D < now), and the soft-delete write live in the workerInvocationRetentionSweep automation's window + forEach steps (#2235; the date-window gate is evaluated correctly by the condition evaluator since #2256/#2254).")
logic workerInvocationRetentionSweep {
  args {
    event object @required
  }
  body {
  candidates := expiredWorkerInvocations({})
  return candidates.nodes()
  }
}


// workerInvocationRetentionWindow -- pure read of the retention window
// global variable for the workerInvocationRetentionSweep automation's
// per-row date gate (#2235). Returns the v1:platform:globalVariable row so
// the automation reads window.first().payload.value in its forEach `if`.
@enabled
@description("Pure read: returns the WORKER_INVOCATION_RETENTION_DAYS global variable row for the workerInvocationRetentionSweep automation's per-row window gate (#2235).")
logic workerInvocationRetentionWindow {
  args {
    event object @required
  }
  body {
  return globalVariable({ name: "WORKER_INVOCATION_RETENTION_DAYS" })
  }
}
