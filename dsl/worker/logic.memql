// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// workerInvocationRetentionSweep
// ===============================
//
// Daily 02:30 UTC sweep. Soft-deletes worker-invocation rows older
// than WORKER_INVOCATION_RETENTION_DAYS (default 90). Per-user
// invocation queries already filter on the isNotDeleted trait (see
// dsl/worker/queries.memql) so the rows disappear from UIs the moment
// the soft-delete lands.
//
// Different from auditEventRetentionSweep on the identity side
// (default 365) because per-call telemetry is high-volume and
// security signals are not. Operators tune via the
// WORKER_INVOCATION_RETENTION_DAYS env var.
//
// The retention cutoff (now minus the window, addDuration with a
// negative ISO-8601 duration) is computed here and passed to
// expiredWorkerInvocations as `createdBefore`, so the comparison
// runs in the query's filter; the calling automation's `for` loop
// soft-deletes each returned row.
/// Pure decide for the worker-invocation retention sweep (#2369, cluster pruneStaleClusterNodes
/// pattern): reads WORKER_INVOCATION_RETENTION_DAYS (default 90), computes cutoff = now - window
/// via addDuration with a negative ISO duration, reads
/// `query expiredWorkerInvocations(createdBefore: cutoff)` and returns its nodes() -- rows past
/// retention, filtered by QUERY PUSHDOWN. The retention policy lives entirely here; the calling
/// automation's `for` loop soft-deletes each unconditionally.
logic workerInvocationRetentionSweep {
  args {
    event object!
  }
  windowDays := query globalVariable(name: "WORKER_INVOCATION_RETENTION_DAYS")
  candidates := query expiredWorkerInvocations(createdBefore: addDuration(now, "P-" + (windowDays.first().value ?? "90") + "D"))
  return candidates.nodes()
}


// workerModelPullStaleSweep
// =========================
//
// The other half of the model-pull design (epic memql#5103, design D3), and
// the half nobody sees when it works.
//
// A pull is claimed by ONE agent replica -- the one holding the machine's
// stream when the act ran -- which is what makes the claim deterministic and
// lock-free. The cost of that choice is the case where the named replica is
// gone: scaled down, restarted, killed. Nothing then picks the row up, no
// event is raised (a process that dies emits none), and the OS shows a
// spinner that never resolves.
//
// A spinner that never resolves is the one outcome this surface must not
// produce, so something has to LOOK. This is the looking.

/// Every model pull nobody is driving, judged by TWO cutoffs.
///
/// A row still at `requested` past the CLAIM grace was never picked up: the replica named on it
/// is not there. A row at `running` past the STALL grace was claimed and then lost mid-download.
/// The two are separated because one cutoff applied to both fails every ACTIVE pull the moment it
/// is older than the claim grace -- see openModelPulls, which carries that reasoning at the point
/// the filter expresses it.
///
/// THE STALL GRACE MUST EXCEED THE HANDLE'S OWN IDLE CEILING
/// (`component/worker.ModelPullIdleDefault`, 5 minutes). The runtime watcher gives up on a silent
/// machine first and writes a real verdict; a row watcher that fired earlier would replace that
/// verdict with a guess, and would do it while the download was still running.
///
/// Both graces are read from globalVariables so an operator can widen them on a slow cluster
/// without a release, and both default generously: failing a pull that is merely slow is worse
/// than leaving a dead one on screen for another minute.
logic workerModelPullStaleSweep {
  args {
    event object!
  }
  claimGrace := query globalVariable(name: "MEMQL_MODEL_PULL_CLAIM_GRACE_SECONDS")
  stallGrace := query globalVariable(name: "MEMQL_MODEL_PULL_STALL_GRACE_SECONDS")
  abandoned := query openModelPulls(
    requestedBefore: addDuration(now, "PT-" + (claimGrace.first().value ?? "90") + "S"),
    updatedBefore: addDuration(now, "PT-" + (stallGrace.first().value ?? "420") + "S")
  )
  return abandoned.nodes()
}


// workerModelProbeStaleSweep
// ==========================
//
// The pull sweep's sibling (epic memql#5146, D3), and it exists for the same
// reason: a probe is claimed by ONE agent replica, and the cost of a
// deterministic lock-free claim is the case where the named replica is gone.
// Nothing picks the row up, no event is raised because a process that dies
// emits none, and the machine page shows a case counter that never advances.
//
// A probe is MORE exposed to this than a pull, not less. A request nobody
// picked up costs a person nothing but a stuck row; a probe nobody FINISHED
// may have left a suite running on their GPU, and the row is the only thing
// that will ever say so.

/// Every model probe nobody is driving, judged by TWO cutoffs.
///
/// A row still at `requested` past the CLAIM grace was never picked up: the replica named on it is
/// not there. A row at `running` past the STALL grace was claimed and then lost mid-suite. The two
/// are separated because one cutoff applied to both fails every ACTIVE probe the moment it is older
/// than the claim grace -- see openModelProbes, which carries that reasoning where the filter
/// expresses it.
///
/// THE STALL GRACE MUST EXCEED THE HANDLE'S OWN IDLE CEILING
/// (`component/worker.DefaultModelProbeIdleTimeout`, 5 minutes), and here the margin matters more
/// than it does for a pull: a single 32K throughput case on a modest machine can be minutes of
/// silence that is not silence at all. The runtime watcher gives up on a genuinely dead machine
/// first and writes a real verdict; a row watcher that fired earlier would replace that verdict
/// with a guess, while the suite was still running.
///
/// Both graces are read from globalVariables so an operator can widen them on a slow cluster
/// without a release, and both default generously: failing a probe that is merely slow is worse
/// than leaving a dead one on screen for another minute.
logic workerModelProbeStaleSweep {
  args {
    event object!
  }
  claimGrace := query globalVariable(name: "MEMQL_MODEL_PROBE_CLAIM_GRACE_SECONDS")
  stallGrace := query globalVariable(name: "MEMQL_MODEL_PROBE_STALL_GRACE_SECONDS")
  abandoned := query openModelProbes(
    requestedBefore: addDuration(now, "PT-" + (claimGrace.first().value ?? "90") + "S"),
    updatedBefore: addDuration(now, "PT-" + (stallGrace.first().value ?? "900") + "S")
  )
  return abandoned.nodes()
}


// workerStaleConnectionSweep
// ==========================
//
// The third sweep in this file, and the one whose absence was a lie rather
// than a stall (epic memql#5327, design D7).
//
// connectedNodeId names the replica holding a machine's stream. It is stamped
// on register, re-asserted on every heartbeat flush, and cleared by a GRACEFUL
// close -- which a SIGKILLed agent pod does not perform, and every redeploy
// renames pods. So the stamp outlived the pod, StreamHeld read true for a
// stream nobody held, the Fleet page showed the machine online, and the router
// forwarded to a replica that no longer existed.
//
// What makes this different from its two siblings above: they close rows that
// somebody is WATCHING, so their cost is a spinner. This one corrects a row
// somebody is BELIEVING, and the belief is "that machine is up".

/// Every registration still naming a holder that stopped heartbeating, for the sweep that clears
/// the stamp.
///
/// ONE CUTOFF, unlike the pull and probe sweeps, because there is only one thing to judge: a
/// heartbeat arrives THROUGH the stream on the holding pod, so a stale lastSeenAt IS the evidence
/// that the pod named on the row is not holding it. No second read of which nodes are alive --
/// that read can be stale in the other direction and would clear a live hold.
///
/// The grace is read from a globalVariable so an operator can widen it on a cluster whose
/// heartbeats are slow, and it defaults to the engine's own StaleHoldWindow (45s: the online
/// window plus one throttled flush interval). Clearing a hold that is merely late costs the
/// machine one heartbeat to re-stamp; leaving a dead one costs every routing decision that
/// forwards to a replica that is gone.
logic workerStaleConnectionSweep {
  args {
    event object!
  }
  holdGrace := query globalVariable(name: "MEMQL_WORKER_STALE_HOLD_GRACE_SECONDS")
  stranded := query registrationsWithStaleHold(
    lastSeenBefore: addDuration(now, "PT-" + (holdGrace.first().value ?? "45") + "S")
  )
  return stranded.nodes()
}
