// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

// requireLabels / preferLabels, AND NO workerId (design D4, memql#4351).
// The agent says what the work NEEDS -- os=darwin, has-gpu=true -- and the
// owner's routingPolicy decides which of their machines that lands on. There
// is no argument through which a model can name a machine, so a hallucinated
// machine id is a failure mode this surface does not have; the worst a wrong
// label can do is narrow the candidate set to nothing, which is reported as
// no_worker_available with the candidates considered.
//
// requireLabels is AND-ed with the owner's policy requirement and filters;
// preferLabels only orders. Both are matched against the MERGE of the
// registration's cockpit `labels` and owner-set `operatorLabels`, operator side
// winning.
@executor("integration.agentworker.dispatchComputer")
@args(profile="object")
@description("Dispatch a workerComputer.<action> call to the user's computer-use-capable worker.")
builtin agentworkerDispatchComputer {
  action         string!
  args           object
  agentId        string
  ownerUserId    string
  planId         string
  taskId         string
  correlationId  string
  requireLabels  object
  preferLabels   object
}

// ---- queries/v1/worker/builtin/builtinAgentworkerDispatchHost.memql ----

// builtinAgentworkerDispatchHost - Dispatch a workerHost call
// ============================================================
//
// Bridges the workerHost.memql tool definition to the agentworker
// Go integration. Called via @handler(type="query") on the tool.

@executor("integration.agentworker.dispatchHost")
@args(profile="object")
@description("Dispatch a workerHost.<action> call to the user's connected worker.")
builtin agentworkerDispatchHost {
  action         string!
  args           object
  agentId        string
  ownerUserId    string
  planId         string
  taskId         string
  correlationId  string
  requireLabels  object
  preferLabels   object
}

// ---- queries/v1/worker/builtin/builtinAgentworkerListWorkers.memql ----

// builtinAgentworkerListWorkers - List the user's connected workers
// ==================================================================

@executor("integration.agentworker.listWorkers")
@args(profile="object")
@description("List workers connected for the supplied user. Returns a JSON list of {registrationId, name, capabilities, ...}.")
builtin agentworkerListWorkers {
  ownerUserId  string!
}

// ---- queries/v1/worker/builtin/builtinAgentworkerRequestScope.memql ----

// builtinAgentworkerRequestScope - Scope-elevation request bridge
// =================================================================
//
// Bridges the requestComputerUseScope.memql tool definition to the
// agentworker Go integration's `requestScope` capability. The
// integration creates a v1:planner:plan in awaitingFeedback +
// emits a canvas card; the agent's tool result is just a small
// JSON payload acknowledging the request.

// requireLabels is what makes the card's promise honest (design D6). The
// user's Allow covers the task on ANY of their machines that match, so the
// card has to SAY which machines those are -- "on any of your machines
// matching os=darwin -- currently Jose's MacBook". A card that named one
// machine and then ran the work on another would be a consent surface that
// described something other than what it authorized.
@executor("integration.agentworker.requestScope")
@args(profile="object")
@description("Create a scope-elevation Plan + canvas card for a computer_use task awaiting user approval.")
builtin agentworkerRequestScope {
  intent          string!
  requestedScope  string!
  summary         string!
  agentId         string!
  ownerUserId     string!
  partitionId         string
  requireLabels   object
}

// ---- queries/v1/worker/builtin/builtinAgentworkerStatus.memql ----

// builtinAgentworkerStatus - Live worker-availability query
// ===========================================================
//
// Bridges the workerStatus.memql tool definition to the
// agentworker Go integration's `status` capability. Returns the
// same three-state result (connected / disconnected / unconfigured)
// the agentReply prompt is seeded with on every turn, but pulled
// fresh at call time.

@executor("integration.agentworker.status")
@args(profile="object")
@description("Resolve the live computer-use availability for the calling agent's owner user.")
builtin agentworkerStatus {
  ownerUserId  string!
  agentId      string
}
