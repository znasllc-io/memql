// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@executor("integration.agentworker.dispatchComputer")
@args(profile="object")
@description("Dispatch a workerComputer.<action> call to the user's computer-use-capable worker.")
builtin agentworkerDispatchComputer {
  action         string  @required
  args           object
  agentId        string
  ownerUserId    string
  planId         string
  taskId         string
  correlationId  string
}

