// ---- queries/v1/worker/builtin/builtinAgentworkerRequestScope.memql ----

// builtinAgentworkerRequestScope - Scope-elevation request bridge
// =================================================================
//
// Bridges the requestComputerUseScope.memql tool definition to the
// agentworker Go integration's `requestScope` capability. The
// integration creates a v1:planner:plan in awaitingFeedback +
// emits a canvas card; the agent's tool result is just a small
// JSON payload acknowledging the request.

@executor("integration.agentworker.requestScope")
@args(profile="object")
@description("Create a scope-elevation Plan + canvas card for a computer_use task awaiting user approval.")
builtin agentworkerRequestScope {
  intent          string  @required
  requestedScope  string  @required
  summary         string  @required
  agentId         string  @required
  ownerUserId     string  @required
  partitionId         string
}

// ---- queries/v1/worker/builtin/builtinAgentworkerStatus.memql ----

// builtinAgentworkerStatus - Live worker-availability query
// ===========================================================
//
// Bridges the workerStatus.memql tool definition to the
// agentworker Go integration's `status` capability. Returns the
// same three-state result (connected / disconnected / unconfigured)
// the agentReply prompt is seeded with on every turn, but pulled
// fresh at call time.

@executor("integration.agentworker.status")
@args(profile="object")
@description("Resolve the live computer-use availability for the calling agent's owner user.")
builtin agentworkerStatus {
  ownerUserId  string  @required
  agentId      string
}
