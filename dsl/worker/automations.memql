// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use planner.mutations.{ updatePlanStatus }

/// Suspend the user's worker-using plans when computerUseEnabled flips false. The TRIGGER RELEVANCE
/// check (kill switch engaged) lives on @filter; the plan-classification policy (has a
/// computerUseScope) is pushed down into runningPlansForUser by the decide logic; the forEach
/// transitions each returned plan unconditionally (#2370).
@trigger(event="node.updated", concept="v1:identity:user", partition="*")
@filter(event.node.payload.preferences.computerUseEnabled == false)
automation killSwitchSuspendsRunningPlans {
  step decide {
    logic killSwitchSuspendsRunningPlans ( event: event )
  }
  step apply {
    forEach item in decide.nodes() {
      updatePlanStatus {
        planId: item.id,
        status: "awaitingFeedback",
        feedbackReason: "kill_switch_engaged"
      }
    }
  }
}

/// Daily 02:30 UTC sweep: soft-delete worker-invocation rows past WORKER_INVOCATION_RETENTION_DAYS.
/// decide (pure) returns the candidate rows; window reads the retention var; the forEach apply
/// gates each row on createdAt + P{N}D < now (#2256/#2254 evaluator fix) and soft-deletes it.
@trigger(schedule="0 30 2 * * *")
automation workerInvocationRetentionSweep {
  step decide {
    logic workerInvocationRetentionSweep ( event: event )
  }
  step apply {
    forEach item in decide.result {
      softDeleteWorkerInvocation {
        invocationId: item.id
      }
    }
  }
}
