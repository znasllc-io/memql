// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

use worker.logic.{ killSwitchSuspendsRunningPlans, workerInvocationRetentionSweep, workerInvocationRetentionWindow }
use worker.mutations.{ softDeleteWorkerInvocation }
use planner.mutations.{ updatePlanStatus }

@enabled
@trigger(event="node.updated", concept="v1:identity:user", partition="*")
@description("Suspend the user's worker-using plans when computerUseEnabled flips false. decide (pure) returns the running plans; the forEach apply gates each on computerUseEnabled==false AND the plan having a computerUseScope, then transitions it to awaitingFeedback.")
automation killSwitchSuspendsRunningPlans {
  step decide {
    logic killSwitchSuspendsRunningPlans { event: event }
  }
  step apply {
    forEach item in decide.nodes() {
      if exists(item.payload.computerUseScope) && event.node.payload.preferences.computerUseEnabled == false {
        updatePlanStatus {
          planId: item.id,
          status: "awaitingFeedback",
          feedbackReason: "kill_switch_engaged"
        }
      }
    }
  }
}

// workerInvocationRetentionSweep
// ===============================
//
// Daily 02:30 UTC sweep. Soft-deletes worker-invocation rows older
// than WORKER_INVOCATION_RETENTION_DAYS (default 90). Per-user
// invocation queries already filter on @skipDeleted so the rows
// disappear from UIs the moment the soft-delete lands.
//
// Different from auditEventRetentionSweep on the identity side
// (default 365) because per-call telemetry is high-volume and
// security signals are not. Operators tune via the
// WORKER_INVOCATION_RETENTION_DAYS env var.
//
// MemQL parser limitations:
//   - The filter side of expiredWorkerInvocations can't push
//     the duration math into the query (no `>` operator on
//     datetime). Per-row gating uses
//       addDuration(item.createdAt, "P{retention}D") < now
@enabled
@trigger(schedule="0 30 2 * * *")
@description("Daily 02:30 UTC sweep: soft-delete worker-invocation rows past WORKER_INVOCATION_RETENTION_DAYS. decide (pure) returns the candidate rows; window reads the retention var; the forEach apply gates each row on createdAt + P{N}D < now (#2256/#2254 evaluator fix) and soft-deletes it.")
automation workerInvocationRetentionSweep {
  step window {
    logic workerInvocationRetentionWindow { event: event }
  }
  step decide {
    logic workerInvocationRetentionSweep { event: event }
  }
  step apply {
    forEach item in decide.result {
      if addDuration(item.createdAt, concat("P", coalesce(window.first().payload.value, "90"), "D")) < now {
        softDeleteWorkerInvocation {
          invocationId: item.id
        }
      }
    }
  }
}
