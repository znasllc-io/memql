// ---- providers/v1/openai/embedding3Large.memql ----

/// OpenAI text-embedding-3-large for high-fidelity vector embeddings (3072 dimensions)
@extends("openai")
@vendor("OpenAIEmbedding")
@model("text-embedding-3-large")
@modality("embedding")
provider embedding3Large {
  params {
    dimensions    3072
    // The vendor's per-request input limit, in tokens. It is declared because
    // the router's context floor became a LIVE gate in epic memql#5127 and
    // fails CLOSED: a record with no window is passed over as soon as a call
    // states one, so an undeclared limit here would refuse every embedding
    // call rather than silently truncating.
    contextWindow 8191
  }
}

// ---- providers/v1/openai/embedding3Small.memql ----

/// OpenAI text-embedding-3-small for cheaper vector embeddings (1536 dimensions); default for
/// high-volume retrieval
@extends("openai")
@vendor("OpenAIEmbedding")
@model("text-embedding-3-small")
@modality("embedding")
provider embedding3Small {
  params {
    dimensions    1536
    // See embedding3Large: the context floor is a live, fail-closed gate.
    contextWindow 8191
  }
}

// ---- providers/v1/openai/moderationOmni.memql ----

@base
@vendor("OpenAI")
provider openai {
  auth {
    // OpenAI workload identity federation (memql#5088). The 2026-08-22 record
    // said OpenAI offered no federation; that was wrong when written -- it has
    // been generally available since 2025-05-26 -- and this block is what
    // replaced the static key.
    //
    // ALL THREE OR NONE: all three set means the engine exchanges the pod's
    // projected token for a short-lived bearer, none means the OpenAI
    // providers register as unavailable (the normal state of a fresh cloud
    // cluster and of EVERY local cluster, whose OIDC issuer is private and
    // cannot be discovered), and one or two refuses boot naming both halves.
    // Optional at resolution, like Anthropic's, so openaiCredential is the one
    // place that decides what an absence means.
    // Runbook: docs/public/operate/auth/openai-federation.md.
    identityProviderId  env("MEMQL_AI_OPENAI_IDENTITY_PROVIDER_ID")
    serviceAccountId    env("MEMQL_AI_OPENAI_SERVICE_ACCOUNT_ID")
    identityTokenFile   env("MEMQL_AI_OPENAI_IDENTITY_TOKEN_FILE")
  }
}

// ---- providers/v1/openai/stream54Pro.memql ----

// stream54Pro - "Pro tier" streaming OpenAI chat
// =================================================
//
// Routed-to as a fallback in the `strongReasoning` policy chain
// (streamClaudeSonnet -> stream54Pro). Concept:
// "if the primary Claude is out, use the strongest OpenAI chat
// model the v1/chat/completions endpoint accepts."
//
// IMPORTANT: this provider ALIASES to the `gpt-5.4` flagship chat
// model -- NOT to `gpt-5.4-pro`. OpenAI hosts `gpt-5.4-pro` only
// on the v1/responses endpoint (the new Responses API for the
// reasoning-focused "pro" tier). Sending `gpt-5.4-pro` to the
// streaming chat-completions endpoint returns
//
//     404 Not Found -- "This is not a chat model and thus not
//     supported in the v1/chat/completions endpoint. Did you
//     mean to use v1/completions?"
//
// which silently kills the agent's tool-loop fallback when the
// primary (Anthropic) is out of credits / rate-limited / down.
// `gpt-5.4` IS chat-completion-supported, so the chain stays
// working with this aliasing. The "Pro" semantic is preserved in
// the provider name + description; if/when this codebase grows
// Responses API support, swap the @model back to `gpt-5.4-pro`
// AND route the call to the responses endpoint instead of chat
// completions.
//
// Verified the alias by curling the live OpenAI API for both
// names from this project's service-account key on 2026-05-09:
//   gpt-5.4-pro -> 404 "not a chat model"
//   gpt-5.4     -> OK (streams + tools work)

// ---- providers/v1/anthropic/reasoningClaudeOpus.memql ----
//
// Claude Opus 4.6 with extended-thinking enabled. The same model as
// streamClaudeOpus, just with a thinkingBudgetTokens param that the
// anthropicStreamProvider reads via anthropicThinking() and injects
// into every MessageNewParams build. The Anthropic API runs the
// model with an internal reasoning budget BEFORE emitting the user-
// visible response -- the "extended thinking" surface documented at
// https://docs.claude.com/en/docs/build-with-claude/extended-thinking.
//
// Use this provider when an agent's job is reasoning-heavy: the
// planner (decomposing a goal into phases + tasks), the agent
// factory's role / tool selection, training-plan composition, etc.
// For chat replies, summaries, or anything latency-sensitive, stay
// on streamClaudeOpus (or Sonnet) -- extended thinking adds 5-30s
// of latency depending on budget.
//
// Constraints baked in here:
//   - maxTokens raised to 16384 so the reasoning budget (8192) leaves
//     room for a meaningful response. Per API rules,
//     thinkingBudgetTokens must be < maxTokens.
//   - thinkingBudgetTokens 8192 is a reasonable mid-tier budget --
//     enough for multi-step planning without paying for an
//     uncapped think. Tune up to 16384 if specific agents prove
//     reasoning-budget-bound; tune down to 4096 if cost becomes
//     the constraint.
//   - The anthropicStreamProvider suppresses the temperature param
//     when thinking is enabled (Anthropic API requires temp==1
//     under extended thinking). Callers do not need to coordinate.
/// Claude Opus 4.6 with extended-thinking enabled. Same model as streamClaudeOpus but the API
/// reasons over an 8192-token internal budget before answering. Use for planner / factory /
/// training-plan-composition workloads; stay on streamClaudeOpus for chat replies and
/// latency-sensitive flows.
@extends("anthropic")
@model("claude-opus-4-6")
provider reasoningClaudeOpus {
  params {
    streaming                  true
    contextWindow              200000
    maxTokens                  16384
    thinkingBudgetTokens       8192
    inputCostPerMillion        15.00
    outputCostPerMillion       75.00
    cachedInputCostPerMillion  1.50
  }
}

