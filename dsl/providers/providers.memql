// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@base
@vendor("Anthropic")
provider anthropic {
  auth {
    // Workload identity federation is the ONLY door (memql#4333, and the key
    // arm removed by memql#5088). The engine presents its Kubernetes
    // service-account token instead of holding a key: all four of rule /
    // organization / service account / token file set means federate, NONE
    // means the Anthropic providers register as unavailable, and one to three
    // refuses boot. There is no apiKey entry here and there is no key
    // anywhere else either -- TestNoVendorApiKeyEntryPoint fails the build on
    // one coming back.
    //
    // Every one of these is OPTIONAL at resolution -- unlike a normal auth
    // placeholder, an unset federation id leaves the field empty and
    // anthropicCredential decides what that means (see optionalAuthEnvNames
    // in ai_anthropic_federation.go).
    // Runbook: docs/public/operate/auth/anthropic-federation.md.
    federationRuleId   env("MEMQL_AI_ANTHROPIC_FEDERATION_RULE_ID")
    organizationId     env("MEMQL_AI_ANTHROPIC_ORGANIZATION_ID")
    serviceAccountId   env("MEMQL_AI_ANTHROPIC_SERVICE_ACCOUNT_ID")
    workspaceId        env("MEMQL_AI_ANTHROPIC_WORKSPACE_ID")
    identityTokenFile  env("MEMQL_AI_ANTHROPIC_IDENTITY_TOKEN_FILE")
  }
}

// MEMQL_AI_OPENAI_PROJECT_ID is intentionally NOT listed here because
// env() placeholders fail registration when the variable is unset,
// and service-account keys (sk-svcacct-*) do not carry a project id.
// Provider clients read MEMQL_AI_OPENAI_PROJECT_ID directly via
// os.Getenv and attach the OpenAI-Project header only when present.

// ---- providers/v1/openai/chat53Latest.memql ----

/// OpenAI gpt-5.3-chat-latest - auto-updated chat-tuned alias (non-streaming); use for dev/preview
/// flows where you want newest tuning without a code change
@extends("openai")
@model("gpt-5.3-chat-latest")
provider chat53Latest {
  params {
    streaming                  true
    contextWindow        128000
    maxCompletionTokens  4096
  }
}

// ---- providers/v1/openai/chat54.memql ----

/// OpenAI GPT-5.4 - flagship standard-tier chat (non-streaming)
@extends("openai")
@model("gpt-5.4")
provider chat54 {
  params {
    streaming                  true
    contextWindow              128000
    maxCompletionTokens        4096
    inputCostPerMillion        2.50
    outputCostPerMillion       10.00
    cachedInputCostPerMillion  1.25
  }
}

// ---- providers/v1/openai/chat54Mini.memql ----

/// OpenAI GPT-5.4 Mini - balanced cost/latency chat (non-streaming)
@extends("openai")
@model("gpt-5.4-mini")
provider chat54Mini {
  params {
    streaming                  true
    contextWindow              128000
    // Bumped 4096 -> 16384 because seedDomainContent's structured
    // schema (up to 50 chunks, 100-300 words each) hit the cap with
    // finish_reason=length and returned empty content. The new si-
    // provider error path now surfaces the cause, but bumping the
    // budget removes the failure mode entirely. Output is still
    // bounded by the schema's maxItems=50 so a runaway response
    // can't blow the wallet.
    maxCompletionTokens        16384
    // CORRECTED 2026-08-16 (memql#3854). Was 0.15 / 0.60 / 0.075 -- the
    // gpt-4o-mini rates, carried forward through two model renames while the
    // MODEL underneath changed twice. Official gpt-5.4-mini list is
    // $0.75 / $4.50 per million, so every cost this provider reported was
    // understated FIVE-fold on input and SEVEN-fold on output.
    //
    // It mattered from the moment MemQL Cloud attached billing to it (epic
    // memql#3852): these numbers price the AI cost of goods that the tier
    // margins are computed against, and an understated cost does not present
    // as an error -- it presents as a business that looks profitable. The
    // margin targets the epic commits to (>=21% Node, >=35% Graph, >=40% Mesh
    // at full allowance consumption) are only meaningful if the input is real.
    inputCostPerMillion        0.75
    outputCostPerMillion       4.50
    cachedInputCostPerMillion  0.075
  }
}

// ---- providers/v1/openai/chat54Nano.memql ----

/// OpenAI GPT-5.4 Nano - cheapest high-volume chat for low-complexity tasks (non-streaming)
@extends("openai")
@model("gpt-5.4-nano")
provider chat54Nano {
  params {
    streaming                  true
    contextWindow              32000
    maxCompletionTokens        2048
    inputCostPerMillion        0.10
    outputCostPerMillion       0.40
    cachedInputCostPerMillion  0.05
  }
}

// ---- providers/v1/openai/chat54Pro.memql ----

// chat54Pro - "Pro tier" non-streaming OpenAI chat
// ===================================================
//
// Sister provider to stream54Pro for the synchronous chat path
// (suggest endpoints, voice-path InvokeAI). Same reasoning as
// stream54Pro: aliases to `gpt-5.4` because `gpt-5.4-pro` is the
// responses-API-only "pro" tier and rejects v1/chat/completions
// requests with a 404 "not a chat model" error. Switch the
// @model back to `gpt-5.4-pro` when this codebase adds Responses
// API support and routes pro-tier calls there instead.

/// OpenAI GPT-5.4 Pro tier (non-streaming) -- aliases to gpt-5.4 because gpt-5.4-pro is
/// responses-API only; switch the @model back when responses-API support lands
@extends("openai")
@model("gpt-5.4")
provider chat54Pro {
  params {
    streaming                  true
    contextWindow              256000
    maxCompletionTokens        8192
    inputCostPerMillion        5.00
    outputCostPerMillion       20.00
    cachedInputCostPerMillion  2.50
  }
}

