// ---- providers/v1/openai/chat54.memql ----

/// OpenAI GPT-5.4 - the flagship two generations back, still served
@extends("openai")
@model("gpt-5.4")
provider chat54 {
  params {
    streaming                  true
    levels                     "strong"
    rank                       600
    contextWindow              272000
    maxCompletionTokens        4096
    // CORRECTED 2026-11-22 from the vendor's pricing page. Was 10.00 out and
    // 1.25 cached: output understated by a third.
    inputCostPerMillion        2.50
    outputCostPerMillion       15.00
    cachedInputCostPerMillion  0.25
  }
}

// ---- providers/v1/openai/chat54Mini.memql ----

/// OpenAI GPT-5.4 Mini - balanced cost/latency chat
@extends("openai")
@model("gpt-5.4-mini")
provider chat54Mini {
  params {
    streaming                  true
    // The quick tier, which is how every prompt that names this record
    // describes it.
    levels                     "fast"
    rank                       340
    // The vendor's window is 400,000 with at most 272,000 of it input.
    contextWindow              272000
    // Bumped 4096 -> 16384 because seedDomainContent's structured
    // schema (up to 50 chunks, 100-300 words each) hit the cap with
    // finish_reason=length and returned empty content. The new si-
    // provider error path now surfaces the cause, but bumping the
    // budget removes the failure mode entirely. Output is still
    // bounded by the schema's maxItems=50 so a runaway response
    // can't blow the wallet.
    maxCompletionTokens        16384
    // CORRECTED 2026-08-16 (memql#3854). Was 0.15 / 0.60 / 0.075 -- the
    // gpt-4o-mini rates, carried forward through two model renames while the
    // MODEL underneath changed twice. Official gpt-5.4-mini list is
    // $0.75 / $4.50 per million, so every cost this provider reported was
    // understated FIVE-fold on input and SEVEN-fold on output.
    //
    // It mattered from the moment MemQL Cloud attached billing to it (epic
    // memql#3852): these numbers price the AI cost of goods that the tier
    // margins are computed against, and an understated cost does not present
    // as an error -- it presents as a business that looks profitable. The
    // margin targets the epic commits to (>=21% Node, >=35% Graph, >=40% Mesh
    // at full allowance consumption) are only meaningful if the input is real.
    inputCostPerMillion        0.75
    outputCostPerMillion       4.50
    cachedInputCostPerMillion  0.075
  }
}

// ---- providers/v1/openai/chat54Nano.memql ----

/// OpenAI GPT-5.4 Nano - cheapest high-volume chat for low-complexity tasks. OpenAI lists it as
/// deprecated and shuts it down on 2027-04-01.
@extends("openai")
@model("gpt-5.4-nano")
provider chat54Nano {
  params {
    streaming                  true
    levels                     "fast"
    rank                       150
    contextWindow              272000
    maxCompletionTokens        2048
    // CORRECTED 2026-11-22 from the vendor's pricing page. Was 0.10 / 0.40 /
    // 0.05: input understated by half and output by two thirds.
    inputCostPerMillion        0.20
    outputCostPerMillion       1.25
    cachedInputCostPerMillion  0.02
  }
}

// ---- providers/v1/openai/chat54Pro.memql ----

// chat54Pro - "Pro tier" non-streaming OpenAI chat
// ===================================================
//
// Sister provider to stream54Pro for the synchronous chat path
// (suggest endpoints, voice-path InvokeAI). Same reasoning as
// stream54Pro: aliases to `gpt-5.4` because `gpt-5.4-pro` is the
// responses-API-only "pro" tier and rejects v1/chat/completions
// requests with a 404 "not a chat model" error. Switch the
// @model back to `gpt-5.4-pro` when this codebase adds Responses
// API support and routes pro-tier calls there instead.

/// OpenAI GPT-5.4 Pro tier (non-streaming) -- aliases to gpt-5.4 because gpt-5.4-pro is
/// responses-API only; switch the @model back when responses-API support lands. A second name
/// for a model chat54 already offers, so it declares no level and no selector chooses it.
@extends("openai")
@model("gpt-5.4")
provider chat54Pro {
  params {
    streaming                  true
    contextWindow              256000
    maxCompletionTokens        8192
    inputCostPerMillion        5.00
    outputCostPerMillion       20.00
    cachedInputCostPerMillion  2.50
  }
}

// ---- providers/v1/anthropic/claudeHaiku.memql ----

/// Claude Haiku 4.5 - the quick Claude model before Haiku 5.5, still served
@extends("anthropic")
@model("claude-haiku-4-5-20251001")
provider claudeHaiku {
  params {
    streaming                  true
    levels                     "fast"
    rank                       300
    contextWindow              200000
    maxTokens                  4096
    // CORRECTED 2026-11-22 from the vendor's pricing page. Was 0.80 / 4.00 /
    // 0.08, the rates of the model before this one: a fifth understated.
    inputCostPerMillion        1.00
    outputCostPerMillion       5.00
    cachedInputCostPerMillion  0.10
  }
}

// ---- the current Claude models (added 2026-11-22) ----
//
// WHAT THESE THREE RECORDS DO NOT DECLARE, and why. The current models answer
// a 400 to things an older record sends, so a record for one leaves them out:
//
//   - no temperature, topP or topK. Sampling parameters are refused.
//   - no thinkingBudgetTokens. A thinking budget is refused; these models
//     decide how much to think, and thinking is on when nothing is said.
//   - structuredOutput "format". Claude Opus 5.5 and Sonnet 5.5 refuse a
//     forced tool choice, which is how the older records get structured
//     output, so these ask by format (ai_anthropic_structured.go). Haiku 5.5
//     still accepts a forced tool; it asks the same way as its siblings so the
//     three behave alike.
//
// maxTokens is the whole reply, thinking included, so it is larger than the
// older records'. It stays under 21,333: past that the vendor's SDK refuses a
// call that does not stream, and the engine's structured, tool and plain chat
// calls do not (TestNoClaudeRecordDeclaresAnOutputLimitTheSdkRefusesWithoutStreaming).

/// Claude Opus 5.5 - Anthropic's strongest model open to every account at a standard price
@extends("anthropic")
@model("claude-opus-5-5")
provider claudeOpus55 {
  params {
    streaming                  true
    levels                     "strong reasoning"
    rank                       900
    structuredOutput           "format"
    contextWindow              1000000
    maxTokens                  20000
    inputCostPerMillion        4.00
    outputCostPerMillion       20.00
    cachedInputCostPerMillion  0.20
  }
}

/// Claude Sonnet 5.5 - the middle Claude model, for everyday strong work
@extends("anthropic")
@model("claude-sonnet-5-5")
provider claudeSonnet55 {
  params {
    streaming                  true
    levels                     "strong"
    rank                       700
    structuredOutput           "format"
    contextWindow              1000000
    maxTokens                  16384
    inputCostPerMillion        2.00
    outputCostPerMillion       10.00
    cachedInputCostPerMillion  0.10
  }
}

/// Claude Haiku 5.5 - the quick, low-cost Claude model
@extends("anthropic")
@model("claude-haiku-5-5")
provider claudeHaiku55 {
  params {
    streaming                  true
    levels                     "fast"
    rank                       380
    structuredOutput           "format"
    // The model's window is 1,000,000. The vendor charges these rates for a
    // prompt of up to 100,000 tokens and five times as much above it (0.50 /
    // 2.50 / 0.05), so the record is offered prompts the price is true for.
    contextWindow              100000
    maxTokens                  16384
    inputCostPerMillion        0.10
    outputCostPerMillion       0.50
    cachedInputCostPerMillion  0.01
  }
}

