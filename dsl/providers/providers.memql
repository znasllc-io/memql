// ---- providers/v1/openai/streamReasoning4Mini.memql ----

@extends("openai")
@type("OpenAIStream")
@model("o4-mini")
@description("OpenAI o4-mini - efficient reasoning-focused model (o-series); streaming")
provider streamReasoning4Mini {
  params {
    contextWindow        200000
    maxCompletionTokens  16384
  }
}

// ---- providers/v1/openai/transcribeDiarize.memql ----

@extends("openai")
@type("OpenAISTT")
@model("gpt-4o-transcribe-diarize")
@modality("stt")
@description("OpenAI gpt-4o-transcribe-diarize - speech-to-text with speaker diarization. Use for multi-speaker recordings where speaker attribution matters. Placeholder type until diarization-aware client lands.")
provider transcribeDiarize {
  params {
    format     "wav"
    sampleRate 16000
  }
}

// ---- providers/v1/openai/tts1Hd.memql ----

@extends("openai")
@type("OpenAITTS")
@model("tts-1-hd")
@modality("tts")
@description("OpenAI tts-1-hd - classic high-definition text-to-speech; reliable fallback when gpt-4o-mini-tts is unavailable")
provider tts1Hd {
  params {
    voice  "nova"
    format "wav"
    speed  1.0
  }
}

// ---- providers/v1/openai/tts4oMini.memql ----

@extends("openai")
@type("OpenAITTS")
@model("gpt-4o-mini-tts")
@modality("tts")
@description("OpenAI gpt-4o-mini-tts - newest natural-sounding text-to-speech model")
provider tts4oMini {
  params {
    voice  "alloy"
    format "wav"
    speed  1.0
  }
}

// ---- providers/v1/openai/whisper1.memql ----

@extends("openai")
@type("OpenAISTT")
@model("whisper-1")
@modality("stt")
@description("OpenAI whisper-1 - verbatim speech-to-text; the memQL default STT model (see integrations/stt/openai_whisper.go and MEMQL_WHISPER_MODEL)")
provider whisper1 {
  params {
    format    "wav"
    sampleRate 16000
  }
}

@base
@type("xAI")
provider xai {
  auth {
    apiKey   env("MEMQL_SI_XAI_API_KEY")
    baseURL  "https://api.x.ai/v1"
  }
}
