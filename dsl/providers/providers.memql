// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

@base
@vendor("Anthropic")
provider anthropic {
  auth {
    // Workload identity federation is the ONLY door (memql#4333, and the key
    // arm removed by memql#5088). The engine presents its Kubernetes
    // service-account token instead of holding a key: all four of rule /
    // organization / service account / token file set means federate, NONE
    // means the Anthropic providers register as unavailable, and one to three
    // refuses boot. There is no apiKey entry here and there is no key
    // anywhere else either -- TestNoVendorApiKeyEntryPoint fails the build on
    // one coming back.
    //
    // Every one of these is OPTIONAL at resolution -- unlike a normal auth
    // placeholder, an unset federation id leaves the field empty and
    // anthropicCredential decides what that means (see optionalAuthEnvNames
    // in ai_anthropic_federation.go).
    // Runbook: docs/public/operate/auth/anthropic-federation.md.
    federationRuleId   env("MEMQL_AI_ANTHROPIC_FEDERATION_RULE_ID")
    organizationId     env("MEMQL_AI_ANTHROPIC_ORGANIZATION_ID")
    serviceAccountId   env("MEMQL_AI_ANTHROPIC_SERVICE_ACCOUNT_ID")
    workspaceId        env("MEMQL_AI_ANTHROPIC_WORKSPACE_ID")
    identityTokenFile  env("MEMQL_AI_ANTHROPIC_IDENTITY_TOKEN_FILE")
  }
}

// THE VENDOR TEXT RECORDS (refreshed 2026-11-22, design record
// docs/superpowers/specs/2026-11-21-vendor-accounts-and-api-keys-design.md, R1
// to R3). Every model id, price, window and shutdown date below was read from
// the vendor's own pages on that day: Anthropic's models overview and pricing,
// OpenAI's models, pricing and deprecations. Nothing was run against either
// vendor. A refresh re-reads those pages; it does not edit from memory.
//
// WHAT A RECORD DECLARES, and what reads it:
//
//   levels  the jobs it is for: fast, strong, reasoning. `federation:strongest`
//           and `federation:cheapest` choose only among the records that
//           declare the call's level. A record that declares none still
//           resolves by name and is passed over by both selectors.
//   rank    its place among the records of a level, 1 to 1000, higher first.
//           Within a vendor: the newer generation first, then the vendor's own
//           order of its tiers. Across vendors: models of one tier sit
//           together and the cheaper is first. That is an ORDER, not a claim
//           that one vendor's model is better; an owner who disagrees changes
//           these numbers. The API route's page offers the two selectors and
//           no single record, so the order is decided here.
//   prices  per million tokens, the vendor's standard rate.
//   contextWindow
//           the largest prompt the record is offered. Where a vendor charges
//           more past a prompt size (OpenAI past 272,000 tokens, Claude Haiku
//           5.5 past 100,000), the record declares THAT size, not the model's
//           whole window: a record states one price, and a prompt the price is
//           not true for goes to the next record whose window holds it. The
//           cost of the rule is that such a model is passed over for a prompt
//           it could have held.
//
// A NAME IS NEVER REMOVED. Product bundles pin record names, so a record whose
// vendor shut its model down is repointed to the replacement the vendor names
// and keeps resolving. Such a record declares no level: the replacement has a
// record of its own, and a selector offered one model under two names would
// retry a failing model.
//
// NOT HERE, on purpose:
//   - Claude Fable 5.2. It costs twice Claude Opus 5.5, and the top record of
//     a level is the model a call gets with nobody having chosen it. (A
//     request a Claude model declines is handled alike for every record here:
//     it is a failure and the route's next source serves,
//     component/memql/ai_anthropic_declined.go. The vendor's own server-side
//     fallback is a beta surface this engine does not call, for any of them.)
//   - OpenAI's GPT-6 family. On Chat Completions, the one OpenAI API this
//     engine speaks, those models take no function calls, and an agent's turn
//     is function calls.
//
// MEMQL_AI_OPENAI_PROJECT_ID is intentionally NOT listed here because
// env() placeholders fail registration when the variable is unset,
// and service-account keys (sk-svcacct-*) do not carry a project id.
// Provider clients read MEMQL_AI_OPENAI_PROJECT_ID directly via
// os.Getenv and attach the OpenAI-Project header only when present.

// ---- providers/v1/openai/chat53Latest.memql ----

/// A name kept for bundles that pin it. OpenAI shut its model, gpt-5.3-chat-latest, down on
/// 2026-08-10 and names gpt-5.6-sol as the replacement, which this name now calls. It declares
/// no level: chat56Sol is the record the selectors choose for this model.
@extends("openai")
@model("gpt-5.6-sol")
provider chat53Latest {
  params {
    streaming                  true
    contextWindow              272000
    maxCompletionTokens        16384
    inputCostPerMillion        5.00
    outputCostPerMillion       30.00
    cachedInputCostPerMillion  0.50
  }
}

// ---- the GPT-5.6 family and GPT-5.5 (added 2026-11-22) ----

/// OpenAI GPT-5.6 Sol - OpenAI's strongest model this engine can drive (Chat Completions with
/// function calls)
@extends("openai")
@model("gpt-5.6-sol")
provider chat56Sol {
  params {
    streaming                  true
    levels                     "strong reasoning"
    rank                       880
    contextWindow              272000
    maxCompletionTokens        16384
    // The vendor's REGULAR rate. Until 2026-11-30 its page lists a launch
    // price of 4.00 / 20.00 / 0.40 and says that is 20% off input and 33% off
    // output; the regular numbers here are worked out from those two
    // percentages, not read off the page. Declaring the regular rate
    // overstates a call's cost for the last days of the offer, which is the
    // safe direction, and is right from the day after.
    inputCostPerMillion        5.00
    outputCostPerMillion       30.00
    cachedInputCostPerMillion  0.50
  }
}

/// OpenAI GPT-5.6 Terra - the middle of the GPT-5.6 family, for everyday strong work
