// ---- providers/v1/openai/stream54Pro.memql ----

// stream54Pro - "Pro tier" streaming OpenAI chat
// =================================================
//
// Routed-to as a fallback in the `strongReasoning` policy chain
// (streamClaudeSonnet -> stream54Pro). Concept:
// "if the primary Claude is out, use the strongest OpenAI chat
// model the v1/chat/completions endpoint accepts."
//
// IMPORTANT: this provider ALIASES to the `gpt-5.4` flagship chat
// model -- NOT to `gpt-5.4-pro`. OpenAI hosts `gpt-5.4-pro` only
// on the v1/responses endpoint (the new Responses API for the
// reasoning-focused "pro" tier). Sending `gpt-5.4-pro` to the
// streaming chat-completions endpoint returns
//
//     404 Not Found -- "This is not a chat model and thus not
//     supported in the v1/chat/completions endpoint. Did you
//     mean to use v1/completions?"
//
// which silently kills the agent's tool-loop fallback when the
// primary (Anthropic) is out of credits / rate-limited / down.
// `gpt-5.4` IS chat-completion-supported, so the chain stays
// working with this aliasing. The "Pro" semantic is preserved in
// the provider name + description; if/when this codebase grows
// Responses API support, swap the @model back to `gpt-5.4-pro`
// AND route the call to the responses endpoint instead of chat
// completions.
//
// Verified the alias by curling the live OpenAI API for both
// names from this project's service-account key on 2026-05-09:
//   gpt-5.4-pro -> 404 "not a chat model"
//   gpt-5.4     -> OK (streams + tools work)

/// OpenAI GPT-5.4 Pro tier (streaming) -- aliases to gpt-5.4 because gpt-5.4-pro is responses-API
/// only; switch the @model back when responses-API support lands
@extends("openai")
@type("OpenAIStream")
@model("gpt-5.4")
provider stream54Pro {
  params {
    contextWindow              256000
    maxCompletionTokens        8192
    inputCostPerMillion        5.00
    outputCostPerMillion       20.00
    cachedInputCostPerMillion  2.50
  }
}

