{
  "_about": "Curated allowlist/denylist for the SI -> AI rename (epic memql#1889).",
  "_modes": "Each rule has a 'mode': 'token' (full identifier boundary both sides, default), 'prefix' (identifier STARTS with old), 'infix' (old appears anywhere -- only long unambiguous AI stems), or 'regex'.",
  "_casing": "Wire/proto family -> title-case 'Ai' (AiChatMsg; matches generated proto + CLAUDE.md target). Pure Go/DSL/frontend identifiers -> all-caps 'AI' (Go initialism idiom + epic spec: AIExpression). Lowercase DSL keyword si()->ai().",
  "_group_order": "go-internal and shared run BEFORE proto so InvokeSIChat -> InvokeAIChat (AI) wins over the proto SIChat -> AiChat (Ai) stem. Within a group, longest 'old' first.",
  "_boundaries": "Matching is identifier-boundaried (or stem-anchored). The denylist + the runtime overlap check keep SIGTERM/SESSION/SIMLI/POSIX/SID/SIP* untouched: a rule that would alter a protected span is refused.",
  "_excluded_from_scope": [
    "Env var names MEMQL_SI_* / MEMQL_COGNITION_SI_* / VITE_SIMLI_* / SIMLI_API_KEY and their lowercase config keys (si_openai_api_key, ...) -- secret-store + genesis-envelope contract; deferred follow-up.",
    "Stored data value participantType:\"si\" -- DB row data; identifiers that READ it are renamed, the value string stays \"si\".",
    "SCREAMING telemetry/enum strings (SI_COMPLETION_*, SUBSCRIPTION_KIND_SI_STREAM) -- wire/observability data contracts; reviewed per-issue (1.3/1.4), not auto-renamed here."
  ],

  "groups": {

    "go-grammar": [
      { "old": "SIExpr", "new": "AIExpr", "mode": "infix", "exts": [".go"] },
      { "old": "SIInvocation", "new": "AIInvocation", "mode": "infix", "exts": [".go"] },
      { "old": "SIFunctionCall", "new": "AIFunctionCall", "mode": "infix", "exts": [".go"] }
    ],

    "go-internal": [
      { "old": "InvokeSI", "new": "InvokeAI", "mode": "prefix", "exts": [".go"] },
      { "old": "invokeSI", "new": "invokeAI", "mode": "prefix", "exts": [".go"] },
      { "old": "VarCognitionSIEnabled", "new": "VarCognitionAIEnabled", "mode": "token", "exts": [".go"] },
      { "old": "SIProvider", "new": "AIProvider", "mode": "infix", "exts": [".go"] },
      { "old": "SIToolLoop", "new": "AIToolLoop", "mode": "infix", "exts": [".go"] },
      { "old": "SIResponder", "new": "AIResponder", "mode": "infix", "exts": [".go"] },
      { "old": "SIResponse", "new": "AIResponse", "mode": "infix", "exts": [".go", ".memql"] },
      { "old": "SIPolicies", "new": "AIPolicies", "mode": "infix", "exts": [".go"] },
      { "old": "SIRuntime", "new": "AIRuntime", "mode": "infix", "exts": [".go"] },
      { "old": "SIContext", "new": "AIContext", "mode": "infix", "exts": [".go"] },
      { "old": "SICache", "new": "AICache", "mode": "infix", "exts": [".go"] },
      { "old": "SIUsage", "new": "AIUsage", "mode": "infix", "exts": [".go"] },
      { "old": "SIValue", "new": "AIValue", "mode": "infix", "exts": [".go"] },
      { "old": "SIMeta", "new": "AIMeta", "mode": "infix", "exts": [".go"] },
      { "old": "SIData", "new": "AIData", "mode": "infix", "exts": [".go"] },
      { "old": "SIRespond", "new": "AIRespond", "mode": "infix", "exts": [".go"] },
      { "old": "proxySI", "new": "proxyAI", "mode": "prefix", "exts": [".go"] },
      { "old": "shouldProxySI", "new": "shouldProxyAI", "mode": "token", "exts": [".go"] },
      { "old": "UsesSI", "new": "UsesAI", "mode": "token", "exts": [".go"] },
      { "old": "IsSIEnabled", "new": "IsAIEnabled", "mode": "token", "exts": [".go"] },
      { "old": "routeWithSI", "new": "routeWithAI", "mode": "token", "exts": [".go"] },
      { "old": "collectSI", "new": "collectAI", "mode": "token", "exts": [".go"] }
    ],

    "shared": [
      { "old": "SIParticipant", "new": "AIParticipant", "mode": "infix", "exts": [".go", ".ts", ".tsx", ".memql"] },
      { "old": "AutoJoinSI", "new": "AutoJoinAI", "mode": "infix", "exts": [".go", ".ts", ".tsx", ".memql"] },
      { "old": "autoJoinSI", "new": "autoJoinAI", "mode": "infix", "exts": [".go", ".ts", ".tsx", ".memql"] },
      { "old": "JoinSpaceAsSI", "new": "JoinSpaceAsAI", "mode": "infix", "exts": [".go", ".ts", ".tsx", ".memql"] },
      { "old": "greetOnJoinSI", "new": "greetOnJoinAI", "mode": "token", "exts": [".go", ".memql"] }
    ],

    "proto": [
      { "old": "SIForward", "new": "AiForward", "mode": "infix", "exts": [".go", ".proto", ".ts", ".tsx"] },
      { "old": "SITranscribe", "new": "AiTranscribe", "mode": "infix", "exts": [".go", ".proto", ".ts", ".tsx"] },
      { "old": "SISpeech", "new": "AiSpeech", "mode": "infix", "exts": [".go", ".proto", ".ts", ".tsx"] },
      { "old": "SISuggest", "new": "AiSuggest", "mode": "infix", "exts": [".go", ".proto", ".ts", ".tsx"] },
      { "old": "SIStream", "new": "AiStream", "mode": "infix", "exts": [".go", ".proto", ".ts", ".tsx"] },
      { "old": "SIChat", "new": "AiChat", "mode": "infix", "exts": [".go", ".proto", ".ts", ".tsx"] },
      { "old": "SIChunk", "new": "AiChunk", "mode": "infix", "exts": [".go", ".proto", ".ts", ".tsx"] },

      { "old": "si_chat_result", "new": "ai_chat_result", "mode": "token", "exts": [".proto"] },
      { "old": "si_chat", "new": "ai_chat", "mode": "token", "exts": [".proto"] },
      { "old": "si_chunk", "new": "ai_chunk", "mode": "token", "exts": [".proto"] },
      { "old": "si_speech_result", "new": "ai_speech_result", "mode": "token", "exts": [".proto"] },
      { "old": "si_speech", "new": "ai_speech", "mode": "token", "exts": [".proto"] },
      { "old": "si_transcribe_stream_chunk", "new": "ai_transcribe_stream_chunk", "mode": "token", "exts": [".proto"] },
      { "old": "si_transcribe_stream_complete", "new": "ai_transcribe_stream_complete", "mode": "token", "exts": [".proto"] },
      { "old": "si_transcribe_stream_delta", "new": "ai_transcribe_stream_delta", "mode": "token", "exts": [".proto"] },
      { "old": "si_transcribe_stream_end", "new": "ai_transcribe_stream_end", "mode": "token", "exts": [".proto"] },
      { "old": "si_transcribe_stream_start", "new": "ai_transcribe_stream_start", "mode": "token", "exts": [".proto"] },
      { "old": "si_transcribe_result", "new": "ai_transcribe_result", "mode": "token", "exts": [".proto"] },
      { "old": "si_transcribe", "new": "ai_transcribe", "mode": "token", "exts": [".proto"] },
      { "old": "si_suggest_result", "new": "ai_suggest_result", "mode": "token", "exts": [".proto"] },
      { "old": "si_suggest", "new": "ai_suggest", "mode": "token", "exts": [".proto"] },
      { "old": "si_forward_cancel", "new": "ai_forward_cancel", "mode": "token", "exts": [".proto"] },
      { "old": "si_forward_request", "new": "ai_forward_request", "mode": "token", "exts": [".proto"] },
      { "old": "si_forward_response", "new": "ai_forward_response", "mode": "token", "exts": [".proto"] }
    ],

    "dsl-keyword": [
      { "old": "si\\(", "new": "ai(", "mode": "regex", "exts": [".memql"],
        "_note": "The si(\"promptName\", args) construct keyword. Scoped to .memql only." }
    ],

    "go-keyword-literals": [
      { "old": "si\\(", "new": "ai(", "mode": "regex", "exts": [".go"],
        "_note": "Hardcoded `si(` string literals in Go that PARSE/SERIALIZE the keyword (shape.go funcCall[:3]==\"si(\", canonical.go, shape_template.go WriteString) + the si()-keyword error messages/comments. The participant data value \"si\" has no paren and is untouched (deferred #1918)." }
    ],

    "dsl-identifiers": [
      { "old": "queryHasSIResponseForReply", "new": "queryHasAIResponseForReply", "mode": "token", "exts": [".memql"] },
      { "old": "mutationJoinSpaceAsSI", "new": "mutationJoinSpaceAsAI", "mode": "token", "exts": [".memql"] }
    ],

    "frontend": [
      { "old": "SITyping", "new": "AITyping", "mode": "infix", "exts": [".ts", ".tsx"] },
      { "old": "SIMessage", "new": "AIMessage", "mode": "infix", "exts": [".ts", ".tsx"] },
      { "old": "SIVideo", "new": "AIVideo", "mode": "infix", "exts": [".ts", ".tsx"] },
      { "old": "SIAgent", "new": "AIAgent", "mode": "infix", "exts": [".ts", ".tsx"] },
      { "old": "SI_PARTICIPANT_ID", "new": "AI_PARTICIPANT_ID", "mode": "token", "exts": [".ts", ".tsx"] },
      { "old": "startWaitingForSI", "new": "startWaitingForAI", "mode": "token", "exts": [".ts", ".tsx"] },
      { "old": "joinSIArgs", "new": "joinAIArgs", "mode": "token", "exts": [".ts", ".tsx"] },
      { "old": "joinAsSI", "new": "joinAsAI", "mode": "token", "exts": [".ts", ".tsx"] },
      { "old": "isSI", "new": "isAI", "mode": "token", "exts": [".ts", ".tsx"] }
    ]
  },

  "denylist": [
    "SIP(?![a-z])[A-Za-z0-9_]*",
    "TSInterface[A-Za-z0-9_]*",
    "TSImport[A-Za-z0-9_]*",
    "CSS[A-Za-z0-9_]*",
    "CJS[A-Za-z0-9_]*",
    "[A-Za-z0-9_]*CSSItems",
    "POSIX", "OSI", "CSI",
    "VERSION", "MEMQL_VERSION", "MIN_IOS_VERSION",
    "MISSING", "INSIDE", "OUTSIDE", "ANALYSIS", "DECISIONS", "SILENTLY",
    "PERSISTS", "PERSIST", "EPSILON", "UNSIGNALED", "SID",
    "SIGTERM", "SIGINT", "SIGHUP", "SIGKILL", "SIGQUIT", "SIGNAL", "RAISE_HAND_SIGNAL_TEXT",
    "SINGLE", "EXTENSION", "IMAGE_EXTENSIONS", "CSV_EXTENSIONS",
