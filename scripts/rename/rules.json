    "[A-Za-z0-9_]*SIZE[A-Za-z0-9_]*",
    "[A-Za-z0-9_]*SIMILAR[A-Za-z0-9_]*",
    "[A-Za-z0-9_]*TRANSITION[A-Za-z0-9_]*",
    "[A-Za-z0-9_]*PROGRESSIVE[A-Za-z0-9_]*",
    "[A-Za-z0-9_]*SILENCE[A-Za-z0-9_]*",
    "AutoTTSIndicator", "PROGRESSIVE_ID",
    "__VAP_SESSION__"
  ],

  "_scan_only": "denylist_substrings suppress G1-scan noise: any token CONTAINING one of these uppercase English roots is not an AI identifier. Scan-only -- never used by the rename pass (no allowlisted AI token contains any of these).",
  "denylist_substrings": [
    "VERSION", "SESSION", "SIZE", "SIGNAL", "SILENC", "SILENT",
    "TRANSITION", "TRANSIENT", "CLASSIFI", "DECISION", "SINGLE", "INSIDE",
    "OUTSIDE", "MISSING", "EXTENSION", "POSIX", "PERSIST", "SIGNING",
    "SIGNATURE", "SIG", "PROGRESSIV", "ANALYSIS", "ASSISTANT", "SIMILAR",
    "GENESIS", "SIMLI", "IDENTICAL", "EPSILON", "UNSIGNALED", "PROVISION",
    "REVISION", "PRECISION", "EMISSION", "OMISSION", "ADMISSION",
    "DIMENSION", "EXPRESSION", "IMPRESSION", "SUPERVISION", "DIVISION",
    "COLLISION", "DERISION", "ANSI", "SITE", "SINK", "VISIBLE", "SIBLING",
    "SIDE", "SIX", "BASIC", "CLOSING", "COMPOSITION", "CONSISTEN",
    "PERMISSION", "DESIGN", "EXCLUSI", "EXPANSION", "INCLUSI", "INCONCLUSI",
