{
  "name": "install-main",
  "kind": "install",
  "description": "Set up a local MemQL cluster built from the latest source on this machine, instead of from a published release.",
  "steps": [
    {
      "id": "detect",
      "script": "install.detect",
      "description": "Checking this machine can run a cluster: a supported system, Docker running, the ports free, and enough disk space.",
      "readOnly": true,
      "elevation": "none",
      "verify": {
        "kind": "resultTrue",
        "field": "result.supported"
      }
    },
    {
      "id": "dockerAccess",
      "script": "install.dockerAccess",
      "description": "Checking that Docker can run containers for you, before anything is installed.",
      "readOnly": true,
      "dependsOn": [
        "detect"
      ],
      "elevation": "none",
      "verify": {
        "kind": "resultTrue",
        "field": "result.ready"
      }
    },
    {
      "id": "toolK3d",
      "script": "install.binary",
      "description": "Installing k3d, which runs the cluster, and checking the download is the expected one.",
      "params": {
        "tool": "k3d"
      },
      "dependsOn": [
        "detect",
        "providerKey",
        "dockerAccess"
      ],
      "elevation": "none",
      "receipt": "binary",
      "preExistingPath": "result.preExisting",
      "verify": {
        "kind": "resultTrue",
        "field": "result.installed"
      }
    },
    {
      "id": "toolKubectl",
      "script": "install.binary",
      "description": "Installing kubectl, which talks to the cluster, and checking the download is the expected one.",
      "params": {
        "tool": "kubectl"
      },
      "dependsOn": [
        "detect",
        "providerKey",
        "dockerAccess"
      ],
      "elevation": "none",
      "receipt": "binary",
      "preExistingPath": "result.preExisting",
      "verify": {
        "kind": "resultTrue",
        "field": "result.installed"
      }
    },
    {
      "id": "toolMkcert",
      "script": "install.binary",
      "description": "Installing mkcert, which issues this machine's local certificates, and checking the download is the expected one.",
      "params": {
        "tool": "mkcert"
      },
      "dependsOn": [
        "detect",
        "providerKey",
        "dockerAccess"
      ],
      "elevation": "none",
      "receipt": "binary",
      "preExistingPath": "result.preExisting",
      "verify": {
        "kind": "resultTrue",
        "field": "result.installed"
      }
    },
    {
      "id": "hostsBlock",
      "script": "install.hostsEntries",
      "description": "Pointing the cluster's web addresses at this machine, inside a marked section of the system hosts file.",
      "params": {
        "action": "add",
        "confirm": "add-memql-hosts"
      },
      "dependsOn": [
        "detect",
        "providerKey",
        "dockerAccess"
      ],
      "elevation": "sudo",
      "receipt": "hostsEntries",
      "preExistingPath": "none",
      "verify": {
        "kind": "resultTrue",
        "field": "result.blockPresent"
      }
    },
    {
      "id": "browserTrust",
      "script": "install.nssTools",
      "description": "Setting up the tools your browsers need to trust this machine's local certificates.",
      "params": {
        "confirm": "install-nss-tools"
      },
      "dependsOn": [
        "detect",
        "providerKey",
        "dockerAccess"
      ],
      "elevation": "sudo",
      "retained": true,
      "retainedReason": "certutil is a general system tool other software uses. MemQL installs it because without it Firefox and Chrome cannot trust the local CA and the front door is unreachable in a browser -- but an application uninstaller that removes distribution packages is how installers earn their reputation, so this one is never taken back.",
      "verify": {
        "kind": "resultTrue",
        "field": "result.installed"
      }
    },
    {
      "id": "localCA",
      "script": "install.mkcert",
      "description": "Issuing the certificate that lets this cluster answer over https.",
      "params": {
        "confirm": "install-memql-ca"
      },
      "dependsOn": [
        "toolMkcert",
        "browserTrust"
      ],
      "elevation": "user-trust",
      "receipt": "mkcertCA",
      "preExistingPath": "result.caPreExisting",
      "verify": {
        "kind": "resultTrue",
        "field": "result.caTrusted"
      }
    },
    {
      "id": "stackCheckout",
      "script": "install.cloneStack",
      "description": "Downloading the MemQL release you chose.",
      "dependsOn": [
        "detect",
        "providerKey",
        "dockerAccess"
      ],
      "elevation": "none",
      "receipt": "checkout",
      "preExistingPath": "!result.cloned",
      "verify": {
        "kind": "resultNonEmpty",
        "field": "result.commit"
      }
    },
    {
      "id": "providerKey",
      "script": "install.verifyProviderKey",
      "description": "Checking that your AI provider key is accepted, before the cluster is built around it. Skipped when you supplied none: installing spends no AI credit, and providers are set up afterwards in the portal.",
      "dependsOn": [
        "detect"
      ],
      "readOnly": true,
      "elevation": "none",
      "verify": {
        "kind": "resultTrue",
        "field": "result.valid"
      }
    },
    {
      "id": "clusterUp",
      "script": "k3d.up",
      "timeoutSeconds": 1800,
      "description": "Creating the cluster and preparing it for the MemQL images that are about to be built here.",
      "dependsOn": [
        "toolK3d",
        "toolKubectl",
        "hostsBlock",
        "localCA",
        "stackCheckout",
        "providerKey",
        "dockerAccess"
      ],
      "elevation": "none",
      "receipt": "stack",
      "preExistingPath": "!result.clusterCreated",
      "verify": {
        "kind": "resultTrue",
        "field": "result.argocdReady"
      }
    },
    {
      "id": "buildImages",
      "script": "k3d.dev",
      "timeoutSeconds": 2700,
      "description": "Building MemQL from the source just downloaded and starting the cluster on it.",
      "params": {
        "image-source": "checkout"
      },
      "dependsOn": [
        "clusterUp"
      ],
      "elevation": "none",
      "containedBy": "clusterUp",
      "verify": {
        "kind": "resultEquals",
        "field": "result.imageSource",
        "value": "checkout"
      }
    },
    {
      "id": "seedBootstrap",
      "script": "install.seedBootstrap",
      "description": "Creating your owner account and applying the settings you gave, then restarting the services that read them.",
      "dependsOn": [
        "clusterUp",
        "buildImages"
      ],
      "elevation": "none",
      "containedBy": "clusterUp",
      "verify": {
        "kind": "resultTrue",
        "field": "result.bootstrapComplete"
      }
    },
    {
      "id": "frontDoor",
      "script": "install.verifyFrontDoor",
      "description": "Checking the cluster answers over https at every one of its addresses.",
      "dependsOn": [
        "seedBootstrap"
      ],
      "readOnly": true,
      "elevation": "none",
      "verify": {
        "kind": "resultTrue",
        "field": "result.allPassed"
      }
    },
    {
      "id": "magicLink",
      "script": "install.magicLink",
      "description": "Looking for a sign-in link for the owner account, as a second way in. A cluster that has not been asked for one carries none, which is reported rather than treated as a failure.",
      "params": {
        "local": "1"
      },
      "dependsOn": [
        "frontDoor"
      ],
      "readOnly": true,
      "elevation": "none",
      "verify": {
        "kind": "resultNonEmpty",
        "field": "result.linkState"
      }
    },
    {
      "id": "enrolmentLink",
      "script": "install.enrolmentLink",
      "description": "Creating a single-use link for setting up a passkey on the owner account. A cluster nobody has signed into yet has no account -- the first sign-in creates it -- and that is reported instead.",
      "params": {
        "local": "1"
      },
      "dependsOn": [
        "frontDoor"
      ],
      "elevation": "none",
      "containedBy": "clusterUp",
      "verify": {
        "kind": "resultNonEmpty",
        "field": "result.enrolmentState"
      }
    },
    {
      "id": "recoveryKey",
      "script": "install.recoveryKey",
      "description": "Claiming this cluster's recovery key and showing it once, so you finish with a way back in if every other is ever lost. A cluster nobody has signed into yet has no owner and no key; a key an earlier run already claimed is left alone, because only its fingerprint was kept and re-showing it is impossible.",
      "params": {
        "local": "1"
      },
      "dependsOn": [
        "enrolmentLink"
      ],
      "elevation": "none",
      "containedBy": "clusterUp",
      "verify": {
        "kind": "resultNonEmpty",
        "field": "result.recoveryKeyState"
      }
    }
  ]
}
