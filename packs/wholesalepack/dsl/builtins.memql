// wholesale pack builtins -- Go-backed writes and the derived state (epic
// memql#5533, issues memql#5555, memql#5556 and memql#5557).
//
// EVERY ONE OF THESE IS HERE BECAUSE IT NEEDS A CROSS-ROW READ, and that is
// the only reason any of them is Go. A mutation body cannot read another
// concept's rows, and each of these has to:
//
//   - submitting reads the store's applicationsOpen before it accepts;
//   - deciding reads the application for its storeId AND folds the decision
//     log to check the transition is legal;
//   - the state read IS that fold;
//   - provisioning reads the application, the state, the settings and the
//     store's plan before it calls an adapter.
//
// The pack ships NO automations and NO logic, which is the storefront-pack
// convention reviewspack keeps and is what lets a client lay its own
// process over these. A client triggers on the CONCEPTS these write.

@executor("integration.wholesale.submitApplication")
@args(profile="object")
@description("THE SHOPPER WRITE PATH: a business applies for trade terms on one store. Refused when that store's applicationsOpen is false, and ABSENT SETTINGS ARE CLOSED -- a merchant who has never touched their wholesale settings has not asked the internet for their customers' business details. It derives the row id, because the caller is a member of the public posting a plain HTML form and a shopper who could choose a row id could overwrite another applicant's. storeId and siteId arrive STAMPED from the binding the post arrived through, never submitted.")
builtin wholesaleSubmitApplication {
  storeId         string!  @description("Stamped server-side from the binding in effect -- the serving binding, or the PREVIEW binding when the submission was made while exercising a candidate version.")
  companyName     string!  @description("The business applying.")
  applicantName   string!  @description("The person applying. Data, never an identity.")
  applicantEmail  string!  @description("Unverified. How a decision reaches them, and how an adapter finds the Shopify customer to entitle.")
  siteId          string  @description("The deployable the post arrived on. Provenance; the row is scoped by storeId.")
  accountId       string  @description("Stamped server-side from the organization of the site the post arrived on, and refused unless it is that site's. Empty for a site with no organization.")
}

@executor("integration.wholesale.recordDecision")
@args(profile="object")
@description("Append one decision to an application's log. A PERSON ON THE STORE'S SIDE DECIDES: the caller holds the wholesale part in the application's organization (the organization gate judges it), is signed in, and is not one of the cluster's operators, who read every store's applications and decide none. The decider recorded is always the caller; principalKind and decidedBy are accepted for old callers and ignored. storeId, the merchant and the organization are read off the application being decided rather than supplied, so a decision can never be scoped to a store its subject is not on -- and the read runs under the CALLER'S own actor, so a caller who cannot read an application cannot decide it. The transition is checked against the FOLDED LOG rather than against an argument: approve and reject are legal from submitted, revoke only from approved, and nothing leads out of rejected or revoked because re-deciding in place would overwrite why the first decision was made.")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleRecordDecision {
  applicationId  string!  @description("The application being decided. The organization gate judges the call against its organization.")
  transition     string!  @description("approve, reject or revoke.")
  principalKind  string  @description("Ignored. The decider is the caller, and the cluster's operators are refused.")
  decidedBy      string  @description("Ignored. The decider recorded is always the caller, because a decider named by an argument on an append-only log would attribute somebody else's decision to them for ever.")
  note           string  @description("The reason. Append-only storage is only worth having if this survives the next decision.")
}

@executor("integration.wholesale.applicationState")
@args(profile="object")
@description("The DERIVED state of one application -- submitted, approved, rejected or revoked -- folded from its append-only decision log, plus what is legal next. There is no stored state field to read instead: an application whose state was overwritten would lose why it was refused the moment somebody approved it.")
builtin wholesaleApplicationState {
  applicationId  string!  @description("The application to fold.")
}

@executor("integration.wholesale.retryAccess")
@args(profile="object")
@description("Try a buyer's access again after it did not land: an APPROVED application is provisioned again through the store's route, and a REVOKED one whose access is still on (its entitlement row is not revoked) is revoked again through the route that granted it. Anything else is refused by name. The caller holds the wholesale part in the application's organization (the organization gate judges it) and reads the application under their own actor; the attempt then runs as provisioning does -- read as the deployment, the route called and the entitlement written as the application's merchant -- and a failed attempt is recorded on the row rather than returned, so a granted row is never lost to a retry that could not reach a route.")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleRetryAccess {
  applicationId  string!  @description("The application whose access to try again. The organization gate judges the call against its organization.")
}

@executor("integration.wholesale.storeSettings")
@args(profile="object")
@description("One store's wholesale settings as the Deployables app shows them: whether the store is set up, whether applications are open, the route (entitlementAdapter, empty for none), the intro text and the staff address, the routes this engine has, and what the caller may do -- may.setUp is true only for a cluster operator on a store with no settings row, may.update for a person holding the wholesale part or a cluster operator on a store that has one. The caller holds the part in the site's organization (the organization gate judges it), and the site must serve the store.")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleStoreSettings {
  siteId   string!  @description("The store's site: the organization gate judges the read against its organization, and the store must be bound to it.")
  storeId  string!  @description("The store whose settings to read.")
}

@executor("integration.wholesale.updateSettings")
@args(profile="object")
@description("Change a store's wholesale settings once the cluster's operators have set it up: a store with no settings row is refused (\"This store's wholesale program is not set up yet. The cluster's operators set it up.\"). The change MERGES into the row: a field not named keeps its value, and the row's owner, organization and site stay its own. An unknown route is refused by name; an empty route and none both mean none. The staff address is one address (at most 320 characters with exactly one @) or empty. The caller holds the wholesale part in the site's organization, or is a cluster operator holding it (the organization gate judges it), and the site must serve the store.")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleUpdateSettings {
  siteId              string!  @description("The store's site: the organization gate judges the change against its organization, and the store must be bound to it.")
  storeId             string!  @description("The store whose settings change.")
  applicationsOpen    bool  @description("Whether the shopper form accepts posts for this store.")
  entitlementAdapter  string  @description("The route: shopifyB2B or customerTag as this pack ships. Empty or none means none.")
  introText           string  @description("Client-authored copy the storefront shows above its form.")
  staffEmail          string  @description("The address the store's people are told at, or empty for none.")
}

@executor("integration.wholesale.setWholesaleSettings")
@args(profile="object")
@description("Write one store's wholesale settings -- SETTING A STORE UP. THE CLUSTER'S OPERATORS (or trusted server code) ONLY, never the wholesale part: every other caller, the store's own merchant and its people included, is refused before anything is read; once a store is set up its people change it through wholesaleUpdateSettings. An existing row keeps its owner. With a siteId the row is THAT site's -- the site must serve the store, and a new row takes its owner, and every write its organization and id; without one a new row is owned by the one owner of the deployables bound to the store, and is refused when that owner cannot be told. DATA, NOT SOURCE -- a client opens or closes applications, changes what the storefront says and switches entitlement adapter without a deploy or a .memql edit. One row per store at a derived id, so a merchant can take applications on their live store while they are closed on the development store a candidate is being exercised against. An UNKNOWN adapter name is refused HERE rather than at approval time, so a merchant who typed it wrong learns now.")
builtin wholesaleSetSettings {
  storeId             string!  @description("The store these settings govern.")
  siteId              string  @description("The store's site the settings are made for. It must serve the store; the row takes its organization and id, and a new row its owner.")
  applicationsOpen    bool!  @description("Whether the shopper form accepts posts for this store.")
  entitlementAdapter  string  @description("shopifyB2B or customerTag as this pack ships. Empty means none configured, and provisioning then refuses by name rather than silently doing nothing.")
  introText           string  @description("Client-authored copy the storefront shows above its form. The only presentation this pack carries.")
}

@executor("integration.wholesale.provisionEntitlement")
@args(profile="object")
@description("Grant wholesale prices through this store's chosen adapter. CALLED BY THE STORE'S AUTOMATION, on an approve decision: it refuses any call without internal origin before it reads anything, reads as the deployment (the automation's own actor owns nothing), and grants and records the entitlement as the application's merchant. Only an APPROVED application has an entitlement to provision, and the decision log decides that rather than an argument. A FAILED PUSH LEAVES THE APPLICATION APPROVED and writes the entitlement `pending` carrying the error -- an approval is a decision somebody made, and a push that failed is not a reason to undo it. An adapter REFUSAL (a plan ceiling, a buyer with no customer account) writes `failed` instead, because it will fail identically for ever and retrying it is how a queue stops draining.")
builtin wholesaleProvisionEntitlement {
  applicationId  string!  @description("The approved application to provision against.")
}

@executor("integration.wholesale.revokeEntitlement")
@args(profile="object")
@description("Take an entitlement back. CALLED BY THE STORE'S AUTOMATION: it refuses any call without internal origin before it reads anything, reads as the deployment, and takes the entitlement back and records it as the application's merchant -- through the adapter that GRANTED it rather than whatever the settings name today -- a merchant who switches adapters must still be able to undo what the old one gave. Requires a revoke decision to have been recorded first, so the pack's state and its history agree.")
builtin wholesaleRevokeEntitlement {
  applicationId  string!  @description("The revoked application whose entitlement to take back.")
}

@executor("integration.wholesale.backfillAccounts")
@args(profile="object")
@description("TIE EVERY ROW WRITTEN BEFORE ORGANIZATIONS REACHED THIS PACK to the organization of its site (U5, X19). THE CLUSTER'S OPERATORS (or trusted server code) ONLY, refused before anything is read: its writes run at internal origin, which the row gate does not owner-check. It reads as the system and writes each row as the application's merchant. An application's organization is its siteId site's; with no siteId, the one site whose serving or preview binding is the application's store. It ties the application, then its decisions (naming their merchant, changing no decision field), its entitlement and the store's settings. A row already tied is counted and never rewritten, so it is safe to run again; each write is fenced on the version it read, so a change that lands meanwhile is kept and tied. One row that cannot be tied is reported and the run goes on. A TIE IS A NEW VERSION OF THE ROW: the engine publishes graph.node.created for it with firstVersion false, so a client automation that must run once per row -- a grant on an approve decision, a review opened on an application -- filters on args.firstVersion == true, and a client package carries that filter before this is run. That filter is right for triggers on application and applicationDecision only, whose rows are written once and never again by the pack: an entitlement and a wholesaleSettings are single rows whose later versions are real changes that must fire, so a trigger on either cannot use it, and sees a backfill's tie as an ordinary later version of the row. Answers {tied, alreadyTied, untied: [{id, reason}]}, where a reason is \"no site serves this store\", \"two sites serve this store\" or \"its site has no organization\", \"its site does not serve this store\" or \"it names no merchant\": the operator fixes the site and runs it again.")
builtin wholesaleBackfillAccounts {
  storeId  string  @description("Only this store's rows. Empty: every store's.")
}

@executor("integration.wholesale.list")
@args(profile="object")
@description("The Wholesale section's list: one store's applications as the caller reads them, each with its stage, and every stage's count. stage is waitingForTerms, readyToReview (the default), approved, rejected, revoked or all; readyToReview is oldest first, every other stage newest first. search is a case-insensitive part of the company, the applicant or the email. Each row is {applicationId, companyName, applicantName, applicantEmail, stage, primary, secondary, createdAt}: primary and secondary are the two facts a client's own fields show first (their concept's display card), empty when there are none. A stage is folded from the application's whole decision log, read as the deployment once the caller has been admitted; the applications themselves are read under the caller, so an application they cannot read is not listed and not counted. A store id is matched in every form it is held in (bare or v1:shopify:store:<id>). At most a thousand applications are read per call, the NEWEST thousand: truncated is true when the store has more, and then its OLDEST applications are neither listed nor counted -- which, the queue being oldest first, are the ones that have waited longest. The caller holds the wholesale part in the site's organization, or is a cluster operator (the organization gate judges it), and the site must serve the store.")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleList {
  siteId   string!  @description("The store's site: the organization gate judges the read against its organization, and the store must be bound to it.")
  storeId  string!  @description("The store whose applications to list.")
  stage    string  @description("waitingForTerms, readyToReview (the default), approved, rejected, revoked or all.")
  search   string  @description("A case-insensitive part of the company, the applicant's name or the email.")
  limit    int  @description("Rows per page: 50 when omitted, at most 200.")
  after    string  @description("The cursor the previous page answered as next.")
}

@executor("integration.wholesale.get")
@args(profile="object")
@description("One application as the Wholesale section opens it: the application, its state and stage, the client's own fields (details: shown with its fields; none for an application the store's people added or a store with no client fields; unreadable when the caller cannot read the client's row), every decision newest first with the decider's name, the entitlement (null when there is none), whether the caller is one of the cluster's operators, and the acts open to the caller (reject, approve, remove, retryAccess). The application is read under the caller, so a caller who cannot read it is answered nothing; its decisions and entitlement are then read as the deployment, so the state is judged against the whole log. The caller holds the wholesale part in the application's organization (the organization gate judges it).")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleGet {
  applicationId  string!  @description("The application to open, bare or canonical. The organization gate judges the call against its organization.")
}

@executor("integration.wholesale.decisionLog")
@args(profile="object")
@description("One store's decision log, newest first: {applicationId, companyName, transition, decidedBy, decidedByName, note, createdAt} for each decision on an application the caller reads, read under the caller. search is a case-insensitive part of the company, the applicant, the email, the decider's name or the note. A store id is matched in every form it is held in. One call scans a bounded number of decisions, so a page may carry fewer rows than limit -- or none -- together with a next to go on from; the log ends only when next is empty. The caller holds the wholesale part in the site's organization, or is a cluster operator, and the site must serve the store.")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleDecisionLog {
  siteId   string!  @description("The store's site: the organization gate judges the read against its organization, and the store must be bound to it.")
  storeId  string!  @description("The store whose decisions to list.")
  search   string  @description("A case-insensitive part of the company, the applicant, the email, the decider's name or the note.")
  limit    int  @description("Rows per page: 50 when omitted, at most 200.")
  after    string  @description("The cursor the previous page answered as next.")
}

@executor("integration.wholesale.buyers")
@args(profile="object")
@description("One store's buyers: every application the caller reads whose state is approved, newest first, as {applicationId, companyName, applicantEmail, accessState, errorCode, grantedAt, shopifyCustomerId}. accessState is the entitlement's state, or none when nothing was granted; grantedAt is when a granted entitlement was granted. The state and the entitlement are read as the deployment once the caller has been admitted. A store id is matched in every form it is held in. At most a thousand applications are read per call, the NEWEST thousand: truncated is true when the store has more, and then the buyers among its oldest applications are left out. The caller holds the wholesale part in the site's organization, or is a cluster operator, and the site must serve the store.")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleBuyers {
  siteId   string!  @description("The store's site: the organization gate judges the read against its organization, and the store must be bound to it.")
  storeId  string!  @description("The store whose buyers to list.")
  search   string  @description("A case-insensitive part of the company, the applicant's name or the email.")
  limit    int  @description("Rows per page: 50 when omitted, at most 200.")
  after    string  @description("The cursor the previous page answered as next.")
}

@executor("integration.wholesale.exportStore")
@args(profile="object")
@description("One store's wholesale record as one JSON file, {fileName, json}: every application the caller reads, each with the client's own fields, their decisions and entitlements (read as the deployment once the caller has been admitted), and the store's settings. Every decision and entitlement names its application by the application's own id. It reads EVERYTHING -- every application in every form of the store id, and each one's whole log -- with no cap, so it can be slow for a store with a long history. It never carries a token hash. The file is named wholesale-<store>-<YYYYMMDD>.json. The caller holds the wholesale part in the site's organization, or is a cluster operator, and the site must serve the store.")
@requiresCapability("execute", "app:deployables/wholesale")
builtin wholesaleExportStore {
  siteId   string!  @description("The store's site: the organization gate judges the read against its organization, and the store must be bound to it.")
  storeId  string!  @description("The store whose record to export.")
}
