// wholesale pack -- the writes (epic memql#5533, issues memql#5555,
// memql#5556 and memql#5557).
//
// # Why these exist when every ENTRY POINT is a builtin
//
// A BUILTIN COMPUTES; IT DOES NOT WRITE. component/memql's
// evaluateBuiltinFunctionExpression returns its handler's nodes as the
// expression's VALUE and persists nothing -- so a pack whose writes were
// "the node a builtin returned" would report success, write nothing, and
// answer zero on the very next read. Nothing errors anywhere. The live
// e2e suite is what found that, and no fixture-backed test could have.
//
// So the shape is: THE BUILTIN DECIDES, THE MUTATION WRITES. Each
// capability makes the cross-row reads a mutation body cannot -- is this
// store accepting applications, what store is this application on, what
// does the decision log fold to, is this transition legal -- and then
// calls the matching mutation here through the engine, under the caller's
// own actor (or, from the store's automation, the application's merchant).
//
// # Every one of these is @serverOnly
//
// Each is reached ONLY from the builtin that judges it, through reader.go's
// engineWriter, which stamps internal origin for that one call. A client
// calling one directly would write around the check that makes the write
// legal -- a decision appended past the legality fold, an entitlement
// nobody approved -- so the engine refuses it.
//
// THE STAMP ESCAPES THE ROW GATE: a write at internal origin is not
// owner-checked, so the @rowAuthz tiers below do not protect these rows from
// the builtins. Each builtin authorizes its caller itself before it writes:
//
//   - wholesaleSubmitApplication: the store's applicationsOpen gate, an
//     accountId refused unless it is the named site's, then the id
//     established absent (read as the system) and the write fenced on "row
//     absent", so no application is ever written over;
//   - wholesaleRecordDecision: the wholesale part, judged by the organization
//     gate against the APPLICATION's organization; then a signed-in person
//     who is not one of the cluster's operators (the decider is always the
//     caller); then the application read under the CALLER, so a caller who
//     cannot read it cannot decide it; then the legality fold over the
//     WHOLE log, read as the system (X27);
//   - wholesaleRetryAccess: the part against the application's organization,
//     the application read under the caller, then the decision log and the
//     entitlement row decide whether there is access to retry;
//   - wholesaleUpdateSettings: the part against the SITE's organization, the
//     site checked to serve the store (siteForStore), and a store with no
//     settings row refused -- it merges into the row the operators set up;
//   - wholesaleSetSettings: internal origin or a cluster operator only, never
//     the part. An existing row keeps its owner. A NEW ROW'S OWNER is the
//     named site's owner (checked to serve the store), or else the one owner
//     of the deployables bound to the store; two owners, or none, are refused;
//   - wholesaleProvisionEntitlement / wholesaleRevokeEntitlement: internal
//     origin only (the store's automation), then the decision log.
//   - wholesaleBackfillAccounts: internal origin or a cluster operator
//     only, refusing everyone else before it reads; a row already tied is
//     never rewritten.
//
// # ownerUserId is an ARGUMENT, accepted
//
// Every concept in this pack is @rowAuthz(owner="ownerUserId",
// clusterOwner), so a row's owner is the merchant it belongs to. The Go
// names that merchant -- the borrowed site owner on submission, the
// application's ownerUserId on a decision and an entitlement -- because
// the actor running a write is not always that merchant: provisioning from
// the store's automation reads as the deployment, and a row stamped from a
// system actor is owned by nobody.

use wholesale.concepts.{ application, applicationDecision, entitlement, wholesaleSettings, documentVersion }

/// Write one application. IT NAMES NO ROW ID: on the shopper path the
/// caller is a member of the public, `id` is a name the shopper surface
/// refuses outright, and a shopper who could choose a row id could
/// overwrite another applicant's. The engine derives one.
/// ownerUserId is the site owner whose authority the shopper handler
/// borrowed, which is the calling actor. accountId is the site's
/// organization, stamped by the handler; source says how it arrived.
@serverOnly
@actor
mutation application createApplicationRow {
  args {
    applicationId   string!
    ownerUserId     string!
    storeId         string!
    siteId          string
    companyName     string!  @maxLength(200)
    applicantName   string!  @maxLength(120)
    applicantEmail  string!  @maxLength(320)
    accountId       string
    source          string   @enum("storefront", "staff")
    addedBy         string
  }
  insert {
    accept { ownerUserId, storeId, siteId, companyName, applicantName, applicantEmail, accountId, source, addedBy }
    stamp {
      id: args.applicationId
    }
  }
}

/// Append one decision. ALSO NAMES NO ID, because a decision is a new row
/// every time: append-only is what keeps why an application was refused
/// readable after the next decision, and an id the caller chose would let
/// a second decision overwrite the first.
///
/// decidedBy IS THE ACTOR AND IS NOT AN ARGUMENT. The builtin in front of
/// this takes one -- the issue's own wording, and reviewspack's moderation
/// capability does the same -- but the ROW records who actually called,
/// because a caller-supplied decider on an APPEND-ONLY log is a way to
/// attribute somebody else's approval to them permanently, with no later
/// write able to correct it. When the two disagree the actor wins, which
/// is the only one of them that cannot be forged. ownerUserId is the
/// application's merchant, copied off it by the builtin.
@serverOnly
@actor
mutation applicationDecision appendApplicationDecision {
  args {
    applicationId  string!
    ownerUserId    string
    storeId        string!
    transition     string!  @enum("approve", "reject", "revoke")
    note           string   @maxLength(2000)
    accountId      string
  }
  insert {
    accept { applicationId, ownerUserId, storeId, transition, note, accountId }
    stamp {
      decidedBy: actor.userId
      principalKind: "client"
    }
  }
}

/// Write one store's settings. NAMES ITS ID, derived from the store, so
/// there is exactly one row per store and a second write is a new VERSION
/// of it rather than a second row a read would have to choose between.
/// ownerUserId is the store's merchant, which the builtin resolves: an
/// existing row keeps its owner, so an operator's change never takes it.
@serverOnly
@actor
mutation wholesaleSettings setWholesaleSettingsRow {
  args {
    settingsId          string!
    ownerUserId         string!
    storeId             string!
    applicationsOpen    bool!
    entitlementAdapter  string
    introText           string   @maxLength(2000)
    accountId           string
    siteId              string
    staffEmail          string   @maxLength(320)
    termsRequired       bool
    linkLifetimeDays    int
    acceptanceText      string   @maxLength(2000)
  }
  insert {
    accept { ownerUserId, storeId, applicationsOpen, entitlementAdapter, introText, accountId, siteId, staffEmail, termsRequired, linkLifetimeDays, acceptanceText }
    stamp {
      id: args.settingsId
    }
  }
}

/// Write one store's settings WHOLE: every field, the empty and false ones
/// included, at the derived id. wholesaleUpdateSettings merges a change into
/// the row it read and writes the result here, so a field the caller did not
/// name keeps the value it held. The owner, organization and site are the
/// row's own, never the caller's.
@serverOnly
@actor
mutation wholesaleSettings putWholesaleSettingsRow {
  args {
    settingsId          string!
    ownerUserId         string!
    storeId             string!
    applicationsOpen    bool!
    entitlementAdapter  string
    introText           string   @maxLength(2000)
    staffEmail          string   @maxLength(320)
    accountId           string
    siteId              string
    termsRequired       bool
    linkLifetimeDays    int
    acceptanceText      string   @maxLength(2000)
  }
  insert {
    accept { ownerUserId, storeId, applicationsOpen, entitlementAdapter, introText, staffEmail, accountId, siteId, termsRequired, linkLifetimeDays, acceptanceText }
    stamp {
      id: args.settingsId
    }
  }
}

/// Append one version of a store's document. IT NAMES NO ID: a version is a
/// new row every time, and an id the caller chose would let a second version
/// overwrite the first -- the one an applicant may already have accepted.
/// EVERY ARGUMENT IS ACCEPTED AND NOTHING IS STAMPED: wholesalePublishDocument
/// names the merchant, the publisher (the caller), the clock and the body's
/// digest, and runs the write as the store's merchant. Versions are never
/// updated, so there is no mutation that writes one at an existing id.
@serverOnly
@actor
mutation documentVersion appendWholesaleDocumentVersion {
  args {
    ownerUserId  string!
    storeId      string!
    accountId    string
    kind         string!  @enum("terms", "map", "priceSheet")
    label        string!  @maxLength(120)
    body         string!  @maxLength(204800)
    sha256       string!
    publishedBy  string!
    publishedAt  datetime!
  }
  insert {
    accept { ownerUserId, storeId, accountId, kind, label, body, sha256, publishedBy, publishedAt }
  }
}

/// Write one application's entitlement. NAMES ITS ID, derived from the
/// application, so a re-provision after a failure is a new version of one
/// logical row -- and "revoked when" is that version's own createdAt,
/// which is why the concept carries no revokedAt. ownerUserId is the
/// application's merchant: the write runs as that merchant, and a row owned
/// by anybody else is invisible to the merchant who granted it.
@serverOnly
@actor
mutation entitlement writeEntitlementRow {
  args {
    entitlementId  string!
    ownerUserId    string!
    applicationId  string!
    storeId        string!
    buyerEmail     string!
    adapter        string!
    state          string!  @enum("pending", "granted", "failed", "revoked")
    reference      string
    error          string   @maxLength(4000)
    errorCode          string
    shopifyCustomerId  string
    customerCreated    bool
    accountId          string
  }
  insert {
    accept { ownerUserId, applicationId, storeId, buyerEmail, adapter, state, reference, error, errorCode, shopifyCustomerId, customerCreated, accountId }
    stamp {
      id: args.entitlementId
    }
  }
}

// # The backfill (U5, X19)
//
// Rows written before organizations reached this pack carry no accountId, so
// the tiers' account arm admits nobody to them. wholesaleBackfillAccounts
// ties each one, and these are its writes: ONE PER CONCEPT, each at the row's
// OWN id with every field the row held plus the ones it lacked. The engine
// merges a write at an existing id into the row's current version, so a field
// named here with the value it already held changes nothing; what the write
// adds is the tie. The builtin admits internal origin or a cluster operator
// and nobody else, before it reads, because these writes run at internal
// origin and the row gate does not owner-check them.

/// Tie one application to its site's organization. source and addedBy are
/// not here: no row written before this version holds either, and a field
/// the write omits keeps its value.
@serverOnly
@actor
mutation application backfillApplicationRow {
  args {
    applicationId   string!
    ownerUserId     string!
    storeId         string!
    siteId          string
    companyName     string!
    applicantName   string!
    applicantEmail  string!
    accountId       string!
  }
  insert {
    accept { ownerUserId, storeId, siteId, companyName, applicantName, applicantEmail, accountId }
    stamp {
      id: args.applicationId
    }
  }
}

/// Tie one decision to its application's organization and name its merchant.
///
/// decidedBy AND principalKind ARE ARGUMENTS HERE, and stamp nothing from the
/// actor (X5): this rewrites a decision somebody else made, and stamping the
/// actor would attribute it to whoever ran the backfill. The builtin passes
/// the values the row already held, so the backfill changes no decision
/// field. It runs as the application's merchant.
@serverOnly
@actor
mutation applicationDecision backfillDecisionRow {
  args {
    decisionId     string!
    applicationId  string!
    ownerUserId    string!
    storeId        string!
    transition     string!  @enum("approve", "reject", "revoke")
    decidedBy      string!
    principalKind  string!  @enum("client")
    note           string
    accountId      string!
  }
  insert {
    accept { applicationId, ownerUserId, storeId, transition, decidedBy, principalKind, note, accountId }
    stamp {
      id: args.decisionId
    }
  }
}

/// Tie one entitlement to its application's organization, with every field
/// the row held, the empty and false ones included.
@serverOnly
@actor
mutation entitlement backfillEntitlementRow {
  args {
    entitlementId      string!
    ownerUserId        string!
    applicationId      string!
    storeId            string!
    buyerEmail         string!
    adapter            string!
    state              string!  @enum("pending", "granted", "failed", "revoked")
    reference          string
    error              string
    errorCode          string
    shopifyCustomerId  string
    customerCreated    bool
    accountId          string!
  }
  insert {
    accept { ownerUserId, applicationId, storeId, buyerEmail, adapter, state, reference, error, errorCode, shopifyCustomerId, customerCreated, accountId }
    stamp {
      id: args.entitlementId
    }
  }
}

/// Tie one store's settings to its site's organization and name the site.
@serverOnly
@actor
mutation wholesaleSettings backfillSettingsRow {
  args {
    settingsId          string!
    ownerUserId         string!
    storeId             string!
    applicationsOpen    bool!
    entitlementAdapter  string
    introText           string
    accountId           string!
    siteId              string
  }
  insert {
    accept { ownerUserId, storeId, applicationsOpen, entitlementAdapter, introText, accountId, siteId }
    stamp {
      id: args.settingsId
    }
  }
}
