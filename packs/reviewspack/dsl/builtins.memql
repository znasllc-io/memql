// reviews pack builtins -- Go-backed write/export/read (memql#4139, epic
// memql#5532).

@executor("integration.reviews.recordModerationAction")
@args(profile="object")
@description("Append a moderation decision. principalKind must be client; a Provider operator is refused. criterion is a closed enum. Tokens and operator identity never become a criterion. storeId is read off the review being moderated rather than supplied, so a decision can never be scoped to a store its subject is not on.")
builtin reviewsRecordModerationAction {
  reviewId        string  @required  @description("Review id to moderate.")
  criterion       string  @required  @description("Closed criterion: spam, profanity, harassment, off_topic, illegal, copyright.")
  principalKind   string  @required  @description("Must be client. provider is inexpressible.")
  decidedBy       string  @required  @description("Client principal user id.")
  note            string  @description("Optional client note.")
}

@executor("integration.reviews.exportReview")
@args(profile="object")
@description("Export a review including image FILES (bytes + filename). A URL-only image is refused -- export is bytes, not a link.")
builtin reviewsExportReview {
  reviewId  string  @required  @description("Review id to export.")
  images    object  @description("Image list [{name, bytes}]. URL-only entries are refused.")
}

@executor("integration.reviews.setPublicDisplay")
@args(profile="object")
@description("Flip one store's public display toggle at runtime. This is data, not a .memql edit, and does not require a rebuild. Per STORE, so a merchant can show reviews on their live storefront while they stay hidden on the development store a candidate is being exercised against.")
@requiresCapability("execute", "app:deployables/reviews")
builtin reviewsSetPublicDisplay {
  siteId  string  @required  @description("The store's site: the organization gate judges the act against its organization, and the store must be bound to it.")
  storeId        string  @required  @description("The store whose toggle this is.")
  publicDisplay  bool    @required  @description("When true, reviews render on the storefront.")
}

@executor("integration.reviews.publishedForProduct")
@args(profile="object")
@description("THE PUBLIC READ: the reviews a storefront may render for one product. Returns an empty list when this store's publicDisplay is false, and excludes every review a moderation decision hides. It is a builtin rather than a query because that is three reads with a gate between them and a filter cannot make a cross-concept read -- and because putting the gate in each caller is how a storefront ends up rendering reviews a merchant had switched off. Projects NO author email: the email exists so a merchant can reply, not so the internet can read it.")
builtin reviewsPublishedForProduct {
  storeId        string  @required  @description("The store to read. Stamped server-side on the shopper path from the binding in effect.")
  productHandle  string  @required  @description("The product whose reviews to return.")
  siteId         string  @description("The deployable the read arrived through. Provenance; the read is scoped by storeId.")
  limit          integer @description("Maximum reviews to return, newest first. Omitted means 50; the Go half clamps it, because a public read with no bound lets one request ask for every review a store has ever received.")
}

@executor("integration.reviews.decide")
@args(profile="object")
@description("Record one moderation decision on a review: publish, decline, askToFix, escalate or remove. The decider is the calling person (the cluster's operators are refused), the store and organization are read off the review, and the decision is refused when the review has changed since the revision named. Decline, askToFix and remove need a listed reason; remove belongs to the store's named owner. Erasing a writer's data is reviewsEraseReviewer.")
@requiresCapability("execute", "app:deployables/reviews")
builtin reviewsDecide {
  reviewId  string   @required  @description("The review to decide.")
  action    string   @required  @description("publish, decline, askToFix, escalate or remove.")
  reason    string   @description("One of the listed reasons; required for decline, askToFix and remove (which also takes reviewer_request).")
  note      string   @description("Optional note.")
  revision     integer  @required  @description("The revision the person deciding was reading.")
  contentHash  string   @description("The fingerprint of the words they were reading, as reviewsList answers it. Recommended: two edits sent at once can arrive as one revision, and with it a decision is refused when the words changed.")
}

@executor("integration.reviews.updateSettings")
@args(profile="object")
@description("Change one store's reviews settings and keep the rest: every write merges into the store's one settings row. A store with no settings is set up by the cluster's operators; the owner who approves removals is named by the current owner or an operator.")
@requiresCapability("execute", "app:deployables/reviews")
builtin reviewsUpdateSettings {
  siteId  string  @required  @description("The store's site: the organization gate judges the act against its organization, and the store must be bound to it.")
  storeId                string   @required  @description("The store whose settings these are.")
  publicDisplay          bool     @description("Show published reviews on the storefront.")
  linkLifetimeDays       integer  @description("Days a buyer's review link stays open, 1 to 365.")
  requestDelayDays       integer  @description("Days after an order its review request goes out, 0 to 365.")
  requestsEnabled        bool     @description("Send review requests.")
  requestTemplateId      string   @description("The template the request email is rendered from.")
  notifyEmail            string   @description("Where 'a review is waiting' goes.")
  removalApproverUserId  string   @description("The store's owner, who alone removes published reviews and erases writer data.")
  criteriaText           string   @description("The store's own copy describing its criteria.")
}

@executor("integration.reviews.list")
@args(profile="object")
@description("The moderation list: one store's reviews with the state their decision log gives them and the last decision on each. state defaults to waiting, oldest first; every other state, and all, is newest first. Projects the writer's email, because a moderator may need to reply; never served to a storefront.")
@requiresCapability("execute", "app:deployables/reviews")
builtin reviewsList {
  siteId  string  @required  @description("The store's site: the organization gate judges the act against its organization, and the store must be bound to it.")
  storeId  string   @required  @description("The store to list.")
  state    string   @description("waiting (the default), published, declined, removed, erased or all.")
  limit    integer  @description("Page size; 50 when omitted, at most 200.")
  after    string   @description("The cursor the previous page answered as next.")
}

@executor("integration.reviews.submitFromLink")
@args(profile="object")
@description("THE SHOPPER FORM'S CONSTRUCT: a review written, or edited, through a buyer's link. Checks the link -- its store, its product, its expiry, and whether its review can still change -- and refuses by name: link_invalid, link_expired, link_used. A review through a link is verified; an edit is the next revision of the same row and waits again.")
builtin reviewsSubmitFromLink {
  requestToken   string   @required  @description("The link's token, from its t parameter.")
  productHandle  string   @required  @description("The product the link names.")
  body           string   @required  @description("The review text.")
  title          string   @description("Optional headline.")
  rating         integer  @description("Optional 1-5 rating.")
  authorName     string   @description("What the writer calls themselves.")
  authorEmail    string   @description("The writer's email, never published.")
  storeId        string   @required  @description("Stamped by the bff from the binding the post arrived through.")
  siteId         string   @description("Stamped by the bff.")
  submissionId   string   @description("Stamped by the bff; unused, the row id is the link's.")
}

@executor("integration.reviews.draftForLink")
@args(profile="object")
@description("THE DRAFT READ: what the buyer wrote through their link, so reopening it pre-fills the form, and the same named refusals as the form so a closed link is caught before anyone types. Never carries an address or the token's hash.")
builtin reviewsDraftForLink {
  requestToken   string  @required  @description("The link's token.")
  productHandle  string  @description("The product the link names, when the page has it.")
  storeId        string  @required  @description("Stamped by the bff.")
  siteId         string  @description("Stamped by the bff.")
}

@executor("integration.reviews.issueRequest")
@args(profile="object")
@description("Mint one buyer's review link by hand -- the cluster's operators only, for testing a store before it goes live or re-sending a link on the store's request. The order line must earn one (a paid line above $0 of a paid, uncancelled order). Answers the link once; only its hash is kept.")
@requiresCapability("execute", "app:deployables/reviews")
builtin reviewsIssueRequest {
  storeId        string  @required  @description("The store the order was placed on.")
  orderGid       string  @required  @description("The mirrored order.")
  productHandle  string  @required  @description("The product of that order to review.")
  siteId         string  @required  @description("The store's site the link points at.")
}
