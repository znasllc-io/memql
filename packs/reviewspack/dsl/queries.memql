// reviews pack -- reads (epic memql#5532, issue memql#5553).
//
// THE PACK SHIPPED NO QUERY AT ALL, which is the third thing standing
// between it and a storefront: nothing listed the reviews for a product, so
// a storefront had no way to render any. These are the reads that close it.
//
// THE PUBLIC READ IS NOT HERE. "Only reviews no moderation decision hides,
// only while this store's publicDisplay is true" is three reads with a gate
// between them, and a filter cannot make a cross-concept read -- so the
// public read is the Go builtin reviewsPublishedForProduct, and putting the
// gate in every future caller instead is exactly the mistake that ships a
// storefront rendering reviews a merchant had switched off.

use reviews.concepts.{ review, moderationAction, reviewSettings, reviewDecision, reviewRequest }
use shopify.generated.orderLineItem.{ orderLineItem, orderLineItemMirror }
use reviews.shapes.{ reviewFull, reviewPublic, moderationActionFull, reviewSettingsFull, reviewDecisionFull, reviewRequestFull }

@description("Every review for one product on one store, newest first -- the merchant's own list, including reviews a moderation decision hides. The operator read behind a moderation screen; the public read is the reviewsPublishedForProduct builtin.")
@actor
query review reviewsForProduct {
  args {
    storeId        string!
    productHandle  string!
  }
  filter  row => row.storeId == args.storeId && row.productHandle == args.productHandle
  sort    "row.createdAt", "desc"
  shape   reviewFull
}

@description("One review by id. The read moderation resolves its subject through, so a caller who cannot read a review cannot record a decision against it either.")
@unbounded("review by id -- bounded to a single row (id is the row's own primary key)")
@actor
query review reviewById {
  args {
    reviewId  string!
  }
  filter  row => row.id == args.reviewId
  shape   reviewFull
}

@description("This store's reviews, newest first -- the merchant's moderation queue. A bounded first page with a keyset cursor, because a busy store's queue is the one list here that grows without limit.")
@actor
query review reviewsForStore {
  args {
    storeId  string!
  }
  filter  row => row.storeId == args.storeId
  sort    "row.createdAt", "desc"
  paginate 50
  shape   reviewFull
}

@description("Every moderation decision recorded against one review, newest first. Append-only, so this IS the decision history -- there is no undo-by-overwrite to reconstruct.")
@actor
query moderationAction moderationActionsForReview {
  args {
    reviewId  string!
  }
  filter  row => row.reviewId == args.reviewId
  sort    "row.createdAt", "desc"
  shape   moderationActionFull
}

@description("Which of these reviews carry a moderation decision. THE PUBLIC READ SUBTRACTS THIS, so it must be COMPLETE for the reviews it is asked about -- a truncated answer here is a moderated review rendered on a storefront, which is the one failure this pack exists to prevent. So it is bounded by the CALLER'S LIST rather than by a page size: the public read passes the ids it is considering, which is one product's reviews on one store.")
@unbounded("moderation decisions for a caller-supplied list of review ids -- bounded by that list, and a page size here would silently let a moderated review through")
@actor
query moderationAction moderationActionsForReviews {
  args {
    storeId    string!
    reviewIds  []string!
  }
  filter  row => row.storeId == args.storeId && row.reviewId in args.reviewIds
  shape   moderationActionFull
}

@description("This store's reviews settings. One row per store, so this answers at most one.")
@actor
query reviewSettings reviewSettingsForStore {
  args {
    storeId  string!
  }
  filter  row => row.storeId == args.storeId
  sort    "row.createdAt", "desc"
  shape   reviewSettingsFull
}

@description("THE PUBLIC PROJECTION: this store's reviews for one product, WITHOUT the shopper's email. The reviewsPublishedForProduct builtin reads through this rather than through reviewsForProduct, so the address never reaches the code path whose output is served to an unauthenticated browser -- an omission in a Go struct is one refactor away from being undone, and a shape is not. WHOLE AND UNSORTED: the builtin scores every shown review and returns the newest page of them, ordering in Go; a sorted query would carry the implicit row cap and score a product on its newest fifty.")
@unbounded("one product's reviews on one store -- the public read scores every shown review and returns the newest page, ordered in Go")
@actor
query review publishedReviewsForProduct {
  args {
    storeId        string!
    productHandle  string!
  }
  filter  row => row.storeId == args.storeId && row.productHandle == args.productHandle
  shape   reviewPublic
}

@description("Every review on one store, for the moderation list (the reviewsList builtin), which derives each one's state from the decision log and therefore needs all of them, not a page.")
@unbounded("one store's reviews -- bounded by the store, and the moderation list must see every review to know which are waiting")
@actor
query review reviewsInStore {
  args {
    storeId  string!
  }
  filter  row => row.storeId == args.storeId
  shape   reviewFull
}

@description("The decision log for these reviews. THE PUBLIC READ AND THE MODERATION LIST DERIVE STATE FROM THIS, so it must be COMPLETE for the reviews it is asked about: it is bounded by the caller's list, never by a page size.")
@unbounded("decisions for a caller-supplied list of review ids -- bounded by that list, and a page size here could show a review nobody published")
@actor
query reviewDecision reviewDecisionsForReviews {
  args {
    storeId    string!
    reviewIds  []string!
  }
  filter  row => row.storeId == args.storeId && row.reviewId in args.reviewIds
  shape   reviewDecisionFull
}

@description("One review's whole decision log: what the review's own page shows, and what reviewsDecide judges a new decision against. Unsorted, because a sorted query carries the implicit row cap and this read must be whole; a caller orders it by createdAt.")
@unbounded("one review's decisions -- bounded by the review")
@actor
query reviewDecision reviewDecisionsForReview {
  args {
    reviewId  string!
  }
  filter  row => row.reviewId == args.reviewId
  shape   reviewDecisionFull
}

@description("This store's decision log, newest first: who decided what, when, for which reason and with which note.")
@actor
query reviewDecision reviewDecisionsForStore {
  args {
    storeId  string!
  }
  filter  row => row.storeId == args.storeId
  sort    "row.createdAt", "desc"
  paginate 50
  shape   reviewDecisionFull
}

@description("The request a link's token belongs to, on one store. The link path's only way in: a token for another store, or no token at all, finds nothing.")
@unbounded("one request by its token hash -- a token hash is one link")
@actor
query reviewRequest reviewRequestByTokenHash {
  args {
    storeId    string!
    tokenHash  string!
  }
  filter  row => row.storeId == args.storeId && row.tokenHash == args.tokenHash
  shape   reviewRequestFull
}

@description("One request by id.")
@unbounded("request by id -- bounded to a single row")
@actor
query reviewRequest reviewRequestById {
  args {
    requestId  string!
  }
  filter  row => row.id == args.requestId
  shape   reviewRequestFull
}

@description("The lines of one mirrored order, for deciding which of its products earn a review link. Read by the cluster's operators and the request job; the order mirror is cluster-owner tier.")
@unbounded("one order's lines -- bounded by the order")
@actor
query orderLineItem reviewOrderLines {
  args {
    storeId   string!
    orderGid  string!
  }
  filter  row => row.storeId == args.storeId && row.parentGid == args.orderGid
  shape   orderLineItemMirror
}

@description("Every buyer link of one store, for the store's export.")
@unbounded("one store's links -- bounded by the store's orders")
@actor
query reviewRequest reviewRequestsForStore {
  args {
    storeId  string!
  }
  filter  row => row.storeId == args.storeId
  shape   reviewRequestFull
}
