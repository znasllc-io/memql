// reviews pack -- caller-scoped writes (memql#4139, epic memql#5532).
//
// Authz tier: composite owner. ownerUserId / decidedBy are stamped from
// actor.userId. A cluster owner READS every merchant's reviews -- which is
// what makes an operator surface possible at all -- and CANNOT rewrite
// them, because the write guard ignores the second argument. "Provider
// operators cannot moderate" is unchanged and is enforced where it always
// was: the Go capability refuses a non-client principal.
//
// EVERY WRITE IS THE PACK'S. Every reviews concept is @serverWritten, so no
// mutation here is a client's: each is @serverOnly and reached only from the
// builtin that judges it. A buyer's review arrives through the shopper form,
// whose construct is the pack's own Go (reviewsSubmitFromLink), never a
// mutation a form names. The authenticated createReview, the older shopper
// mutation submitReview and setReviewDisplay are gone: nothing in the product
// called them, and each was a way to write a row around the pack.

// THE WRITES THE BUILTINS JUDGE (writer.go). A builtin computes and does not
// write, so each judging builtin runs one of these. They are @serverOnly:
// reached only from that builtin, which stamps internal origin for the one
// call, never by a client -- a decision written around reviewsDecide would
// skip what makes it a decision, above all that the cluster's own operators
// never record one. The CALLER'S own actor still runs them, so the row gate
// still decides whether this caller may write this row.

/// Append one moderation decision. Reached only from reviewsDecide, which
/// names the decider from the caller, copies the store, organization and
/// owner off the review, and refuses an illegal decision before this runs.
@serverOnly
@actor
mutation reviewDecision appendReviewDecision {
  args {
    decisionId   string!
    ownerUserId  string!
    reviewId     string!
    storeId      string!
    accountId    string
    action       string!  @enum("publish", "decline", "askToFix", "escalate", "remove", "erase")
    reason       string   @enum("spam_or_advertising", "profanity", "harassing_or_obscene", "discriminatory", "personal_information", "defamatory", "false_or_dangerous", "believed_fake", "unrelated", "confidential", "undisclosed_connection", "reviewer_request")
    note         string   @maxLength(4000)
    revision     int!
    contentHash  string   @maxLength(64)
    decidedBy    string!
  }
  insert {
    accept { ownerUserId, reviewId, storeId, accountId, action, reason, note, revision, contentHash, decidedBy }
    stamp {
      id: args.decisionId
    }
  }
}

/// Write one store's settings row, whole, at the store's derived id: a second
/// write is a new VERSION of the one row. Reached only from
/// reviewsUpdateSettings and reviewsSetPublicDisplay, which merge the current
/// row and judge who may change what.
@serverOnly
@actor
mutation reviewSettings putReviewSettings {
  args {
    settingsId             string!
    ownerUserId            string!
    storeId                string!
    accountId              string
    publicDisplay          bool!
    criteriaText           string   @maxLength(4000)
    linkLifetimeDays       int      @minimum(1) @maximum(365)
    requestDelayDays       int      @minimum(0) @maximum(365)
    requestsEnabled        bool
    requestTemplateId      string   @maxLength(200)
    notifyEmail            string   @maxLength(320)
    removalApproverUserId  string   @maxLength(200)
    requestSenderIdentityId string  @maxLength(200)
  }
  insert {
    accept { ownerUserId, storeId, accountId, publicDisplay, criteriaText, linkLifetimeDays, requestDelayDays, requestsEnabled, requestTemplateId, notifyEmail, removalApproverUserId, requestSenderIdentityId }
    stamp {
      id: args.settingsId
    }
  }
}

/// Write a review through a buyer's link: the first submission, or the next
/// revision of the same row. Reached only from reviewsSubmitFromLink, which
/// checks the link (its store, its product, its expiry, whether its review
/// can still change) before this runs. verifiedBuyer is set here and nowhere
/// a form could reach.
@serverOnly
@actor
mutation review putReview {
  args {
    reviewId       string!
    storeId        string!
    siteId         string
    productHandle  string!  @maxLength(200)
    body           string!  @maxLength(4000)
    title          string   @maxLength(200)
    rating         int      @minimum(1) @maximum(5)
    authorName     string   @maxLength(120)
    authorEmail    string   @maxLength(320)
    accountId      string
    requestId      string!
    verifiedBuyer  bool!
    revision       int!     @minimum(1)
  }
  insert {
    accept { storeId, siteId, productHandle, body, title, rating, authorName, authorEmail, accountId, requestId, verifiedBuyer, revision }
    stamp {
      id: args.reviewId
      ownerUserId: actor.userId
    }
  }
}

/// Write one buyer's review link, whole, at its derived id. Reached only from
/// the builtins that issue links, which write it AS THE SITE OWNER so the
/// shopper path -- that owner's borrowed authority -- can read it.
@serverOnly
@actor
mutation reviewRequest putReviewRequest {
  args {
    requestId      string!
    storeId        string!
    accountId      string
    siteId         string
    orderGid       string!
    orderName      string
    productHandle  string!
    productTitle   string
    email          string!
    tokenHash      string!
    issuedAt       datetime!
    expiresAt      datetime!
    sentAt         datetime
    sendState      string  @enum("pending", "sent", "skipped", "failed")
    sendNote       string  @maxLength(1000)
  }
  insert {
    accept { storeId, accountId, siteId, orderGid, orderName, productHandle, productTitle, email, tokenHash, issuedAt, expiresAt, sentAt, sendState, sendNote }
    stamp {
      id: args.requestId
      ownerUserId: actor.userId
    }
  }
}
