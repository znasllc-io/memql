# deploy/media/livekit.yaml.tmpl -- the calls media server's LiveKit configuration, for
# every target.
#
# RENDERED, NEVER READ AS IT STANDS, by two renderers that fill the same double-brace
# placeholders the same way:
#   - scripts/media/local-up.sh, for the server beside the local cluster, from the
#     memql-calls-media Secret and the cluster's domain, into ~/.memql/media/livekit.yaml
#     (deploy/media/compose.yaml mounts it);
#   - memql-media configure, on a rented server, from the values the operator hands it
#     over SSH, into /etc/memql-media/livekit.yaml. deploy/media/cloud-init.yaml.tmpl
#     installs that command and writes this file beside it, as it stands.
# Either rendering carries both key pairs, so it is written 0600; this template carries
# none, which is what lets it travel in a server's user data.
#
# ONE FILE FOR EVERY TARGET, so what a call is -- the rooms, the codecs, the video
# subscription cap, the webhook and its four events -- is the same on the server a change
# is tried on and on a rented server made from the same revision. A rented server keeps
# the copy its first boot wrote: a change here reaches it only when it is replaced
# (calls.md, "Replacing a server"). Only where the server is varies:
# where its HTTP port listens, where its Redis is, the address its ICE candidates name,
# and whether it runs a TURN server of its own. Those are the scalar placeholders below,
# each explained where it is used.
#
# Every key was checked against livekit-server v1.13.7, the version both targets pin:
# its config-sample.yaml, pkg/config/config.go and pkg/service/turn.go at that tag, and
# the livekit/protocol webhook package it pins.

port: 7880

# Where the HTTP port (signalling and the control API) listens. Locally "" (every
# interface of the container, which compose.yaml publishes); on a rented server
# 127.0.0.1, because Caddy, on the same host, is its only client and nothing else should
# reach it.
bind_addresses:
  - "{{BIND_ADDRESS}}"

redis:
  # Locally the compose network's redis service; on a rented server, where every
  # service shares the host's network, Redis on loopback.
  address: "{{REDIS_ADDRESS}}"

# Two key pairs. Rooms and passes are signed with the first (MEMQL_CALLS_MEDIA_API_KEY);
# the server signs its webhooks with the second (MEMQL_CALLS_MEDIA_WEBHOOK_KEY, named in
# webhook.api_key below), which is the only pair the engine verifies a delivery against.
keys:
  "{{API_KEY}}": "{{API_SECRET}}"
  "{{WEBHOOK_KEY}}": "{{WEBHOOK_SECRET}}"

rtc:
  tcp_port: 7881
  # One UDP port, muxed, rather than a range: exactly one port to publish locally and to
  # open in a rented server's firewall.
  udp_port: 7882
  # The address the server's ICE candidates name. Locally 127.0.0.1: the browser runs on
  # this machine and reaches the published ports at loopback. On a rented server its
  # public IPv4, read from the provider's metadata at the operator's step. Either way it
  # is set, so external-address discovery (use_external_ip, off by default) never runs
  # and no STUN answer can replace it.
  node_ip: "{{NODE_IP}}"

room:
  # The engine creates every room, with its participant limit (integrations/calls
  # media.go CreateRoom). A pass for a room that does not exist must be refused, not
  # open a room without that limit. How long an empty room lives is v1.13.7's default
  # (300 s, then 20 s after the last departure); the engine creates a call's room again
  # before every pass into it, so a room closed or lost in a restart is back first.
  auto_create: false
  # This list REPLACES v1.13.7's default one, and the server registers only what it
  # names (pkg/rtc/mediaengine.go), so each entry is a decision:
  #   - audio/opus: the audio codec every browser implements, and what clients publish.
  #   - audio/red: redundant audio (RFC 2198), each packet carrying a copy of the frame
  #     before it, so a lost packet's audio is recovered from the next one on a lossy
  #     network instead of heard as a gap.
  #   - video/vp8 and video/h264: the two video codecs WebRTC requires every browser to
  #     implement, so every participant can send and decode one of them.
  #   - video/rtx: retransmission of lost video packets on a stream of their own
  #     (RFC 4588), for lossy networks; the server registers it beside each video codec
  #     only when it is named here.
  # Off, though the default list carries them: video/vp9, video/av1 and video/h265, which
  # not every browser can encode, so a room using one would need a second encoding for
  # the rest; and audio/pcmu and audio/pcma, G.711 telephone audio, which a participant
  # publishing Opus never needs.
  enabled_codecs:
    - mime: audio/opus
    - mime: audio/red
    - mime: video/vp8
    - mime: video/h264
    - mime: video/rtx

# Of the quality caps (cameras up to 720p, screen shares up to 1080p at 15 fps, at most
# 10 video subscriptions per participant), only the last is something the server can
# express: subscriptions past it stay pending until one ends. Resolution, frame rate and
# bitrate are the publishing client's encoder settings, and a pass says which sources a
# seat may publish, not at what quality. Audio subscriptions are not capped: one held
# pending is a participant nobody hears.
limit:
  subscription_limit_video: 10

# The server's own TURN server, whose address and credentials LiveKit hands a
# participant when it joins with a pass (the credentials are derived from the API secret
# and last v1.13.7's default 300 s, so nobody gets one any other way). Off locally
# (false, "", 0, 0): the browser is on the same machine and reaches the published ports
# directly. On a rented server it is on, twice:
#   - over TLS on port 443, for networks that let only HTTPS out. v1.13.7 advertises it
#     as turns:<domain>:443 whatever tls_port says (pkg/service/roommanager.go), so 443
#     is shared with signalling: Caddy routes the connection by TLS server name, ends
#     TLS (external_tls) and hands it to tls_port 5349 on loopback with a PROXY header
#     naming the client (proxy_protocol), because TURN echoes the address it sees back
#     to the client and Firefox abandons an allocation whose address is loopback. With
#     proxy_protocol on, a connection to 5349 from anywhere but loopback is closed.
#   - over UDP on 3478, which also serves participants as STUN. Without a STUN server of
#     its own, v1.13.7 hands every browser Google's and Twilio's public ones (as it does
#     locally, for a developer's own browser), and each participant's address would go
#     to them.
turn:
  enabled: {{TURN_ENABLED}}
  domain: "{{TURN_DOMAIN}}"
  tls_port: {{TURN_TLS_PORT}}
  udp_port: {{TURN_UDP_PORT}}
  external_tls: true
  proxy_protocol: true

webhook:
  api_key: "{{WEBHOOK_KEY}}"
  urls:
    - "{{WEBHOOK_URL}}"
  # Only the four events integrations/calls applies (events.go). Each delivery is staged
  # as a row and opens a journal run before anything reads its event, so every other
  # event would be that cost for nothing.
  filter_params:
    include_events:
      - participant_joined
      - participant_left
      - track_published
      - room_finished

logging:
  level: info
